#pragma OPENCL EXTENSION cl_khr_fp16 : enable
#pragma OPENCL EXTENSION cl_intel_subgroups : enable
#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
#pragma OPENCL EXTENSION cl_khr_integer_dot_product : enable

// IQ3_XXS, IQ4_XS and IQ4_NL x q8_1 matrix-vector products for Intel Arc,
// on the layout of mul_mv_kq_q8_1.cl: the activation as two int8 terms per
// 32 values (kernel_quantize_q8_1 there), the weights expanded to signed
// int8 per sub-block and multiplied with 4x8-bit integer dot products, as
// llama.cpp's CUDA vec_dot_iq3_xxs_q8_1 / vec_dot_iq4_xs_q8_1 /
// vec_dot_iq4_nl_q8_1 do. IQ3_XXS and IQ4_XS are ggml's blocks as stored
// (98 and 136 bytes per 256 weights); IQ4_NL is ggml-opencl's flat planes
// (16 code bytes and one half scale per 32 weights).
//
// A subgroup of 16 takes N_DST rows; lane l covers 32-block l % 8 of a
// 256-weight super-block (IQ4_NL: of eight consecutive blocks), two super-
// blocks per step; NCOLS columns per pass.

#ifndef N_DST
#define N_DST 4
#endif
#ifndef N_SIMDGROUP
#define N_SIMDGROUP 4
#endif
#ifndef NCOLS
#define NCOLS 1
#endif
#define QK_K 256

// ggml-common.h tables (byte-exact copies)
