    0x09050107u, 0x09050301u, 0x0905030bu, 0x09050503u,
    0x09050707u, 0x09050901u, 0x09050b0fu, 0x09050d05u,
    0x09050f01u, 0x09070109u, 0x09070303u, 0x09070307u,
    0x09070501u, 0x09070505u, 0x09070703u, 0x0907070bu,
    0x09090101u, 0x09090105u, 0x09090509u, 0x0909070fu,
    0x09090901u, 0x09090f03u, 0x090b010bu, 0x090b010fu,
    0x090b0503u, 0x090b0d05u, 0x090d0307u, 0x090d0709u,
    0x090d0d01u, 0x090f0301u, 0x090f030bu, 0x090f0701u,
    0x090f0907u, 0x090f0b03u, 0x0b010105u, 0x0b010301u,
    0x0b010309u, 0x0b010505u, 0x0b010901u, 0x0b010909u,
    0x0b01090fu, 0x0b010b05u, 0x0b010d0du, 0x0b010f09u,
    0x0b030103u, 0x0b030107u, 0x0b03010bu, 0x0b030305u,
    0x0b030503u, 0x0b030705u, 0x0b030f05u, 0x0b050101u,
    0x0b050303u, 0x0b050507u, 0x0b050701u, 0x0b05070du,
    0x0b050b07u, 0x0b070105u, 0x0b07010fu, 0x0b070301u,
    0x0b07050fu, 0x0b070909u, 0x0b070b03u, 0x0b070d0bu,
    0x0b070f07u, 0x0b090103u, 0x0b090109u, 0x0b090501u,
    0x0b090705u, 0x0b09090du, 0x0b0b0305u, 0x0b0b050du,
    0x0b0b0b03u, 0x0b0b0b07u, 0x0b0d0905u, 0x0b0f0105u,
    0x0b0f0109u, 0x0b0f0505u, 0x0d010303u, 0x0d010307u,
    0x0d01030bu, 0x0d010703u, 0x0d010707u, 0x0d010d01u,
    0x0d030101u, 0x0d030501u, 0x0d03050fu, 0x0d030d09u,
    0x0d050305u, 0x0d050709u, 0x0d050905u, 0x0d050b0bu,
    0x0d050d05u, 0x0d050f01u, 0x0d070101u, 0x0d070309u,
    0x0d070503u, 0x0d070901u, 0x0d09050bu, 0x0d090907u,
    0x0d090d05u, 0x0d0b0101u, 0x0d0b0107u, 0x0d0b0709u,
    0x0d0b0d01u, 0x0d0d010bu, 0x0d0d0901u, 0x0d0f0303u,
    0x0d0f0307u, 0x0f010101u, 0x0f010109u, 0x0f01010fu,
    0x0f010501u, 0x0f010505u, 0x0f01070du, 0x0f010901u,
    0x0f010b09u, 0x0f010d05u, 0x0f030105u, 0x0f030303u,
    0x0f030509u, 0x0f030907u, 0x0f03090bu, 0x0f050103u,
    0x0f050109u, 0x0f050301u, 0x0f05030du, 0x0f050503u,
    0x0f050701u, 0x0f050b03u, 0x0f070105u, 0x0f070705u,
    0x0f07070bu, 0x0f070b07u, 0x0f090103u, 0x0f09010bu,
    0x0f090307u, 0x0f090501u, 0x0f090b01u, 0x0f0b0505u,
    0x0f0b0905u, 0x0f0d0105u, 0x0f0d0703u, 0x0f0f0101u,
};

// ---- the low-bit types of the ISTA-DASLab GSQ-RCO files (patch 0022): kq type
// index 6 IQ2_XXS, 7 IQ2_S, 8 IQ1_M, 9 Q2_0, 10 IQ3_S, blocks as stored.
// A 32-weight sub-block j32 of a row expands to its signed int8 values w[8]
// (weights 4i .. 4i+3 in w[i]) and two scales, s0 for weights 0..15 and s1
// for 16..31 (equal unless the type scales half sub-blocks: IQ2_S, IQ1_M).
// IQ1_M's values are 8 (g + delta) with delta = +-1/8, exact in int8, and
// its scales carry the 1/8. After ggml-quants.c's dequantize_row_*. ----

// bytes per block, 32-weight sub-blocks per block
#define LB_BYTES(T) ((T) == 6 ? 66 : (T) == 7 ? 82 : (T) == 8 ? 56 : (T) == 9 ? 18 : (T) == 11 ? 74 : 110)
#define LB_SUBS(T)  ((T) == 9 ? 2 : 8)
#define LB_ROW_BYTES(T, n32) ((ulong)((n32) / LB_SUBS(T)) * LB_BYTES(T))

// four sign bits -> 0xFF in the bytes to negate (32-bit only: Intel's GPUs
// emulate 64-bit integer arithmetic)
static inline uint lb_signmask4(uint b) {
    uint m = ((b & 0xFu) * 0x01010101u) & 0x08040201u;
    m = (m + 0x7F7F7F7Fu) & 0x80808080u;
    return (m >> 7) * 0xFFu;
}

// four unsigned grid bytes, negated where m's bytes are 0xFF. In 32-bit words
// (patch 0034): IGC splits char4 arithmetic per byte (moves to byte registers,
// widens, packs back: more than half of a low-bit matvec's instructions on the
// B60). Exact because no grid byte is 0 (the IQ2 grids hold 8, 25, 43; IQ3_XXS
// 4..62; IQ3_S odd 1..15): ~g + 1 never carries out of a byte.
// -DLB_CHAR4_ARITH keeps the char4 form (measurement).
static inline uint lb_sgn4(uint g, uint m) {
#ifdef LB_CHAR4_ARITH
    return as_uint(as_char4(g ^ m) - as_char4(m));
#else
    return (g ^ m) + (m & 0x01010101u);
#endif
}

// four unsigned grid bytes negated where the low four bits of b are set (IQ2_S,
// IQ3_S; patch 0053): the bits spread to the bytes' low bits by one multiply (the
// copies at shifts 0, 7, 14, 21 do not overlap), 0xFF from the bit, then
// lb_sgn4's form. -DLB_SIGN_MASK4 keeps lb_signmask4 (measurement)
#if defined(LB_SIGN_RED) && (defined(LB_SIGN_MASK4) || defined(LB_CHAR4_ARITH))
#error "LB_SIGN_RED mutates the multiply form; LB_SIGN_MASK4 / LB_CHAR4_ARITH select the old one"
#endif
#if defined(Q2_SPREAD_RED) && defined(Q2_SPREAD_SHIFT)
#error "Q2_SPREAD_RED mutates the multiply form; Q2_SPREAD_SHIFT selects the old one"
#endif
static inline uint lb_sgnb4(uint g, uint b) {
#if defined(LB_SIGN_MASK4) || defined(LB_CHAR4_ARITH)
    return lb_sgn4(g, lb_signmask4(b));
#else
#ifndef LB_SIGN_RED   // the red case of the test: the first weight of four never negated
    const uint s = ((b & 0xFu) * 0x00204081u) & 0x01010101u;
#else
    const uint s = ((b & 0xFu) * 0x00204081u) & 0x01010100u;
#endif
    return (g ^ (s * 0xFFu)) + s;
#endif
}

// Q2_0's fields 1 and 3 in their bytes (patch 0053)
#ifndef Q2_SPREAD_RED   // the red case of the test: field 3 dropped
#define Q2_SPREAD_HI 0x03000300u
#else
#define Q2_SPREAD_HI 0x00000300u
#endif

// a 64-bit table entry as two 32-bit halves
#define LB_TAB2(T, i) vload2((i), (constant const uint *)(T))

static inline uint lb_u32(global const uchar * p) {
    return (uint)p[0] | ((uint)p[1] << 8) | ((uint)p[2] << 16) | ((uint)p[3] << 24);
}

#define LB_LT_PARAM , local const uint * lt
#define LB_GRID_XXS(i) vload2((i), lt)
#define LB_SIGNS_XXS(i) vload2(256 + (i), lt)
#define LB_GRID_1M(i) vload2((i), lt)
#define LB_GRID_XS(i) vload2((i), lt)
#define LB_SIGNS_XS(i) vload2(512 + (i), lt)
// A low-bit slice (one weight matrix, nblk blocks) is kept in planes on the
// card (ggml-opencl's ggml_cl_lb_planes): IQ2_XXS d | qs[64]; IQ2_XS d | qs[64] |
// scales[8]; IQ2_S d | qs[32]
// | signs[32] | qh[8] | scales[8]; Q2_0 d | qs[16]; IQ3_S d | qs[64] | qh[8] |
// signs[32] | scales[4], each field of every block back to back, so a lane's
// sub-block fields are aligned 32-bit words (the GGUF blocks of 18, 66, 82 or
// 110 bytes left them at 2-byte offsets: single-byte loads). IQ1_M stays as
// stored (its fields are aligned). Block bi of the slice, sub-block p (Q2_0: half).
static inline void lb_expand(const int TYPE, global const uchar * S, ulong nblk, ulong bi, int p,
                             uint * w, float * s0, float * s1 LB_LT_PARAM) {
    if (TYPE == 6) {          // IQ2_XXS
        const float d = vload_half(bi, (global const half *)S);
        const uint2 a = vload2(bi * 8 + p, (global const uint *)(S + nblk * 2));
        const uint a0 = a.s0, a1 = a.s1;
        #pragma unroll
        for (int l = 0; l < 4; ++l) {
            const uint2 g = LB_GRID_XXS((a0 >> (8 * l)) & 0xFF);
            const uint2 m = LB_SIGNS_XXS((a1 >> (7 * l)) & 127);
            w[2 * l]     = lb_sgn4(g.s0, m.s0);
            w[2 * l + 1] = lb_sgn4(g.s1, m.s1);
        }
        *s0 = *s1 = d * (0.5f + (float)(a1 >> 28)) * 0.25f;
    } else if (TYPE == 11) {  // IQ2_XS: a code is a 9-bit grid index and a 7-bit sign index
        const float d = vload_half(bi, (global const half *)S);
        const uint2 a = vload2(bi * 8 + p, (global const uint *)(S + nblk * 2));
        const uint qv[4] = { a.s0 & 0xFFFF, a.s0 >> 16, a.s1 & 0xFFFF, a.s1 >> 16 };
        const uint sc = S[nblk * 66 + bi * 8 + p];
        #pragma unroll
        for (int l = 0; l < 4; ++l) {
            const uint2 g = LB_GRID_XS(qv[l] & 511);
            const uint2 m = LB_SIGNS_XS(qv[l] >> 9);
            w[2 * l]     = lb_sgn4(g.s0, m.s0);
            w[2 * l + 1] = lb_sgn4(g.s1, m.s1);
        }
        *s0 = d * (0.5f + (float)(sc & 0xF)) * 0.25f;
        *s1 = d * (0.5f + (float)(sc >> 4)) * 0.25f;
    } else if (TYPE == 7) {   // IQ2_S
        const float d = vload_half(bi, (global const half *)S);
        const uint qw = ((global const uint *)(S + nblk * 2))[bi * 8 + p];
        const uint sw = ((global const uint *)(S + nblk * 34))[bi * 8 + p];
        const uint qh = S[nblk * 66 + bi * 8 + p], sc = S[nblk * 74 + bi * 8 + p];
        #pragma unroll
        for (int l = 0; l < 4; ++l) {
            const uint2 g = LB_TAB2(iq2s_grid, ((qw >> (8 * l)) & 0xFF) | ((qh << (8 - 2 * l)) & 0x300));
            const uint sb = (sw >> (8 * l)) & 0xFF;
            w[2 * l]     = lb_sgnb4(g.s0, sb);
            w[2 * l + 1] = lb_sgnb4(g.s1, sb >> 4);
        }
        *s0 = d * (0.5f + (float)(sc & 0xF)) * 0.25f;
        *s1 = d * (0.5f + (float)(sc >> 4)) * 0.25f;
    } else if (TYPE == 8) {   // IQ1_M, as stored: qs[32], qh[16], scales[8]
        global const uchar * bp = S + bi * 56;
        global const ushort * sc = (global const ushort *)(bp + 48);
        const ushort u = (sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) | ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000);
        const float d = convert_float(as_half(u));
        const uint s = sc[p / 2] >> (6 * (p & 1));
        const uint qhw = ((global const ushort *)(bp + 32))[p];
        const uint qh0 = qhw & 0xFF, qh1 = qhw >> 8;
        const uint qsw = ((global const uint *)bp)[p];
        const uint idx[4] = { (qsw & 0xFF) | ((qh0 << 8) & 0x700), ((qsw >> 8) & 0xFF) | ((qh0 << 4) & 0x700),
                              ((qsw >> 16) & 0xFF) | ((qh1 << 8) & 0x700), (qsw >> 24) | ((qh1 << 4) & 0x700) };
        const int dl[4] = { (qh0 & 0x08) ? -1 : 1, (qh0 & 0x80) ? -1 : 1, (qh1 & 0x08) ? -1 : 1, (qh1 & 0x80) ? -1 : 1 };
        #pragma unroll
        for (int l = 0; l < 4; ++l) {
            const uint2 g = LB_GRID_1M(idx[l]);
#ifdef LB_CHAR4_ARITH
            w[2 * l]     = as_uint(as_char4(g.s0) * (char4)(8) + (char4)(dl[l]));
            w[2 * l + 1] = as_uint(as_char4(g.s1) * (char4)(8) + (char4)(dl[l]));
#else
            // 8 g per byte (g in -1..1: the shift's spill masked off), then +-1 per byte with the
            // top bit flipped around it: no carry or borrow crosses a byte
            const uint t0 = ((g.s0 << 3) & 0xF8F8F8F8u) ^ 0x80808080u, t1 = ((g.s1 << 3) & 0xF8F8F8F8u) ^ 0x80808080u;
            w[2 * l]     = (dl[l] > 0 ? t0 + 0x01010101u : t0 - 0x01010101u) ^ 0x80808080u;
            w[2 * l + 1] = (dl[l] > 0 ? t1 + 0x01010101u : t1 - 0x01010101u) ^ 0x80808080u;
#endif
        }
        *s0 = d * (float)(2 * (s & 7) + 1) * 0.125f;
        *s1 = d * (float)(2 * ((s >> 3) & 7) + 1) * 0.125f;
    } else if (TYPE == 9) {   // Q2_0: p is the half of the 64-weight block
        const float d = vload_half(bi, (global const half *)S);
        const uint2 c = vload2(bi * 2 + p, (global const uint *)(S + nblk * 2));
        const uint cw[2] = { c.s0, c.s1 };
        #pragma unroll
        for (int i = 0; i < 8; ++i) {
            const uint b = (cw[i >> 2] >> (8 * (i & 3))) & 0xFF;
#ifdef Q2_SPREAD_SHIFT   // the per-field shifts (measurement)
            const uint v = (b & 3) | (((b >> 2) & 3) << 8) | (((b >> 4) & 3) << 16) | (((b >> 6) & 3) << 24);
#else
            // fields 0, 2 and 1, 3 spread to their bytes by one multiply each (copies
            // at shifts 0, 12 and 6, 18 do not overlap; patch 0053)
            const uint v = (((b & 0x33u) * 0x1001u) & 0x00030003u) | (((b & 0xCCu) * 0x40040u) & Q2_SPREAD_HI);
#endif
#ifdef LB_CHAR4_ARITH
            w[i] = as_uint(as_char4(v) - (char4)(1));
#else
            w[i] = ((v | 0x80808080u) - 0x01010101u) ^ 0x80808080u;   // v - 1 per byte (v in 0..3), no borrow across bytes
#endif
        }
        *s0 = *s1 = d;
    } else {                  // IQ3_S
        const float d = vload_half(bi, (global const half *)S);
        const uint2 q = vload2(bi * 8 + p, (global const uint *)(S + nblk * 2));
        const uint qv[4] = { q.s0 & 0xFFFF, q.s0 >> 16, q.s1 & 0xFFFF, q.s1 >> 16 };
        const uint qh = S[nblk * 66 + bi * 8 + p];
        const uint sw = ((global const uint *)(S + nblk * 74))[bi * 8 + p];
        const uint sc = (S[nblk * 106 + bi * 4 + p / 2] >> (4 * (p & 1))) & 0xF;
        #pragma unroll
        for (int l = 0; l < 4; ++l) {
            const uint g1 = iq3s_grid[(qv[l] & 0xFF) | ((qh << (8 - 2 * l)) & 256)];
            const uint g2 = iq3s_grid[(qv[l] >> 8)   | ((qh << (7 - 2 * l)) & 256)];
            const uint sb = (sw >> (8 * l)) & 0xFF;
            w[2 * l]     = lb_sgnb4(g1, sb);
            w[2 * l + 1] = lb_sgnb4(g2, sb >> 4);
        }
        *s0 = *s1 = d * (float)(1 + 2 * sc);
    }
}

// sub-block j32 of row r: its block in the slice, and p
#define LB_BI(T, r, nbr, j32) ((ulong)(r) * (nbr) + (ulong)((j32) / LB_SUBS(T)))
#define LB_P(T, j32)          ((j32) % LB_SUBS(T))


static inline int dot8_ss(const uint * w, uint4 x0, uint4 x1) {
    int a = 0;
    a = dot_acc_sat_4x8packed_ss_int(w[0], x0.s0, a);
    a = dot_acc_sat_4x8packed_ss_int(w[1], x0.s1, a);
    a = dot_acc_sat_4x8packed_ss_int(w[2], x0.s2, a);
    a = dot_acc_sat_4x8packed_ss_int(w[3], x0.s3, a);
    a = dot_acc_sat_4x8packed_ss_int(w[4], x1.s0, a);
    a = dot_acc_sat_4x8packed_ss_int(w[5], x1.s1, a);
    a = dot_acc_sat_4x8packed_ss_int(w[6], x1.s2, a);
    a = dot_acc_sat_4x8packed_ss_int(w[7], x1.s3, a);
    return a;
}

// four 4-bit codes (one per byte, low nibble) -> four int8 kvalues (patch
// 0035). IGC assembles a char4 one byte at a time, and the constant table's
// lookups each widen their index to a 64-bit address: on the B60 that was a
// third of the dense IQ4_XS matvec's instructions. By default the codebook is
// four tables with each value already in its byte, copied into local memory
// by LOCAL_TABLES (32-bit addresses), and a word is their OR.
// On the A770 too, where it replaced the register selects below (coder
// decode 41.0-42.1 -> 41.9-42.9 t/s). IQ4_KV_SHIFTED: the same tables in
// constant memory; IQ4_KV_CHAR4: the char4 form; IQ4_KV_SELECT: the selects
// (measurement).
#if !defined(IQ4_KV_CHAR4) && !defined(IQ4_KV_SHIFTED) && !defined(IQ4_KV_SELECT)
#define IQ4_KV_LOCAL
#endif
#if defined(IQ4_KV_CHAR4)
#undef IQ4_KV_LOCAL
static inline uint kv4(uint n) {
    return as_uint((char4)(kvalues_iq4nl[n & 0xF], kvalues_iq4nl[(n >> 8) & 0xF],
                           kvalues_iq4nl[(n >> 16) & 0xF], kvalues_iq4nl[(n >> 24) & 0xF]));
}
#else
constant uint kvalues_iq4nl_sh[64] = {
#define KV_ROW(s) (0x81u << s), (0x98u << s), (0xADu << s), (0xBFu << s), (0xCFu << s), (0xDDu << s), (0xEAu << s), (0xF6u << s), \
                  (0x01u << s), (0x0Du << s), (0x19u << s), (0x26u << s), (0x35u << s), (0x45u << s), (0x59u << s), (0x71u << s)
    KV_ROW(0), KV_ROW(8), KV_ROW(16), KV_ROW(24)
#undef KV_ROW
};
#ifdef IQ4_KV_LOCAL
#define kv4(n) (kvt[(n) & 0xF] | kvt[16 + (((n) >> 8) & 0xF)] | kvt[32 + (((n) >> 16) & 0xF)] | kvt[48 + (((n) >> 24) & 0xF)])
#else
static inline uint kv4(uint n) {
    return kvalues_iq4nl_sh[n & 0xF] | kvalues_iq4nl_sh[16 + ((n >> 8) & 0xF)] |
           kvalues_iq4nl_sh[32 + ((n >> 16) & 0xF)] | kvalues_iq4nl_sh[48 + ((n >> 24) & 0xF)];
}
#endif
#endif

// 16 code bytes -> the 32 weights' int8 values: low nibbles are weights
// 0..15, high nibbles 16..31 (dequantize_row_iq4_nl / _iq4_xs)
#if defined(IQ4_KV_SELECT) && !defined(IQ4_KV_LOCAL)
// the codebook as four packed words, picked with selects and shifts: faster
// than the constant gathers on the A770 (MV_ID 34 -> 28 us, dense 137 -> 120),
// slower on the B60 (130 -> 146; measured-here); the A770's default until 0035
static inline uint kv1(uint i) {
    const uint w = (i & 8) ? ((i & 4) ? 0x71594535u : 0x26190D01u) : ((i & 4) ? 0xF6EADDCFu : 0xBFAD9881u);
    return (w >> (8 * (i & 3))) & 0xFFu;
}
#undef kv4
#define kv4(n) (kv1((n) & 0xF) | (kv1(((n) >> 8) & 0xF) << 8) | (kv1(((n) >> 16) & 0xF) << 16) | (kv1(((n) >> 24) & 0xF) << 24))
#endif
static inline void iq4_expand(uint4 q, uint * w, local const uint * kvt) {
    w[0] = kv4(q.s0 & 0x0F0F0F0Fu);        w[1] = kv4(q.s1 & 0x0F0F0F0Fu);
    w[2] = kv4(q.s2 & 0x0F0F0F0Fu);        w[3] = kv4(q.s3 & 0x0F0F0F0Fu);
    w[4] = kv4((q.s0 >> 4) & 0x0F0F0F0Fu); w[5] = kv4((q.s1 >> 4) & 0x0F0F0F0Fu);
    w[6] = kv4((q.s2 >> 4) & 0x0F0F0F0Fu); w[7] = kv4((q.s3 >> 4) & 0x0F0F0F0Fu);
}

// IQ3_XXS sub-block p of the block at bp (98 bytes, 2-byte aligned): the 32
// weights' signed int8 values and the sub-block scale (dequantize_row_iq3_xxs)
static inline float iq3xxs_expand(global const uchar * bp, int p, uint * w,
                                  local const uint * grid, local const ulong * signs) {
    global const ushort * h = (global const ushort *)bp;
    const float d = vload_half(0, (global const half *)bp);
    // grid indices: qs[8p .. 8p+7] at byte 2 + 8p; scales/signs: qs[64 + 4p]
    const ushort4 gi = vload4(0, h + 1 + 4 * p);
    const uint aux = (uint)h[1 + 32 + 2 * p] | ((uint)h[1 + 32 + 2 * p + 1] << 16);
    const uchar idx[8] = { gi.s0 & 0xFF, gi.s0 >> 8, gi.s1 & 0xFF, gi.s1 >> 8,
                           gi.s2 & 0xFF, gi.s2 >> 8, gi.s3 & 0xFF, gi.s3 >> 8 };
    #pragma unroll
    for (int l = 0; l < 4; ++l) {
        const ulong m = signs[(aux >> (7 * l)) & 127];   // 0xFF in the bytes to negate
        const uint m1 = (uint)m, m2 = (uint)(m >> 32);
        const uint g1 = grid[idx[2 * l]], g2 = grid[idx[2 * l + 1]];
        w[2 * l]     = lb_sgn4(g1, m1);
        w[2 * l + 1] = lb_sgn4(g2, m2);
    }
    return d * (0.5f + (float)(aux >> 28)) * 0.5f;
}

// IQ4_XS sub-block p of the block at bp (136 bytes): values and scale
static inline float iq4xs_expand(global const uchar * bp, int p, uint * w, local const uint * kvt) {
    const float d = vload_half(0, (global const half *)bp);
    const uint sh = ((global const ushort *)bp)[1];
    const uint sl = bp[4 + p / 2];
    const int ls = ((sl >> (4 * (p & 1))) & 0xF) | (((sh >> (2 * p)) & 3) << 4);
    iq4_expand(vload4(0, (global const uint *)(bp + 8 + 16 * p)), w, kvt);
    return d * (float)(ls - 32);
}

static inline void reduce_store(float acc[N_DST][NCOLS], global float * out, ulong ostride, int first_row, int ne01) {
    const int lane = get_sub_group_local_id();
    #pragma unroll
    for (int c = 0; c < NCOLS; ++c) {
        #pragma unroll
        for (int r = 0; r < N_DST; ++r) {
            const float t = sub_group_reduce_add(acc[r][c]);
            if (lane == 0 && first_row + r < ne01) out[c * ostride + first_row + r] = t;
        }
    }
}

static inline int dot4_ss(const uint * w, uint4 x) {
    int a = 0;
    a = dot_acc_sat_4x8packed_ss_int(w[0], x.s0, a);
    a = dot_acc_sat_4x8packed_ss_int(w[1], x.s1, a);
    a = dot_acc_sat_4x8packed_ss_int(w[2], x.s2, a);
    a = dot_acc_sat_4x8packed_ss_int(w[3], x.s3, a);
    return a;
}

// the low-bit types (6..10): one 32-weight sub-block per lane, 16 lanes a
// step, rows of n32 sub-blocks (Q2_0's K need only be a multiple of 64)
// S: the weight slice (its planes), first_row: the first of the rows taken
static inline void mv_lb(const int TYPE, global const uchar * S, int n32, int first_row, int ne01,
                         global const char * xq, global const float * xd, ulong res,
                         global float * out, ulong ostride, local const uint * lt) {
    const int lane = get_sub_group_local_id();
    const int ne00 = n32 * 32;
    const int   nbr  = n32 / LB_SUBS(TYPE);            // blocks a row
    const ulong nblk = (ulong)ne01 * nbr;             // blocks in the slice
    global const char  * xq2 = xq + res;
    global const float * xd2 = xd + res / 32;

    float acc[N_DST][NCOLS];
    #pragma unroll
    for (int r = 0; r < N_DST; ++r)
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;

    for (int b32 = lane; b32 < n32; b32 += 16) {
        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
        float dx[NCOLS], dy[NCOLS];
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) {
            global const char * xc = xq + c * ne00 + b32 * 32;
            global const char * yc = xq2 + c * ne00 + b32 * 32;
            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
        }
        #pragma unroll
        for (int r = 0; r < N_DST; ++r) {
            if (first_row + r >= ne01) break;
            uint w[8];
            float s0, s1;
            lb_expand(TYPE, S, nblk, LB_BI(TYPE, first_row + r, nbr, b32), LB_P(TYPE, b32), w, &s0, &s1, lt);
            #pragma unroll
            for (int c = 0; c < NCOLS; ++c) {
                acc[r][c] += s0 * (dx[c] * (float)dot4_ss(w, xa[c]) + dy[c] * (float)dot4_ss(w, ya[c])) +
                             s1 * (dx[c] * (float)dot4_ss(w + 4, xb[c]) + dy[c] * (float)dot4_ss(w + 4, yb[c]));
            }
        }
    }
    reduce_store(acc, out, ostride, first_row, ne01);
}

// the same for one column with 4 lanes a row, the sub-group's 4 rows side by
// side: a row of n32 sub-blocks that 16 lanes do not divide (Flash-Next's down
// projections, K = 640: 20 sub-blocks left 12 of 16 lanes idle in the second
// pass; 2560 x 640 Q2_0 took 135 us at 3 tokens against 83 for 640 x 2560)
static inline void mv_lb4(const int TYPE, global const uchar * S, int n32, int first_row, int ne01,
                          global const char * xq, global const float * xd, ulong res,
                          global float * out, local const uint * lt) {
    const int lane = get_sub_group_local_id();
    const int row = first_row + (lane >> 2), q = lane & 3;
    const int   nbr  = n32 / LB_SUBS(TYPE);
    const ulong nblk = (ulong)ne01 * nbr;
    global const char  * xq2 = xq + res;
    global const float * xd2 = xd + res / 32;
    float acc = 0.f;
    if (row < ne01) {
        for (int b32 = q; b32 < n32; b32 += 4) {
            global const char * xc = xq + b32 * 32;
            global const char * yc = xq2 + b32 * 32;
            const uint4 xa = vload4(0, (global const uint *)xc), xb = vload4(0, (global const uint *)(xc + 16));
            const uint4 ya = vload4(0, (global const uint *)yc), yb = vload4(0, (global const uint *)(yc + 16));
            const float dx = xd[b32], dy = xd2[b32];
            uint w[8];
            float s0, s1;
            lb_expand(TYPE, S, nblk, LB_BI(TYPE, row, nbr, b32), LB_P(TYPE, b32), w, &s0, &s1, lt);
            acc += s0 * (dx * (float)dot4_ss(w, xa) + dy * (float)dot4_ss(w, ya)) +
                   s1 * (dx * (float)dot4_ss(w + 4, xb) + dy * (float)dot4_ss(w + 4, yb));
        }
    }
    acc += intel_sub_group_shuffle_xor(acc, 1);
#ifndef LB4_RED   // the red case of the 4-lane path's test: half of each row's lanes summed
    acc += intel_sub_group_shuffle_xor(acc, 2);
#endif
    if (q == 0 && row < ne01) out[row] = acc;
}

// TYPE 0: IQ3_XXS, 1: IQ4_XS (row_bytes: the row stride in bytes), 2: IQ4_NL
// flat (q: code plane, dp: scale plane, rows of nb*8 blocks). xq/xd: column
// 0's codes and scales, the residual term at + res.
// IQ4_NL: one 32-block per lane, 16 lanes a step, rows of n32 blocks (K a
// multiple of 32 only: Flash-Next's down projections have K = 640)
static inline void mv_iq4_nl(global const uchar * q, global const half * dp, ulong blk0, int n32, int first_row, int ne01,
                             global const char * xq, global const float * xd, ulong res,
                             global float * out, ulong ostride, local const uint * kvt) {
    const int lane = get_sub_group_local_id();
    const int ne00 = n32 * 32;
    global const char  * xq2 = xq + res;
    global const float * xd2 = xd + res / 32;

    float acc[N_DST][NCOLS];
    #pragma unroll
    for (int r = 0; r < N_DST; ++r)
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;

    for (int b32 = lane; b32 < n32; b32 += 16) {
        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
        float dx[NCOLS], dy[NCOLS];
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) {
            global const char * xc = xq + c * ne00 + b32 * 32;
            global const char * yc = xq2 + c * ne00 + b32 * 32;
            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
        }
        #pragma unroll
        for (int r = 0; r < N_DST; ++r) {
            if (first_row + r >= ne01) break;
            const ulong blk = blk0 + (ulong)r * n32 + b32;
            uint w[8];
            iq4_expand(vload4(0, (global const uint *)(q + blk * 16)), w, kvt);
            const float s = vload_half(blk, dp);
            #pragma unroll
            for (int c = 0; c < NCOLS; ++c) {
                acc[r][c] += s * (dx[c] * (float)dot8_ss(w, xa[c], xb[c]) + dy[c] * (float)dot8_ss(w, ya[c], yb[c]));
            }
        }
    }
    reduce_store(acc, out, ostride, first_row, ne01);
}

// ARC-LAB 0096: dense Q4_0, IQ4_NL's planes and product with kvalue = n - 8
// (dequantize_row_q4_0: low nibbles weights 0..15, high nibbles 16..31)
#define Q40V(n) as_uint(as_char4(n) - (char4)(8))
static inline void q40_expand(uint4 q, uint * w) {
    w[0] = Q40V(q.s0 & 0x0F0F0F0Fu);        w[1] = Q40V(q.s1 & 0x0F0F0F0Fu);
    w[2] = Q40V(q.s2 & 0x0F0F0F0Fu);        w[3] = Q40V(q.s3 & 0x0F0F0F0Fu);
    w[4] = Q40V((q.s0 >> 4) & 0x0F0F0F0Fu); w[5] = Q40V((q.s1 >> 4) & 0x0F0F0F0Fu);
    w[6] = Q40V((q.s2 >> 4) & 0x0F0F0F0Fu); w[7] = Q40V((q.s3 >> 4) & 0x0F0F0F0Fu);
}

static inline void mv_q4_0(global const uchar * q, global const half * dp, ulong blk0, int n32, int first_row, int ne01,
                           global const char * xq, global const float * xd, ulong res,
                           global float * out, ulong ostride) {
    const int lane = get_sub_group_local_id();
    const int ne00 = n32 * 32;
    global const char  * xq2 = xq + res;
    global const float * xd2 = xd + res / 32;

    float acc[N_DST][NCOLS];
    #pragma unroll
    for (int r = 0; r < N_DST; ++r)
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;

    for (int b32 = lane; b32 < n32; b32 += 16) {
        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
        float dx[NCOLS], dy[NCOLS];
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) {
            global const char * xc = xq + c * ne00 + b32 * 32;
            global const char * yc = xq2 + c * ne00 + b32 * 32;
            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
        }
        #pragma unroll
        for (int r = 0; r < N_DST; ++r) {
            if (first_row + r >= ne01) break;
            const ulong blk = blk0 + (ulong)r * n32 + b32;
            uint w[8];
            q40_expand(vload4(0, (global const uint *)(q + blk * 16)), w);
            const float s = vload_half(blk, dp);
            #pragma unroll
            for (int c = 0; c < NCOLS; ++c) {
                acc[r][c] += s * (dx[c] * (float)dot8_ss(w, xa[c], xb[c]) + dy[c] * (float)dot8_ss(w, ya[c], yb[c]));
            }
        }
    }
    reduce_store(acc, out, ostride, first_row, ne01);
}

static inline void mv_iq(const int TYPE, global const uchar * q, global const half * dp, ulong row0_off,
                         ulong row_bytes, int nb, int first_row, int ne01,
                         global const char * xq, global const float * xd, ulong res,
                         global float * out, ulong ostride, local const uint * grid, local const ulong * signs) {
    const int lane = get_sub_group_local_id();
    const int p = lane & 7;
    const int ne00 = nb * QK_K, n32 = nb * 8;
    global const char  * xq2 = xq + res;
    global const float * xd2 = xd + res / 32;

    float acc[N_DST][NCOLS];
    #pragma unroll
    for (int r = 0; r < N_DST; ++r)
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;

    for (int ib = lane >> 3; ib < nb; ib += 2) {
        const int b32 = ib * 8 + p;
        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
        float dx[NCOLS], dy[NCOLS];
        #pragma unroll
        for (int c = 0; c < NCOLS; ++c) {
            global const char * xc = xq + c * ne00 + b32 * 32;
            global const char * yc = xq2 + c * ne00 + b32 * 32;
            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
        }
        #pragma unroll
        for (int r = 0; r < N_DST; ++r) {
            if (first_row + r >= ne01) break;
            uint w[8];
            float s;
            if (TYPE == 0) {
                s = iq3xxs_expand(q + row0_off + (ulong)r * row_bytes + (ulong)ib * 98, p, w, grid, signs);
            } else {
                s = iq4xs_expand(q + row0_off + (ulong)r * row_bytes + (ulong)ib * 136, p, w, (local const uint *)signs);
            }
            #pragma unroll
            for (int c = 0; c < NCOLS; ++c) {
                acc[r][c] += s * (dx[c] * (float)dot8_ss(w, xa[c], xb[c]) + dy[c] * (float)dot8_ss(w, ya[c], yb[c]));
            }
        }
    }
    reduce_store(acc, out, ostride, first_row, ne01);
}

#define FIRST_ROW (int)((get_group_id(0) * N_SIMDGROUP + get_sub_group_id()) * N_DST)

// IQ3_XXS reads its grid and sign tables from local memory: each lane looks
// up its own entries, and gathers from constant memory measured 74 GB/s
// against 200 for the IQ4 types (A770).
// the local table's size in 64-bit words, per type: IQ3_XXS's signs, or a
// low-bit grid (IQ2_XXS or IQ2_XS + signs, IQ1_M); the IQ4 types 128
// IQ2_S and IQ3_S keep constant grids (a local copy per work-group cost more: 146 -> 245, 255 -> 335 us, B60)
#define LB_LT_ULONGS(T) ((T) == 8 ? 2048 : (T) == 11 ? 640 : (T) == 6 ? 384 : 128)
#ifdef IQ4_KV_LOCAL
#define IQ4_LT 1
#ifndef IQ4_LT_RED   // the red case of the test: two codebook entries swapped
#define IQ4_LT_VAL(i) kvalues_iq4nl_sh[i]
#else
#define IQ4_LT_VAL(i) kvalues_iq4nl_sh[(i) ^ 1]
#endif
#else
#define IQ4_LT 0
#define IQ4_LT_VAL(i) 0u
#endif
#define LOCAL_TABLES(TYPE)                                                                     \
    local uint  lgrid[256];                                                                    \
    local ulong lsigns[LB_LT_ULONGS(TYPE)];   /* IQ3_XXS's signs, or a low-bit grid */       \
    {                                                                                          \
        const int lid_ = get_local_linear_id(), lsz_ = get_local_size(0) * get_local_size(1);  \
        local uint * lt_ = (local uint *)lsigns;                                               \
        if ((TYPE) == 0) {                                                                     \
            for (int i_ = lid_; i_ < 256; i_ += lsz_) {                                        \
                lgrid[i_] = iq3xxs_grid[i_];                                                   \
                if (i_ < 128) lsigns[i_] = ksigns64[i_];                                       \
            }                                                                                  \
        } else if ((TYPE) == 6) {                                                              \
            for (int i_ = lid_; i_ < 384; i_ += lsz_) {                                        \
                const ulong v_ = i_ < 256 ? iq2xxs_grid[i_] : ksigns64[i_ - 256];              \
                lt_[2 * i_] = (uint)v_; lt_[2 * i_ + 1] = (uint)(v_ >> 32);                    \
            }                                                                                  \
        } else if ((TYPE) == 11) {                                                             \
            for (int i_ = lid_; i_ < 640; i_ += lsz_) {                                        \
                const ulong v_ = i_ < 512 ? iq2xs_grid[i_] : ksigns64[i_ - 512];               \
                lt_[2 * i_] = (uint)v_; lt_[2 * i_ + 1] = (uint)(v_ >> 32);                    \
            }                                                                                  \
        } else if ((TYPE) == 8) {                                                              \
            for (int i_ = lid_; i_ < 2048; i_ += lsz_) {                                       \
                const ulong v_ = iq1s_grid[i_]; lt_[2 * i_] = (uint)v_; lt_[2 * i_ + 1] = (uint)(v_ >> 32); \
            }                                                                                  \
        } else if (IQ4_LT && ((TYPE) == 1 || (TYPE) == 2)) {                                   \
            for (int i_ = lid_; i_ < 64; i_ += lsz_) lt_[i_] = IQ4_LT_VAL(i_);                 \
        }                                                                                      \
        if ((TYPE) == 0 || (TYPE) == 6 || (TYPE) == 8 || (TYPE) == 11 || (IQ4_LT && ((TYPE) == 1 || (TYPE) == 2))) \
            barrier(CLK_LOCAL_MEM_FENCE);                                                      \
    }

// row byte strides of the blocked types: IQ3_XXS nb*98, IQ4_XS nb*136
#define ROW_BYTES(TYPE, nb) ((ulong)(nb) * ((TYPE) == 0 ? 98 : 136))

// ---- one weight matrix times NCOLS packed columns; dst column c at
// offd + c * nb1. The weights at q + offq; IQ4_NL takes its code plane in `q`
// and scales in `dp`, the others ignore `dp`. ----
#define MV_KERNEL(NAME, TYPE)                                                                  \
__attribute__((intel_reqd_sub_group_size(16)))                                                 \
kernel void NAME(global const uchar * q, ulong offq, global const half * dp,                   \
                 global const char * xq, global const float * xd,                              \
                 global char * dst, ulong offd, ulong nb1, int ne00, int ne01) {               \
    LOCAL_TABLES(TYPE)                                                                         \
    const int first_row = FIRST_ROW;                                                           \
    if (first_row >= ne01) return;                                                             \
    const int nb = ne00 / QK_K;                                                                \
    if ((TYPE) >= 6) {                                                                         \
        mv_lb(TYPE, q + offq, ne00 / 32,                                                       \
              first_row, ne01, xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float), \
              (local const uint *)lsigns);                                                     \
        return;                                                                                \
    }                                                                                          \
    if ((TYPE) == 2) {                                                                         \
        mv_iq4_nl(q + offq, dp, (ulong)first_row * (ne00 / 32), ne00 / 32, first_row, ne01,    \
                  xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float), (local const uint *)lsigns); \
        return;                                                                                \
    }                                                                                          \
    mv_iq(TYPE, q + offq, dp, (ulong)first_row * ROW_BYTES(TYPE, nb), ROW_BYTES(TYPE, nb), nb,        \
          first_row, ne01, xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float), \
          lgrid, lsigns);                                                                      \
}
MV_KERNEL(kernel_mul_mv_iq3_xxs_q8_1, 0)
MV_KERNEL(kernel_mul_mv_iq4_xs_q8_1, 1)
MV_KERNEL(kernel_mul_mv_iq4_nl_q8_1, 2)
__attribute__((intel_reqd_sub_group_size(16)))
kernel void kernel_mul_mv_q4_0_q8_1(global const uchar * q, ulong offq, global const half * dp,
                                    global const char * xq, global const float * xd,
                                    global char * dst, ulong offd, ulong nb1, int ne00, int ne01) {
    const int first_row = FIRST_ROW;
    if (first_row >= ne01) return;
    mv_q4_0(q + offq, dp, (ulong)first_row * (ne00 / 32), ne00 / 32, first_row, ne01,
            xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float));
}
MV_KERNEL(kernel_mul_mv_iq2_xxs_q8_1, 6)
MV_KERNEL(kernel_mul_mv_iq2_s_q8_1, 7)
MV_KERNEL(kernel_mul_mv_iq1_m_q8_1, 8)
MV_KERNEL(kernel_mul_mv_q2_0_q8_1, 9)
MV_KERNEL(kernel_mul_mv_iq3_s_q8_1, 10)
MV_KERNEL(kernel_mul_mv_iq2_xs_q8_1, 11)

// ---- MUL_MAT_ID (NCOLS = 1 builds): pair k = get_group_id(2), slot
// i = k % n_used, token t = k / n_used; expert ids[t][i], column
// (i % ne11) + t * ne11, output dst + t * nb2 + i * nb1; res: the residual
// term's offset (the quantized total) ----
// the order of an expert cache's pairs (a verify's bank pairs, read over the
// link, first or last; GGML_OPENCL_PAIR_ORDER), computed once for the ids a
// layer's three projections share: perm[k] is the pair work-group k takes.
// One work-group of up to 256 lanes, a lane a pair.
kernel void kernel_moe_pair_perm(global const char * ids, ulong offi, ulong nbi1, int n_used, int n_pairs,
                                 int n_split, int bank_first, global int * perm) {
    const int p = get_local_id(0);
    const int id = p < n_pairs ? ((global const int *)(ids + offi + (p / n_used) * nbi1))[p % n_used] : -1;
    const int bank = p < n_pairs && id >= n_split;
    const int rb  = work_group_scan_exclusive_add(bank);
    const int nbk = work_group_reduce_add(bank);
    if (p >= n_pairs) return;
    const int rs = p - rb;   // slot pairs before p
    perm[bank_first == 1 ? (bank ? rb : nbk + rs) : bank_first == 2 ? (bank ? (n_pairs - nbk) + rb : rs) : p] = p;
}

// 4 lanes a row where 16 do not divide a row's sub-blocks (N_DST 4 rows a
// sub-group); -DLB_NO_LB4 keeps 16 lanes a row
#if N_DST == 4 && !defined(LB_NO_LB4)
#define MV_LB4 1
#else
#define MV_LB4 0
#endif

#define MV_ID_KERNEL(NAME, TYPE)                                                               \
__attribute__((intel_reqd_sub_group_size(16)))                                                 \
kernel void NAME(global const uchar * q, ulong offq, global const half * dp,                   \
                 global const char * xq, global const float * xd,                              \
                 global const char * ids, ulong offi, ulong nbi1, int n_used, int ne11,        \
                 global char * dst, ulong offd, ulong nb1, ulong nb2, int ne00, int ne01, ulong res, \
                 global const uchar * q2, global const half * dp2, int n_split,                \
                 global const int * perm) {                                                    \
    LOCAL_TABLES(TYPE)                                                                         \
    const int k = perm != 0 ? perm[get_group_id(2)] : (int)get_group_id(2);                   \
    const int i = k % n_used, t = k / n_used;                                                  \
    int e = ((global const int *)(ids + offi + t * nbi1))[i];                                  \
    const int first_row = FIRST_ROW;                                                           \
    if (first_row >= ne01) return;                                                             \
    const int nb = ne00 / QK_K;                                                                \
    /* an expert cache's single branch: ids >= n_split are bank experts, gathered into the     \
       mirror q2 / dp2 at e - n_split */                                                       \
    if (e >= n_split) { q = q2; offq = 0; dp = dp2; e -= n_split; }                            \
    if (e < 0) {   /* an expert cache's other branch: this pair's rows are zero */            \
        global float * zo = (global float *)(dst + offd + t * nb2 + i * nb1);                 \
        if (get_sub_group_local_id() == 0)                                                     \
            for (int r = 0; r < N_DST; ++r)                                                    \
                if (first_row + r < ne01) zo[first_row + r] = 0.0f;                            \
        return;                                                                                \
    }                                                                                          \
    const int col = (i % ne11) + t * ne11;                                                     \
    if ((TYPE) >= 6) {                                                                         \
        if (MV_LB4 && (ne00 / 32) % 16 != 0 && (ne00 / 32) % 4 == 0) {                         \
            mv_lb4(TYPE, q + offq + (ulong)e * ne01 * LB_ROW_BYTES(TYPE, ne00 / 32), ne00 / 32, \
                   first_row, ne01, xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res, \
                   (global float *)(dst + offd + t * nb2 + i * nb1), (local const uint *)lsigns); \
            return;                                                                            \
        }                                                                                      \
        mv_lb(TYPE, q + offq + (ulong)e * ne01 * LB_ROW_BYTES(TYPE, ne00 / 32), ne00 / 32,     \
              first_row, ne01, xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res,     \
              (global float *)(dst + offd + t * nb2 + i * nb1), 0, (local const uint *)lsigns);   \
        return;                                                                                \
    }                                                                                          \
    if ((TYPE) == 2) {                                                                         \
        mv_iq4_nl(q + offq, dp, ((ulong)e * ne01 + first_row) * (ne00 / 32), ne00 / 32, first_row, ne01, \
                  xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res,                  \
                  (global float *)(dst + offd + t * nb2 + i * nb1), 0, (local const uint *)lsigns); \
        return;                                                                                \
    }                                                                                          \
    mv_iq(TYPE, q + offq, dp, ((ulong)e * ne01 + first_row) * ROW_BYTES(TYPE, nb), ROW_BYTES(TYPE, nb), nb, \
          first_row, ne01, xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res,         \
          (global float *)(dst + offd + t * nb2 + i * nb1), 0, lgrid, lsigns);                 \
}
MV_ID_KERNEL(kernel_mul_mv_id_iq3_xxs_q8_1, 0)
MV_ID_KERNEL(kernel_mul_mv_id_iq4_xs_q8_1, 1)
MV_ID_KERNEL(kernel_mul_mv_id_iq4_nl_q8_1, 2)
MV_ID_KERNEL(kernel_mul_mv_id_iq2_xxs_q8_1, 6)
MV_ID_KERNEL(kernel_mul_mv_id_iq2_s_q8_1, 7)
MV_ID_KERNEL(kernel_mul_mv_id_iq1_m_q8_1, 8)
MV_ID_KERNEL(kernel_mul_mv_id_q2_0_q8_1, 9)
MV_ID_KERNEL(kernel_mul_mv_id_iq3_s_q8_1, 10)
MV_ID_KERNEL(kernel_mul_mv_id_iq2_xs_q8_1, 11)

// ---- F16 weights (BF16 is stored as F16 on the device) times 2 to 8 f32
// columns, as a verify window or an MTP step brings them: each weight row
// is read once for all columns (the tiled GEMM computes a 64-column tile and
// read 2-8 columns at ~42 GB/s of weights on the B60). Sub-group: 4 rows,
// lanes over K in 8-half steps; dst column c at offd + c * nb1. ----
__attribute__((intel_reqd_sub_group_size(16)))
kernel void kernel_mul_mv_f16_f32_nc(global const char * a, ulong offa, global const char * b, ulong offb, ulong nb11,
                                     global char * d, ulong offd, ulong nb1, int ne00, int ne01, int ncols) {
    const int first_row = (int)((get_group_id(0) * get_num_sub_groups() + get_sub_group_id()) * 4);
    if (first_row >= ne01) return;
    const int lane = get_sub_group_local_id();
    global const half * w0 = (global const half *)(a + offa);
    float acc[4][8];
    #pragma unroll
    for (int r = 0; r < 4; ++r)
        #pragma unroll
        for (int c = 0; c < 8; ++c) acc[r][c] = 0.f;
    for (int k = lane * 8; k < ne00; k += 16 * 8) {
        float8 x[8];
        #pragma unroll
        for (int c = 0; c < 8; ++c)
            x[c] = c < ncols ? vload8(0, (global const float *)(b + offb + (ulong)c * nb11) + k) : (float8)(0.f);
        #pragma unroll
        for (int r = 0; r < 4; ++r) {
            if (first_row + r >= ne01) break;
            const float8 w = vload_half8(0, w0 + (ulong)(first_row + r) * ne00 + k);
            #pragma unroll
            for (int c = 0; c < 8; ++c)
                acc[r][c] += dot(w.lo, x[c].lo) + dot(w.hi, x[c].hi);
        }
    }
    #pragma unroll
    for (int r = 0; r < 4; ++r) {
        #pragma unroll
        for (int c = 0; c < 8; ++c) {
            const float t = sub_group_reduce_add(acc[r][c]);
            if (lane == 0 && c < ncols && first_row + r < ne01)
                ((global float *)(d + offd + (ulong)c * nb1))[first_row + r] = t;
        }
    }
}

// ---- F16 weights with few output rows and a long K (a hyper-connection's
// inject: 4 rows of 10,240; a shared-expert gate: 1 row of 2,560) times 1 to
// 8 columns: one 256-wide work-group per row splits K (one work-group a row of
// 64 lanes walked K alone: ~30 us for an 80 KB read on the B60). ----
__attribute__((intel_reqd_sub_group_size(16)))
kernel void kernel_mul_mv_f16_f32_ksplit(global const char * a, ulong offa, global const char * b, ulong offb, ulong nb11,
                                         global char * d, ulong offd, ulong nb1, int ne00, int ne01, int ncols) {
    local float part[16][8];
    const int row = get_group_id(0);
    const int lid = get_local_id(0);
    global const half * w0 = (global const half *)(a + offa) + (ulong)row * ne00;
    float acc[8];
    #pragma unroll
    for (int c = 0; c < 8; ++c) acc[c] = 0.f;
    for (int k = lid * 8; k < ne00; k += 256 * 8) {
        const float8 w = vload_half8(0, w0 + k);
        #pragma unroll
        for (int c = 0; c < 8; ++c) {
            if (c < ncols) {
                const float8 x = vload8(0, (global const float *)(b + offb + (ulong)c * nb11) + k);
                acc[c] += dot(w.lo, x.lo) + dot(w.hi, x.hi);
            }
        }
    }
    const int sg = get_sub_group_id();
    #pragma unroll
    for (int c = 0; c < 8; ++c) {
        const float t = sub_group_reduce_add(acc[c]);
        if (get_sub_group_local_id() == 0) part[sg][c] = t;
    }
    barrier(CLK_LOCAL_MEM_FENCE);
    if (lid < ncols) {
        float t = 0.f;
        for (int i = 0; i < 16; ++i) t += part[i][lid];
        ((global float *)(d + offd + (ulong)lid * nb1))[row] = t;
    }
}

// ---- the DeepSeek-V4-style hyper-connection ops (GGML_OP_DSV4_HC_PRE /
// _POST, as ggml-sycl/dsv4-hc.cpp computes them): Qwen3.8-Flash-Next's mixers
// were ~17 small ops a layer half on this backend. Strides in bytes. ----
kernel void kernel_dsv4_hc_pre(global const char * x, ulong offx, global const char * w, ulong offw,
                               global char * d, ulong offd, int n_embd, int hc, int n_tok,
                               ulong sx0, ulong sx1, ulong sx2, ulong sw0, ulong sw1, ulong sw2,
                               ulong sd0, ulong sd1, float scale, int gated) {
    const int ir = get_global_id(0);
    if (ir >= n_embd * n_tok) return;
    const int i0 = ir % n_embd, it = ir / n_embd;
    x += offx; w += offw; d += offd;
    float sum = 0.f;
    for (int ih = 0; ih < hc; ++ih) {
        const float xv = *(global const float *)(x + i0 * sx0 + ih * sx1 + it * sx2);
        float wv;
        if (gated) {
            const float gv = *(global const float *)(w + i0 * sw0 + ih * sw1 + it * sw2);
            wv = 1.0f / (1.0f + exp(-gv));
        } else {
            wv = *(global const float *)(w + ih * sw0 + it * sw1);
        }
        sum += xv * wv;
    }
    *(global float *)(d + i0 * sd0 + it * sd1) = scale * sum;
}

// identity comb: every stream keeps its own residual and adds the block output
// scaled by its weight
kernel void kernel_dsv4_hc_post(global const char * x, ulong offx, global const char * r, ulong offr,
                                global const char * p, ulong offp, global char * d, ulong offd,
                                int n_embd, int hc, int n_tok, ulong sx0, ulong sx1,
                                ulong sr0, ulong sr1, ulong sr2, ulong sp0, ulong sp1,
                                ulong sd0, ulong sd1, ulong sd2) {
    const int ir = get_global_id(0);
    if (ir >= n_embd * hc * n_tok) return;
    const int i0 = ir % n_embd, idst = (ir / n_embd) % hc, it = ir / (n_embd * hc);
    x += offx; r += offr; p += offp; d += offd;
    const float v = *(global const float *)(x + i0 * sx0 + it * sx1) * *(global const float *)(p + idst * sp0 + it * sp1) +
                    *(global const float *)(r + i0 * sr0 + idst * sr1 + it * sr2);
    *(global float *)(d + i0 * sd0 + idst * sd1 + it * sd2) = v;
}

// ---- the MoE router's top-k in one kernel (llama.cpp's CUDA topk_moe fusion):
// softmax over a token's logits, the k largest in descending order (ties: the
// lower expert), and their probabilities normalized by their clamped sum.
//
// One sub-group handles one token, TOPK_MOE_TOKENS_PER_WG tokens a work-group,
// so decode (1..5 tokens) fills a whole work-group and prefill keeps the GPU
// busy. The token's probabilities live in one register per expert per lane
// (expert i = lane + TOPK_MOE_SG_SIZE * j), and the row max, the probability
// sum and the k selections are sub-group reductions only: no local memory and
// no barrier inside a token. GGML_OPENCL_TOPK_MOE_LEGACY=1 selects the old
// work-group-per-token kernel below. ----
#define TOPK_MAX_EXPERT          1024
#define TOPK_MAX_K              32
#define TOPK_MOE_SG_SIZE        16
#ifndef TOPK_MOE_TOKENS_PER_WG
#define TOPK_MOE_TOKENS_PER_WG  4
#endif

// One kernel per NPER bucket, so the private array is only as large as the
// token's expert count needs: NPER = 4, 8, 16, 32, 64 for n_expert <= 64, 128,
// 256, 512, 1024. A larger bucket is harmless but spills registers, so the
// host picks the smallest bucket whose NPER * 16 covers n_expert.
#define TOPK_MOE_BODY(NPER) \
    const int sg = get_sub_group_id(), ln = get_sub_group_local_id(); \
    const int t = get_group_id(0) * TOPK_MOE_TOKENS_PER_WG + sg; \
    if (t >= n_tok) return; \
    \
    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1); \
    global int * io = (global int *)(ids + offi + (ulong)t * nbi1); \
    global float * wo = (global float *)(w + offw + (ulong)t * nbw1); \
    \
    /* p[j]: expert i = ln + TOPK_MOE_SG_SIZE * j; sel: bit j = p[j] taken */ \
    float p[NPER]; \
    ulong sel = 0; \
    float m = -INFINITY; \
    _Pragma("unroll") \
    for (int j = 0; j < NPER; ++j) { \
        const int i = ln + TOPK_MOE_SG_SIZE * j; \
        p[j] = i < n_expert ? x[i] : -INFINITY; \
        m = fmax(m, p[j]); \
    } \
    m = sub_group_reduce_max(m); \
    float s = 0.0f; \
    _Pragma("unroll") \
    for (int j = 0; j < NPER; ++j) { \
        const int i = ln + TOPK_MOE_SG_SIZE * j; \
        if (i < n_expert) { p[j] = exp(p[j] - m); s += p[j]; } \
    } \
    s = sub_group_reduce_add(s); \
    \
    float wsum = 0.0f; \
    for (int j = 0; j < k; ++j) { \
        float bv = -1.0f; \
        int   bi = INT_MAX; \
        _Pragma("unroll") \
        for (int q = 0; q < NPER; ++q) { \
            if ((sel & (1UL << q)) == 0 && p[q] > bv) { bv = p[q]; bi = ln + TOPK_MOE_SG_SIZE * q; } \
        } \
        const float gv = sub_group_reduce_max(bv); \
        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX); \
        if (ln == 0) { io[j] = gi; wo[j] = gv / s; wsum += gv / s; } \
        if (gi < n_expert && (gi & (TOPK_MOE_SG_SIZE - 1)) == ln) sel |= 1UL << (gi / TOPK_MOE_SG_SIZE); \
    } \
    if (ln == 0) { \
        const float sum = clamp(wsum, cmin, cmax); \
        for (int j = 0; j < k; ++j) wo[j] = wo[j] / sum; \
    }

#define TOPK_MOE_KERNEL(N) \
__attribute__((intel_reqd_sub_group_size(TOPK_MOE_SG_SIZE))) \
kernel void kernel_topk_moe_softmax_norm_n##N(global const char * lg, ulong offl, ulong nbl1, \
                                         global char * ids, ulong offi, ulong nbi1, \
                                         global char * w, ulong offw, ulong nbw1, \
                                         int n_expert, int k, int n_tok, float cmin, float cmax) { \
    TOPK_MOE_BODY(N) \
}

TOPK_MOE_KERNEL(4)
TOPK_MOE_KERNEL(8)
TOPK_MOE_KERNEL(16)
TOPK_MOE_KERNEL(32)
TOPK_MOE_KERNEL(64)

// the previous version: one work-group (256 work-items) per token, the
// probabilities and the selection in local memory
__attribute__((intel_reqd_sub_group_size(16)))
kernel void kernel_topk_moe_softmax_norm_legacy(global const char * lg, ulong offl, ulong nbl1,
                                         global char * ids, ulong offi, ulong nbi1,
                                         global char * w, ulong offw, ulong nbw1,
                                         int n_expert, int k, float cmin, float cmax) {
    local float p[TOPK_MAX_EXPERT];
    local float red[16];
    local float sv[16];
    local int   si[16];
    local float wt[TOPK_MAX_K];
    const int t = get_group_id(0), lid = get_local_id(0), sg = get_sub_group_id(), ln = get_sub_group_local_id();
    const int nsg = get_num_sub_groups();
    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1);

    float m = -INFINITY;
    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float v = x[i]; p[i] = v; m = fmax(m, v); }
    m = sub_group_reduce_max(m);
    if (ln == 0) red[sg] = m;
    barrier(CLK_LOCAL_MEM_FENCE);
    m = red[0];
    for (int j = 1; j < nsg; ++j) m = fmax(m, red[j]);
    barrier(CLK_LOCAL_MEM_FENCE);
    float s = 0.f;
    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float e = exp(p[i] - m); p[i] = e; s += e; }
    s = sub_group_reduce_add(s);
    if (ln == 0) red[sg] = s;
    barrier(CLK_LOCAL_MEM_FENCE);
    s = 0.f;
    for (int j = 0; j < nsg; ++j) s += red[j];

    for (int j = 0; j < k; ++j) {
        float bv = -1.f;
        int   bi = INT_MAX;
        for (int i = lid; i < n_expert; i += get_local_size(0)) {
            const float v = p[i];
            if (v > bv) { bv = v; bi = i; }
        }
        const float gv = sub_group_reduce_max(bv);
        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX);
        if (ln == 0) { sv[sg] = gv; si[sg] = gi; }
        barrier(CLK_LOCAL_MEM_FENCE);
        if (lid == 0) {
            float b = sv[0];
            int   bix = si[0];
            for (int q = 1; q < nsg; ++q)
                if (sv[q] > b || (sv[q] == b && si[q] < bix)) { b = sv[q]; bix = si[q]; }
            ((global int *)(ids + offi + (ulong)t * nbi1))[j] = bix;
            wt[j] = b / s;
            p[bix] = -1.f;
        }
        barrier(CLK_LOCAL_MEM_FENCE);
    }
    if (lid == 0) {
        float sum = 0.f;
        for (int j = 0; j < k; ++j) sum += wt[j];
        sum = clamp(sum, cmin, cmax);
        global float * wo = (global float *)(w + offw + (ulong)t * nbw1);
        for (int j = 0; j < k; ++j) wo[j] = wt[j] / sum;
    }
}

// ---- SCALE -> SILU and SCALE -> SIGMOID -> SCALE in one pass (contiguous
// f32): the hyper-connection mixer's silu(x / hc) and combine's
// 2 sigmoid(x / hc), ~290 small kernels a Flash-Next graph ----
kernel void kernel_scale_act_f32(global const char * x, ulong offx, global char * d, ulong offd, int n,
                                 float s1, float b1, float s2, int act) {
    const int i = get_global_id(0);
    if (i >= n) return;
    const float v = ((global const float *)(x + offx))[i] * s1 + b1;
    const float r = act == 0 ? v / (1.0f + exp(-v)) : s2 / (1.0f + exp(-v));
    ((global float *)(d + offd))[i] = r;
}
