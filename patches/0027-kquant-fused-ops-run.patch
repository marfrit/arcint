+        const OUTPUT_TYPE dq_out = TO_OUTPUT_TYPE(ACTIVATION_TYPED(dequantized, ACTIVATION_PARAMS_TYPED));
         FUSED_OPS;
         output[dst_index] = FUSED_OPS_RESULT;
 #else
