# The K-quant kernel's fused ops run: the runtime fusion check accepts the kernel

# Applied against the pinned runtime, build 2026.4.0-22849-71640275d29, on top of
# patches/0003-0026. arcint 0.4.1 (DESIGN.md section 7.0.2bk).
#
# What changes:
#   primitive_inst.cpp  is_valid_fusion(): for a dynamic OCL fully-connected node the check accepted
#                       a fused eltwise only on the bf_tiled and bfyx_ref kernels; every K-quant node
#                       with a fused eltwise (the residual add after each down and output projection,
#                       the MLP's Swish and Multiply on the native form) was declared invalid every
#                       step and executed through the unfused-subgraph fallback -- a separate
#                       sub-network whose output read (network_output::get_memory) drains the queue
#                       on an in-order stream: 79 clFinish per served decode step of the dense GGUF
#                       model, 25 ms inside them, the card idle at each. The kernel's own FUSED_OPS
#                       (patch 0021) had never executed. Now accepted by name.
#   fully_connected_gpu_kquant.cl, fully_connected_kernel_kquant.cpp   The fused ops take the value
#                       the unfused path would have stored -- the sum rounded to the output type --
#                       so fusing changes no bit of the served output.
#   fully_connected_gpu_test.cpp   Five correctness cases with a residual add fused into the op
#                       (the decode and the tiled variant, both Q6_K layouts, Q5_K, Q4_K; the
#                       residual a dynamic input, as in the served graph), each checking that the
#                       eltwise is no longer a primitive of its own and that the output matches the
#                       unfused rounding. A constant [1, M, N] residual makes the plugin's own fusing
#                       throw "get_dims() is called for dynamic shape" -- not this patch's path.
#
# MEASURED 2026-09-07 (correctness 21/21 on both cards): served on the 24 GB card, mixed form with
# the 224-byte Q6_K layout, u8 KV, one fresh process per cell, against 0026 on the same base:
# the decode step 59.8 -> 54.7 ms at 856 tokens (17.2 t/s; Pruefstand 10/10 at 18.4 over its
# 1,145 tokens against 17.0) and 77.7 -> 73.3 at 71,727 (11.1 t/s); greedy outputs byte-identical
# at both depths; prefill 551 / 341 t/s. clFinish over the whole traced process: 6,663 with 0026,
# 1,064 with this patch -- the per-step count from 81 to the IR's 2 (the load's are the same).
# The timing test after this build: the type-114 rows read 2.7 ms per launch on the first run
# and 202 us on the rerun (the cold-cache stall of a freshly compiled kernel, DESIGN 7.0.2bd).

--- a/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
+++ b/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
@@ -3080,8 +3080,13 @@
         // TODO: Only fc_bf_tiled_kernel & ref kernel are verified for fused eltwise. To support more fc kernels for eltwise fusion
         if (!get_node().get_selected_impl())
             LOG_AND_RETURN_FALSE(_node);
+        // arcint (patch 0027): the K-quant kernel carries FUSED_OPS on its store in both variants
+        // (patch 0021); without this line every fused eltwise on a K-quant node ran through the
+        // unfused subgraph, whose output read drains the queue (79 clFinish per served decode
+        // step of the dense GGUF model, DESIGN 7.0.2bk).
         if (!data_type_traits::is_i8_u8(get_node().get_input_layout(0).data_type) &&
             (get_node().get_selected_impl()->get_kernel_name().find("fully_connected_gpu_bf_tiled") == std::string::npos) &&
+            (get_node().get_selected_impl()->get_kernel_name().find("fully_connected_gpu_kquant") == std::string::npos) &&
             (get_node().get_selected_impl()->get_kernel_name().find("fully_connected_gpu_bfyx_ref") == std::string::npos)) {
             LOG_AND_RETURN_FALSE(_node);
         }
--- a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/fully_connected_gpu_kquant.cl
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/fully_connected_gpu_kquant.cl
@@ -326,6 +326,9 @@
         ACTIVATION_TYPE dequantized = TO_ACTIVATION_TYPE(sum);
 #endif
 #if HAS_FUSED_OPS
+        // The fused eltwise/activation sees the value the unfused path would have stored (the
