+// Q6_K in the block-read shape: lane l holds, in each of the eight 32-value runs, the values
+// at positions 2l and 2l + 1 -- the activations of a 128-value half are one block_read4
+// (lane l gets dwords l + 16 r: run r, positions 2l, 2l + 1). The 210-byte blocks are only
+// 2-aligned and a block read needs a dword address (measured: a 16-bit block read two bytes
+// off returns the neighbour's word on every lane but the first), so the 128 ql bytes and the
+// 64 qh bytes are block-read as dwords from the dword at or below the block (two reads per
+// row) and each lane takes its word from the lane that holds it with one shuffle; the one
+// word an odd block's last lane needs past those reads is a uniform load. The sixteen
+// scales are one uniform load, each lane selecting its byte. No min.
+inline float kq_row_q6k_x(const __global uchar* blk, uint lane, float16 x) {
+    const uint odd = ((uint)(ulong)blk >> 1) & 1u;          // the block starts two bytes past a dword
+    const __global uchar* b4 = blk - 2 * odd;
+    const float d = kq_f16at(blk + 208);
+    const uint w = lane + odd, src = w >> 1, hi = (w & 1) * 16;   // this lane's word, in words from b4
+    const uint2 dq = intel_sub_group_block_read2((const __global uint*)b4);          // ql: lane l holds dwords l and 16 + l
+    const uint dh = intel_sub_group_block_read((const __global uint*)(b4 + 128));    // qh: lane l holds dword 32 + l
+    const uint tail = (uint)*(const __global ushort*)(blk + 190);                    // qh's last word (dword 48 for an odd block)
+    const ushort8 sw = vload8(0, (const __global ushort*)(blk + 192));               // the 16 scale bytes
+    float acc = 0.0f;
+    __attribute__((opencl_unroll_hint(2)))
+    for (uint h = 0; h < 2; ++h) {
+        const uint qlh = h == 0 ? dq.s0 : dq.s1;                                       // ql half h: dwords 16h .. 16h+15
+        const uint g0 = intel_sub_group_shuffle(qlh, src) >> hi;                       // values 0..31 of the half: word 32h + w
+        const uint g1a = intel_sub_group_shuffle(qlh, (8 + src) & 15u);                // values 32..63: word 32h + 16 + w
+        const uint g1b = intel_sub_group_shuffle(h == 0 ? dq.s1 : dh, 0u);             //   (the lane past the half: the next read's first dword)
