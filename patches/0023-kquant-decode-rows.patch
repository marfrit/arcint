+
+// ---- the decode variant in llama.cpp's shape (patch 0023, DESIGN 7.0.2bc) ----
+//
+// A subgroup takes one super-block per iteration, its sixteen lanes along K. Q4_K/Q5_K
+// (kq_row_q4k_x): lane l holds, in every one of the eight sub-blocks, the values at
+// positions l and l + 16 -- the 128 quant bytes are one intel_sub_group_block_read_uc8
+// (lane l gets bytes l + 16 i, i < 8: sub-block pair i / 2, position 16 (i % 2) + l, low
+// nibble the even sub-block, high nibble the odd one), the 256 activations one
+// block_read_us16 (lane l gets x[l + 16 t]: sub-block t / 2, position 16 (t % 2) + l),
+// loaded once per super-block by the kernel and shared by its rows. The eight scale/min
+// pairs are decoded by lanes 0..7, one each, and broadcast; the min term is the pair sums
+// times the mins. Q6_K (kq_row_q6k_x): dword block reads and a shuffle, below. Q8_0
+// (kq_row_q8_0_piece): lane l reads its own bytes and activations. f32 accumulation over f16 activations,
+// exact, no activation quantisation.
+
+// Q8_0: a subgroup takes eight 32-value blocks (256 values, 272 bytes); lane l takes half a
+// block: block l / 2, values 16 (l % 2) .. +16.
+inline float kq_row_q8_0_piece(const __global uchar* blk8, uint lane, const __global half* xsb) {
+    const __global uchar* b = blk8 + (lane >> 1) * 34;
+    const float d = kq_f16at(b);
+    const ushort8 q = vload8(0, (const __global ushort*)(b + 2 + (lane & 1) * 16));
+    const float16 x = convert_float16(vload16(0, xsb + (lane >> 1) * 32 + (lane & 1) * 16));
+    float acc = 0.0f;
+    __attribute__((opencl_unroll_hint(8)))
+    for (int i = 0; i < 8; ++i) {
+        const int q0 = (int)(char)(q[i] & 0xFFu), q1 = (int)(char)(q[i] >> 8);
+        acc = fma(x[2 * i], (float)q0, acc);
+        acc = fma(x[2 * i + 1], (float)q1, acc);
+    }
+    return d * acc;
+}
+
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups_char : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups_short : enable
+// ---- v18: the activation super-block is loaded once per work-group iteration (block read,
+// converted once, pair sums once) and shared by the KQ_ROWS rows; the eight scale/min
+// pairs of a row's super-block are decoded by lanes 0..7 (one pair each) and broadcast.
+inline float kq_row_q4k_x(const __global uchar* blk, uint lane, float16 x, float8 xp, uint fifth) {
+    const uint4 h = vload4(0, (const __global uint*)blk);
+    const float d = kq_f16bits(h.s0), dmin = kq_f16bits(h.s0 >> 16);
+    uint sc = 0, mn = 0;
+    if (lane < 8) kq_scale_min_k4(lane, h.s1, h.s2, h.s3, &sc, &mn);
+    const float dl_me = d * (float)sc, ml_me = dmin * (float)mn;
+    const uchar8 q = intel_sub_group_block_read_uc8(blk + (fifth ? 48 : 16));
+    uchar2 qh = (uchar2)(0, 0);
+    if (fifth) qh = intel_sub_group_block_read_uc2(blk + 16);
+    float acc = 0.0f;
+    __attribute__((opencl_unroll_hint(8)))
+    for (uint i = 0; i < 8; ++i) {
+        const uint P = i >> 1, m = i & 1;
+        const uint lo = q[i] & 0xFu, hi = q[i] >> 4;
+        uint f_lo = 0, f_hi = 0;
+        if (fifth) { f_lo = ((qh[m] >> (2 * P)) & 1u) << 4; f_hi = ((qh[m] >> (2 * P + 1)) & 1u) << 4; }
+        acc = fma(x[4 * P + m],     sub_group_broadcast(dl_me, 2 * P)     * (float)(lo | f_lo), acc);
+        acc = fma(x[4 * P + 2 + m], sub_group_broadcast(dl_me, 2 * P + 1) * (float)(hi | f_hi), acc);
+    }
+    __attribute__((opencl_unroll_hint(8)))
+    for (uint s = 0; s < 8; ++s) acc = fma(-sub_group_broadcast(ml_me, s), xp[s], acc);
+    return acc;
+}
