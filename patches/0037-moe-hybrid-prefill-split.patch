+// ----- arcint (patch 0037). Red-first: get_expert_mask_from_gpu sentinel skip -----
+// Under the hybrid prefill path, batch_mem_ptr may contain sentinel entries
+// (expert_no >= max_expert_num) for non-resident experts. Before this patch,
+// get_expert_mask_from_gpu throws on any such entry. With this patch, sentinel
+// entries are skipped and the count assertion accounts for them.
+//
+// This test is RED on the unpatched tree (OPENVINO_THROW on sentinel) and
+// GREEN with the patch (sentinel entries skipped, assertion holds).
+//
+// Host-only: no GPU, no OTD provider, no stream. Uses the same
+// build_expert_mask_cpu helper the existing tests use, extended to accept
+// sentinels.
+namespace {
+
+void build_expert_mask_cpu_with_sentinel(const int32_t* topk_id_buf, int max_tokens, int max_topk,
+                                          int max_expert_num, expert_mask_test_result& result, int& skipped) {
+    result.pred_flag.assign(max_expert_num, 0);
+    result.batch.assign(max_expert_num, {});
+    result.topk.assign(max_expert_num, {});
+    skipped = 0;
+    for (int b = 0; b < max_tokens; b++) {
+        auto* tok_p = &topk_id_buf[b * max_topk];
+        for (int t = 0; t < max_topk; t++) {
+            auto expert_no = tok_p[t];
+            if (expert_no >= max_expert_num) {
+                ++skipped;
+                continue;
+            }
+            result.batch[expert_no].push_back(b);
+            result.topk[expert_no].push_back(t + b * max_topk);
+            result.pred_flag[expert_no] = 1;
+        }
+    }
+}
+
+}  // namespace
