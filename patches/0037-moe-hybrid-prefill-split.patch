+TEST(moe_hybrid_prefill, get_expert_mask_sentinel_skip) {
+    // 4 tokens, top_k=2, 8 experts. Sentinel = num_expert = 8.
+    const int max_tokens = 4;
+    const int max_topk = 2;
+    const int max_expert_num = 8;
+    const int32_t sentinel = max_expert_num;  // one past last valid
+
+    // Token 0: experts 0, 1 (both resident)
+    // Token 1: expert 2 + sentinel (one resident, one non-resident)
+    // Token 2: sentinel, sentinel (both non-resident)
+    // Token 3: expert 7, expert 3 (both resident)
+    std::vector<int32_t> topk_ids = {0, 1, 2, sentinel, sentinel, sentinel, 7, 3};
+
+    expert_mask_test_result ref;
+    int ref_skipped = 0;
+    build_expert_mask_cpu_with_sentinel(topk_ids.data(), max_tokens, max_topk, max_expert_num, ref, ref_skipped);
+    ASSERT_EQ(ref_skipped, 3);  // 3 sentinel entries
+
+    int count = 0;
+    for (int e = 0; e < max_expert_num; ++e)
+        count += static_cast<int>(ref.batch[e].size());
+    ASSERT_EQ(count + ref_skipped, max_topk * max_tokens);
+
+    // Verify specific expert assignments
+    ASSERT_EQ(ref.pred_flag[0], 1);  // expert 0: token 0
+    ASSERT_EQ(ref.pred_flag[2], 1);  // expert 2: token 1
+    ASSERT_EQ(ref.pred_flag[4], 0);  // expert 4: never routed
+    ASSERT_EQ(ref.batch[0].size(), 1u);  // expert 0: 1 token
+    ASSERT_EQ(ref.batch[7].size(), 1u);  // expert 7: 1 token
+}
