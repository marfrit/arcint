+// arcint VENICE (patches/0044). Per-call routing trace. The counter is
+// process-wide so <call_seq> orders every layer's calls in one file even
+// though providers are driven by different streams; the mutex serializes the
+// appends. One line per call, flushed immediately so a SIGKILL'd window keeps
+// every record already written (the aggregate dump above only runs at exit).
+std::atomic<size_t>& otd_trace_seq_counter() {
+    static std::atomic<size_t> counter{0};
+    return counter;
+}
+
+std::mutex& otd_trace_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+void otd_trace_append(const std::string& path, size_t layer_key, size_t top_k,
+                      const std::vector<uint32_t>& experts) {
+    std::lock_guard<std::mutex> lock(otd_trace_mutex());
+    const size_t seq = otd_trace_seq_counter().fetch_add(1, std::memory_order_relaxed);
+    std::ofstream out(path, std::ios::app);
+    if (!out.is_open()) {
+        std::cerr << "[OTD_PERF] routing_trace: failed to open " << path << " for writing" << std::endl;
+        return;
+    }
+    out << seq << ' ' << layer_key << ' ' << top_k;
+    for (const uint32_t expert : experts)
+        out << ' ' << expert;
+    out << '\n';
+    out.flush();
+}
+
 }  // namespace
 
