+// arcint (patch 0066). The tier's native stage over several jobs runs one job
+// per AVX2 lane (native_dot_jobs_avx2); a job's f32 sums must be the per-job
+// scalar stage's, bit for bit -- compared here at f32, where the f16 outputs of
+// the whole-expert cell above could not see a last-bit change (a mutant that
+// let the lanes contract to FMA passed that cell and fails this one). K is
+// Flash-Next's hidden size.
+TEST(moe_cpu_expert_native, the_stage_over_several_jobs_gives_each_job_the_scalar_sums_bitwise) {
+    using ov::intel_gpu::ocl::moe::compute_stage_f32_jobs;
+    // Off the SIMD route the stage runs the scalar loop for every job and the
+    // comparison would be the scalar loop against itself: say so, not pass.
+#if !defined(OV_MOE_CPU_TIER_HAVE_AVX2)
+    GTEST_SKIP() << "built without OV_MOE_CPU_TIER_HAVE_AVX2: the AVX2 lanes are not compiled";
+#else
+    if (!ov::with_cpu_x86_avx2())
+        GTEST_SKIP() << "no AVX2 on this CPU: the stage takes the scalar loop";
+#endif
+    // N = 15 rows: passes of 4, 4, 4 and 3 rows; J = 11: a full 8-lane block
+    // and a 3-lane tail.
+    const int K = 2560, N = 15, J = 11;
+    std::mt19937 rng(11);
+    std::vector<uint8_t> gw(static_cast<size_t>(N) * K / 4), gz(static_cast<size_t>(N) * K / 8);
+    for (auto& b : gw) b = static_cast<uint8_t>(rng() % 256u);
+    for (auto& b : gz) b = static_cast<uint8_t>(rng() % 128u);
+    std::uniform_real_distribution<float> scale(0.01f, 0.05f);
+    std::vector<uint16_t> gs(static_cast<size_t>(N) * K / 32);
+    for (auto& s : gs) s = f32_to_f16_bits(scale(rng));
+    QuantMatrix m = native_matrix(kQuantFormatIq3Xxs, K, gw.data(), gz.data(), gs.data());
+    m.oc = N;
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> X(static_cast<size_t>(J) * K);
+    for (auto& v : X) v = nd(rng);
+    std::vector<float> all(static_cast<size_t>(J) * N), one(static_cast<size_t>(N));
+    compute_stage_f32_jobs(m, X.data(), J, K, 0, N, all.data());
+    for (int j = 0; j < J; j++) {
+        compute_stage_f32(m, X.data() + static_cast<size_t>(j) * K, 0, N, one.data());
+        EXPECT_EQ(0, std::memcmp(one.data(), all.data() + static_cast<size_t>(j) * N, sizeof(float) * N)) << "job " << j;
+    }
+}
