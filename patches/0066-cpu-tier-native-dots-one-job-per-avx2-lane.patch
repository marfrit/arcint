+// arcint (patch 0066): see moe_cpu_expert.hpp. Four rows per pass give four
+// independent accumulator chains per job block, so the add latency is hidden;
+// the order along k within each chain is the scalar dot's.
+__attribute__((optimize("fp-contract=off")))
+void native_dot_jobs_avx2(const float* const* wrows, int nrows, const float* xt, size_t jpad, int ic, size_t n_jobs,
+                          float* out, size_t out_stride) {
+    for (size_t jb = 0; jb < n_jobs; jb += 8) {
+        __m256 acc0 = _mm256_setzero_ps(), acc1 = _mm256_setzero_ps();
+        __m256 acc2 = _mm256_setzero_ps(), acc3 = _mm256_setzero_ps();
+        const float* w0 = wrows[0];
+        const float* w1 = wrows[nrows > 1 ? 1 : 0];
+        const float* w2 = wrows[nrows > 2 ? 2 : 0];
+        const float* w3 = wrows[nrows > 3 ? 3 : 0];
+        for (int k = 0; k < ic; k++) {
+            const __m256 x = _mm256_loadu_ps(xt + static_cast<size_t>(k) * jpad + jb);
+            acc0 = _mm256_add_ps(acc0, _mm256_mul_ps(x, _mm256_set1_ps(w0[k])));
+            acc1 = _mm256_add_ps(acc1, _mm256_mul_ps(x, _mm256_set1_ps(w1[k])));
+            acc2 = _mm256_add_ps(acc2, _mm256_mul_ps(x, _mm256_set1_ps(w2[k])));
+            acc3 = _mm256_add_ps(acc3, _mm256_mul_ps(x, _mm256_set1_ps(w3[k])));
+        }
+        alignas(32) float lanes[4][8];
+        _mm256_store_ps(lanes[0], acc0);
+        _mm256_store_ps(lanes[1], acc1);
+        _mm256_store_ps(lanes[2], acc2);
+        _mm256_store_ps(lanes[3], acc3);
+        const size_t nl = n_jobs - jb < 8 ? n_jobs - jb : 8;
+        for (size_t l = 0; l < nl; l++)
+            for (int r = 0; r < nrows; r++)
+                out[(jb + l) * out_stride + static_cast<size_t>(r)] = lanes[r][l];
+    }
+}
