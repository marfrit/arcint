# CPU tier, native formats: decode each expert row once for all of the
# expert's jobs. The per-job reference decoded the whole expert for every
# (token, expert) pair, so a prefill chunk repeated it for every token routed
# to the expert. Stage-major now: a row is decoded once and dotted with every
# job, and each job keeps the per-job path's own dot (acc += x*w in k order)
# and rounding, so a job's bytes are the per-job call's. Affine matrices keep
# their per-job calls. The IQ2_S unit cell's bytes move to group 1's place:
# as written, the cell failed against the correct decoder.
#
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_cpu_expert.cpp
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_cpu_expert.cpp
@@ -905,42 +905,75 @@
 
 namespace {
 
+// arcint (patch 0065). One stage over all of an expert's jobs: out[j * width +
+// (n - n_begin)]. A native matrix decodes each row ONCE for every job -- the
+// per-job form decoded the whole expert per (token, expert) pair, which a
+// prefill chunk repeats for every token routed to the expert. Each job's dot is
+// compute_stage_f32's own (acc += x[k] * w[k] in k order), so a job's bytes are
+// the per-job call's. An affine matrix keeps its per-job call.
+void compute_stage_f32_jobs(const QuantMatrix& mat, const float* X, size_t n_jobs, size_t ldx, int n_begin,
+                            int n_end, float* out) {
+    const size_t width = static_cast<size_t>(n_end - n_begin);
+    if (mat.format == kQuantFormatU4Affine) {
+        for (size_t j = 0; j < n_jobs; j++)
+            compute_stage_f32(mat, X + j * ldx, n_begin, n_end, out + j * width);
+        return;
+    }
+    std::vector<float> wrow(static_cast<size_t>(mat.ic));
+    for (int n = n_begin; n < n_end; n++) {
+        decode_native_row(mat, n, wrow.data());
+        for (size_t j = 0; j < n_jobs; j++) {
+            const float* x = X + j * ldx;
+            float acc = 0.0f;
+            for (int k = 0; k < mat.ic; k++) {
+                acc += x[k] * wrow[static_cast<size_t>(k)];
+            }
+            out[j * width + static_cast<size_t>(n - n_begin)] = acc;
+        }
+    }
+}
