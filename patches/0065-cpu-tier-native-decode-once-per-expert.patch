+// arcint (patch 0065). The tier decodes a native expert's rows once for all of
+// the expert's jobs; each job must still get the bytes a call with that job
+// alone gives. Flash-Next's formats: IQ3_XXS gate/up, IQ4_NL down, random
+// blocks. Red: a stage that read one job's activations for every job, or kept
+// the per-job loop but indexed a job's output by another's, fails the equality;
+// the jobs' outputs differ from one another, so the cell can see it.
+TEST(moe_cpu_expert_native, the_jobs_of_one_expert_get_each_job_s_own_bytes) {
+    const int H = 128, I = 64, J = 7;
+    std::mt19937 rng(7);
+    auto bytes = [&](size_t n, int mod) {
+        std::vector<uint8_t> v(n);
+        for (auto& b : v) b = static_cast<uint8_t>(rng() % static_cast<unsigned>(mod));
+        return v;
+    };
+    std::uniform_real_distribution<float> scale(0.01f, 0.05f);
+    auto scales = [&](size_t n) {
+        std::vector<uint16_t> v(n);
+        for (auto& x : v) x = f32_to_f16_bits(scale(rng));
+        return v;
+    };
+    auto gw = bytes(I * H / 4, 256), gz = bytes(I * H / 8, 128), uw = bytes(I * H / 4, 256), uz = bytes(I * H / 8, 128);
+    auto gs = scales(I * H / 32), us = scales(I * H / 32);
+    auto dw = bytes(H * I / 2, 256);
+    auto ds = scales(H * I / 32);
+    ExpertDesc e;
+    e.gate = native_matrix(kQuantFormatIq3Xxs, H, gw.data(), gz.data(), gs.data());
+    e.gate.oc = I;
+    e.up = native_matrix(kQuantFormatIq3Xxs, H, uw.data(), uz.data(), us.data());
+    e.up.oc = I;
+    e.down = native_matrix(kQuantFormatIq4Nl, I, dw.data(), nullptr, ds.data());
+    e.down.oc = H;
+
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<std::vector<uint16_t>> x(J, std::vector<uint16_t>(H));
+    for (auto& row : x)
+        for (auto& v : row) v = f32_to_f16_bits(nd(rng));
+    std::vector<std::vector<uint16_t>> y_all(J, std::vector<uint16_t>(H, 0)), y_one(J, std::vector<uint16_t>(H, 0));
+    std::vector<ExpertJob> jobs(J);
+    for (int j = 0; j < J; j++)
+        jobs[j] = ExpertJob{x[j].data(), f32_to_f16_bits(0.1f * static_cast<float>(j + 1)), y_all[j].data()};
+    moe_cpu_expert(e, jobs.data(), J, 0, H);
+    for (int j = 0; j < J; j++) {
+        ExpertJob one{x[j].data(), jobs[j].w_route, y_one[j].data()};
+        moe_cpu_expert(e, &one, 1, 0, H);
+    }
+    for (int j = 0; j < J; j++) EXPECT_EQ(y_all[j], y_one[j]) << "job " << j;
+    EXPECT_NE(y_all[0], y_all[1]);
+}
