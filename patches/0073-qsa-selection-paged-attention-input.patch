+// QSA step 3 T2: an exporter-tagged indexer mask (rt_info arcint =
+// "qsa_selection") becomes the optional 29th PagedAttention input, a
+// [T_new, total] u8 visibility mask; an untagged mask -- every causal mask
+// -- is dropped exactly as before and the node stays at 28 inputs.
+TEST(SDPAToPA, QsaSelectionMaskIsWiredIntoTheOptionalPagedAttentionInput) {
+    auto model = make_single_layer_sdpa_model(false, false, false);
+    std::shared_ptr<ov::Node> sdpa;
+    for (const auto& op : model->get_ops()) {
+        if (ov::is_type<ov::op::v13::ScaledDotProductAttention>(op)) {
+            sdpa = op;
+            break;
+        }
+    }
+    ASSERT_NE(sdpa, nullptr);
+    sdpa->input_value(3).get_node_shared_ptr()->set_rt_info("qsa_selection", "arcint");
+    ov::pass::Manager manager;
+    manager.register_pass<ov::pass::SDPAToPagedAttention>();
+    manager.run_passes(model);
+    std::shared_ptr<ov::Node> pa;
+    for (const auto& op : model->get_ops()) {
+        if (ov::is_type<ov::op::PagedAttentionExtension>(op)) {
+            pa = op;
+            break;
+        }
+    }
+    ASSERT_NE(pa, nullptr);
+    EXPECT_EQ(pa->get_input_size(), 29u);
+    const auto mask = pa->get_input_node_shared_ptr(28);
+    EXPECT_EQ(mask->get_friendly_name(), "qsa_selection");
+    EXPECT_EQ(mask->get_output_element_type(0), element::u8);
+    EXPECT_EQ(mask->get_output_partial_shape(0).rank(), ov::Rank(2));
+}
+
+TEST(SDPAToPA, AnUntaggedSdpaMaskIsDroppedAndKeepsPagedAttentionAt28Inputs) {
+    auto model = make_single_layer_sdpa_model(false, false, false);
+    ov::pass::Manager manager;
+    manager.register_pass<ov::pass::SDPAToPagedAttention>();
+    manager.run_passes(model);
+    std::shared_ptr<ov::Node> pa;
+    for (const auto& op : model->get_ops()) {
+        if (ov::is_type<ov::op::PagedAttentionExtension>(op)) {
+            pa = op;
+            break;
+        }
+    }
+    ASSERT_NE(pa, nullptr);
+    EXPECT_EQ(pa->get_input_size(), 28u);
+}
