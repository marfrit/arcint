+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// arcint M9 (patches/0004): split out of moe_otd_runtime.hpp so that
+// compile-time code (src/plugin/ops/moe_offload_constant.cpp, which decides
+// the per-constant allocation tier and has no reason to see cldnn graph/
+// runtime execution types) can update the shared counters without pulling in
+// moe_otd_runtime.hpp's heavier prelude requirement (see the comment on that
+// include in expert_weight_providers.cpp). This header has no dependency
+// beyond <atomic>/<cstdint> and is safe to include from any layer.
+namespace ov::intel_gpu::ocl::moe_otd {
+
+// Lightweight perf counters for OTD profiling.
+// Enabled by setting MOE_OTD_PERF_LOG=1 environment variable.
+// Counters are printed to stderr on process exit.
+struct OtdPerfCounters {
+    std::atomic<uint64_t> gpu_hits{0};
+    std::atomic<uint64_t> gpu_misses{0};
+    std::atomic<uint64_t> disk_io_ns{0};
+    std::atomic<uint64_t> transpose_ns{0};
+    std::atomic<uint64_t> gpu_copy_ns{0};
+    std::atomic<uint64_t> tensor_load_count{0};
+    std::atomic<uint64_t> batched_fallbacks{0};
+    std::atomic<uint64_t> grouped_fallbacks{0};
+    std::atomic<uint64_t> created_onednn_kernels{0};
+
+    // arcint M9 (patches/0004, P0 counters).
+    // LRU evictions across all OTD-offloaded MoE layers in this process.
+    std::atomic<uint64_t> evictions{0};
+    // Slot resolutions (hits + misses) returned by LRUCache::get_lru_item;
+    // recorded independently of gpu_hits/gpu_misses so the two accounting
+    // paths (per-slot vs per-acquire-call) can be cross-checked.
+    std::atomic<uint64_t> acquisitions{0};
+
+    // arcint M9 (patches/0005, P1 two-tier device pool). Populated in
+    // try_prepare_partial_upload (src/plugin/ops/moe_offload_constant.cpp) at
+    // compile time, one increment per routed-expert constant compiled under
+    // otd_ratio: which tier its slot buffer landed in, and how many times the
+    // usm_device attempt threw and fell back to the usm_host lockable path.
+    std::atomic<uint64_t> device_slot_buffers{0};
+    std::atomic<uint64_t> host_slot_buffers{0};
+    std::atomic<uint64_t> alloc_fallbacks{0};
+
+    // arcint M9 (patches/0006, P2 async batched uploads). Current footprint
+    // of the provider-owned usm_host staging ring, in bytes: sum of each
+    // ring slot's live capacity. Grows only on a ring-slot resize, so it
+    // should plateau after warm-up; a value that keeps climbing across
+    // infers is the async path leaking staging capacity, not amortizing it.
+    std::atomic<uint64_t> staging_bytes{0};
+
+    void dump() const;
+};
+
+OtdPerfCounters* get_perf_counters();
+
+}  // namespace ov::intel_gpu::ocl::moe_otd
