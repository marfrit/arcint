+// arcint (patch 0063): the weight-rounding emulation arm, a measurement
+// instrument for the matrix-unit route (docs/design-native-dpas-expert-kernel.md
+// §6.2). The matrix unit takes f16 weights; NATIVE_W_ROUND = 1 rounds each
+// decoded weight (the product of its factors, in f32) to f16 before the
+// multiply, so the served cost of that rounding alone can be read against the
+// unrounded kernels; 2 rounds to bf16, the instrument's red. 0, the default,
+// expands to the kernels' own left-to-right product, token for token.
+#if NATIVE_W_ROUND == 1
+#  define NATIVE_W3(x, a, b, c) ((x) * convert_float(convert_half((a) * (b) * (c))))
+#  define NATIVE_W2(x, a, b) ((x) * convert_float(convert_half((a) * (b))))
+#elif NATIVE_W_ROUND == 2
+#  define NATIVE_W3(x, a, b, c) ((x) * intel_convert_as_bfloat16_float(intel_convert_bfloat16_as_ushort((a) * (b) * (c))))
+#  define NATIVE_W2(x, a, b) ((x) * intel_convert_as_bfloat16_float(intel_convert_bfloat16_as_ushort((a) * (b))))
+#else
+#  define NATIVE_W3(x, a, b, c) ((x) * (a) * (b) * (c))
+#  define NATIVE_W2(x, a, b) ((x) * (a) * (b))
+#endif
