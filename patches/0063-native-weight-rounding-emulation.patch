+// The weight-rounding emulation arm (patch 0063; moe_expert_swiglu.cl
+// NATIVE_W_ROUND): MOE_NATIVE_W_ROUND=f16|bf16, read once per process; unset is
+// the kernels' own arithmetic. Every native generator emits it (the decode
+// helpers are compiled once per program).
+static int native_w_round() {
+    static const int r = [] {
+        const char* v = std::getenv("MOE_NATIVE_W_ROUND");
+        if (v == nullptr) return 0;
+        const std::string s(v);
+        OPENVINO_ASSERT(s == "f16" || s == "bf16", "MOE_NATIVE_W_ROUND must be f16 or bf16; got ", s);
+        return s == "f16" ? 1 : 2;
+    }();
+    return r;
+}
