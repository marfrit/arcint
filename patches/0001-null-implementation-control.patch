+// --- arcint null-implementation control (diagnostic, not for upstream) -------
+//
+// A second implementation manager for an op that already has exactly one. It
+// does nothing of its own: it inherits create_impl and validate_impl from
+// PagedCausalConv1DRef, so the primitive it builds, the generator it uses and
+// the kernel it compiles are the same objects the stock path builds. Only the
+// manager identity differs.
+//
+// The point is to separate two things that a real second implementation would
+// confound: the cost of the *mechanism* (registering and selecting a second
+// manager) from the effect of the *kernel*. If the node inventory and the step
+// time move when this is registered, the mechanism is not free and every later
+// measurement through it is suspect.
+struct PagedCausalConv1DNull : public PagedCausalConv1DRef {
+    OV_GPU_PRIMITIVE_IMPL("ocl::paged_causal_conv1d::null")
+    explicit PagedCausalConv1DNull(shape_types shape_type, ValidateFunc vf = nullptr)
+        : PagedCausalConv1DRef(shape_type, std::move(vf)) {}
+};
+
 }  // namespace ov::intel_gpu::ocl
