+    size_t group_num = config.hidden_size / config.group_size;
+    size_t group_num2 = config.inter_size / config.group_size;
+
+    auto hidden_states_mem = create_f16_tensor_3d(hidden_states, 1, 1, config.hidden_size);
+    auto topk_weights_mem = create_f16_tensor_3d(topk_weights_data, 1, 1, config.top_k);
+
+    auto w0_weight_mem = create_weight_tensor(w0_q_packed, config.num_experts, config.inter_size, config.group_size, group_num);
+    auto w0_scale_mem = make_scale(w0_scale, config.num_experts, config.inter_size, group_num);
+    auto w0_zp_mem = make_zp(w0_zp_packed, config.num_experts, config.inter_size, group_num);
+    auto w1_weight_mem = create_weight_tensor(w1_q_packed, config.num_experts, config.inter_size, config.group_size, group_num);
+    auto w1_scale_mem = make_scale(w1_scale, config.num_experts, config.inter_size, group_num);
+    auto w1_zp_mem = make_zp(w1_zp_packed, config.num_experts, config.inter_size, group_num);
+    auto w2_weight_mem = create_weight_tensor(w2_q_packed, config.num_experts, config.hidden_size, config.group_size, group_num2);
+    auto w2_scale_mem = make_scale(w2_scale, config.num_experts, config.hidden_size, group_num2);
+    auto w2_zp_mem = make_zp(w2_zp_packed, config.num_experts, config.hidden_size, group_num2);
+
+    topology topology;
+    topology.add(input_layout("hidden_states", hidden_states_mem->get_layout()));
+    topology.add(input_layout("topk_weights", topk_weights_mem->get_layout()));
+    topology.add(input_layout("topk_indices", layout{ov::PartialShape{1, 1, static_cast<int64_t>(config.top_k)}, data_types::u32, format::bfyx}));
+    topology.add(data("w0_weight", w0_weight_mem));
+    topology.add(data("w0_scale", w0_scale_mem));
+    topology.add(data("w0_zp", w0_zp_mem));
+    topology.add(data("w1_weight", w1_weight_mem));
+    topology.add(data("w1_scale", w1_scale_mem));
+    topology.add(data("w1_zp", w1_zp_mem));
+    topology.add(data("w2_weight", w2_weight_mem));
+    topology.add(data("w2_scale", w2_scale_mem));
+    topology.add(data("w2_zp", w2_zp_mem));
+
+    cldnn::MOECompressed::Config moe_config;
+    moe_config.hidden_size = config.hidden_size;
+    moe_config.inter_size = config.inter_size;
+    moe_config.num_expert = config.num_experts;
+    moe_config.top_k = config.top_k;
+    moe_config.group_size = config.group_size;
+    moe_config.out_type = data_types::f16;
+    moe_config.has_zp = true;
+
+    std::vector<input_info> moe_inputs{input_info("hidden_states"),
+                                       input_info("topk_weights"),
+                                       input_info("topk_indices"),
+                                       input_info("w0_weight"),
+                                       input_info("w0_scale"),
+                                       input_info("w0_zp"),
+                                       input_info("w1_weight"),
+                                       input_info("w1_scale"),
+                                       input_info("w1_zp"),
+                                       input_info("w2_weight"),
+                                       input_info("w2_scale"),
+                                       input_info("w2_zp")};
+    topology.add(moe_3gemm_fused_compressed("moe_3gemm_fused_compressed", moe_inputs, moe_config));
+
+    auto net_config = get_test_default_config(engine);
+    net_config.set_property(ov::intel_gpu::allow_new_shape_infer(true));
+    // arcint M14. Independent of OTD: add_common_consts() reads this straight
+    // off the program config, not off any provider state (§3.4).
+    net_config.set_property(ov::intel_gpu::moe_cpu_tier(true));
+    network network(engine, topology, net_config);
+
+    // MOE_INTERNAL_BUFFER_DOWN_OUTPUT == 1 (moe_3gemm_base.hpp); not included
+    // here since it lives under src/graph/impls, off this test target's
+    // include path (CMakeLists.txt) - mirrored as a literal with a size/dtype
+    // guard below instead of trusting the index blind.
+    constexpr size_t kDownOutputBufferIndex = 1;
+    constexpr uint32_t kSentinel = 0xFFFFFFFFu;
+
+    // Out-parameter, not a return value: ASSERT_* expands to a bare `return;`
+    // on failure, which requires the enclosing function to return void.
+    const size_t expected_elems = config.top_k * config.hidden_size;  // EXPERTS_PER_TOKEN == MAX_TOPK here (no shared expert)
+    auto run_and_snapshot = [&](const std::vector<uint32_t>& expert_ids, std::vector<ov::float16>& snapshot) {
+        auto topk_indices_mem = engine.allocate_memory(
+            layout{ov::PartialShape{1, 1, static_cast<int64_t>(config.top_k)}, data_types::u32, format::bfyx});
+        set_values(topk_indices_mem, expert_ids);
+        get_test_stream().finish();
+
+        network.set_input_data("hidden_states", hidden_states_mem);
+        network.set_input_data("topk_weights", topk_weights_mem);
+        network.set_input_data("topk_indices", topk_indices_mem);
+        auto outputs = network.execute();
+        get_test_stream().finish();
+
+        auto prim_inst = network.get_primitive("moe_3gemm_fused_compressed");
+        const auto& intermediates = prim_inst->get_intermediates_memories();
+        ASSERT_GT(intermediates.size(), kDownOutputBufferIndex);
+        auto scratch_y = intermediates[kDownOutputBufferIndex];
+        ASSERT_EQ(scratch_y->get_layout().data_type, data_types::f16);
+        ASSERT_GE(scratch_y->count(), expected_elems);
+
+        snapshot.resize(expected_elems);
+        cldnn::mem_lock<ov::float16, mem_lock_type::read> y_ptr(scratch_y, get_test_stream());
+        std::copy_n(y_ptr.data(), expected_elems, snapshot.begin());
+    };
+
+    // Run A: all four flat positions are real experts (0,1,0,1) - every row
+    // of scratch.y gets a real, recognisable value.
+    std::vector<ov::float16> snapshot_a;
+    run_and_snapshot({0, 1, 0, 1}, snapshot_a);
+    ASSERT_EQ(snapshot_a.size(), expected_elems);
+    // Run B: positions 1 and 3 replaced by the sentinel; positions 0 and 2
+    // keep the same expert id and the same hidden_states/topk_weights as A.
+    std::vector<ov::float16> snapshot_b;
+    run_and_snapshot({0, kSentinel, 0, kSentinel}, snapshot_b);
+    ASSERT_EQ(snapshot_b.size(), expected_elems);
+
+    const size_t hs = config.hidden_size;
+    for (size_t j = 0; j < hs; ++j) {
+        // Sentineled rows: byte-identical to whatever run A left there -
+        // proof the kernel wrote nothing (not "wrote the same thing again").
+        EXPECT_EQ(snapshot_b[1 * hs + j].to_bits(), snapshot_a[1 * hs + j].to_bits()) << "row 1 (sentinel) elem " << j;
+        EXPECT_EQ(snapshot_b[3 * hs + j].to_bits(), snapshot_a[3 * hs + j].to_bits()) << "row 3 (sentinel) elem " << j;
+        // Non-sentineled rows: same expert, same inputs in both runs -> same
+        // result, proving the #ifdef MOE_CPU_TIER_ENABLE branch is inert on
+        // the path it does not take.
+        EXPECT_EQ(snapshot_b[0 * hs + j].to_bits(), snapshot_a[0 * hs + j].to_bits()) << "row 0 (resident) elem " << j;
+        EXPECT_EQ(snapshot_b[2 * hs + j].to_bits(), snapshot_a[2 * hs + j].to_bits()) << "row 2 (resident) elem " << j;
+    }
+}
