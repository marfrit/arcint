             GPU_DEBUG_INFO << "MOE OTD partial constant allocation at compile stage: "
                            << node_name << ", experts=" << uploaded_experts
                            << "/" << total_experts << ", upload_bytes=" << upload_bytes
-                           << ", target_bytes=" << target_bytes << std::endl;
