+                            "This buffer is device-only by design (patches/0005); locking it would "
+                            "silently allocate a host copy sized to the full constant layout and read "
+                            "past the actual (smaller) physical allocation.");
             GPU_DEBUG_LOG << "Copy usm_device buffer to host buffer." << std::endl;
             _host_buffer.allocateHost(_bytes_count);
             // Always copy device data to host buffer (treat write as read_write internally).
