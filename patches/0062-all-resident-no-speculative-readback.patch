         static const bool nohoist = std::getenv("MOE_OTD_READBACK_NOHOIST") != nullptr;
+        // arcint (patch 0062): every expert holds a slot (the all-resident
+        // native pool, 0051/0058), so no call can miss, and the speculative
+        // x/rw read below would copy the whole hidden state to the host for
