# All-resident native pool: no speculative hidden-state readback. With every
# expert holding a slot no call can miss, so the hoisted x/rw copy of 0017
# (the whole T x hidden f16 hidden state, per MoE layer) is skipped and
# topk_id is read alone, as under MOE_OTD_READBACK_NOHOIST; a miss would
# still fetch x/rw after the slot upload.
#
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_3gemm_swiglu_opt.cpp
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_3gemm_swiglu_opt.cpp
