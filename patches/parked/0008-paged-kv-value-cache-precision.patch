@@ -35,6 +35,13 @@
 
     const ov::AnyMap& get_user_properties() const { return m_user_properties; }
 
+    // docs/design-m8-asymmetric-kv.md, patches/0008 "Round 5": hides (does not override -
+    // ov::PluginConfig::visit_attributes is not virtual, and every call site that matters
+    // here, Graph's save/load in plugin/graph.cpp, holds a concrete ExecutionConfig, so
