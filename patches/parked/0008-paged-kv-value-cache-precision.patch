diff --git a/src/plugins/intel_gpu/src/runtime/execution_config.cpp b/src/plugins/intel_gpu/src/runtime/execution_config.cpp
--- a/src/plugins/intel_gpu/src/runtime/execution_config.cpp
+++ b/src/plugins/intel_gpu/src/runtime/execution_config.cpp
@@ -161,6 +161,59 @@
     PluginConfig::finalize(ctx.get(), nullptr);
 }
 
+bool ExecutionConfig::visit_attributes(ov::AttributeVisitor& visitor) {
+    // docs/design-m8-asymmetric-kv.md, patches/0008 "Round 5": ov::PluginConfig::
+    // visit_attributes (de)serializes m_options_map POSITIONALLY for GPU model-cache blobs
+    // (plugin/graph.cpp's Graph save/load constructors) - by std::map iteration order (sorted
+    // by property name string), value only, with no name or count written into the stream
+    // itself (IstreamAttributeVisitor::handle_option / OstreamAttributeVisitor::handle_option,
+    // openvino/runtime/plugin_config.hpp). A cache blob written by a plugin build with a
+    // DIFFERENT set of registered options (e.g. one missing a newly-added option such as this
+    // patch's own VALUE_CACHE_PRECISION) silently misaligns on read: every option whose name
+    // sorts after the added/removed one reads the WRONG stream token. Confirmed on-card as the
+    // root cause of a "presence, not value" corruption this task chased for several rounds:
+    // even a value-side change that resolved to byte-identical key/value precisions still
+    // corrupted decode, because the actual damage was to whichever unrelated option now sat at
+    // a shifted map position after VALUE_CACHE_PRECISION was inserted - never to KV_CACHE_
+    // PRECISION or VALUE_CACHE_PRECISION themselves. The existing runtime_requirements guard
+    // (plugin/compiled_model.cpp) catches OpenVINO-build/device incompatibility but not this:
+    // the build version string does not change just because a plugin's own option set did, so
+    // a stale-schema blob from before a rebuild sails past that guard into the positional loop.
+    //
+    // Fix: an explicit schema signature - the sorted, semicolon-joined names of every
+    // registered RELEASE/RELEASE_INTERNAL-visibility option - carried through the exact same
+    // symmetric AnyMap on_adapter path the base class's own m_user_properties attribute
+    // already uses (both IstreamAttributeVisitor and OstreamAttributeVisitor already implement
+    // ov::AttributeAdapter<ov::AnyMap> generically; no visitor-class change needed). A mismatch
+    // throws before the base class's positional loop runs, so a stale-schema blob is rejected
+    // outright - the caller catches the exception and recompiles instead of silently consuming
+    // misaligned data, the same contract compiled_model.cpp's own guard already documents for
+    // itself ("throws ov::Exception; so the caller ... recompiles instead of consuming a bad
+    // blob"). This does not repair a blob that already exists from before this fix landed (it
+    // has no marker to check against) - an operator swapping in a plugin build that changes
+    // this schema still needs to clear any existing GPU model cache directory once; this fix
+    // only makes every rebuild AFTER this one fail loud instead of silently corrupting output.
+    {
+        std::string schema_names;
