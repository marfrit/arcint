+// The same three decodes from a super-block already in registers (the tiled variant's 2D
+// block loads, patch 0029): h is the block's first four dwords, q the eight dwords serving
+// the sub-block pair, qh/ql/sc the corresponding runs. Same arithmetic as the pointer forms,
+// bit for bit.
+inline void kq_dec_q4_K_w(uint4 h, uint8 q, uint s, float* y) {
+    const float d = kq_f16bits(h.s0), dmin = kq_f16bits(h.s0 >> 16);
+    uint sc, mn;
+    kq_scale_min_k4(s, h.s1, h.s2, h.s3, &sc, &mn);
+    const float dl = d * (float)sc, ml = dmin * (float)mn;
+    const uint shift = (s & 1) * 4;
+    __attribute__((opencl_unroll_hint(32)))
+    for (int l = 0; l < 32; ++l)
+        y[l] = dl * (float)((q[l >> 2] >> ((l & 3) * 8 + shift)) & 0xFu) - ml;
+}
+inline void kq_dec_q5_K_w(uint4 h, uint8 qh, uint8 q, uint s, float* y) {
+    const float d = kq_f16bits(h.s0), dmin = kq_f16bits(h.s0 >> 16);
+    uint sc, mn;
+    kq_scale_min_k4(s, h.s1, h.s2, h.s3, &sc, &mn);
+    const float dl = d * (float)sc, ml = dmin * (float)mn;
+    const uint shift = (s & 1) * 4;
+    __attribute__((opencl_unroll_hint(32)))
+    for (int l = 0; l < 32; ++l) {
+        const uint nib = (q[l >> 2] >> ((l & 3) * 8 + shift)) & 0xFu;
+        const uint hb = (qh[l >> 2] >> ((l & 3) * 8 + s)) & 1u;
+        y[l] = dl * (float)(nib | (hb << 4)) - ml;
+    }
+}
+// ql: the run's 32 bytes of ql (dwords hh*16 + (r&1)*8 ..), qh: the half's 32 bytes (dwords
+// 32 + hh*8 ..), sc: dwords 48..55 of the 224-byte block (scales, then d at byte 208).
+inline void kq_dec_q6_K_w(uint8 ql, uint8 qh, uint8 sc, uint s, float* y) {
+    const float d = kq_f16bits(sc[4]);
+    const uint hh = s >> 2, r = s & 3;
+    const uint sb = hh * 8 + 2 * r;   // byte of scales[16]
+    const float s0 = d * (float)((int)(char)((sc[sb >> 2] >> ((sb & 3) * 8)) & 0xFFu));
+    const float s1 = d * (float)((int)(char)((sc[(sb + 1) >> 2] >> (((sb + 1) & 3) * 8)) & 0xFFu));
+    const uint shift = 2 * r;
+    const uint nib = (r >> 1) * 4;
+    __attribute__((opencl_unroll_hint(32)))
+    for (int l = 0; l < 32; ++l) {
+        const uint lo = (ql[l >> 2] >> ((l & 3) * 8 + nib)) & 0xFu;
+        const uint hi = (qh[l >> 2] >> ((l & 3) * 8 + shift)) & 3u;
+        y[l] = (l < 16 ? s0 : s1) * (float)((int)(lo | (hi << 4)) - 32);
+    }
+}
