+            continue;
+        _fill_pending.push_back(ex);
+        AdaptiveReadPool::get().submit([prep, config = _config, path = _weight_reader.path(), plans = std::move(plans), ex] {
+            std::vector<moe_otd::PreparedTensor> tensors;
+            try {
+                tensors = moe_otd::read_expert_tensors(config, path, plans);
+            } catch (...) {
