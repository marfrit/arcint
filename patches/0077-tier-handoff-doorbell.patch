+        std::vector<uint32_t> v(ids, ids + n);
+        otd_trace_append(_routing_trace_path, layer_key(), _config.top_k, v);
+    }
+    if (_routing_hist_enabled)
+        for (size_t i = 0; i < n; ++i)
+            if (ids[i] >= 0 && static_cast<size_t>(ids[i]) < _routing_hist.size())
+                ++_routing_hist[ids[i]];
+    if (!(_adaptive && _static_partition) || n > static_cast<size_t>(_config.top_k))
+        return;
+    for (size_t i = 0; i < n; ++i)
+        if (ids[i] >= 0 && static_cast<size_t>(ids[i]) < _adaptive_usage.size())
+            _adaptive_usage[ids[i]] += 1.0f;
+    otd_adaptive_tick(this);
+}
