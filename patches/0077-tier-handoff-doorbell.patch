+// arcint (patch 0077). The doorbell's residency table: a filled pinned slot
+// maps its expert to the slot, an unfilled one and a non-resident expert to
+// -1 (the route kernel's CPU-tier mark).
+TEST(moe_expert_weight_provider, doorbell_residency_table_marks_only_filled_pinned_slots) {
+    MOECompressed::Config config{};
+    config.num_expert = 8;
+    OffloadExpertWeightProvider provider(/*capacity=*/3, config, {0, 100, 200, 300}, "/nonexistent");
+    cldnn::moe_weights resident{};
+    provider.bind(resident);
+    auto& cache = provider.cache();
+    cache.reserve_pinned(5, 0);
+    cache.reserve_pinned(2, 1);
+    cache.reserve_pinned(7, 2);
+    cache.set_filled(0);  // expert 5
+    cache.set_filled(2);  // expert 7; expert 2's slot 1 stays unfilled
+    std::vector<int32_t> table;
+    provider.residency_table(table);
+    ASSERT_EQ(table.size(), 8u);
+    const std::vector<int32_t> want = {-1, -1, -1, -1, -1, 0, -1, 2};
+    ASSERT_EQ(table, want);
+}
