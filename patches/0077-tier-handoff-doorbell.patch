+#ifdef DOORBELL_ROUTE_ENABLE
+// arcint (patch 0077, campaign tier-handoff-doorbell). Strata's doorbell
+// publish (src/kernels/cuda/elementwise.cu:186-311): the decode pair table
+// from topk_id through the layer's residency table (slot, or -1 for an expert
+// the card does not hold: the batched kinds skip that row and the CPU tier
+// computes it), and the published copy of what the tier needs -- the ids, the
+// slots the device chose, the routing weights and x -- in host memory, then
+// `seq` with a release store. One work-group.
+// pub layout (ints): ids[DOORBELL_PMAX], slots[DOORBELL_PMAX], then halves:
+// rw[DOORBELL_PMAX], x[DOORBELL_TMAX * HIDDEN_SIZE].
+KERNEL(doorbell_route)(
+    const __global int*  topk_id,
+    const __global half* topk_w,
+    const __global half* x,
+    const __global int*  table,
+    __global int*        pairs,
+    __global int*        pub,
+    __global uint*       flags,
+    int experts_per_token,
+    int max_topk,
+    int route_pairs,
+    int n_tok,
+    uint seq)
+{
+    const int lid = get_local_id(0);
+    const int lsz = get_local_size(0);
+    __global int* pub_ids = pub;
+    __global int* pub_slots = pub + DOORBELL_PMAX;
+    __global half* pub_rw = (__global half*)(pub + 2 * DOORBELL_PMAX);
+    __global half* pub_x = pub_rw + DOORBELL_PMAX;
+    for (int i = lid; i < route_pairs; i += lsz) {
+        const int e = topk_id[i];
+        const int slot = table[e];
+        const int pos = i % max_topk;
+        pairs[3 * i + 0] = slot;
+        pairs[3 * i + 1] = (i / max_topk) * experts_per_token + pos;
+        pairs[3 * i + 2] = pos;
+        pub_ids[i] = e;
+        pub_slots[i] = slot;
+        pub_rw[i] = topk_w[i];
+    }
+    for (int i = lid; i < n_tok * HIDDEN_SIZE; i += lsz)
+        pub_x[i] = x[i];
+    atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_release, memory_scope_all_svm_devices);
+    barrier(CLK_GLOBAL_MEM_FENCE);
+    if (lid == 0) {
+        atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_release, memory_scope_all_svm_devices);
+        atomic_store_explicit((__global atomic_uint*)flags, seq, memory_order_release, memory_scope_all_svm_devices);
+    }
+}
+#endif  // DOORBELL_ROUTE_ENABLE
+
+#ifdef DOORBELL_WAIT_ENABLE
+// arcint (patch 0077). Strata's doorbell wait: one work-item polls the host's
+// `done` flag (flags[16], its own cache line) until it reaches `seq`, then the
+// work-group copies the CPU tier's rows (host: rows[0] = count, rows[1..] the
+// flat ids; yhost the rows in that order) into y. Host memory is read with
+// LSC loads that bypass L1 and L3: on this driver host USM is not concurrent,
+// and atomic or volatile loads of a host-written flag were measured to miss
+// the write (acquire atomics 2 of 8 rounds, volatile and RMW 0 of 8; the
+// uncached load with an acquire fence in the loop 8 of 8, ~5 us). The poll is bounded: on a timeout flags-side
+// status (rows are not merged) is left to the host's own check, so the queue
+// never hangs on a lost flag.
+#if HIDDEN_SIZE % 2
+#  error "moe_expert_swiglu.cl: the doorbell merge copies two halves a word"
+#endif
+#ifndef ARCINT_DOORBELL_LSC_DECLARED
+#define ARCINT_DOORBELL_LSC_DECLARED
+enum DOORBELL_LDCC { DOORBELL_LDCC_DEFAULT = 0, DOORBELL_L1UC_L3UC = 1 };
+extern uint __builtin_IB_lsc_load_global_uint(const __global uint* base, int immElemOff, enum DOORBELL_LDCC cacheOpt);
+#endif
+// flags[17] == seq: the host's half failed for this call. A timeout or a
+// failed call writes NaN into the call's y rows (y_rows rows) instead of
+// merging, so a wrong token cannot pass for a right one; the host throws on
+// its next call.
+KERNEL(doorbell_wait)(
+    const __global uint* flags,
+    const __global uint* rows,
+    const __global uint* yhost,
+    __global uint*       y,
+    __global uint*       status,
+    uint seq,
+    uint limit,
+    uint y_rows)
+{
+    __local uint seen;
+    const int lid = get_local_id(0);
+    const int lsz = get_local_size(0);
+    if (lid == 0) {
+        uint polls = 0, ok = 0;
+        while (polls < limit) {
+            if (__builtin_IB_lsc_load_global_uint(flags + 16, 0, DOORBELL_L1UC_L3UC) >= seq) { ok = 1; break; }
+            // Without a fence in the loop the compiler hoists the load and
+            // the poll never sees the host's write (measured: 3M polls in
+            // ~110 ms, every round a timeout); with it, 4.5-5.4 us.
+            atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acquire, memory_scope_all_svm_devices);
+            ++polls;
+        }
+        atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acquire, memory_scope_all_svm_devices);
+        const uint failed = ok && __builtin_IB_lsc_load_global_uint(flags + 17, 0, DOORBELL_L1UC_L3UC) == seq;
+        seen = ok && !failed;
+        if (!ok)
+            status[0] = seq;  // a timeout, for the host to read
+    }
+    barrier(CLK_LOCAL_MEM_FENCE | CLK_GLOBAL_MEM_FENCE);
+    if (!seen) {
+        const int words = HIDDEN_SIZE / 2;
+        for (uint w = lid; w < y_rows * words; w += lsz)
+            y[w] = 0x7E007E00u;  // two half NaNs
+        return;
+    }
+    const uint n = __builtin_IB_lsc_load_global_uint(rows, 0, DOORBELL_L1UC_L3UC);
+    const int words = HIDDEN_SIZE / 2;  // two halves a uint
+    for (uint r = 0; r < n; ++r) {
+        const uint flat = __builtin_IB_lsc_load_global_uint(rows + 1 + r, 0, DOORBELL_L1UC_L3UC);
+        for (int w = lid; w < words; w += lsz)
+            y[(long)flat * words + w] = __builtin_IB_lsc_load_global_uint(yhost + (long)r * words + w, 0, DOORBELL_L1UC_L3UC);
+    }
+}
+#endif  // DOORBELL_WAIT_ENABLE
