+// arcint (patch 0077, campaign tier-handoff-doorbell). The doorbell's host
+// half runs here, off the thread that enqueues the network, so that thread
+// submits the whole decode step ahead (Strata records the pass; FreeToken's
+// coordinator polls the ready flag). One thread, calls in FIFO order, which
+// is the GPU's layer order. A call that throws still rings its `done` (the
+// job does that) and the error surfaces on the enqueueing thread's next MoE
+// call. Leaked on purpose: no static destructor joins a thread mid-call.
+class DoorbellCoordinator {
+public:
+    static DoorbellCoordinator& get() {
+        static auto* inst = new DoorbellCoordinator();
+        return *inst;
+    }
+    void push(std::function<void()> job) {
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            _q.push_back(std::move(job));
+        }
+        _cv.notify_one();
+    }
+    // Blocks until every pushed call has finished.
+    void drain() {
+        std::unique_lock<std::mutex> lock(_m);
+        _idle.wait(lock, [this] { return _q.empty() && !_busy; });
+    }
+    void fail(std::exception_ptr e) {
+        std::lock_guard<std::mutex> lock(_m);
+        if (!_error)
+            _error = e;
+    }
+    void rethrow() {
+        drain();
+        std::exception_ptr e;
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            std::swap(e, _error);
+        }
+        if (e)
+            std::rethrow_exception(e);
+    }
+
+private:
+    DoorbellCoordinator() {
+        std::thread([this] { run(); }).detach();
+    }
+    void run() {
+        for (;;) {
+            std::function<void()> job;
+            {
+                std::unique_lock<std::mutex> lock(_m);
+                _cv.wait(lock, [this] { return !_q.empty(); });
+                job = std::move(_q.front());
+                _q.pop_front();
+                _busy = true;
+            }
+            job();
+            {
+                std::lock_guard<std::mutex> lock(_m);
+                _busy = false;
+            }
+            _idle.notify_all();
+        }
+    }
+    std::mutex _m;
+    std::condition_variable _cv, _idle;
+    std::deque<std::function<void()>> _q;
+    bool _busy = false;
+    std::exception_ptr _error;
+};
