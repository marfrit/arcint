# Native per-expert kernels: several output rows per pass, and uniform
# indices. A subgroup decodes NATIVE_GU_TILE_N (2) rows of gate AND up, or
# NATIVE_DOWN_TILE_N (4) rows of down (IQ3_XXS, IQ4_NL), per load of the
# tile's activations; the tile shrinks from 8 to 4 pairs so the gate/up
# accumulators fit the registers. The tile, pair and row indices go through
# sub_group_broadcast so they stay scalar. Each (row, token) sum keeps the
# one-row decoder's products and order; the output bytes equal 0060's by
# measurement on the A770. MOE_NATIVE_TILE_N=1 restores the row-at-a-time
# loop (the cell's reference).
#
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe_expert_swiglu.cl
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe_expert_swiglu.cl
@@ -1296,6 +1296,163 @@
     __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
         if (t < cnt) out[t] = sub_group_reduce_add(acc[t]);
