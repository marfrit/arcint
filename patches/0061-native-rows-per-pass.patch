+#if NATIVE_DOWN_TILE_N > 1
+inline void native_dot_iq3xxs_rows(const __global uchar* W, const __global uchar* Z, const __global half* S,
+                                   int n0, int nr, int N, int K, const __global half* x, __private const int* xb,
+                                   int cnt, int id_local, __private float (*out)[NATIVE_TILE_M]) {
+    float acc[NATIVE_DOWN_TILE_N][NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[r][t] = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        float fs[NATIVE_DOWN_TILE_N];
+        __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+            fs[r] = convert_float(S[g * N + n0 + (r < nr ? r : 0)]);
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            const int l = j >> 3;
+            const int m = j & 7;
+            float wm[NATIVE_DOWN_TILE_N], ws[NATIVE_DOWN_TILE_N];
+            __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++) {
+                const int n = n0 + (r < nr ? r : 0);
+                const __global uchar* gridix = W + n * (K / 4) + g * 8;
+                const __global uchar* signix = Z + n * (K / 8) + g * 4;
+                const uchar gi = (m < 4) ? gridix[2 * l] : gridix[2 * l + 1];
+                wm[r] = convert_float(NATIVE_IQ3XXS_GRID[gi * 4 + (m & 3)]);
+                const uchar signs = NATIVE_IQ2XS_SIGNS[signix[l] & 127];
+                ws[r] = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            }
+            __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) {
+                if (t < cnt) {
+                    const float xv = convert_float(x[xb[t] + g * 32 + j]);
+                    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+                        acc[r][t] += xv * fs[r] * wm[r] * ws[r];
+                }
+            }
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+            if (r < nr && t < cnt) out[r][t] = sub_group_reduce_add(acc[r][t]);
+}
+
+inline void native_dot_iq4nl_rows(const __global uchar* W, const __global half* S, int n0, int nr, int N, int K,
+                                  const __global half* x, __private const int* xb, int cnt, int id_local,
+                                  __private float (*out)[NATIVE_TILE_M]) {
+    float acc[NATIVE_DOWN_TILE_N][NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[r][t] = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        float fs[NATIVE_DOWN_TILE_N];
+        __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+            fs[r] = convert_float(S[g * N + n0 + (r < nr ? r : 0)]);
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            float fv[NATIVE_DOWN_TILE_N];
+            __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++) {
+                const int n = n0 + (r < nr ? r : 0);
