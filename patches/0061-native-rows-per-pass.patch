+
+// arcint (patch 0061): the tile decoders over several output rows at once
+// (NATIVE_GU_TILE_N for gate/up, NATIVE_DOWN_TILE_N for down). A subgroup's N_BLOCK rows used to run one after another, and every row
+// re-read the tile's NATIVE_TILE_M token vectors from global memory -- twice
+// for gate/up, once per projection. Here one load of x[t][k] feeds every row of
+// the pass, gate and up together. Each (row, token) accumulator takes the same
+// products in the same order as the one-row decoders above, so its bytes are
+// expected to equal theirs -- by measurement, not by construction
+// (-cl-mad-enable, as above). Rows r >= nr are computed on row n0 and dropped.
+// The helpers are compiled once per program, and one program holds the gate/up
+// and the down kernels, so each projection's row count is its own constant
+// and both generators define both.
+#if NATIVE_GU_TILE_N > 1
+inline void native_gu_iq2s_packed_rows(const __global uchar* Wu, const __global half* Su,
+                                       const __global uchar* Wg, const __global half* Sg,
+                                       int n0, int nr, int K, const __global half* x, __private const int* xb,
+                                       int cnt, int id_local,
+                                       __private float (*ou)[NATIVE_TILE_M], __private float (*og)[NATIVE_TILE_M]) {
+    float au[NATIVE_GU_TILE_N][NATIVE_TILE_M], ag[NATIVE_GU_TILE_N][NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) {
+            au[r][t] = 0.0f;
+            ag[r][t] = 0.0f;
+        }
+    const int nblk = K / 256;
+    for (int ib = 0; ib < nblk; ib++) {
+        float du[NATIVE_GU_TILE_N], dg[NATIVE_GU_TILE_N];
+        __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++) {
+            const long n = n0 + (r < nr ? r : 0);
+            du[r] = convert_float(Su[n * nblk + ib]);
+            dg[r] = convert_float(Sg[n * nblk + ib]);
+        }
+        for (int ib32 = 0; ib32 < 8; ib32++) {
+            float ulo[NATIVE_GU_TILE_N], uhi[NATIVE_GU_TILE_N], glo[NATIVE_GU_TILE_N], ghi[NATIVE_GU_TILE_N];
+            uchar uqh[NATIVE_GU_TILE_N], gqh[NATIVE_GU_TILE_N];
+            __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++) {
+                const long n = n0 + (r < nr ? r : 0);
+                const __global uchar* bu = Wu + (n * nblk + ib) * 80;
+                const __global uchar* bg = Wg + (n * nblk + ib) * 80;
+                const uchar scu = bu[72 + ib32];
+                const uchar scg = bg[72 + ib32];
+                ulo[r] = du[r] * (0.5f + convert_float(scu & 0x0F)) * 0.25f;
+                uhi[r] = du[r] * (0.5f + convert_float(scu >> 4)) * 0.25f;
+                glo[r] = dg[r] * (0.5f + convert_float(scg & 0x0F)) * 0.25f;
+                ghi[r] = dg[r] * (0.5f + convert_float(scg >> 4)) * 0.25f;
+                uqh[r] = bu[64 + ib32];
+                gqh[r] = bg[64 + ib32];
+            }
+            for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+                const int l = j >> 3;
+                const int m = j & 7;
+                float wud[NATIVE_GU_TILE_N], wum[NATIVE_GU_TILE_N], wus[NATIVE_GU_TILE_N];
+                float wgd[NATIVE_GU_TILE_N], wgm[NATIVE_GU_TILE_N], wgs[NATIVE_GU_TILE_N];
+                __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++) {
+                    const long n = n0 + (r < nr ? r : 0);
+                    const __global uchar* bu = Wu + (n * nblk + ib) * 80;
+                    const __global uchar* bg = Wg + (n * nblk + ib) * 80;
+                    const ushort giu = (ushort)bu[ib32 * 4 + l] | ((ushort)((uqh[r] >> (2 * l)) & 3) << 8);
+                    const ushort gig = (ushort)bg[ib32 * 4 + l] | ((ushort)((gqh[r] >> (2 * l)) & 3) << 8);
+                    wum[r] = convert_float(NATIVE_IQ2S_GRID[giu * 8 + m]);
+                    wgm[r] = convert_float(NATIVE_IQ2S_GRID[gig * 8 + m]);
+                    wus[r] = (bu[32 + ib32 * 4 + l] & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+                    wgs[r] = (bg[32 + ib32 * 4 + l] & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+                    wud[r] = (l < 2) ? ulo[r] : uhi[r];
+                    wgd[r] = (l < 2) ? glo[r] : ghi[r];
+                }
+                __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) {
+                    if (t < cnt) {
+                        const float xv = convert_float(x[xb[t] + ib * 256 + ib32 * 32 + j]);
+                        __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++) {
+                            au[r][t] += xv * wud[r] * wum[r] * wus[r];
+                            ag[r][t] += xv * wgd[r] * wgm[r] * wgs[r];
+                        }
+                    }
+                }
+            }
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_GU_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+            if (r < nr && t < cnt) {
+                ou[r][t] = sub_group_reduce_add(au[r][t]);
+                og[r][t] = sub_group_reduce_add(ag[r][t]);
+            }
+}
+#endif  // NATIVE_GU_TILE_N > 1
