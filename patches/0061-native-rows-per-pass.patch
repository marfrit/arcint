+                const int code = (j & 1) ? (byte >> 4) : (byte & 0x0F);
+                fv[r] = convert_float(NATIVE_IQ4NL_TABLE[code]);
+            }
+            __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) {
+                if (t < cnt) {
+                    const float xv = convert_float(x[xb[t] + g * 32 + j]);
+                    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+                        acc[r][t] += xv * fs[r] * fv[r];
+                }
+            }
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int r = 0; r < NATIVE_DOWN_TILE_N; r++)
+        __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+            if (r < nr && t < cnt) out[r][t] = sub_group_reduce_add(acc[r][t]);
+}
