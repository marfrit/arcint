+
+bool OffloadExpertWeightProvider::create_pinned_nvme_pool(lgc::nvme_fill::ArcwellTransport& transport,
+                                                          std::string* reason) {
+    if (_pinned_pool.ready) return true;
+    // The store is the three packed u4 weight matrices in device order. A
+    // native expert format (patch 0043) has a different, non-page-aligned
+    // layout, so the byte-transparent fill is u4-only in this patch; refuse
+    // rather than DMA the wrong bytes.
+    if (_config.gate_up_weight_format != 0 || _config.down_weight_format != 0) {
+        if (reason) {
+            *reason = "pinned NVMe fill is u4-only in this patch: layer " +
+                      std::to_string(layer_key()) + " carries a native expert format";
+        }
+        return false;
+    }
+    const std::uint64_t gu = static_cast<std::uint64_t>(_config.inter_size) * _config.hidden_size / 2;
+    const std::uint64_t dn = static_cast<std::uint64_t>(_config.hidden_size) * _config.inter_size / 2;
+    const std::uint64_t tensor_bytes[3] = {gu, gu, dn};
+    for (int t = 0; t < 3; ++t) {
+        if (tensor_bytes[t] == 0 || (tensor_bytes[t] % 4096) != 0) {
+            if (reason) *reason = "pinned NVMe fill: tensor byte size is not page-aligned";
+            return false;
+        }
+        const std::uint64_t pool_bytes = static_cast<std::uint64_t>(_capacity) * tensor_bytes[t];
+        std::uint64_t bo_size = 0;
+        if (!transport.register_bo(pool_bytes, &_pinned_pool.aw_handle[t], &_pinned_pool.prime_fd[t],
+                                  &bo_size, reason)) {
+            return false;
+        }
+        _pinned_pool.tensor_bytes[t] = tensor_bytes[t];
+    }
+    _pinned_pool.ready = true;
+    return true;
+}
+
+lgc::nvme_fill::PinnedLayerGeometry OffloadExpertWeightProvider::pinned_nvme_geometry(std::uint32_t dense_index) const {
+    lgc::nvme_fill::PinnedLayerGeometry geometry;
+    geometry.capacity = _capacity;
+    geometry.dense_index = dense_index;
+    for (int t = 0; t < 3; ++t) {
+        geometry.aw_handle[t] = _pinned_pool.aw_handle[t];
+        geometry.tensor_bytes[t] = _pinned_pool.tensor_bytes[t];
+    }
+    return geometry;
+}
