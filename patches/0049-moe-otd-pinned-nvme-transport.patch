+void OffloadExpertWeightProvider::bind_pinned_nvme_pool(cldnn::engine& engine) {
+    if (!_pinned_pool.ready || _resident == nullptr) return;
+
+    // Import each registered dma-buf into OpenCL and REPLACE this layer's
+    // host-mapped weight slot buffer with a reinterpretation of the imported
+    // pool. The fused GEMV kernel indexes `gate_weight_addr + expert_id *
+    // expert_wei_size` (moe_3gemm_swiglu_mlp.cl), so the pool layout keeps the
+    // per-tensor stride and the full-layout wrapper keeps
+    // expert_tensor_span()'s total_bytes/num_expert arithmetic correct.
+    auto import_and_replace = [&](cldnn::memory::ptr& dst, int t) {
+        if (_pinned_pool.prime_fd[t] < 0) return;
+        const std::uint64_t pool_bytes =
+            static_cast<std::uint64_t>(_capacity) * _pinned_pool.tensor_bytes[t];
+        const auto full_layout = dst->get_layout();
+        // The store's per-tensor stride must equal the device's
+        // full_layout.bytes_count()/num_expert, or expert_tensor_span() and the
+        // GEMV stride would disagree. Assert it rather than assume.
+        OPENVINO_ASSERT(_config.num_expert > 0, "pinned NVMe fill: num_expert is zero");
+        OPENVINO_ASSERT(full_layout.bytes_count() / _config.num_expert == _pinned_pool.tensor_bytes[t],
+                        "pinned NVMe fill: tensor stride mismatch for tensor ", t, ": device ",
+                        full_layout.bytes_count() / _config.num_expert, " vs store ", _pinned_pool.tensor_bytes[t]);
+        OPENVINO_ASSERT(pool_bytes <= full_layout.bytes_count(),
+                        "pinned NVMe fill: slot pool exceeds the full constant layout for tensor ", t);
+        cldnn::layout pool_layout({1, 1, 1, static_cast<ov::Dimension::value_type>(pool_bytes)},
+                                  cldnn::data_types::u8, cldnn::format::bfyx);
+        auto pool_mem = engine.import_buffer(pool_layout, _pinned_pool.prime_fd[t]);
+        OPENVINO_ASSERT(pool_mem != nullptr, "pinned NVMe fill: engine.import_buffer returned null for tensor ", t);
+        // arcwell took its own dma_buf_get at MAP_BUFFER; the exported fd may
+        // be closed now (the transport header records the ownership).
+        ::close(_pinned_pool.prime_fd[t]);
+        _pinned_pool.prime_fd[t] = -1;
+        dst = engine.reinterpret_buffer(*pool_mem, full_layout);
+    };
+    import_and_replace(_resident->gate_w, 0);
+    import_and_replace(_resident->up_w, 1);
+    import_and_replace(_resident->down_w, 2);
+
+    // Scales/zp are NOT in the DMA slice: adding them makes 2,553,600 B = 623.4375
+    // pages (not page-aligned), and the device wants [group][oc] while the file
+    // carries [oc][group]. They stay on the existing transposing host path and
+    // are uploaded here, at load, on the engine's service stream, so every
+    // pinned slot is complete before the first routed call and set_filled()
+    // (already set at the barrier) never races an unwritten scale.
+    auto& service_stream = engine.get_service_stream();
+    const auto resident_experts =
+        _census_seed_active
+            ? _census_seed
+            : static_partition_resident_experts(_static_seed, layer_key(), _config.num_expert, _capacity);
+    for (std::size_t slot = 0; slot < resident_experts.size(); ++slot) {
+        moe_otd::fill_weights_memory(service_stream, _config, _weight_bin_offsets, _weight_reader, *_resident,
+                                     {resident_experts[slot]}, {slot}, _staging, /*include_weights=*/false);
+        _cache->set_filled(slot);
+    }
 }
 
