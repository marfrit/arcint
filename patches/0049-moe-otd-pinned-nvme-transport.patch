+// Per-(layer,tensor) registration the caller built. The transport owns only
+// the arcwell handles and the transfer arithmetic; it does not own the BO's
+// OpenCL import (the provider does that, because the import needs the engine).
+struct PinnedLayerGeometry {
+    std::uint32_t aw_handle[3] = {0, 0, 0};
+    std::uint64_t tensor_bytes[3] = {0, 0, 0};
+    std::uint64_t capacity = 0;
+    std::uint32_t dense_index = 0;
+};
+
+// One plain extent -> absolute LBA, the once-at-open translation. `out_len` is
+// the whole file size; the caller splits it into per-tensor requests.
+inline bool pinned_file_lba(const std::string& path,
+                            std::uint64_t partition_start_sectors,
+                            std::uint64_t* out_lba,
+                            std::uint64_t* out_len,
+                            std::string* reason) {
+    int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        if (reason) *reason = "open expert file failed: " + path + ": " + std::strerror(errno);
+        return false;
+    }
+    struct stat st;
+    if (fstat(fd, &st) < 0) {
+        if (reason) *reason = std::string("fstat expert file failed: ") + std::strerror(errno);
+        ::close(fd);
+        return false;
+    }
+    union {
+        struct fiemap fm;
+        char raw[sizeof(struct fiemap) + 8 * sizeof(struct fiemap_extent)];
+    } u;
+    std::memset(&u, 0, sizeof u);
+    u.fm.fm_start = 0;
+    u.fm.fm_length = static_cast<std::uint64_t>(st.st_size);
+    u.fm.fm_flags = FIEMAP_FLAG_SYNC;
+    u.fm.fm_extent_count = 8;
+    if (ioctl(fd, FS_IOC_FIEMAP, &u.fm) < 0) {
+        if (reason) *reason = "FS_IOC_FIEMAP failed: " + path + ": " + std::strerror(errno);
+        ::close(fd);
+        return false;
+    }
+    ::close(fd);
+    if (u.fm.fm_mapped_extents != 1) {
+        if (reason) {
+            *reason = "expert file is not one plain extent: " + path + " extents=" +
+                      std::to_string(u.fm.fm_mapped_extents);
+        }
+        return false;
+    }
+    const struct fiemap_extent* ex = &u.fm.fm_extents[0];
+    if (ex->fe_flags & (FIEMAP_EXTENT_UNKNOWN | FIEMAP_EXTENT_DELALLOC |
+                        FIEMAP_EXTENT_ENCODED | FIEMAP_EXTENT_DATA_INLINE |
+                        FIEMAP_EXTENT_UNWRITTEN)) {
+        if (reason) {
+            *reason = "expert file extent not plain: " + path + " flags=" +
+                      std::to_string(ex->fe_flags);
+        }
+        return false;
+    }
+    *out_lba = ex->fe_physical / 512 + partition_start_sectors;
+    *out_len = static_cast<std::uint64_t>(st.st_size);
+    return true;
+}
+
+// The production transport. Construct once per process (the coordinator does);
+// `register_bo` is called by each provider while it builds its slot pool, then
+// `set_layers`, then the Scheduler runs `begin`/`submit`/`collect`.
+class ArcwellTransport : public Transport {
+public:
+    ArcwellTransport(std::string drm_path,
+                     std::string arcwell_path,
+                     std::string store_dir,
+                     std::uint64_t partition_start_sectors)
+        : drm_path_(std::move(drm_path)),
+          arcwell_path_(std::move(arcwell_path)),
+          store_dir_(std::move(store_dir)),
+          part_start_(partition_start_sectors),
+          drm_fd_(::open(drm_path_.c_str(), O_RDWR | O_CLOEXEC)),
+          aw_fd_(::open(arcwell_path_.c_str(), O_RDWR | O_CLOEXEC)) {
+        if (drm_fd_ < 0 || aw_fd_ < 0) {
+            reason_ = std::string("open device failed: drm=") + drm_path_ + " arcwell=" + arcwell_path_ +
+                      " (" + std::strerror(errno) + ")";
+            return;
+        }
+        struct aw_ioc_stats st;
+        std::memset(&st, 0, sizeof st);
+        if (ioctl(aw_fd_, AW_IOC_STATS, &st) < 0) {
+            reason_ = std::string("AW_IOC_STATS baseline failed: ") + std::strerror(errno);
+            return;
+        }
+        base_stats_ = st;
+        ok_ = true;
+    }
+
+    ~ArcwellTransport() override { end(); }
+
+    bool ok() const { return ok_; }
+    const std::string& reason() const { return reason_; }
+
+    // Create one 64 KiB-rounded xe VRAM BO, export its dma-buf, and register it
+    // peer-to-peer. The caller imports `prime_fd` with the engine and may then
+    // close it. On any failure `reason` names the step.
+    bool register_bo(std::uint64_t bytes,
+                     std::uint32_t* aw_handle,
+                     int* prime_fd,
+                     std::uint64_t* bo_size,
+                     std::string* reason) {
+        if (!ok_) {
+            if (reason) *reason = reason_;
+            return false;
+        }
+        const std::uint64_t rounded = (bytes + 65535ULL) & ~65535ULL;
+        struct drm_xe_gem_create gc;
+        std::memset(&gc, 0, sizeof gc);
+        gc.size = rounded;
+        gc.placement = 1u << DRM_XE_MEM_REGION_CLASS_VRAM;
+        gc.flags = DRM_XE_GEM_CREATE_FLAG_NEEDS_VISIBLE_VRAM;
+        gc.cpu_caching = DRM_XE_GEM_CPU_CACHING_WC;
+        if (ioctl(drm_fd_, DRM_IOCTL_XE_GEM_CREATE, &gc) < 0) {
+            if (reason) *reason = std::string("DRM_IOCTL_XE_GEM_CREATE failed: ") + std::strerror(errno);
+            return false;
+        }
+        struct drm_prime_handle pr;
+        std::memset(&pr, 0, sizeof pr);
+        pr.handle = gc.handle;
+        pr.flags = O_RDWR | O_CLOEXEC;
+        if (ioctl(drm_fd_, DRM_IOCTL_PRIME_HANDLE_TO_FD, &pr) < 0) {
+            if (reason) *reason = std::string("DRM_IOCTL_PRIME_HANDLE_TO_FD failed: ") + std::strerror(errno);
+            return false;
+        }
+        struct aw_ioc_map_buffer mb;
+        std::memset(&mb, 0, sizeof mb);
+        mb.in_handle = static_cast<std::uint64_t>(pr.fd);
+        mb.in_source = AW_BUF_DMABUF;
+        mb.in_length = static_cast<std::uint32_t>(rounded);
+        if (ioctl(aw_fd_, AW_IOC_MAP_BUFFER, &mb) < 0) {
+            const int saved = errno;
+            ::close(pr.fd);
+            if (reason) {
+                *reason = std::string("AW_IOC_MAP_BUFFER refused the BO: ") + std::strerror(saved) +
+                          " (a system-memory BO is refused; there is no host-bounce fallback)";
+            }
+            return false;
+        }
+        if (!(mb.out_flags & AW_MAP_F_REQUIRE_P2P)) {
+            // The map itself succeeded; release that registration before
+            // dropping the fd, or the handle would leak (it is never stored).
+            std::uint32_t h = mb.out_handle;
+            ioctl(aw_fd_, AW_IOC_UNMAP_BUFFER, &h);
+            ::close(pr.fd);
+            if (reason) *reason = "AW_IOC_MAP_BUFFER returned without AW_MAP_F_REQUIRE_P2P";
+            return false;
+        }
+        *aw_handle = mb.out_handle;
+        *prime_fd = pr.fd;
+        *bo_size = rounded;
+        return true;
+    }
+
+    void set_layers(std::vector<PinnedLayerGeometry> layers) { layers_ = std::move(layers); }
+
+    const aw_ioc_stats& stats() const { return base_stats_; }
+    aw_ioc_stats current_stats() const {
+        aw_ioc_stats st;
+        std::memset(&st, 0, sizeof st);
+        if (aw_fd_ >= 0) ioctl(aw_fd_, AW_IOC_STATS, &st);
+        return st;
+    }
+
+    bool begin(std::string* reason) override {
+        if (!ok_) {
+            if (reason) *reason = reason_;
+            return false;
+        }
+        if (layers_.empty()) {
+            if (reason) *reason = "pinned NVMe transport has no registered layers";
+            return false;
+        }
+        return true;
+    }
+
+    bool submit(const FillBatch& batch, std::uint64_t* batch_id, std::string* reason) override {
+        if (!ok_) {
+            if (reason) *reason = reason_;
+            return false;
+        }
+        if (batch.requests.empty()) {
+            if (reason) *reason = "pinned NVMe fill: empty batch";
+            return false;
+        }
+        const PinnedLayerGeometry* geom = geometry_for(batch.layer);
+        if (geom == nullptr) {
+            if (reason) *reason = "pinned NVMe fill: no registered geometry for layer " +
+                                  std::to_string(batch.layer);
+            return false;
+        }
+
+        std::vector<aw_ioc_read_blocks> reqs;
+        reqs.reserve(batch.requests.size() * 3);
+        for (const auto& r : batch.requests) {
+            std::uint64_t lba = 0;
+            std::uint64_t len = 0;
+            if (!file_lba(batch.layer, r.slot, &lba, &len, reason)) return false;
+            std::uint64_t record = 0;
+            for (int t = 0; t < 3; ++t) record += geom->tensor_bytes[t];
+            if (len != record) {
+                if (reason) {
+                    *reason = "pinned NVMe fill: store file length " + std::to_string(len) +
+                              " != the layer's concatenated record " + std::to_string(record);
+                }
+                return false;
+            }
+            for (int t = 0; t < 3; ++t) {
+                const std::uint64_t tb = geom->tensor_bytes[t];
+                if (tb == 0 || (tb % 512) != 0 || (tb % 4096) != 0) {
+                    if (reason) *reason = "pinned NVMe fill: tensor bytes not page/block aligned for layer " +
+                                          std::to_string(batch.layer);
+                    return false;
+                }
+                aw_ioc_read_blocks rr;
+                std::memset(&rr, 0, sizeof rr);
+                rr.in_buffer_handle = geom->aw_handle[t];
+                rr.in_start_block = lba + static_cast<std::uint64_t>(t) * (tb / 512);
+                rr.in_block_count = tb / 512;
+                rr.in_dest_offset = static_cast<std::uint64_t>(r.slot) * tb;
+                // in_flags stays 0: AW_READ_F_REVALIDATE is unnecessary for a
+                // fallocated one-plain-extent ext4 store whose block map is
+                // fixed at open (docs/USING_ARCWELL.md section 5).
+                reqs.push_back(rr);
+            }
+        }
+
+        Pending pending;
+        pending.logical = batch.requests.size();
+        const std::size_t kPerBatch = 85;  // 85 * 3 = 255 <= AW_BATCH_MAX
+        for (std::size_t start = 0; start < reqs.size(); start += kPerBatch * 3) {
+            const std::size_t end = std::min(reqs.size(), start + kPerBatch * 3);
+            aw_ioc_batch_submit sb;
+            std::memset(&sb, 0, sizeof sb);
+            sb.in_requests = reinterpret_cast<std::uint64_t>(reqs.data() + start);
+            sb.in_count = static_cast<std::uint32_t>(end - start);
+            if (ioctl(aw_fd_, AW_IOC_SUBMIT_BATCH, &sb) < 0) {
+                drain(pending);
+                if (reason) *reason = std::string("AW_IOC_SUBMIT_BATCH failed: ") + std::strerror(errno);
+                return false;
+            }
+            if (sb.out_err != 0 || sb.out_submitted != sb.in_count) {
+                drain(pending);
+                if (reason) {
+                    *reason = "AW_IOC_SUBMIT_BATCH refused the batch: submitted=" +
+                              std::to_string(sb.out_submitted) + " of " + std::to_string(sb.in_count) +
+                              ", err=" + std::to_string(sb.out_err);
+                }
+                return false;
+            }
+            pending.arcwell_ids.push_back(sb.out_batch_id);
+            pending.expected += sb.in_count;
+        }
+        const std::uint64_t id = next_id_++;
+        inflight_.emplace(id, std::move(pending));
+        *batch_id = id;
+        return true;
+    }
+
+    bool collect(std::uint64_t batch_id, CollectOutcome* outcome, std::string* reason) override {
+        auto it = inflight_.find(batch_id);
+        if (it == inflight_.end()) {
+            if (reason) *reason = "pinned NVMe fill: unknown batch id";
+            return false;
+        }
+        Pending pending = std::move(it->second);
+        inflight_.erase(it);
+
+        std::uint64_t completed = 0;
+        std::uint64_t bytes = 0;
+        std::uint32_t segments = 0;
+        std::int32_t err = 0;
+        for (std::uint64_t id : pending.arcwell_ids) {
+            aw_ioc_batch_wait bw;
+            std::memset(&bw, 0, sizeof bw);
+            bw.in_batch_id = id;
+            bw.in_timeout_us = std::numeric_limits<std::uint64_t>::max();
+            if (ioctl(aw_fd_, AW_IOC_BATCH_WAIT, &bw) < 0) {
+                if (reason) *reason = std::string("AW_IOC_BATCH_WAIT failed: ") + std::strerror(errno);
+                return false;
+            }
+            completed += bw.out_completed;
+            bytes += bw.out_bytes;
+            segments += bw.out_segments;
+            if (bw.out_err != 0 && err == 0) err = bw.out_err;
+        }
+        outcome->requested = pending.logical;
+        outcome->completed = static_cast<std::size_t>(completed / 3);
+        outcome->ok = (completed == pending.expected) && (err == 0);
+        outcome->error = err != 0 ? ("arcwell transfer error " + std::to_string(err)) : "";
+        last_bytes_ = bytes;
+        last_segments_ = segments;
+        return true;
+    }
+
+    void end() override {
+        for (auto& l : layers_) {
+            for (int t = 0; t < 3; ++t) {
+                if (l.aw_handle[t] != 0 && aw_fd_ >= 0) {
+                    std::uint32_t h = l.aw_handle[t];
+                    ioctl(aw_fd_, AW_IOC_UNMAP_BUFFER, &h);
+                    l.aw_handle[t] = 0;
+                }
+            }
+        }
+        if (aw_fd_ >= 0) { ::close(aw_fd_); aw_fd_ = -1; }
+        if (drm_fd_ >= 0) { ::close(drm_fd_); drm_fd_ = -1; }
+    }
+
+    std::uint64_t last_bytes() const { return last_bytes_; }
+    std::uint32_t last_segments() const { return last_segments_; }
+
+private:
+    struct Pending {
+        std::vector<std::uint64_t> arcwell_ids;
+        std::uint64_t expected = 0;
+        std::size_t logical = 0;
+    };
+
+    const PinnedLayerGeometry* geometry_for(std::uint32_t dense_index) const {
+        for (const auto& l : layers_) {
+            if (l.dense_index == dense_index) return &l;
+        }
+        return nullptr;
+    }
+
+    bool file_lba(std::uint32_t dense_index, std::uint32_t slot,
+                  std::uint64_t* lba, std::uint64_t* len, std::string* reason) {
+        const PinnedLayerGeometry* geom = geometry_for(dense_index);
+        if (geom == nullptr) {
+            if (reason) *reason = "pinned NVMe fill: layer geometry missing";
+            return false;
+        }
+        const std::uint64_t ordinal = geom->capacity * dense_index + slot;
+        auto it = lba_cache_.find(ordinal);
+        if (it != lba_cache_.end()) {
+            *lba = it->second.first;
+            *len = it->second.second;
+            return true;
+        }
+        char path[1024];
+        std::snprintf(path, sizeof path, "%s/expert_%04llu.bin", store_dir_.c_str(),
+                      static_cast<unsigned long long>(ordinal));
+        std::uint64_t got_lba = 0, got_len = 0;
+        if (!pinned_file_lba(path, part_start_, &got_lba, &got_len, reason)) return false;
+        lba_cache_.emplace(ordinal, std::make_pair(got_lba, got_len));
+        *lba = got_lba;
+        *len = got_len;
+        return true;
+    }
+
+    void drain(Pending& pending) {
+        for (std::uint64_t id : pending.arcwell_ids) {
+            aw_ioc_batch_wait bw;
+            std::memset(&bw, 0, sizeof bw);
+            bw.in_batch_id = id;
+            bw.in_timeout_us = std::numeric_limits<std::uint64_t>::max();
+            ioctl(aw_fd_, AW_IOC_BATCH_WAIT, &bw);
+        }
+        pending.arcwell_ids.clear();
+    }
+
+    std::string drm_path_;
+    std::string arcwell_path_;
+    std::string store_dir_;
+    std::uint64_t part_start_ = 0;
+    int drm_fd_ = -1;
+    int aw_fd_ = -1;
+    bool ok_ = false;
+    std::string reason_;
+    aw_ioc_stats base_stats_{};
+    std::vector<PinnedLayerGeometry> layers_;
+    std::map<std::uint64_t, Pending> inflight_;
+    std::map<std::uint64_t, std::pair<std::uint64_t, std::uint64_t>> lba_cache_;
+    std::uint64_t next_id_ = 1;
+    std::uint64_t last_bytes_ = 0;
+    std::uint32_t last_segments_ = 0;
+};
+
+}  // namespace lgc::nvme_fill
diff --git a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/aw_uapi.h b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/aw_uapi.h
