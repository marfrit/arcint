+// arcint defect hunt (patches/0008-0010 host-side sizing audit, requested alongside patches/0015):
+// reproduces the on-card GPU CAT-error crash directly in the harness rather than through the
+// full model - u8-K/i4-V (patches/0010's asymmetric decode kernel), a pool sized for >=10,600
+// blocks (>=169,600 tokens at block_size=16) and a past of >=170,000 tokens, at both
+// PAGED_ATTENTION_MAX_PARTITIONS=0 (unbounded, patches/0015's control arm) and =32 (the bound
+// arcint actually serves under). This does NOT depend on the sdpa_opt.cl PREFILL-only
+// IS_KV_COMPRESSED=0 hard-code documented above (paged_attention_asymmetric_kv_pure_prefill_test):
+// every case here has past_len > 0, so it stays on PagedAttentionStage::MIXED/GENERATE, routed to
+// paged_attention_opt.cl's "opt" kernel (PagedAttentionGeneratorMultiTokens /
+// SingleToken) - the correctly IS_INT4_K/IS_INT4_V-split path per that same comment. If a crash
+// reproduces here, the defect is in that opt-kernel path or its host-side sizing at this specific
+// depth, not the already-known PREFILL gap.
+//
+// run_reference is left true for everything EXCEPT the two deepest (past=170,000) cases: this
+// harness's CPU reference has no partial-row / row-limit mode (checked -
+// PagedAttentionReference::get_reference() always walks every query row against the full past),
+// so "compute only a few query rows" has no existing hook to ask for. Turning run_reference off
+// for just those two is the honest substitute - it disables the correctness compare and keeps the
+// dispatch (the actual thing being reproduced: does the kernel crash, not is its output correct).
+class paged_attention_asymmetric_kv_deep_pool_test : public PagedAttentionTest<paged_attention_test_params> {};
+
+TEST_P(paged_attention_asymmetric_kv_deep_pool_test, matches_cpu_reference_or_survives) {
+    auto p = GetParam();
+    ASSERT_TRUE(this->pam.has_value());
+    auto& pam = *this->pam;
+
+    auto result = run_gpu_inference(pam, p);
+
+    if (p.run_reference) {
+        const auto reference = PagedAttentionReference(pam).get_reference(result.key_cache_mem);
+        compare(result.outputs.at("output_data").get_memory(), nullptr, nullptr, reference);
+    }
+}
