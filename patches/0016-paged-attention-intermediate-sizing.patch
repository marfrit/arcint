+// arcint (patches/0016, Opus review, red-first for findings 1 and 2): both tests below reuse
+// the growth test's topology-construction pattern (one network, one paged_attention primitive,
+// re-executed with set_input_data between calls) or, where a single call suffices, the
+// established run_gpu_inference() single-shot harness.
+//
+// Finding 1 (SWA mirror), recast after a design flaw was caught in review: the original test
+// checked that the reported buffer size stayed CONSTANT ("plateaued") across two GENERATE steps
+// both past the sliding window. That is not actually a property of correct SWA sizing - the
+// SWA-shrunk effective_context_len rounds to whole blocks (block_size=16), so effective_blocks
+// can itself flip between two adjacent values one token apart (e.g. around a window/block
+// boundary the correctly-shrunk partition count is not even constant step to step), making
+// "plateau" pass or fail depending on exactly which two steps are sampled, on BOTH correct and
+// buggy code. Recast to something that is actually diagnostic: a single GENERATE call, past
+// 1,999 tokens, sliding_window 256 (>> the window, no boundary-adjacency risk), max_context_len
+// exactly 2,000 - chosen so the two quantities below are unambiguously different (2 vs 1
+// order of magnitude apart, not off-by-one-block): the unshrunk (raw) partition count is
+// ceil_div(2000, 256) = 8; the correctly SWA-shrunk count is ceil_div(256, 256) = 1
+// (total_blocks=ceil_div(2000,16)=125, swa_start_block=(2000-256)/16=109, effective_blocks=16,
+// effective_context_len=256). The test asserts that get_internal_buffer_descs()'s reported
+// exp_sums size, read AFTER this call completes (so rt_params is non-null and its own
+// if-branch is what runs, in every world below - the same call's rt_params, not a stale one),
+// equals total_tokens*heads_num*element_size*num_of_partitions where num_of_partitions is the
+// ACTUAL value update_rt_params computed for this exact dispatch (read via
+// get_kernels_dump_info()'s "arcint_0015_diag:num_of_partitions=" entry, patches/0015) - i.e.
+// that the buffer the plugin sized for this call and the partition count the plugin actually
+// dispatched with agree, rather than checking either number against a hand-computed constant.
+//
+// Which world this is red in, reasoned through rather than assumed: under 0015 alone (no 0016 at
+// all), get_internal_buffer_descs()'s if-branch is `num_of_partitions = rt_params->
+// num_of_partitions` - reading the SAME field the diag string reports, so they trivially agree
+// - GREEN. Under the first (pre-review) draft of 0016 - the one finding 1 itself describes,
+// where the always-computed "fresh" estimate did not mirror the SWA shrink - the if-branch
+// becomes `max(fresh_UNSHRUNK=8, rt_params->num_of_partitions_SHRUNK=1) = 8`, disagreeing with
+// the diag's actual dispatched value of 1 - RED. Under 0016-final (finding 1 fixed, this file's
+// own hunk), fresh is shrunk the same way rt_params is, so the if-branch is
+// `max(fresh_SHRUNK=1, rt_params->num_of_partitions_SHRUNK=1) = 1`, matching the diag - GREEN.
+class paged_attention_review_swa_mirror_test : public PagedAttentionTest<paged_attention_test_params> {};
+
+TEST_P(paged_attention_review_swa_mirror_test, exp_sums_size_matches_the_actual_dispatched_partition_count) {
+    auto p = GetParam();
+    ASSERT_TRUE(this->pam.has_value());
+    auto& pam = *this->pam;
+
+    ASSERT_GT(p.sliding_window_size, 0);
+
+    auto result = run_gpu_inference(pam, p);
+
+    auto pa_inst = result.network->get_primitive("paged_attention");
+    ASSERT_NE(pa_inst, nullptr);
+    auto* impl = pa_inst->get_impl();
+    ASSERT_NE(impl, nullptr);
+
+    // The diag string: the ACTUAL num_of_partitions update_rt_params computed and dispatched
+    // with, for this exact call - the ground truth this test checks buffer sizing against.
+    const auto dump_info = impl->get_kernels_dump_info(*pa_inst->get_impl_params());
+    const auto& entries = dump_info.get_entries();
+    const auto diag_pos = entries.find("arcint_0015_diag:");
+    ASSERT_NE(diag_pos, std::string::npos)
+        << "Expected the arcint_0015_diag entry (paged_attention_opt.cpp's "
+        << "PagedAttentionOptImpl::get_kernels_dump_info override) - got: " << entries;
+    const auto diag = entries.substr(diag_pos);
+    const auto key_pos = diag.find("num_of_partitions=");
+    ASSERT_NE(key_pos, std::string::npos) << "Expected a num_of_partitions= field: " << diag;
+    const auto value_start = key_pos + std::string("num_of_partitions=").size();
+    const auto value_end = diag.find(';', value_start);
+    ASSERT_NE(value_end, std::string::npos) << "num_of_partitions= field not terminated: " << diag;
+    const size_t actual_num_of_partitions = std::stoull(diag.substr(value_start, value_end - value_start));
+
+    // The reported size: get_internal_buffer_descs(), a host-side call - not the real GPU
+    // allocation - reflecting the SAME call's now-non-null rt_params (this is called AFTER
+    // run_gpu_inference()'s own execute() already ran, so realloc_intermediates() already ran
+    // too and rt_params already holds THIS call's values, not a stale previous one - matching
+    // what the plugin's own internal re-query would see if called again right now).
+    const auto descs = impl->get_internal_buffer_descs(*pa_inst->get_impl_params());
+    ASSERT_GT(descs.size(), 3u);
+    const size_t exp_sums_bytes = descs[3].m_layout.count();  // descs report BYTES, not elements
+    const size_t heads_num = static_cast<size_t>(p.num_heads);
+    constexpr size_t softmax_accumulator_element_size = 4;  // f32
+    const int64_t total_tokens = result.network->get_primitive("paged_attention")->get_impl_params()->input_layouts[0].get_partial_shape()[0].get_length();
+    const size_t expected_bytes =
+        static_cast<size_t>(total_tokens) * heads_num * actual_num_of_partitions * softmax_accumulator_element_size;
+
+    ASSERT_EQ(exp_sums_bytes, expected_bytes)
+        << "exp_sums sized for " << exp_sums_bytes << " bytes but the actual dispatch used "
+        << actual_num_of_partitions << " partitions (" << expected_bytes << " bytes expected) - "
+        << "the SWA shrink is not mirrored into the fresh sizing estimate";
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    regression_paged_attention_review_swa_mirror,
+    paged_attention_review_swa_mirror_test,
+    ::testing::Values(paged_attention_test_params{
+        {{1, 1999}},
+        8, 2, 128, 128, 16, 256,
+        DISABLE_CACHE_COMPRESSION,
+        ov::internal::CacheQuantMode::BY_TOKEN,
+        DYNAMIC_INPUT_PAD, DISABLE_SCORES, DISABLE_ROTATION, DISABLE_FA_V2,
+        false, 0, {},
+        false, {}, {},
+        ov::element::dynamic,
+        false, {}, false,
+        std::nullopt, false, std::nullopt, false, false,
+        ov::element::dynamic,
+        0
