+        paged_attention_test_params{
+            {{100352, 0}},
+            8, 2, 128, 128, 16, 0,
+            ENABLE_CACHE_COMPRESSION,
+            ov::internal::CacheQuantMode::BY_TOKEN,
+            DYNAMIC_INPUT_PAD, DISABLE_SCORES, DISABLE_ROTATION, DISABLE_FA_V2,
+            false, 0, {},
+            false, {}, {},
+            ov::element::u8,
