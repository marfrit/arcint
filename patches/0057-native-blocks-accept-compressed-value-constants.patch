# Native expert pattern blocks accept a value Constant behind the f16->f32
# Convert that save_model(compress_to_fp16=True) inserts, so a --dense-fp16
# artifact's decode chains fuse instead of being constant-folded.
#
--- a/src/common/transformations/src/transformations/pattern_blocks/native_expert_block.cpp
+++ b/src/common/transformations/src/transformations/pattern_blocks/native_expert_block.cpp
@@ -35,11 +35,28 @@
 namespace v8 = ov::op::v8;
 namespace v13 = ov::op::v13;
 
+namespace {
+// arcint (patch 0057): a value Constant of the decode chain, bare or behind
+// the f16->f32 Convert that ov::save_model(compress_to_fp16=True) inserts.
+// The exporter's --dense-fp16 compresses EVERY f32 Constant, including the
+// chain's grids, tables, +-1 and divisors (all exact in f16); a bare
+// wrap_type<Constant> then matched no layer of a --dense-fp16 artifact
+// (measured 2026-09-26: MOE_COMPRESSED 0 of 40 on the full-depth packed IR,
+// 4 of 4 on the uncompressed depth-4 one) and the GPU compile constant-folded
+// every chain. The kernels carry their own tables and read only the anchors.
+std::shared_ptr<ov::Node> value_const(const std::shared_ptr<ov::Node>& c) {
+    return ov::pass::pattern::optional<v0::Convert>({c});
+}
+std::shared_ptr<ov::Node> value_const() {
+    return value_const(wrap_type<v0::Constant>());
+}
+}  // namespace
