# The K-quant kernel's timing test streams: eight weight buffers in rotation on one queue

# Applied against the pinned runtime, build 2026.4.0-22849-71640275d29, on top of
# patches/0003-0022. arcint 0.4.1 (DESIGN.md section 7.0.2bb). The test only; the kernel
# of 0022 is unchanged.
#
# What changes:
#   fully_connected_gpu_test.cpp   The DISABLED_ timing case of the K-quant kernel ran ten
#                       launches of ONE 50 MB weight back to back, and 18 MB of it stayed in
#                       the 24 GB card's L2 between launches: every launch figure recorded
#                       for 0021 and 0022 is that L2-assisted number (by up to a third of
#                       the rows). The case now builds eight independent weight buffers and
#                       runs their networks in rotation on the shared test stream, so no
#                       launch finds its rows in cache and none overlaps another (eight
#                       networks on their own streams overlapped and reported 392 GB/s that
#                       no served step gets).
#
# MEASURED with it, the 0022 kernel, one row, 24 GB card: the gate projection (N 17,408,
# K 5,120) 171 us, 293 GB/s of rows; the down projection (N 5,120, K 17,408) 219 us,
# 229 GB/s; the value projection (N 1,024) 97 us for 3 MB. The int8-activation decode
# kernel built in the same window (activations quantised per 32 in registers, byte-
# parallel unpack, the 4x8-bit integer dot: 159 and 165 us streamed) is recorded in
# DESIGN 7.0.2bb and NOT carried: 8/10 on the Prüfstand, and the same served rate.
#
# Upstream: not yet filed.

--- a/src/plugins/intel_gpu/tests/unit/test_cases/fully_connected_gpu_test.cpp
+++ b/src/plugins/intel_gpu/tests/unit/test_cases/fully_connected_gpu_test.cpp
@@ -6729,38 +6729,49 @@
 
 // Timing at the dense model's gate projection shape, both kernels (run by name; prints KQPERF lines).
 TEST(fully_connected_gpu_kquant_perf, DISABLED_dense_shapes_q4k) {
+    // Streams: eight independent weight buffers in rotation on one queue, so no launch
+    // finds its rows in the 18 MB L2 (ten launches of ONE buffer let a third of it hit,
+    // which overstated every launch figure before this test was corrected; and eight
+    // networks on their own streams overlapped their launches -- DESIGN 7.0.2bb).
     tests::random_generator rg(GET_SUITE_NAME);
     auto& engine = get_test_engine();
     const int t = 12;
-    // (N, K, rows): the gate projection at four row counts, then the value projection and the
-    // down projection at one row (narrow and deep: the decode split's two other regimes).
     const std::vector<std::tuple<size_t, size_t, std::vector<long>>> shapes = {
         {17408, 5120, {1L, 32L, 256L, 2048L}}, {1024, 5120, {1L}}, {5120, 17408, {1L}}};
+    const int rotation = 8;
     for (const auto& sh : shapes) {
     const size_t N = std::get<0>(sh), K = std::get<1>(sh);
     const size_t rb = kq_host::row_bytes(t, K);
-    auto wbytes = rg.generate_random_1d<uint8_t>(N * rb, 0, 255);
-    auto weights_mem = engine.allocate_memory({ { (long)N, (long)rb }, data_types::u8, format::bfyx });
-    set_values(weights_mem, wbytes);
+    std::vector<memory::ptr> weights_mems;
+    for (int r = 0; r < rotation; ++r) {
+        auto wbytes = rg.generate_random_1d<uint8_t>(N * rb, 0, 255);
+        auto wm = engine.allocate_memory({ { (long)N, (long)rb }, data_types::u8, format::bfyx });
+        set_values(wm, wbytes);
+        weights_mems.push_back(wm);
+    }
     for (long m : std::get<2>(sh)) {
         auto xh = rg.generate_random_1d<ov::float16>(m * K, -1.0f, 1.0f);
         auto input_mem = engine.allocate_memory({ { m, (long)K }, data_types::f16, format::bfyx });
         set_values(input_mem, xh);
-        auto fc = fully_connected("fc_kq", input_info("input"), "weights", "", data_types::f16, 2, 2, true);
-        fc.kquant_type = t; fc.kquant_k = K; fc.kquant_n = N;
-        topology topology(input_layout("input", layout{ { -1, (long)K }, data_types::f16, format::bfyx }), data("weights", weights_mem), fc);
-        auto config = get_test_default_config(engine);
-        config.set_property(ov::intel_gpu::allow_new_shape_infer(true));
-        network net(engine, topology, config);
-        net.set_input_data("input", input_mem);
-        net.execute(); net.get_stream().finish();
-        const int reps = 10;
+        std::vector<std::unique_ptr<network>> nets;
+        for (int r = 0; r < rotation; ++r) {
+            auto fc = fully_connected("fc_kq", input_info("input"), "weights", "", data_types::f16, 2, 2, true);
+            fc.kquant_type = t; fc.kquant_k = K; fc.kquant_n = N;
+            topology topology(input_layout("input", layout{ { -1, (long)K }, data_types::f16, format::bfyx }), data("weights", weights_mems[r]), fc);
+            auto config = get_test_default_config(engine);
+            config.set_property(ov::intel_gpu::allow_new_shape_infer(true));
+            auto prog = program::build_program(engine, topology, config, false, false);
+            nets.push_back(std::make_unique<network>(prog, get_test_stream_ptr(), uint16_t{0}));  // one queue: launches in sequence, as a served step issues them
+            nets.back()->set_input_data("input", input_mem);
+            nets.back()->execute();
+        }
+        get_test_stream().finish();
+        const int reps = 2;
         auto t0 = std::chrono::steady_clock::now();
-        for (int i = 0; i < reps; ++i) { net.execute(); }
-        net.get_stream().finish();
-        const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count() / reps;
-        std::cout << "KQPERF M=" << m
-                  << " N=" << N << " K=" << K << " Q4_K: " << us << " us per run, " << (double)(N * rb) / us / 1e3 << " GB/s weights" << std::endl;
+        for (int i = 0; i < reps; ++i) for (auto& n : nets) n->execute();
+        get_test_stream().finish();
+        const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count() / (reps * rotation);
+        std::cout << "KQPERF M=" << m << " N=" << N << " K=" << K << " Q4_K: " << us << " us per run, " << (double)(N * rb) / us / 1e3 << " GB/s weights (streamed)" << std::endl;
     }
     }
 }
