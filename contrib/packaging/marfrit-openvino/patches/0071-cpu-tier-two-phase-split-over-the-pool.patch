+// The schedule the plugin runs: cpu_tier_dispatch on a real pool, eight
+// Flash-Next experts (one to three jobs each, like a decode step's misses),
+// split and unsplit, against the whole-expert call per expert. Repeated, so a
+// phase 2 that started before its phase 1 finished (the chaining broken) would
+// show as wrong bytes rather than pass by timing.
+TEST(moe_cpu_tier_split, the_pool_schedule_gives_the_whole_expert_bytes) {
+    const int H = 2560, I = 640, E = 8;
+    std::mt19937 rng(73);
+    std::vector<std::unique_ptr<NativeExpertData>> ex;
+    std::vector<std::unique_ptr<JobSet>> js;
+    std::vector<std::vector<std::vector<uint16_t>>> whole;
+    for (int x = 0; x < E; x++) {
+        ex.push_back(make_native_expert(H, I, rng));
+        js.push_back(std::make_unique<JobSet>(H, 1 + x % 3, rng));
+        ov::intel_gpu::ocl::moe::moe_cpu_expert(ex[x]->e, js[x]->jobs.data(), js[x]->jobs.size(), 0, H);
+        whole.push_back(js[x]->y);
+    }
+    std::vector<CpuTierExpertWork> work;
+    for (int x = 0; x < E; x++)
+        work.push_back(CpuTierExpertWork{&ex[x]->e, js[x]->jobs.data(), js[x]->jobs.size()});
+    CpuTierPool pool(7);
+    const CpuTierSplit plan = ov::intel_gpu::ocl::moe::cpu_tier_split_plan(E, pool.thread_count(), I, H);
+    ASSERT_GT(plan.gate_up_chunks, 1) << "the plan does not split a decode step's experts: the cell would test nothing new";
+    for (CpuTierSplit split : {CpuTierSplit{1, 1}, plan, CpuTierSplit{10, 10}, CpuTierSplit{3, 1}, CpuTierSplit{1, 4}}) {
+        for (int rep = 0; rep < 4; rep++) {
+            for (auto& s : js) s->clear();
+            std::atomic<int> tasks{0}, firsts{0};
+            ov::intel_gpu::ocl::moe::cpu_tier_dispatch(pool, work, split,
+                [&](size_t, bool first, std::chrono::steady_clock::time_point, std::chrono::steady_clock::time_point) {
+                    tasks++;
+                    if (first) firsts++;
+                });
+            pool.wait();
+            EXPECT_EQ(firsts.load(), E);
+            EXPECT_EQ(tasks.load(), E * (split.gate_up_chunks + split.down_chunks == 2 ? 1 : split.gate_up_chunks + split.down_chunks));
+            for (int x = 0; x < E; x++)
+                for (size_t j = 0; j < js[x]->jobs.size(); j++)
+                    EXPECT_EQ(0, std::memcmp(whole[x][j].data(), js[x]->y[j].data(), sizeof(uint16_t) * H))
+                        << "split " << split.gate_up_chunks << "/" << split.down_chunks << " rep " << rep << " expert " << x << " job " << j;
+        }
+    }
+}
+
+// The plan: experts that leave the pool's last round short (a count that is
+// not a multiple of the workers) are split so the call has at least twice as
+// many tasks as workers (where the chunk floors allow that many), gate/up in
+// at least as many chunks as down, gate/up chunks at least 64 rows and down
+// chunks at least 256 columns; a whole number of rounds, or a one-thread
+// pool, keeps whole-expert tasks.
+TEST(moe_cpu_tier_split, the_plan_fills_the_pool_and_keeps_whole_experts_when_they_do) {
+    using ov::intel_gpu::ocl::moe::cpu_tier_split_plan;
+    const int H = 2560, I = 640;
+    for (size_t W : {3u, 7u, 8u, 15u}) {
+        for (size_t n = 1; n < 6 * W; n++) {
+            const CpuTierSplit s = cpu_tier_split_plan(n, W, I, H);
+            if (n % W == 0) {
+                EXPECT_EQ(s.gate_up_chunks, 1) << "W " << W << " n " << n;
+                EXPECT_EQ(s.down_chunks, 1) << "W " << W << " n " << n;
+                continue;
+            }
+            EXPECT_GE(n * static_cast<size_t>(s.gate_up_chunks + s.down_chunks), std::min(2 * W, n * (I / 64 + H / 256)))
+                << "W " << W << " n " << n;
+            EXPECT_GT(s.gate_up_chunks, 1) << "W " << W << " n " << n;
+            EXPECT_GE(I / s.gate_up_chunks, 64) << "W " << W << " n " << n;
+            EXPECT_GE(H / s.down_chunks, 256) << "W " << W << " n " << n;
+            EXPECT_GE(s.gate_up_chunks, s.down_chunks) << "W " << W << " n " << n;
+        }
+    }
+    const CpuTierSplit one = cpu_tier_split_plan(3, 1, I, H);
+    EXPECT_EQ(one.gate_up_chunks, 1);
+    EXPECT_EQ(one.down_chunks, 1);
+}
