+CpuTierSplit cpu_tier_split_plan(size_t n_experts, size_t workers, int inter, int hidden) {
+    CpuTierSplit s;
+    // Whole experts when they already fill every round of the pool (a
+    // multiple of the worker count: splitting there measured 1.5-8 % slower
+    // on the tier bench at 7, 14 and 21 experts on 7 workers).
+    if (workers < 2 || n_experts == 0 || n_experts % workers == 0)
+        return s;
+    // t tasks per expert, a third of them down chunks (down is one matrix of
+    // the expert's three): at least 6 (4 gate/up + 2 down, the best of 2/1,
+    // 3/1 and 4/2 at 8 experts on 7 workers) while the call has under 4 rounds of
+    // whole experts, else 3; more when that leaves the call under 6 * workers
+    // tasks.
+    const size_t floor_t = n_experts < 4 * workers ? 6 : 3;
+    const size_t t = std::max(floor_t, (6 * workers + n_experts - 1) / n_experts);
+    size_t d = std::max<size_t>(1, t / 3);
+    size_t g = t - d;
+    g = std::min<size_t>(g, static_cast<size_t>(std::max(1, inter / 64)));
+    d = std::min<size_t>(d, static_cast<size_t>(std::max(1, hidden / 256)));
+    d = std::min(d, g);
+    s.gate_up_chunks = static_cast<int>(g);
+    s.down_chunks = static_cast<int>(d);
+    return s;
+}
