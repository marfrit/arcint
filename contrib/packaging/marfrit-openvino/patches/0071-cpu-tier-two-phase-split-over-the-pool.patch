+// arcint (patch 0071). The CPU tier runs a decode step's few experts as
+// several pool tasks each: gate/up/SwiGLU over row chunks, then down over
+// column chunks (moe_cpu_expert_gate_up / moe_cpu_expert_down, scheduled by
+// cpu_tier_dispatch). The split must give moe_cpu_expert's bytes -- the
+// pre-0071 whole-expert call, unchanged by this patch -- for every chunking,
+// every job count and every format the tier serves. Flash-Next geometry
+// (hidden 2560, inter 640); the chunk bounds include ones off the 8-row pass
+// grid of the stage kernels. Red: a phase that writes h or y at a chunk-local
+// offset, drops a chunk's tail, or rounds differently changes bytes here.
+namespace {
+using ov::intel_gpu::ocl::moe::CpuTierExpertWork;
+using ov::intel_gpu::ocl::moe::CpuTierPool;
+using ov::intel_gpu::ocl::moe::CpuTierSplit;
+
+struct NativeExpertData {
+    std::vector<uint8_t> gw, gz, uw, uz, dw;
+    std::vector<uint16_t> gs, us, ds;
+    ExpertDesc e;
+};
+
+// IQ3_XXS gate/up, IQ4_NL down, random blocks and scales (the served
+// Flash-Next expert formats).
+std::unique_ptr<NativeExpertData> make_native_expert(int H, int I, std::mt19937& rng) {
+    auto d = std::make_unique<NativeExpertData>();
+    auto bytes = [&](size_t n, int mod) {
+        std::vector<uint8_t> v(n);
+        for (auto& b : v) b = static_cast<uint8_t>(rng() % static_cast<unsigned>(mod));
+        return v;
+    };
+    std::uniform_real_distribution<float> scale(0.01f, 0.05f);
+    auto scales = [&](size_t n) {
+        std::vector<uint16_t> v(n);
+        for (auto& x : v) x = f32_to_f16_bits(scale(rng));
+        return v;
+    };
+    const size_t IH = static_cast<size_t>(I) * static_cast<size_t>(H);
+    d->gw = bytes(IH / 4, 256); d->gz = bytes(IH / 8, 128); d->uw = bytes(IH / 4, 256); d->uz = bytes(IH / 8, 128);
+    d->gs = scales(IH / 32); d->us = scales(IH / 32); d->dw = bytes(IH / 2, 256); d->ds = scales(IH / 32);
+    d->e.gate = native_matrix(kQuantFormatIq3Xxs, H, d->gw.data(), d->gz.data(), d->gs.data());
+    d->e.gate.oc = I;
+    d->e.up = native_matrix(kQuantFormatIq3Xxs, H, d->uw.data(), d->uz.data(), d->us.data());
+    d->e.up.oc = I;
+    d->e.down = native_matrix(kQuantFormatIq4Nl, I, d->dw.data(), nullptr, d->ds.data());
+    d->e.down.oc = H;
+    return d;
+}
+
+struct JobSet {
+    std::vector<std::vector<uint16_t>> x, y;
+    std::vector<ExpertJob> jobs;
+    JobSet(int H, int J, std::mt19937& rng) : x(J, std::vector<uint16_t>(H)), y(J, std::vector<uint16_t>(H, 0)), jobs(J) {
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        for (auto& row : x)
+            for (auto& v : row) v = f32_to_f16_bits(nd(rng));
+        for (int j = 0; j < J; j++)
+            jobs[j] = ExpertJob{x[j].data(), f32_to_f16_bits(0.1f * static_cast<float>(j + 1)), y[j].data()};
+    }
+    void clear() {
+        for (auto& row : y) std::fill(row.begin(), row.end(), uint16_t{0});
+    }
+};
+
+// Runs the two phases over the given chunk bounds and returns every job's y.
+std::vector<std::vector<uint16_t>> run_phases(const ExpertDesc& e, JobSet& js, const std::vector<int>& rows,
+                                              const std::vector<int>& cols, bool ref) {
+    const size_t J = js.jobs.size();
+    const int inter = e.up.oc;
+    std::vector<float> h(J * static_cast<size_t>(inter), std::numeric_limits<float>::quiet_NaN());
+    js.clear();
+    for (size_t c = 0; c + 1 < rows.size(); c++) {
+        if (ref)
+            ov::intel_gpu::ocl::moe::moe_cpu_expert_gate_up_ref(e, js.jobs.data(), J, rows[c], rows[c + 1], h.data());
+        else
+            ov::intel_gpu::ocl::moe::moe_cpu_expert_gate_up(e, js.jobs.data(), J, rows[c], rows[c + 1], h.data());
+    }
+    for (size_t c = 0; c + 1 < cols.size(); c++) {
+        if (ref)
+            ov::intel_gpu::ocl::moe::moe_cpu_expert_down_ref(e, js.jobs.data(), J, h.data(), cols[c], cols[c + 1]);
+        else
+            ov::intel_gpu::ocl::moe::moe_cpu_expert_down(e, js.jobs.data(), J, h.data(), cols[c], cols[c + 1]);
+    }
+    return js.y;
+}
+
+// Checks the split against the whole-expert call for several chunkings.
+void expect_split_gives_whole_bytes(const ExpertDesc& e, int J, std::mt19937& rng, bool ref) {
+    const int H = e.down.oc, I = e.up.oc;
+    JobSet js(H, J, rng);
+    if (ref)
+        moe_cpu_expert_ref(e, js.jobs.data(), static_cast<size_t>(J), 0, H);
+    else
+        ov::intel_gpu::ocl::moe::moe_cpu_expert(e, js.jobs.data(), static_cast<size_t>(J), 0, H);
+    const auto whole = js.y;
+    for (const auto& row : whole) {
+        size_t nonzero = 0;
+        for (auto v : row) nonzero += (v & 0x7FFFu) != 0;
+        ASSERT_GT(nonzero, static_cast<size_t>(H) / 2) << "the whole-expert output is mostly zero: the cell could not see a dropped chunk";
+    }
+    const std::vector<std::vector<int>> row_splits = {{0, I}, {0, I / 4, I / 2, 3 * I / 4, I}, {0, 13, 160, 333, I}, {0, 8, 16, I - 8, I}};
+    const std::vector<std::vector<int>> col_splits = {{0, H}, {0, H / 2, H}, {0, 7, 1280, 2001, H}, {0, 256, 512, 768, H}};
+    for (size_t r = 0; r < row_splits.size(); r++)
+        for (size_t c = 0; c < col_splits.size(); c++) {
+            const auto got = run_phases(e, js, row_splits[r], col_splits[c], ref);
+            for (int j = 0; j < J; j++)
+                EXPECT_EQ(0, std::memcmp(whole[j].data(), got[j].data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+                    << "jobs " << J << " job " << j << " row split " << r << " col split " << c;
+        }
+}
+}  // namespace
+
+TEST(moe_cpu_tier_split, the_phases_give_the_whole_expert_bytes_native_iq3xxs_iq4nl) {
+    std::mt19937 rng(71);
+    auto x = make_native_expert(2560, 640, rng);
+    for (int J : {1, 3, 9}) {
+        SCOPED_TRACE(J);
+        expect_split_gives_whole_bytes(x->e, J, rng, false);
+        expect_split_gives_whole_bytes(x->e, J, rng, true);
+    }
+}
+
+TEST(moe_cpu_tier_split, the_phases_give_the_whole_expert_bytes_affine_u4) {
+    // The dispatcher's affine kernel (AVX2 when present) and the scalar
+    // reference; SiLU (the served activation) and tanh-GELU.
+    std::mt19937 rng(72);
+    auto x = SyntheticExpert::make(2560, 640, 64, rng);
+    for (GateAct act : {GateAct::Silu, GateAct::GeluTanh}) {
+        x.desc.act = act;
+        for (int J : {1, 3}) {
+            SCOPED_TRACE(J);
+            expect_split_gives_whole_bytes(x.desc, J, rng, false);
+            expect_split_gives_whole_bytes(x.desc, J, rng, true);
+        }
+    }
+}
