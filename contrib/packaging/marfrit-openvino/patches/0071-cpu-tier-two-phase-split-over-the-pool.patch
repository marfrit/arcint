+void run_observed(const SplitCall& call, size_t x, bool first, const std::function<void()>& body) {
+    if (!call.observer) {
+        body();
+        return;
+    }
+    const auto ts = std::chrono::steady_clock::now();
+    body();
+    call.observer(x, first, ts, std::chrono::steady_clock::now());
