+            });
+        }
+        pool.dispatch(std::move(tasks));
+        return;
+    }
+    auto call = std::make_shared<SplitCall>();
+    call->pool = &pool;
+    call->work = work;
+    call->split = CpuTierSplit{std::max(1, split.gate_up_chunks), std::max(1, split.down_chunks)};
+    call->observer = observer;
