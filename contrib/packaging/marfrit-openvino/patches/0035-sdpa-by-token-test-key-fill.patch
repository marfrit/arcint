+// arcint (patch 0035): the by-token key-fill fix -- the constant fill overflowed fp16 zp in
+// quantize_data(); the per-dimension ramp keeps every token's range meaningful (DESIGN 7.0.2br).
 INSTANTIATE_TEST_SUITE_P(
-    DISABLED_arcint_0034_by_token_nan,
+    arcint_0035_by_token_key_fill,
     paged_attention_u8i4_mixed_micro_test,
     ::testing::Values(u8i4_by_token_default_geom({{2, 34}}),               // exact
                       u8u8_by_token(u8i4_by_token_default_geom({{2, 34}})),  // exact
-                      u8i4_by_token_default_geom({{2, 130}}),              // all NaN, generic kernel
-                      u8u8_by_token(u8i4_by_token_default_geom({{2, 130}})),  // all NaN, micro SDPA
+                      u8i4_by_token_default_geom({{2, 130}}),              // was NaN, now passes
