+// arcint (patch 0034): patch 0020 declines four-bit values under BY_TOKEN keys, on a 2026-09-05
+// measurement of NaN past 128 keys. Re-measured 2026-09-08 with 0033's discriminating fill, on the
+// 24 GB card, and the decline was NOT lifted -- because the same by-token cases fail with EIGHT-bit
+// values too, a pairing this decline does not govern and which runs on micro SDPA rather than the
+// generic kernel. Two different kernels, one fill, the same all-NaN output. The fill is not the
+// explanation either: at head 128 with 36 keys both precisions are exact (max 0.002, no NaN), and
+// both go all-NaN at 132 keys; at the served head 256 the NaN is already a quarter of the elements
+// at 36 keys, three quarters at 102, all of them from 126. The failure tracks the causal length and
+// the head size, and ignores the value precision and the kernel. What the common element is -- the
+// harness's own by-token page writing, its cache sizing, or the key dequantisation both kernels
+// share -- is NOT measured, and no mechanism is claimed here.
+//
+// Nothing served is affected: arcint never selects BY_TOKEN keys (the plugin defaults to BY_CHANNEL
+// and forces BY_TOKEN only for graphs carrying cache-block rotation, which arcint's do not).
+// The instantiation below is DISABLED for that reason -- it is the reproducer, kept so the next
+// reader starts from the measurement instead of rebuilding it. Run it with
+// --gtest_also_run_disabled_tests.
+static paged_attention_test_params u8i4_mixed_micro_by_token(std::vector<SubsequenceDescriptor> subsequences) {
+    paged_attention_test_params p = u8i4_mixed_micro_served(std::move(subsequences));
+    p.key_cache_quant_mode = ov::internal::CacheQuantMode::BY_TOKEN;
+    return p;
+}
+
+// The same, at the test's default geometry (32 heads, 2 KV heads, head 128) rather than the served
+// one (24 heads, 4 KV heads, head 256): this is the pair that shows the length threshold.
+static paged_attention_test_params u8i4_by_token_default_geom(std::vector<SubsequenceDescriptor> subsequences) {
+    paged_attention_test_params p = u8i4_mixed_micro_params(std::move(subsequences));
+    p.key_cache_quant_mode = ov::internal::CacheQuantMode::BY_TOKEN;
+    return p;
+}
+
+// Eight-bit values, by-token keys: the control that kept the decline in place. The fill writes
+// sixteen integer levels per (token, head) row, which u8 by-token stores exactly.
+static paged_attention_test_params u8u8_by_token(paged_attention_test_params p) {
+    p.value_cache_precision = ov::element::u8;
+    return p;
+}
+
 class paged_attention_u8i4_mixed_micro_test : public PagedAttentionTest<paged_attention_test_params> {};
 
