+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+// arcint M14 (patches/0011). Host CPU compute tier for MoE decode. A capacity
+// miss in the device slot pool (see expert_weight_provider.hpp's
+// kCpuTierSentinelSlot, patches/0012) is computed here instead of being
+// uploaded and evicting a resident expert. See this patch's header for the
+// weight-layout derivation (the nibble order and the scale/zp axes) and the
+// rounding table this kernel reproduces from the GPU stages.
+//
+// This header has no dependency on cldnn/OpenVINO plugin types so that
+// tests/unit/test_cases/moe_cpu_expert_test.cpp can exercise it as a pure
+// host library with no GPU engine constructed (§8 T1 of the binding spec).
+
+#pragma once
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <deque>
+#include <vector>
+
+namespace ov::intel_gpu::ocl::moe {
+
+// One quantised weight matrix as it is stored in the OTD weight file:
+// w   : [oc][ic] 4- or 8-bit, ic contiguous; for 4-bit, byte j of a row holds
+//       element 2j in the low nibble and 2j+1 in the high nibble (see the
+//       derivation in this patch's header, from moe_3gemm_swiglu_mlp.cl:547/126).
+// s   : [oc][group_count] f16 (raw bit patterns), FILE order -- not the [group][oc]
+//       order maybe_transpose_scale_zp produces for the device.
+// z   : [oc][group_count], u4 packed two per byte with the even linear index in the
+//       low nibble, or u8 one per byte. nullptr when has_zp is false.
+struct QuantMatrix {
+    const uint8_t*  w = nullptr;
+    const uint16_t* s = nullptr;
+    const uint8_t*  z = nullptr;
+    int oc = 0;
+    int ic = 0;
+    int group_size = 0;      // == ic when the config's group_size is SIZE_MAX
+    int weight_bits = 4;     // 4 or 8
+    bool weight_signed = false;
+    bool has_zp = true;
+    bool zp_is_u8 = false;
+};
+
+enum class GateAct { Silu, GeluTanh, GeluErf };   // mirrors MOE_GATE_ACT, mlp.cl:46-65
+
+struct ExpertDesc {
+    QuantMatrix gate, up, down;
+    GateAct act = GateAct::Silu;
+};
+
+// One (token, expert) pair to compute.
+//   x        : [hidden] f16 bit patterns (the token's hidden_states row)
+//   w_route  : f16 bit pattern of routing_weights[flat position]
+//   y        : [hidden] f16 bit patterns, written by the kernel
+struct ExpertJob {
+    const uint16_t* x = nullptr;
+    uint16_t        w_route = 0;
+    uint16_t*       y = nullptr;
+};
+
+// y = w_route * down( silu(gate(x)) * up(x) ) for one expert over its token list.
+// Rounding is chosen to match the GPU stage boundaries exactly (see the patch
+// header's rounding table): f32 accumulation inside a stage, f16 at every
+// store the GPU makes.
+//
+// col_begin/col_end partition the *down* stage's output columns (`hidden`);
+// gate/up/SwiGLU are always computed in full for a job -- see moe_cpu_expert.cpp's
+// CpuTierPool task partition for how the caller avoids redundant gate/up work
+// when splitting across threads.
+void moe_cpu_expert_ref(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end);
+
+// AVX2+FMA3+F16C kernel. Only compiled (and only linked) when the build has
+// ENABLE_AVX2; see moe_cpu_expert_avx2.cpp and the CMakeLists.txt guard.
+void moe_cpu_expert_avx2(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end);
+
+// arcint M14 (§8 T1c). Same algorithm as moe_cpu_expert_ref, except every
+// per-lane partial dot product is accumulated with the GPU's within-fake-group
+// half rounding (moe_3gemm_swiglu_mlp.cl:124-146) instead of f32, parameterised
+// by (subgroup_size, elems_per_lane) so it can reproduce either card
+// (SG=32/EPL=2, or SG=16/EPL=4 -- both seen on served hardware). This
+// predicts the on-card divergence between the CPU tier and the GPU path; it
+// is not itself a correctness oracle -- T1c only records the max relative
+// diff against moe_cpu_expert_ref via ::testing::Test::RecordProperty.
+void moe_cpu_expert_ref_gpu_emul(const ExpertDesc& e,
+                                 const ExpertJob* jobs,
+                                 size_t n_jobs,
+                                 int col_begin,
+                                 int col_end,
+                                 int subgroup_size,
+                                 int elems_per_lane);
+
+// Runtime dispatch: avx2 when the build has it AND ov::with_cpu_x86_avx2(), else ref.
+void moe_cpu_expert(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end);
+
+// arcint M14 (patches/0012 wires this up; declared here so T1 can exercise it
+// standalone). Plain std::thread + condvar pool, independent of whatever
+// executor the plugin's streams use -- it runs *inside* an infer request
+// while that executor's thread is the one blocked in cpu_tier_join(). One
+// process-wide pool (a Meyers singleton, see moe_cpu_expert.cpp), not one per
+// impl instance: 40 layers x 15 threads would be 600 threads, and layers
+// execute strictly one at a time on a single decode stream.
+class CpuTierPool {
+public:
+    using Task = std::function<void()>;
+
+    // threads == 0 => max(1, hardware_concurrency() - 1), leaving one core
+    // for the dispatch thread.
+    explicit CpuTierPool(size_t threads = 0);
+    ~CpuTierPool();
+
+    CpuTierPool(const CpuTierPool&) = delete;
+    CpuTierPool& operator=(const CpuTierPool&) = delete;
+
+    // Returns immediately; tasks run on the pool's worker threads.
+    void dispatch(std::vector<Task> tasks);
+    // Blocks until every task dispatched since the last wait() has completed.
+    void wait();
+
+    size_t thread_count() const {
+        return _threads.size();
+    }
+
+private:
+    void worker_loop();
+
+    std::vector<std::thread> _threads;
+    std::mutex _m;
+    std::condition_variable _cv_work;
+    std::condition_variable _cv_done;
+    // FIFO. Tasks are popped from the front and never erased by dispatch(),
+    // so a second dispatcher arriving while the first batch is still queued
+    // cannot drop the first batch's tasks (found in review: the earlier
+    // vector+cursor form reset the cursor and erased on every dispatch,
+    // which with two concurrent dispatchers left _outstanding counting
+    // tasks that no longer existed - a permanent hang in wait()). wait()
+    // is process-wide: it returns when every dispatched task has finished,
+    // which over-waits for a concurrent second dispatcher and is safe.
+    std::deque<Task> _queue;
+    size_t _outstanding = 0;
+    bool _stop = false;
+};
+
+}  // namespace ov::intel_gpu::ocl::moe
