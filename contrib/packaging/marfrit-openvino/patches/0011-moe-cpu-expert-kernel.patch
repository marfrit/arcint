+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_cpu_expert_avx2.cpp
@@ -0,0 +1,324 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+// arcint M14 (patches/0011). The MoE host compute tier's AVX2+FMA3+F16C
+// kernel. This is the ONLY translation unit in the plugin that may use these
+// intrinsics (CMakeLists.txt scopes -mavx2 -mfma -mf16c and a per-source -O3
+// to this file alone); it is selected at runtime by ov::with_cpu_x86_avx2()
+// (moe_cpu_expert.cpp's dispatcher). The whole body is behind
+// OV_MOE_CPU_TIER_HAVE_AVX2, which CMake defines only under ENABLE_AVX2, so
+// a build without it compiles this file to nothing whichever way the target
+// collects its sources; moe_cpu_expert_ref serves there.
+//
+// Shape of the inner loop (per output column, per 64-element group chunk):
+// one 32-byte load of packed u4 weights, split into low/high nibbles, spread
+// bytes to dwords with one in-lane shuffle per 8 outputs (spread_u8_to_i32x8),
+// convert to f32 and FMA against activations that were de-interleaved once
+// per stage into even/odd halves and permuted to the shuffle's element order
+// (permute_block32). Four accumulators per column keep the FMA chains
+// independent; the horizontal sum is deferred to the end of the column, and
+// the zero-point term is folded in via the group-sum identity
+// sum_k s*x_k*(w_k - z) = s*sum_k x_k*w_k - s*z*sum_k x_k. One column per
+// pass: with four accumulators a second column's state spills the sixteen
+// ymm registers (measured on the assembly: 67 stack spills at two columns,
+// none at one), and the activations are L1-resident, so sharing their loads
+// across columns buys nothing. Measured from RAM on the served 35B shape
+// (256 rotating experts, single thread): 198 us/expert, against 520 for the
+// first version of this file, which widened bytes by lane extraction and
+// re-read x per column with one accumulator.
+//
+// Credit ik_llama.cpp / iqk (github.com/ikawrakow) for the nibble-unpack and
+// group-scale handling idea this kernel's inner loop follows -- credited per
+// this repository's convention; no code copied.
+
+#include "moe_cpu_expert.hpp"
+
+#if defined(OV_MOE_CPU_TIER_HAVE_AVX2)
+
+#include <immintrin.h>
+
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace ov::intel_gpu::ocl::moe {
+
+namespace {
+
+inline float f16_to_f32(uint16_t h) {
+    return _cvtsh_ss(h);
+}
+
+inline uint16_t f32_to_f16(float f) {
+    return _cvtss_sh(f, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
+}
+
+// A&S 7.1.26 fast erf, transcribed verbatim from
+// moe_3gemm_swiglu_mlp.cl:48-59 (GATE_ACT_GELU_ERF). Do not substitute std::erf.
+inline float moe_mlp_fast_erf(float x) {
+    const float p = 0.3275911f;
+    const float a1 = 0.254829592f;
+    const float a2 = -0.284496736f;
+    const float a3 = 1.421413741f;
+    const float a4 = -1.453152027f;
+    const float a5 = 1.061405429f;
+    float z = std::fabs(x);
+    float t = 1.0f / (1.0f + p * z);
+    float y = 1.0f - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * std::exp(-(z * z));
+    return (x >= 0.0f) ? y : -y;
+}
+
+inline float apply_act(float x, GateAct act) {
+    switch (act) {
+    case GateAct::GeluErf:
+        return 0.5f * x * (1.0f + moe_mlp_fast_erf(x * 0.7071067811865475f));
+    case GateAct::GeluTanh:
+        return 0.5f * x * (1.0f + std::tanh(0.79788458347320556640625f * x * (1.0f + 0.044715f * x * x)));
+    case GateAct::Silu:
+    default:
+        return x / (1.0f + std::exp(-x));
+    }
+}
+
+inline float dequant_weight_scalar(const uint8_t* row, int k, int weight_bits, bool weight_signed) {
+    int q;
+    if (weight_bits == 4) {
+        const uint8_t byte = row[k >> 1];
+        const uint8_t nib = (k & 1) ? static_cast<uint8_t>(byte >> 4) : static_cast<uint8_t>(byte & 0x0F);
+        q = weight_signed ? (static_cast<int>(nib ^ 0x8) - 8) : static_cast<int>(nib);
+    } else {
+        const uint8_t byte = row[k];
+        q = weight_signed ? static_cast<int>(static_cast<int8_t>(byte)) : static_cast<int>(byte);
+    }
+    return static_cast<float>(q);
+}
+
+inline int zp_at(const QuantMatrix& m, int n, int g, int group_count) {
+    if (!m.has_zp || m.z == nullptr) {
+        return 0;
+    }
+    const size_t idx = static_cast<size_t>(n) * static_cast<size_t>(group_count) + static_cast<size_t>(g);
+    if (m.zp_is_u8) {
+        return static_cast<int>(m.z[idx]);
+    }
+    const uint8_t byte = m.z[idx >> 1];
+    return (idx & 1) ? static_cast<int>(byte >> 4) : static_cast<int>(byte & 0x0F);
+}
+
+inline float scale_at(const QuantMatrix& m, int n, int g, int group_count) {
+    const size_t idx = static_cast<size_t>(n) * static_cast<size_t>(group_count) + static_cast<size_t>(g);
+    return f16_to_f32(m.s[idx]);
+}
+
+// Horizontal sum of an __m256 (8 f32 lanes) -> scalar.
+inline float hsum256_ps(__m256 v) {
+    __m128 lo = _mm256_castps256_ps128(v);
+    __m128 hi = _mm256_extractf128_ps(v, 1);
+    lo = _mm_add_ps(lo, hi);
+    __m128 shuf = _mm_movehdup_ps(lo);
+    __m128 sums = _mm_add_ps(lo, shuf);
+    shuf = _mm_movehl_ps(shuf, sums);
+    sums = _mm_add_ss(sums, shuf);
+    return _mm_cvtss_f32(sums);
+}
+
+// Byte-to-dword spread with one in-lane shuffle per 8 outputs (vpshufb), in
+// place of an extract/shift/pmovzx sequence (7 shuffle-port ops per 32
+// bytes; this is 4). The price is a fixed permutation of the
+// element order: sub-block j, dword i of the result holds byte
+// (i/4)*16 + j*4 + (i%4) of the 32-byte block. A dot product does not care
+// about order as long as the activation side is permuted identically, which
+// permute_block32() below does once per stage.
+inline __m256i spread_u8_to_i32x8(__m256i v, int sub) {
+    const __m256i m = _mm256_set_epi8(-1, -1, -1, static_cast<char>(sub * 4 + 3), -1, -1, -1, static_cast<char>(sub * 4 + 2),
+                                      -1, -1, -1, static_cast<char>(sub * 4 + 1), -1, -1, -1, static_cast<char>(sub * 4 + 0),
+                                      -1, -1, -1, static_cast<char>(sub * 4 + 3), -1, -1, -1, static_cast<char>(sub * 4 + 2),
+                                      -1, -1, -1, static_cast<char>(sub * 4 + 1), -1, -1, -1, static_cast<char>(sub * 4 + 0));
+    return _mm256_shuffle_epi8(v, m);
+}
+
+// The activation-side permutation matching spread_u8_to_i32x8: for every
+// 32-element block, out[j*8 + i] = in[(i/4)*16 + j*4 + (i%4)]. Only whole
+// blocks are permuted; a partial trailing block is copied through unchanged
+// (the vector loop never reads it - it stops at the last full 64-element
+// chunk, i.e. the last full 32-entry block of xe/xo).
+inline void permute_block32(const float* in, float* out, size_t count) {
+    size_t b = 0;
+    for (; b + 32 <= count; b += 32) {
+        for (int j = 0; j < 4; j++)
+            for (int i = 0; i < 8; i++)
+                out[b + j * 8 + i] = in[b + (i / 4) * 16 + j * 4 + (i % 4)];
+    }
+    for (; b < count; b++)
+        out[b] = in[b];
+}
+
+// arcint M14, orchestrator rewrite after the first on-card window (§7.0.2x).
+// The implementer's NCOL=1 loop measured 646 us per 35B expert in isolation
+// (~10x the RAM-bound envelope), for three reasons this version removes:
+//  1. it built the even/odd activation vectors with sixteen scalar gathers
+//     (_mm256_set_ps) per 64-element chunk - x is now de-interleaved once per
+//     stage (xe[p] = x[2p], xo[p] = x[2p+1]) and read with plain loads;
+//  2. one accumulator per column made the eight FMAs of a chunk a single
+//     dependency chain (8 x 4 cycles of latency per 64 MACs) - there are now
+//     four accumulators per column, one per 16-element sub-block;
+//  3. it did a horizontal sum per (column, group) - the group scale is now
+//     applied in vector form (acc_vec += s_g * group_vec) and the zero-point
+//     term is folded into one scalar correction, so each column pays one
+//     horizontal sum at the end.
+// NCOL columns share the activation loads. Numerics: still f32 FMA over the
+// same dequantised values; only the association of the sum changes, which is
+// within T1's stated bounds (the reference is a scalar f32 loop either way).
+template <int NCOL>
+inline void compute_columns_avx2(const QuantMatrix& mat,
+                                 const float* xe,
+                                 const float* xo,
+                                 const float* x,
+                                 const float* sx,
+                                 int n,
+                                 int group_count,
+                                 float* out) {
+    const size_t row_bytes = static_cast<size_t>(mat.ic) / (mat.weight_bits == 4 ? 2u : 1u);
+    const uint8_t* rows[NCOL];
+    for (int c = 0; c < NCOL; c++)
+        rows[c] = mat.w + static_cast<size_t>(n + c) * row_bytes;
+    const bool is4 = (mat.weight_bits == 4);
+    const bool wsigned = mat.weight_signed;
+    const __m256i nib_mask = _mm256_set1_epi8(0x0F);
+    const __m256i sign_xor = _mm256_set1_epi32(8);
+    const __m256i sign_sub = _mm256_set1_epi32(8);
+
+    __m256 acc_vec[NCOL];
+    float corr[NCOL];
+    for (int c = 0; c < NCOL; c++) {
+        acc_vec[c] = _mm256_setzero_ps();
+        corr[c] = 0.0f;
+    }
+
+    for (int g = 0; g < group_count; g++) {
+        const int k0 = g * mat.group_size;
+        const int gs = mat.group_size;
+        __m256 a[NCOL][4];
+        for (int c = 0; c < NCOL; c++)
+            for (int sub = 0; sub < 4; sub++)
+                a[c][sub] = _mm256_setzero_ps();
+        int k = k0;
+
+        if (is4) {
+            const int aligned_end = k0 + (gs / 64) * 64;  // 64 elements = 32 bytes
+            for (; k < aligned_end; k += 64) {
+                const size_t byte_off = static_cast<size_t>(k) / 2;
+                const int p0 = k / 2;
+                for (int c = 0; c < NCOL; c++) {
+                    __m256i v = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(rows[c] + byte_off));
+                    __m256i lo = _mm256_and_si256(v, nib_mask);
+                    __m256i hi = _mm256_and_si256(_mm256_srli_epi16(v, 4), nib_mask);
+                    for (int sub = 0; sub < 4; sub++) {
+                        __m256i qlo_i = spread_u8_to_i32x8(lo, sub);
+                        __m256i qhi_i = spread_u8_to_i32x8(hi, sub);
+                        if (wsigned) {
+                            qlo_i = _mm256_sub_epi32(_mm256_xor_si256(qlo_i, sign_xor), sign_sub);
+                            qhi_i = _mm256_sub_epi32(_mm256_xor_si256(qhi_i, sign_xor), sign_sub);
+                        }
+                        // xe/xo are block-permuted to match spread_u8_to_i32x8, so
+                        // lane i of sub-block `sub` pairs with xe/xo[p0 + sub*8 + i]:
+                        // low nibble -> even element, high nibble -> odd element.
+                        const __m256 xev = _mm256_loadu_ps(xe + p0 + sub * 8);
+                        const __m256 xov = _mm256_loadu_ps(xo + p0 + sub * 8);
+                        a[c][sub] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(qlo_i), xev, a[c][sub]);
+                        a[c][sub] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(qhi_i), xov, a[c][sub]);
+                    }
+                }
+            }
+        }
+
+        for (int c = 0; c < NCOL; c++) {
+            __m256 gvec = _mm256_add_ps(_mm256_add_ps(a[c][0], a[c][1]), _mm256_add_ps(a[c][2], a[c][3]));
+            const float s = scale_at(mat, n + c, g, group_count);
+            const float z = static_cast<float>(zp_at(mat, n + c, g, group_count));
+            if (k < k0 + gs) {
+                // Scalar tail (gs not a multiple of 64, or 8-bit weights): fold
+                // it into lane 0 so the group is still scaled once below.
+                float tail = 0.0f;
+                for (int kk = k; kk < k0 + gs; kk++)
+                    tail += x[kk] * dequant_weight_scalar(rows[c], kk, mat.weight_bits, wsigned);
+                gvec = _mm256_add_ps(gvec, _mm256_set_ps(0, 0, 0, 0, 0, 0, 0, tail));
+            }
+            acc_vec[c] = _mm256_fmadd_ps(_mm256_set1_ps(s), gvec, acc_vec[c]);
+            corr[c] += s * sx[g] * z;
+        }
+    }
+    for (int c = 0; c < NCOL; c++)
+        out[c] = hsum256_ps(acc_vec[c]) - corr[c];
+}
+
+
+void compute_stage_avx2(const QuantMatrix& mat, const float* x, int n_begin, int n_end, float* acc_out) {
+    const int group_count = mat.ic / mat.group_size;
+    std::vector<float> sx(static_cast<size_t>(group_count), 0.0f);
+    for (int g = 0; g < group_count; g++) {
+        float s = 0.0f;
+        for (int k = g * mat.group_size; k < (g + 1) * mat.group_size; k++) {
+            s += x[k];
+        }
+        sx[static_cast<size_t>(g)] = s;
+    }
+    // De-interleaved activation halves (see compute_columns_avx2). Sized to
+    // the even count so an odd ic (scalar tail only) never reads past x.
+    const size_t half = static_cast<size_t>(mat.ic) / 2;
+    std::vector<float> xe_lin(half), xo_lin(half), xe(half), xo(half);
+    for (size_t p = 0; p < half; p++) {
+        xe_lin[p] = x[2 * p];
+        xo_lin[p] = x[2 * p + 1];
+    }
+    permute_block32(xe_lin.data(), xe.data(), half);
+    permute_block32(xo_lin.data(), xo.data(), half);
+    // NCOL=1: with four accumulators per column, a second column's state
+    // no longer fits the 16 ymm registers (measured: NCOL=2 spilled and was
+    // no faster than NCOL=1); the shared-load saving is worth nothing
+    // against L1-resident activations.
+    for (int n = n_begin; n < n_end; n++)
+        compute_columns_avx2<1>(mat, xe.data(), xo.data(), x, sx.data(), n, group_count, acc_out + (n - n_begin));
+}
+
+}  // namespace
+
+void moe_cpu_expert_avx2(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end) {
+    const int hidden = e.down.oc;
+    const int inter = e.up.oc;
+    std::vector<float> x_f32(static_cast<size_t>(hidden));
+    std::vector<float> up_acc(static_cast<size_t>(inter));
+    std::vector<float> gate_acc(static_cast<size_t>(inter));
+    std::vector<float> h_f32(static_cast<size_t>(inter));
+    std::vector<float> down_acc(static_cast<size_t>(col_end - col_begin));
+
+    for (size_t j = 0; j < n_jobs; j++) {
+        const ExpertJob& job = jobs[j];
+        for (int k = 0; k < hidden; k++) {
+            x_f32[static_cast<size_t>(k)] = f16_to_f32(job.x[k]);
+        }
+
+        compute_stage_avx2(e.up, x_f32.data(), 0, inter, up_acc.data());
+        compute_stage_avx2(e.gate, x_f32.data(), 0, inter, gate_acc.data());
+
+        for (int j2 = 0; j2 < inter; j2++) {
+            const float up_h = f16_to_f32(f32_to_f16(up_acc[static_cast<size_t>(j2)]));
+            const float act = apply_act(gate_acc[static_cast<size_t>(j2)], e.act);
+            const uint16_t h_bits = f32_to_f16(up_h * act);
+            h_f32[static_cast<size_t>(j2)] = f16_to_f32(h_bits);
+        }
+
+        compute_stage_avx2(e.down, h_f32.data(), col_begin, col_end, down_acc.data());
+
+        const float w_route = f16_to_f32(job.w_route);
+        for (int n = col_begin; n < col_end; n++) {
+            const float y_val = down_acc[static_cast<size_t>(n - col_begin)] * w_route;
+            job.y[n] = f32_to_f16(y_val);
+        }
+    }
+}
+
+}  // namespace ov::intel_gpu::ocl::moe
+
+#endif  // OV_MOE_CPU_TIER_HAVE_AVX2
