+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_cpu_expert.cpp
@@ -0,0 +1,428 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+// arcint M14 (patches/0011). Scalar reference kernel, the GPU-emulating
+// reference used by T1c, the runtime dispatcher and the CPU thread pool. See
+// moe_cpu_expert.hpp and this patch's header for the layout/rounding
+// contract. No intrinsics in this translation unit -- the AVX2 kernel lives
+// in moe_cpu_expert_avx2.cpp, compiled with different flags (CMakeLists.txt).
+
+#include "moe_cpu_expert.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+#if defined(OV_MOE_CPU_TIER_HAVE_AVX2)
+#include "openvino/runtime/system_conf.hpp"
+#endif
+
+namespace ov::intel_gpu::ocl::moe {
+
+namespace {
+
+// ---- f16 <-> f32, portable bit manipulation, round-to-nearest-even on store.
+// Independent of the AVX2 kernel's F16C-based conversion by construction --
+// that independence is what makes T1b's ref-vs-avx2 comparison meaningful
+// rather than the two kernels agreeing because they share one conversion.
+
+inline float f16_to_f32(uint16_t h) {
+    uint32_t sign = static_cast<uint32_t>(h & 0x8000u) << 16;
+    uint32_t exp = (h >> 10) & 0x1Fu;
+    uint32_t mant = h & 0x3FFu;
+    uint32_t bits;
+    if (exp == 0) {
+        if (mant == 0) {
+            bits = sign;
+        } else {
+            // Subnormal half -> normalize into a normal float.
+            uint32_t e = 1;
+            while (!(mant & 0x400u)) {
+                mant <<= 1;
+                e--;
+            }
+            mant &= 0x3FFu;
+            bits = sign | ((e + (127 - 15)) << 23) | (mant << 13);
+        }
+    } else if (exp == 0x1Fu) {
+        bits = sign | 0x7F800000u | (mant << 13);
+    } else {
+        bits = sign | ((exp + (127 - 15)) << 23) | (mant << 13);
+    }
+    float f;
+    std::memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+inline uint16_t f32_to_f16(float f) {
+    uint32_t bits;
+    std::memcpy(&bits, &f, sizeof(bits));
+    const uint32_t sign = (bits >> 16) & 0x8000u;
+    const uint32_t abs_bits = bits & 0x7FFFFFFFu;
+    const int32_t f_exp = static_cast<int32_t>((abs_bits >> 23) & 0xFFu);
+    uint32_t mant = abs_bits & 0x7FFFFFu;
+
+    if (f_exp == 0xFF) {
+        // Inf / NaN
+        return static_cast<uint16_t>(sign | 0x7C00u | (mant ? 0x200u : 0u));
+    }
+
+    int32_t h_exp = f_exp - 127 + 15;
+    if (h_exp >= 0x1F) {
+        return static_cast<uint16_t>(sign | 0x7C00u);  // overflow -> inf
+    }
+    if (h_exp <= 0) {
+        if (h_exp < -10) {
+            return static_cast<uint16_t>(sign);  // too small -> zero
+        }
+        mant |= 0x800000u;
+        const uint32_t shift = static_cast<uint32_t>(14 - h_exp);
+        uint32_t rounded = mant >> shift;
+        const uint32_t rem = mant & ((1u << shift) - 1u);
+        const uint32_t halfbit = 1u << (shift - 1);
+        if (rem > halfbit || (rem == halfbit && (rounded & 1u))) {
+            rounded++;
+        }
+        return static_cast<uint16_t>(sign | rounded);
+    }
+
+    uint32_t rounded_mant = mant + 0xFFFu + ((mant >> 13) & 1u);
+    if (rounded_mant & 0x800000u) {
+        rounded_mant = 0;
+        h_exp++;
+        if (h_exp >= 0x1F) {
+            return static_cast<uint16_t>(sign | 0x7C00u);
+        }
+    }
+    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(h_exp) << 10) | (rounded_mant >> 13));
+}
+
+// A&S 7.1.26 fast erf, transcribed verbatim from
+// moe_3gemm_swiglu_mlp.cl:48-59 (GATE_ACT_GELU_ERF). Do not substitute std::erf.
+inline float moe_mlp_fast_erf(float x) {
+    const float p = 0.3275911f;
+    const float a1 = 0.254829592f;
+    const float a2 = -0.284496736f;
+    const float a3 = 1.421413741f;
+    const float a4 = -1.453152027f;
+    const float a5 = 1.061405429f;
+    float z = std::fabs(x);
+    float t = 1.0f / (1.0f + p * z);
+    float y = 1.0f - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * std::exp(-(z * z));
+    return (x >= 0.0f) ? y : -y;
+}
+
+inline float apply_act(float x, GateAct act) {
+    switch (act) {
+    case GateAct::GeluErf:
+        return 0.5f * x * (1.0f + moe_mlp_fast_erf(x * 0.7071067811865475f));
+    case GateAct::GeluTanh:
+        return 0.5f * x * (1.0f + std::tanh(0.79788458347320556640625f * x * (1.0f + 0.044715f * x * x)));
+    case GateAct::Silu:
+    default:
+        return x / (1.0f + std::exp(-x));
+    }
+}
+
+// Dequantised weight element k (0 <= k < ic) of row `row`, per the file
+// layout derivation in this patch's header (mlp.cl:547/126 substitution):
+// byte j holds element 2j in the low nibble, element 2j+1 in the high
+// nibble; sign-extended iff weight_signed (i4).
+inline float dequant_weight(const uint8_t* row, int k, int weight_bits, bool weight_signed) {
+    int q;
+    if (weight_bits == 4) {
+        const uint8_t byte = row[k >> 1];
+        const uint8_t nib = (k & 1) ? static_cast<uint8_t>(byte >> 4) : static_cast<uint8_t>(byte & 0x0F);
+        q = weight_signed ? (static_cast<int>(nib ^ 0x8) - 8) : static_cast<int>(nib);
+    } else {
+        const uint8_t byte = row[k];
+        q = weight_signed ? static_cast<int>(static_cast<int8_t>(byte)) : static_cast<int>(byte);
+    }
+    return static_cast<float>(q);
+}
+
+// zero point at (output column n, group g), per the file-layout derivation
+// (moe_otd_runtime.cpp:152-171): linear index n*group_count+g, u4 packed two
+// per byte (even index low nibble) or one u8 per element. Never sign-extended.
+inline int zp_at(const QuantMatrix& m, int n, int g, int group_count) {
+    if (!m.has_zp || m.z == nullptr) {
+        return 0;
+    }
+    const size_t idx = static_cast<size_t>(n) * static_cast<size_t>(group_count) + static_cast<size_t>(g);
+    if (m.zp_is_u8) {
+        return static_cast<int>(m.z[idx]);
+    }
+    const uint8_t byte = m.z[idx >> 1];
+    return (idx & 1) ? static_cast<int>(byte >> 4) : static_cast<int>(byte & 0x0F);
+}
+
+inline float scale_at(const QuantMatrix& m, int n, int g, int group_count) {
+    const size_t idx = static_cast<size_t>(n) * static_cast<size_t>(group_count) + static_cast<size_t>(g);
+    return f16_to_f32(m.s[idx]);
+}
+
+// acc[n] for n in [n_begin, n_end) = sum_g s[n,g]*(dot(x, q(n, group g)) - Sx[g]*z[n,g]).
+// Plain scalar, f32 accumulation throughout, no intrinsics, no xe/xo split --
+// it indexes x[k] directly and derives the nibble from k&1, so it exercises
+// the packing rule independently of the AVX2 kernel's interpretation of it
+// (that independence is what makes T1's nibble-flip red case meaningful).
+void compute_stage_f32(const QuantMatrix& mat, const float* x, int n_begin, int n_end, float* acc_out) {
+    const int group_count = mat.ic / mat.group_size;
+    std::vector<float> sx(static_cast<size_t>(group_count), 0.0f);
+    for (int g = 0; g < group_count; g++) {
+        const int k0 = g * mat.group_size;
+        const int k1 = k0 + mat.group_size;
+        float s = 0.0f;
+        for (int k = k0; k < k1; k++) {
+            s += x[k];
+        }
+        sx[static_cast<size_t>(g)] = s;
+    }
+
+    const size_t row_bytes = static_cast<size_t>(mat.ic) / (mat.weight_bits == 4 ? 2u : 1u);
+    for (int n = n_begin; n < n_end; n++) {
+        const uint8_t* row = mat.w + static_cast<size_t>(n) * row_bytes;
+        float acc = 0.0f;
+        for (int g = 0; g < group_count; g++) {
+            const float s = scale_at(mat, n, g, group_count);
+            const float z = static_cast<float>(zp_at(mat, n, g, group_count));
+            const int k0 = g * mat.group_size;
+            const int k1 = k0 + mat.group_size;
+            float dot = 0.0f;
+            for (int k = k0; k < k1; k++) {
+                dot += x[k] * dequant_weight(row, k, mat.weight_bits, mat.weight_signed);
+            }
+            acc += s * (dot - sx[static_cast<size_t>(g)] * z);
+        }
+        acc_out[n - n_begin] = acc;
+    }
+}
+
+}  // namespace
+
+void moe_cpu_expert_ref(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end) {
+    const int hidden = e.down.oc;
+    const int inter = e.up.oc;
+    std::vector<float> x_f32(static_cast<size_t>(hidden));
+    std::vector<float> up_acc(static_cast<size_t>(inter));
+    std::vector<float> gate_acc(static_cast<size_t>(inter));
+    std::vector<float> h_f32(static_cast<size_t>(inter));
+    std::vector<float> down_acc(static_cast<size_t>(col_end - col_begin));
+
+    for (size_t j = 0; j < n_jobs; j++) {
+        const ExpertJob& job = jobs[j];
+        for (int k = 0; k < hidden; k++) {
+            x_f32[static_cast<size_t>(k)] = f16_to_f32(job.x[k]);
+        }
+
+        compute_stage_f32(e.up, x_f32.data(), 0, inter, up_acc.data());
+        compute_stage_f32(e.gate, x_f32.data(), 0, inter, gate_acc.data());
+
+        // Rounding, matched stage by stage (§5.4):
+        //   up_h[j] = f16(acc_up[j])
+        //   h[j]    = f16(up_h[j] * act_f32(acc_gate[j]))
+        for (int j2 = 0; j2 < inter; j2++) {
+            const float up_h = f16_to_f32(f32_to_f16(up_acc[static_cast<size_t>(j2)]));
+            const float act = apply_act(gate_acc[static_cast<size_t>(j2)], e.act);
+            const uint16_t h_bits = f32_to_f16(up_h * act);
+            h_f32[static_cast<size_t>(j2)] = f16_to_f32(h_bits);
+        }
+
+        compute_stage_f32(e.down, h_f32.data(), col_begin, col_end, down_acc.data());
+
+        const float w_route = f16_to_f32(job.w_route);
+        for (int n = col_begin; n < col_end; n++) {
+            const float y_val = down_acc[static_cast<size_t>(n - col_begin)] * w_route;
+            job.y[n] = f32_to_f16(y_val);
+        }
+    }
+}
+
+// arcint M14 (T1c, §8). Reproduces the GPU's within-fake-group half
+// accumulation (moe_3gemm_swiglu_mlp.cl:124-146): every branch (ELEMS_PER_LANE
+// 2/4/8) is, per lane, a chain of exactly 2 sequential half-precision FMAs
+// (one nibble pair of one weight byte), and elems_per_lane/2 such chains are
+// summed in float per lane before the float-domain scale/zp/reduce. This
+// function emulates that chain structure directly rather than the SIMD lane
+// layout (the lane->k mapping is a scheduling detail with no numerical
+// effect on a *sum*, only its rounding path) -- it predicts the on-card
+// divergence, not the exact bit pattern.
+void moe_cpu_expert_ref_gpu_emul(const ExpertDesc& e,
+                                 const ExpertJob* jobs,
+                                 size_t n_jobs,
+                                 int col_begin,
+                                 int col_end,
+                                 int subgroup_size,
+                                 int elems_per_lane) {
+    const int fake_group = subgroup_size * elems_per_lane;
+
+    auto stage_emul = [&](const QuantMatrix& mat, const float* x, int n_begin, int n_end, float* acc_out) {
+        const int group_count = mat.ic / mat.group_size;
+        std::vector<float> sx(static_cast<size_t>(group_count), 0.0f);
+        for (int g = 0; g < group_count; g++) {
+            float s = 0.0f;
+            for (int k = g * mat.group_size; k < (g + 1) * mat.group_size; k++) {
+                s += x[k];
+            }
+            sx[static_cast<size_t>(g)] = s;
+        }
+        const size_t row_bytes = static_cast<size_t>(mat.ic) / (mat.weight_bits == 4 ? 2u : 1u);
+        const int chains_per_lane = std::max(1, elems_per_lane / 2);
+
+        for (int n = n_begin; n < n_end; n++) {
+            const uint8_t* row = mat.w + static_cast<size_t>(n) * row_bytes;
+            float acc = 0.0f;
+            for (int gk = 0; gk * fake_group < mat.ic; gk++) {
+                const int group_base = gk * fake_group;
+                // GPU groups (real quant groups, size mat.group_size) and fake
+                // groups coincide on the served config (both 64); when they do
+                // not, s/z are taken at the real-group the fake group's start
+                // falls in, matching the kernel's scale_offset/zp_offset stride.
+                const int real_g = group_base / mat.group_size;
+                const float s = scale_at(mat, n, real_g, group_count);
+                const float z = static_cast<float>(zp_at(mat, n, real_g, group_count));
+
+                float lane_sum_f32 = 0.0f;
+                for (int lane = 0; lane < subgroup_size; lane++) {
+                    for (int c = 0; c < chains_per_lane; c++) {
+                        const int k = group_base + lane * chains_per_lane * 2 + c * 2;
+                        if (k + 1 >= group_base + fake_group)
+                            break;
+                        const float xe = x[k];
+                        const float xo = x[k + 1];
+                        const float qlo = dequant_weight(row, k, mat.weight_bits, mat.weight_signed);
+                        const float qhi = dequant_weight(row, k + 1, mat.weight_bits, mat.weight_signed);
+                        // Two sequential half-precision FMAs, matching the
+                        // kernel's sum0 = fma(a,LO,0); sum0 = fma(a,HI,sum0).
+                        uint16_t acc_h = f32_to_f16(xe * qlo);
+                        acc_h = f32_to_f16(f16_to_f32(acc_h) + xo * qhi);
+                        lane_sum_f32 += f16_to_f32(acc_h);
+                    }
+                }
+                acc += s * (lane_sum_f32 - sx[static_cast<size_t>(real_g)] * z);
+            }
+            acc_out[n - n_begin] = acc;
+        }
+    };
+
+    const int hidden = e.down.oc;
+    const int inter = e.up.oc;
+    std::vector<float> x_f32(static_cast<size_t>(hidden));
+    std::vector<float> up_acc(static_cast<size_t>(inter));
+    std::vector<float> gate_acc(static_cast<size_t>(inter));
+    std::vector<float> h_f32(static_cast<size_t>(inter));
+    std::vector<float> down_acc(static_cast<size_t>(col_end - col_begin));
+
+    for (size_t j = 0; j < n_jobs; j++) {
+        const ExpertJob& job = jobs[j];
+        for (int k = 0; k < hidden; k++) {
+            x_f32[static_cast<size_t>(k)] = f16_to_f32(job.x[k]);
+        }
+
+        stage_emul(e.up, x_f32.data(), 0, inter, up_acc.data());
+        stage_emul(e.gate, x_f32.data(), 0, inter, gate_acc.data());
+
+        for (int j2 = 0; j2 < inter; j2++) {
+            const float up_h = f16_to_f32(f32_to_f16(up_acc[static_cast<size_t>(j2)]));
+            const float act = apply_act(gate_acc[static_cast<size_t>(j2)], e.act);
+            const uint16_t h_bits = f32_to_f16(up_h * act);
+            h_f32[static_cast<size_t>(j2)] = f16_to_f32(h_bits);
+        }
+
+        stage_emul(e.down, h_f32.data(), col_begin, col_end, down_acc.data());
+
+        const float w_route = f16_to_f32(job.w_route);
+        for (int n = col_begin; n < col_end; n++) {
+            const float y_val = down_acc[static_cast<size_t>(n - col_begin)] * w_route;
+            job.y[n] = f32_to_f16(y_val);
+        }
+    }
+}
+
+void moe_cpu_expert(const ExpertDesc& e, const ExpertJob* jobs, size_t n_jobs, int col_begin, int col_end) {
+#if defined(OV_MOE_CPU_TIER_HAVE_AVX2)
+    static const bool have_avx2 = ov::with_cpu_x86_avx2();
+    // The AVX2 kernel's activation permutation works on 32-pair blocks aligned
+    // to the group start (moe_cpu_expert_avx2.cpp, permute_block32), which
+    // holds when every group is a whole number of 64-element chunks or is
+    // smaller than one chunk (then the group is all scalar tail). A group of,
+    // say, 96 would start mid-block and pair lanes with the wrong elements
+    // (found in review); such shapes take the scalar reference instead.
+    auto avx2_ok = [](const QuantMatrix& m) {
+        return m.group_size < 64 || m.group_size % 64 == 0;
+    };
+    if (have_avx2 && avx2_ok(e.gate) && avx2_ok(e.up) && avx2_ok(e.down)) {
+        moe_cpu_expert_avx2(e, jobs, n_jobs, col_begin, col_end);
+        return;
+    }
+#endif
+    moe_cpu_expert_ref(e, jobs, n_jobs, col_begin, col_end);
+}
+
+// ---------------------------------------------------------------------------
+// CpuTierPool -- plain std::thread + condvar, independent of the plugin's
+// stream executor (§5.6). See moe_cpu_expert.hpp for the rationale.
+
+CpuTierPool::CpuTierPool(size_t threads) {
+    size_t n = threads;
+    if (n == 0) {
+        const unsigned hw = std::thread::hardware_concurrency();
+        n = hw > 1 ? static_cast<size_t>(hw - 1) : 1;
+    }
+    _threads.reserve(n);
+    for (size_t i = 0; i < n; i++) {
+        _threads.emplace_back([this] { worker_loop(); });
+    }
+}
+
+CpuTierPool::~CpuTierPool() {
+    {
+        std::lock_guard<std::mutex> lock(_m);
+        _stop = true;
+    }
+    _cv_work.notify_all();
+    for (auto& t : _threads) {
+        if (t.joinable())
+            t.join();
+    }
+}
+
+void CpuTierPool::dispatch(std::vector<Task> tasks) {
+    std::lock_guard<std::mutex> lock(_m);
+    _outstanding += tasks.size();
+    for (auto& t : tasks) {
+        _queue.push_back(std::move(t));
+    }
+    _cv_work.notify_all();
+}
+
+void CpuTierPool::wait() {
+    std::unique_lock<std::mutex> lock(_m);
+    _cv_done.wait(lock, [this] { return _outstanding == 0; });
+}
+
+void CpuTierPool::worker_loop() {
+    for (;;) {
+        Task task;
+        {
+            std::unique_lock<std::mutex> lock(_m);
+            _cv_work.wait(lock, [this] { return _stop || !_queue.empty(); });
+            if (_stop && _queue.empty())
+                return;
+            task = std::move(_queue.front());
+            _queue.pop_front();
+        }
+        if (task)
+            task();
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            _outstanding--;
+            if (_outstanding == 0)
+                _cv_done.notify_all();
+        }
+    }
+}
+
+}  // namespace ov::intel_gpu::ocl::moe
