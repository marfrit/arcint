--- a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/include/batch_headers/kquant_utils.cl
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/include/batch_headers/kquant_utils.cl
@@ -1,18 +1,25 @@
-// arcint (patch 0021): GGUF K-quant super-block decoders (ggml-quants.c's dequantize_row_*,
-// formula for formula). A row of a [N, K] weight is K/256 super-blocks (K/32 for Q8_0) laid
-// end to end, the file's own bytes. Every decoder reads one 32-value sub-block of one
-// super-block from global memory with vector loads into registers, decodes it there, and
-// produces 32 f32 values so the caller fuses the multiply-accumulate without materialising
-// the row.
-//
-// The quantised bytes are handled as 32-bit (Q4_K, Q5_K; 16-byte-aligned blocks) or 16-bit
-// (Q6_K, Q8_0; 210- and 34-byte blocks are only 2-aligned) words and each value is a shift, a
-// mask and a convert out of its word. Byte-wise vectors cost the compiler a move per byte
-// per lane (measured: three times the instructions). Nothing here indexes a private array
-// with a runtime value: the compiled kernel must report no private memory, or every lane's
-// arrays go to scratch and the kernel runs at a fraction of the weight bandwidth (measured).
-// Checked against an independent transcription of the same formulas in the plugin's unit
-// test (kq_host in fully_connected_gpu_test.cpp) and end to end by the served model.
+// arcint (patches 0021/0022): GGUF K-quant super-block decoders and packers (ggml-quants.c's
+// dequantize_row_* formulas). A row of a [N, K] weight is K/256 super-blocks (K/32 for Q8_0)
+// laid end to end, the file's own bytes. Every routine reads one 32-value sub-block of one
+// super-block from global memory with vector loads into registers:
+//   kq_dec_*   produce 32 f32 values (the fused multiply-accumulate path; a shift, a mask
+//              and a convert per value out of 32-bit or 16-bit words of the block --
+//              byte-wise vectors cost the compiler a move per byte per lane, measured 3x);
+//   kq_pack_*  produce this lane's B operand for two f16 subgroup matrix multiplies
+//              (k = 0..15 and 16..31; consecutive k paired in each int, low half first) plus
+//              the two scalars that turn the multiplies' sums into the dot product:
+//                value_k = dl * q_k + c          (ggml: d*sc*q - dmin*mn; d*sc*(q6-32); d*q8)
+//                packed_k = f16(1024 + q'_k)      (q' = q, q6, or q8+128: an unsigned integer
+//                                                 below 1024, whose f16 is 0x6400 | q' -- no convert)
+//                sum x*value = dl * S - mo * X   (S = A x B over the packed values, X = A x 1,
+//                                                 mo = 1024*dl + (min | 32*dl | 128*dl))
+//              so packing a value is a shift, a mask and an or, and the 1024x offset falls
+//              out of the f32 sums (seven bits of the accumulator; measured within 2e-3 of
+//              the f32 reference at K 1,280).
+// Nothing here indexes a private array with a runtime value: the compiled kernel must report
+// no private memory, or every lane's arrays go to scratch (measured, 10x). Checked against an
+// independent transcription of the same formulas in the plugin's unit test (kq_host in
+// fully_connected_gpu_test.cpp) and end to end by the served model.
 #pragma OPENCL EXTENSION cl_khr_fp16 : enable
 
 inline float kq_f16bits(uint h) { return convert_float(as_half((ushort)(h & 0xFFFFu))); }
@@ -98,3 +105,100 @@
         y[l] = (l < 16 ? s0 : s1) * (float)((int)(lo | (hi << 4)) - 32);
     }
 }
+
+// ---- packers for the matrix unit ----
+#define KQ_HALF_BASE 0x64006400u   // two f16 1024.0: 0x6400 | q is f16(1024 + q) for 0 <= q < 1024
+#define KQ_ONES8 ((int8)(0x3C003C00))  // sixteen f16 1.0: the B operand that sums the activations
+
+
+// One int of B from a word v holding the even value's nibble in bits 0-3 and the odd value's
+// in bits 8-11.
+inline int kq_pair4(uint v) { return (int)(KQ_HALF_BASE | (v & 0xFu) | ((v << 8) & 0xF0000u)); }
+
+// Q8_0: 32 values, {f16 d; int8 qs[32]} = 34 bytes; value = d * q8. Packed as 1024 + (q8 + 128):
+// the raw byte xor 0x80. The bytes as 16 little-endian ushorts (2-aligned block).
+inline void kq_pack_q8_0(const __global uchar* b, uint s, int8* b0, int8* b1, float2* dl, float2* mo) {
+    const float d = kq_f16at(b);
+    *dl = (float2)(d); *mo = (float2)((1024.0f + 128.0f) * d);
+    const ushort16 q = vload16(0, (const __global ushort*)(b + 2));
+    int p[16];
+    __attribute__((opencl_unroll_hint(16)))
+    for (int i = 0; i < 16; ++i) {
+        const uint w = q[i];
+        p[i] = (int)(KQ_HALF_BASE | (((w & 0xFFu) | ((w << 8) & 0xFF0000u)) ^ 0x00800080u));
+    }
+    *b0 = (int8)(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    *b1 = (int8)(p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+}
+
+// Q4_K: 256 values, {f16 d; f16 dmin; uchar scales[12]; uchar qs[128]} = 144 bytes; sub-block
+// s = 0..7; value = d*sc * q - dmin*mn. The 16-byte header is one load; the 32 bytes serving
+// sub-blocks 2j / 2j+1 (low / high nibbles) are one more. Values 2i, 2i+1 are bytes 2i, 2i+1:
+// bits 16*(i&1) and +8 of dword i>>1.
+inline void kq_pack_q4_K_sub(const __global uchar* b, uint s, int8* b0, int8* b1, float2* dl, float2* mo) {
+    const uint4 h = vload4(0, (const __global uint*)b);
+    const float d = kq_f16bits(h.s0), dmin = kq_f16bits(h.s0 >> 16);
+    uint sc, mn;
+    kq_scale_min_k4(s, h.s1, h.s2, h.s3, &sc, &mn);
+    const float dls = d * (float)sc, mls = dmin * (float)mn;
+    *dl = (float2)(dls); *mo = (float2)(1024.0f * dls + mls);
+    const uint8 q = vload8(0, (const __global uint*)(b + 16 + (s >> 1) * 32));
+    const uint shift = (s & 1) * 4;  // low nibbles for even s, high for odd
+    int p[16];
+    __attribute__((opencl_unroll_hint(16)))
+    for (int i = 0; i < 16; ++i)
+        p[i] = kq_pair4(q[i >> 1] >> ((i & 1) * 16 + shift));
+    *b0 = (int8)(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    *b1 = (int8)(p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+}
+
+// Q5_K: 256 values, {f16 d; f16 dmin; uchar scales[12]; uchar qh[32]; uchar qs[128]} = 176 bytes;
+// value = d*sc * (q4 | fifth bit << 4) - dmin*mn, the fifth bit being bit s of qh[l].
+inline void kq_pack_q5_K_sub(const __global uchar* b, uint s, int8* b0, int8* b1, float2* dl, float2* mo) {
+    const uint4 h = vload4(0, (const __global uint*)b);
+    const float d = kq_f16bits(h.s0), dmin = kq_f16bits(h.s0 >> 16);
+    uint sc, mn;
+    kq_scale_min_k4(s, h.s1, h.s2, h.s3, &sc, &mn);
+    const float dls = d * (float)sc, mls = dmin * (float)mn;
+    *dl = (float2)(dls); *mo = (float2)(1024.0f * dls + mls);
+    const uint8 qh = vload8(0, (const __global uint*)(b + 16));
+    const uint8 q = vload8(0, (const __global uint*)(b + 48 + (s >> 1) * 32));
+    const uint shift = (s & 1) * 4;
+    int p[16];
+    __attribute__((opencl_unroll_hint(16)))
+    for (int i = 0; i < 16; ++i) {
+        const uint v = q[i >> 1] >> ((i & 1) * 16 + shift);
+        const uint u = qh[i >> 1] >> ((i & 1) * 16 + s);   // bit 0: the even value's fifth bit, bit 8: the odd's
+        p[i] = kq_pair4(v) | (int)(((u & 1u) << 4) | ((u << 12) & 0x100000u));
+    }
+    *b0 = (int8)(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    *b1 = (int8)(p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+}
+
+// Q6_K: 256 values, {uchar ql[128]; uchar qh[64]; int8 scales[16]; f16 d} = 210 bytes; value =
+// d*scale * (q6 - 32), q6 = nibble of ql | two bits of qh << 4. ggml walks two halves of 128
+// values as four interleaved runs of 32; sub-block s = 0..7 here is 32 consecutive values,
+// i.e. run r = s & 3 of half h = s >> 2: run r reads ql[l] or ql[l+32] (low or high nibble)
+// and bits 2r, 2r+1 of qh[l]; 64 bytes of ql, 32 of qh and 8 scales per half, two scales per
+// run (values 0-15 and 16-31). The block is 2-aligned only: 16-bit words. Packed as
+// 1024 + q6, so the -32 joins the offset.
+inline void kq_pack_q6_K_sub(const __global uchar* b, uint s, int8* b0, int8* b1, float2* dl, float2* mo) {
+    const float d = kq_f16at(b + 208);
+    const uint hh = s >> 2, r = s & 3;
+    const ushort16 ql = vload16(0, (const __global ushort*)(b + hh * 64 + (r & 1) * 32));
+    const ushort16 qh = vload16(0, (const __global ushort*)(b + 128 + hh * 32));
+    const __global char* scp = (const __global char*)(b + 192) + hh * 8;
+    const float s0 = d * (float)scp[2 * r], s1 = d * (float)scp[2 * r + 1];
+    *dl = (float2)(s0, s1); *mo = (float2)((1024.0f + 32.0f) * s0, (1024.0f + 32.0f) * s1);
+    const uint shift = 2 * r;
+    const uint nib = (r >> 1) * 4;  // runs 2, 3 read the high nibble
+    int p[16];
+    __attribute__((opencl_unroll_hint(16)))
+    for (int i = 0; i < 16; ++i) {
+        const uint v = (uint)ql[i] >> nib;      // bits 0-3: even value's nibble, bits 8-11: odd's
+        const uint u = (uint)qh[i] >> shift;    // bits 0-1: even value's high bits, bits 8-9: odd's
+        p[i] = kq_pair4(v) | (int)(((u & 3u) << 4) | ((u << 12) & 0x300000u));
+    }
+    *b0 = (int8)(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    *b1 = (int8)(p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+}
