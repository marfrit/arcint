+// here is a LOAD FAILURE (a throw), never a fallback.
+void start_pinned_nvme_fill() {
+    auto& coordinator = pinned_nvme_fill();
+    if (coordinator.started) return;
+    coordinator.started = true;
+
+    if (coordinator.transport == nullptr) {
+        throw std::runtime_error(
