+// Activations l*8 .. l*8+7 of a 32-value block (f16, 64-byte aligned) as f32:
+// one 16-byte load.
+inline float8 native_x8(const __global half* xp, int l) {
+    return convert_float8(as_half8(vload4(l, (const __global uint*)xp)));
+}
+
+// s continued over eight products, in order, each rounded once by its fma.
+inline float native_dot8(float s, float8 x, float8 w) {
+    s = fma(x.s0, w.s0, s);
+    s = fma(x.s1, w.s1, s);
+    s = fma(x.s2, w.s2, s);
+    s = fma(x.s3, w.s3, s);
+    s = fma(x.s4, w.s4, s);
+    s = fma(x.s5, w.s5, s);
+    s = fma(x.s6, w.s6, s);
+    s = fma(x.s7, w.s7, s);
+    return s;
+}
