+// IQ3_XXS values l*8 .. l*8+7 of a block as signed f32 weights (without the
+// block scale): gq = the block's eight grid indices (bytes 2l, 2l+1 for
+// sub-block l), sg = its four sign indices (byte l for sub-block l, bit 7
+// ignored as in the per-element decoder). The sign byte is the 7-bit index
+// with its parity in bit 7 (NATIVE_IQ2XS_SIGNS[s7], computed); a sign sets the
+// magnitude's sign bit. The magnitudes are small integers, exact in f32, so a
+// product x * w is x * sign * magnitude exactly.
+inline float8 native_iq3xxs_w8(uint2 gq, uint sg, int l) {
+    const uint g2 = (l < 2 ? gq.x : gq.y) >> ((l & 1) * 16);
