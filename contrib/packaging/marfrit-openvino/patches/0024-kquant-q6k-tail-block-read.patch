# The K-quant kernel's Q6_K decode row: the block's tail as one block read and broadcasts

# Applied against the pinned runtime, build 2026.4.0-22849-71640275d29, on top of
# patches/0003-0023. arcint 0.4.1 (DESIGN.md section 7.0.2bh).
#
# What changes:
#   kquant_utils.cl     kq_row_q6k_x: the super-block's last twenty bytes -- qh's last word, the
#                       sixteen scales, d -- were four per-lane gathers (the scales as a vector
#                       load, the tail word, the two bytes of d), six load messages per
#                       super-block per row. Now one 16-bit sub-group block read of the 32 bytes
#                       at the dword at or below those twenty (b4 + 192 is a dword; a 2-aligned
#                       16-bit block read returns the neighbour's word, DESIGN 7.0.2bc): lane l
#                       holds word l and every value is one broadcast, three messages per block.
#                       The read runs 12-14 bytes past the block; the last block of the last row
#                       (uniform per subgroup) has each lane load its own word within the block.
#   fully_connected_gpu_kquant.cl   The call site passes that last-block flag.
#
# MEASURED streamed at steady state (the timing test of 0023, every process warmed once, one
# row, the served model's Q6_K shapes) against 0023 in the same instrument, 2026-09-07:
#   24 GB card (Xe2):    down projection N 5,120 x K 17,408: 400 us against 397 (unchanged);
#                        N 1,024 x K 5,120: 34 against 34. Every Q4_K/Q5_K shape unchanged.
#   16 GiB card (Xe-HPG): down projection 385 us against 510 (-25 %); N 1,024: 34 against 44.
# Correctness 14/14 on both cards. Served on the 24 GB card (mixed form, u8 KV, +p8 base):
# greedy outputs byte-identical to 0023's at 856 and 71,727 tokens, Prüfstand 10/10, the
# decode step unchanged (70.6 against 68.9 ms at 1k, 88.2 against 87.6 at depth: run-to-run).
#
# Why the 24 GB card did not move, measured in the same window (DESIGN 7.0.2bh): with the
# arithmetic removed the row costs 291 us, with the shuffles removed 294, with only its three
# reads 353; the same reads forced onto cache lines or laid out as planes 402; every other
# rows x subgroups dispatch slower than the current 16 x 4. A streaming probe of the read
# shapes over the same bytes puts this three-message form at 289 GB/s, the same three reads
# on 16-byte-aligned 224-byte blocks at 349, one or two wide messages per block at 383-418;
# and a byte-wise block read is exact at any dword-aligned address and wrong two bytes off
# one. The next form is therefore a load-time reorder into 224-byte blocks read as two
# byte-wise block reads with no shuffles (arcint-side layout + a kernel body), not a kernel
# change on the file's bytes. This patch stays: fewer messages, exact, a gain on Xe-HPG.
#
# Measurement knobs used for those numbers (ARCINT_CL_OPTS, ARCINT_KQ_ROWS/SG) are not in this
# patch.

--- a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/include/batch_headers/kquant_utils.cl
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/include/batch_headers/kquant_utils.cl
@@ -273,15 +273,29 @@
 // row) and each lane takes its word from the lane that holds it with one shuffle; the one
 // word an odd block's last lane needs past those reads is a uniform load. The sixteen
 // scales are one uniform load, each lane selecting its byte. No min.
-inline float kq_row_q6k_x(const __global uchar* blk, uint lane, float16 x) {
+// v26 (2026-09-07): the block's last twenty bytes -- qh's last word, the sixteen scales, d --
+// were four per-lane gathers (the scales as a vector load, the tail word, the two bytes of d):
+// six load messages per super-block per row against Q4_K's two, and the decode rates of the
+// three types follow bytes per message almost linearly (372, 316, 188 GB/s at 72, 59, 35
+// bytes per message; DESIGN 7.0.2bg). Now one 16-bit sub-group block read of the 32 bytes at
+// the dword at or below those twenty (a 2-aligned 16-bit block read returns the neighbour's
+// word, DESIGN 7.0.2bc; b4 + 192 is a dword): lane l holds word l, every value is one
+// broadcast, three messages per block. The read runs 12-14 bytes past the block; on the last
+// block of the last row (`last`, uniform) each lane loads its own word within the block instead.
+inline float kq_row_q6k_x(const __global uchar* blk, uint lane, float16 x, uint last) {
     const uint odd = ((uint)(ulong)blk >> 1) & 1u;          // the block starts two bytes past a dword
     const __global uchar* b4 = blk - 2 * odd;
-    const float d = kq_f16at(blk + 208);
     const uint w = lane + odd, src = w >> 1, hi = (w & 1) * 16;   // this lane's word, in words from b4
     const uint2 dq = intel_sub_group_block_read2((const __global uint*)b4);          // ql: lane l holds dwords l and 16 + l
     const uint dh = intel_sub_group_block_read((const __global uint*)(b4 + 128));    // qh: lane l holds dword 32 + l
-    const uint tail = (uint)*(const __global ushort*)(blk + 190);                    // qh's last word (dword 48 for an odd block)
-    const ushort8 sw = vload8(0, (const __global ushort*)(blk + 192));               // the 16 scale bytes
+    ushort tw;                                                                       // word lane of b4 + 192: [tail,] scales, d
+    if (last) {
+        tw = lane < 9u + odd ? *(const __global ushort*)(b4 + 192 + 2 * lane) : (ushort)0;
+    } else {
+        tw = intel_sub_group_block_read_us((const __global ushort*)(b4 + 192));
+    }
+    const uint tail = (uint)sub_group_broadcast(tw, 0u);                             // qh's last word (an odd block's)
+    const float d = kq_f16bits((uint)sub_group_broadcast(tw, 8u + odd));
     float acc = 0.0f;
     __attribute__((opencl_unroll_hint(2)))
     for (uint h = 0; h < 2; ++h) {
@@ -292,7 +306,8 @@
         const uint g1 = (src < 8 ? g1a : g1b) >> hi;
         const uint qa = intel_sub_group_shuffle(dh, (8 * h + src) & 15u);              // qh half h: word 64 + 16h + w
         const uint qw = ((h == 1 && src == 8) ? tail : qa) >> hi;
-        const ushort sv0 = sw[4 * h], sv1 = sw[4 * h + 1], sv2 = sw[4 * h + 2], sv3 = sw[4 * h + 3];   // scale pairs of runs 0..3
+        const ushort sv0 = sub_group_broadcast(tw, 4 * h + odd), sv1 = sub_group_broadcast(tw, 4 * h + 1 + odd),
+                     sv2 = sub_group_broadcast(tw, 4 * h + 2 + odd), sv3 = sub_group_broadcast(tw, 4 * h + 3 + odd);   // scale pairs of runs 0..3
         const float s0 = d * (float)(lane < 8 ? (char)(sv0 & 0xFFu) : (char)(sv0 >> 8));
         const float s1 = d * (float)(lane < 8 ? (char)(sv1 & 0xFFu) : (char)(sv1 >> 8));
         const float s2 = d * (float)(lane < 8 ? (char)(sv2 & 0xFFu) : (char)(sv2 >> 8));
--- a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/fully_connected_gpu_kquant.cl
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/fully_connected_gpu_kquant.cl
@@ -203,7 +203,10 @@
 #elif KQ_TYPE == 13
                 acc[rr] = fma(mask, kq_row_q4k_x(blk, lane, x, xp, 1u), acc[rr]);
 #elif KQ_TYPE == 14
-                acc[rr] = fma(mask, kq_row_q6k_x(blk, lane, x), acc[rr]);
+                // the last block of the last row: its scale read must not run past the buffer
+                acc[rr] = fma(mask, kq_row_q6k_x(blk, lane, x,
+                                                 (uint)(min(n0 + rr, (uint)KQ_N - 1) == (uint)KQ_N - 1 && kb == (uint)KQ_BLOCKS - 1)),
+                              acc[rr]);
 #else
                 if (kb + (lane >> 1) < KQ_BLOCKS) acc[rr] = fma(mask, kq_row_q8_0_piece(blk, lane, xsb), acc[rr]);
 #endif
