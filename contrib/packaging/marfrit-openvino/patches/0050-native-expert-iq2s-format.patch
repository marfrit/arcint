+
+ov::pass::pattern::op::NativeIq2sWeightsBlock::NativeIq2sWeightsBlock() : Block({}, {}, "NativeIq2sWeightsBlock") {
+    // four 10-bit grid indices, little-endian u16, in a u8 weight op-constant
+    auto gridix = wrap_type<v0::Constant>(ov::pass::pattern::type_matches(ov::element::u8));
+    auto w5_target = wrap_type<v0::Constant>();
+    auto w5 = wrap_type<v1::Reshape>({gridix, w5_target});
+    auto lo_idx = wrap_type<v0::Constant>();
+    auto lo_axis = wrap_type<v0::Constant>();
+    auto lo = wrap_type<v8::Gather>({w5, lo_idx, lo_axis});
+    auto hi_idx = wrap_type<v0::Constant>();
+    auto hi_axis = wrap_type<v0::Constant>();
+    auto hi = wrap_type<v8::Gather>({w5, hi_idx, hi_axis});
+    auto hi_conv = wrap_type<v0::Convert>({hi});
+    auto hi_shift_const = wrap_type<v0::Constant>();
+    auto hi_shift = wrap_type<v1::Multiply>({hi_conv, hi_shift_const});
+    auto lo_conv = wrap_type<v0::Convert>({lo});
+    auto index = wrap_type<v1::Add>({lo_conv, hi_shift});
+    auto grid = wrap_type<v0::Constant>();
+    auto grid_axis = wrap_type<v0::Constant>();
+    auto grid_gather = wrap_type<v8::Gather>({grid, index, grid_axis});
+    auto mag_target = wrap_type<v0::Constant>();
+    auto mag = wrap_type<v1::Reshape>({grid_gather, mag_target});
+    // RAW sign bytes (bit j flips value j)
+    auto signix = wrap_type<v0::Constant>(ov::pass::pattern::type_matches(ov::element::u8));
+    auto signix_convert = wrap_type<v0::Convert>({signix});
+    auto sign_unsq_axis = wrap_type<v0::Constant>();
+    auto sign_unsq = wrap_type<v0::Unsqueeze>({signix_convert, sign_unsq_axis});
+    auto masks = wrap_type<v0::Constant>();
+    auto bits = wrap_type<v13::BitwiseAnd>({sign_unsq, masks});
+    auto zero = wrap_type<v0::Constant>();
+    auto neg = wrap_type<v1::Greater>({bits, zero});
+    auto minus_one = wrap_type<v0::Constant>();
+    auto plus_one = wrap_type<v0::Constant>();
+    auto select = wrap_type<v1::Select>({neg, minus_one, plus_one});
+    auto sign_target = wrap_type<v0::Constant>();
+    auto sign = wrap_type<v1::Reshape>({select, sign_target});
+    auto mag_sign = wrap_type<v1::Multiply>({mag, sign});
+    // the two sub-block scales [E,out,g,2] expanded to [E,out,g,32]
+    auto scale = wrap_type<v0::Constant>();
+    auto scale_f32 = ov::pass::pattern::optional<v0::Convert>({scale});
+    auto scale5_target = wrap_type<v0::Constant>();
+    auto scale5 = wrap_type<v1::Reshape>({scale_f32, scale5_target});
+    auto scale_target = wrap_type<v0::Constant>();
+    auto scale_bcast = wrap_type<v3::Broadcast>({scale5, scale_target});
+    auto scale32_target = wrap_type<v0::Constant>();
+    auto scale32 = wrap_type<v1::Reshape>({scale_bcast, scale32_target});
+    auto mul = wrap_type<v1::Multiply>({mag_sign, scale32});
+    auto reshape_target = wrap_type<v0::Constant>();
+    auto reshape = wrap_type<v1::Reshape>({mul, reshape_target});
+    auto weights_input = ov::pass::pattern::optional<v0::Convert>({reshape});
+
+    m_inputs = ov::OutputVector{gridix, signix};
+    m_outputs = ov::OutputVector{weights_input};
+    REGISTER_ANCHORS(this, gridix, signix, scale, reshape);
+}
