+    uint8_t z[8] = {0}; z[0] = 0x03;
+    const uint16_t s[4] = {f32_to_f16_bits(1.0f), f32_to_f16_bits(2.0f),
+                           f32_to_f16_bits(1.0f), f32_to_f16_bits(1.0f)};
+    const auto y = decode_row_through_stage(native_matrix(kQuantFormatIq2S, 64, w, z, s));
+    for (int j = 0; j < 2; j++) EXPECT_EQ(y[j], -8.0f);
+    for (int j = 2; j < 8; j++) EXPECT_EQ(y[j], 8.0f);
+    for (int j = 8; j < 16; j++) EXPECT_EQ(y[j], 8.0f);
+    for (int j = 16; j < 32; j++) EXPECT_EQ(y[j], 16.0f);
+    const float g256[8] = {25, 25, 25, 25, 25, 8, 25, 8};
+    for (int j = 0; j < 8; j++) EXPECT_EQ(y[32 + j], g256[j]);
+    for (int j = 8; j < 32; j++) EXPECT_EQ(y[32 + j], 43.0f);
+    // red case: the affine reading of the same bytes is a different row
+    const auto affine = decode_row_through_stage(native_matrix(0, 64, w, z, s));
+    EXPECT_NE(affine[0], y[0]);
