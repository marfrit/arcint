+inline float native_dot_iq2s(const __global uchar* W,
+                             const __global uchar* Z,
+                             const __global half* S,
+                             int n, int N, int K,
+                             const __global half* x, int x_base,
+                             int id_local) {
+    // IQ2_S: four 10-bit grid indices per 32 values (little-endian u16 in W),
+    // RAW sign bytes in Z, and TWO f16 sub-block scales per 32 in S. S is
+    // ROW-MAJOR [oc, groups, 2] (moe_otd_runtime.cpp skips the transpose for
+    // IQ2_S), so the read is S[n*(K/32)*2 + g*2 + j] -- not the affine
+    // [groups, oc] layout the other native formats use.
+    float acc = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s0 = S[(long)n * (K / 32) * 2 + g * 2 + 0];
+        half s1 = S[(long)n * (K / 32) * 2 + g * 2 + 1];
+        const __global uchar* wrow = W + (long)n * (K / 4) + g * 8;
+        const __global uchar* zrow = Z + (long)n * (K / 8) + g * 4;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            int l = j >> 3;         // the 8-value sub-block
+            int m = j & 7;
+            ushort gi = (ushort)wrow[2 * l] | ((ushort)wrow[2 * l + 1] << 8);
+            float mag = convert_float(NATIVE_IQ2S_GRID[gi * 8 + m]);
+            uchar signs = zrow[l];
+            float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            float s = convert_float((l < 2) ? s0 : s1);
+            acc += convert_float(x[x_base + g * 32 + j]) * s * mag * sign;
+        }
+    }
+    return sub_group_reduce_add(acc);
+}
