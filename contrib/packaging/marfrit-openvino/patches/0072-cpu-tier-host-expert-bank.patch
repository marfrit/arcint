+// arcint (patch 0072). The CPU tier's host expert bank, one per weight file
+// (by canonical path), created on first use when MOE_CPU_BANK_BYTES (bytes)
+// is set; unset or 0 keeps the tier on the file mapping. Each bank reserves
+// the whole budget (MAP_NORESERVE: a budget above the host's free memory ends
+// in an OOM kill, not an allocation error). MOE_CPU_BANK_IO_THREADS reads
+// concurrently (default 8). A bank that cannot be created (the filesystem
+// refuses O_DIRECT) is logged once and that file stays on the mapping. Each
+// bank prints its counters at exit.
+HostExpertBank* cpu_tier_bank(const std::string& weights_path) {
+    static const size_t budget = [] {
+        const char* v = std::getenv("MOE_CPU_BANK_BYTES");
+        return v ? static_cast<size_t>(std::strtoull(v, nullptr, 10)) : size_t{0};
+    }();
+    if (budget == 0)
+        return nullptr;
+    struct Banks {
+        std::mutex m;
+        std::map<std::string, std::unique_ptr<HostExpertBank>> by_path;
+        std::map<std::string, bool> failed;
+        ~Banks() {
+            for (auto& [path, bank] : by_path) {
+                const auto st = bank->stats();
+                std::cerr << "[MOE_BANK] " << path << " filled=" << st.filled << " fill_layers=" << st.fill_layers
+                          << " fill_read_MiB=" << (st.fill_bytes_read >> 20) << " hits=" << st.hits
+                          << " misses=" << st.misses
+                          << " unbanked=" << st.unbanked << " evictions=" << st.evictions
+                          << " read_MiB=" << (st.bytes_read >> 20) << " read_errors=" << st.read_errors
+                          << " callback_errors=" << st.callback_errors
+                          << " slots=" << st.slots << " reserved_MiB=" << (st.reserved_bytes >> 20) << std::endl;
+            }
+        }
+    };
+    static Banks banks;
+    std::error_code ec;
+    auto canonical = std::filesystem::weakly_canonical(std::filesystem::path(weights_path), ec);
+    const std::string path = ec ? weights_path : canonical.string();
+    std::lock_guard<std::mutex> lock(banks.m);
+    if (banks.failed.count(path))
+        return nullptr;
+    auto& bank = banks.by_path[path];
