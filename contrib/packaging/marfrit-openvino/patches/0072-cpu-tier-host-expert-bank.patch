+    // Opens `path` with O_DIRECT (throws when it cannot) and reserves
+    // `budget_bytes` of address space (MAP_NORESERVE; pages exist once read
+    // into). io_threads read spans concurrently.
+    HostExpertBank(const std::string& path, size_t budget_bytes, int io_threads) : _budget(budget_bytes) {
+        _fd = ::open(path.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
