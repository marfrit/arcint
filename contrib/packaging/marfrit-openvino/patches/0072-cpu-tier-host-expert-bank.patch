+    }
+
+    // Reads a Pending slot's spans on the IO threads. done(ok) runs once, on
+    // an IO thread, after the last span has landed; ok=false after a read
+    // error (the slot is dropped, the caller must read the mapping).
+    void fetch(uint32_t slot, std::function<void(bool)> done) {
+        Slot* s = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            s = &_slots[slot];
