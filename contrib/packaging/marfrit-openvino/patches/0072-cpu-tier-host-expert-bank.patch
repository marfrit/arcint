+    }
+
+    // Queues a load-time fill of one layer, run on the bank's fill thread:
+    // `experts` in order (the caller's priority), expert e's span r at
+    // role0[r].file_offset + e * role0[r].bytes (the tier's per-tensor
+    // arrays), each role read as ONE sequential range and copied into the
+    // slots. It takes only new slots while the budget has room (it never
+    // evicts), skips experts already present, and runs once per layer_key.
+    // Acquires of an expert being filled answer Unbanked meanwhile.
+    void fill_layer(uint64_t layer_key, std::vector<uint32_t> experts, std::vector<BankSpan> role0) {
+        if (role0.empty() || role0.size() > static_cast<size_t>(kMaxSpans))
