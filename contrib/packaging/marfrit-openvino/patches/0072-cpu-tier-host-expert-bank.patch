+        st.unbanked = _unbanked.load(std::memory_order_relaxed);
+        st.bytes_read = _bytes_read.load(std::memory_order_relaxed);
+        st.callback_errors = _callback_errors.load(std::memory_order_relaxed);
+        st.slots = _slots.size();
+        st.reserved_bytes = _used;
+        return st;
+    }
+
+private:
+    enum class SlotState { Empty, Reading, Ready };
+
+    struct Key {
+        uint64_t layer_key;
+        uint32_t expert;
+        bool operator==(const Key& o) const {
+            return layer_key == o.layer_key && expert == o.expert;
+        }
+    };
+    struct KeyHash {
+        size_t operator()(const Key& k) const {
+            return std::hash<uint64_t>()(k.layer_key * 0x9E3779B97F4A7C15ull ^ k.expert);
+        }
+    };
+
+    struct Slot {
+        uint8_t* mem = nullptr;
+        size_t cls = 0;
+        Key key{0, 0};
+        SlotState state = SlotState::Empty;
+        int n = 0;
+        size_t record = 0;
+        BankSpan spans[kMaxSpans];
+        int pins = 0;
+        std::list<uint32_t>::iterator lru;
+        bool in_lru = false;
+        std::atomic<int> left{0};
+        std::atomic<bool> failed{false};
+        std::function<void(bool)> done;
+    };
+
+    struct IoJob {
+        uint32_t slot;
+        int span;
+    };
+
+    static uint64_t align_down(uint64_t v) {
+        return v / kAlign * kAlign;
+    }
+    static size_t aligned_len(const BankSpan& sp) {
+        const uint64_t b = align_down(sp.file_offset);
+        const uint64_t e = (sp.file_offset + sp.bytes + kAlign - 1) / kAlign * kAlign;
+        return static_cast<size_t>(e - b);
+    }
+
+    Lease& count_unbanked(Lease& lease) {
+        _unbanked.fetch_add(1, std::memory_order_relaxed);
+        lease.state = State::Unbanked;
+        return lease;
+    }
+
+    Lease& fill_lease(Lease& lease, uint32_t idx, const BankSpan* spans, int n, State st) {
+        lease.state = st;
+        lease.slot = idx;
+        lease.n = n;
+        size_t off = 0;
+        for (int i = 0; i < n; i++) {
+            lease.ptr[i] = _slots[idx].mem + off + (spans[i].file_offset - align_down(spans[i].file_offset));
+            off += aligned_len(spans[i]);
+        }
+        return lease;
+    }
+
+    static bool same_spans(const Slot& s, const BankSpan* spans, int n) {
+        if (s.n != n)
+            return false;
+        for (int i = 0; i < n; i++) {
+            if (s.spans[i].file_offset != spans[i].file_offset || s.spans[i].bytes != spans[i].bytes)
+                return false;
+        }
+        return true;
+    }
+
+    // A fresh slot of class `cls` from the unreserved budget, or none.
+    // Called under _m.
+    bool new_slot(size_t cls, uint32_t& idx) {
+        if (_used + cls > _budget)
+            return false;
+        _slots.emplace_back();
+        idx = static_cast<uint32_t>(_slots.size() - 1);
+        _slots[idx].mem = _base + _used;
+        _slots[idx].cls = cls;
+        _used += cls;
+        return true;
+    }
+
+    void touch_back(uint32_t idx) {
+        Slot& s = _slots[idx];
+        if (s.in_lru)
+            _lru.erase(s.lru);
+        _lru.push_back(idx);
+        s.lru = std::prev(_lru.end());
+        s.in_lru = true;
+    }
+
+    struct FillJob {
+        uint64_t layer_key;
+        std::vector<uint32_t> experts;
+        std::vector<BankSpan> role0;
+    };
+
+    void fill_loop() {
+        for (;;) {
+            FillJob job;
+            {
+                std::unique_lock<std::mutex> lock(_fill_m);
+                _fill_cv.wait(lock, [this] { return _fill_stop || !_fill_q.empty(); });
+                if (_fill_stop)
+                    return;
+                job = std::move(_fill_q.front());
+                _fill_q.pop_front();
+                _fill_busy = true;
+            }
