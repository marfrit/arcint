+            {
+                std::lock_guard<std::mutex> lock(_fill_m);
+                _fill_busy = false;
+            }
+            _fill_cv.notify_all();
+        }
+    }
+
+    void run_fill(const FillJob& job) {
+        const int n = static_cast<int>(job.role0.size());
+        struct Item {
+            uint32_t slot;
+            BankSpan sp[kMaxSpans];
+        };
+        std::vector<Item> items;
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            for (uint32_t e : job.experts) {
+                Item it{};
+                for (int r = 0; r < n; r++)
+                    it.sp[r] = BankSpan{job.role0[r].file_offset + static_cast<uint64_t>(e) * job.role0[r].bytes,
+                                        job.role0[r].bytes};
+                const Key key{job.layer_key, e};
+                if (_index.count(key))
+                    continue;
+                const size_t rec = record_bytes(it.sp, n);
+                const size_t cls = (rec + kSlotRound - 1) / kSlotRound * kSlotRound;
+                if (!new_slot(cls, it.slot))
+                    break;
+                Slot& s = _slots[it.slot];
+                s.key = key;
+                s.state = SlotState::Reading;
+                s.n = n;
+                s.record = rec;
+                for (int r = 0; r < n; r++)
+                    s.spans[r] = it.sp[r];
+                s.pins = 1;
+                _index[key] = it.slot;
+                touch_back(it.slot);
+                items.push_back(it);
+            }
+        }
+        if (items.empty())
+            return;
+        std::vector<bool> ok(items.size(), true);
+        uint64_t read_total = 0;
+        for (int r = 0; r < n; r++) {
+            if (job.role0[r].bytes == 0)
+                continue;
+            uint64_t lo = UINT64_MAX, hi = 0;
+            for (const auto& it : items) {
+                lo = std::min(lo, align_down(it.sp[r].file_offset));
+                hi = std::max(hi, align_down(it.sp[r].file_offset) + aligned_len(it.sp[r]));
+            }
+            const size_t len = static_cast<size_t>(hi - lo);
+            void* m = ::mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+            if (m == MAP_FAILED) {
+                std::fill(ok.begin(), ok.end(), false);
+                break;
+            }
+            auto* buf = static_cast<uint8_t*>(m);
+            size_t got = 0;
+            while (got < len) {
+                const size_t want = std::min(len - got, size_t{64} << 20);
+                const ssize_t rd = ::pread(_fd, buf + got, want, static_cast<off_t>(lo + got));
+                if (rd < 0 && errno == EINTR)
+                    continue;
+                if (rd <= 0)
+                    break;
+                got += static_cast<size_t>(rd);
+            }
+            read_total += got;
+            for (size_t k = 0; k < items.size(); k++) {
+                const BankSpan& sp = items[k].sp[r];
+                const uint64_t b = align_down(sp.file_offset);
+                if (sp.file_offset + sp.bytes - lo > got) {
+                    ok[k] = false;
+                    continue;
+                }
+                size_t off = 0;
+                for (int i = 0; i < r; i++)
