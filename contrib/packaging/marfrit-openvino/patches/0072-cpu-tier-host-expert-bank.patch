+
+    // The bytes a record of these spans occupies in a slot: each span read
+    // as its 4 KiB-aligned superset, back to back.
+    static size_t record_bytes(const BankSpan* spans, int n) {
+        size_t total = 0;
+        for (int i = 0; i < n; i++)
+            total += aligned_len(spans[i]);
+        return total;
+    }
+
+    // Pins the slot of (layer_key, expert) until release(). Ready: the bytes
+    // are in the bank. Pending: they are not, and this caller must call
+    // fetch(lease.slot, ...) exactly once. Unbanked: no slot (the caller reads
+    // the mapping); nothing to release. The pointers are valid for Ready and
+    // Pending (the latter's bytes land before fetch's callback runs).
+    Lease acquire(uint64_t layer_key, uint32_t expert, const BankSpan* spans, int n) {
+        Lease lease;
+        if (n <= 0 || n > kMaxSpans)
+            return count_unbanked(lease);
+        const size_t rec = record_bytes(spans, n);
+        const size_t cls = (rec + kSlotRound - 1) / kSlotRound * kSlotRound;
+        std::lock_guard<std::mutex> lock(_m);
+        const Key key{layer_key, expert};
+        auto it = _index.find(key);
+        if (it != _index.end()) {
+            Slot& s = _slots[it->second];
+            if (s.state == SlotState::Reading || !same_spans(s, spans, n)) {
+                // Being read for another caller (or a key reused with other
+                // spans, which the tier never does): read the mapping.
+                return count_unbanked(lease);
+            }
+            s.pins++;
+            touch(it->second);
+            _stats.hits++;
+            return fill_lease(lease, it->second, spans, n, State::Ready);
+        }
+        uint32_t idx = 0;
+        if (!take_slot(cls, idx))
+            return count_unbanked(lease);
