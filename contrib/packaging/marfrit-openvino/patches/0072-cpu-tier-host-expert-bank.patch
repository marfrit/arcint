+            std::cerr << "[MOE_BANK] disabled for " << path << ": " << e.what() << std::endl;
+            return nullptr;
+        }
+        std::cerr << "[MOE_BANK] " << path << " budget_MiB=" << (budget >> 20) << " io_threads=" << threads
+                  << std::endl;
+    }
+    return bank.get();
+}
