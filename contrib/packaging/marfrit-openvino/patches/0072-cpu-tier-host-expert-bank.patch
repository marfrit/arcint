+            }
+            ::munmap(m, len);
+        }
+        std::lock_guard<std::mutex> lock(_m);
+        for (size_t k = 0; k < items.size(); k++) {
+            Slot& s = _slots[items[k].slot];
+            s.pins = 0;
+            if (ok[k]) {
+                s.state = SlotState::Ready;
+                _stats.filled++;
+            } else {
+                _index.erase(s.key);
+                s.state = SlotState::Empty;
+                _stats.read_errors++;
+            }
+        }
+        _stats.fill_bytes_read += read_total;
+        _stats.fill_layers++;
+    }
+
+    void touch(uint32_t idx) {
+        Slot& s = _slots[idx];
+        if (s.in_lru)
+            _lru.erase(s.lru);
+        _lru.push_front(idx);
+        s.lru = _lru.begin();
+        s.in_lru = true;
+    }
+
+    // A slot of size class `cls`: a new one while the budget has room, else
+    // the least recently used slot of that class that is neither pinned nor
+    // being read. Called under _m.
+    bool take_slot(size_t cls, uint32_t& idx) {
+        if (new_slot(cls, idx))
+            return true;
+        for (auto it = _lru.rbegin(); it != _lru.rend(); ++it) {
+            Slot& s = _slots[*it];
+            if (s.cls == cls && s.pins == 0 && s.state != SlotState::Reading) {
+                idx = *it;
+                if (s.state == SlotState::Ready) {
+                    _index.erase(s.key);
+                    _stats.evictions++;
+                }
+                s.state = SlotState::Empty;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void io_loop() {
+        for (;;) {
+            IoJob job;
+            {
+                std::unique_lock<std::mutex> lock(_io_m);
+                _io_cv.wait(lock, [this] { return _stop || !_io_q.empty(); });
+                // At stop the queue is dropped, not drained: its callbacks
+                // may point into objects already destroyed at process exit.
+                if (_stop)
+                    return;
+                job = _io_q.front();
+                _io_q.pop_front();
+            }
+            Slot& s = _slots_at(job.slot);
+            const BankSpan sp = s.spans[job.span];
+            size_t off = 0;
+            for (int i = 0; i < job.span; i++)
+                off += aligned_len(s.spans[i]);
+            const uint64_t b = align_down(sp.file_offset);
+            const size_t len = aligned_len(sp);
+            const size_t need = static_cast<size_t>(sp.file_offset + sp.bytes - b);
+            size_t got = 0;
+            bool ok = true;
+            while (got < len) {
+                const ssize_t r = ::pread(_fd, s.mem + off + got, len - got, static_cast<off_t>(b + got));
+                if (r < 0 && errno == EINTR)
+                    continue;
+                if (r <= 0)
+                    break;  // an error, or EOF exactly at an aligned boundary
+                got += static_cast<size_t>(r);
+                if (static_cast<size_t>(r) < len - (got - static_cast<size_t>(r)))
+                    break;  // a short read on a regular file is the file's end
+            }
+            if (got < need)
+                ok = false;
+            if (!ok)
+                s.failed.store(true, std::memory_order_relaxed);
+            _bytes_read.fetch_add(got, std::memory_order_relaxed);
+            if (s.left.fetch_sub(1, std::memory_order_acq_rel) == 1)
+                finish(job.slot);
+        }
+    }
+
+    Slot& _slots_at(uint32_t idx) {
+        std::lock_guard<std::mutex> lock(_m);
+        return _slots[idx];
+    }
+
+    void finish(uint32_t idx) {
+        std::function<void(bool)> done;
+        bool ok = true;
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            Slot& s = _slots[idx];
+            ok = !s.failed.load(std::memory_order_relaxed);
+            if (ok) {
+                s.state = SlotState::Ready;
+            } else {
+                _index.erase(s.key);
+                s.state = SlotState::Empty;
+                _stats.read_errors++;
+            }
+            done = std::move(s.done);
+            s.done = nullptr;
+        }
+        if (done) {
+            // The callback is the caller's; an exception must not end the
+            // IO thread (std::terminate). It is counted, and the caller's
+            // own bookkeeping (patch 0072's dispatch) catches its errors.
+            try {
+                done(ok);
+            } catch (...) {
+                _callback_errors.fetch_add(1, std::memory_order_relaxed);
+            }
