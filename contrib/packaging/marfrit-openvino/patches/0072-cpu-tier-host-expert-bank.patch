+struct BankSpan {
+    uint64_t file_offset = 0;
+    size_t bytes = 0;
+};
+
+class HostExpertBank {
+public:
+    static constexpr int kMaxSpans = 12;
+    static constexpr size_t kAlign = 4096;       // O_DIRECT offset/length/buffer alignment
+    static constexpr size_t kSlotRound = 65536;  // slot sizes are rounded to this (size classes)
+
+    enum class State { Ready, Pending, Unbanked };
+
+    struct Lease {
+        State state = State::Unbanked;
+        uint32_t slot = 0;
+        int n = 0;
+        const uint8_t* ptr[kMaxSpans] = {};
+    };
+
+    struct Stats {
+        uint64_t hits = 0;
+        uint64_t misses = 0;
+        uint64_t unbanked = 0;
+        uint64_t evictions = 0;
+        uint64_t bytes_read = 0;
+        uint64_t read_errors = 0;
+        uint64_t filled = 0;           // experts installed by fill_layer
+        uint64_t fill_bytes_read = 0;  // bytes the layer fills read
+        uint64_t fill_layers = 0;
+        uint64_t callback_errors = 0;
+        size_t slots = 0;
+        size_t reserved_bytes = 0;
+    };
