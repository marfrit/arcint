+// arcint (patch 0072). Cells for the CPU tier's host expert bank
+// (moe/host_expert_bank.hpp). They read a scratch file with O_DIRECT, so it
+// lives on a filesystem that takes O_DIRECT: MOE_BANK_TEST_DIR, default
+// /var/tmp.
+
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <random>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "ocl_v2/moe/host_expert_bank.hpp"
+
+using ov::intel_gpu::ocl::moe::BankSpan;
+using ov::intel_gpu::ocl::moe::HostExpertBank;
+
+namespace {
+
+struct ScratchFile {
+    std::string path;
+    std::vector<uint8_t> bytes;
+    explicit ScratchFile(size_t size) {
+        const char* dir = std::getenv("MOE_BANK_TEST_DIR");
+        path = std::string(dir ? dir : "/var/tmp") + "/moe_bank_test_" + std::to_string(::getpid()) + ".bin";
+        std::mt19937 rng(7);
+        bytes.resize(size);
+        for (auto& b : bytes)
+            b = static_cast<uint8_t>(rng());
+        {
+            std::ofstream f(path, std::ios::binary);
+            f.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+        }
+        const int fd = ::open(path.c_str(), O_RDONLY | O_DIRECT);
+        direct_ok = fd >= 0;
+        if (fd >= 0)
+            ::close(fd);
+    }
+    bool direct_ok = false;
+    ~ScratchFile() {
+        ::unlink(path.c_str());
+    }
+};
+
+// The bank opens its file with O_DIRECT; a filesystem that refuses it
+// (tmpfs) skips the cell by name rather than failing it.
+#define REQUIRE_DIRECT(f) \
+    if (!(f).direct_ok) \
+    GTEST_SKIP() << "O_DIRECT refused under " << (f).path << "; set MOE_BANK_TEST_DIR"
+
+// fetch() and a wait for its callback. The state is shared with the
+// callback, so a timed-out wait leaves nothing dangling behind it.
+bool fetch_and_wait(HostExpertBank& bank, uint32_t slot) {
+    struct State {
+        std::mutex m;
+        std::condition_variable cv;
+        bool fired = false, ok = false;
+    };
+    auto st = std::make_shared<State>();
+    bank.fetch(slot, [st](bool r) {
+        std::lock_guard<std::mutex> lock(st->m);
+        st->ok = r;
+        st->fired = true;
+        st->cv.notify_all();
+    });
+    std::unique_lock<std::mutex> lock(st->m);
+    EXPECT_TRUE(st->cv.wait_for(lock, std::chrono::seconds(20), [&] { return st->fired; }));
+    return st->ok;
+}
+
+void expect_span_bytes(const ScratchFile& f, const HostExpertBank::Lease& lease, const BankSpan* spans, int n) {
+    ASSERT_EQ(lease.n, n);
+    for (int i = 0; i < n; i++) {
+        ASSERT_NE(lease.ptr[i], nullptr);
+        EXPECT_EQ(0, std::memcmp(lease.ptr[i], f.bytes.data() + spans[i].file_offset, spans[i].bytes)) << "span " << i;
+    }
+}
+
+// An expert's record: unaligned spans of the tier's sizes, the last one
+// ending at the (unaligned) end of the file.
+std::vector<BankSpan> spans_of(size_t file_size, uint64_t first) {
+    std::vector<BankSpan> s = {{first + 17, 409600}, {first + 409617 + 300, 204800}, {first + 1000001, 102400}};
+    s.push_back({file_size - 81931, 81931});
+    return s;
+}
+
+constexpr size_t kFile = 6 * 1024 * 1024 + 4321;
+constexpr size_t MiB = 1024 * 1024;
+
+}  // namespace
+
+TEST(moe_host_expert_bank, every_span_holds_the_file_bytes_at_its_unaligned_offset) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 4);
+    auto sp = spans_of(kFile, 0);
+    auto lease = bank.acquire(11, 3, sp.data(), static_cast<int>(sp.size()));
+    ASSERT_EQ(lease.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, lease.slot));
+    expect_span_bytes(f, lease, sp.data(), static_cast<int>(sp.size()));
+    bank.release(lease.slot);
+    EXPECT_EQ(bank.stats().read_errors, 0u);
+}
+
+TEST(moe_host_expert_bank, a_second_acquire_is_a_hit_that_reads_nothing) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 4);
+    auto sp = spans_of(kFile, 4096);
+    auto a = bank.acquire(11, 3, sp.data(), static_cast<int>(sp.size()));
+    ASSERT_EQ(a.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, a.slot));
+    bank.release(a.slot);
+    const uint64_t read = bank.stats().bytes_read;
+    auto b = bank.acquire(11, 3, sp.data(), static_cast<int>(sp.size()));
+    ASSERT_EQ(b.state, HostExpertBank::State::Ready);
+    EXPECT_EQ(b.slot, a.slot);
+    expect_span_bytes(f, b, sp.data(), static_cast<int>(sp.size()));
+    bank.release(b.slot);
+    EXPECT_EQ(bank.stats().bytes_read, read);
+    EXPECT_EQ(bank.stats().hits, 1u);
+    EXPECT_EQ(bank.stats().misses, 1u);
+}
+
+TEST(moe_host_expert_bank, lru_evicts_the_least_recent_unpinned_slot_and_never_a_pinned_one) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    auto sp = spans_of(kFile, 0);
+    const int n = static_cast<int>(sp.size());
+    const size_t cls = (HostExpertBank::record_bytes(sp.data(), n) + HostExpertBank::kSlotRound - 1) /
+                       HostExpertBank::kSlotRound * HostExpertBank::kSlotRound;
+    HostExpertBank bank(f.path, 2 * cls, 2);  // room for two slots
+    for (uint32_t e : {1u, 2u}) {
+        auto l = bank.acquire(5, e, sp.data(), n);
+        ASSERT_EQ(l.state, HostExpertBank::State::Pending);
+        ASSERT_TRUE(fetch_and_wait(bank, l.slot));
+        bank.release(l.slot);
+    }
+    auto t = bank.acquire(5, 1, sp.data(), n);  // expert 1 becomes the most recent
+    ASSERT_EQ(t.state, HostExpertBank::State::Ready);
+    bank.release(t.slot);
+    auto c = bank.acquire(5, 3, sp.data(), n);  // evicts expert 2
+    ASSERT_EQ(c.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, c.slot));
+    expect_span_bytes(f, c, sp.data(), n);
+    EXPECT_EQ(bank.stats().evictions, 1u);
+    auto one = bank.acquire(5, 1, sp.data(), n);
+    EXPECT_EQ(one.state, HostExpertBank::State::Ready);
+    // Both slots pinned now (expert 3 and expert 1): a fourth expert has no
+    // slot, and expert 2 is gone.
+    auto d = bank.acquire(5, 4, sp.data(), n);
+    EXPECT_EQ(d.state, HostExpertBank::State::Unbanked);
+    auto two = bank.acquire(5, 2, sp.data(), n);
+    EXPECT_EQ(two.state, HostExpertBank::State::Unbanked);
+    expect_span_bytes(f, one, sp.data(), n);
+    bank.release(one.slot);
+    bank.release(c.slot);
+    EXPECT_EQ(bank.stats().evictions, 1u);
+}
+
+TEST(moe_host_expert_bank, a_short_read_fails_the_fetch_and_drops_the_slot) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 2);
+    std::vector<BankSpan> sp = {{4096, 8192}, {kFile - 100, 4096}};  // the second runs past the end
+    auto l = bank.acquire(9, 0, sp.data(), 2);
+    ASSERT_EQ(l.state, HostExpertBank::State::Pending);
+    EXPECT_FALSE(fetch_and_wait(bank, l.slot));
+    bank.release(l.slot);
+    EXPECT_EQ(bank.stats().read_errors, 1u);
+    auto again = bank.acquire(9, 0, sp.data(), 2);
+    EXPECT_EQ(again.state, HostExpertBank::State::Pending);  // not Ready: the failed bytes are not served
+    ASSERT_FALSE(fetch_and_wait(bank, again.slot));
+    bank.release(again.slot);
+}
+
+TEST(moe_host_expert_bank, a_record_being_read_is_unbanked_for_a_second_caller) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 2);
+    auto sp = spans_of(kFile, 0);
+    const int n = static_cast<int>(sp.size());
+    auto a = bank.acquire(2, 7, sp.data(), n);
+    ASSERT_EQ(a.state, HostExpertBank::State::Pending);
+    auto b = bank.acquire(2, 7, sp.data(), n);
+    EXPECT_EQ(b.state, HostExpertBank::State::Unbanked);
+    ASSERT_TRUE(fetch_and_wait(bank, a.slot));
+    bank.release(a.slot);
+    auto c = bank.acquire(2, 7, sp.data(), n);
+    EXPECT_EQ(c.state, HostExpertBank::State::Ready);
+    bank.release(c.slot);
+    EXPECT_EQ(bank.stats().unbanked, 1u);
+}
+
+TEST(moe_host_expert_bank, a_full_bank_of_one_size_class_does_not_evict_for_another) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    auto big = spans_of(kFile, 0);
+    const int nb = static_cast<int>(big.size());
+    const size_t cls = (HostExpertBank::record_bytes(big.data(), nb) + HostExpertBank::kSlotRound - 1) /
+                       HostExpertBank::kSlotRound * HostExpertBank::kSlotRound;
+    HostExpertBank bank(f.path, cls, 2);  // one big slot
+    auto a = bank.acquire(1, 1, big.data(), nb);
+    ASSERT_EQ(a.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, a.slot));
+    bank.release(a.slot);
+    std::vector<BankSpan> small = {{8192, 4096}};
+    auto s = bank.acquire(1, 2, small.data(), 1);
+    EXPECT_EQ(s.state, HostExpertBank::State::Unbanked);
+    EXPECT_EQ(bank.stats().evictions, 0u);
+    auto again = bank.acquire(1, 1, big.data(), nb);
+    EXPECT_EQ(again.state, HostExpertBank::State::Ready);
+    bank.release(again.slot);
+}
+
+namespace {
+
+// Three per-tensor arrays of 8 experts at unaligned bases, as the tier's
+// weight file lays them out (expert e of role r at base_r + e * bytes_r).
+std::vector<BankSpan> role0_of() {
+    return {{4096 * 3 + 17, 40960 + 17}, {4096 * 3 + 17 + 8 * (40960 + 17) + 100, 20000}, {5 * 1024 * 1024 + 5, 8192}};
+}
+std::vector<BankSpan> expert_spans(const std::vector<BankSpan>& role0, uint32_t e) {
+    std::vector<BankSpan> s;
+    for (const auto& r : role0)
+        s.push_back({r.file_offset + e * r.bytes, r.bytes});
+    return s;
+}
+
+}  // namespace
+
+TEST(moe_host_expert_bank, a_layer_fill_installs_the_listed_experts_with_their_file_bytes) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 2);
+    const auto role0 = role0_of();
+    bank.fill_layer(77, {5, 1, 6}, role0);
+    bank.wait_fill_idle();
+    EXPECT_EQ(bank.stats().filled, 3u);
+    EXPECT_GT(bank.stats().fill_bytes_read, 0u);
+    for (uint32_t e : {5u, 1u, 6u}) {
+        const auto sp = expert_spans(role0, e);
+        auto l = bank.acquire(77, e, sp.data(), 3);
+        ASSERT_EQ(l.state, HostExpertBank::State::Ready) << "expert " << e;
+        expect_span_bytes(f, l, sp.data(), 3);
+        bank.release(l.slot);
+    }
+    const auto sp2 = expert_spans(role0, 2);
+    auto two = bank.acquire(77, 2, sp2.data(), 3);
+    EXPECT_EQ(two.state, HostExpertBank::State::Pending);  // not listed, not filled
+    ASSERT_TRUE(fetch_and_wait(bank, two.slot));
+    bank.release(two.slot);
+    EXPECT_EQ(bank.stats().bytes_read > 0, true);
+}
+
+TEST(moe_host_expert_bank, a_layer_fill_stops_at_the_budget_and_never_evicts) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    const auto role0 = role0_of();
+    const auto sp0 = expert_spans(role0, 0);
+    const size_t cls = (HostExpertBank::record_bytes(sp0.data(), 3) + HostExpertBank::kSlotRound - 1) /
+                       HostExpertBank::kSlotRound * HostExpertBank::kSlotRound;
+    HostExpertBank bank(f.path, 2 * cls + cls / 2, 2);  // two slots and a half
+    auto d = bank.acquire(78, 7, expert_spans(role0, 7).data(), 3);  // a demand slot, released
+    ASSERT_EQ(d.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, d.slot));
+    bank.release(d.slot);
+    bank.fill_layer(78, {0, 1, 2}, role0);
+    bank.wait_fill_idle();
+    EXPECT_EQ(bank.stats().filled, 1u);  // one fresh slot was left
+    EXPECT_EQ(bank.stats().evictions, 0u);
+    auto seven = bank.acquire(78, 7, expert_spans(role0, 7).data(), 3);
+    EXPECT_EQ(seven.state, HostExpertBank::State::Ready);  // the demand slot survived the fill
+    bank.release(seven.slot);
+}
+
+TEST(moe_host_expert_bank, a_layer_fill_skips_present_experts_and_runs_once_per_layer) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 2);
+    const auto role0 = role0_of();
+    auto one = bank.acquire(79, 1, expert_spans(role0, 1).data(), 3);
+    ASSERT_EQ(one.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, one.slot));
+    bank.release(one.slot);
+    bank.fill_layer(79, {1, 2}, role0);
+    bank.wait_fill_idle();
+    EXPECT_EQ(bank.stats().filled, 1u);
+    const uint64_t read = bank.stats().fill_bytes_read;
+    bank.fill_layer(79, {3, 4}, role0);  // the same layer again: nothing runs
+    bank.wait_fill_idle();
+    EXPECT_EQ(bank.stats().filled, 1u);
+    EXPECT_EQ(bank.stats().fill_bytes_read, read);
+    EXPECT_EQ(bank.stats().fill_layers, 1u);
+}
+
+TEST(moe_host_expert_bank, a_key_asked_for_with_other_spans_is_unbanked) {
+    ScratchFile f(kFile);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 * MiB, 2);
+    std::vector<BankSpan> a = {{8192 + 5, 30000}, {65536, 4096}};
+    std::vector<BankSpan> b = {{8192 + 5, 30000}, {65536 + 4096, 4096}};  // same count and record size
+    ASSERT_EQ(HostExpertBank::record_bytes(a.data(), 2), HostExpertBank::record_bytes(b.data(), 2));
+    auto la = bank.acquire(3, 3, a.data(), 2);
+    ASSERT_EQ(la.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, la.slot));
+    bank.release(la.slot);
+    auto lb = bank.acquire(3, 3, b.data(), 2);
+    EXPECT_EQ(lb.state, HostExpertBank::State::Unbanked);
+}
