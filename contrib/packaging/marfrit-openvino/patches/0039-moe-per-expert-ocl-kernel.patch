+// ----- arcint (patch 0039). Per-expert GPU kernel counter -----
+// Campaign: sub4bit-vram-kernel. The per_expert_gpu_invocations counter tracks
+// GPU kernel launches (expert_gate_up + expert_down) for per-expert dispatch.
+// Host-only test: validates the counter exists, increments correctly, and can
+// distinguish GPU per-expert invocations from CPU-tier fallback.
+//
+// The actual GPU kernel correctness test requires the dispatch integration
+// (patch 0040) to compile and launch moe_expert_swiglu.cl's entry points
+// against device-resident expert weights. This test proves the counter
+// plumbing is ready for that integration.
+
+TEST(moe_per_expert_dispatch, gpu_kernel_counter_exists_and_increments) {
+    using ov::intel_gpu::ocl::moe_otd::OtdPerfCounters;
+    OtdPerfCounters perf;
+    ASSERT_EQ(perf.per_expert_gpu_invocations.load(), 0u);
+    perf.per_expert_gpu_invocations.fetch_add(2, std::memory_order_relaxed);
+    ASSERT_EQ(perf.per_expert_gpu_invocations.load(), 2u);
+    perf.per_expert_gpu_invocations.fetch_add(20, std::memory_order_relaxed);
+    ASSERT_EQ(perf.per_expert_gpu_invocations.load(), 22u);
+}
