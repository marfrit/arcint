+// ---------------------------------------------------------------------------
+// SLM interleave: load K-elements into SLM with even/odd split for block
+// reads. Identical to moe_3gemm_swiglu_mlp.cl's x-interleaving code.
+// ---------------------------------------------------------------------------
+inline void load_x_interleaved(__local half* x2,
+                               __local float* xg_sum,
+                               const __global half* x_src,
+                               int K) {
+    int id_sg = get_sub_group_id();
+    int num_sg = get_num_sub_groups();
+    int id_local = get_sub_group_local_id();
+    const __global half* px = x_src + id_sg * FAKE_GROUP_SIZE;
+    __local half* px2 = x2 + id_sg * FAKE_GROUP_SIZE;
+
+    unroll_for(int i = id_sg; i < K / FAKE_GROUP_SIZE; i += num_sg,
+               px += num_sg * FAKE_GROUP_SIZE,
+               px2 += num_sg * FAKE_GROUP_SIZE) {
+#if HAS_ZP
+        float x_group_sum = 0;
+#endif
+        unroll_for(int j = id_local; j < FAKE_GROUP_SIZE / 2; j += SUBGROUP_SIZE) {
+            half even = px[2 * j];
+            half odd  = px[2 * j + 1];
+            px2[j] = even;
+            px2[j + FAKE_GROUP_SIZE / 2] = odd;
+#if HAS_ZP
+            x_group_sum += even + odd;
+#endif
+        }
+#if HAS_ZP
+        x_group_sum = sub_group_reduce_add(x_group_sum);
+        if (id_local == 0) {
+            xg_sum[i] = x_group_sum / SUBGROUP_SIZE;
+        }
+#endif
+    }
+}
+
+// ===========================================================================
+// Stage 1: gate + up for a single expert.
+//   y[n] = up(x)[n] * SiLU(gate(x)[n])
+//
+// Workgroup decomposition (same tiling as the fused kernel per token):
+//   dim 0: token index [0, TOKEN_COUNT)
+//   dim 1: subgroup lanes [0, SUBGROUP_SIZE)
+//   dim 2: output row tile [0, INTERMEDIATE_SIZE / N_BLOCK)
+//   lws:   {1, SUBGROUP_SIZE, SUBGROUP_NUM}
+// ===========================================================================
+__attribute__((intel_reqd_sub_group_size(SUBGROUP_SIZE)))
+KERNEL(expert_gate_up)(
+    const __global MOE_WEI_DT*   gate_weight,
+    const __global MOE_SCALE_DT* gate_scale,
+    const __global MOE_ZP_DT*    gate_zp,
+    const __global MOE_WEI_DT*   up_weight,
+    const __global MOE_SCALE_DT* up_scale,
+    const __global MOE_ZP_DT*    up_zp,
+    const __global MOE_DTYPE*    x,
+    __global MOE_DTYPE*          y)
+{
+    int token_idx = get_global_id(0);
+    y += token_idx * INTERMEDIATE_SIZE;
+
+    __local half x2[HIDDEN_SIZE];
+#if HAS_ZP
+    __local float xg_sum[HIDDEN_SIZE / FAKE_GROUP_SIZE];
+#else
+    __local float xg_sum[1];
+#endif
+
+    load_x_interleaved(x2, xg_sum, x + token_idx * HIDDEN_SIZE, HIDDEN_SIZE);
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+#if WEIGHT_COMPRESSEION_DT == 0
+    expert_gate_up_gemv_u4((__global uchar*)up_weight,
+                           (__global half*)up_scale,
+                           (__global uchar*)up_zp,
+                           y, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                           (half*)x2, (float*)xg_sum, false);
+
+    expert_gate_up_gemv_u4((__global uchar*)gate_weight,
+                           (__global half*)gate_scale,
+                           (__global uchar*)gate_zp,
+                           y, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                           (half*)x2, (float*)xg_sum, true);
+#endif
+}
+
+// ===========================================================================
+// Stage 2: down projection for a single expert.
+//   y[n] = down(intermediate)[n] * routing_weight
+//
+// Workgroup decomposition:
+//   dim 0: token index [0, TOKEN_COUNT)
+//   dim 1: subgroup lanes [0, SUBGROUP_SIZE)
+//   dim 2: output row tile [0, HIDDEN_SIZE / N_BLOCK)
+//   lws:   {1, SUBGROUP_SIZE, SUBGROUP_NUM}
+// ===========================================================================
+__attribute__((intel_reqd_sub_group_size(SUBGROUP_SIZE)))
+KERNEL(expert_down)(
+    const __global MOE_WEI_DT*   weight,
+    const __global MOE_SCALE_DT* scales,
+    const __global MOE_ZP_DT*    zps,
+    const __global MOE_DTYPE*    x,
+    const __global half*         routing_weights,
+    __global MOE_DTYPE*          y)
+{
+    int token_idx = get_global_id(0);
+    x += token_idx * INTERMEDIATE_SIZE;
+    y += token_idx * HIDDEN_SIZE;
+    half routing_weight_val = routing_weights[token_idx];
+
+    __local half x2[INTERMEDIATE_SIZE];
+#if HAS_ZP
+    __local float xg_sum[INTERMEDIATE_SIZE / FAKE_GROUP_SIZE];
+#else
+    __local float xg_sum[1];
+#endif
+
+    load_x_interleaved(x2, xg_sum, x, INTERMEDIATE_SIZE);
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+#if WEIGHT_COMPRESSEION_DT == 0
+    expert_down_gemv_u4((__global uchar*)weight,
+                        (__global half*)scales,
+                        (__global uchar*)zps,
+                        routing_weight_val,
+                        y, HIDDEN_SIZE, INTERMEDIATE_SIZE,
+                        (half*)x2, (float*)xg_sum);
+#endif
+}
