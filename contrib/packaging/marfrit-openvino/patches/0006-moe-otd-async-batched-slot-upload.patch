+StagingRing::Slot StagingRing::acquire(cldnn::engine& engine, size_t bytes) {
+    const size_t idx = _next;
+    _next = (_next + 1) % _entries.size();
+    auto& e = _entries[idx];
+    if (e.pending) {
+        // The slot's previous non-blocking copy may still be reading out of
+        // e.mem's host pointer; wait for it before this call overwrites that
+        // memory with a new payload (docs/design-m9-offload-v2.md §1, P2's
+        // payload-lifetime bullet).
+        e.pending->wait();
+        e.pending.reset();
+    }
+    if (!e.mem || e.capacity < bytes) {
+        auto layout = cldnn::layout({1, 1, 1, static_cast<ov::Dimension::value_type>(bytes)}, cldnn::data_types::u8, cldnn::format::bfyx);
+        e.mem = engine.allocate_memory(layout, cldnn::allocation_type::usm_host, false);
+        if (auto* perf = get_perf_counters())
+            perf->staging_bytes.fetch_add(bytes - e.capacity, std::memory_order_relaxed);
+        e.capacity = bytes;
+    }
+    return {idx, e.mem->buffer_ptr()};
+}
+
+void StagingRing::retire(size_t index, cldnn::event::ptr ev) {
+    _entries[index].pending = std::move(ev);
+}
