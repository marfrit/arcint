+// arcint M9 (patches/0006, P2). Provider-owned pool of usm_host staging
+// buffers for non-blocking miss uploads. A ring rather than one buffer per
+// call: fill_weights_memory enqueues copy_from(..., blocking=false) out of a
+// slot's host pointer, so that pointer must stay valid until its event
+// completes — a loop-local std::vector does not survive that
+// (docs/design-m9-offload-v2.md §1, P2's payload-lifetime bullet).
+// acquire() waits on the slot it is about to hand back if that slot's
+// previous copy has not finished, which bounds ring memory at the cost of a
+// stall only when a batch reuses a slot faster than its DMA drains; retire()
+// records the event the caller must let the ring wait on before the next
+// acquire of that slot. Slot count is a placeholder, tuned by measurement
+// (docs/design-m9-offload-v2.md §4 [to measure]), not a correctness
+// parameter. Single-stream-only by assumption: acquire()/retire() take no
+// lock, so one StagingRing must not be driven from more than one stream or
+// thread concurrently — true today, since it is one-per-provider and each
+// provider is only ever called from its network's own exec stream.
+class StagingRing {
+public:
+    static constexpr size_t default_slot_count = 8;
+
+    explicit StagingRing(size_t slot_count = default_slot_count) : _entries(slot_count) {}
+
+    struct Slot {
+        size_t index;
+        void* host_ptr;
+    };
+
+    Slot acquire(cldnn::engine& engine, size_t bytes);
+    void retire(size_t index, cldnn::event::ptr ev);
+
+private:
+    struct Entry {
+        cldnn::memory::ptr mem;
+        cldnn::event::ptr pending;
+        size_t capacity = 0;
+    };
+
+    std::vector<Entry> _entries;
+    size_t _next = 0;
+};
