+// NOT the rank order (which is seed-dependent and not useful as a stable
+// slot number across a debugging session), so the same resident expert
+// keeps the same slot for as long as the layer's config is unchanged.
+inline size_t static_partition_slot_of(const std::vector<uint32_t>& resident_experts_sorted, uint32_t expert) {
+    auto it = std::lower_bound(resident_experts_sorted.begin(), resident_experts_sorted.end(), expert);
+    return (it != resident_experts_sorted.end() && *it == expert)
