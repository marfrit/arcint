+// arcint F2. The static-partition resident set for one MoE layer: the
+// min(capacity, num_expert) experts with the smallest rank key, returned
+// sorted by expert id. A pure function of (seed, layer_key, num_expert,
+// capacity) -- the same 4-tuple always produces the same set regardless of
+// what requests (if any) preceded the call, and regardless of pool-bytes
+// budget (not one of the four arguments). Ties on the 64-bit key
+// (astronomically unlikely, never observed, but not assumed away) are
+// broken by expert id, so the sort has a total order and the result is not
+// std::sort-implementation-defined.
+inline std::vector<uint32_t> static_partition_resident_experts(uint64_t seed,
+                                                                size_t layer_key,
+                                                                size_t num_expert,
+                                                                size_t capacity) {
+    const size_t n = std::min(capacity, num_expert);
+    std::vector<std::pair<uint64_t, uint32_t>> ranked;
+    ranked.reserve(num_expert);
+    for (uint32_t e = 0; e < static_cast<uint32_t>(num_expert); ++e)
+        ranked.emplace_back(static_partition_rank_key(seed, layer_key, e), e);
+    std::sort(ranked.begin(), ranked.end(), [](const std::pair<uint64_t, uint32_t>& a,
