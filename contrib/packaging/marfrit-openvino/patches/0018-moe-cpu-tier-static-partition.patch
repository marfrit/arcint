+using ov::intel_gpu::ocl::moe::static_partition_checksum;
+using ov::intel_gpu::ocl::moe::static_partition_rank_key;
+using ov::intel_gpu::ocl::moe::static_partition_resident_experts;
+
+// Red 1 (provider level: history independence). OffloadExpertWeightProvider::
+// bind() reserves the static partition's resident set into its LRUCache via
+// reserve_pinned(), once, before any real request; try_acquire_simultaneous's
+// static-partition branch resolves a resident expert purely through
+// LRUCache::probe(), which neither inserts nor evicts. This test drives that
+// exact sequence -- reserve the same resident set into two independent
+// caches, then push two DIFFERENT simulated request histories of ordinary
+// (non-resident) traffic through each before ever probing a resident expert
+// -- and asserts every resident expert resolves to the identical slot on
+// both caches regardless of which history preceded it. Pre-0018 (no
+// reserve_pinned, no probe/pin-aware eviction), this does not compile: red
+// by construction, not by assertion.
+TEST(moe_3gemm_static_partition, history_independence_at_provider_level) {
+    constexpr uint64_t seed = 0xF2A17C0DE5EEDULL;
+    constexpr size_t layer_key = 12345;
+    constexpr size_t num_expert = 32;
+    constexpr size_t capacity = 8;
+
+    const auto resident = static_partition_resident_experts(seed, layer_key, num_expert, capacity);
+    ASSERT_EQ(resident.size(), capacity);
+
+    // arcint F2 review: LRUCache holds a std::mutex member and is neither
+    // copyable nor movable, so it cannot be returned by value (NRVO is an
+    // optimization, not a language guarantee that a copy/move constructor
+    // need not exist) -- drive each cache in place via a reference instead.
+    auto drive = [&](LRUCache& cache, const std::vector<uint32_t>& ordinary_history) {
+        for (size_t slot = 0; slot < resident.size(); ++slot)
+            cache.reserve_pinned(resident[slot], slot);
+        // Ordinary (non-resident) traffic, in whatever order this call was
+        // given -- resident experts are never in `resident_experts()`'s
+        // complement by construction (both come from the same num_expert
+        // range), so pick ids from outside [0, num_expert) to guarantee no
+        // accidental overlap with the reserved set.
+        for (uint32_t e : ordinary_history)
+            cache.get_lru_item(e);
+    };
+
+    // Two orderings of the same 6 ordinary ids, reversed against each other,
+    // plus a repeat in one but not the other -- different enough that an
+    // LRU-driven slot assignment would disagree between them.
+    LRUCache cache_a(/*max_total_experts=*/32);
+    LRUCache cache_b(/*max_total_experts=*/32);
+    drive(cache_a, {1000, 1001, 1002, 1003, 1004, 1005});
+    drive(cache_b, {1005, 1005, 1004, 1003, 1002, 1001, 1000});
+
+    for (size_t slot = 0; slot < resident.size(); ++slot) {
+        const auto probe_a = cache_a.probe(resident[slot]);
+        const auto probe_b = cache_b.probe(resident[slot]);
+        ASSERT_NE(probe_a.first, LRUCache::kProbeMiss) << "expert " << resident[slot] << " missing from cache_a";
+        ASSERT_NE(probe_b.first, LRUCache::kProbeMiss) << "expert " << resident[slot] << " missing from cache_b";
+        EXPECT_EQ(probe_a.first, slot) << "expert " << resident[slot] << " drifted off its reserved slot in cache_a";
+        EXPECT_EQ(probe_b.first, slot) << "expert " << resident[slot] << " drifted off its reserved slot in cache_b";
+        EXPECT_EQ(probe_a.first, probe_b.first)
+            << "expert " << resident[slot] << " resolved to different slots under different request histories";
+    }
+}
+
+// Red 2 (resident set is a function of (layer, expert, slots) only,
+// including pool-bytes invariance). static_partition_resident_experts()'s
+// signature is (seed, layer_key, num_expert, capacity) -- there is no
+// pool-bytes/device_pool_bytes parameter anywhere in its call graph
+// (static_partition.hpp), so two calls that agree on those four values agree
+// on the result regardless of anything about the pool's byte budget; the
+// absence of the parameter is the invariance proof, not a runtime check. This
+// test pins that signature (a caller that tried to pass a fifth "pool bytes"
+// argument would fail to compile) and additionally checks the two directions
+// a rank-based partition must satisfy: identical inputs give an identical,
+// deterministic, and capacity-sized set; and each of the three documented
+// inputs it DOES depend on (layer, expert range via num_expert, slots)
+// changes the set when varied, so the function is not a constant that would
+// trivially pass the "same in, same out" half alone.
+TEST(moe_3gemm_static_partition, resident_set_is_pure_function_of_layer_expert_slots) {
+    constexpr uint64_t seed = 0xF2A17C0DE5EEDULL;
+
+    const auto a1 = static_partition_resident_experts(seed, /*layer_key=*/7, /*num_expert=*/64, /*capacity=*/16);
+    const auto a2 = static_partition_resident_experts(seed, /*layer_key=*/7, /*num_expert=*/64, /*capacity=*/16);
+    EXPECT_EQ(a1, a2) << "identical (seed, layer, num_expert, capacity) produced different resident sets";
+    EXPECT_EQ(a1.size(), 16u);
+    EXPECT_TRUE(std::is_sorted(a1.begin(), a1.end()));
+    for (uint32_t e : a1)
+        EXPECT_LT(e, 64u);
+
+    const auto different_layer = static_partition_resident_experts(seed, /*layer_key=*/8, /*num_expert=*/64, /*capacity=*/16);
+    EXPECT_NE(a1, different_layer) << "layer_key had no effect on the resident set";
+
+    const auto different_slots = static_partition_resident_experts(seed, /*layer_key=*/7, /*num_expert=*/64, /*capacity=*/24);
+    EXPECT_NE(a1.size(), different_slots.size());
+    for (uint32_t e : a1)
+        EXPECT_TRUE(std::find(different_slots.begin(), different_slots.end(), e) != different_slots.end())
+            << "raising capacity dropped expert " << e << " that a smaller capacity kept resident";
+}
+
+// Red 3 (the side is independent of fill state). A pinned-but-not-yet-filled
+// slot is still a resident (device-tier) expert -- LRUCache::probe() must
+// report the same slot before and after the first fill, with only the
+// `filled` half of the pair changing. This is the invariant that lets the
+// static-partition branch in try_acquire_simultaneous decide "resident vs.
+// host" (the side) once, at bind() time, and decide "already uploaded or
+// needs an upload" (fill state) separately and later, without the two ever
+// disagreeing about which side an expert is on.
+TEST(moe_3gemm_static_partition, side_is_independent_of_fill_state) {
+    LRUCache cache(/*max_total_experts=*/4);
+    cache.reserve_pinned(/*expert=*/42, /*slot=*/0);
+
+    const auto before = cache.probe(42);
+    EXPECT_EQ(before.first, 0u);
+    EXPECT_FALSE(before.second) << "a freshly reserved slot must not report filled before any fill";
+
+    cache.set_filled(0);
+
+    const auto after = cache.probe(42);
+    EXPECT_EQ(after.first, 0u);
+    EXPECT_EQ(after.first, before.first) << "fill state changed which slot (which side) the expert resolved to";
+    EXPECT_TRUE(after.second);
+}
+
+// Red 4 (prefill cannot evict a pinned slot). Reserves a pinned set, then
+// drives far more ordinary get_lru_item() traffic than the pool's unpinned
+// capacity -- the shape of prefill's own device-path pressure on this same
+// shared cache (DESIGN Section 7.0.2ae: "the expert slot LRU pool is
+// process-global") -- and asserts every pinned expert survives every one of
+// those evictions. Also checks the pool still functions for ordinary
+// (unpinned) entries: without the pin-aware skip in evict_one_unlocked(),
+// this test either loses a pinned expert (a resident expert silently
+// evicted and rerouted or reloaded elsewhere -- an F2 violation) or, if the
+// naive "front of the list" eviction is what runs, evicts the SAME pinned
+// front-of-list node every time and never frees an unpinned slot for the
+// ordinary traffic, which the final capacity check below would also catch.
+TEST(moe_3gemm_static_partition, prefill_cannot_evict_pinned_slot) {
+    constexpr size_t max_total = 8;
+    constexpr size_t pinned_count = 3;
+    LRUCache cache(max_total);
+    for (size_t slot = 0; slot < pinned_count; ++slot)
+        cache.reserve_pinned(/*expert=*/static_cast<uint32_t>(1000 + slot), slot);
+
+    // Far more distinct ordinary experts than the (max_total - pinned_count)
+    // unpinned slots available, forcing repeated evictions.
+    for (uint32_t e = 0; e < 50; ++e)
+        cache.get_lru_item(e);
+
+    for (size_t slot = 0; slot < pinned_count; ++slot) {
+        const auto probe = cache.probe(static_cast<uint32_t>(1000 + slot));
+        ASSERT_NE(probe.first, LRUCache::kProbeMiss)
+            << "pinned expert " << (1000 + slot) << " was evicted by ordinary prefill-shaped traffic";
+        EXPECT_EQ(probe.first, slot) << "pinned expert " << (1000 + slot) << " changed slot after eviction pressure";
+    }
+    // The pool never exceeds its declared capacity even under sustained
+    // pressure: pinned_count reserved + at most (max_total - pinned_count)
+    // unpinned residents at any time.
+    EXPECT_LE(cache.size(), max_total);
+}
