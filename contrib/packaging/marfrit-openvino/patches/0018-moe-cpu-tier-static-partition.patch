+// arcint F2. FNV-1a checksum of a resident set, logged on the `cpu_tier on:`
+// line (moe_3gemm_swiglu_opt.cpp) so two runs' logs can be diffed for
+// residency agreement without dumping the whole set.
+inline uint64_t static_partition_checksum(const std::vector<uint32_t>& resident_experts_sorted) {
+    uint64_t h = 0xCBF29CE484222325ULL;
+    for (uint32_t e : resident_experts_sorted) {
+        h ^= static_cast<uint64_t>(e);
+        h *= 0x100000001B3ULL;
+    }
+    return h;
