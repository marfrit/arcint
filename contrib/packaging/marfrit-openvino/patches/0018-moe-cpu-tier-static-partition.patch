+// arcint F2 fix (patch 0018, B-5, red-first): MOE_CPU_TIER_STATIC_PARTITION
+// must report false whenever MOE_CPU_TIER itself is off, regardless of
+// MOE_CPU_TIER_PARTITION -- before this fix the options.inl default lambda
+// answered only from the environment, with no way to see this compile's own
+// MOE_CPU_TIER property, so it reported true (the F2 rule "in effect") for
+// every load, tier on or off. Device-free: finalize_impl's moe_cpu_tier_
+// static_partition gate does not touch engine capabilities, unlike the
+// kv-cache-precision tests below it still needs a real ctx/model to reach
+// finalize() at all, so this reuses the same fixture, not because the
+// assertion itself is device-dependent.
+TEST(execution_config, moe_cpu_tier_static_partition_false_when_tier_off) {
+    auto& engine = get_test_engine();
+    auto ctx = std::make_shared<RemoteContextImpl>("GPU", std::vector<cldnn::device::ptr>{engine.get_device()});
+    auto model = make_pa_matmul_model(ov::element::f32);
+
+    ExecutionConfig config;
+    // MOE_CPU_TIER left at its own default (false) -- the exact case the
+    // bug got wrong.
+    config.finalize(ctx.get(), model.get());
+
+    ASSERT_FALSE(config.get_moe_cpu_tier_static_partition());
+}
+
+// The tier-on side of the same gate: once MOE_CPU_TIER is actually set,
+// the property must still answer the F2-vs-LRU default the way it always
+// did (true, MOE_CPU_TIER_PARTITION unset) -- this fix must not flip that.
+TEST(execution_config, moe_cpu_tier_static_partition_true_when_tier_on) {
+    auto& engine = get_test_engine();
+    auto ctx = std::make_shared<RemoteContextImpl>("GPU", std::vector<cldnn::device::ptr>{engine.get_device()});
+    auto model = make_pa_matmul_model(ov::element::f32);
+
+    ExecutionConfig config;
+    config.set_user_property(ov::intel_gpu::moe_cpu_tier(true));
+    config.finalize(ctx.get(), model.get());
+
+    ASSERT_TRUE(config.get_moe_cpu_tier_static_partition());
+}
