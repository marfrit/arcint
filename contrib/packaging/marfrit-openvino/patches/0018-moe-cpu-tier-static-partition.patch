+// arcint F2. Rank key for one (seed, layer, expert) triple. Pure function of
+// its three arguments -- no cache, no LRU, no request history, no fill
+// state anywhere in its call graph, and no pool-bytes budget: two providers
+// that agree on (seed, layer_key, expert) agree on this key regardless of
+// device_pool_bytes, offload_ratio, or how many bytes are actually resident.
+inline uint64_t static_partition_rank_key(uint64_t seed, size_t layer_key, uint32_t expert) {
+    uint64_t h = splitmix64(seed ^ (static_cast<uint64_t>(layer_key) * 0xD6E8FEB86659FD93ULL));
+    h = splitmix64(h ^ static_cast<uint64_t>(expert));
+    return h;
