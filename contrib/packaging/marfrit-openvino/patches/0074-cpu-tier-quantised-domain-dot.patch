+    ExpertJob jr{js.x[0].data(), js.jobs[0].w_route, y_ref.data()};
+    ExpertJob ja{js.x[0].data(), js.jobs[0].w_route, y_avx.data()};
+    moe_cpu_expert_ref(ex->e, &jr, 1, 0, H);
+    moe_cpu_expert_avx2(ex->e, &ja, 1, 0, H);
+    // Pointwise RELATIVE error is meaningless here: the output has components
+    // near zero where the int8 activation's ~0.8 % error dominates the
+    // denominator. Compare the max ABSOLUTE deviation to the reference's own
+    // scale instead.
+    double ref_scale = 0.0, max_abs = 0.0;
+    size_t worst = 0;
+    for (size_t i = 0; i < static_cast<size_t>(H); i++) {
+        const double av = f16_bits_to_double(y_ref[i]);
+        const double bv = f16_bits_to_double(y_avx[i]);
+        ref_scale = std::max(ref_scale, std::fabs(av));
+        const double d = std::fabs(av - bv);
+        if (d > max_abs) { max_abs = d; worst = i; }
+    }
+    std::printf("[DBG] worst i=%zu ref=%.6f avx=%.6f\n", worst, f16_bits_to_double(y_ref[worst]),
+                f16_bits_to_double(y_avx[worst]));
+    for (size_t i = 0; i < 6; i++)
+        std::printf("[DBG] i=%zu ref=%.6f avx=%.6f\n", i, f16_bits_to_double(y_ref[i]),
+                    f16_bits_to_double(y_avx[i]));
+    const double rel = ref_scale > 0.0 ? max_abs / ref_scale : 0.0;
+    RecordProperty("quantised_dot_max_abs", std::to_string(max_abs));
+    RecordProperty("quantised_dot_ref_scale", std::to_string(ref_scale));
+    RecordProperty("quantised_dot_scale_relative", std::to_string(rel));
+    EXPECT_LE(rel, kBound) << "max_abs=" << max_abs << " ref_scale=" << ref_scale;
+    std::vector<uint16_t> y_avx_b(static_cast<size_t>(H), 0);
+    ExpertJob jb{js.x[0].data(), js.jobs[0].w_route, y_avx_b.data()};
+    moe_cpu_expert_avx2(ex->e, &jb, 1, 0, H);
+    EXPECT_EQ(0, std::memcmp(y_avx.data(), y_avx_b.data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+        << "the quantised path is not deterministic across runs";
+}
+
+// arcint (patch 0074). Shape routing: a native expert takes the quantised-
+// domain dot for decode-shaped calls (<= 8 jobs) and the f32 reference for
+// prefill-shaped calls (more jobs). Deterministic by call shape (DESIGN 3.4).
+// Red-first: flipping the threshold, or routing both shapes one way, turns one
+// of the two assertions red.
+TEST(moe_cpu_expert_native, shape_routing_sends_large_calls_to_the_f32_path) {
+    if (!ov::with_cpu_x86_avx2()) {
+        GTEST_SKIP() << "host has no AVX2";
+    }
+    const int H = 2560, I = 640;
+    std::mt19937 rng(0x74u);
+    auto ex = make_native_expert(H, I, rng);
+    {
+        // decode shape: 1 job -> the q8 AVX2 path.
+        JobSet js(H, 1, rng);
+        std::vector<uint16_t> a(static_cast<size_t>(H), 0), b(static_cast<size_t>(H), 0), c(static_cast<size_t>(H), 0);
+        ExpertJob ja{js.x[0].data(), js.jobs[0].w_route, a.data()};
+        ExpertJob jb{js.x[0].data(), js.jobs[0].w_route, b.data()};
+        ExpertJob jc{js.x[0].data(), js.jobs[0].w_route, c.data()};
+        ov::intel_gpu::ocl::moe::moe_cpu_expert(ex->e, &ja, 1, 0, H);
+        moe_cpu_expert_avx2(ex->e, &jb, 1, 0, H);
+        moe_cpu_expert_ref(ex->e, &jc, 1, 0, H);
+        EXPECT_EQ(0, std::memcmp(a.data(), b.data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+            << "a decode-shaped call did not take the q8 AVX2 path";
+        EXPECT_NE(0, std::memcmp(a.data(), c.data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+            << "a decode-shaped call matched the f32 reference bitwise -- it did not take the q8 path";
+    }
+    {
+        // prefill shape: 9 jobs -> the f32 reference (bitwise).
+        JobSet js(H, 9, rng);
+        std::vector<std::vector<uint16_t>> a(9, std::vector<uint16_t>(static_cast<size_t>(H), 0));
+        std::vector<std::vector<uint16_t>> c(9, std::vector<uint16_t>(static_cast<size_t>(H), 0));
+        std::vector<ExpertJob> jobs_a(9), jobs_c(9);
+        for (int j = 0; j < 9; j++) {
+            jobs_a[j] = ExpertJob{js.x[j].data(), js.jobs[j].w_route, a[j].data()};
+            jobs_c[j] = ExpertJob{js.x[j].data(), js.jobs[j].w_route, c[j].data()};
+        }
+        ov::intel_gpu::ocl::moe::moe_cpu_expert(ex->e, jobs_a.data(), 9, 0, H);
+        moe_cpu_expert_ref(ex->e, jobs_c.data(), 9, 0, H);
+        for (int j = 0; j < 9; j++)
+            EXPECT_EQ(0, std::memcmp(a[j].data(), c[j].data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+                << "a prefill-shaped call did not take the f32 path (job " << j << ")";
+    }
+}
