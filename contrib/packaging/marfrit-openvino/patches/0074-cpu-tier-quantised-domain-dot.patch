+// arcint (patch 0074). The quantised-domain dot against the f32 tier at the
+// served native shape. Not bitwise: the activation is quantised to int8 with
+// one scale per 32 values (ggml's approach), so the cell holds to a stated
+// tolerance. Red-first: an IQ3_XXS sign-flip or grid/nibble mis-map moves a
+// value by O(1) times the weight scale, orders above this bound (the f32 tier
+// itself sits ~1e-3 from the double oracle); the same run twice is bit-equal.
+TEST(moe_cpu_expert_native, quantised_dot_matches_the_f32_tier_within_bound) {
+    if (!ov::with_cpu_x86_avx2()) {
+        GTEST_SKIP() << "host has no AVX2";
+    }
+    constexpr double kBound = 0.06;
+    const int H = 2560, I = 640;
+    std::mt19937 rng(0x74u);
+    auto ex = make_native_expert(H, I, rng);
+    JobSet js(H, 1, rng);
+    std::vector<uint16_t> y_ref(static_cast<size_t>(H), 0), y_avx(static_cast<size_t>(H), 0);
+    ExpertJob jr{js.x[0].data(), js.jobs[0].w_route, y_ref.data()};
+    ExpertJob ja{js.x[0].data(), js.jobs[0].w_route, y_avx.data()};
+    moe_cpu_expert_ref(ex->e, &jr, 1, 0, H);
+    moe_cpu_expert_avx2(ex->e, &ja, 1, 0, H);
+    // Pointwise RELATIVE error is meaningless here: the output has components
+    // near zero where the int8 activation's ~0.8 % error dominates the
+    // denominator. Compare the max ABSOLUTE deviation to the reference's own
+    // scale instead.
+    double ref_scale = 0.0, max_abs = 0.0;
+    size_t worst = 0;
+    for (size_t i = 0; i < static_cast<size_t>(H); i++) {
+        const double av = f16_bits_to_double(y_ref[i]);
+        const double bv = f16_bits_to_double(y_avx[i]);
+        ref_scale = std::max(ref_scale, std::fabs(av));
+        const double d = std::fabs(av - bv);
+        if (d > max_abs) { max_abs = d; worst = i; }
+    }
+    std::printf("[DBG] worst i=%zu ref=%.6f avx=%.6f\n", worst, f16_bits_to_double(y_ref[worst]),
+                f16_bits_to_double(y_avx[worst]));
+    for (size_t i = 0; i < 6; i++)
+        std::printf("[DBG] i=%zu ref=%.6f avx=%.6f\n", i, f16_bits_to_double(y_ref[i]),
+                    f16_bits_to_double(y_avx[i]));
+    const double rel = ref_scale > 0.0 ? max_abs / ref_scale : 0.0;
+    RecordProperty("quantised_dot_max_abs", std::to_string(max_abs));
+    RecordProperty("quantised_dot_ref_scale", std::to_string(ref_scale));
+    RecordProperty("quantised_dot_scale_relative", std::to_string(rel));
+    EXPECT_LE(rel, kBound) << "max_abs=" << max_abs << " ref_scale=" << ref_scale;
+    std::vector<uint16_t> y_avx_b(static_cast<size_t>(H), 0);
+    ExpertJob jb{js.x[0].data(), js.jobs[0].w_route, y_avx_b.data()};
+    moe_cpu_expert_avx2(ex->e, &jb, 1, 0, H);
+    EXPECT_EQ(0, std::memcmp(y_avx.data(), y_avx_b.data(), sizeof(uint16_t) * static_cast<size_t>(H)))
+        << "the quantised path is not deterministic across runs";
+}
