+// arcint (patch 0074). Informational: one decode layer call's CPU-expert cost
+// at the served Flash-Next shape (8 experts, one job each, IQ3_XXS gate/up +
+// IQ4_NL down, H=2560 I=640), on the plan the plugin runs. Records the value;
+// the ggml bar is ~540 us per layer. Not a gate.
+TEST(moe_cpu_expert_native, perf_one_layer_call_eight_experts) {
+    const int H = 2560, I = 640, E = 8;
+    std::mt19937 rng(99);
+    std::vector<std::unique_ptr<NativeExpertData>> ex;
+    std::vector<std::unique_ptr<JobSet>> js;
+    std::vector<CpuTierExpertWork> work;
+    for (int x = 0; x < E; x++) {
+        ex.push_back(make_native_expert(H, I, rng));
+        js.push_back(std::make_unique<JobSet>(H, 1, rng));
+        work.push_back(CpuTierExpertWork{&ex[x]->e, js[x]->jobs.data(), js[x]->jobs.size()});
+    }
+    CpuTierPool pool(7);
+    const CpuTierSplit plan = ov::intel_gpu::ocl::moe::cpu_tier_split_plan(E, pool.thread_count(), I, H);
+    for (int rep = 0; rep < 3; rep++) {
+        ov::intel_gpu::ocl::moe::cpu_tier_dispatch(pool, work, plan, {});
+        pool.wait();
+    }
+    const int reps = 200;
+    // Direct, single-threaded: one expert at a time, no pool overhead.
+    for (int x = 0; x < E; x++) ov::intel_gpu::ocl::moe::moe_cpu_expert(ex[x]->e, js[x]->jobs.data(), 1, 0, H);
+    const auto d0 = std::chrono::steady_clock::now();
+    for (int rep = 0; rep < reps; rep++)
+        for (int x = 0; x < E; x++) ov::intel_gpu::ocl::moe::moe_cpu_expert(ex[x]->e, js[x]->jobs.data(), 1, 0, H);
+    const auto d1 = std::chrono::steady_clock::now();
+    const double direct_us = std::chrono::duration<double, std::micro>(d1 - d0).count() / reps;
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int rep = 0; rep < reps; rep++) {
+        ov::intel_gpu::ocl::moe::cpu_tier_dispatch(pool, work, plan, {});
+        pool.wait();
+    }
+    const auto t1 = std::chrono::steady_clock::now();
