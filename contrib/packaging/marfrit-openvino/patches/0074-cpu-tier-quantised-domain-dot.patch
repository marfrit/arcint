+// arcint (patch 0074) debug scaffold: isolate the quantised stage against the
+// f32 stage for one row of each native format.
+TEST(moe_cpu_expert_native, debug_q8_stage) {
+    if (!ov::with_cpu_x86_avx2()) {
+        GTEST_SKIP() << "host has no AVX2";
+    }
+    const int K = 64;
+    std::mt19937 rng(5);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> x(static_cast<size_t>(K));
+    for (auto& v : x) v = nd(rng);
+
+    {
+        std::vector<uint8_t> w(static_cast<size_t>(K) / 2);
+        for (auto& b : w) b = static_cast<uint8_t>(rng() & 0xFF);
+        std::vector<uint16_t> s(2);
+        s[0] = f32_to_f16_bits(0.03f);
+        s[1] = f32_to_f16_bits(0.05f);
+        QuantMatrix m = native_matrix(kQuantFormatIq4Nl, K, w.data(), nullptr, s.data());
+        m.oc = 1;
+        float ref = 0.0f, q8 = 0.0f;
+        ov::intel_gpu::ocl::moe::compute_stage_f32(m, x.data(), 0, 1, &ref);
+        ov::intel_gpu::ocl::moe::compute_stage_q8_for_test(m, x.data(), 0, 1, &q8);
+        std::printf("[DBG-NL] ref=%.6f q8=%.6f\n", ref, q8);
+    }
+    {
+        std::vector<uint8_t> w(static_cast<size_t>(K) / 4);
+        for (auto& b : w) b = static_cast<uint8_t>(rng() & 0xFF);
+        std::vector<uint8_t> z(static_cast<size_t>(K) / 8);
+        for (auto& b : z) b = static_cast<uint8_t>(rng() & 0x7F);
+        std::vector<uint16_t> s(2);
+        s[0] = f32_to_f16_bits(0.03f);
+        s[1] = f32_to_f16_bits(0.05f);
+        QuantMatrix m = native_matrix(kQuantFormatIq3Xxs, K, w.data(), z.data(), s.data());
+        m.oc = 1;
+        float ref = 0.0f, q8 = 0.0f;
+        ov::intel_gpu::ocl::moe::compute_stage_f32(m, x.data(), 0, 1, &ref);
+        ov::intel_gpu::ocl::moe::compute_stage_q8_for_test(m, x.data(), 0, 1, &q8);
+        // Scalar emulation of the q8 algorithm (same tables via the accessors).
+        const uint32_t* grid = ov::intel_gpu::ocl::moe::iq3xxs_grid_table();
+        const uint8_t* signs = ov::intel_gpu::ocl::moe::iq2xs_signs_table();
+        const uint8_t mask[8] = {1, 2, 4, 8, 16, 32, 64, 128};
+        float emu = 0.0f;
+        const int groups = K / 32;
+        for (int g = 0; g < groups; g++) {
+            float amax = 0.0f;
+            for (int j = 0; j < 32; j++) amax = std::max(amax, std::fabs(x[static_cast<size_t>(g) * 32 + j]));
+            const float da = amax / 127.0f;
+            int qv[32];
+            for (int j = 0; j < 32; j++) qv[j] = static_cast<int>(std::nearbyint(x[static_cast<size_t>(g) * 32 + j] / da));
+            long long dot = 0;
+            for (int l = 0; l < 4; l++) {
+                const uint8_t sg = signs[z[static_cast<size_t>(g) * 4 + l] & 127];
+                uint8_t g1[4], g2[4];
+                std::memcpy(g1, &grid[w[static_cast<size_t>(g) * 8 + 2 * l]], 4);
+                std::memcpy(g2, &grid[w[static_cast<size_t>(g) * 8 + 2 * l + 1]], 4);
+                for (int j = 0; j < 4; j++) {
+                    dot += static_cast<long long>(g1[j]) * ((sg & mask[j]) ? -qv[l * 8 + j] : qv[l * 8 + j]);
+                    dot += static_cast<long long>(g2[j]) * ((sg & mask[j + 4]) ? -qv[l * 8 + 4 + j] : qv[l * 8 + 4 + j]);
+                }
+            }
+            emu += f16_bits_to_double(s[static_cast<size_t>(g)]) * da * static_cast<double>(dot);
+            std::printf("[EMU] G%d da=%g dot=%lld\n", g, (double)da, dot);
+        }
+        std::printf("[DBG-IQ3] ref=%.6f q8=%.6f emu=%.6f\n", ref, q8, emu);
+    }
+}
