+// arcint (patch 0074, campaign host-expert-bank / tier hot loop). The
+// quantised-domain dot ggml uses: the activation is quantised ONCE per stage
+// to int8 with a per-32-value scale, and the packed weight is dotted directly
+// (no f32 row materialisation). Copied in approach -- not in code -- from
+// llama.cpp's ggml-cpu vec_dot_iq3_xxs_q8_K / vec_dot_iq4_nl_q8_0 /
+// vec_dot_q8_0_q8_0 (pinned clone 56b9eb28, MIT): maddubs of the unsigned
+// weight magnitude against the sign-flipped q8, madd to int32, one scale
+// product at the end. IQ4_XS arrives in the IQ4_NL layout (scales folded into
+// s), so it takes the IQ4_NL branch. The result is not the f32 decode+dot's
+// bits -- the activation rounding is new -- but it is deterministic.
+inline float hsum_i32_8(__m256i v) {
+    __m128i lo = _mm256_castsi256_si128(v);
+    __m128i hi = _mm256_extracti128_si256(v, 1);
+    __m128i s = _mm_add_epi32(lo, hi);
+    s = _mm_hadd_epi32(s, s);
+    s = _mm_hadd_epi32(s, s);
+    return static_cast<float>(_mm_cvtsi128_si32(s));
+}
+
+void compute_stage_q8_avx2(const QuantMatrix& mat, const float* x, int n_begin, int n_end, float* acc_out) {
+    const int ic = mat.ic;
+    const int groups = ic / 32;
+    std::vector<float> da(static_cast<size_t>(groups));
+    std::vector<int8_t> qa(static_cast<size_t>(ic));
+    for (int g = 0; g < groups; g++) {
+        const float* xb = x + g * 32;
+        float amax = 0.0f;
+        for (int j = 0; j < 32; j++) {
+            const float a = std::fabs(xb[j]);
+            if (a > amax) amax = a;
+        }
+        const float d = amax / 127.0f;
+        da[static_cast<size_t>(g)] = d;
+        if (d == 0.0f) {
+            std::memset(qa.data() + static_cast<size_t>(g) * 32, 0, 32);
+            continue;
+        }
+        const float inv = 1.0f / d;
+        for (int j = 0; j < 32; j++) {
+            float r = std::nearbyint(xb[j] * inv);
+            if (r > 127.0f) r = 127.0f;
+            else if (r < -127.0f) r = -127.0f;
+            qa[static_cast<size_t>(g) * 32 + j] = static_cast<int8_t>(r);
+        }
+    }
+
+    const bool is_iq3 = (mat.format == kQuantFormatIq3Xxs);
+    const bool is_nl  = (mat.format == kQuantFormatIq4Nl);
+    const uint32_t* grid = iq3xxs_grid_table();
+    const int8_t* nlvals = iq4nl_values_table();
+    const __m128i nl_tbl = _mm_loadu_si128(reinterpret_cast<const __m128i*>(nlvals));
+    const __m128i lo4 = _mm_set1_epi8(0x0F);
+    static uint64_t sign64[128];
+    static const bool sign64_init = [] {
+        const uint8_t* st = iq2xs_signs_table();
+        for (int i = 0; i < 128; i++) {
+            const uint8_t b = st[i];
+            uint64_t v = 0;
+            for (int j = 0; j < 8; j++)
+                // _mm256_sign_epi8 ZEROES the source where the sign byte is 0
+                // (PSIGNB semantics), so a clear bit must be +1, not 0.
+                v |= (b & (1u << j)) ? (0xFFULL << (8 * j)) : (0x01ULL << (8 * j));
+            sign64[i] = v;
+        }
+        return true;
+    }();
+    (void)sign64_init;
+
+    for (int n = n_begin; n < n_end; n++) {
+        const size_t wstride = is_iq3 ? static_cast<size_t>(groups) * 8u
+                             : is_nl ? static_cast<size_t>(ic) / 2u
+                                     : static_cast<size_t>(ic);
+        const uint8_t* row = mat.w + static_cast<size_t>(n) * wstride;
+        const uint16_t* sc = mat.s + static_cast<size_t>(n) * static_cast<size_t>(groups);
+        const uint8_t* zrow = is_iq3 ? mat.z + static_cast<size_t>(n) * static_cast<size_t>(groups) * 4u : nullptr;
+        float acc = 0.0f;
+        for (int g = 0; g < groups; g++) {
+            const __m256i q8 = _mm256_loadu_si256(
+                reinterpret_cast<const __m256i*>(qa.data() + static_cast<size_t>(g) * 32));
+            __m256i dot16;
+            if (is_nl) {
+                const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i*>(row + static_cast<size_t>(g) * 16));
+                const __m128i lo = _mm_and_si128(b, lo4);
+                const __m128i hi = _mm_and_si128(_mm_srli_epi16(b, 4), lo4);
+                const __m128i c0 = _mm_unpacklo_epi8(lo, hi);
+                const __m128i c1 = _mm_unpackhi_epi8(lo, hi);
+                const __m256i v = _mm256_set_m128i(_mm_shuffle_epi8(nl_tbl, c1), _mm_shuffle_epi8(nl_tbl, c0));
+                dot16 = _mm256_maddubs_epi16(_mm256_abs_epi8(v), _mm256_sign_epi8(q8, v));
+            } else if (!is_iq3) {
+                const __m256i v = _mm256_loadu_si256(
+                    reinterpret_cast<const __m256i*>(row + static_cast<size_t>(g) * 32));
+                dot16 = _mm256_maddubs_epi16(_mm256_abs_epi8(v), _mm256_sign_epi8(q8, v));
+            } else {
+                const uint8_t* gx = row + static_cast<size_t>(g) * 8u;
+                const uint8_t* sx = zrow + static_cast<size_t>(g) * 4u;
+                const __m256i gv = _mm256_set_epi32(static_cast<int>(grid[gx[7]]), static_cast<int>(grid[gx[6]]),
+                                                    static_cast<int>(grid[gx[5]]), static_cast<int>(grid[gx[4]]),
+                                                    static_cast<int>(grid[gx[3]]), static_cast<int>(grid[gx[2]]),
+                                                    static_cast<int>(grid[gx[1]]), static_cast<int>(grid[gx[0]]));
+                const __m256i sv = _mm256_set_epi64x(static_cast<long long>(sign64[sx[3] & 127]),
+                                                     static_cast<long long>(sign64[sx[2] & 127]),
+                                                     static_cast<long long>(sign64[sx[1] & 127]),
+                                                     static_cast<long long>(sign64[sx[0] & 127]));
+                dot16 = _mm256_maddubs_epi16(gv, _mm256_sign_epi8(q8, sv));
+            }
+            const __m256i p32 = _mm256_madd_epi16(dot16, _mm256_set1_epi16(1));
+            const float dot = hsum_i32_8(p32);
+            acc += f16_to_f32(sc[g]) * da[static_cast<size_t>(g)] * dot;
+        }
+        acc_out[n - n_begin] = acc;
+    }
+}
