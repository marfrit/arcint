+// arcint (patch 0068): see moe_cpu_expert.hpp. Each 8x8 block of the eight
+// rows is transposed in registers so lane r holds row r's k-th value; the
+// products are w * x (x * w in the scalar dot: the same IEEE product).
+__attribute__((optimize("fp-contract=off")))
+void native_dot_rows8_avx2(const float* rows, int ic, const float* x, float* out8) {
+    __m256 acc = _mm256_setzero_ps();
+    for (int k = 0; k < ic; k += 8) {
+        const __m256 r0 = _mm256_loadu_ps(rows + 0 * static_cast<size_t>(ic) + k);
+        const __m256 r1 = _mm256_loadu_ps(rows + 1 * static_cast<size_t>(ic) + k);
+        const __m256 r2 = _mm256_loadu_ps(rows + 2 * static_cast<size_t>(ic) + k);
+        const __m256 r3 = _mm256_loadu_ps(rows + 3 * static_cast<size_t>(ic) + k);
+        const __m256 r4 = _mm256_loadu_ps(rows + 4 * static_cast<size_t>(ic) + k);
+        const __m256 r5 = _mm256_loadu_ps(rows + 5 * static_cast<size_t>(ic) + k);
+        const __m256 r6 = _mm256_loadu_ps(rows + 6 * static_cast<size_t>(ic) + k);
+        const __m256 r7 = _mm256_loadu_ps(rows + 7 * static_cast<size_t>(ic) + k);
+        const __m256 t0 = _mm256_unpacklo_ps(r0, r1), t1 = _mm256_unpackhi_ps(r0, r1);
+        const __m256 t2 = _mm256_unpacklo_ps(r2, r3), t3 = _mm256_unpackhi_ps(r2, r3);
+        const __m256 t4 = _mm256_unpacklo_ps(r4, r5), t5 = _mm256_unpackhi_ps(r4, r5);
+        const __m256 t6 = _mm256_unpacklo_ps(r6, r7), t7 = _mm256_unpackhi_ps(r6, r7);
+        const __m256 u0 = _mm256_shuffle_ps(t0, t2, 0x44), u1 = _mm256_shuffle_ps(t0, t2, 0xEE);
+        const __m256 u2 = _mm256_shuffle_ps(t1, t3, 0x44), u3 = _mm256_shuffle_ps(t1, t3, 0xEE);
+        const __m256 u4 = _mm256_shuffle_ps(t4, t6, 0x44), u5 = _mm256_shuffle_ps(t4, t6, 0xEE);
+        const __m256 u6 = _mm256_shuffle_ps(t5, t7, 0x44), u7 = _mm256_shuffle_ps(t5, t7, 0xEE);
+        // c_i: lane r = rows[r][k + i]
+        const __m256 c0 = _mm256_permute2f128_ps(u0, u4, 0x20), c4 = _mm256_permute2f128_ps(u0, u4, 0x31);
+        const __m256 c1 = _mm256_permute2f128_ps(u1, u5, 0x20), c5 = _mm256_permute2f128_ps(u1, u5, 0x31);
+        const __m256 c2 = _mm256_permute2f128_ps(u2, u6, 0x20), c6 = _mm256_permute2f128_ps(u2, u6, 0x31);
+        const __m256 c3 = _mm256_permute2f128_ps(u3, u7, 0x20), c7 = _mm256_permute2f128_ps(u3, u7, 0x31);
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c0, _mm256_set1_ps(x[k + 0])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c1, _mm256_set1_ps(x[k + 1])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c2, _mm256_set1_ps(x[k + 2])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c3, _mm256_set1_ps(x[k + 3])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c4, _mm256_set1_ps(x[k + 4])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c5, _mm256_set1_ps(x[k + 5])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c6, _mm256_set1_ps(x[k + 6])));
+        acc = _mm256_add_ps(acc, _mm256_mul_ps(c7, _mm256_set1_ps(x[k + 7])));
+    }
+    _mm256_storeu_ps(out8, acc);
+}
