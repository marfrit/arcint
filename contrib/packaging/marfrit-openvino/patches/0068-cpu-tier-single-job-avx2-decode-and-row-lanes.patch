+__attribute__((optimize("fp-contract=off")))
+void decode_iq4nl_row_avx2(const uint8_t* row, const uint16_t* s, int groups, const int8_t* table, float* out) {
+    const __m128i tbl = _mm_loadu_si128(reinterpret_cast<const __m128i*>(table));
+    const __m128i lo4 = _mm_set1_epi8(0x0F);
+    for (int g = 0; g < groups; g++) {
+        const __m256 d = _mm256_set1_ps(_cvtsh_ss(s[g]));
+        const __m128i b = _mm_loadu_si128(reinterpret_cast<const __m128i*>(row + g * 16));
+        const __m128i lo = _mm_and_si128(b, lo4);
+        const __m128i hi = _mm_and_si128(_mm_srli_epi16(b, 4), lo4);
+        // element 2i is byte i's low nibble, 2i+1 its high nibble (linear order)
+        const __m128i c0 = _mm_unpacklo_epi8(lo, hi);
+        const __m128i c1 = _mm_unpackhi_epi8(lo, hi);
+        const __m128i v0 = _mm_shuffle_epi8(tbl, c0);
+        const __m128i v1 = _mm_shuffle_epi8(tbl, c1);
+        float* y = out + g * 32;
+        _mm256_storeu_ps(y + 0, _mm256_mul_ps(d, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(v0))));
+        _mm256_storeu_ps(y + 8, _mm256_mul_ps(d, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(v0, 8)))));
+        _mm256_storeu_ps(y + 16, _mm256_mul_ps(d, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(v1))));
+        _mm256_storeu_ps(y + 24, _mm256_mul_ps(d, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(v1, 8)))));
+    }
+}
