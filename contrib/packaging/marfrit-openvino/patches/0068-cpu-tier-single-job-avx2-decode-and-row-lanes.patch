+// arcint (patch 0068): see moe_cpu_expert.hpp. The f16 scale converts exactly
+// (F16C); the product is the scalar decoder's d * float(v); the sign is a
+// sign-bit xor, which is what multiplying by -1.0f does exactly.
+__attribute__((optimize("fp-contract=off")))
+void decode_iq3xxs_row_avx2(const uint8_t* gridix, const uint8_t* signix, const uint16_t* s, int groups,
+                            const uint32_t* grid, const uint8_t* signs_tbl, float* out) {
+    const __m256i bits = _mm256_setr_epi32(1, 2, 4, 8, 16, 32, 64, 128);
+    const __m256 signbit = _mm256_castsi256_ps(_mm256_set1_epi32(static_cast<int>(0x80000000u)));
+    for (int g = 0; g < groups; g++) {
+        const __m256 d = _mm256_set1_ps(_cvtsh_ss(s[g]));
+        for (int l = 0; l < 4; l++) {
+            const int signs = signs_tbl[signix[g * 4 + l] & 127];
+            const __m128i v = _mm_set_epi32(0, 0, static_cast<int>(grid[gridix[g * 8 + 2 * l + 1]]),
+                                            static_cast<int>(grid[gridix[g * 8 + 2 * l + 0]]));
+            const __m256 f = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(v));
+            const __m256i neg = _mm256_cmpeq_epi32(_mm256_and_si256(_mm256_set1_epi32(signs), bits), bits);
+            const __m256 y = _mm256_xor_ps(_mm256_mul_ps(d, f), _mm256_and_ps(_mm256_castsi256_ps(neg), signbit));
+            _mm256_storeu_ps(out + g * 32 + l * 8, y);
+        }
+    }
+}
