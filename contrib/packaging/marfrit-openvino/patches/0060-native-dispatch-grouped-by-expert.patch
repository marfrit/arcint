+// arcint (patch 0060): the same decoders over a TILE of up to NATIVE_TILE_M
+// tokens that share one expert: each weight element is decoded once and every
+// token's lane accumulator takes the same left-to-right product, in the same
+// order, as the one-token decoder above (x * scale * magnitude * sign, per
+// format). The source does not GUARANTEE equal bytes: the plugin builds with
+// -cl-mad-enable, so contraction is the compiler's choice per kernel. That a
+// token's value does not depend on which tokens share its tile is MEASURED
+// (the dispatch cell, the served digests). out[t] for t < cnt. NATIVE_TILE_M
+// is the native generators' JIT constant (kNativeTileM on the host).
+
+inline void native_dot_iq4nl_tile(const __global uchar* W, const __global half* S, int n, int N, int K,
+                                  const __global half* x, __private const int* xb, int cnt, int id_local,
+                                  __private float* out) {
+    float acc[NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[t] = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s = S[g * N + n];
+        const __global uchar* codes = W + n * (K / 2) + g * 16;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            uchar byte = codes[j >> 1];
+            int code = (j & 1) ? (byte >> 4) : (byte & 0x0F);
+            const float fs = convert_float(s);
+            const float fv = convert_float(NATIVE_IQ4NL_TABLE[code]);
+            __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+                if (t < cnt) acc[t] += convert_float(x[xb[t] + g * 32 + j]) * fs * fv;
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+        if (t < cnt) out[t] = sub_group_reduce_add(acc[t]);
+}
