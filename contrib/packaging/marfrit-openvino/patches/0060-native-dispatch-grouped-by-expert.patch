+inline void native_dot_iq3xxs_tile(const __global uchar* W, const __global uchar* Z, const __global half* S,
+                                   int n, int N, int K, const __global half* x, __private const int* xb, int cnt,
+                                   int id_local, __private float* out) {
+    float acc[NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[t] = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s = S[g * N + n];
+        const __global uchar* gridix = W + n * (K / 4) + g * 8;
+        const __global uchar* signix = Z + n * (K / 8) + g * 4;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            int l = j >> 3;
+            int m = j & 7;
+            uchar gi = (m < 4) ? gridix[2 * l] : gridix[2 * l + 1];
+            float mag = convert_float(NATIVE_IQ3XXS_GRID[gi * 4 + (m & 3)]);
+            uchar signs = NATIVE_IQ2XS_SIGNS[signix[l] & 127];
+            float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            const float fs = convert_float(s);
+            __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+                if (t < cnt) acc[t] += convert_float(x[xb[t] + g * 32 + j]) * fs * mag * sign;
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+        if (t < cnt) out[t] = sub_group_reduce_add(acc[t]);
+}
+
+inline void native_dot_iq2s_tile(const __global uchar* W, const __global uchar* Z, const __global half* S,
+                                 int n, int N, int K, const __global half* x, __private const int* xb, int cnt,
+                                 int id_local, __private float* out) {
+    float acc[NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[t] = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s0 = S[(long)n * (K / 32) * 2 + g * 2 + 0];
+        half s1 = S[(long)n * (K / 32) * 2 + g * 2 + 1];
+        const __global uchar* wrow = W + (long)n * (K / 4) + g * 8;
+        const __global uchar* zrow = Z + (long)n * (K / 8) + g * 4;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            int l = j >> 3;
+            int m = j & 7;
+            ushort gi = (ushort)wrow[2 * l] | ((ushort)wrow[2 * l + 1] << 8);
+            float mag = convert_float(NATIVE_IQ2S_GRID[gi * 8 + m]);
+            uchar signs = zrow[l];
+            float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            float s = convert_float((l < 2) ? s0 : s1);
+            __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+                if (t < cnt) acc[t] += convert_float(x[xb[t] + g * 32 + j]) * s * mag * sign;
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+        if (t < cnt) out[t] = sub_group_reduce_add(acc[t]);
+}
+
+inline void native_dot_iq2s_packed_tile(const __global uchar* W, const __global half* S, int n, int N, int K,
+                                        const __global half* x, __private const int* xb, int cnt, int id_local,
+                                        __private float* out) {
+    float acc[NATIVE_TILE_M];
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++) acc[t] = 0.0f;
+    const int nblk = K / 256;
+    const __global uchar* brow = W + (long)n * nblk * 80;
+    for (int ib = 0; ib < nblk; ib++) {
+        const __global uchar* blk = brow + (long)ib * 80;
+        float d = convert_float(S[(long)n * nblk + ib]);
+        for (int ib32 = 0; ib32 < 8; ib32++) {
+            uchar scb = blk[72 + ib32];
+            float dlo = d * (0.5f + convert_float(scb & 0x0F)) * 0.25f;
+            float dhi = d * (0.5f + convert_float(scb >> 4)) * 0.25f;
+            uchar qhb = blk[64 + ib32];
+            for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+                int l = j >> 3;
+                int m = j & 7;
+                ushort gi = (ushort)blk[ib32 * 4 + l] | ((ushort)((qhb >> (2 * l)) & 3) << 8);
+                float mag = convert_float(NATIVE_IQ2S_GRID[gi * 8 + m]);
+                uchar signs = blk[32 + ib32 * 4 + l];
+                float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+                float dd = (l < 2) ? dlo : dhi;
+                __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+                    if (t < cnt) acc[t] += convert_float(x[xb[t] + ib * 256 + ib32 * 32 + j]) * dd * mag * sign;
+            }
+        }
+    }
+    __attribute__((opencl_unroll_hint)) for (int t = 0; t < NATIVE_TILE_M; t++)
+        if (t < cnt) out[t] = sub_group_reduce_add(acc[t]);
+}
