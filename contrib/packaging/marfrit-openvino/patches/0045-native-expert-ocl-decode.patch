+// arcint (patch 0045). Native-format per-expert kernels: the same dispatch
+// geometry and argument list as MoEExpertGateUp/MoEExpertDown, but the
+// expert weights are the checkpoint's own blocks (IQ4_NL / IQ3_XXS / Q8_0),
+// decoded in the K-loop. The kernels are compiled only when per-expert
+// dispatch is on and the config carries a native weight format.
+class MoEExpertGateUpNative : public KernelGenerator {
+public:
+    MoEExpertGateUpNative()
+        : KernelGenerator("moe_expert_swiglu", "expert_gate_up_native") {}
+protected:
+    JitConstants get_jit_constants(const RuntimeParams& params) const override {
+        auto jit = KernelGenerator::get_jit_constants(params);
+        add_common_consts(params, jit);
+        jit.make("NATIVE_GATE_UP_ENABLE", 1);
+        auto desc = params.typed_desc<moe_3gemm_fused_compressed>();
+        // A gate/up projection is IQ3_XXS (2) or IQ4_XS-in-the-IQ4_NL-layout
+        // (1); Q8_0 is a down format in this checkpoint. Refuse a decode the
+        // kernel does not have rather than run the IQ4_NL path over Q8_0
+        // bytes (the "wrong dequant rejected" rule of 0045's test ladder).
+        OPENVINO_ASSERT(desc->_config.gate_up_weight_format == 1 ||
+                            desc->_config.gate_up_weight_format == 2,
+                        "native per-expert gate/up kernel supports IQ4_NL (1) and IQ3_XXS (2); got format ",
+                        desc->_config.gate_up_weight_format);
+        if (desc->_config.activation_type == ov::op::internal::MOE::Activation_type::GEGLU_TANH)
+            jit.make("GATE_ACT_GELU_TANH", 1);
+        else if (desc->_config.activation_type == ov::op::internal::MOE::Activation_type::GEGLU_ERF)
+            jit.make("GATE_ACT_GELU_ERF", 1);
+        return jit;
+    }
+    Arguments get_arguments_desc(const RuntimeParams&) const override { return {}; }
+    DispatchDataFunc get_dispatch_data_func() const override {
+        return DispatchDataFunc{[](const RuntimeParams&, KernelData&, ImplRuntimeParams*) {}};
+    }
+};
+
+class MoEExpertDownNative : public KernelGenerator {
+public:
+    MoEExpertDownNative()
+        : KernelGenerator("moe_expert_swiglu", "expert_down_native") {}
+protected:
+    JitConstants get_jit_constants(const RuntimeParams& params) const override {
+        auto jit = KernelGenerator::get_jit_constants(params);
+        add_common_consts(params, jit);
+        jit.make("NATIVE_DOWN_ENABLE", 1);
+        auto desc = params.typed_desc<moe_3gemm_fused_compressed>();
+        // Native down formats in this checkpoint: IQ4_NL (1; IQ4_XS shares the
+        // layout), IQ3_XXS (2), Q8_0 (3). The .cl's #else branch is IQ4_NL, so
+        // refuse anything else rather than silently decode it as IQ4_NL.
+        OPENVINO_ASSERT(desc->_config.down_weight_format == 1 ||
+                            desc->_config.down_weight_format == 2 ||
+                            desc->_config.down_weight_format == 3,
+                        "native per-expert down kernel supports IQ4_NL (1), IQ3_XXS (2) and Q8_0 (3); got format ",
+                        desc->_config.down_weight_format);
+        return jit;
+    }
+    Arguments get_arguments_desc(const RuntimeParams&) const override { return {}; }
+    DispatchDataFunc get_dispatch_data_func() const override {
+        return DispatchDataFunc{[](const RuntimeParams&, KernelData&, ImplRuntimeParams*) {}};
+    }
+};
