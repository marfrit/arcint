+// ===========================================================================
+// arcint (patch 0045). Native per-expert kernels.
+//
+// Same dispatch geometry and argument list as expert_gate_up / expert_down
+// (patch 0040): one workgroup per (token, expert) pair, dim 2 tiles the output
+// rows by N_BLOCK, the subgroup's lanes share one output row's K reduction.
+// What differs is only the decode: no interleaved SLM x, no packed-u4 block
+// reads -- the weight bytes are decoded per element inside the K-loop and the
+// scale is read from the device-transposed [groups, oc] array.
+// ===========================================================================
+#ifdef NATIVE_GATE_UP_ENABLE
+__attribute__((intel_reqd_sub_group_size(SUBGROUP_SIZE)))
+KERNEL(expert_gate_up_native)(
+    const __global MOE_WEI_DT*   gate_weight,
+    const __global MOE_SCALE_DT* gate_scale,
+    const __global MOE_ZP_DT*    gate_zp,
+    const __global MOE_WEI_DT*   up_weight,
+    const __global MOE_SCALE_DT* up_scale,
+    const __global MOE_ZP_DT*    up_zp,
+    const __global MOE_DTYPE*    x,
+    __global MOE_DTYPE*          y,
+    int slot_index,
+    int x_base_elem,
+    int y_base_elem)
+{
+    const int id_local = get_sub_group_local_id();
+    const int token_idx = get_global_id(0);
+    const int n_start = get_global_id(2) * N_BLOCK;
+
+    // per-expert strides of the native slots (bytes; the slot fill writes one
+    // expert's tensor bytes at lru_expert_no * (tensor bytes / num_expert))
+#if NATIVE_GU_FORMAT == 2  // IQ3_XXS: u8 grid indices (K/4) + u8 sign indices (K/8)
+    gate_weight += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 4);
+    gate_zp     += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 8);
+    up_weight   += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 4);
+    up_zp       += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 8);
+#else                      // IQ4_NL: packed u4 codes (K/2)
+    gate_weight += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 2);
+    up_weight   += (long)slot_index * ((long)INTERMEDIATE_SIZE * HIDDEN_SIZE / 2);
+#endif
+    gate_scale += (long)slot_index * ((long)(HIDDEN_SIZE / GATE_UP_GROUP_SIZE) * INTERMEDIATE_SIZE);
+    up_scale   += (long)slot_index * ((long)(HIDDEN_SIZE / GATE_UP_GROUP_SIZE) * INTERMEDIATE_SIZE);
+
+    const int x_base = x_base_elem + token_idx * HIDDEN_SIZE;
+    __global MOE_DTYPE* yrow = y + y_base_elem + token_idx * INTERMEDIATE_SIZE;
+
+    const int n_end = min(n_start + N_BLOCK, INTERMEDIATE_SIZE);
+    for (int n = n_start; n < n_end; n++) {
+        float su, sg;
+#if NATIVE_GU_FORMAT == 2
+        su = native_dot_iq3xxs((const __global uchar*)up_weight,
+                               (const __global uchar*)up_zp,
+                               (const __global half*)up_scale,
+                               n, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                               (const __global half*)x, x_base, id_local);
+        sg = native_dot_iq3xxs((const __global uchar*)gate_weight,
+                               (const __global uchar*)gate_zp,
+                               (const __global half*)gate_scale,
+                               n, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                               (const __global half*)x, x_base, id_local);
+#else
+        su = native_dot_iq4nl((const __global uchar*)up_weight,
+                              (const __global half*)up_scale,
+                              n, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                              (const __global half*)x, x_base, id_local);
+        sg = native_dot_iq4nl((const __global uchar*)gate_weight,
+                              (const __global half*)gate_scale,
+                              n, INTERMEDIATE_SIZE, HIDDEN_SIZE,
+                              (const __global half*)x, x_base, id_local);
+#endif
+        if (id_local == 0) {
+            yrow[n] = (MOE_DTYPE)(su * MOE_GATE_ACT(sg));
+        }
+    }
+}
