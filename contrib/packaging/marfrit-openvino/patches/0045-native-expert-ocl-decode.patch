+inline float native_dot_iq4nl(const __global uchar* W,
+                              const __global half* S,
+                              int n, int N, int K,
+                              const __global half* x, int x_base,
+                              int id_local) {
+    float acc = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s = S[g * N + n];  // scales are device-transposed to [groups, oc]
+        const __global uchar* codes = W + n * (K / 2) + g * 16;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            uchar byte = codes[j >> 1];
+            int code = (j & 1) ? (byte >> 4) : (byte & 0x0F);
+            acc += convert_float(x[x_base + g * 32 + j]) * convert_float(s)
+                   * convert_float(NATIVE_IQ4NL_TABLE[code]);
+        }
+    }
+    return sub_group_reduce_add(acc);
+}
+
+inline float native_dot_iq3xxs(const __global uchar* W,
+                               const __global uchar* Z,
+                               const __global half* S,
+                               int n, int N, int K,
+                               const __global half* x, int x_base,
+                               int id_local) {
+    float acc = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s = S[g * N + n];
+        const __global uchar* gridix = W + n * (K / 4) + g * 8;
+        const __global uchar* signix = Z + n * (K / 8) + g * 4;
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            int l = j >> 3;         // the 8-value sub-block
+            int m = j & 7;
+            uchar gi = (m < 4) ? gridix[2 * l] : gridix[2 * l + 1];
+            float mag = convert_float(NATIVE_IQ3XXS_GRID[gi * 4 + (m & 3)]);
+            uchar signs = NATIVE_IQ2XS_SIGNS[signix[l] & 127];
+            float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            acc += convert_float(x[x_base + g * 32 + j]) * convert_float(s) * mag * sign;
+        }
+    }
+    return sub_group_reduce_add(acc);
+}
+
+inline float native_dot_q8_0(const __global uchar* W,
+                             const __global half* S,
+                             int n, int N, int K,
+                             const __global half* x, int x_base,
+                             int id_local) {
+    float acc = 0.0f;
+    for (int g = 0; g < K / 32; g++) {
+        half s = S[g * N + n];
+        const __global char* codes = (const __global char*)(W + n * K + g * 32);
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            acc += convert_float(x[x_base + g * 32 + j]) * convert_float(s)
+                   * convert_float(codes[j]);
+        }
+    }
+    return sub_group_reduce_add(acc);
+}
