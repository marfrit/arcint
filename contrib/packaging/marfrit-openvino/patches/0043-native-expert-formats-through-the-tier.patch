+TEST(moe_cpu_expert_native, iq4_nl_row_decodes_through_the_16_entry_table) {
+    // two 32-value blocks of codes in LINEAR element order (the exporter's
+    // split re-lays the GGUF block's nibbles, native_blocks.iq4_nl_split, and
+    // pack_u4 packs element k into byte k/2, even index low): y[j] = T[j],
+    // y[j+16] = T[15-j]; d = 1.0 then 0.5. (The first form of this cell built
+    // the GGUF's own nibble layout and failed against the correct decoder.)
+    static const int8_t T[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+    uint8_t codes[64];
+    for (int b = 0; b < 2; b++)
+        for (int j = 0; j < 16; j++) {
+            codes[b * 32 + j] = static_cast<uint8_t>(j);
+            codes[b * 32 + 16 + j] = static_cast<uint8_t>(15 - j);
+        }
+    uint8_t w[32];
+    for (int m = 0; m < 32; m++) w[m] = static_cast<uint8_t>(codes[2 * m] | (codes[2 * m + 1] << 4));
+    const uint16_t s[2] = {f32_to_f16_bits(1.0f), f32_to_f16_bits(0.5f)};
+    const auto y = decode_row_through_stage(native_matrix(kQuantFormatIq4Nl, 64, w, nullptr, s));
+    for (int j = 0; j < 16; j++) {
+        EXPECT_EQ(y[j], static_cast<float>(T[j]));
+        EXPECT_EQ(y[16 + j], static_cast<float>(T[15 - j]));
+        EXPECT_EQ(y[32 + j], 0.5f * static_cast<float>(T[j]));
+        EXPECT_EQ(y[48 + j], 0.5f * static_cast<float>(T[15 - j]));
+    }
+    // the affine reading of the same bytes is a different row (the cell can fail)
+    const auto affine = decode_row_through_stage(native_matrix(0, 64, w, nullptr, s));
+    EXPECT_NE(affine[0], y[0]);
+}
+
+TEST(moe_cpu_expert_native, q8_0_row_decodes_as_d_times_q) {
+    int8_t q[64];
+    for (int j = 0; j < 64; j++) q[j] = static_cast<int8_t>((j % 32) - 16);
+    const uint16_t s[2] = {f32_to_f16_bits(0.5f), f32_to_f16_bits(-2.0f)};
+    const auto y = decode_row_through_stage(
+        native_matrix(kQuantFormatQ8_0, 64, reinterpret_cast<const uint8_t*>(q), nullptr, s));
+    for (int j = 0; j < 32; j++) {
+        EXPECT_EQ(y[j], 0.5f * static_cast<float>(j - 16));
+        EXPECT_EQ(y[32 + j], -2.0f * static_cast<float>(j - 16));
+    }
+}
+
+TEST(moe_cpu_expert_native, iq3_xxs_row_decodes_through_the_grid_and_the_sign_masks) {
+    // one 32-value sub-block: grid index pair (1, 0) for the first 8 values
+    // (grid[1] = 0x04040414 -> magnitudes 20,4,4,4; grid[0] -> 4,4,4,4), sign
+    // index 5 (= 0b101: values 0 and 2 negative), scale d*(0.5+3)*0.5 = 1.75
+    // -> [-35, 7, -7, 7, 7, 7, 7, 7]; the remaining 24 values grid 0, sign 0
+    // -> 7. A second sub-block at scale 0.25 (s = 0) -> 1.0 everywhere.
+    uint8_t gridix[16] = {0}; gridix[0] = 1;
+    uint8_t signix[8] = {0}; signix[0] = 5;
+    const uint16_t s[2] = {f32_to_f16_bits(1.75f), f32_to_f16_bits(0.25f)};
+    const auto y = decode_row_through_stage(native_matrix(kQuantFormatIq3Xxs, 64, gridix, signix, s));
+    const float want[8] = {-35, 7, -7, 7, 7, 7, 7, 7};
+    for (int j = 0; j < 8; j++) EXPECT_EQ(y[j], want[j]);
+    for (int j = 8; j < 32; j++) EXPECT_EQ(y[j], 7.0f);
+    for (int j = 32; j < 64; j++) EXPECT_EQ(y[j], 1.0f);
+}
