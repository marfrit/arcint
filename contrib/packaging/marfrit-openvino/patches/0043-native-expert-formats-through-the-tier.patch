+std::vector<float> decode_row_through_stage(const QuantMatrix& m) {
+    std::vector<float> out(static_cast<size_t>(m.ic)), x(static_cast<size_t>(m.ic), 0.0f);
+    for (int k = 0; k < m.ic; k++) {
+        x[static_cast<size_t>(k)] = 1.0f;
+        float acc = 0.0f;
+        compute_stage_f32(m, x.data(), 0, 1, &acc);
+        out[static_cast<size_t>(k)] = acc;
+        x[static_cast<size_t>(k)] = 0.0f;
+    }
+    return out;
+}
