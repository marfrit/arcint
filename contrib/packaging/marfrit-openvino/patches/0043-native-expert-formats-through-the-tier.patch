+QuantMatrix native_matrix(int format, int ic, const uint8_t* w, const uint8_t* z, const uint16_t* s) {
+    QuantMatrix m;
+    m.w = w; m.z = z; m.s = s;
+    m.oc = 1; m.ic = ic; m.group_size = 32;
+    m.weight_bits = 4; m.weight_signed = false; m.has_zp = (z != nullptr); m.zp_is_u8 = true;
+    m.format = format;
+    return m;
+}
