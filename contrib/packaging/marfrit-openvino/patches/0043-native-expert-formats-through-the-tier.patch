+}
+
+ov::pass::pattern::op::NativeIq3xxsWeightsBlock::NativeIq3xxsWeightsBlock() : Block({}, {}, "NativeIq3xxsWeightsBlock") {
+    // the magnitudes
+    auto gridix = wrap_type<v0::Constant>(ov::pass::pattern::type_matches(ov::element::u8));
+    auto gridix_convert = wrap_type<v0::Convert>({gridix});
+    auto grid = wrap_type<v0::Constant>();
+    auto grid_axis = wrap_type<v0::Constant>();
+    auto grid_gather = wrap_type<v8::Gather>({grid, gridix_convert, grid_axis});
+    auto mag_reshape_const = wrap_type<v0::Constant>();
+    auto mag = wrap_type<v1::Reshape>({grid_gather, mag_reshape_const});
+    // the signs
+    auto signix = wrap_type<v0::Constant>(ov::pass::pattern::type_matches(ov::element::u8));
+    auto signix_convert = wrap_type<v0::Convert>({signix});
+    auto ksigns = wrap_type<v0::Constant>();
+    auto ksigns_axis = wrap_type<v0::Constant>();
+    auto ksigns_gather = wrap_type<v8::Gather>({ksigns, signix_convert, ksigns_axis});
+    auto unsq_axis = wrap_type<v0::Constant>();
+    auto unsq = wrap_type<v0::Unsqueeze>({ksigns_gather, unsq_axis});
+    auto masks = wrap_type<v0::Constant>();
+    auto bits = wrap_type<v13::BitwiseAnd>({unsq, masks});
+    auto zero = wrap_type<v0::Constant>();
+    auto neg = wrap_type<v1::Greater>({bits, zero});
+    auto minus_one = wrap_type<v0::Constant>();
+    auto plus_one = wrap_type<v0::Constant>();
+    auto select = wrap_type<v1::Select>({neg, minus_one, plus_one});
+    auto sign_reshape_const = wrap_type<v0::Constant>();
+    auto sign = wrap_type<v1::Reshape>({select, sign_reshape_const});
+    // magnitudes * signs * scale
+    auto mag_sign = wrap_type<v1::Multiply>({mag, sign});
+    auto scale = wrap_type<v0::Constant>();
+    auto scale_f32 = ov::pass::pattern::optional<v0::Convert>({scale});
+    auto mul = wrap_type<v1::Multiply>({mag_sign, scale_f32});
+    auto reshape_const = wrap_type<v0::Constant>();
+    auto reshape = wrap_type<v1::Reshape>({mul, reshape_const});
+    auto weights_input = ov::pass::pattern::optional<v0::Convert>({reshape});
+
+    m_inputs = ov::OutputVector{gridix, signix};
+    m_outputs = ov::OutputVector{weights_input};
+    REGISTER_ANCHORS(this, gridix, grid, signix, ksigns, masks, scale, reshape);
+}
+
+ov::pass::pattern::op::NativeQ8WeightsBlock::NativeQ8WeightsBlock() : Block({}, {}, "NativeQ8WeightsBlock") {
+    auto codes = wrap_type<v0::Constant>(ov::pass::pattern::type_matches(ov::element::i8));
