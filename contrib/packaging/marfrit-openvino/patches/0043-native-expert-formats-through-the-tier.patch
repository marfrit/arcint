+// arcint (patch 0043, campaign sub4bit-vram-kernel). See the header.
+ConvertTiledMoeBlockNativeToMoeCompressed::ConvertTiledMoeBlockNativeToMoeCompressed(bool has_batch_dim) {
+    MATCHER_SCOPE(ConvertTiledMoeBlockNativeToMoeCompressed);
+    using ov::op::internal::MOECompressed;
+
+    auto weights = std::make_shared<std::vector<NativeWeightPattern>>();
+    auto p = build_3gemm_pattern_impl([weights]() {
+        weights->push_back(make_native_weight_pattern());
+        return weights->back().either;
+    });
+    OPENVINO_ASSERT(weights->size() == 3, "the 3-GEMM tiled pattern creates exactly three expert weight patterns");
+
+    matcher_pass_callback callback = [=](pattern::Matcher& m) {
+        auto& pm = m.get_pattern_value_map();
+        if (transformation_callback(m.get_match_root())) {
+            return false;
+        }
+
+        struct Resolved {
+            size_t format = 0;
+            ov::Output<ov::Node> weight, scale, zp;
+        };
+        auto resolve = [&](const NativeWeightPattern& w, Resolved& r) -> bool {
+            if (auto codes = w.iq4nl->get_anchor("codes", pm)) {
+                r.format = MOECompressed::kWeightFormatIq4Nl;
+                r.weight = codes.value();
+                r.scale = w.iq4nl->get_anchor("scale", pm).value();
+                // IQ4_NL has no zero-point: the scale Constant fills the slot
+                // (the op's has_zp is per op; the kernels never read it for
+                // this format; the offload path copies a few extra bytes)
+                r.zp = r.scale;
+                return true;
+            }
+            if (auto gridix = w.iq3xxs->get_anchor("gridix", pm)) {
+                r.format = MOECompressed::kWeightFormatIq3Xxs;
+                r.weight = gridix.value();
+                r.scale = w.iq3xxs->get_anchor("scale", pm).value();
+                r.zp = w.iq3xxs->get_anchor("signix", pm).value();
+                return true;
+            }
+            if (auto codes = w.q8->get_anchor("codes", pm)) {
+                r.format = MOECompressed::kWeightFormatQ8_0;
+                r.weight = codes.value();
+                r.scale = w.q8->get_anchor("scale", pm).value();
+                r.zp = r.scale;  // no zero-point, as IQ4_NL
+                return true;
+            }
+            return false;
+        };
+        Resolved gate, up, down;
+        if (!resolve((*weights)[0], gate) || !resolve((*weights)[1], up) || !resolve((*weights)[2], down)) {
+            return false;
+        }
+        if (gate.format != up.format) {
+            return false;  // one format per projection pair, as the config carries it
+        }
+        for (const Resolved* r : {&gate, &up, &down}) {
+            if (!ov::as_type_ptr<v0::Constant>(r->weight.get_node_shared_ptr()) ||
+                !ov::as_type_ptr<v0::Constant>(r->scale.get_node_shared_ptr()) ||
+                !ov::as_type_ptr<v0::Constant>(r->zp.get_node_shared_ptr())) {
+                return false;
+            }
+        }
+
+        const auto& hidden_states = pm.at(p.experts_input);
+        const auto& routing = pm.at(p.chosen_experts);
+        const auto& topk_indices = pm.at(p.router_topk_indices);
+
+        float expert_beta = 1.0f;
+        auto activation_type = ov::op::internal::MOE::Activation_type::SWIGLU;
+        const auto activation_node = pm.at(p.swish).get_node_shared_ptr();
+        if (auto swish_op = ov::as_type_ptr<v4::Swish>(activation_node)) {
+            if (swish_op->get_input_size() > 1) {
+                if (auto beta_const = ov::as_type_ptr<v0::Constant>(swish_op->get_input_node_shared_ptr(1))) {
+                    expert_beta = beta_const->cast_vector<float>()[0];
+                }
+            }
+        } else if (auto gelu_op = ov::as_type_ptr<v7::Gelu>(activation_node)) {
+            if (gelu_op->get_approximation_mode() == ov::op::GeluApproximationMode::TANH) {
+                activation_type = ov::op::internal::MOE::Activation_type::GEGLU_TANH;
+            } else if (gelu_op->get_approximation_mode() == ov::op::GeluApproximationMode::ERF) {
+                activation_type = ov::op::internal::MOE::Activation_type::GEGLU_ERF;
+            } else {
+                return false;
+            }
+        } else {
+            return false;
+        }
+
+        const auto gate_shape = gate.weight.get_partial_shape();
+        const auto down_shape = down.weight.get_partial_shape();
+        if (!gate_shape.is_static() || !down_shape.is_static() || gate_shape.size() != 4 || down_shape.size() != 4) {
+            return false;
+        }
+        const auto topk_shape = topk_indices.get_partial_shape();
+        if (topk_shape.rank().is_dynamic() || topk_shape.size() < 2 || !topk_shape[1].is_static()) {
+            return false;
+        }
+        // a native weight holds one 32-value block per group row (2.3c)
+        const size_t hidden_size = static_cast<size_t>(gate_shape[2].get_length()) * 32;
+        const size_t inter_size = static_cast<size_t>(gate_shape[1].get_length());
+        const size_t num_expert = static_cast<size_t>(gate_shape[0].get_length());
+
+        MOECompressed::Config config{
+            {ov::op::internal::MOE::Expert_type::GEMM3_SWIGLU, 0.0f, expert_beta, 0, activation_type},
+            hidden_size,
+            inter_size,
+            num_expert,
+            0,  // num_shared_expert
+            static_cast<size_t>(topk_shape[1].get_length()),
+            32,  // group_size: one block per group row
+            has_batch_dim,
