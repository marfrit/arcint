+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+// arcint (patch 0043, campaign sub4bit-vram-kernel). Pattern blocks for the
+// two NATIVE expert weight formats of the Flash-Next checkpoint, as the
+// serving-shape emitter writes them (tools/q4e/serving_shape.py
+// _native_expert): the checkpoint's own IQ4_NL / IQ3_XXS blocks re-laid per
+// role and decoded in standard ops. The blocks expose the per-role Constants
+// as anchors so the native MoE lowering can hand them to MOECompressed as
+// they are (design-routing-aware-expert-execution 2.3b/2.3c).
+
+#pragma once
+
+#include "openvino/pass/matcher_pass.hpp"
+#include "openvino/pass/pattern/op/block.hpp"
+#include "transformations_visibility.hpp"
+
+namespace ov::pass::pattern::op {
+
+class TRANSFORMATIONS_API NativeIq4nlWeightsBlock;
+class TRANSFORMATIONS_API NativeIq3xxsWeightsBlock;
+class TRANSFORMATIONS_API NativeQ8WeightsBlock;
+
+}  // namespace ov::pass::pattern::op
+
+/// IQ4_NL: codes u4 [E, out, K/32, 32] -> Convert(i32) -> Gather(table f32 [16], ., axis)
+///         -> Multiply(scale f32 [E, out, K/32, 1]) -> Reshape [E, out, K] -> optional Convert
+/// anchors: codes, table, scale, reshape
+class ov::pass::pattern::op::NativeIq4nlWeightsBlock : public ov::pass::pattern::op::Block {
+public:
+    NativeIq4nlWeightsBlock();
+};
+
+/// IQ3_XXS: magnitudes = Reshape(Gather(grid f32 [256, 4], Convert(gridix u8 [E, out, K/32, 8]), axis))
+///          signs = Reshape(Select(Greater(BitwiseAnd(Unsqueeze(Gather(ksigns i32 [128],
+///                  Convert(signix u8 [E, out, K/32, 4]), axis), axis), masks i32 [8]), 0), -1, +1))
+///          Multiply(Multiply(magnitudes, signs), scale f32 [E, out, K/32, 1]) -> Reshape [E, out, K]
+///          -> optional Convert
+/// anchors: gridix, grid, signix, ksigns, masks, scale, reshape
+class ov::pass::pattern::op::NativeIq3xxsWeightsBlock : public ov::pass::pattern::op::Block {
+public:
+    NativeIq3xxsWeightsBlock();
+};
+
+// Q8_0: i8 codes [E, out, K/32, 32] -> Convert -> Multiply(optional
+// Convert(f16 scale [E, out, K/32, 1])) -> Reshape [E, out, K] -> optional
+// Convert. Every block's scale is an f16 Constant behind an optional Convert
+// (the emitter keeps the decode arithmetic in f32).
+class ov::pass::pattern::op::NativeQ8WeightsBlock : public ov::pass::pattern::op::Block {
+public:
+    NativeQ8WeightsBlock();
+};
