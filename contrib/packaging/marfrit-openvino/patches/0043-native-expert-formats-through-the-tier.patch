+// arcint (patch 0043). Row n of a native-format matrix, decoded to f32 with
+// the block scale folded in: ic values into `out`. The layouts are the
+// per-role tensors of design-routing-aware-expert-execution 2.3c, one
+// 32-value block per group row: IQ4_NL codes u4 [oc, ic/32, 32] in linear
+// element order (even index low nibble, as the u4 packing everywhere here);
+// IQ3_XXS grid indices u8 [oc, ic/32, 8] (4 values each) and sign-mask
+// indices u8 [oc, ic/32, 4] (8 signs each); scales f32 [oc, ic/32].
+inline void decode_native_row(const QuantMatrix& m, int n, float* out) {
+    const int groups = m.ic / 32;
+    const uint16_t* s = m.s + static_cast<size_t>(n) * static_cast<size_t>(groups);   // f16 per 32
+    if (m.format == kQuantFormatIq4Nl) {
+        const uint8_t* row = m.w + static_cast<size_t>(n) * (static_cast<size_t>(m.ic) / 2u);
+        for (int g = 0; g < groups; g++) {
+            const float d = f16_to_f32(s[g]);
+            for (int j = 0; j < 32; j++) {
+                const int k = g * 32 + j;
+                const uint8_t byte = row[k >> 1];
+                const int code = (k & 1) ? (byte >> 4) : (byte & 0x0F);
+                out[k] = d * static_cast<float>(kIq4NlValues[code]);
+            }
+        }
+        return;
+    }
+    if (m.format == kQuantFormatQ8_0) {
+        const int8_t* row = reinterpret_cast<const int8_t*>(m.w) + static_cast<size_t>(n) * static_cast<size_t>(m.ic);
+        for (int g = 0; g < groups; g++) {
+            const float d = f16_to_f32(s[g]);
+            for (int j = 0; j < 32; j++) {
+                out[g * 32 + j] = d * static_cast<float>(row[g * 32 + j]);
+            }
+        }
+        return;
+    }
+    // IQ3_XXS
+    const uint8_t* gridix = m.w + static_cast<size_t>(n) * static_cast<size_t>(groups) * 8u;
+    const uint8_t* signix = m.z + static_cast<size_t>(n) * static_cast<size_t>(groups) * 4u;
+    for (int g = 0; g < groups; g++) {
+        const float d = f16_to_f32(s[g]);
+        for (int l = 0; l < 4; l++) {                 // 8 values per sign index
+            const uint8_t signs = kIq2xsSigns[signix[g * 4 + l] & 127];
+            uint8_t g1[4], g2[4];
+            std::memcpy(g1, &kIq3xxsGrid[gridix[g * 8 + 2 * l + 0]], 4);
+            std::memcpy(g2, &kIq3xxsGrid[gridix[g * 8 + 2 * l + 1]], 4);
