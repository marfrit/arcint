# IQ2_S-packed gate/up on the matrix unit (Xe-HPG, subgroup 8), for every
# call size. The B operand is (2s+1)*grid*sign, exact in f16, and d/8 scales
# each 256-value chain once, so every product the unit forms is exact. A tile
# of up to 16 pairs of one expert per work-group, the activations gathered
# into local memory in the unit's A layout; a call under 64 pairs runs one
# pair per work-group with K split across subgroups, in the same chain
# order, so a pair's bytes do not depend on its call (measured). Down keeps
# the scalar kernels. MOE_NATIVE_GU=scalar restores 0061's gate/up.
#
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe_expert_swiglu.cl
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe_expert_swiglu.cl
@@ -1471,6 +1471,550 @@
             if (r < nr && t < cnt) out[r][t] = sub_group_reduce_add(acc[r][t]);
 }
 #endif  // NATIVE_DOWN_TILE_N > 1
