+// One 16-value slice (half hh of 32-value sub-block ib32) of a lane's IQ2_S
+// block, as the B column of a matrix multiply: (2s + 1) * grid * sign, an
+// integer of magnitude at most 31 * 43 = 1,333, exact in f16. The block's
+// d / 8 is applied by the caller once per 256 values, so every product the
+// matrix unit forms is exact.
+inline int8 native_iq2s_packed_b16(const __global uchar* blk, int ib32, int hh) {
+    const uchar sc = blk[72 + ib32];
+    const half2 k2 = (half2)(convert_half(2 * (hh ? (sc >> 4) : (sc & 0x0F)) + 1));
+    const uchar qh = blk[64 + ib32];
+    uint p[8];
+    __attribute__((opencl_unroll_hint))
+    for (int ll = 0; ll < 2; ll++) {
+        const int l = hh * 2 + ll;
+        const uint gi = (uint)blk[ib32 * 4 + l] | (((uint)(qh >> (2 * l)) & 3u) << 8);
+        const uint4 gq = vload4(gi, NATIVE_IQ2S_GRID_H2);
+        const uint sgn = blk[32 + ib32 * 4 + l];
+        const uint g4[4] = {gq.s0, gq.s1, gq.s2, gq.s3};
+        __attribute__((opencl_unroll_hint))
+        for (int m2 = 0; m2 < 4; m2++) {
+            const uint mask = (((sgn >> (2 * m2)) & 1u) << 15) | (((sgn >> (2 * m2 + 1)) & 1u) << 31);
