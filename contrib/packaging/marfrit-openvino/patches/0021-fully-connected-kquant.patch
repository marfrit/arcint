+// arcint (patch 0021): the ov op arcint builds for a GGUF K-quant projection --
+// "FullyConnectedKQuant" in "arcint_opset", inputs (activation, weights u8 [N, row_bytes],
+// optional bias), runtime info "arcint_kquant_type" (ggml type id) and "arcint_kquant_k" (the
+// logical K). The op class lives in arcint (it implements shape inference there); this plugin
+// only knows its type name and reads the rt_info, so no class crosses the library boundary.
+#include "intel_gpu/plugin/program_builder.hpp"
+#include "intel_gpu/plugin/common_utils.hpp"
+#include "intel_gpu/primitives/fully_connected.hpp"
+#include "openvino/core/type.hpp"
+
+namespace ov::op::internal {
+struct FullyConnectedKQuant {
+    static const ov::DiscreteTypeInfo& get_type_info_static() {
+        static const ov::DiscreteTypeInfo info("FullyConnectedKQuant", "arcint_opset");
+        return info;
+    }
+};
+}  // namespace ov::op::internal
+
+namespace ov::intel_gpu {
+
+static size_t kquant_row_bytes(int64_t t, int64_t k) {
+    switch (t) {
+        case 8:  return k % 32 ? 0 : (k / 32) * 34;
+        case 12: return k % 256 ? 0 : (k / 256) * 144;
+        case 13: return k % 256 ? 0 : (k / 256) * 176;
+        case 14: return k % 256 ? 0 : (k / 256) * 210;
+        default: return 0;
+    }
+}
+
+static void CreateFullyConnectedKQuantOp(ProgramBuilder& p, const std::shared_ptr<ov::Node>& op) {
+    validate_inputs_count(op, {2, 3});
+    auto inputs = p.GetInputInfo(op);
+    const auto& rt = op->get_rt_info();
+    auto get_i64 = [&](const char* key) {
+        auto it = rt.find(key);
+        OPENVINO_ASSERT(it != rt.end(), "[GPU] FullyConnectedKQuant '", op->get_friendly_name(), "' lacks rt_info ", key);
+        return it->second.as<int64_t>();
+    };
+    const int64_t type = get_i64("arcint_kquant_type");
+    const int64_t k = get_i64("arcint_kquant_k");
+    const size_t row_bytes = kquant_row_bytes(type, k);
+    OPENVINO_ASSERT(row_bytes != 0, "[GPU] FullyConnectedKQuant '", op->get_friendly_name(),
+                    "': unsupported ggml type ", type, " or K ", k, " (Q8_0 needs K % 32 == 0, K-quants K % 256 == 0)");
+    const auto wshape = op->get_input_partial_shape(1);
+    OPENVINO_ASSERT(op->get_input_element_type(1) == ov::element::u8 && wshape.is_static() && wshape.size() == 2 &&
+                    static_cast<size_t>(wshape[1].get_length()) == row_bytes,
+                    "[GPU] FullyConnectedKQuant '", op->get_friendly_name(), "': weights must be u8 [N, ", row_bytes, "], got ",
+                    op->get_input_element_type(1), " ", wshape);
+    const std::string bias = inputs.size() > 2 ? inputs[2].pid : "";
+    auto fc = cldnn::fully_connected(layer_type_name_ID(op),
+                                     inputs[0],
+                                     inputs[1].pid,
+                                     bias,
+                                     cldnn::element_type_to_data_type(op->get_output_element_type(0)),
+                                     op->get_input_partial_shape(0).size(),
+                                     2,
+                                     true);
+    fc.kquant_type = static_cast<uint8_t>(type);
+    fc.kquant_k = static_cast<size_t>(k);
+    fc.kquant_n = static_cast<size_t>(wshape[0].get_length());
+    p.add_primitive(*op, fc);
+}
+
+void __register_FullyConnectedKQuant_internal();
+void __register_FullyConnectedKQuant_internal() {
+    ProgramBuilder::RegisterFactory<ov::op::internal::FullyConnectedKQuant>(CreateFullyConnectedKQuantOp);
+}
+
+}  // namespace ov::intel_gpu
