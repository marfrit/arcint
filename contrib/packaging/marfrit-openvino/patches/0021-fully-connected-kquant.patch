+TEST_P(fully_connected_gpu_kquant, matches_the_host_dequantized_reference) {
+    const int t = std::get<0>(GetParam());
+    const long m = std::get<1>(GetParam());
+    const bool three_d = std::get<2>(GetParam());
+    tests::random_generator rg(GET_SUITE_NAME);
+    auto& engine = get_test_engine();
+
+    const size_t K = std::get<3>(GetParam()), N = std::get<4>(GetParam());
+    const size_t rb = kq_host::row_bytes(t, K);
+    auto wbytes = kq_host::random_rows(rg, t, N, K);
+    std::vector<float> wf(N * K);
+    for (size_t r = 0; r < N; ++r) kq_host::dequant_row(t, wbytes.data() + r * rb, K, wf.data() + r * K);
+
+    auto xh = rg.generate_random_1d<ov::float16>(static_cast<size_t>(m) * K, -2.0f, 2.0f);
+    std::vector<float> xf(xh.begin(), xh.end());
+
+    // Reference: plain f32 matmul on the host over the dequantized weights.
+    std::vector<float> ref(static_cast<size_t>(m) * N, 0.f), refmag(ref.size(), 0.f);
+    for (long i = 0; i < m; ++i)
+        for (size_t n = 0; n < N; ++n) {
+            double acc = 0, mag = 0;
+            for (size_t k = 0; k < K; ++k) {
+                const double p = static_cast<double>(xf[i * K + k]) * wf[n * K + k];
+                acc += p; mag += std::fabs(p);
+            }
+            ref[i * N + n] = static_cast<float>(acc);
+            refmag[i * N + n] = static_cast<float>(mag);
+        }
+
+    const ov::PartialShape in_shape = three_d ? ov::PartialShape{1, m, static_cast<long>(K)} : ov::PartialShape{m, static_cast<long>(K)};
+    auto input_mem = engine.allocate_memory({ in_shape, data_types::f16, format::bfyx });
+    set_values(input_mem, xh);
+    auto weights_mem = engine.allocate_memory({ { static_cast<long>(N), static_cast<long>(rb) }, data_types::u8, format::bfyx });
+    set_values(weights_mem, wbytes);
+
+    auto fc = fully_connected("fc_kq", input_info("input"), "weights", "", data_types::f32, three_d ? 3 : 2, 2, true);
+    fc.kquant_type = static_cast<uint8_t>(t);
+    fc.kquant_k = K;
+    fc.kquant_n = N;
+    const ov::PartialShape dyn_shape = three_d ? ov::PartialShape{1, -1, static_cast<long>(K)} : ov::PartialShape{-1, static_cast<long>(K)};
+    topology topology(input_layout("input", layout{ dyn_shape, data_types::f16, format::bfyx }), data("weights", weights_mem), fc);
+    auto config = get_test_default_config(engine);
+    config.set_property(ov::intel_gpu::allow_new_shape_infer(true));
+    config.set_property(ov::intel_gpu::optimize_data(true));
+    network net(engine, topology, config);
+    net.set_input_data("input", input_mem);
+    auto outputs = net.execute();
+    ASSERT_EQ(outputs.size(), size_t(1));
+    auto out_mem = outputs.begin()->second.get_memory();
+    cldnn::mem_lock<float> out(out_mem, get_test_stream());
+    ASSERT_EQ(out.size(), ref.size());
+    for (size_t i = 0; i < ref.size(); ++i) {
+        // f32 accumulation in a different order; the tiled variant (M > 1) multiplies f16 copies
+        // of the decoded weights, each within 2^-11 relative.
+        const float tol = 2e-3f * (1.0f + std::fabs(ref[i])) + (m > 1 ? 4.9e-4f * refmag[i] : 0.f);
+        ASSERT_NEAR(out[i], ref[i], tol) << "type " << t << " m " << m << " i " << i;
+    }
+}
