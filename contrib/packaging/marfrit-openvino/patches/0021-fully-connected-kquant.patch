@@ -0,0 +1,186 @@
+// arcint (patch 0021): see fully_connected_kernel_kquant.h.
+#include "fully_connected_kernel_kquant.h"
+#include "kernel_selector_utils.h"
+
+namespace kernel_selector {
+
+static constexpr size_t kSimd = 16;
+// Two variants of the one kernel source, chosen at dispatch by the activation's row count.
+// Kernel 0 carries one row (decode): the weights are the whole stream, read once, and K is
+// split over kKSplitGemv subgroups of a work-group so enough are in flight to cover the load
+// latency. Kernel 1 carries kTileMGemm rows (prefill): the weights are read once per tile and
+// the row tiles supply the parallelism. The tile is bounded by the register file (the decoded
+// sub-block, the activations and four partial sums per row all live in registers).
+static constexpr size_t kTileMGemm = 32;
+static constexpr size_t kKSplitGemv = 4;   // subgroups per work-group splitting K (decode)
+static constexpr size_t kColumnGroups = 8; // subgroups per work-group sharing the staged activation tile (prefill)
+
+static size_t tile_m_of(int kernel_number) { return kernel_number == 0 ? 1 : kTileMGemm; }
+static size_t wg_of(int kernel_number) { return kernel_number == 0 ? kKSplitGemv : kColumnGroups; }
+// The tiled kernel's subgroup is the matrix multiply's N: 16 on Xe2 and later, 8 before.
+static size_t simd_of(const fully_connected_params& params, int kernel_number) {
+    return (kernel_number == 0 || params.engineInfo.arch >= gpu_arch::xe2) ? kSimd : 8;
+}
+
+// Rows of the activation: flattened [M, K] (batch) or [B, M, K] (batch x feature).
+static size_t rows_of(const fully_connected_params& params) {
+    const auto& out = params.outputs[0];
+    size_t rows = out.Batch().v;
+    if (out.GetLayout() == DataLayout::bfyx)
+        rows = out.Batch().v * out.Feature().v;
+    return rows == 0 ? 1 : rows;  // shape-agnostic compile; the real figure comes at dispatch
+}
+
+size_t FullyConnected_kquant::RowBytes(uint8_t t, size_t k) {
+    switch (t) {
+        case 8:  return k % 32 ? 0 : (k / 32) * 34;     // Q8_0
+        case 12: return k % 256 ? 0 : (k / 256) * 144;  // Q4_K
+        case 13: return k % 256 ? 0 : (k / 256) * 176;  // Q5_K
+        case 14: return k % 256 ? 0 : (k / 256) * 210;  // Q6_K
+        default: return 0;
+    }
+}
+
+ParamsKey FullyConnected_kquant::GetSupportedKey() const {
+    ParamsKey k;
+    k.EnableInputDataType(Datatype::F16);
+    k.EnableOutputDataType(Datatype::F16);
+    k.EnableOutputDataType(Datatype::F32);
+    k.EnableInputWeightsType(WeightsType::UINT8);
+    k.EnableInputLayout(DataLayout::bf);
+    k.EnableInputLayout(DataLayout::bfyx);
+    k.EnableOutputLayout(DataLayout::bf);
+    k.EnableOutputLayout(DataLayout::bfyx);
+    k.EnableBiasPerOutput();
+    k.EnableBiasPerFeature();
+    k.EnableNonBiasTerm();
+    k.EnableTensorOffset();
+    k.EnableTensorPitches();
+    k.EnableDifferentInputWeightsTypes();
+    k.EnableDifferentTypes();
+    k.EnableDynamicShapesSupport();
+    k.EnableBatching();
+    return k;
+}
+
+DeviceFeaturesKey FullyConnected_kquant::get_required_device_features_key(const Params& params) const {
+    auto k = get_common_subgroups_device_features_key(params);
+    k.requires_blocked_read_write_short();  // block reads of the activation rows
+    return k;
+}
+
+bool FullyConnected_kquant::Validate(const Params& params) const {
+    if (!Parent::Validate(params))
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    const auto& fc = static_cast<const fully_connected_params&>(params);
+    const auto& input = fc.inputs[0];
+    const auto& weights = fc.weights;
+    if (fc.kquant_type == 0 || fc.compressed)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (!params.engineInfo.supports_immad)  // the tiled variant is a subgroup matrix multiply
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (weights.GetDType() != WeightsType::UINT8)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    const size_t row_bytes = RowBytes(fc.kquant_type, fc.kquant_k);
+    if (row_bytes == 0 || fc.kquant_n == 0 || weights.OFM().v != fc.kquant_n || weights.IFM().v != row_bytes)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    // The kernel walks K with a pitch of one from the row's first element.
+    if (input.GetLayout() == DataLayout::bfyx) {
+        if (input.X().pad.Total() != 0 || input.Y().pad.Total() != 0)
+            DO_NOT_USE_THIS_KERNEL(params.layerID);
+    } else if (input.Feature().pad.Total() != 0) {
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    }
+    // 4-D outputs are not handled (same rule as bf_tiled).
+    if (fc.outputs[0].GetLayout() == DataLayout::bfyx && input.X().v > 1)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    return true;
+}
+
+FullyConnected_kquant::DispatchData FullyConnected_kquant::SetDefault(const fully_connected_params& params, int, int kernel_number) const {
+    DispatchData d;
+    d.tile_m = static_cast<uint32_t>(tile_m_of(kernel_number));
+    d.tile_n = static_cast<uint32_t>(wg_of(kernel_number));  // subgroups per work-group, not a column tile
+    d.tile_mk = static_cast<uint32_t>(simd_of(params, kernel_number));  // the subgroup size
+    const size_t n = params.kquant_n;
+    const size_t rows = rows_of(params);
+    // A lane per output column, a work-group of ksplit subgroups per subgroup of columns, a
+    // work-group per tile of rows.
+    if (kernel_number == 0)
+        d.gws = { Align(n, d.tile_mk), d.tile_n, CeilDiv(rows, d.tile_m) };
+    else
+        d.gws = { CeilDiv(n, d.tile_mk * d.tile_n) * d.tile_mk, d.tile_n, CeilDiv(rows, d.tile_m) };
+    d.lws = { d.tile_mk, d.tile_n, 1 };
+    return d;
+}
+
+KernelsPriority FullyConnected_kquant::GetKernelsPriority(const Params&) const {
+    return FORCE_PRIORITY_1;  // the only kernel that reads this weight format
+}
+
+JitConstants FullyConnected_kquant::GetJitConstants(const fully_connected_params& params, const DispatchData& dispatchData) const {
+    JitConstants jit = Parent::GetJitConstants(params, dispatchData);
+    const size_t row_bytes = RowBytes(params.kquant_type, params.kquant_k);
+    jit.AddConstant(MakeJitConstant("KQ_TYPE", static_cast<size_t>(params.kquant_type)));
+    jit.AddConstant(MakeJitConstant("KQ_K", params.kquant_k));
+    jit.AddConstant(MakeJitConstant("KQ_N", params.kquant_n));
+    jit.AddConstant(MakeJitConstant("KQ_ROW_BYTES", row_bytes));
+    jit.AddConstant(MakeJitConstant("TILE_M", static_cast<size_t>(dispatchData.tile_m)));
+    jit.AddConstant(MakeJitConstant("KQ_WG", static_cast<size_t>(dispatchData.tile_n)));
+    jit.AddConstant(MakeJitConstant("SIMD", static_cast<size_t>(dispatchData.tile_mk)));
+    const bool out3d = params.outputs[0].GetLayout() == DataLayout::bfyx;
+    if (out3d)
+        jit.AddConstant(MakeJitConstant("OUTPUT_3D", true));
+    // f32 accumulation throughout (the reference kernel's own rule for compressed f16 inputs).
+    Datatype activation_dt = GetActivationType(params);
+    if (activation_dt == Datatype::F16)
+        activation_dt = Datatype::F32;
+    jit.Merge(MakeTypeJitConstants(activation_dt, "ACTIVATION"));
+    jit.Merge(MakeTypeJitConstants(Datatype::F32, "ACCUMULATOR"));
+    jit.Merge(MakeActivationJitConstants(params.activations, activation_dt, "_TYPED"));
+    if (!params.fused_ops.empty()) {
+        std::vector<std::string> idx_order = out3d ? std::vector<std::string>{"b", "m", "n", "0"}
+                                                   : std::vector<std::string>{"m", "n", "0", "0"};
+        FusedOpsConfiguration conf = {"", idx_order, "dequantized", activation_dt, 1};
+        jit.Merge(MakeFusedOpsJitConstants(params, {conf}));
+    }
+    return jit;
+}
+
+// Which of the two compiled kernels runs for a row count: the one-row kernel for decode, the
+// tiled one for anything wider.
+static int kernel_for(const KernelData& kd, size_t rows) {
+    return (kd.kernels.size() > 1 && rows > 1) ? 1 : 0;
+}
+
+void FullyConnected_kquant::GetUpdateDispatchDataFunc(KernelData& kd) const {
+    kd.update_dispatch_data_func = [this](const Params& params, KernelData& kd) {
+        const auto& prim_params = static_cast<const fully_connected_params&>(params);
+        const int execute = kernel_for(kd, rows_of(prim_params));
+        for (size_t i = 0; i < kd.kernels.size(); ++i)
+            kd.kernels[i].skip_execution = static_cast<int>(i) != execute;
+        const auto dispatchData = SetDefault(prim_params, -1, execute);
+        kd.kernels[execute].params.workGroups.global = dispatchData.gws;
+        kd.kernels[execute].params.workGroups.local = dispatchData.lws;
+        kd.kernels[execute].skip_execution = KernelData::SkipKernelExecution(prim_params);
+    };
+}
+
+KernelsData FullyConnected_kquant::GetKernelsData(const Params& params) const {
+    const auto& fc = static_cast<const fully_connected_params&>(params);
+    // The weights' own layout is requested, so CheckWeights finds nothing to reorder.
+    KernelsData kds = GetCommonKernelsData(params, fc.inputs[0].GetLayout(), fc.weights.GetLayout(), EXE_MODE_DEFAULT, -1, 0);
+    if (kds.empty() || kds[0].kernels.empty())
+        return kds;
+    KernelsData tiled = GetCommonKernelsData(params, fc.inputs[0].GetLayout(), fc.weights.GetLayout(), EXE_MODE_DEFAULT, -1, 1);
+    if (!tiled.empty() && !tiled[0].kernels.empty())
+        kds[0].kernels.push_back(tiled[0].kernels.back());
+    GetUpdateDispatchDataFunc(kds[0]);
+    // A static shape dispatches without the update: pick the kernel here.
+    const int execute = kernel_for(kds[0], rows_of(fc));
+    for (size_t i = 0; i < kds[0].kernels.size(); ++i)
+        kds[0].kernels[i].skip_execution = static_cast<int>(i) != execute;
+    return kds;
+}
+
+}  // namespace kernel_selector
