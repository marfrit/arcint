+// arcint (patch 0021): fully connected over GGUF K-quant weights (Q4_K, Q5_K, Q6_K, Q8_0)
+// served as stored -- the weights memory is the file's bytes, u8 [N, row_bytes], decoded in
+// the kernel's inner loop. No unpack at load, no reorder at compile (the kernel asks for the
+// weights' own layout). Design: arcint docs/design-gguf-native.md §3.3.
+#pragma once
+
+#include "fully_connected_kernel_base.h"
+
+namespace kernel_selector {
+
+class FullyConnected_kquant : public FullyConnectedKernelBase {
+public:
+    using Parent = FullyConnectedKernelBase;
+    FullyConnected_kquant() : Parent("fully_connected_gpu_kquant") {}
+
+    using FullyConnectedKernelBase::GetTunedKernelsDataByIndex;
+    KernelsData GetKernelsData(const Params& params) const override;
+    KernelsPriority GetKernelsPriority(const Params& params) const override;
+    ParamsKey GetSupportedKey() const override;
+    DeviceFeaturesKey get_required_device_features_key(const Params& params) const override;
+
+    // Bytes one output row occupies for a ggml type id and a contraction size K; 0 = unsupported.
+    static size_t RowBytes(uint8_t kquant_type, size_t k);
+
+protected:
+    DispatchData SetDefault(const fully_connected_params& params, int autoTuneIndex = -1, int kernel_number = 0) const override;
+    std::vector<FusedOpType> GetSupportedFusedOps() const override { return {FusedOpType::ACTIVATION, FusedOpType::ELTWISE}; }
+    bool Validate(const Params& params) const override;
+    bool SupportsKQuant() const override { return true; }
+    JitConstants GetJitConstants(const fully_connected_params& params, const DispatchData& dispatchData) const override;
+    void GetUpdateDispatchDataFunc(KernelData& kd) const override;
+};
+
+}  // namespace kernel_selector
