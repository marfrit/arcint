+// arcint (patch 0021): fully connected over GGUF K-quant weights, decoded in the inner loop.
+// One LANE per output column: each lane walks its own row's super-blocks along K and decodes
+// one 32-value sub-block at a time into registers. Weights stay in their file layout
+// (KQ_ROW_BYTES per row); nothing is unpacked outside this kernel.
+//
+// Two variants are compiled from this source and chosen at dispatch by the row count (host
+// side):
+//   TILE_M == 1 (decode): the weights are the whole stream. Each lane multiplies its decoded
+//   sub-block with the one activation row -- the same address in every lane, one broadcast
+//   read per subgroup -- and K is split over the KQ_WG subgroups of a work-group (reduced
+//   through local memory) so enough subgroups are in flight to cover the load latency.
+//   TILE_M > 1 (prefill): the decoded sub-block, converted to f16, is this lane's column of
+//   the B operand of the subgroup matrix multiply (XMX, cl_intel_subgroup_matrix_multiply_
+//   accumulate); the activation rows are the A operand. A work-group of KQ_WG subgroups
+//   (KQ_WG x SIMD columns) stages each super-block's activation tile (TILE_M rows x 256 k)
+//   in local memory once and every subgroup reads its A operands from there: reading them
+//   from global memory per subgroup re-read the tile once per 16 columns and ran at a
+//   fraction of the matrix unit (measured, 30x). The weights are read and decoded once per
+//   TILE_M rows.
+//
+// Every loop over the tile has a compile-time bound and every private array a constant index
+// after unrolling: rows and columns past the end are clamped to the last one and their
+// results dropped, rather than bounded at run time. A run-time bound sends the accumulators
+// to scratch memory (the compiled kernel reports private_size > 0), measured as a 10x loss.
+#include "include/batch_headers/fetch_data.cl"
+#include "include/batch_headers/kquant_utils.cl"
+
+#if KQ_TYPE == 8
+#  define KQ_BLOCK 32
+#  define KQ_BLOCK_BYTES 34
+#  define KQ_SUBS 1
+#  define KQ_DECODE(blk, s, y) kq_dec_q8_0(blk, y)
+#elif KQ_TYPE == 12
+#  define KQ_BLOCK 256
+#  define KQ_BLOCK_BYTES 144
+#  define KQ_SUBS 8
+#  define KQ_DECODE(blk, s, y) kq_dec_q4_K_sub(blk, s, y)
+#elif KQ_TYPE == 13
+#  define KQ_BLOCK 256
+#  define KQ_BLOCK_BYTES 176
+#  define KQ_SUBS 8
+#  define KQ_DECODE(blk, s, y) kq_dec_q5_K_sub(blk, s, y)
+#elif KQ_TYPE == 14
+#  define KQ_BLOCK 256
+#  define KQ_BLOCK_BYTES 210
+#  define KQ_SUBS 8
+#  define KQ_DECODE(blk, s, y) kq_dec_q6_K_sub(blk, s, y)
+#else
+#  error "fully_connected_gpu_kquant.cl: unsupported KQ_TYPE"
+#endif
+
+#define KQ_BLOCKS (KQ_K / KQ_BLOCK)
+
+#if TILE_M > 1
+// A operand of the f16 matrix multiply, one 8 x 16 tile of activation rows: with 16 lanes a
+// lane holds one k per row (short), with 8 lanes two consecutive k (int).
+#  if SIMD == 16
+#    define KQ_A_T short8
+#    define KQ_A_ELEM short
+#  elif SIMD == 8
+#    define KQ_A_T int8
+#    define KQ_A_ELEM int
+#  else
+#    error "fully_connected_gpu_kquant.cl: the matrix multiply takes a subgroup of 8 or 16"
+#  endif
+#  define KQ_GROUPS (TILE_M / 8)
+// The staged activation tile: TILE_M rows of one super-block (KQ_BLOCK halves), 16 bytes per
+// work-item per pass.
+#  define KQ_TILE_BYTES (TILE_M * KQ_BLOCK * 2)
+#  define KQ_WG_ITEMS (SIMD * KQ_WG)
+#  define KQ_TILE_PASSES (KQ_TILE_BYTES / (16 * KQ_WG_ITEMS))
+#  if KQ_TILE_PASSES * 16 * KQ_WG_ITEMS != KQ_TILE_BYTES
+#    error "fully_connected_gpu_kquant.cl: the activation tile is not a whole number of passes"
+#  endif
+#endif
+
+REQD_SUB_GROUP_SIZE(SIMD)
+__attribute__((reqd_work_group_size(SIMD, KQ_WG, 1)))
+KERNEL(fully_connected_gpu_kquant)(
+    OPTIONAL_SHAPE_INFO_ARG
+    const __global INPUT0_TYPE* input,
+    __global OUTPUT_TYPE* output,
+    const __global uchar* weights
+#if BIAS_TERM
+    , const __global BIAS_TYPE* biases
+#endif
+#if HAS_FUSED_OPS_DECLS
+    , FUSED_OPS_DECLS
+#endif
+)
+{
+    const uint lane = get_local_id(0);
+    const uint sg = get_local_id(1);
+    const uint tile = get_global_id(2);
+#if OUTPUT_3D
+    const uint rows_per_batch = INPUT0_FEATURE_NUM;
+    const uint rows = INPUT0_BATCH_NUM * rows_per_batch;
+#else
+    const uint rows = INPUT0_BATCH_NUM;
+#endif
+    const uint r0 = tile * TILE_M;
+    if (r0 >= rows)                        // uniform over the work-group
+        return;
+
+#if TILE_M == 1
+    const uint n = get_global_id(0);       // lane = output column; the work-group's subgroups split K
+    const uint nn = min(n, (uint)KQ_N - 1);
+#if OUTPUT_3D
+    const uint ibase = INPUT0_GET_INDEX(r0 / rows_per_batch, r0 % rows_per_batch, 0, 0);
+#else
+    const uint ibase = INPUT0_GET_INDEX(r0, 0, 0, 0);
+#endif
+    const __global uchar* wrow = weights + (ulong)nn * KQ_ROW_BYTES;
+    const uint kb0 = (sg * KQ_BLOCKS) / KQ_WG, kb1 = ((sg + 1) * KQ_BLOCKS) / KQ_WG;
+    float4 acc = (float4)(0.0f);
+    for (uint kb = kb0; kb < kb1; ++kb) {
+        const __global uchar* blk = wrow + kb * KQ_BLOCK_BYTES;
+        __attribute__((opencl_unroll_hint(KQ_SUBS)))
+        for (uint s = 0; s < KQ_SUBS; ++s) {
+            float y[32];
+            KQ_DECODE(blk, s, y);
+            const float16 ya = vload16(0, y);
+            const float16 yb = vload16(0, y + 16);
+            const __global INPUT0_TYPE* x = input + ibase + kb * KQ_BLOCK + s * 32;  // one address for the whole subgroup
+            const float16 fa = convert_float16(vload16(0, x));
+            const float16 fb = convert_float16(vload16(0, x + 16));
+            const float16 p = fma(fa, ya, fb * yb);
+            const float8 p8 = p.lo + p.hi;
+            acc += p8.lo + p8.hi;
+        }
+    }
+#  if KQ_WG > 1
+    __local float4 red[KQ_WG][SIMD];
+    red[sg][lane] = acc;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    if (sg != 0)
+        return;
+    for (uint j = 1; j < KQ_WG; ++j) acc += red[j][lane];
+#  endif
+    float sums[1];
+    sums[0] = (acc.s0 + acc.s1) + (acc.s2 + acc.s3);
+#else
+    const uint n = (get_group_id(0) * KQ_WG + sg) * SIMD + lane;   // lane = output column; the work-group's subgroups take KQ_WG x SIMD columns
+    const uint nn = min(n, (uint)KQ_N - 1);
+    const __global uchar* wrow = weights + (ulong)nn * KQ_ROW_BYTES;
+
+    // This work-item's share of the tile staging: 16 bytes of one row per pass.
+    const uint item = sg * SIMD + lane;
+    uint stage_src[KQ_TILE_PASSES];
+    __attribute__((opencl_unroll_hint(KQ_TILE_PASSES)))
+    for (uint p = 0; p < KQ_TILE_PASSES; ++p) {
+        const uint chunk = p * KQ_WG_ITEMS + item;            // 16-byte chunk of the tile
+        const uint t = chunk / (KQ_BLOCK * 2 / 16);           // row of the tile
+        const uint off = (chunk % (KQ_BLOCK * 2 / 16)) * 8;   // halves into the row's super-block
+        const uint r = min(r0 + t, rows - 1);
+#if OUTPUT_3D
+        stage_src[p] = INPUT0_GET_INDEX(r / rows_per_batch, r % rows_per_batch, 0, 0) + off;
+#else
+        stage_src[p] = INPUT0_GET_INDEX(r, 0, 0, 0) + off;
+#endif
+    }
+    __local ushort xt[TILE_M * KQ_BLOCK];
+
+    float8 acc[KQ_GROUPS];
+    __attribute__((opencl_unroll_hint(KQ_GROUPS)))
+    for (uint g = 0; g < KQ_GROUPS; ++g) acc[g] = (float8)(0.0f);
+
+    for (uint kb = 0; kb < KQ_BLOCKS; ++kb) {
+        // Stage this super-block's activation tile.
+        barrier(CLK_LOCAL_MEM_FENCE);                            // the previous super-block's reads are done
+        __attribute__((opencl_unroll_hint(KQ_TILE_PASSES)))
+        for (uint p = 0; p < KQ_TILE_PASSES; ++p) {
+            const uint chunk = p * KQ_WG_ITEMS + item;
+            const uint4 v = vload4(0, (const __global uint*)(input + stage_src[p] + kb * KQ_BLOCK));
+            vstore4(v, 0, (__local uint*)xt + chunk * 4);
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+
+        const __global uchar* blk = wrow + kb * KQ_BLOCK_BYTES;
+        __attribute__((opencl_unroll_hint(KQ_SUBS)))
+        for (uint s = 0; s < KQ_SUBS; ++s) {
+            float y[32];
+            KQ_DECODE(blk, s, y);
+            // This lane's column of B for k = 0..15 and 16..31 of the sub-block: 16 halves,
+            // consecutive k paired in each int.
+            const int8 b0 = as_int8(convert_half16(vload16(0, y)));
+            const int8 b1 = as_int8(convert_half16(vload16(0, y + 16)));
+            __attribute__((opencl_unroll_hint(KQ_GROUPS)))
+            for (uint g = 0; g < KQ_GROUPS; ++g) {
+                KQ_A_T a0, a1;
+                __attribute__((opencl_unroll_hint(8)))
+                for (uint t = 0; t < 8; ++t) {
+                    const __local KQ_A_ELEM* xr = (const __local KQ_A_ELEM*)(xt + (g * 8 + t) * KQ_BLOCK + s * 32);
+                    a0[t] = xr[lane];
+                    a1[t] = ((const __local KQ_A_ELEM*)(xt + (g * 8 + t) * KQ_BLOCK + s * 32 + 16))[lane];
+                }
+                acc[g] = intel_sub_group_f16_f16_matrix_mad_k16(a0, b0, acc[g]);
+                acc[g] = intel_sub_group_f16_f16_matrix_mad_k16(a1, b1, acc[g]);
+            }
+        }
+    }
+    float sums[TILE_M];
+    __attribute__((opencl_unroll_hint(KQ_GROUPS)))
+    for (uint g = 0; g < KQ_GROUPS; ++g)
+        __attribute__((opencl_unroll_hint(8)))
+        for (uint t = 0; t < 8; ++t) sums[g * 8 + t] = acc[g][t];
+#endif
+
+    if (n >= KQ_N)
+        return;
+    __attribute__((opencl_unroll_hint(TILE_M)))
+    for (uint t = 0; t < TILE_M; ++t) {
+        const uint r = r0 + t;
+        if (r >= rows) continue;
+        const float sum = sums[t];
+#if OUTPUT_3D
+        const uint b = r / rows_per_batch, m = r % rows_per_batch;
+        const uint dst_index = OUTPUT_GET_INDEX(b, m, n, 0);
+#else
+        const uint m = r;
+        const uint dst_index = OUTPUT_GET_INDEX(m, n, 0, 0);
+#endif
+#if BIAS_TERM
+        ACTIVATION_TYPE dequantized = TO_ACTIVATION_TYPE(sum) + TO_ACTIVATION_TYPE(biases[n]);
+#else
+        ACTIVATION_TYPE dequantized = TO_ACTIVATION_TYPE(sum);
+#endif
+#if HAS_FUSED_OPS
+        FUSED_OPS;
+        output[dst_index] = FUSED_OPS_RESULT;
+#else
+        output[dst_index] = TO_OUTPUT_TYPE(ACTIVATION_TYPED(dequantized, ACTIVATION_PARAMS_TYPED));
+#endif
+    }
+}
