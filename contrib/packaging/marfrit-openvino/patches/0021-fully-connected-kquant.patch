+// ------------------------------------------------------------------------------------------------
+// arcint (patch 0021): GGUF K-quant weights served as stored, decoded in the kernel.
+// Red case: with the kquant kernel absent (or declining), a fully_connected whose primitive
+// carries kquant_type has no implementation and the network fails to build; with it, the output
+// must match a plain f32 reference over the host-dequantized weights. The host decoder here is
+// ggml's formula (a copy; arcint's own reference lives in its src/core/gguf_dequant.cpp).
+namespace {
+
+struct kq_host {
+    static float f16(const uint8_t* p) { return static_cast<float>(ov::float16::from_bits(static_cast<uint16_t>(p[0] | (p[1] << 8)))); }
+    static void scale_min_k4(int j, const uint8_t* q, uint8_t& d, uint8_t& m) {
+        if (j < 4) { d = q[j] & 63; m = q[j + 4] & 63; }
+        else { d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4); m = (q[j + 4] >> 4) | ((q[j] >> 6) << 4); }
+    }
+    static size_t row_bytes(int t, size_t k) {
+        switch (t) { case 8: return k / 32 * 34; case 12: return k / 256 * 144; case 13: return k / 256 * 176; case 14: return k / 256 * 210; }
+        return 0;
+    }
+    static void dequant_row(int t, const uint8_t* row, size_t k, float* y) {
+        if (t == 8) {
+            for (size_t b = 0; b < k / 32; ++b) {
+                const uint8_t* q = row + b * 34; const float d = f16(q);
+                for (int l = 0; l < 32; ++l) y[b * 32 + l] = d * static_cast<float>(static_cast<int8_t>(q[2 + l]));
+            }
+            return;
+        }
+        for (size_t b = 0; b < k / 256; ++b) {
+            float* yb = y + b * 256;
+            if (t == 12 || t == 13) {
+                const uint8_t* q = row + b * (t == 12 ? 144 : 176);
+                const float d = f16(q), dmin = f16(q + 2);
+                const uint8_t* qh = q + 16;
+                const uint8_t* qs = t == 12 ? q + 16 : q + 48;
+                int is = 0; uint8_t u1 = 1, u2 = 2;
+                for (int j = 0; j < 256; j += 64) {
+                    uint8_t sc, m;
+                    scale_min_k4(is + 0, q + 4, sc, m); const float d1 = d * sc, m1 = dmin * m;
+                    scale_min_k4(is + 1, q + 4, sc, m); const float d2 = d * sc, m2 = dmin * m;
+                    for (int l = 0; l < 32; ++l) yb[j + l] = d1 * ((qs[l] & 0xF) + (t == 13 && (qh[l] & u1) ? 16 : 0)) - m1;
+                    for (int l = 0; l < 32; ++l) yb[j + 32 + l] = d2 * ((qs[l] >> 4) + (t == 13 && (qh[l] & u2) ? 16 : 0)) - m2;
+                    qs += 32; is += 2; u1 <<= 2; u2 <<= 2;
+                }
+            } else {  // Q6_K
+                const uint8_t* q = row + b * 210;
+                const uint8_t* ql = q; const uint8_t* qh = q + 128; const int8_t* sc = reinterpret_cast<const int8_t*>(q + 192);
+                const float d = f16(q + 208);
+                for (int n = 0; n < 256; n += 128) {
+                    for (int l = 0; l < 32; ++l) {
+                        const int is = l / 16;
+                        const int q1 = ((ql[l + 0] & 0xF) | (((qh[l] >> 0) & 3) << 4)) - 32;
+                        const int q2 = ((ql[l + 32] & 0xF) | (((qh[l] >> 2) & 3) << 4)) - 32;
+                        const int q3 = ((ql[l + 0] >> 4) | (((qh[l] >> 4) & 3) << 4)) - 32;
+                        const int q4 = ((ql[l + 32] >> 4) | (((qh[l] >> 6) & 3) << 4)) - 32;
+                        yb[n + l + 0] = d * sc[is + 0] * q1;
+                        yb[n + l + 32] = d * sc[is + 2] * q2;
+                        yb[n + l + 64] = d * sc[is + 4] * q3;
+                        yb[n + l + 96] = d * sc[is + 6] * q4;
+                    }
+                    ql += 64; qh += 32; sc += 8;
+                }
+            }
+        }
+    }
+    // Structurally valid random blocks: every byte random except the f16 scales, drawn small.
+    static std::vector<uint8_t> random_rows(tests::random_generator& rg, int t, size_t n, size_t k) {
+        const size_t rb = row_bytes(t, k);
+        std::vector<uint8_t> bytes = rg.generate_random_1d<uint8_t>(n * rb, 0, 255);
+        auto put_f16 = [&](size_t off, float v) { const uint16_t b = ov::float16(v).to_bits(); bytes[off] = b & 0xFF; bytes[off + 1] = b >> 8; };
+        for (size_t r = 0; r < n; ++r) {
+            for (size_t blk = 0; blk < rb / (t == 8 ? 34 : (t == 12 ? 144 : (t == 13 ? 176 : 210))); ++blk) {
+                const size_t base = r * rb + blk * (t == 8 ? 34 : (t == 12 ? 144 : (t == 13 ? 176 : 210)));
+                const float sd = 0.001f + 0.004f * static_cast<float>(rg.generate_random_1d<uint8_t>(1, 0, 255)[0]) / 255.f;
+                if (t == 8) put_f16(base, sd * 8);
+                else if (t == 14) put_f16(base + 208, sd * 0.25f);
+                else { put_f16(base, sd); put_f16(base + 2, sd * 0.5f); }
+            }
+        }
+        return bytes;
+    }
+};
+
+}  // namespace
