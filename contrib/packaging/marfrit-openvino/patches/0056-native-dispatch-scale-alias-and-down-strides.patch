# Per-expert dispatch: do not upload a native zero-point that aliases its
# scale (IQ4_NL, Q8_0, IQ2_S-packed) -- the raw copy undid the scale's device
# transpose; give the Q8_0 and IQ2_S down kernels their slot strides and
# IQ2_S down its decode branch.
#
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_otd_runtime.cpp
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/moe/moe_otd_runtime.cpp
@@ -409,6 +409,21 @@
             // so only the scale/zp tensors (3..8) are uploaded on this path.
             if (!include_weights && offset_pos < 3)
                 continue;
+            // arcint (patch 0056): a native format whose zero-point slot
+            // ALIASES its scale (IQ4_NL, Q8_0, IQ2_S-packed: the matcher sets
+            // zp = scale, and the constant cache gives both inputs ONE
+            // memory) must not upload the zp: offsets 3..5 wrote the scale
+            // device-transposed, and the zp's raw [oc, groups] copy into the
+            // same bytes undid it -- the per-expert kernels then read a
+            // row-major scale as [groups, oc] (measured on the A770, one
+            // E=256 block: IQ4_NL 125x and Q8_0 240x the CPU oracle's band).
+            // The device zp of a native format is never read by a kernel.
+            if (offset_pos >= 6 && tensors_by_offset[offset_pos] &&
+                tensors_by_offset[offset_pos] == tensors_by_offset[offset_pos - 3]) {
+                const size_t fmt = (offset_pos % 3 == 2) ? config.down_weight_format : config.gate_up_weight_format;
+                if (ov::op::internal::MOECompressed::is_native_format(fmt))
+                    continue;
+            }
             auto plan = make_tensor_fill_plan(offset_pos, tensors_by_offset[offset_pos], expert, lru_experts[index]);
             std::vector<uint8_t> payload;
 
