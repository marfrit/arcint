 namespace ov::intel_gpu::ocl::moe {
 
+namespace {
+
+// arcint M10 (patches/0013). Process-wide sequence-id counter and dump
+// registry for OffloadExpertWeightProvider's routing histograms. Kept local
+// to this translation unit (raw pointers into live providers, never exposed)
+// rather than split into their own header/pair the way OtdPerfCounters was
+// (patches/0004): unlike that split, nothing outside this .cpp needs to touch
+// either the counter or the registry, so a second header would only add a
+// file with no independent reader.
+
+std::atomic<size_t>& otd_layer_seq_counter() {
+    static std::atomic<size_t> counter{0};
+    return counter;
+}
+
+std::mutex& otd_registry_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+std::vector<OffloadExpertWeightProvider*>& otd_registry() {
+    static std::vector<OffloadExpertWeightProvider*> providers;
+    return providers;
+}
+
+void otd_register_provider(OffloadExpertWeightProvider* provider) {
+    std::lock_guard<std::mutex> lock(otd_registry_mutex());
+    otd_registry().push_back(provider);
+}
+
+// Histograms of providers that have already been destroyed, keyed by layer
+// sequence id. Measured need (orchestrator, first on-card run of this patch):
+// a graceful exit tears the network down before atexit runs, so every
+// provider had unregistered and the dump wrote "layers=0 total=0" against
+// a process that had routed hundreds of thousands of expert ids. The
+// destructor now retires its histogram here and the dump merges live and
+// retired entries.
+size_t& otd_key_collisions() {
+    static size_t n = 0;
+    return n;
+}
+
+std::map<size_t, std::vector<uint32_t>>& otd_retired_hists() {
+    static std::map<size_t, std::vector<uint32_t>> retired;
+    return retired;
+}
+
+void otd_unregister_provider(OffloadExpertWeightProvider* provider) {
+    std::lock_guard<std::mutex> lock(otd_registry_mutex());
+    auto& reg = otd_registry();
+    reg.erase(std::remove(reg.begin(), reg.end(), provider), reg.end());
+    // Retire unconditionally (an all-zero layer still takes its rank in the
+    // dump, so a dump of retired providers and a dump of live ones number
+    // layers identically). A key already present means two providers of one
+    // IR in one process; their counts are summed and the dump says so.
+    const auto& hist = provider->routing_histogram();
+    auto& slot = otd_retired_hists()[provider->layer_key()];
+    if (slot.empty()) {
+        slot = hist;
+    } else {
+        otd_key_collisions()++;
+        for (size_t i = 0; i < hist.size() && i < slot.size(); ++i)
+            slot[i] += hist[i];
+    }
+}
+
+// arcint M10 (patches/0013). MOE_OTD_ROUTING_HIST is read here, at real
+// process exit, fresh - never cached - unlike get_perf_counters()'s
+// process-wide-cached `static bool enabled` (moe_otd_runtime.cpp). That is a
+// deliberate difference, not an inconsistency with the "read once" channel
+// convention: get_perf_counters()'s cache has to be process-wide because it
+// gates a hot-path counter increment checked on every call, so caching once
+// per process is the whole point. This dump's condition is checked exactly
+// once - here, at exit - so there is nothing to cache, and reading fresh
+// means whether the dump fires depends only on the environment at exit, never
+// on which provider happened to be constructed first while some earlier
+// test (or, in production, some earlier reconfiguration) had the var unset.
+// Per-provider *counting* is still a one-time, per-provider decision (see
+// OffloadExpertWeightProvider's constructor below) so the hot path still
+// costs only the one cached-bool branch the header promises.
+void otd_dump_routing_hist() {
+    const char* path = std::getenv("MOE_OTD_ROUTING_HIST");
+    if (path == nullptr || path[0] == '\0')
+        return;
+
+    // Merge live providers and retired histograms into one seq-id-ordered map
+    // (a copy, taken under the mutex, so a provider destroyed while the file
+    // is being written cannot pull the vector out from under the loop).
+    std::map<size_t, std::vector<uint32_t>> merged;
+    {
+        std::lock_guard<std::mutex> lock(otd_registry_mutex());
+        merged = otd_retired_hists();
+        for (const auto* provider : otd_registry()) {
+            auto& slot = merged[provider->layer_key()];
+            const auto& hist = provider->routing_histogram();
+            if (slot.empty()) {
+                slot = hist;
+            } else {
+                otd_key_collisions()++;
+                for (size_t i = 0; i < hist.size() && i < slot.size(); ++i)
+                    slot[i] += hist[i];
+            }
+        }
+    }
+
+    std::ofstream out(path, std::ios::out | std::ios::trunc);
+    if (!out.is_open()) {
+        std::cerr << "[OTD_PERF] routing_hist: failed to open " << path << " for writing" << std::endl;
+        return;
+    }
+
+    // `layer` is the rank of the layer's weight-file offset among all layers
+    // seen by this process (0-based, export order); `weight_offset` is the
+    // key itself, so two runs of the same artifact can be joined on it.
+    out << "layer,weight_offset,expert,count\n";
+    uint64_t total = 0;
+    size_t experts_written = 0;
+    size_t layer = 0;
+    for (const auto& [key, hist] : merged) {
+        for (size_t expert = 0; expert < hist.size(); ++expert) {
+            if (hist[expert] == 0)
+                continue;
+            out << layer << "," << key << "," << expert << "," << hist[expert] << "\n";
+            total += hist[expert];
+            ++experts_written;
+        }
