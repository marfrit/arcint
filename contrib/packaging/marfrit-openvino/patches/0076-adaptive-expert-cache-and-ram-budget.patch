+        // fill uploads the newcomer then.
+        if (copied)
+            _cache->set_filled(*slot);
+        if (_host_bank)
+            exchange_in_bank(out, in);
+        if (perf)
+            perf->adaptive_swaps_applied.fetch_add(1, std::memory_order_relaxed);
+    }
+    _adaptive_pending.swap(waiting);
+}
