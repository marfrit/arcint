+std::optional<size_t> LRUCache::replace_pinned(size_t old_expert, size_t new_expert) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_map.find(Key{old_expert});
+    if (it == m_map.end() || m_map.find(Key{new_expert}) != m_map.end())
+        return std::nullopt;
+    const size_t slot = it->second->lru_expert_no;
+    if (slot >= m_pinned.size() || !m_pinned[slot])
+        return std::nullopt;
+    auto node = it->second;
+    m_map.erase(it);
+    node->expert = new_expert;
+    m_map[Key{new_expert}] = node;
+    m_filled_list[slot] = false;
+    return slot;
+}
