+// arcint (patch 0076, campaign expert-hot-set-lru). The adaptive cache's
+// clock and planner. One clock for the whole model: the adaptive provider
+// with the smallest layer_key counts decode steps (it is called once per
+// step, like every layer). Every `every` steps it plans one swap batch across
+// all adaptive layers with Strata's policy (adaptive_expert_cache.hpp), queues
+// each swap on its layer, and decays every count; while any swap is still in
+// flight it does neither (Strata's rule). Layers apply a swap at the start of
+// a call once its bytes are read. The plain usage vectors are not raced
+// because the whole process runs one network forward at a time (the engine's
+// lane turnstile), not merely one stream per provider; the registry mutex
+// guards the registry walk.
+size_t env_size(const char* name, size_t dflt) {
+    const char* v = std::getenv(name);
+    return (v != nullptr && v[0] != '\0') ? static_cast<size_t>(std::strtoul(v, nullptr, 10)) : dflt;
+}
+
+// arcint (patch 0076). Reader threads for the adaptive cache's newcomers:
+// file reads and the scale/zp transpose, no device objects. Process-wide and
+// deliberately leaked (detached threads parked on the condition variable at
+// exit), so no provider or static destructor has to join them.
+class AdaptiveReadPool {
+public:
+    static AdaptiveReadPool& get() {
+        static auto* pool = new AdaptiveReadPool();
+        return *pool;
+    }
+    void submit(std::function<void()> job) {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _jobs.push_back(std::move(job));
+        }
+        _cv.notify_one();
+    }
+
+private:
+    AdaptiveReadPool() {
+        const size_t n = std::max<size_t>(1, env_size("MOE_CPU_TIER_ADAPT_READERS", 2));
+        for (size_t i = 0; i < n; ++i)
+            std::thread([this] { run(); }).detach();
+    }
+    void run() {
+        for (;;) {
+            std::function<void()> job;
+            {
+                std::unique_lock<std::mutex> lock(_mutex);
+                _cv.wait(lock, [this] { return !_jobs.empty(); });
+                job = std::move(_jobs.front());
+                _jobs.pop_front();
+            }
+            // A job records its own failure; anything escaping it must not
+            // end the process from a detached thread.
+            try {
+                job();
+            } catch (...) {
+            }
+        }
+    }
+    std::mutex _mutex;
+    std::condition_variable _cv;
+    std::deque<std::function<void()>> _jobs;
+};
+
+void otd_adaptive_tick(OffloadExpertWeightProvider* caller) {
+    static const size_t every = env_size("MOE_CPU_TIER_ADAPT_EVERY", 12);
+    static const size_t max_swaps = env_size("MOE_CPU_TIER_ADAPT_SWAPS", 96);
+    static size_t clock_key = 0;
+    static bool clock_known = false;
+    static uint64_t steps = 0;
+    std::lock_guard<std::mutex> lock(otd_registry_mutex());
+    auto& reg = otd_registry();
+    if (!clock_known) {
+        bool any = false;
+        for (const auto* p : reg) {
+            if (!p->adaptive())
+                continue;
+            if (!any || p->layer_key() < clock_key)
+                clock_key = p->layer_key();
+            any = true;
+        }
+        clock_known = any;
+    }
+    if (!clock_known || caller->layer_key() != clock_key || every == 0)
+        return;
+    if (++steps % every != 0)
+        return;
+
+    std::vector<OffloadExpertWeightProvider*> layers;
+    for (auto* p : reg) {
+        if (p->adaptive() && p->config().num_expert == caller->config().num_expert)
+            layers.push_back(p);
+    }
+    // Strata's adapt returns while the previous swaps are in flight: no plan
+    // and no decay (generate.cpp:4431, `if (!pending.empty()) return true`).
+    for (const auto* p : layers)
+        if (p->adaptive_busy())
+            return;
+    std::sort(layers.begin(), layers.end(), [](const OffloadExpertWeightProvider* a, const OffloadExpertWeightProvider* b) {
+        return a->layer_key() < b->layer_key();
+    });
+    const size_t n_expert = caller->config().num_expert;
+    AdaptiveCacheState state(layers.size(), n_expert);
+    for (size_t l = 0; l < layers.size(); ++l) {
+        const auto& u = layers[l]->adaptive_usage();
+        for (size_t e = 0; e < n_expert && e < u.size(); ++e)
+            if (u[e] != 0.0f)
+                state.bump(l, e, u[e]);
+        for (const auto& [e, s] : layers[l]->cache().pinned_residents())
+            if (e < n_expert)
+                state.admit(l, e, static_cast<int32_t>(s));
+    }
+    AdaptiveCacheParams params;
+    params.max_swaps = max_swaps;
+    const auto swaps = state.plan(params);
+    for (const auto& sw : swaps)
+        layers[static_cast<size_t>(sw.layer)]->queue_adaptive_swap(static_cast<uint32_t>(sw.out),
+                                                                   static_cast<uint32_t>(sw.in));
+    for (auto* p : layers)
+        for (float& v : p->adaptive_usage())
+            v *= params.decay;
+    if (auto* perf = moe_otd::get_perf_counters()) {
+        perf->adaptive_plans.fetch_add(1, std::memory_order_relaxed);
+        perf->adaptive_swaps_planned.fetch_add(swaps.size(), std::memory_order_relaxed);
+    }
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        std::cerr << "[MOE_ADAPT] adaptive expert cache on: layers=" << layers.size() << " every=" << every
+                  << " decode steps, max_swaps=" << max_swaps << " (Strata adapt)" << std::endl;
+    }
+}
