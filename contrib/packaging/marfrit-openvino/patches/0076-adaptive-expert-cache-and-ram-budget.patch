+bool LRUCache::contains_filled(size_t expert) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_map.find(Key{expert});
+    return it != m_map.end() && m_filled_list[it->second->lru_expert_no];
