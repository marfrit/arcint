+private:
+    bool load(const std::string& path, const std::string& weights_path, std::string& why) {
+        std::ifstream f(path, std::ios::binary);
+        char magic[8] = {};
+        uint32_t hdr[4] = {};
+        if (!f.read(magic, 8) || std::memcmp(magic, "ARCRLA01", 8) != 0 || !f.read(reinterpret_cast<char*>(hdr), 16)) {
+            why = path + " is not an ARCRLA01 router file";
+            return false;
+        }
+        _n_expert = hdr[1];
+        _n_embd = hdr[2];
+        if (hdr[0] == 0 || hdr[0] > 4096 || _n_expert == 0 || _n_expert > 65536 || _n_embd == 0 || _n_embd > 65536) {
+            why = path + ": implausible header";
+            return false;
+        }
+        const size_t per = static_cast<size_t>(_n_expert) * _n_embd;
+        _w.resize(static_cast<size_t>(hdr[0]) * per);
+        for (uint32_t l = 0; l < hdr[0]; ++l) {
+            uint64_t key = 0;
+            if (!f.read(reinterpret_cast<char*>(&key), 8) ||
+                !f.read(reinterpret_cast<char*>(_w.data() + l * per), static_cast<std::streamsize>(per * sizeof(float)))) {
+                why = path + " is truncated";
+                return false;
+            }
+            _row_of[key] = l;
+            _keys.push_back(key);
+        }
+        std::sort(_keys.begin(), _keys.end());
+        if (const char* k = std::getenv("MOE_CPU_TIER_LOOKAHEAD_K"))
+            _k = std::atoi(k);
+        _k = std::max(1, std::min(static_cast<int>(_n_expert), _k));
+        _x.assign(8 * static_cast<size_t>(_n_embd), 0.0f);
+        _fd = ::open(weights_path.c_str(), O_RDONLY | O_CLOEXEC);
+        struct stat st {};
+        if (_fd < 0 || ::fstat(_fd, &st) != 0) {
+            why = "cannot open " + weights_path;
+            return false;
+        }
+        _size = static_cast<size_t>(st.st_size);
+        void* m = ::mmap(nullptr, _size, PROT_READ, MAP_SHARED, _fd, 0);
+        if (m == MAP_FAILED) {
+            why = "cannot map " + weights_path;
+            return false;
+        }
+        _base = static_cast<const uint8_t*>(m);
+        return true;
+    }
+
+    void run() {
+        std::vector<float> logits(static_cast<size_t>(_n_expert));
+        std::vector<int32_t> order(static_cast<size_t>(_n_expert));
+        std::vector<uint32_t> want;
+        for (;;) {
+            uint64_t next = 0;
+            size_t nt = 0;
+            HostExpertBank* bank = nullptr;
+            {
+                std::unique_lock<std::mutex> lock(_m);
+                _cv.wait(lock, [this] { return _pending; });
+                _pending = false;
+                _busy = true;
+                next = _next;
+                nt = _n_tok;
+                bank = _bank;
+            }
+            const auto t0 = std::chrono::steady_clock::now();
+            want.clear();
+            const float* w = _w.data() + _row_of[next] * static_cast<size_t>(_n_expert) * _n_embd;
+            for (size_t t = 0; t < nt; ++t) {
+                const float* x = _x.data() + t * _n_embd;
+                for (uint32_t e = 0; e < _n_expert; ++e) {
+                    const float* r = w + static_cast<size_t>(e) * _n_embd;
+                    float acc = 0.0f;
+                    for (uint32_t i = 0; i < _n_embd; ++i)
+                        acc += r[i] * x[i];
+                    logits[e] = acc;
+                }
+                std::iota(order.begin(), order.end(), 0);
+                std::partial_sort(order.begin(), order.begin() + _k, order.end(),
+                                  [&](int32_t a, int32_t b) { return logits[a] > logits[b]; });
+                for (int j = 0; j < _k; ++j) {
+                    const uint32_t e = static_cast<uint32_t>(order[j]);
+                    if (std::find(want.begin(), want.end(), e) == want.end())
+                        want.push_back(e);
+                }
+            }
+            uint64_t warmed = 0;
+            for (const uint32_t e : want) {
+                BankSpan sp[HostExpertBank::kMaxSpans];
+                int n = 0;
+                bool on_card = false;
+                if (!otd_lookahead_query(next, e, sp, &n, &on_card) || on_card)
+                    continue;
+                if (bank != nullptr && bank->holds(next, e))
+                    continue;
+                for (int i = 0; i < n; ++i) {
+                    if (sp[i].bytes == 0 || sp[i].file_offset + sp[i].bytes > _size)
+                        continue;
+                    const uintptr_t a = reinterpret_cast<uintptr_t>(_base + sp[i].file_offset) & ~uintptr_t{4095};
+                    const uintptr_t end = reinterpret_cast<uintptr_t>(_base + sp[i].file_offset + sp[i].bytes);
+                    (void)::madvise(reinterpret_cast<void*>(a), end - a, MADV_WILLNEED);
+                }
+                ++warmed;
+            }
+            if (auto* perf = moe_otd::get_perf_counters()) {
+                perf->lookahead_runs.fetch_add(1, std::memory_order_relaxed);
+                perf->lookahead_warmed.fetch_add(warmed, std::memory_order_relaxed);
+                perf->lookahead_ns.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                 std::chrono::steady_clock::now() - t0).count()),
+                                             std::memory_order_relaxed);
+            }
+            {
+                std::lock_guard<std::mutex> lock(_m);
+                _busy = false;
+            }
+        }
+    }
+
+    std::vector<float> _w;
+    std::map<uint64_t, size_t> _row_of;
+    std::vector<uint64_t> _keys;
+    uint32_t _n_expert = 0, _n_embd = 0;
+    int _k = 10;
+    int _fd = -1;
+    size_t _size = 0;
+    const uint8_t* _base = nullptr;
+    std::thread _thread;
+    std::mutex _m;
+    std::condition_variable _cv;
+    bool _pending = false, _busy = false;
+    std::vector<float> _x;
+    size_t _n_tok = 0;
+    uint64_t _next = 0;
+    HostExpertBank* _bank = nullptr;
+};
