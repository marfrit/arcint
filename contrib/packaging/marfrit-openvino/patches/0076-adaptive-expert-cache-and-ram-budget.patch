+// arcint (patch 0076, campaign expert-hot-set-lru). The adaptive expert
+// cache's policy, device-free: Strata's adapt (decay 0.7, margin 1.5, at most
+// 96 swaps every 4 rounds), one pool ranked across all layers. Red under a
+// mutant that drops the margin, forgets the decay, or admits a slot before its
+// copy has landed.
+
+TEST(adaptive_expert_cache, the_swap_batch_follows_the_decayed_usage_counts) {
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheParams;
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheState;
+    AdaptiveCacheParams p;  // decay 0.7, margin 1.5, candidate_min 2.0, every 4, <= 96
+    AdaptiveCacheState st(2, 4);
+    st.admit(0, 0, /*slot=*/0);                 // one resident victim in layer 0
+    for (int i = 0; i < 3; ++i) st.bump(0, 2);  // one hot non-resident candidate, same layer
+    auto sw = st.plan(p);
+    ASSERT_EQ(sw.size(), 1u);
+    EXPECT_EQ(sw[0].layer, 0);
+    EXPECT_EQ(sw[0].in, 2);
+    EXPECT_EQ(sw[0].out, 0);
+
+    // The margin blocks a swap whose gain is under 1.5.
+    AdaptiveCacheState hi(1, 2);
+    hi.admit(0, 0, 0);
+    hi.bump(0, 0, 2.0f);  // victim
+    hi.bump(0, 1, 3.0f);  // candidate 3.0 < 2.0 + 1.5 = 3.5 -> no swap
+    EXPECT_TRUE(hi.plan(p).empty()) << "the margin did not block a sub-margin swap";
+    hi.bump(0, 1, 1.0f);  // candidate 4.0 >= 3.5 -> swap
+    EXPECT_EQ(hi.plan(p).size(), 1u);
+
+    // The decay: after four rounds a candidate that fell below 2.0 is gone.
+    AdaptiveCacheState dc(1, 2);
+    dc.admit(0, 0, 0);
+    dc.bump(0, 1, 3.0f);
+    EXPECT_EQ(dc.plan(p).size(), 1u);
+    for (int r = 0; r < 4; ++r) dc.finish_round(p.decay);  // 3.0 * 0.7^4 ~= 0.72
+    EXPECT_TRUE(dc.plan(p).empty()) << "the decay did not drop the candidate below the threshold";
+}
+
+TEST(adaptive_expert_cache, evicted_slots_are_never_read_stale_and_admission_lands_late) {
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheState;
+    AdaptiveCacheState st(1, 2);
+    st.admit(0, 0, /*slot=*/0);
+    st.evict(0, 0);                 // evicted at once, before any copy is made
+    EXPECT_EQ(st.resident(0, 0), AdaptiveCacheState::kNotResident)
+        << "an evicted slot is still reported resident (a stale read is possible)";
+    st.admit(0, 1, /*slot=*/0);     // admitted only when the copy has landed
+    EXPECT_EQ(st.resident(0, 1), 0);
+    EXPECT_EQ(st.resident(0, 0), AdaptiveCacheState::kNotResident);
+}
+
+TEST(adaptive_expert_cache, the_round_is_due_every_n_rounds) {
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheState;
+    AdaptiveCacheState st(1, 2);
+    for (uint64_t r = 0; r < 3; ++r) {
+        EXPECT_FALSE(st.due(4)) << "adaptation fired early at round " << r;
+        st.finish_round(0.7f);
+    }
+    EXPECT_TRUE(st.due(4));
+}
+
+TEST(adaptive_expert_cache, the_batch_is_one_pool_capped_and_ordered_by_gain) {
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheParams;
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheState;
+    AdaptiveCacheParams p;
+    // Two layers, byte-sized pools: experts 0..E-1 resident (usage 1.0), experts
+    // E..2E-1 non-resident and hot (usage 3.0 -> over the 1 + margin 1.5 bar).
+    // E = 40 gives 80 swaps, under the 96 cap, so both layers appear.
+    const int E = 40;
+    AdaptiveCacheState st(2, 2 * E);
+    for (int l = 0; l < 2; ++l) {
+        for (int e = 0; e < E; ++e) {
+            st.admit(l, e, e);
+            st.bump(l, e, 1.0f);
+        }
+        for (int e = E; e < 2 * E; ++e) st.bump(l, e, 3.0f);
+    }
+    auto sw = st.plan(p);
+    EXPECT_EQ(sw.size(), static_cast<size_t>(2 * E));
+    for (size_t i = 1; i < sw.size(); ++i)
+        EXPECT_GE(sw[i - 1].gain, sw[i].gain) << "the batch is not ordered by gain desc";
+    bool l0 = false, l1 = false;
+    for (const auto& s : sw) { l0 |= s.layer == 0; l1 |= s.layer == 1; }
+    EXPECT_TRUE(l0 && l1) << "the batch is not one pool across layers";
+    // The cap: the same shape with 120 candidates per layer exceeds 96.
+    AdaptiveCacheState big(2, 240);
+    for (int l = 0; l < 2; ++l) {
+        for (int e = 0; e < 120; ++e) { big.admit(l, e, e); big.bump(l, e, 1.0f); }
+        for (int e = 120; e < 240; ++e) big.bump(l, e, 3.0f);
+    }
+    EXPECT_EQ(big.plan(p).size(), p.max_swaps) << "the batch was not capped at adapt_swaps";
+}
+
+TEST(adaptive_expert_cache, the_same_request_sequence_gives_the_same_state_and_batch) {
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheParams;
+    using ov::intel_gpu::ocl::moe::AdaptiveCacheState;
+    AdaptiveCacheParams p;
+    auto replay = [&]() {
+        AdaptiveCacheState st(3, 8);
+        for (int l = 0; l < 3; ++l)
+            for (int e = 0; e < 4; ++e) st.admit(l, e, e);
+        const int seq[12] = {5, 6, 6, 7, 5, 4, 6, 7, 5, 6, 4, 7};
+        for (int s : seq) st.bump(s % 3, s);
+        for (int r = 0; r < 4; ++r) {
+            st.plan(p);
+            st.finish_round(p.decay);
+        }
+        st.bump(0, 5);
+        return st.plan(p);
+    };
+    auto a = replay();
+    auto b = replay();
+    ASSERT_EQ(a.size(), b.size());
+    for (size_t i = 0; i < a.size(); ++i) {
+        EXPECT_EQ(a[i].layer, b[i].layer);
+        EXPECT_EQ(a[i].in, b[i].in);
+        EXPECT_EQ(a[i].out, b[i].out);
+        EXPECT_FLOAT_EQ(a[i].gain, b[i].gain);
+    }
+}
