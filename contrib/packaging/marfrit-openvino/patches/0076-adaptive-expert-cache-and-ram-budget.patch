+int OffloadExpertWeightProvider::expert_file_spans(uint32_t expert, BankSpan* spans) const {
+    if (!_spans_ready.load(std::memory_order_acquire))
+        return 0;
+    // expert_tensor_span's arithmetic: tensor base + expert * per-expert bytes.
+    for (int i = 0; i < _span_count; ++i)
+        spans[i] = BankSpan{static_cast<uint64_t>(_span_base[i].first + static_cast<size_t>(expert) * _span_base[i].second),
+                            _span_base[i].second};
+    return _span_count;
+}
+
+bool otd_lookahead_query(uint64_t layer_key, uint32_t expert, BankSpan* spans, int* n, bool* on_card) {
+    std::lock_guard<std::mutex> lock(otd_registry_mutex());
+    for (auto* p : otd_registry()) {
+        if (static_cast<uint64_t>(p->layer_key()) != layer_key)
+            continue;
+        *n = p->expert_file_spans(expert, spans);
+        *on_card = p->cache().contains_filled(expert);
+        return *n > 0;
+    }
+    return false;
+}
+
+void OffloadExpertWeightProvider::exchange_in_bank(uint32_t out, uint32_t in) {
+    // A span mismatch only makes the bank answer Unbanked for `out` later.
+    BankSpan sp[HostExpertBank::kMaxSpans];
+    const int n = expert_file_spans(out, sp);
+    const bool ok = n > 0 && _host_bank->exchange(static_cast<uint64_t>(layer_key()), in, out, sp, n);
+    if (auto* perf = moe_otd::get_perf_counters())
+        (ok ? perf->adaptive_bank_exchanges : perf->adaptive_bank_exchange_misses).fetch_add(1, std::memory_order_relaxed);
+}
+
+void OffloadExpertWeightProvider::apply_ready_adaptive_swaps(cldnn::stream& stream) {
+    if (_adaptive_pending.empty() || !_adaptive_prep || _resident == nullptr)
+        return;
+    auto* perf = moe_otd::get_perf_counters();
+    std::vector<std::pair<uint32_t, uint32_t>> waiting;
+    std::lock_guard<std::mutex> lock(_adaptive_prep->mutex);
+    for (const auto& [out, in] : _adaptive_pending) {
+        auto it = _adaptive_prep->ready.find(in);
+        if (it == _adaptive_prep->ready.end()) {
+            if (_adaptive_prep->failed.erase(in) != 0) {
+                if (perf)
+                    perf->adaptive_swaps_dropped.fetch_add(1, std::memory_order_relaxed);
+            } else {
+                waiting.emplace_back(out, in);  // still reading: the victim keeps serving
+            }
+            continue;
+        }
+        auto tensors = std::move(it->second);
+        _adaptive_prep->ready.erase(it);
+        const auto slot = _cache->replace_pinned(out, in);
+        if (!slot) {
+            if (perf)
+                perf->adaptive_swaps_dropped.fetch_add(1, std::memory_order_relaxed);
+            continue;
+        }
+        // In-order queue: the copy runs after every kernel already enqueued
+        // (the victim's last readers) and before every later one. Without
+        // program order the queue is drained on both sides of the copy.
+        const bool in_order = stream.get_queue_type() == cldnn::QueueTypes::in_order;
+        if (!in_order)
+            stream.finish();
+        const bool copied = moe_otd::enqueue_expert_tensors(stream, *_resident, tensors, *slot, _adaptive_upload);
+        if (!in_order)
+            stream.finish();
