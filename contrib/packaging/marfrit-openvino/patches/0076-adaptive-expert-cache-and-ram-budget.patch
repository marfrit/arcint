+// Spins until pred() or `budget` has passed; true when pred() held.
+template <class Pred>
+bool spin_for(std::chrono::microseconds budget, Pred pred) {
+    if (budget.count() <= 0)
+        return false;
+    const auto end = std::chrono::steady_clock::now() + budget;
+    unsigned n = 0;
+    while (!pred()) {
+        if ((++n & 63u) == 0 && std::chrono::steady_clock::now() >= end)
+            return false;
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+    return true;
