+// reclaims them.
+// arcint (patch 0076, campaign expert-hot-set-lru). Strata's routing-aware
+// prefetch of the file tier (src/program/generate.cpp:3001-3030,
+// src/core/expert_source.cpp:814-930): while the CPU tier works on layer L, a
+// thread applies layer L+1's router to layer L's MoE input, takes each
+// token's top-k, and asks the kernel (MADV_WILLNEED) for the pages of the
+// predicted experts that neither the card nor the host bank holds. It only
+// warms pages; the experts computed are the same. MOE_CPU_TIER_LOOKAHEAD=<file>
+// (tools/export_router_lookahead.py: the routers keyed by layer_key) turns it
+// on; MOE_CPU_TIER_LOOKAHEAD_K the experts per token (default 10). A submit
+// while the thread is busy is skipped, as Strata's is.
+class RouterLookahead {
+public:
+    // The first caller's weights file and shape bind the lookahead; a router
+    // file of another shape turns it off (its rows would misread x).
+    static RouterLookahead* get(const std::string& weights_path, uint32_t n_embd, uint32_t n_expert) {
+        static RouterLookahead* inst = [&]() -> RouterLookahead* {
+            const char* f = std::getenv("MOE_CPU_TIER_LOOKAHEAD");
+            if (f == nullptr || f[0] == '\0')
+                return nullptr;
+            auto* la = new RouterLookahead();  // leaked: its thread may outlive static destruction
+            std::string why;
+            bool ok = false;
+            try {
+                ok = la->load(f, weights_path, why);
+            } catch (const std::exception& e) {
+                why = e.what();
+            }
+            if (ok && (la->_n_embd != n_embd || la->_n_expert != n_expert)) {
+                why = "router file is " + std::to_string(la->_n_expert) + "x" + std::to_string(la->_n_embd) +
+                      ", the model " + std::to_string(n_expert) + "x" + std::to_string(n_embd);
+                ok = false;
+            }
+            if (!ok) {
+                std::cerr << "[MOE_LOOKAHEAD] off: " << why << std::endl;
+                return nullptr;
+            }
+            la->_thread = std::thread([la] { la->run(); });
+            la->_thread.detach();
+            std::cerr << "[MOE_LOOKAHEAD] on: " << la->_keys.size() << " routers " << la->_n_expert << "x" << la->_n_embd
+                      << ", k=" << la->_k << std::endl;
+            return la;
+        }();
+        return inst;
+    }
+
+    // x: n_tok f16 rows of `n_embd` (the tier's host copy of the MoE input).
+    void submit(uint64_t layer_key, const uint16_t* x, size_t n_tok, HostExpertBank* bank) {
+        auto* perf = moe_otd::get_perf_counters();
+        const auto it = std::upper_bound(_keys.begin(), _keys.end(), layer_key);
+        if (n_tok == 0 || n_tok > 8 || it == _keys.end() ||
+            std::find(_keys.begin(), _keys.end(), layer_key) == _keys.end())
+            return;
+        {
+            std::lock_guard<std::mutex> lock(_m);
+            if (_pending || _busy) {
+                if (perf)
+                    perf->lookahead_skipped.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            for (size_t i = 0; i < n_tok * _n_embd; ++i)
+                _x[i] = static_cast<float>(ov::float16::from_bits(x[i]));
+            _n_tok = n_tok;
+            _next = *it;
+            _bank = bank;
+            _pending = true;
+        }
+        _cv.notify_one();
+    }
