+namespace {
+std::array<cldnn::memory_ptr, cldnn::moe_3gemm_fused_compressed::serialized_weight_offset_count> tensors_of(
+    cldnn::moe_weights& w) {
+    return {{w.gate_w, w.up_w, w.down_w, w.gate_s, w.up_s, w.down_s, w.gate_z, w.up_z, w.down_z}};
+}
+}  // namespace
+
+std::vector<ExpertTensorPlan> plan_expert_tensors(const cldnn::MOECompressed::Config& config,
+                                                  const std::vector<size_t>& weight_bin_offsets,
+                                                  cldnn::moe_weights& wei_mem,
+                                                  uint32_t expert) {
+    const auto tensors = tensors_of(wei_mem);
+    std::vector<ExpertTensorPlan> plans;
+    for (size_t pos = 0; pos < tensors.size(); ++pos) {
+        const auto& mem = tensors[pos];
+        if (!mem)
+            continue;
+        // The same zp-aliasing skip as fill_weights_memory: a native format
+        // whose zp tensor aliases its scale tensor has nothing separate to load.
+        if (pos >= 6 && tensors[pos] == tensors[pos - 3]) {
+            const size_t fmt = (pos % 3 == 2) ? config.down_weight_format : config.gate_up_weight_format;
+            if (ov::op::internal::MOECompressed::is_native_format(fmt))
+                continue;
+        }
+        const auto span = expert_tensor_span(config, weight_bin_offsets, mem, pos, expert);
+        if (span.bytes == 0)
+            continue;
+        plans.push_back(ExpertTensorPlan{pos, span.file_offset, span.bytes, mem->get_layout()});
+    }
+    return plans;
+}
+
+std::vector<PreparedTensor> read_expert_tensors(const cldnn::MOECompressed::Config& config,
+                                                const std::filesystem::path& weights_path,
+                                                const std::vector<ExpertTensorPlan>& plans) {
+    std::vector<PreparedTensor> out;
+    const int fd = ::open(weights_path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return out;  // the swap is dropped; the victim keeps serving
+    auto* perf = get_perf_counters();
+    for (const auto& p : plans) {
+        PreparedTensor t;
+        t.offset_pos = p.offset_pos;
+        t.payload.resize(p.bytes);
+        size_t done = 0;
+        const auto t0 = std::chrono::steady_clock::now();
+        while (done < p.bytes) {
+            const ssize_t n = ::pread(fd, t.payload.data() + done, p.bytes - done, static_cast<off_t>(p.file_offset + done));
+            if (n <= 0)
+                break;
+            done += static_cast<size_t>(n);
+        }
+        if (done != p.bytes) {
+            ::close(fd);
+            return {};  // short read: drop the swap
+        }
+        if (perf)
+            perf->adaptive_read_ns.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                 std::chrono::steady_clock::now() - t0).count()),
+                                             std::memory_order_relaxed);
+        maybe_transpose_scale_zp(config, p.offset_pos, p.layout, t.payload, p.bytes);
+        out.push_back(std::move(t));
+    }
+    ::close(fd);
+    return out;
+}
+
+void* HostUploadPool::acquire(cldnn::engine& engine, size_t bytes, size_t* index) {
+    for (size_t i = 0; i < _entries.size(); ++i) {
+        auto& e = _entries[i];
+        if (e.pending && !e.pending->is_set())
+            continue;
+        e.pending.reset();
+        if (e.capacity < bytes)
+            continue;
+        *index = i;
+        return e.mem->buffer_ptr();
+    }
+    auto layout = cldnn::layout({1, 1, 1, static_cast<ov::Dimension::value_type>(bytes)}, cldnn::data_types::u8, cldnn::format::bfyx);
+    Entry e;
+    e.mem = engine.allocate_memory(layout, cldnn::allocation_type::usm_host, false);
+    e.capacity = bytes;
+    _live_bytes += bytes;
+    if (auto* perf = get_perf_counters())
+        perf->staging_bytes.fetch_add(bytes, std::memory_order_relaxed);
+    _entries.push_back(std::move(e));
+    *index = _entries.size() - 1;
+    return _entries.back().mem->buffer_ptr();
+}
+
+void HostUploadPool::retire(size_t index, cldnn::event::ptr ev) {
+    _entries[index].pending = std::move(ev);
+}
+
+bool enqueue_expert_tensors(cldnn::stream& exec_stream,
+                            cldnn::moe_weights& wei_mem,
+                            const std::vector<PreparedTensor>& tensors,
+                            size_t slot,
+                            HostUploadPool& pool) {
+    const auto by_pos = tensors_of(wei_mem);
+    size_t total = 0;
+    cldnn::engine* engine = nullptr;
+    for (const auto& t : tensors) {
+        total += t.payload.size();
+        if (!engine && by_pos[t.offset_pos])
+            engine = by_pos[t.offset_pos]->get_engine();
+    }
+    if (total == 0 || engine == nullptr)
+        return false;
+    size_t index = 0;
+    auto* host = static_cast<uint8_t*>(pool.acquire(*engine, total, &index));
+    size_t off = 0;
+    cldnn::event::ptr last;
+    for (const auto& t : tensors) {
+        auto mem = by_pos[t.offset_pos];
+        const size_t bytes = t.payload.size();
+        if (!mem || bytes == 0)
+            continue;
+        std::memcpy(host + off, t.payload.data(), bytes);
+        last = mem->copy_from(exec_stream, host, off, slot * bytes, bytes, false);
+        off += bytes;
+    }
+    // In-order queue: the last copy's event covers the earlier ones.
+    pool.retire(index, last);
+    return last != nullptr;
+}
+
 }  // namespace ov::intel_gpu::ocl::moe_otd
