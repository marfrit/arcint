+namespace ov::intel_gpu::ocl::moe {
+
+// arcint (patch 0076, campaign expert-hot-set-lru). The adaptive expert
+// cache: the resident set follows the conversation. A port of Strata's
+// `adapt` (src/program/generate.cpp:4414-4478, `code`), which is the
+// mechanism the reference audit (docs/campaigns/research-reference-audit.md)
+// says arcint never tried. DESIGN Section 3.4's 2026-10-01 amendment permits
+// history-dependent placement for the MoE expert tier, judged at the answer
+// (CLAUDE.md). This policy is deterministic; with non-blocking admission
+// (expert_weight_providers.cpp) WHEN a swap lands depends on reader timing,
+// so which device computes an expert at a given step can vary run to run. This
+// header is OpenVINO-free like census_seed.hpp, so the unit cells exercise
+// the policy without a card.
+//
+// The policy, exactly as Strata runs it:
+//  - each layer keeps one DECAYED usage count per expert;
+//  - every `rounds_between` calls (Strata adapt_every = 4) one swap batch is
+//    planned across ALL layers (one pool, ranked globally);
+//  - candidates are non-resident experts with usage >= candidate_min (2.0);
+//    victims are resident experts, paired candidate i against victim i sorted
+//    by usage (candidates desc, victims asc), and a pair swaps only when
+//    cand.usage >= vict.usage + margin (1.5) -- the margin is Strata's
+//    hysteresis against thrash;
+//  - the batch is ordered by gain desc and capped at max_swaps (96);
+//  - after the batch, every usage is multiplied by decay (0.7).
+//
+// Residency is explicit and two-phase: `evict()` takes the victim out at
+// once (resident = -1, so a stale slot is never read) and `admit()` records
+// the candidate only when its copy has landed. Nothing in this header waits
+// on a copy; the caller drives that with its own events.
+
+struct AdaptiveCacheParams {
+    float decay = 0.7f;           // Strata generate.cpp:4478
+    float margin = 1.5f;          // Strata generate.cpp:4443
+    float candidate_min = 2.0f;   // Strata generate.cpp:4436
+    size_t rounds_between = 4;    // Strata adapt_every
+    size_t max_swaps = 96;        // Strata adapt_swaps
+};
+
+struct AdaptiveSwap {
+    int32_t layer = 0;
+    int32_t in = 0;    // expert admitted when its copy lands
+    int32_t out = 0;   // resident expert evicted at once
+    float gain = 0.0f;
+};
+
+class AdaptiveCacheState {
+public:
+    AdaptiveCacheState(size_t n_layers, size_t n_expert)
+        : _n_expert(n_expert),
+          _usage(n_layers * n_expert, 0.0f),
+          _resident(n_layers * n_expert, kNotResident),
+          _rounds(0) {}
+
+    static constexpr int32_t kNotResident = -1;
+
+    size_t n_expert() const { return _n_expert; }
+    uint64_t rounds() const { return _rounds; }
+
+    float usage(size_t l, size_t e) const { return _usage[l * _n_expert + e]; }
+    int32_t resident(size_t l, size_t e) const { return _resident[l * _n_expert + e]; }
+
+    // One routed occurrence of expert e in layer l.
+    void bump(size_t l, size_t e, float w = 1.0f) { _usage[l * _n_expert + e] += w; }
+
+    // Resident now (its copy has landed), occupying `slot`.
+    void admit(size_t l, size_t e, int32_t slot) { _resident[l * _n_expert + e] = slot; }
+    // Clear the resident set so the caller can refresh it from the live cache
+    // before planning (the pool is the source of truth; this state caches it).
+    void reset_resident() {
+        for (int32_t& r : _resident)
+            r = kNotResident;
+    }
+
+
+    // Evicted at once: the slot is retired before the replacement is copied,
+    // so an evicted slot is never read stale.
+    void evict(size_t l, size_t e) { _resident[l * _n_expert + e] = kNotResident; }
+
+    // A swap batch is due every `rounds_between` completed rounds.
+    bool due(size_t rounds_between) const {
+        return rounds_between > 0 && (_rounds + 1) % rounds_between == 0;
+    }
+
+    // Decay every usage once for the round that just completed.
+    void finish_round(float decay) {
+        for (float& v : _usage)
+            v *= decay;
+        ++_rounds;
+    }
+
+    // The swap batch for the current round: one pool ranked across all layers,
+    // ordered by gain desc, capped at max_swaps. Pure function of the state --
+    // the same request sequence reaches the same state and the same batch.
+    std::vector<AdaptiveSwap> plan(const AdaptiveCacheParams& p) const {
+        std::vector<AdaptiveSwap> swaps;
+        const size_t n_layers = _resident.size() / _n_expert;
+        std::vector<std::pair<float, int32_t>> cand, vict;
+        for (size_t l = 0; l < n_layers; ++l) {
+            cand.clear();
+            vict.clear();
+            const float* u = _usage.data() + l * _n_expert;
+            const int32_t* r = _resident.data() + l * _n_expert;
+            for (int32_t e = 0; e < static_cast<int32_t>(_n_expert); ++e) {
+                if (r[e] == kNotResident) {
+                    if (u[e] >= p.candidate_min)
+                        cand.emplace_back(u[e], e);
+                } else {
+                    vict.emplace_back(u[e], e);
+                }
+            }
+            if (cand.empty() || vict.empty())
+                continue;
+            std::sort(cand.begin(), cand.end(),
+                      [](const std::pair<float, int32_t>& a, const std::pair<float, int32_t>& b) {
+                          if (a.first != b.first)
+                              return a.first > b.first;
+                          return a.second < b.second;  // total order: id tie-break
+                      });
+            const size_t nc = std::min(cand.size(), vict.size());
+            std::partial_sort(vict.begin(), vict.begin() + static_cast<ptrdiff_t>(nc), vict.end(),
+                              [](const std::pair<float, int32_t>& a, const std::pair<float, int32_t>& b) {
+                                  if (a.first != b.first)
+                                      return a.first < b.first;
+                                  return a.second > b.second;  // total order: id tie-break
+                              });
+            for (size_t i = 0; i < nc; ++i) {
+                if (cand[i].first < vict[i].first + p.margin)
+                    break;
+                swaps.push_back(AdaptiveSwap{static_cast<int32_t>(l), cand[i].second, vict[i].second,
+                                             cand[i].first - vict[i].first});
+            }
+        }
+        std::sort(swaps.begin(), swaps.end(), [](const AdaptiveSwap& a, const AdaptiveSwap& b) {
+            if (a.gain != b.gain)
+                return a.gain > b.gain;
+            if (a.layer != b.layer)
+                return a.layer < b.layer;
+            if (a.out != b.out)
+                return a.out < b.out;
+            return a.in < b.in;  // total order
+        });
+        if (swaps.size() > p.max_swaps)
+            swaps.resize(p.max_swaps);
+        return swaps;
+    }
+
+private:
+    size_t _n_expert;
+    std::vector<float> _usage;
+    std::vector<int32_t> _resident;
+    uint64_t _rounds;
+};
+
+}  // namespace ov::intel_gpu::ocl::moe
