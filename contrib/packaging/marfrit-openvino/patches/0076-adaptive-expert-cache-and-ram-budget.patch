+    AdaptiveReadPool::get().submit([prep = _adaptive_prep, config = _config, path = _weight_reader.path(),
+                                    plans = std::move(plans), in] {
+        std::vector<moe_otd::PreparedTensor> tensors;
+        try {
+            tensors = moe_otd::read_expert_tensors(config, path, plans);
+        } catch (...) {
+            tensors.clear();
