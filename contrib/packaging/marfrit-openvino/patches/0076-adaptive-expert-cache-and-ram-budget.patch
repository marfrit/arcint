+// --------------------------------------------------
+// arcint (patch 0076): the adaptive cache's swap under the static partition.
+// A pinned slot is handed to a newcomer, unfilled, and stays pinned; the old
+// expert is gone at once. Red on a mutant that keeps the slot filled (the
+// newcomer would be read before its bytes land) or keeps the old key (the
+// victim would still resolve to bytes that are about to be replaced).
+// --------------------------------------------------
+
+TEST(moe_lru_cache, replace_pinned_hands_the_slot_to_the_newcomer_unfilled) {
+    LRUCache cache(4);
+    cache.reserve_pinned(/*expert=*/10, /*slot=*/0);
+    cache.reserve_pinned(/*expert=*/11, /*slot=*/1);
+    cache.set_filled(0);
+    cache.set_filled(1);
+
+    ASSERT_TRUE(cache.replace_pinned(10, 20));
+
+    auto [slot, filled] = cache.probe(20);
+    ASSERT_EQ(slot, 0U);       // the victim's slot
+    ASSERT_FALSE(filled);      // uploaded on first use, never read before
+    ASSERT_EQ(cache.probe(10).first, LRUCache::kProbeMiss);  // the victim is gone at once
+    ASSERT_TRUE(cache.is_pinned(0));                          // still pinned: never evictable
+    ASSERT_EQ(cache.size(), 2U);
+    auto [slot11, filled11] = cache.probe(11);                // the other resident is untouched
+    ASSERT_EQ(slot11, 1U);
+    ASSERT_TRUE(filled11);
+}
+
+TEST(moe_lru_cache, replace_pinned_refuses_and_changes_nothing) {
+    LRUCache cache(4);
+    cache.reserve_pinned(10, 0);
+    cache.reserve_pinned(11, 1);
+    cache.set_filled(0);
+    auto [unpinned_slot, h] = cache.get_lru_item(12);  // an ordinary, unpinned entry
+    (void)h;
+
+    ASSERT_FALSE(cache.replace_pinned(99, 20));   // the old expert is absent
+    ASSERT_FALSE(cache.replace_pinned(10, 11));   // the newcomer is already resident
+    ASSERT_FALSE(cache.replace_pinned(12, 20));   // the old expert is not pinned
+    ASSERT_EQ(cache.probe(10).first, 0U);
+    ASSERT_TRUE(cache.probe(10).second);
+    ASSERT_EQ(cache.probe(12).first, unpinned_slot);
+    ASSERT_EQ(cache.probe(20).first, LRUCache::kProbeMiss);
+    ASSERT_EQ(cache.size(), 3U);
+}
+
+TEST(moe_lru_cache, pinned_residents_lists_only_the_pinned_set) {
+    LRUCache cache(4);
+    cache.reserve_pinned(10, 0);
+    cache.reserve_pinned(11, 1);
+    cache.get_lru_item(12);
+    ASSERT_TRUE(cache.replace_pinned(11, 21));
+
+    auto r = cache.pinned_residents();
+    std::set<std::pair<size_t, size_t>> got(r.begin(), r.end());
+    std::set<std::pair<size_t, size_t>> want{{10, 0}, {21, 1}};
+    ASSERT_EQ(got, want);
+}
+
+// arcint (patch 0076). contains_filled: true only for a resident expert whose
+// slot is filled, and it does not reorder the LRU list.
+TEST(moe_lru_cache, contains_filled_reports_only_filled_residents) {
+    LRUCache cache(2);
+    const auto a = cache.get_lru_item(7);
+    ASSERT_FALSE(cache.contains_filled(7));
+    cache.set_filled(a.first);
+    ASSERT_TRUE(cache.contains_filled(7));
+    ASSERT_FALSE(cache.contains_filled(8));
+    const auto b = cache.get_lru_item(8);
+    cache.set_filled(b.first);
+    ASSERT_TRUE(cache.contains_filled(7));  // no reorder: 7 stays least recent
+    const auto c = cache.get_lru_item(9);   // evicts the least recent, 7
+    ASSERT_EQ(c.first, a.first);
+    ASSERT_FALSE(cache.contains_filled(7));
+}
