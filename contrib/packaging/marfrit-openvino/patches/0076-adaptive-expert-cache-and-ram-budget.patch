+// arcint (patch 0076). The adaptive cache's split upload (plan on the compute
+// thread, read on a reader thread, one non-blocking enqueue) must leave a
+// slot holding the same bytes as fill_weights_memory, and those bytes must be
+// the expert's bytes from the file. Weight tensors only: the scale/zp
+// transpose is the same maybe_transpose_scale_zp call on both paths. The down
+// tensor has its own per-expert size, so a destination offset taken from
+// another tensor's size lands in the wrong place.
+TEST(moe_expert_weight_provider, adaptive_split_upload_matches_fill_weights_memory) {
+    namespace otd = ov::intel_gpu::ocl::moe_otd;
+    constexpr size_t n_expert = 4;
+    const size_t per[3] = {64, 64, 96};
+    const std::string path = ::testing::TempDir() + "adaptive_split_upload.bin";
+    const size_t off[3] = {0, n_expert * per[0], n_expert * (per[0] + per[1])};
+    std::vector<uint8_t> file(n_expert * (per[0] + per[1] + per[2]));
+    for (size_t i = 0; i < file.size(); ++i)
+        file[i] = static_cast<uint8_t>((i * 7 + 13) % 251);
+    {
+        std::ofstream f(path, std::ios::binary);
+        f.write(reinterpret_cast<const char*>(file.data()), static_cast<std::streamsize>(file.size()));
+    }
+    MOECompressed::Config config{};
+    config.num_expert = n_expert;
+    const std::vector<size_t> offsets = {off[0], off[1], off[2], 0, 0, 0, 0, 0, 0};
+
+    auto& engine = get_test_engine();
+    auto& stream = get_test_stream();
+    auto lay = [&](size_t t) {
+        return layout({1, 1, 1, static_cast<ov::Dimension::value_type>(n_expert * per[t])}, data_types::u8, format::bfyx);
+    };
+    auto make = [&] {
+        moe_weights w{};
+        w.gate_w = engine.allocate_memory(lay(0), allocation_type::usm_device);
+        w.up_w = engine.allocate_memory(lay(1), allocation_type::usm_device);
+        w.down_w = engine.allocate_memory(lay(2), allocation_type::usm_device);
+        return w;
+    };
+    moe_weights a = make(), b = make();
+
+    otd::ParallelWeightReader reader(path);
+    otd::StagingRing staging;
+    otd::fill_weights_memory(stream, config, offsets, reader, a, {3}, {1}, staging);
+
+    const auto plans = otd::plan_expert_tensors(config, offsets, b, 3);
+    ASSERT_EQ(plans.size(), 3U);
+    const auto tensors = otd::read_expert_tensors(config, path, plans);
+    ASSERT_EQ(tensors.size(), 3U);
+    otd::HostUploadPool pool;
+    otd::enqueue_expert_tensors(stream, b, tensors, /*slot=*/1, pool);
+    stream.finish();
+
+    const memory::ptr pairs[3][2] = {{a.gate_w, b.gate_w}, {a.up_w, b.up_w}, {a.down_w, b.down_w}};
+    for (size_t t = 0; t < 3; ++t) {
+        const size_t bytes = n_expert * per[t];
+        std::vector<uint8_t> ha(bytes), hb(bytes);
+        pairs[t][0]->copy_to(stream, ha.data(), 0, 0, bytes, true);
+        pairs[t][1]->copy_to(stream, hb.data(), 0, 0, bytes, true);
+        const auto* want = file.data() + off[t] + 3 * per[t];
+        ASSERT_TRUE(std::equal(want, want + per[t], hb.begin() + per[t])) << "tensor " << t << ": slot 1 is not expert 3's bytes";
+        ASSERT_TRUE(std::equal(ha.begin() + per[t], ha.begin() + 2 * per[t], hb.begin() + per[t])) << "tensor " << t;
+    }
+    std::remove(path.c_str());
+}
+
+// arcint (patch 0076). Measurement, not a check (run by name): CPU read
+// bandwidth from a usm_host allocation against plain heap memory, the
+// question behind the pinned host bank's CPU-tier slowdown.
+TEST(moe_expert_weight_provider, DISABLED_cpu_read_bandwidth_usm_host_vs_heap) {
+    constexpr size_t bytes = size_t{512} << 20;
+    auto& engine = get_test_engine();
+    const layout l({1, 1, 1, static_cast<ov::Dimension::value_type>(bytes)}, data_types::u8, format::bfyx);
+    auto host = engine.allocate_memory(l, allocation_type::usm_host, false);
+    std::vector<uint8_t> heap(bytes);
+    auto run = [&](const uint8_t* p, const char* what) {
+        std::memset(const_cast<uint8_t*>(p), 1, bytes);
+        double best = 0;
+        for (int r = 0; r < 5; ++r) {
+            const auto t0 = std::chrono::steady_clock::now();
+            uint64_t acc = 0;
+            const auto* q = reinterpret_cast<const uint64_t*>(p);
+            for (size_t i = 0; i < bytes / 8; i += 8)
+                acc += q[i] ^ q[i + 1] ^ q[i + 2] ^ q[i + 3] ^ q[i + 4] ^ q[i + 5] ^ q[i + 6] ^ q[i + 7];
+            const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            best = std::max(best, bytes / s / 1e9);
+            ASSERT_NE(acc, 1u);
+        }
+        std::cout << "[BW] " << what << " CPU read " << best << " GB/s" << std::endl;
+    };
+    run(heap.data(), "heap");
+    run(static_cast<const uint8_t*>(host->buffer_ptr()), "usm_host");
+}
