+// arcint (patch 0076, campaign expert-hot-set-lru). fill_weights_memory split
+// in two, for the adaptive cache's swaps (Strata's non-blocking admission):
+//  - plan_expert_tensors (caller thread; needs the bound tensors' layouts):
+//    which tensors to upload for one expert, with their file spans, under the
+//    same skip rules as fill_weights_memory;
+//  - read_expert_tensors (any thread; no device objects): reads the spans with
+//    its own file handle and applies the scale/zp transpose -- the payload
+//    does not depend on the destination slot;
+//  - enqueue_expert_tensors (the compute stream): copies the payloads into a
+//    slot through a HostUploadPool buffer, non-blocking and WITHOUT the
+//    end-of-call wait fill_weights_memory has (and without StagingRing's
+//    wait-on-reuse: a busy buffer is never waited on, a new one is made). In-order execution orders the copies after
+//    every kernel already enqueued (so the slot's old bytes are never
+//    overwritten under a reader) and before every later kernel (so the new
+//    bytes are never read early).
+struct ExpertTensorPlan {
+    size_t offset_pos = 0;
+    size_t file_offset = 0;
+    size_t bytes = 0;
+    cldnn::layout layout;
+};
+struct PreparedTensor {
+    size_t offset_pos = 0;
+    std::vector<uint8_t> payload;
+};
+std::vector<ExpertTensorPlan> plan_expert_tensors(const cldnn::MOECompressed::Config& config,
+                                                  const std::vector<size_t>& weight_bin_offsets,
+                                                  cldnn::moe_weights& wei_mem,
+                                                  uint32_t expert);
+std::vector<PreparedTensor> read_expert_tensors(const cldnn::MOECompressed::Config& config,
+                                                const std::filesystem::path& weights_path,
+                                                const std::vector<ExpertTensorPlan>& plans);
+// Background-read results for one provider's queued swaps. Shared with the
+// reader threads, so it outlives the provider while a read is in flight.
+struct AdaptivePrep {
+    std::mutex mutex;
+    std::unordered_map<uint32_t, std::vector<PreparedTensor>> ready;  // newcomer -> payloads
+    std::unordered_set<uint32_t> failed;
+};
+
+// usm_host buffers for the swap copies. One buffer per swapped expert (all
+// its tensors packed), held until the copy's event is set. acquire() never
+// waits: on an in-order queue a copy's event fires only after every kernel
+// enqueued before it, so waiting would stall the host on the whole queue.
+class HostUploadPool {
+public:
+    void* acquire(cldnn::engine& engine, size_t bytes, size_t* index);
+    void retire(size_t index, cldnn::event::ptr ev);
+    size_t live_bytes() const { return _live_bytes; }
+
+private:
+    struct Entry {
+        cldnn::memory::ptr mem;
+        cldnn::event::ptr pending;
+        size_t capacity = 0;
+    };
+    std::vector<Entry> _entries;
+    size_t _live_bytes = 0;
+};
+
+// Returns false when nothing was copied (the slot must then stay unfilled).
+bool enqueue_expert_tensors(cldnn::stream& exec_stream,
+                            cldnn::moe_weights& wei_mem,
+                            const std::vector<PreparedTensor>& tensors,
+                            size_t slot,
+                            HostUploadPool& pool);
