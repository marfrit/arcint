+// arcint (patch 0076). A bank over caller-owned chunks (the pinned mode)
+// reads through each IO thread's bounce buffer: the slot gets the file's
+// bytes, and a record never straddles two chunks.
+TEST(moe_host_expert_bank, external_chunks_get_the_files_bytes_through_the_bounce) {
+    ScratchFile f(1 << 20);
+    REQUIRE_DIRECT(f);
+    const size_t chunk = 128 << 10;  // two 64 KiB records a chunk
+    std::vector<std::vector<uint8_t>> mem(2, std::vector<uint8_t>(chunk));
+    std::vector<HostExpertBank::Chunk> chunks{{mem[0].data(), chunk}, {mem[1].data(), chunk}};
+    HostExpertBank bank(f.path, chunks, 2);
+    ASSERT_TRUE(bank.external());
+    for (uint32_t e = 0; e < 3; ++e) {
+        const BankSpan sp[2] = {{4096 + e * 65536ull, 20000}, {300000 + e * 4096ull, 3000}};
+        const auto l = bank.acquire(9, e, sp, 2);
+        ASSERT_EQ(l.state, HostExpertBank::State::Pending);
+        ASSERT_TRUE(fetch_and_wait(bank, l.slot));
+        for (int i = 0; i < 2; ++i) {
+            ASSERT_TRUE(std::equal(f.bytes.begin() + sp[i].file_offset,
+                                   f.bytes.begin() + sp[i].file_offset + sp[i].bytes, l.ptr[i]))
+                << "expert " << e << " span " << i;
+            const bool in0 = l.ptr[i] >= mem[0].data() && l.ptr[i] + sp[i].bytes <= mem[0].data() + chunk;
+            const bool in1 = l.ptr[i] >= mem[1].data() && l.ptr[i] + sp[i].bytes <= mem[1].data() + chunk;
+            ASSERT_TRUE(in0 || in1) << "expert " << e << " span " << i << " outside the chunks";
+        }
+        bank.release(l.slot);
+    }
+}
+
+// arcint (patch 0076). exchange(): a promoted expert's Ready slot is handed
+// to the demoted one and refilled with its bytes; the promoted expert is no
+// longer banked. A pinned slot or an already-banked newcomer refuses.
+TEST(moe_host_expert_bank, exchange_hands_the_promoted_slot_to_the_demoted_expert) {
+    ScratchFile f(1 << 20);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 << 10, 1);  // one slot
+    const BankSpan in_sp[1] = {{8192, 12000}};
+    const BankSpan out_sp[1] = {{400000, 12000}};
+    auto l = bank.acquire(5, 1, in_sp, 1);
+    ASSERT_EQ(l.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, l.slot));
+    ASSERT_FALSE(bank.exchange(5, 1, 2, out_sp, 1));  // still pinned by the lease
+    bank.release(l.slot);
+    ASSERT_TRUE(bank.exchange(5, 1, 2, out_sp, 1));
+    HostExpertBank::Lease o;
+    for (int i = 0; i < 2000; ++i) {
+        o = bank.acquire(5, 2, out_sp, 1);
+        if (o.state == HostExpertBank::State::Ready)
+            break;
+        if (o.state != HostExpertBank::State::Unbanked)
+            bank.release(o.slot);
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    ASSERT_EQ(o.state, HostExpertBank::State::Ready);
+    ASSERT_TRUE(std::equal(f.bytes.begin() + 400000, f.bytes.begin() + 400000 + 12000, o.ptr[0]));
+    bank.release(o.slot);
+    ASSERT_FALSE(bank.exchange(5, 1, 3, out_sp, 1));  // expert 1 is no longer banked
+    ASSERT_EQ(bank.stats().exchanges, 1u);
+}
+
+// arcint (patch 0076). A fixed bank (Strata's RAM budget) answers a miss
+// Unbanked and evicts nothing: the filled set stays, holds() reports it.
+TEST(moe_host_expert_bank, a_fixed_bank_answers_misses_unbanked_and_keeps_its_set) {
+    ScratchFile f(1 << 20);
+    REQUIRE_DIRECT(f);
+    HostExpertBank bank(f.path, 64 << 10, 1);  // one slot
+    const BankSpan a[1] = {{8192, 12000}};
+    const BankSpan b[1] = {{400000, 12000}};
+    auto l = bank.acquire(3, 1, a, 1);
+    ASSERT_EQ(l.state, HostExpertBank::State::Pending);
+    ASSERT_TRUE(fetch_and_wait(bank, l.slot));
+    bank.release(l.slot);
+    bank.set_fixed(true);
+    ASSERT_EQ(bank.acquire(3, 2, b, 1).state, HostExpertBank::State::Unbanked);
+    ASSERT_TRUE(bank.holds(3, 1));
+    ASSERT_FALSE(bank.holds(3, 2));
+    auto again = bank.acquire(3, 1, a, 1);
+    ASSERT_EQ(again.state, HostExpertBank::State::Ready);
+    bank.release(again.slot);
+    ASSERT_EQ(bank.stats().evictions, 0u);
+}
