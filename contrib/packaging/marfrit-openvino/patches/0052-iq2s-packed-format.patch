+inline float native_dot_iq2s_packed(const __global uchar* W,
+                                    const __global half* S,
+                                    int n, int N, int K,
+                                    const __global half* x, int x_base,
+                                    int id_local) {
+    // arcint (patch 0052). IQ2_S-packed: the checkpoint's own 82-byte ggml
+    // block, with the f16 d LIFTED OUT -- 80 self-contained bytes per 256
+    // values: qs low-2-bit indices (32 B) | RAW sign masks (32 B) | qh
+    // high-2-bit (8 B) | 4-bit sub-block scales (8 B). d is the scale slot,
+    // [E, out, K/256] f16 -- the emitter's separate Constant, so the plugin
+    // carries the same bytes the checkpoint ships and the layout is the
+    // split form's own. idx = qs[ib*4+l] | (((qh[ib] >> 2l) & 3) << 8); the
+    // low nibble scales l<2 and the high nibble l>=2.
+    float acc = 0.0f;
+    const int nblk = K / 256;
+    const __global uchar* brow = W + (long)n * nblk * 80;
+    for (int ib = 0; ib < nblk; ib++) {
+        const __global uchar* blk = brow + (long)ib * 80;
+        float d = convert_float(S[(long)n * nblk + ib]);
+        uchar scb = blk[72 + ib];
+        float dlo = d * (0.5f + convert_float(scb & 0x0F)) * 0.25f;
+        float dhi = d * (0.5f + convert_float(scb >> 4)) * 0.25f;
+        uchar qhb = blk[64 + ib];
+        for (int j = id_local; j < 32; j += SUBGROUP_SIZE) {
+            int l = j >> 3;
+            int m = j & 7;
+            ushort gi = (ushort)blk[ib * 4 + l] | ((ushort)((qhb >> (2 * l)) & 3) << 8);
+            float mag = convert_float(NATIVE_IQ2S_GRID[gi * 8 + m]);
+            uchar signs = blk[32 + ib * 4 + l];
+            float sign = (signs & NATIVE_IQ2XS_MASK[m]) ? -1.0f : 1.0f;
+            float dd = (l < 2) ? dlo : dhi;
+            acc += convert_float(x[x_base + ib * 32 + j]) * dd * mag * sign;
+        }
+    }
+    return sub_group_reduce_add(acc);
+}
