     std::vector<uint32_t> missed_experts;
     std::vector<size_t> missed_slots;
 
+    // arcint (patch 0038, campaign: sub4bit-vram-kernel). Per-expert dispatch
+    // mode: ALL routed experts are treated as CPU-tier misses. No expert
+    // reaches the fused GEMV path. The slot pool is not consulted.
+    if (_per_expert_dispatch && cpu_tier_misses != nullptr) {
+        OPENVINO_ASSERT(cpu_tier_misses->empty(),
+            "per-expert dispatch: cpu_tier_misses must be empty on entry");
+        std::unordered_map<uint32_t, size_t> miss_index;
+        miss_index.reserve(experts.size());
+        ExpertSlotLease lease(experts.size(), kCpuTierSentinelSlot);
+        for (size_t i = 0; i < experts.size(); i++) {
+            const uint32_t expert = experts[i];
+            auto it = miss_index.find(expert);
+            if (it != miss_index.end()) {
+                (*cpu_tier_misses)[it->second].positions.push_back(i);
+            } else {
+                auto& m = cpu_tier_misses->emplace_back();
+                m.expert = expert;
+                m.positions.push_back(i);
+                miss_index[expert] = cpu_tier_misses->size() - 1;
+            }
+        }
+        if (auto* perf = moe_otd::get_perf_counters()) {
+            perf->per_expert_dispatches.fetch_add(
+                static_cast<uint64_t>(miss_index.size()),
+                std::memory_order_relaxed);
+        }
+        return lease;
