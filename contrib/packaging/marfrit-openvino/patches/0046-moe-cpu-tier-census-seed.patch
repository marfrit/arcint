+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+// arcint VENICE (patch 0046). Census-seeded static partition for the MoE host
+// compute tier.
+//
+// Patch 0018 chooses a layer's resident expert set with a frequency-FREE
+// splitmix64 rank over (seed, layer_key, expert). The VENICE campaign replaces
+// that ranking with a measured-frequency rank: a seed file emitted by
+// tools/hot_set_census.py select, keyed by the structural layer_key (the
+// layer's first OTD weight-file offset -- the same key patch 0018 and patch
+// 0044's routing trace already use). The set membership is still a pure
+// function of the recorded census, so DESIGN Section 3.4 (history-independent
+// greedy output) is untouched: the seed does not depend on run history, and a
+// layer's set is fixed once at bind().
+//
+// Format ("hot-set seed v2"), one data line per layer:
+//   <layer_key> <expert> <expert> ...
+// `#` lines are comments; the header MUST declare `# space=layer_key`, so a
+// seed keyed by the decoder-layer index cannot be silently consumed as a
+// layer_key seed. Expert ids must be distinct; they may appear in any order
+// (frequency rank order is preserved in the file, and the caller re-sorts
+// ascending for slot assignment).
+//
+// This header is deliberately free of OpenVINO dependencies: it is pure
+// <algorithm>/<cstdint>/<map>/<stdexcept>/<string>/<vector>, so the parser and
+// its red-first refusal cells compile and run device-free with a plain g++
+// (see tools/test_census_seed.py).
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ov::intel_gpu::ocl::moe {
+
+struct CensusSeed {
+    // decoder-layer layer_key -> the experts the census ranked resident.
+    std::map<size_t, std::vector<uint32_t>> by_layer_key;
+};
+
+namespace census_seed_detail {
+inline bool parse_ull(const std::string& tok, unsigned long long& out) {
+    if (tok.empty())
+        return false;
+    for (char c : tok)
+        if (c < '0' || c > '9')
+            return false;
+    try {
+        size_t pos = 0;
+        out = std::stoull(tok, &pos);
+        return pos == tok.size();
+    } catch (...) {
+        return false;
+    }
+}
+}  // namespace census_seed_detail
+
+// Parse format v2. Throws std::runtime_error on any malformed line, a
+// duplicate layer_key, a duplicate expert id, a missing or wrong `space=`
+// header, or no data rows at all. The strictness is the point: a seed that
+// cannot be attributed to the layer_key space is a mismatch, not a default.
+inline CensusSeed parse_census_seed(const std::string& text) {
+    CensusSeed seed;
+    bool space_declared = false;
+    bool space_is_layer_key = false;
+    size_t lineno = 0;
+    size_t start = 0;
+    while (start <= text.size()) {
+        const size_t nl = text.find('\n', start);
+        std::string line = (nl == std::string::npos) ? text.substr(start)
+                                                     : text.substr(start, nl - start);
+        start = (nl == std::string::npos) ? text.size() + 1 : nl + 1;
+        ++lineno;
+        auto fail = [&](const std::string& why) -> void {
+            throw std::runtime_error("census seed line " + std::to_string(lineno) + ": " + why);
+        };
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+            line.pop_back();
+        if (line.empty())
+            continue;
+        if (line[0] == '#') {
+            const size_t pos = line.find("space=");
+            if (pos != std::string::npos) {
+                std::string val;
+                for (char c : line.substr(pos + 6)) {
+                    if (c == ' ' || c == '\t' || c == '\r')
+                        break;
+                    val.push_back(c);
+                }
+                space_declared = true;
+                space_is_layer_key = (val == "layer_key");
+            }
+            continue;
+        }
+        std::vector<std::string> toks;
+        std::string tok;
+        for (char c : line) {
+            if (c == ' ' || c == '\t' || c == '\r') {
+                if (!tok.empty()) {
+                    toks.push_back(tok);
+                    tok.clear();
+                }
+            } else {
+                tok.push_back(c);
+            }
+        }
+        if (!tok.empty())
+            toks.push_back(tok);
+        if (toks.size() < 2)
+            fail("data line needs a layer_key and at least one expert id");
+        unsigned long long layer_key = 0;
+        if (!census_seed_detail::parse_ull(toks[0], layer_key))
+            fail("layer_key is not a non-negative integer: " + toks[0]);
+        if (seed.by_layer_key.count(static_cast<size_t>(layer_key)))
+            fail("duplicate layer_key " + toks[0]);
+        std::vector<uint32_t> experts;
+        for (size_t i = 1; i < toks.size(); ++i) {
+            unsigned long long e = 0;
+            if (!census_seed_detail::parse_ull(toks[i], e))
+                fail("expert id is not a non-negative integer: " + toks[i]);
+            if (e > 0xFFFFFFFFULL)
+                fail("expert id does not fit uint32: " + toks[i]);
+            experts.push_back(static_cast<uint32_t>(e));
+        }
+        std::vector<uint32_t> sorted = experts;
+        std::sort(sorted.begin(), sorted.end());
+        for (size_t i = 1; i < sorted.size(); ++i)
+            if (sorted[i] == sorted[i - 1])
+                fail("duplicate expert id " + std::to_string(sorted[i]));
+        seed.by_layer_key[static_cast<size_t>(layer_key)] = experts;
+    }
+    if (!space_declared)
+        throw std::runtime_error("census seed: missing `# space=layer_key` header");
+    if (!space_is_layer_key)
+        throw std::runtime_error(
+            "census seed: declared space is not `layer_key` -- a decoder-index seed "
+            "cannot be consumed as a static-partition seed");
+    if (seed.by_layer_key.empty())
+        throw std::runtime_error("census seed: no data rows");
+    return seed;
+}
+
+// The validated resident set for one layer: its seed entry, sorted ascending
+// for slot assignment. Throws on a layer absent from the seed (the file and
+// the model disagree), a slot-count mismatch (the pool budget changed since
+// the census was taken), or an expert id outside [0, num_expert).
+inline std::vector<uint32_t> census_seed_resident_experts(const CensusSeed& seed,
+                                                          size_t layer_key,
+                                                          size_t num_expert,
+                                                          size_t capacity) {
+    auto it = seed.by_layer_key.find(layer_key);
+    if (it == seed.by_layer_key.end())
+        throw std::runtime_error("census seed: layer_key " + std::to_string(layer_key) +
+                                 " is absent from the seed (mismatched model/seed)");
+    if (it->second.size() != capacity)
+        throw std::runtime_error("census seed: layer_key " + std::to_string(layer_key) +
+                                 " lists " + std::to_string(it->second.size()) +
+                                 " experts but the pool has " + std::to_string(capacity) +
+                                 " slots (mismatched budget)");
+    for (uint32_t e : it->second)
+        if (e >= num_expert)
+            throw std::runtime_error("census seed: expert " + std::to_string(e) +
+                                     " is out of range [0, " + std::to_string(num_expert) +
+                                     ") for layer_key " + std::to_string(layer_key));
+    std::vector<uint32_t> sorted = it->second;
+    std::sort(sorted.begin(), sorted.end());
+    return sorted;
+}
+
+// FNV-1a over the seed TEXT, for the `cpu_tier on:` log line: a fingerprint of
+// the file two runs were seeded from, so residency agreement can be diffed
+// without dumping the whole set. Not a cryptographic digest.
+inline uint64_t census_seed_fingerprint(const std::string& text) {
+    uint64_t h = 0xCBF29CE484222325ULL;
+    for (unsigned char c : text) {
+        h ^= static_cast<uint64_t>(c);
+        h *= 0x100000001B3ULL;
+    }
+    return h;
+}
+
+}  // namespace ov::intel_gpu::ocl::moe
