+namespace {
+// arcint VENICE (patch 0046). The census seed file is per-RUN, not per-layer,
+// so parse it once and share the result across all MoE layers' constructors.
+// Any failure -- cannot open, malformed line, missing/wrong space header --
+// throws here and refuses the load, rather than silently falling back to the
+// frequency-free seed. The fingerprint is FNV-1a over the file text, for the
+// `cpu_tier on:` log line.
+struct LoadedCensusSeed {
+    ov::intel_gpu::ocl::moe::CensusSeed seed;
+    uint64_t fingerprint = 0;
+};
+
+const LoadedCensusSeed& cached_census_seed(const char* path) {
+    static std::map<std::string, LoadedCensusSeed> cache;
+    auto it = cache.find(path);
+    if (it == cache.end()) {
+        std::ifstream in(path);
+        if (!in)
+            OPENVINO_THROW("MOE_CPU_TIER_SEED: cannot open census seed file ", path);
+        std::stringstream ss;
+        ss << in.rdbuf();
+        const std::string text = ss.str();
+        LoadedCensusSeed loaded;
+        loaded.seed = ov::intel_gpu::ocl::moe::parse_census_seed(text);
+        loaded.fingerprint = ov::intel_gpu::ocl::moe::census_seed_fingerprint(text);
+        it = cache.emplace(path, std::move(loaded)).first;
+    }
+    return it->second;
+}
