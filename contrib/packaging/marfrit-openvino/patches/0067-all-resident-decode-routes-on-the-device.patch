+// writes for routed position i: flat = token * experts_per_token + position.
+KERNEL(expert_route_native)(
+    const __global int* topk_id,
+    __global int*       pairs,
+    int experts_per_token,
+    int max_topk)
+{
+    const int i = get_global_id(0);
+    const int pos = i % max_topk;
+    pairs[3 * i + 0] = topk_id[i];
+    pairs[3 * i + 1] = (i / max_topk) * experts_per_token + pos;
+    pairs[3 * i + 2] = pos;
