+// arcint (contrib/sdcpp/server-health-props.patch): the service probes of the
+// language units. The context is built before the server listens, so a
+// listening server is a loaded one.
+static json make_props_json(const ServerRuntime& runtime) {
+    const auto& ctx      = *runtime.ctx_params;
+    const auto& defaults = *runtime.default_gen_params;
+    auto base            = [](const std::string& p) { return p.empty() ? std::string() : fs::u8path(p).filename().u8string(); };
+    json devices         = json::array();
+    const std::string assigned = ctx.effective_backend.empty() ? ctx.backend : ctx.effective_backend;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        const std::string name = ggml_backend_dev_name(dev);
+        if (!assigned.empty() && assigned.find(name) == std::string::npos) {
+            continue;
+        }
+        devices.push_back({{"name", name}, {"description", ggml_backend_dev_description(dev)}});
+    }
+    return {
+        {"model", base(resolve_display_model_path(runtime).u8string())},
+        {"text_encoder", base(ctx.llm_path)},
+        {"vae", base(ctx.vae_path)},
+        {"tensor_type_rules", ctx.tensor_type_rules},
+        {"backend", assigned},
+        {"devices", devices},
+        {"flash_attn", ctx.flash_attn_mode},
+        {"conv_direct", ctx.conv_direct_mode.empty() ? std::string("auto") : ctx.conv_direct_mode},
+        {"width", defaults.width},
+        {"height", defaults.height},
+        {"seed", defaults.seed},
+        {"sample", make_sample_params_json(defaults.sample_params, defaults.skip_layers)},
+        {"sdcpp_version", sd_version()},
+        {"sdcpp_commit", sd_commit()},
+        {"build", ARCINT_BUILD},
+    };
+}
