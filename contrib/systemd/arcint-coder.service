# arcint-coder — the Qwen3.6-27B-A3B coder on the libllama engine, the 16 GB card.
#
# The coder endpoint since 2026-10-05. The GGUF is the kernel GA's searched
# quantization, genome c5f495ac in its shq8 variant, 14.6 GB
# (docs/llama-engine.md). The OpenVINO export it replaced stays as the
# rollback: arcint-coder-openvino.service, same port and served name, so a
# proxy finds either.
#
# Measured on the Arc A770 with exactly these flags (arcint 0.5.11):
# - VRAM peak 16.67 of 17.08 GB at a 94,926-token prompt, no paging. Prefill
#   285.1 t/s at that depth; decode 19.5 t/s there, 57.5 t/s on a fresh
#   context.
# - KL against Q8_0 0.02367, the same top-1 95.43 %.
# - Acceptance task 10/10 at temperature 0; all 10 of 10 runs at 0.7.
# --llama-kv q8_0:q4_0 is the smallest pair arcint accepts (4:4 is refused).

[Unit]
Description=arcint-coder — Qwen3.6-27B-A3B-Coder on libllama, GPU.1, :8080, 98k
Documentation=https://github.com/marfrit/arcint
After=default.target
Conflicts=arcint-coder-openvino.service

[Service]
Type=simple
ExecStart=/usr/bin/arcint \
    --engine llama \
    --gguf /models/gguf/qwen36-coder-c5f495ac-shq8.gguf \
    --served-model-name qwen3.6-coder \
    --device GPU.1 \
    --host 0.0.0.0 \
    --port 8080 \
    --n-ctx 98304 \
    --llama-mtp 4 \
    --llama-kv q8_0:q4_0 \
    --queue-timeout 30
Restart=on-failure
RestartSec=30
TimeoutStartSec=20min
TimeoutStopSec=60s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=read-only

[Install]
WantedBy=default.target
