# arcint-agent — Qwen3.6-35B-A3B on the 24 GB card, the agent endpoint.
#
# Why this card and this model (measured 2026-08-30, same tasks, same probes):
#   here     62.7 t/s decode at 53.5k context, 1584 t/s prefill
#   before   12.45 t/s on llama.cpp/Vulkan on the 16 GB card, ~58 t/s prefill
# Acceptance task 10/10 greedy, tool probe 3/3. The IR is Intel's official
# export of the checkpoint. The model fits the card whole: weights+graph
# 17.38 GiB of 22.71, the reservation admitting 377552 tokens against a
# trained maximum of 262144. No offload, no streaming, no CPU experts.

[Unit]
Description=arcint-agent — Qwen3.6-35B-A3B on OpenVINO, GPU.0 (Arc Pro B60), :8087
Documentation=https://github.com/marfrit/arcint
After=default.target
# One card, one resident model: name the other units that want this card.
#Conflicts=some-other-engine-on-gpu0.service

[Service]
Type=simple
ExecStart=/usr/bin/arcint \
    --model /models/ov/qwen36-35b-a3b-int4-ov \
    --model-id qwen3.6-35b-a3b \
    --served-model-name qwen3.6-agent \
    --device GPU.0 \
    --host 0.0.0.0 \
    --port 8087 \
    --n-ctx 262144 \
    --prefix-cache-mib 8192 \
    --cache-dir %h/.cache/arcint-agent \
    --queue-timeout 30 \
    --paged-kv u8 \
    --gate-pad 16
Restart=on-failure
RestartSec=30
TimeoutStartSec=20min
TimeoutStopSec=60s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=read-only
ReadWritePaths=%h/.cache/arcint-agent

[Install]
WantedBy=default.target
