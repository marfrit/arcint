+// TEST ONLY, never in the series (see mix())
+struct inkling2_noise { float amp; unsigned long long seed; unsigned long long call; };
+static void inkling2_noise_fn(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    const inkling2_noise * ud = (const inkling2_noise *) userdata;
+    const float * x = (const float *) a->data;
+    float * y = (float *) dst->data;
+    const int64_t n = ggml_nelements(a);
+    unsigned long long h0 = ud->seed*0x9E3779B97F4A7C15ull + ud->call*0xD1B54A32D192ED03ull;
+    for (int64_t i = 0; i < n; ++i) {
+        unsigned long long z = h0 + (unsigned long long) i*0x9E3779B97F4A7C15ull;
+        z = (z ^ (z >> 30))*0xBF58476D1CE4E5B9ull; z = (z ^ (z >> 27))*0x94D049BB133111EBull; z ^= z >> 31;
+        // one ulp up or down: the smallest change a float has (relative 6e-8 .. 1.2e-7)
+        y[i] = nextafterf(x[i], (z & 1) ? INFINITY : -INFINITY);
+    }
+}
