+struct test_mul_mat_id_p5 : public test_mul_mat_id {
+    const int mode;     // 2 balanced, 3 replay
+    const int replay;   // the p5_replay row (mode 3)
+    test_mul_mat_id_p5(int mode, int replay, ggml_type type_a, ggml_type type_b, int n_mats, int n_used, bool b,
+                       int64_t m, int64_t n, int64_t k)
+        : test_mul_mat_id(type_a, type_b, n_mats, n_used, b, m, n, k), mode(mode), replay(replay) {
+        GGML_ASSERT(n_mats == 128 && n_used == 8);
+        GGML_ASSERT(mode == 2 || (mode == 3 && replay >= 0 && replay < p5_n_replay && p5_replay[replay].n == n));
+    }
+    std::string vars() override {
+        return test_mul_mat_id::vars() + (mode == 2 ? std::string(",routed=2") : std::string(",routed=3,replay=") + p5_replay[replay].tag);
+    }
+    void initialize_tensors(ggml_context * ctx) override {
+        std::vector<int32_t> list;
+        if (mode == 3) {
+            int mx = 0;
+            for (int e = 0; e < 128; ++e) {
+                mx = std::max(mx, p5_replay[replay].cnt[e]);
+                for (int c = 0; c < p5_replay[replay].cnt[e]; ++c) { list.push_back(e); }
+            }
+            GGML_ASSERT((int64_t) list.size() == n * n_used && mx <= n);
+        }
+        std::vector<int> cnt(n_mats, 0);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_I32) {
+                if (ggml_is_view_op(t->op)) { continue; }
+                const int off = ids_offset ? 1 : 0;
+                for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                    std::vector<int32_t> data(t->ne[0], 0);
+                    for (int i = 0; i < n_used; i++) {
+                        const int32_t e = mode == 2 ? (int32_t) ((n_used * r + i) % n_mats) : list[(size_t) i * n + r];
+                        data[off + i] = e;
+                        cnt[e]++;
+                    }
+                    for (int i = 0; i < n_used; i++) {
+                        for (int j = i + 1; j < n_used; j++) { GGML_ASSERT(data[off + i] != data[off + j]); }
+                    }
+                    ggml_backend_tensor_set(t, data.data(), r * t->nb[1], t->ne[0] * sizeof(int32_t));
+                }
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+        int tiles = 0, touched = 0, mx = 0, skip = 0;
+        for (int c : cnt) {
+            tiles += (c + 31) / 32; touched += c > 0; mx = std::max(mx, c); skip += 4 * ((c + 31) / 32) - (c + 7) / 8;
+        }
+        printf("P5 ROUTE %s tiles32=%d touched=%d max=%d skip8=%d\n", vars().c_str(), tiles, touched, mx, skip);
+        fflush(stdout);
+    }
+    void reinit_perf_iter(ggml_context * ctx) override { GGML_UNUSED(ctx); }
+};
