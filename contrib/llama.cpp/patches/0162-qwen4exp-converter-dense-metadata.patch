--- a/conversion/qwen4exp.py
+++ b/conversion/qwen4exp.py
@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import json
 from typing import Iterable, cast
 
 import torch
@@ -13,6 +14,29 @@ from .qwen import _LinearAttentionVReorderBase, _Qwen35MRopeMixin
 from .qwen3vl import Qwen3VLVisionModel
 
 
+# The transformers outer Qwen4ExpConfig is a multimodal wrapper: its text fields live
+# under `text_config` and the text defaults are Qwen4ExpTextConfig's (16 key heads,
+# 32 value heads), which AutoConfig would inject when a checkpoint spells the text
+# fields at the root. Return the raw config.json instead; TextModel merges
+# `text_config` after this point, so both layouts keep their own values.
+def _is_qwen4exp_checkpoint(dir_model) -> bool:
+    cfg_path = dir_model / "config.json"
+    if not cfg_path.is_file():
+        return False
+    try:
+        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
+    except Exception:
+        return False
+    return cfg.get("model_type") in ("qwen4_exp", "qwen4_exp_text") or \
+        any(a in ("Qwen4ExpForCausalLM", "Qwen4ExpForConditionalGeneration", "Qwen4ExpTextModel")
+            for a in cfg.get("architectures", []))
+
+
+@ModelBase.register_hparams_loader(_is_qwen4exp_checkpoint)
+def _load_qwen4exp_hparams(dir_model) -> dict:
+    return json.loads((dir_model / "config.json").read_text(encoding="utf-8"))
+
+
 @ModelBase.register("Qwen4ExpForConditionalGeneration", "Qwen4ExpForCausalLM")
 @ModelBase.example("Qwen/Qwen3.8-Flash-Next")
 class Qwen4ExpTextModel(_Qwen35MRopeMixin, _LinearAttentionVReorderBase):
@@ -77,16 +101,39 @@ class Qwen4ExpTextModel(_Qwen35MRopeMixin, _LinearAttentionVReorderBase):
         self.gguf_writer.add_hyper_connection_low_rank(hp["hc_lowrank"])
 
         n_layer = hp["num_hidden_layers"]
-        self.gguf_writer.add_indexer_head_count(hp["indexer_n_heads"])
-        self.gguf_writer.add_indexer_key_length(hp["indexer_head_dim"])
-        self.gguf_writer.add_indexer_top_k(hp["indexer_budget"])
-        ratio = hp["indexer_compress_ratio"]
-        layer_types = hp["layer_types"]
-        # the MTP block is a full-attention QSA layer too
-        self.gguf_writer.add_attention_compress_ratios(
-            [ratio if layer_types[i] == "full_attention" else 0 for i in range(n_layer)]
-            + [ratio] * (self.block_count - n_layer)
+        # the indexer is optional by presence: a dense checkpoint without QSA carries no indexer keys
+        if "indexer_n_heads" in hp:
+            self.gguf_writer.add_indexer_head_count(hp["indexer_n_heads"])
+            self.gguf_writer.add_indexer_key_length(hp["indexer_head_dim"])
+            self.gguf_writer.add_indexer_top_k(hp["indexer_budget"])
+            ratio = hp["indexer_compress_ratio"]
+            layer_types = hp["layer_types"]
+            # the HF text config spells an indexed layer "full_attention"/"indexed_attention"
+            # or the canonical "qwen_sparse_attention"; Qwen4ExpTextConfig.__post_init__
+            # rewrites the first to the last, so accept all three spellings.
+            # The MTP block is a full-attention QSA layer too.
+            def is_indexed(t: str) -> bool:
+                return t in ("full_attention", "indexed_attention", "qwen_sparse_attention")
+            self.gguf_writer.add_attention_compress_ratios(
+                [ratio if is_indexed(layer_types[i]) else 0 for i in range(n_layer)]
+                + [ratio] * (self.block_count - n_layer)
+            )
+
+        # the dense/MoE rule, as vLLM reads it; absent keys mean all-MoE when experts exist
+        mlp_only = {int(i) for i in hp.get("mlp_only_layers", [])}
+        if mlp_only and any(i < 0 or i >= n_layer for i in mlp_only):
+            raise ValueError(f"mlp_only_layers {sorted(mlp_only)} is out of range for {n_layer} layers")
+        # the MTP block follows the checkpoint: a dense checkpoint carries no routed expert
+        # tensors, so its MTP block is dense too (the HF mlp_only_layers list is trunk-only)
+        has_experts = any(".mlp.experts" in name for name in self.model_tensors)
+        mtp_dense = not has_experts
+        self.gguf_writer.add_mlp_only_layers(
+            [i in mlp_only for i in range(n_layer)] + [mtp_dense] * (self.block_count - n_layer)
         )
+        step = int(hp.get("decoder_sparse_step", 1))
+        if step < 1:
+            raise ValueError(f"decoder_sparse_step must be at least 1, got {step}")
+        self.gguf_writer.add_moe_every_n_layers(step)
 
         # ple_layer_ids is 1-based in the HF config; empty means no n-gram table,
         # so emit no PLE keys rather than optional ones
