+void llama_kv_cache::set_input_port_pos(ggml_tensor * dst_k, ggml_tensor * dst_q, ggml_tensor * dst_c, ggml_tensor * dst_r,
+                                        const llama_ubatch * ubatch, uint32_t kv_off) const {
+    GGML_ASSERT(dst_k->type == GGML_TYPE_I32 && dst_q->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst_c->type == GGML_TYPE_I8 && dst_r->type == GGML_TYPE_I8);
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst_k->buffer) && ggml_backend_buffer_is_host(dst_q->buffer));
+
+    const int64_t n_kv = dst_k->ne[0];
+    const auto & cells = v_cells.at(seq_to_stream.at(ubatch->seq_id[0][0]));
+
+    int32_t * kd = (int32_t *) dst_k->data;
+    int8_t  * cd = (int8_t  *) dst_c->data;
+    for (int64_t j = 0; j < n_kv; ++j) {
+        kd[j] = cells.is_empty(kv_off + j) ? -1 : cells.pos_get(kv_off + j);
+    }
+    for (int64_t g = 0; g < dst_c->ne[0]; ++g) {
+        const int64_t lo = g * 16, hi = std::min((g + 1) * 16, n_kv);
+        bool lin = kd[lo] >= 0;
+        for (int64_t j = lo + 1; j < hi && lin; ++j) {
+            lin = kd[j] >= 0 && kd[j] == kd[j - 1] + 1;
+        }
+        cd[g] = lin;
+    }
+
+    int32_t * qd = (int32_t *) dst_q->data;
+    int8_t  * rd = (int8_t  *) dst_r->data;
+    const int64_t n_q = dst_q->ne[0];
+    for (int64_t i = 0; i < n_q; ++i) {
+        qd[i] = ubatch->pos[i];
+    }
+    for (int64_t g = 0; g < dst_r->ne[0]; ++g) {
+        const int64_t lo = g * 8, hi = std::min((g + 1) * 8, n_q);
+        bool lin = qd[lo] >= 0;
+        for (int64_t i = lo + 1; i < hi && lin; ++i) {
+            lin = qd[i] >= 0 && qd[i] == qd[i - 1] + 1 && ubatch->seq_id[i][0] == ubatch->seq_id[i - 1][0];
+        }
+        rd[g] = lin;
+    }
+}
+
