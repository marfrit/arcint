@@ -3449,6 +3488,11 @@ void llama_kv_cache_context::set_input_relative_pos(ggml_tensor * dst, const lla
     kv->set_input_relative_pos(dst, ubatch, extent, sinfos.empty() ? 0 : sinfos[i_cur].kv_off);
 }
 
