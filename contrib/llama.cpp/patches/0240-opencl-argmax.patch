+// 0240: GGML_OP_ARGMAX on the device. GGML_OPENCL_ARGMAX=0 leaves the op to the CPU (the A/B arm and the red case
+// of the scheduler test); GGML_OPENCL_ARGMAX_RED=1 / 2 builds the red kernels of the tie tests (argmax.cl).
+static bool ggml_cl_argmax_on() {
+    static const char * e  = getenv("GGML_OPENCL_ARGMAX");
+    static const bool   on = e == nullptr || atoi(e) != 0;
+    return on;
+}
+
+static void load_cl_kernels_argmax(ggml_backend_opencl_context * backend_ctx) {
+    if (backend_ctx->kernels_loaded_argmax) {
+        return;
+    }
+    backend_ctx->kernels_loaded_argmax = true;
+    static const char * re  = getenv("GGML_OPENCL_ARGMAX_RED");
+    static const int    red = re != nullptr ? atoi(re) : 0;
+#ifdef GGML_OPENCL_EMBED_KERNELS
+    const std::string kernel_src {
+        #include "argmax.cl.h"
+    };
+#else
+    const std::string kernel_src = read_file("argmax.cl");
+#endif
+    // the work-group: 256 lanes, halved until the device's and the built kernel's own limits take it (the local arrays
+    // are sized by ARGMAX_WG, so a smaller group is a rebuild). A program that does not build leaves the op to the CPU
+    // with a downgrade line, not an abort.
+    int wg = 256;
+    while (wg > 1 && (size_t) wg > backend_ctx->max_workgroup_size) {
+        wg /= 2;
+    }
+    for (;;) {
+        // no fast-math options: the scan starts at -INFINITY and must order -inf as the CPU does
+        const std::string compile_opts = std::string("-cl-std=CL") + std::to_string(backend_ctx->opencl_c_version.major) + "." +
+                                         std::to_string(backend_ctx->opencl_c_version.minor) + " -DARGMAX_WG=" +
+                                         std::to_string(wg) + " -DARGMAX_RED=" + std::to_string(red);
+        cl_program prog = build_program_from_source_optional(backend_ctx, kernel_src.c_str(), compile_opts);
+        cl_int     err  = CL_SUCCESS;
+        cl_kernel  k    = prog != nullptr ? clCreateKernel(prog, "kernel_argmax_f32", &err) : nullptr;
+        if (prog == nullptr || err != CL_SUCCESS || k == nullptr) {
+            if (prog != nullptr) {
+                clReleaseProgram(prog);
+            }
+            ggml_cl_downgrade("op=ARGMAX type=f32 path=cpu reason=no-kernel (argmax.cl did not build, WG %d)", wg);
+            return;
+        }
+        const size_t kmax = backend_ctx->get_kernel_workgroup_size(k);
+        if ((size_t) wg <= kmax || wg == 1) {
+            backend_ctx->program_argmax    = prog;
+            backend_ctx->kernel_argmax_f32 = k;
+            break;
+        }
+        clReleaseKernel(k);
+        clReleaseProgram(prog);
+        while (wg > 1 && (size_t) wg > kmax) {
+            wg /= 2;
+        }
+    }
+    backend_ctx->argmax_wg = wg;
+    GGML_LOG_INFO("ggml_opencl: ARGMAX on the device (a tie: the last maximum, ggml's CPU rule), %d lanes a row%s\n", wg,
+                  red == 1 ? " -- RED CASE 1: the lowest index on a tie" : red == 2 ? " -- RED CASE 2: the lower lane wins a tie" : "");
+}
