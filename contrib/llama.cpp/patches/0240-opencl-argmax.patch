index 0000000..cf221a4
--- /dev/null
+++ b/tests/test-opencl-argmax-sched.cpp
@@ -0,0 +1,114 @@
+// 0240: one DSpark Markov step as the scheduler places it, on the card. Built, not a ctest case (it needs the
+// device); run by name:
+//   test-opencl-argmax-sched [w1-f32 | w1-bf16-host]
+// The graph: a 200,058-float column (Inkling 2's vocabulary) -> ARGMAX -> GET_ROWS of markov_w1 [256 x 200,058]
+// with that id -> a device op (SCALE) -> the output, scheduled over the OpenCL and the CPU backends as llama.cpp
+// schedules a drafter graph (op_offload on). The column and w1 are weights in their backends' buffers.
+//   w1-f32        w1 F32 in an OpenCL buffer (the converter's F32 copy): expect ONE split and no node on the CPU
+//   w1-bf16-host  w1 BF16 in host memory (today's drafter: the loader keeps it there, OpenCL's GET_ROWS takes no
+//                 BF16): expect the GET_ROWS on the CPU, i.e. this run FAILS (its red case)
+// GGML_OPENCL_ARGMAX=0 (the op left to the CPU) makes the w1-f32 run fail too (the ARGMAX's red case).
+// Also checks the answer: the id is the column's LAST maximum (ggml's CPU rule; the column carries a tie at
+// 200,057, the V mod 4 = 2 tail), and the row is w1's row of that id, exact.
+// Exit 0 only with one split, no CPU node and the right answer. The first GPU device is taken: run it with the
+// card pinned (ZE_AFFINITY_MASK) on a host with two.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    const std::string mode = argc > 1 ? argv[1] : "w1-f32";
+    const bool w1_host = mode == "w1-bf16-host";
+    if (!w1_host && mode != "w1-f32") { fprintf(stderr, "usage: %s [w1-f32 | w1-bf16-host]\n", argv[0]); return 2; }
+    const int V = 200058, R = 256;
+
+    ggml_backend_dev_t gd = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (!gd) { fprintf(stderr, "no GPU device\n"); return 2; }
+    ggml_backend_t gpu = ggml_backend_dev_init(gd, nullptr);
+    ggml_backend_t cpu = ggml_backend_cpu_init();
+    printf("SCHED device: %s (%s), mode %s\n", ggml_backend_dev_name(gd), ggml_backend_dev_description(gd), mode.c_str());
+
+    ggml_init_params wp = { 8 * ggml_tensor_overhead(), nullptr, true };
+    ggml_context * cg = ggml_init(wp);   // device weights
+    ggml_context * ch = ggml_init(wp);   // host weights
+    ggml_tensor * col = ggml_new_tensor_2d(cg, GGML_TYPE_F32, V, 1);
+    ggml_set_name(col, "col");
+    ggml_tensor * w1 = w1_host ? ggml_new_tensor_2d(ch, GGML_TYPE_BF16, R, V) : ggml_new_tensor_2d(cg, GGML_TYPE_F32, R, V);
+    ggml_set_name(w1, "markov_w1.weight");
+    ggml_backend_buffer_t bg = ggml_backend_alloc_ctx_tensors(cg, gpu);
+    ggml_backend_buffer_t bh = w1_host ? ggml_backend_alloc_ctx_tensors(ch, cpu) : nullptr;
+    ggml_backend_buffer_set_usage(bg, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    if (bh) ggml_backend_buffer_set_usage(bh, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // the column: distinct values, a tie at the maximum between V / 3 and V - 1 (the answer: V - 1)
+    std::mt19937 rng(218);
+    std::vector<float> c(V);
+    for (int i = 0; i < V; ++i) c[i] = (float) i;
+    std::shuffle(c.begin(), c.end(), rng);
+    c[V / 3] = (float) V; c[V - 1] = (float) V;
+    ggml_backend_tensor_set(col, c.data(), 0, sizeof(float) * V);
+    // w1: integers below 256, exact in bfloat16, so the two modes' rows are the same values and only the placement
+    // differs
+    std::vector<float> w1f((size_t) R * V);
+    for (int k = 0; k < V; ++k) for (int j = 0; j < R; ++j) w1f[(size_t) k * R + j] = (float) ((k * 31 + j) % 256);
+    if (w1_host) {
+        std::vector<ggml_bf16_t> b(w1f.size());
+        for (size_t i = 0; i < w1f.size(); ++i) b[i] = ggml_fp32_to_bf16(w1f[i]);
+        ggml_backend_tensor_set(w1, b.data(), 0, b.size() * sizeof(ggml_bf16_t));
+    } else {
+        ggml_backend_tensor_set(w1, w1f.data(), 0, w1f.size() * sizeof(float));
+    }
+
+    ggml_init_params gp = { 64 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * cx = ggml_init(gp);
+    ggml_tensor * prev = ggml_argmax(cx, col);
+    ggml_set_name(prev, "prev");
+    ggml_tensor * row = ggml_get_rows(cx, w1, prev);
+    ggml_set_name(row, "w1_prev");
+    ggml_tensor * out = ggml_scale(cx, row, 1.0f);
+    ggml_set_name(out, "out");
+    ggml_set_output(out);
+    ggml_set_output(prev);
+    ggml_cgraph * gf = ggml_new_graph(cx);
+    ggml_build_forward_expand(gf, out);
+
+    ggml_backend_t backends[2] = { gpu, cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, 2, GGML_DEFAULT_GRAPH_SIZE, false, true);
+    if (!ggml_backend_sched_alloc_graph(sched, gf)) { fprintf(stderr, "alloc failed\n"); return 2; }
+    const int n_splits = ggml_backend_sched_get_n_splits(sched);
+    int cpu_nodes = 0;
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * n = ggml_graph_node(gf, i);
+        ggml_backend_t b = ggml_backend_sched_get_tensor_backend(sched, n);
+        const bool on_cpu = b == cpu;
+        cpu_nodes += on_cpu;
+        printf("SCHED node %d %-10s %-18s on %s\n", i, ggml_op_desc(n), n->name, b ? ggml_backend_name(b) : "?");
+    }
+    if (ggml_backend_sched_graph_compute(sched, gf) != GGML_STATUS_SUCCESS) { fprintf(stderr, "compute failed\n"); return 2; }
+    int32_t id = -1;
+    ggml_backend_tensor_get(prev, &id, 0, sizeof(id));
+    std::vector<float> got(R);
+    ggml_backend_tensor_get(out, got.data(), 0, sizeof(float) * R);
+    bool row_ok = id >= 0 && id < V;
+    for (int j = 0; row_ok && j < R; ++j) row_ok = got[j] == w1f[(size_t) id * R + j];
+    const bool id_ok = id == V - 1;
+    printf("SCHED splits %d, CPU nodes %d | id %d (expect %d: the last maximum) %s | w1's row %s\n", n_splits, cpu_nodes, id,
+           V - 1, id_ok ? "right" : "WRONG", row_ok ? "exact" : "WRONG");
+    const bool pass = n_splits == 1 && cpu_nodes == 0 && id_ok && row_ok;
+    printf("SCHED %s\n", pass ? "PASS: one split, the step on the device" : "FAIL");
+    ggml_backend_sched_free(sched);
+    ggml_free(cx);
+    ggml_backend_buffer_free(bg); if (bh) ggml_backend_buffer_free(bh);
+    ggml_free(cg); ggml_free(ch);
+    ggml_backend_free(gpu); ggml_backend_free(cpu);
+    return pass ? 0 : 1;
+}
