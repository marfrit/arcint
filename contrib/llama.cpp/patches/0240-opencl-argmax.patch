+// 0240: GGML_OP_ARGMAX with ties at the maximum, one tie pattern a row, against the CPU backend's rule (the LAST
+// maximum, ggml-cpu/vec.h ggml_vec_argmax_f32). Row 0: a tie with the last element (the V mod 4 = 2 tail of the
+// vocabulary); row 1: two neighbouring indices in the middle (two lanes of one work-group); row 2: two indices one
+// work-group stride apart (one lane); row 3: every element equal (the answer is the last index). The rest of a row
+// is a shuffle of distinct values below the tie. A kernel that takes the lowest index, or lets a lower lane win
+// a tie, fails rows 0-3. With pad > 0 the rows are a view with a row stride of ne0 + pad floats that starts one row
+// into its tensor (a view offset: a kernel that ignores it reads the decoy row 0, whose maximum is elsewhere).
+struct test_argmax_tie : public test_case {
+    const int64_t ne0;
+    const int64_t pad;
+
+    std::string vars() override {
+        return VARS_TO_STR2(ne0, pad);
+    }
+
+    test_argmax_tie(int64_t ne0 = 200058, int64_t pad = 0) : ne0(ne0), pad(pad) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne0 + pad, pad > 0 ? 5 : 4);
+        ggml_set_name(a, "a");
+        ggml_tensor * v = pad > 0 ? ggml_view_2d(ctx, a, ne0, 4, a->nb[1], a->nb[1]) : a;
+        ggml_tensor * out = ggml_argmax(ctx, v);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        std::default_random_engine rng(218);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->view_src != nullptr) {
+                continue;
+            }
+            if (strcmp(t->name, "a") != 0) {
+                init_tensor_uniform(t);   // the framework's other tensors (the sentinels): not the case's rows
+                continue;
+            }
+            const int64_t w = t->ne[0];
+            const int64_t mid = (ne0 / 2) & ~(int64_t) 1;   // an even index: the pair sits in an even and the next odd lane, so a lower-lane-wins tree meets them in that order
+            const int64_t pairs[3][2] = { { ne0 / 3, ne0 - 1 }, { mid, mid + 1 }, { ne0 / 5, ne0 / 5 + 256 } };
+            const int64_t r0 = t->ne[1] - 4;   // 1 for the view (row 0 a decoy), else 0
+            if (r0 > 0) {
+                std::vector<float> decoy(w);
+                for (int64_t i = 0; i < w; i++) {
+                    decoy[i] = (float) ((i * 7) % ne0);
+                }
+                decoy[3] = (float) (3 * ne0);   // the decoy's maximum at index 3, which no real row's answer is
+                ggml_backend_tensor_set(t, decoy.data(), 0, w * sizeof(float));
+            }
+            for (int64_t r = 0; r < 4; r++) {
+                std::vector<float> data(w);
+                for (int64_t i = 0; i < w; i++) {
+                    data[i] = (float) i;
+                }
+                std::shuffle(data.begin(), data.begin() + ne0, rng);
+                if (r < 3) {
+                    data[pairs[r][0]] = (float) ne0;
+                    data[pairs[r][1]] = (float) ne0;
+                } else {
+                    for (int64_t i = 0; i < ne0; i++) {
+                        data[i] = 7.0f;
+                    }
+                }
+                for (int64_t i = ne0; i < w; i++) {
+                    data[i] = (float) (2 * ne0);   // the pad: above every real value; a kernel that reads it is wrong
+                }
+                ggml_backend_tensor_set(t, data.data(), (r0 + r) * t->nb[1], w * sizeof(float));
+            }
+        }
+    }
+
+    double max_nmse_err() override {
+        return 0.0;
+    }
+};
