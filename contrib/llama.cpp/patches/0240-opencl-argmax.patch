diff --git a/ggml/src/ggml-opencl/kernels/argmax.cl b/ggml/src/ggml-opencl/kernels/argmax.cl
new file mode 100644
index 0000000..0b62d68
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/argmax.cl
@@ -0,0 +1,58 @@
+// 0240: GGML_OP_ARGMAX, F32 rows -> one I32 index a row, ggml's CPU rule (ggml-cpu/vec.h ggml_vec_argmax_f32):
+// the LAST maximum wins a tie ("max = MAX(max, x[i]); if (max == x[i]) idx = i"). One work-group a row, ARGMAX_WG
+// lanes (the host's choice, a power of two <= 256): lane l scans l, l + WG, ... in index order and keeps a value
+// that is >= its best (an equal value moves the index forward, as the CPU loop does), then the lanes combine in a
+// tree where the larger value wins and an equal value keeps the larger index. The result is the CPU loop's for every
+// row without a NaN; a NaN is never selected here (the CPU loop's MAX lets one reset its running maximum): a NaN in
+// logits is a failure on both paths. Built without the fast-math options: the scan starts at -INFINITY and a row of
+// -inf must give the CPU's answer (its last index).
+// ARGMAX_RED (the red cases of the op's tests, GGML_OPENCL_ARGMAX_RED): 1 = the lowest index on a tie (torch's rule),
+// 2 = the lower lane wins a tie in the tree whatever its index (a reduction-order kernel). Both must fail the tie cases.
+#ifndef ARGMAX_WG
+#define ARGMAX_WG 256
+#endif
+#ifndef ARGMAX_RED
+#define ARGMAX_RED 0
+#endif
+
+kernel void kernel_argmax_f32(global const char * src0, ulong offset0, global char * dst, ulong offsetd, int ne00,
+                              ulong nb01) {
+    local float lv[ARGMAX_WG];
+    local int   li[ARGMAX_WG];
+    const int row = get_group_id(0);
+    const int l   = get_local_id(0);
+    global const float * x = (global const float *) (src0 + offset0 + (ulong) row * nb01);
+    float bv = -INFINITY;
+    int   bi = -1;   // a lane with no element never wins a tie
+    for (int i = l; i < ne00; i += ARGMAX_WG) {
+        const float v = x[i];
+#if ARGMAX_RED == 1
+        if (v > bv || bi < 0) { bv = v; bi = i; }
+#else
+        if (v >= bv) { bv = v; bi = i; }
+#endif
+    }
+    lv[l] = bv; li[l] = bi;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int s = ARGMAX_WG / 2; s > 0; s >>= 1) {
+        if (l < s) {
+            const float ov = lv[l + s];
+            const int   oi = li[l + s];
+            const float mv = lv[l];
+            const int   mi = li[l];
+#if ARGMAX_RED == 1
+            const bool take = oi >= 0 && (mi < 0 || ov > mv || (ov == mv && oi < mi));
+#elif ARGMAX_RED == 2
+            const bool take = oi >= 0 && (mi < 0 || ov > mv);
+#else
+            const bool take = oi >= 0 && (mi < 0 || ov > mv || (ov == mv && oi > mi));
+#endif
+            if (take) { lv[l] = ov; li[l] = oi; }
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (l == 0) {
+        global int * d = (global int *) (dst + offsetd);
+        d[row] = li[0] < 0 ? 0 : li[0];
+    }
+}
