+// 0209: the Q8_0 / Q4_0 branches of set_tensor return for a view (or a non-contiguous tensor) without
+// writing: a split base's bytes live in its scales and quants, which a byte range of the block layout
+// does not map onto. That return was silent, and a checkpoint resume's K/V writes went through it at
+// q8_0 K/V; since 0209 only a view of a split base (or a weights buffer's view) comes there. Once a
+// process per type, so a path that still lands there shows in the log.
+static void ggml_cl_warn_view_write_dropped(const ggml_tensor * tensor, ggml_backend_buffer_t buffer) {
+    static std::atomic<bool> warned_q8_0{false};
+    static std::atomic<bool> warned_q4_0{false};
+    std::atomic<bool> & warned = tensor->type == GGML_TYPE_Q8_0 ? warned_q8_0 : warned_q4_0;
+    if (warned.exchange(true)) {
