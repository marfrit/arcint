+    }
+    const ggml_tensor * base = tensor->view_src != nullptr ? tensor->view_src : tensor;
+    GGML_LOG_WARN("ggml_opencl: set_tensor: a view write into a split q8_0/q4_0 tensor was not performed "
+                  "(tensor '%s', type %s, base '%s', %s buffer); logged once per process and type\n",
+                  tensor->name, ggml_type_name(tensor->type), base->name,
+                  ggml_backend_buffer_get_usage(buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS ? "weights" : "non-weights");
+}
