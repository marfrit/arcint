index 0000000..4b48168
--- /dev/null
+++ b/tools/qwen4-dense-fixture-compare.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Compare a converted dense qwen4exp GGUF with the fixture script's own GGUF.
+
+Compares every tensor (names, shapes, values) and every qwen4exp.* metadata key.
+Tokenizer keys are not compared: the fixture ships a minimal byte-level BPE for
+the converter's set_vocab, while the fixture GGUF keeps the byte-fallback vocab
+the loader test uses.
+
+    python3 tools/qwen4-dense-fixture-compare.py <fixture.gguf> <converted.gguf>
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(1, str(REPO / "gguf-py"))
+import gguf  # noqa: E402
+
+
+def load(path: Path) -> gguf.GGUFReader:
+    return gguf.GGUFReader(str(path))
+
+
+def field_value(field) -> object:
+    # GGUFReader Field.contents() handles scalar and array types
+    return field.contents()
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print(__doc__.strip().splitlines()[0], file=sys.stderr)
+        print("usage: qwen4-dense-fixture-compare.py <fixture.gguf> <converted.gguf>", file=sys.stderr)
+        return 2
+    a, b = load(Path(sys.argv[1])), load(Path(sys.argv[2]))
+    bad = 0
+
+    ta = {t.name: t for t in a.tensors}
+    tb = {t.name: t for t in b.tensors}
+    only_a = sorted(set(ta) - set(tb))
+    only_b = sorted(set(tb) - set(ta))
+    if only_a or only_b:
+        bad += 1
+        print(f"tensor names differ: only in fixture {only_a[:20]}, only in converted {only_b[:20]}")
+
+    for name in sorted(set(ta) & set(tb)):
+        xa, xb = ta[name], tb[name]
+        if tuple(xa.shape) != tuple(xb.shape):
+            bad += 1
+            print(f"shape {name}: fixture {xa.shape} converted {xb.shape}")
+            continue
+        da = np.asarray(xa.data)
+        db = np.asarray(xb.data)
+        if not np.allclose(da, db, rtol=1e-5, atol=1e-6, equal_nan=True):
+            bad += 1
+            diff = np.abs(da - db)
+            print(f"FAIL values {name}: max abs diff {np.max(np.abs(diff)):.6g} "
+                  f"(mean {np.mean(diff):.6g}, {np.count_nonzero(diff)}/{diff.size} elements differ)")
+            continue
+        if not np.array_equal(da, db):
+            # exactness only: torch and numpy libm can differ by one ulp, and a permutation
+            # never reaches this branch because allclose above fails it
+            print(f"note {name}: not bit-identical, within tolerance")
+
+    ka = {k: field_value(v) for k, v in a.fields.items() if k.startswith("qwen4exp.")}
+    kb = {k: field_value(v) for k, v in b.fields.items() if k.startswith("qwen4exp.")}
+    only_a = sorted(set(ka) - set(kb))
+    only_b = sorted(set(kb) - set(ka))
+    if only_a or only_b:
+        bad += 1
+        print(f"qwen4exp keys differ: only in fixture {only_a}, only in converted {only_b}")
+    for key in sorted(set(ka) & set(kb)):
+        va, vb = ka[key], kb[key]
+        same = np.array_equal(np.asarray(va), np.asarray(vb)) if isinstance(va, (list, tuple, np.ndarray)) else va == vb
+        if not same:
+            bad += 1
+            print(f"key {key}: fixture {va} converted {vb}")
+
+    if bad:
+        print(f"FAIL: {bad} difference(s)")
+        return 1
+    print(f"OK: {len(ta)} tensors, {len(ka)} qwen4exp.* keys identical")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/qwen4-dense-fixture.py b/tools/qwen4-dense-fixture.py
