diff --git a/tools/qwen4-dense-fixture-check.sh b/tools/qwen4-dense-fixture-check.sh
new file mode 100755
index 0000000..9d8fe75
--- /dev/null
+++ b/tools/qwen4-dense-fixture-check.sh
@@ -0,0 +1,93 @@
+#!/bin/bash
+# A dense qwen4exp GGUF must load and run on the CPU. RED before the dense path
+# (the MoE-only loader divides by expert_used=0 or trips the ffn_gate_inp assert),
+# GREEN after it.
+#   LLAMA_BIN_DIR  directory holding llama-perplexity (default: build/bin)
+#   WORK            output directory (default: a fresh mktemp -d)
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+bin=${LLAMA_BIN_DIR:-"$here/../build/bin"}
+work=${WORK:-$(mktemp -d)}
+trap 'rm -rf "$work"' EXIT INT TERM  2>/dev/null || true
+mkdir -p "$work"
+
+python3 "$here/qwen4-v-reorder-check.py"
+python3 "$here/qwen4-dense-fixture.py" --out "$work" >/dev/null
+python3 - "$work/text.txt" <<'PY'
+import sys
+open(sys.argv[1], "w").write("aaaa bbbb cccc dddd " * 100)
+PY
+
+run_arm() {
+    local name=$1 dir=$2 file=${3:-qwen4-dense-fixture.gguf}
+    local gguf="$dir/$file" log="$work/load-$name.log"
+    if ! "$bin/llama-perplexity" -m "$gguf" -f "$work/text.txt" -c 128 -b 16 -t 2 -v >"$log" 2>&1; then
+        echo "RED: the $name dense fixture did not load or run; log tail:" >&2
+        tail -5 "$log"
+        exit 1
+    fi
+    grep -Eq "0 of [0-9]+ layers are MoE, [0-9]+ dense MLP" "$log" || {
+        echo "FAIL: the $name load log does not classify the layers as dense" >&2; exit 1; }
+    local ppl
+    ppl=$(sed -n 's/.*Final estimate: PPL = \([-0-9.]*\).*/\1/p' "$log" | tail -1)
+    case "$ppl" in
+        ""|nan|inf|Inf) echo "FAIL: no finite perplexity on the $name fixture" >&2; exit 1 ;;
+    esac
+    echo "$ppl"
+}
+
+# the mixed arm: a QSA layer beside a full-attention layer without indexer tensors
+ppl_mixed=$(run_arm mixed "$work")
+grep -q "layer 4 has no QSA indexer tensors, running dense attention" "$work/load-mixed.log" || {
+    echo "FAIL: the load log does not name the layer without an indexer" >&2; exit 1; }
+
+# the no-QSA arm: no indexer keys and no indexer tensors, dense attention everywhere
+python3 "$here/qwen4-dense-fixture.py" --out "$work/no-qsa" --no-qsa >/dev/null
+cp "$work/text.txt" "$work/no-qsa/text.txt"
+ppl_noqsa=$(run_arm no-qsa "$work/no-qsa")
+
+# the MTP arm: the trunk plus one in-model nextn block, as qwen35 / Flash-Next carry it.
+# The trunk loads with the MTP tensors resident; llama-cli --spec-type draft-mtp then builds
+# and runs the MTP graph, which perplexity does not.
+python3 "$here/qwen4-dense-fixture.py" --out "$work/mtp" --mtp >/dev/null
+cp "$work/text.txt" "$work/mtp/text.txt"
+ppl_mtp=$(run_arm mtp "$work/mtp" qwen4-dense-fixture-mtp.gguf)
+grep -q "loading tensor blk.6.nextn.eh_proj.weight" "$work/load-mtp.log" || {
+    echo "FAIL: the MTP arm did not load the nextn block" >&2; exit 1; }
+grep -q "loading tensor blk.6.nextn.shared_head_norm.weight" "$work/load-mtp.log" || {
+    echo "FAIL: the MTP arm did not load the optional shared_head_norm" >&2; exit 1; }
+grep -q "n_layer_all           = 7" "$work/load-mtp.log" || {
+    echo "FAIL: the MTP arm does not count the nextn block as layer 6" >&2; exit 1; }
+
+mtp_log="$work/mtp-graph.log"
+if ! "$bin/llama-cli" -m "$work/mtp/qwen4-dense-fixture-mtp.gguf" -p "aaaa" -n 2 -c 64 \
+        --no-warmup -v --spec-type draft-mtp >"$mtp_log" 2>&1; then
+    echo "FAIL: the MTP graph did not run; log tail:" >&2; tail -5 "$mtp_log"; exit 1
+fi
+grep -q "node 'mtp_tok_embd-6'" "$mtp_log" && grep -q "node 'mtp_h_input" "$mtp_log" || {
+    echo "FAIL: the MTP arm did not build the nextn graph" >&2; exit 1; }
+
+# the converter's GGUF, when given, must give the same logits as the fixture's own GGUF.
+# Both files carry the same byte-level tokenizer and the same weights, so a reorder or a
+# key difference shows up as nonzero KL rather than a load error.
+if [ -n "${CONVERTED_GGUF:-}" ]; then
+    base_logits="$work/fixture.logits"
+    if ! "$bin/llama-perplexity" -m "$work/qwen4-dense-fixture.gguf" -f "$work/text.txt" \
+            -c 128 -b 16 -t 2 --save-all-logits "$base_logits" >"$work/logits-fixture.log" 2>&1; then
+        echo "FAIL: could not write the fixture's logits" >&2; tail -5 "$work/logits-fixture.log"; exit 1
+    fi
+    if ! "$bin/llama-perplexity" -m "$CONVERTED_GGUF" -f "$work/text.txt" \
+            -c 128 -b 16 -t 2 --kl-divergence --kl-divergence-base "$base_logits" >"$work/logits-converted.log" 2>&1; then
+        echo "FAIL: the converter's GGUF did not run; log tail:" >&2; tail -5 "$work/logits-converted.log"; exit 1
+    fi
+    kld=$(sed -n 's/^Mean    KLD: *\([-0-9.]*\).*/\1/p' "$work/logits-converted.log" | tail -1)
+    top=$(sed -n 's/^Same top p: *\([-0-9.]*\).*/\1/p' "$work/logits-converted.log" | tail -1)
+    if [ "$kld" != "0.000000" ] && [ "$kld" != "-0.000000" ]; then
+        echo "FAIL: converter GGUF mean KLD is $kld against the fixture GGUF, expected 0" >&2
+        tail -5 "$work/logits-converted.log"; exit 1
+    fi
+    case "$top" in 100*) ;; *) echo "FAIL: same top p is $top, expected 100" >&2; exit 1 ;; esac
+    echo "LOGITS: converter GGUF KLD $kld, same top p $top against the fixture GGUF"
+fi
+
+echo "GREEN: dense qwen4exp fixtures loaded and ran on the CPU, PPL $ppl_mixed (mixed) / $ppl_noqsa (no QSA) / $ppl_mtp (MTP trunk)"
diff --git a/tools/qwen4-dense-fixture-compare.py b/tools/qwen4-dense-fixture-compare.py
