+#!/usr/bin/env python3
+"""Check the linear-attention V-head reorder at ratio 3 and at the frozen ratio 2.
+
+`conversion/qwen.py::_LinearAttentionVReorderBase._reorder_v_heads` turns HF's
+grouped V order [G0_v0..v{r-1}, G1_v0..v{r-1}, ...] into ggml's tiled order
+[K0, K1, ..., K0, K1, ...]. The geometry comes from the text config:
+
+  fixture           2 key / 6 value heads at 32      ratio 3
+  Flash-Next/Qwen4  16 key / 48 value heads at 128   ratio 3   (config.json text_config)
+  Qwen3.5-9B        16 key / 32 value heads at 128   ratio 2   (config.json text_config)
+
+The last row is the pre-existing ratio; its output must stay byte-identical.
+
+The torch half runs the converter's own function when torch is importable (a CPU
+run on a torch host); without torch the numpy reference is still checked.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(1, str(REPO))
+sys.path.insert(1, str(REPO / "gguf-py"))
+
+CASES = [
+    ("fixture", 2, 6, 32),
+    ("flash-next", 16, 48, 128),
+    ("qwen3.5-9b-frozen", 16, 32, 128),
+]
+
+
+def grouped_order(num_k: int, ratio: int, head_dim: int) -> list[int]:
+    # source index of tiled position (v, k, d): HF grouped as (k, v, d)
+    return [((k * ratio + v) * head_dim + d)
+            for v in range(ratio) for k in range(num_k) for d in range(head_dim)]
+
+
+def reorder_reference(x: np.ndarray, num_k: int, num_v: int, head_dim: int) -> np.ndarray:
+    ratio = num_v // num_k
+    assert ratio * num_k * head_dim == x.size
+    return x[np.asarray(grouped_order(num_k, ratio, head_dim))]
+
+
+def main() -> int:
+    bad = 0
+    for name, num_k, num_v, head_dim in CASES:
+        n = num_k * head_dim * (num_v // num_k)
+        x = np.arange(n, dtype=np.float32)
+        y = reorder_reference(x, num_k, num_v, head_dim)
+        ratio = num_v // num_k
+        # tiled order: consecutive rows are the same V head over every K head
+        for k_i in range(num_k):
+            for d in range(head_dim):
+                assert y[k_i * head_dim + d] == x[((k_i * ratio) * head_dim + d)]
+        print(f"numpy OK: {name} {num_k}K/{num_v}V ratio {ratio} head {head_dim}")
+
+        # the fixture's own numpy mirror must agree with the reference
+        import importlib.util
+        spec = importlib.util.spec_from_file_location("qwen4_dense_fixture", REPO / "tools" / "qwen4-dense-fixture.py")
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)  # type: ignore[union-attr]
+        x2 = np.arange(n * 4, dtype=np.float32).reshape(num_k * head_dim * (num_v // num_k), 4)
+        got = mod.reorder_v_heads(x2, 0, num_k, ratio, head_dim)
+        want = x2[np.asarray(grouped_order(num_k, ratio, head_dim))]
+        if not np.array_equal(got, want):
+            bad += 1
+            print(f"FAIL: fixture reorder differs at {name}")
+
+    try:
+        import torch  # noqa: E402
+        from conversion.qwen import _LinearAttentionVReorderBase  # noqa: E402
+    except Exception as e:
+        print(f"SKIP converter half: torch/conversion not importable ({e.__class__.__name__})")
+        if bad:
+            print(f"FAIL: {bad} difference(s)")
+            return 1
+        return 0
+
+    for name, num_k, num_v, head_dim in CASES:
+        n = num_k * head_dim * (num_v // num_k)
+        ratio = num_v // num_k
+        x = torch.arange(n, dtype=torch.float32)
+        got = _LinearAttentionVReorderBase._reorder_v_heads(x, 0, num_k, ratio, head_dim).numpy()
+        want = reorder_reference(np.arange(n, dtype=np.float32), num_k, num_v, head_dim)
+        if not np.array_equal(got, want):
+            bad += 1
+            print(f"FAIL: converter reorder differs at {name} ({num_k}K/{num_v}V ratio {ratio})")
+        else:
+            print(f"converter OK: {name} {num_k}K/{num_v}V ratio {ratio} head {head_dim}")
+
+    if bad:
+        print(f"FAIL: {bad} difference(s)")
+        return 1
+    print("OK: V-head reorder matches the reference at ratio 3 and the frozen ratio 2")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
