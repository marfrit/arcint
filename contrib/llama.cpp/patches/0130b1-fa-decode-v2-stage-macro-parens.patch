                               v3.s0, v3.s1, v3.s2, v3.s3, v3.s4, v3.s5, v3.s6, v3.s7,        \
                               v3.s8, v3.s9, v3.sa, v3.sb, v3.sc, v3.sd, v3.se, v3.sf };      \
-        for (int j = 0; j < 64; ++j) dst[(64 * c64 + j) * BK + key] = vv[j];                   \
