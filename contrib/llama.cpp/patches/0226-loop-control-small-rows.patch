+//------------------------------------------------------------------------------
+// loop_control_small (0226)
+//------------------------------------------------------------------------------
+// Inkling 2 Mini's loop controller at T <= 8 rows (a decode step, a draft's verify rows, a short
+// prompt tail): the reference's own fused case (the vLLM-XPU port's loop_control.sycl, check_rows:
+// 1 .. 8 rows), which 0221 left on the chain.
+//
+//   g   = s_c * (Wd_a . cur) + s_m * (Wd_b . msg)    [64]   s_x = 1/sqrt(mean(x^2) + eps)
+//   out = (cur - tanh(Wf . g) * cur) + tanh(Wg . g) * msg
+//
+// loop_control.cl (0221) owns a work-group a Xe core and keeps g in local memory; at T <= 8 that
+// is ONE work-group, one core reading the control's 2.36 MB of weights. Here the work is spread
+// as the reference spreads it (control_many: a work-group a (row, output) for the down product,
+// a work-item a (row, column) for the up products), in two launches:
+//
+//   kernel_loop_control_gate  one work-group of LCS_GATE_W lanes a (row t, half h, output r):
+//       the half's down product Wd_h[r] . x_h and the half's sum of squares in ONE pass over
+//       the row (the norm folded in as a scale after the product, 0221's algebra), reduced over
+//       the group; the partial s_h * (Wd_h[r] . x_h) goes to the scratch gp [T][2][64].
+//       128 T work-groups; no concat, no normed copy.
+//   kernel_loop_control_out   one lane a column d: g = gp[t][0] + gp[t][1] (uniform), the gain
+//       and forget products, tanh and the combine in registers, out written once. ONE pass over
+//       the two weight rows serves all T rows (the row template TR = 1, 2, 4 or 8 accumulators
+//       a lane; rows past T are the last row again and are not stored).
+//
+// The scratch (512 T bytes) is the only intermediate in global memory; the reference writes the
+// normed inputs, the hidden and the mixed rows.
+//
+// Reds (GGML_OPENCL_LOOP_CONTROL_OPTS=-DLOOP_CONTROL_RED=<n>, loop_control.cl's numbers where
+// the red exists there; 1 - 4 must fail every case, 6 and 7 every case of 2 .. 8 rows):
+//   1 gain and forget swapped in the combine
+//   2 s_c used for both halves (the msg half scaled by cur's sum of squares)
+//   3 the gain's tanh dropped
+//   4 the last sub-group's part of the msg half dropped from the reduction
+//   6 the scratch's row step taken as 64 floats (a row's two halves are 128): rows >= 1 read
+//     another row's partials
+//   7 the tail row not stored (the last of 2 .. 8 rows)
+
+#ifndef LOOP_CONTROL_HOST_REPLAY
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+#define LC_REQD_SG  __attribute__((intel_reqd_sub_group_size(16)))
+#define LC_SGID()   ((int) get_sub_group_id())
+#define LC_LANE()   ((int) get_sub_group_local_id())
+#endif
+
+#ifdef LOOP_CONTROL_HOST_REPLAY
+// the host replay (arcint tests/test_loop_control.cpp) includes this text once a build
+#undef LCS_RANK
+#undef LCS_GATE_W
+#undef LCS_GATE_NSG
+#undef LCS_GP_ROW
+#undef LCS_TG
+#undef LCS_COMBINE
+#undef LCS_OUT
+#endif
+
+#ifndef LOOP_CONTROL_RED
+#define LOOP_CONTROL_RED 0
+#endif
+
+#define LCS_RANK      64
+#define LCS_GATE_W    64                  // lanes a gate work-group (GGML_LOOP_CONTROL_GATE_W)
+#define LCS_GATE_NSG  (LCS_GATE_W/16)
+#if LOOP_CONTROL_RED == 6
+#define LCS_GP_ROW    LCS_RANK
+#else
+#define LCS_GP_ROW    (2*LCS_RANK)        // the scratch: a row's cur half, then its msg half
+#endif
+
+// the combine, in the chain's node order (mul, sub, mul, add)
+#if LOOP_CONTROL_RED == 1
+#define LCS_TG(ag) tanh(ag)
+#define LCS_COMBINE(c, m, tg, tf) ((c) - (tg)*(c)) + (tf)*(m)
+#elif LOOP_CONTROL_RED == 3
+#define LCS_TG(ag) (ag)
+#define LCS_COMBINE(c, m, tg, tf) ((c) - (tf)*(c)) + (tg)*(m)
+#else
+#define LCS_TG(ag) tanh(ag)
+#define LCS_COMBINE(c, m, tg, tf) ((c) - (tf)*(c)) + (tg)*(m)
+#endif
+
+// The gate. Global (LCS_GATE_W, 2*64, T), local (LCS_GATE_W, 1, 1): group id 1 is h*64 + r,
+// group id 2 the row. A lane takes every LCS_GATE_W-th float4 of the half (n_embd is a
+// multiple of 256, the rule's, so every lane runs n_embd/256 chunks).
+LC_REQD_SG
+kernel void kernel_loop_control_gate(
+        global const char * cur,
+        ulong               offc,
+        ulong               nbc1,
+        global const char * msg,
+        ulong               offm,
+        ulong               nbm1,
+        global const char * down,
+        ulong               offw,
+        ulong               nbw1,
+        global char *       gp,
+        ulong               offp,
+        int                 ne0,
+        int                 nt,
+        float               eps,
+        local float *       slm          // [2][LCS_GATE_NSG]: the sub-groups' dot parts, their sums of squares
+) {
+    const int D   = ne0;
+    const int lid = (int) get_local_id(0);
+    const int sg  = LC_SGID();
+    const int hr  = (int) get_global_id(1);
+    const int t   = (int) get_global_id(2);
+    const int h   = hr / LCS_RANK;
+    const int r   = hr % LCS_RANK;
+
+    const global float * xc = (const global float *) (cur + offc + (ulong) t*nbc1);
+    const global float * xm = (const global float *) (msg + offm + (ulong) t*nbm1);
+    const global float * x  = h ? xm : xc;
+    const global float * w  = (const global float *) (down + offw + (ulong) r*nbw1) + h*D;
+
+    float acc = 0.0f, ss = 0.0f;
+    const int n4 = D/4;
+    for (int k = lid; k < n4; k += LCS_GATE_W) {
+        const float4 xv = vload4(k, x);
+#if LOOP_CONTROL_RED == 2
+        const float4 qv = vload4(k, xc);
+#else
+        const float4 qv = xv;                 // the sum of squares takes the floats the product reads
+#endif
+        const float4 wv = vload4(k, w);
+        _Pragma("unroll")
+        for (int e = 0; e < 4; ++e) {
+            acc = fma(wv[e], xv[e], acc);
+            ss  = fma(qv[e], qv[e], ss);
+        }
+    }
+    const float a_sg = sub_group_reduce_add(acc);
+    const float q_sg = sub_group_reduce_add(ss);
+    if (LC_LANE() == 0) {
+        slm[sg]                = a_sg;
+        slm[LCS_GATE_NSG + sg] = q_sg;
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    if (lid == 0) {
+        float a = 0.0f, q = 0.0f;
+        const int na = LCS_GATE_NSG - ((LOOP_CONTROL_RED == 4 && h == 1) ? 1 : 0);
+        for (int p = 0; p < na; ++p) {
+            a += slm[p];
+        }
+        for (int p = 0; p < LCS_GATE_NSG; ++p) {
+            q += slm[LCS_GATE_NSG + p];
+        }
+        const float s = 1.0f/sqrt(q/(float) D + eps);
+        ((global float *) (gp + offp))[(t*2 + h)*LCS_RANK + r] = s*a;
+    }
+}
+
+// The out, TR rows a pass: lane d's gain and forget rows are read once, 8 k a chunk, and every
+// row's two products accumulate beside each other; g's two halves are uniform loads (the same
+// address for every lane) and their sum a uniform add. A row index past nt - 1 is the last row
+// again (the loads stay inside the tensors) and is not stored.
+#define LCS_OUT(TR)                                                                          \
+static void lcs_out_##TR(const global char * cur, ulong nbc1, const global char * msg,      \
+        ulong nbm1, const global char * gain, ulong nbg1, const global char * forget,        \
+        ulong nbf1, const global float * gp, global char * dst, ulong nbd1, int nt, int d) { \
+    const global float * pg = (const global float *) (gain   + (ulong) d*nbg1);              \
+    const global float * pf = (const global float *) (forget + (ulong) d*nbf1);              \
+    float ag[TR], af[TR];                                                                    \
+    _Pragma("unroll")                                                                        \
+    for (int i = 0; i < TR; ++i) {                                                           \
+        ag[i] = 0.0f;                                                                        \
+        af[i] = 0.0f;                                                                        \
+    }                                                                                        \
+    _Pragma("unroll")                                                                        \
+    for (int q = 0; q < LCS_RANK/8; ++q) {                                                   \
+        const float8 wg = vload8(q, pg);                                                     \
+        const float8 wf = vload8(q, pf);                                                     \
+        _Pragma("unroll")                                                                    \
+        for (int i = 0; i < TR; ++i) {                                                       \
+            const int tt = min(i, nt - 1);                                                   \
+            const global float * gr = gp + (ulong) tt*LCS_GP_ROW;                            \
+            const float8 gc = vload8(q, gr);                                                 \
+            const float8 gm = vload8(q, gr + LCS_RANK);                                      \
+            _Pragma("unroll")                                                                \
+            for (int e = 0; e < 8; ++e) {                                                    \
+                const float gv = gc[e] + gm[e];                                              \
+                ag[i] = fma(wg[e], gv, ag[i]);                                               \
+                af[i] = fma(wf[e], gv, af[i]);                                               \
+            }                                                                                \
+        }                                                                                    \
+    }                                                                                        \
+    const int nstore = (LOOP_CONTROL_RED == 7 && nt > 1) ? nt - 1 : nt;                      \
+    _Pragma("unroll")                                                                        \
+    for (int i = 0; i < TR; ++i) {                                                           \
+        const int tt = min(i, nt - 1);                                                       \
+        const float c  = ((const global float *) (cur + (ulong) tt*nbc1))[d];                \
+        const float m  = ((const global float *) (msg + (ulong) tt*nbm1))[d];                \
+        const float tg = LCS_TG(ag[i]);                                                      \
+        const float tf = tanh(af[i]);                                                        \
+        const float o  = LCS_COMBINE(c, m, tg, tf);                                          \
+        if (i < nstore) {                                                                    \
+            ((global float *) (dst + (ulong) i*nbd1))[d] = o;                                \
+        }                                                                                    \
+    }                                                                                        \
+}
+
+LCS_OUT(1)
+LCS_OUT(2)
+LCS_OUT(4)
+LCS_OUT(8)
+
+// Global (n_embd), local (GGML_LOOP_CONTROL_OUT_W): a work-item a column. tr is the plan's row
+// template (the least of 1, 2, 4, 8 that holds nt), uniform over the launch.
+LC_REQD_SG
+kernel void kernel_loop_control_out(
+        global const char * cur,
+        ulong               offc,
+        ulong               nbc1,
+        global const char * msg,
+        ulong               offm,
+        ulong               nbm1,
+        global const char * gain,
+        ulong               offg,
+        ulong               nbg1,
+        global const char * forget,
+        ulong               offf,
+        ulong               nbf1,
+        global const char * gp,
+        ulong               offp,
+        global char *       dst,
+        ulong               offd,
+        ulong               nbd1,
+        int                 ne0,
+        int                 nt,
+        int                 tr
+) {
+    const int d = (int) get_global_id(0);
+    if (d >= ne0) {
+        return;
+    }
+    cur    = cur    + offc;
+    msg    = msg    + offm;
+    gain   = gain   + offg;
+    forget = forget + offf;
+    dst    = dst    + offd;
+    const global float * g = (const global float *) (gp + offp);
+
+    if (tr == 1) {
+        lcs_out_1(cur, nbc1, msg, nbm1, gain, nbg1, forget, nbf1, g, dst, nbd1, nt, d);
+    } else if (tr == 2) {
+        lcs_out_2(cur, nbc1, msg, nbm1, gain, nbg1, forget, nbf1, g, dst, nbd1, nt, d);
+    } else if (tr == 4) {
+        lcs_out_4(cur, nbc1, msg, nbm1, gain, nbg1, forget, nbf1, g, dst, nbd1, nt, d);
+    } else {
+        lcs_out_8(cur, nbc1, msg, nbm1, gain, nbg1, forget, nbf1, g, dst, nbd1, nt, d);
+    }
+}
