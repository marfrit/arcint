+    plan->small  = plan->nt <= GGML_LOOP_CONTROL_SMALL_ROWS;
+    plan->out_tr = plan->nt <= 1 ? 1 : plan->nt <= 2 ? 2 : plan->nt <= 4 ? 4 : 8;
+    plan->gate_gws[0] = GGML_LOOP_CONTROL_GATE_W;
+    plan->gate_gws[1] = (uint64_t) 2*GGML_LOOP_CONTROL_RANK;
+    plan->gate_gws[2] = (uint64_t) plan->nt;
+    plan->out_gws     = (uint64_t) plan->ne0;
+    plan->gp_floats   = (uint64_t) plan->nt*2*GGML_LOOP_CONTROL_RANK;
+    plan->gate_local_floats = 2*(GGML_LOOP_CONTROL_GATE_W/GGML_LOOP_CONTROL_SG);
 }
 
