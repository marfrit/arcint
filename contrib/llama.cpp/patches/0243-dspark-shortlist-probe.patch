@@ -0,0 +1,37 @@
+// 0243: the DSpark shortlist's probe (llama_set_dspark_probe): beside the shortlist's pick, the step the full
+// chain would take on the same state, and whether that id was among the step's K candidates. A measurement aid,
+// off by default: it adds the full chain's GEMV and its ARGMAX over the vocabulary back to every step.
+// Shared by src/models/dflash.cpp and tests/test-dspark-shortlist.cpp; ggml only.
+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <cstdlib>
+
+// the full chain's pick of one step, the ops in the full path's order: argmax_V( softcap(base_i + bias) ), bias the
+// Markov correction w2 . m (+ b) as the caller built it; [n_blocks] I32. pick_short: the shortlist's pick of the same
+// step, [n_blocks] I32. LLAMA_DSPARK_PROBE_RED=1 (test only): the red probe, the pick over the K candidates (the
+// shortlist's own) in place of the full one: every position then reads "inside"
+static inline ggml_tensor * dspark_probe_full_pick(ggml_context * ctx, ggml_tensor * base_i, ggml_tensor * bias,
+                                                   float softcap, ggml_tensor * pick_short) {
+    const char * red = getenv("LLAMA_DSPARK_PROBE_RED");
+    if (red != nullptr && atoi(red) == 1) {
+        return pick_short;
+    }
+    ggml_tensor * col = ggml_add(ctx, base_i, bias);
+    if (softcap > 0.0f) {
+        col = ggml_scale(ctx, ggml_tanh(ctx, ggml_scale(ctx, col, 1.0f/softcap)), softcap);
+    }
+    return ggml_argmax(ctx, col);
+}
+
+// whether id is among a step's k candidates
+static inline bool dspark_probe_inside(const int32_t * cand, int64_t k, int32_t id) {
+    for (int64_t c = 0; c < k; ++c) {
+        if (cand[c] == id) {
+            return true;
+        }
+    }
+    return false;
+}
