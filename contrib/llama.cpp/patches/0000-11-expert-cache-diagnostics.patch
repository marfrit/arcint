diff --git a/src/llama-expert-profile.cpp b/src/llama-expert-profile.cpp
new file mode 100644
index 0000000..6a8d662
--- /dev/null
+++ b/src/llama-expert-profile.cpp
@@ -0,0 +1,368 @@
+#include "llama-expert-profile.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+// The heat is Strata's xe unit: raw routing counts, one a routed pair (its device
+// counter), not a decayed sum. Strata's rank_learned_profile (src/core/expert_cache.cpp, commit 3d6f1718):
+// resident first, then by heat descending, then by the prior's own rank, then
+// by the pair's index. Written as the staged order the save test shows, which
+// is the same sequence: resident by heat, the counted non-resident pairs by
+// heat, the prior in its own order, the fill layer-major. Ties in either heat
+// group take the prior's rank before the index (Strata's comparator), which is
+// what puts a prior pair ahead of a same-heat non-prior pair.
+std::vector<std::pair<int, int>> llama_expert_profile_rank(
+    int n_layers, int n_expert, const std::vector<uint8_t> & resident,
+    const std::vector<double> & heat, const std::vector<std::pair<int, int>> & prior) {
+    std::vector<std::pair<int, int>> out;
+    if (n_layers <= 0 || n_expert <= 0) {
+        return out;
+    }
+    const size_t n = (size_t) n_layers * (size_t) n_expert;
+    auto index = [n_expert](int l, int e) { return (size_t) l * (size_t) n_expert + (size_t) e; };
+    auto is_resident = [&](const std::pair<int, int> & p) {
+        const size_t i = index(p.first, p.second);
+        return i < resident.size() && resident[i] != 0;
+    };
+    auto heat_of = [&](const std::pair<int, int> & p) {
+        const size_t i = index(p.first, p.second);
+        return i < heat.size() ? heat[i] : 0.0;
+    };
+
+    // the pairs in the fill's own enumeration: layer outer, expert inner
+    std::vector<std::pair<int, int>> all;
+    all.reserve(n);
+    for (int l = 0; l < n_layers; ++l) {
+        for (int e = 0; e < n_expert; ++e) {
+            all.emplace_back(l, e);
+        }
+    }
+
+    // prior rank: the position of a pair in the profile the run started from,
+    // INT64_MAX when the prior does not name it (Strata's comparator)
+    std::vector<int64_t> prior_rank(n, INT64_MAX);
+    for (size_t r = 0; r < prior.size(); ++r) {
+        const auto [l, e] = prior[r];
+        if (l >= 0 && l < n_layers && e >= 0 && e < n_expert) {
+            int64_t & pr = prior_rank[index(l, e)];
+            if (pr == INT64_MAX) {
+                pr = (int64_t) r;
+            }
+        }
+    }
+    auto rank_of = [&](const std::pair<int, int> & p) { return prior_rank[index(p.first, p.second)]; };
+
+    std::vector<std::pair<int, int>> hot_resident, hot_others;
+    for (const auto & p : all) {
+        if (is_resident(p)) {
+            hot_resident.push_back(p);
+        } else if (heat_of(p) > 0.0) {
+            hot_others.push_back(p);
+        }
+    }
+    // Strata's tie-break: heat descending, then the prior's rank, then the
+    // index (layer-major). Red mutations: `>` -> `<` reverses both groups; a
+    // tie-break on the index alone moves a prior pair behind a same-heat one.
+    auto by_heat_desc = [&](const std::pair<int, int> & a, const std::pair<int, int> & b) {
+        if (heat_of(a) != heat_of(b)) {
+            return heat_of(a) > heat_of(b);
+        }
+        if (rank_of(a) != rank_of(b)) {
+            return rank_of(a) < rank_of(b);
+        }
+        return index(a.first, a.second) < index(b.first, b.second);
+    };
+    std::sort(hot_resident.begin(), hot_resident.end(), by_heat_desc);
+    std::sort(hot_others.begin(), hot_others.end(), by_heat_desc);
+
+    std::vector<uint8_t> seen(n, 0);
+    auto take = [&](const std::pair<int, int> & p) {
+        if (p.first < 0 || p.first >= n_layers || p.second < 0 || p.second >= n_expert) {
+            return;
+        }
+        const size_t i = index(p.first, p.second);
+        if (seen[i]) {
+            return;
+        }
+        seen[i] = 1;
+        out.push_back(p);
+    };
+    for (const auto & p : hot_resident) take(p);
+    for (const auto & p : hot_others)   take(p);
+    // the profile the run started from, in that profile's order
+    for (const auto & p : prior) take(p);
+    // the fill: layer outer, expert inner, every pair still missing
+    for (const auto & p : all) take(p);
+    return out;
+}
+
+void llama_expert_profile_add_heat(std::vector<double> & heat, int n_expert, const std::vector<int32_t> & ids) {
+    if (n_expert <= 0) {
+        return;
+    }
+    for (int32_t e : ids) {
+        if (e < 0 || e >= n_expert) {
+            continue;
+        }
+        if ((size_t) e < heat.size()) {
+            heat[(size_t) e] += 1.0;   // raw: no decay factor, one a routed pair
+        }
+    }
+}
+
+std::vector<std::pair<int, int>> llama_expert_profile_rank_xe(
+    int n_layers, int n_expert, const std::vector<double> & heat,
+    const std::vector<std::pair<int, int>> & prior, double prior_entries, double lam) {
+    if (n_layers <= 0 || n_expert <= 0) {
+        return std::vector<std::pair<int, int>>();
+    }
+    const size_t n = (size_t) n_layers * (size_t) n_expert;
+    // Strata's SYCL/xe save (generate.cpp save_profile): the device's cumulative
+    // counts, then the prior mass by rank, exp(-lam * rank / n) worth
+    // `prior_entries` routed entries over the whole ranking. `lam` 2, the shipped
+    // ranking holds ~70 % of the routing in its first 47 % of pairs.
+    std::vector<double> mixed(n, 0.0);
+    for (size_t i = 0; i < n; ++i) {
+        mixed[i] = i < heat.size() ? heat[i] : 0.0;
+    }
+    if (prior_entries > 0.0 && lam > 0.0 && n > 0) {
+        const double norm = lam / (1.0 - std::exp(-lam)) / (double) n;
+        for (size_t r = 0; r < prior.size(); ++r) {
+            const auto [l, e] = prior[r];
+            if (l < 0 || l >= n_layers || e < 0 || e >= n_expert) {
+                continue;
+            }
+            const double x = (double) r / (double) n;
+            mixed[(size_t) l * (size_t) n_expert + (size_t) e] +=
+                prior_entries * norm * std::exp(-lam * x);
+        }
+    }
+    // Strata passes no resident vector here: every pair ranks by the mixed heat
+    const std::vector<uint8_t> none(n, 0);
+    return llama_expert_profile_rank(n_layers, n_expert, none, mixed, prior);
+}
+
+void llama_expert_profile_mark_pending(int n_expert, std::vector<uint8_t> & resident,
+                                       const std::vector<llama_expert_profile_swap> & pending, int phase) {
+    if (n_expert <= 0) {
+        return;
+    }
+    for (const auto & s : pending) {
+        if (s.layer < 0) {
+            continue;
+        }
+        const size_t base = (size_t) s.layer * (size_t) n_expert;
+        auto put = [&](int e) {
+            if (e >= 0 && e < n_expert) {
+                const size_t i = base + (size_t) e;
+                if (i < resident.size()) {
+                    resident[i] = 1;
+                }
+            }
+        };
+        auto clear = [&](int e) {
+            if (e >= 0 && e < n_expert) {
+                const size_t i = base + (size_t) e;
+                if (i < resident.size()) {
+                    resident[i] = 0;
+                }
+            }
+        };
+        // the incoming expert has landed (a copy in flight counts as done)
+        put(s.e_in);
+        // the outgoing stays resident only in phase 1; at phase 2 the host
+        // table has already freed its slot
+        if (phase >= 2) {
+            clear(s.e_out);
+        }
+    }
+}
+
+static void put_u32(std::FILE * f, uint32_t v) {
+    uint8_t b[4];
+    for (int i = 0; i < 4; ++i) {
+        b[i] = (uint8_t) ((v >> (8 * i)) & 0xff);
+    }
+    std::fwrite(b, 1, 4, f);
+}
+
+static void put_u16(std::FILE * f, uint32_t v) {
+    uint8_t b[2] = { (uint8_t) (v & 0xff), (uint8_t) ((v >> 8) & 0xff) };
+    std::fwrite(b, 1, 2, f);
+}
+
+static uint32_t get_u32(const uint8_t * b) {
+    return (uint32_t) b[0] | ((uint32_t) b[1] << 8) | ((uint32_t) b[2] << 16) | ((uint32_t) b[3] << 24);
+}
+
+static uint16_t get_u16(const uint8_t * b) {
+    return (uint16_t) ((uint16_t) b[0] | ((uint16_t) b[1] << 8));
+}
+
+bool llama_expert_profile_read(const char * path, int n_layers, int n_expert,
+                               std::vector<std::pair<int, int>> & ranked, std::string & err) {
+    ranked.clear();
+    err.clear();
+    if (path == nullptr || *path == '\0') {
+        err = "llama_expert_profile_read: no profile path";
+        return false;
+    }
+    std::FILE * f = std::fopen(path, "rb");
+    if (f == nullptr) {
+        err = std::string("llama_expert_profile_read: ") + path + ": cannot open: " + std::strerror(errno);
+        return false;
+    }
+
+    uint8_t magic[4];
+    uint8_t hb[20];
+    if (std::fread(magic, 1, 4, f) != 4 || std::fread(hb, 1, 20, f) != 20) {
+        std::fclose(f);
+        err = std::string("llama_expert_profile_read: ") + path + ": shorter than a 24-byte STRP header";
+        return false;
+    }
+    if (std::memcmp(magic, "STRP", 4) != 0) {
+        std::fclose(f);
+        err = std::string("llama_expert_profile_read: ") + path + ": not a Strata profile (magic is not STRP)";
+        return false;
+    }
+    const uint32_t version  = get_u32(hb);
+    const uint32_t n_layer  = get_u32(hb + 4);
+    const uint32_t n_exp    = get_u32(hb + 8);
+    const uint32_t slots    = get_u32(hb + 12);   // ignored: arcint ignores the hint
+    const uint32_t n_ranked = get_u32(hb + 16);
+    (void) slots;
+
+    // the version BEFORE the geometry: the fields after it are a version 1
+    // layout's, so a version 2 file of another model is refused by its number
+    // (Strata's _version_test)
+    if (version != 1) {
+        std::fclose(f);
+        err = std::string("llama_expert_profile_read: ") + path + ": profile version " +
+              std::to_string(version) + ", this reader reads version 1";
+        return false;
+    }
+    if ((int) n_layer != n_layers || (int) n_exp != n_expert) {
+        std::fclose(f);
+        err = std::string("llama_expert_profile_read: ") + path + ": " + std::to_string(n_layer) + "x" +
+              std::to_string(n_exp) + ", not " + std::to_string(n_layers) + "x" + std::to_string(n_expert);
+        return false;
+    }
+    // more pairs than the geometry has: a header claim, refused before the loop
+    // (a truncated pair is caught by the loop's own short read)
+    if (n_ranked > (uint32_t) ((size_t) n_layers * (size_t) n_expert)) {
+        std::fclose(f);
+        err = std::string("llama_expert_profile_read: ") + path + ": " + std::to_string(n_ranked) +
+              " ranked pairs, more than the geometry's " + std::to_string(n_layers * n_expert);
+        return false;
+    }
+
+    std::vector<std::pair<int, int>> got;
+    got.reserve(n_ranked);
+    for (uint32_t i = 0; i < n_ranked; ++i) {
+        uint8_t pb[4];
+        if (std::fread(pb, 1, 4, f) != 4) {
+            std::fclose(f);
+            err = std::string("llama_expert_profile_read: ") + path + ": pair " + std::to_string(i) +
+                  " of " + std::to_string(n_ranked) + " (truncated record)";
+            return false;
+        }
+        const int l = get_u16(pb);
+        const int e = get_u16(pb + 2);
+        if (l < 0 || l >= n_layers || e < 0 || e >= n_expert) {
+            std::fclose(f);
+            err = std::string("llama_expert_profile_read: ") + path + ": pair " + std::to_string(i) + " (" +
+                  std::to_string(l) + "," + std::to_string(e) + ") is out of range";
+            return false;
+        }
+        got.emplace_back(l, e);
+    }
+    if (std::fclose(f) != 0) {
+        err = std::string("llama_expert_profile_read: ") + path + ": close failed: " + std::strerror(errno);
+        return false;
+    }
+    ranked = std::move(got);
+    return true;
+}
+
+bool llama_expert_profile_write(const char * path, int n_layers, int n_expert,
+                                const std::vector<std::pair<int, int>> & ranked, std::string & err) {
+    err.clear();
+    if (path == nullptr || *path == '\0') {
+        err = "llama_expert_profile_write: no profile path";
+        return false;
+    }
+    if (n_layers < 1 || n_layers > 65535 || n_expert < 1 || n_expert > 65535) {
+        err = std::string("llama_expert_profile_write: ") + path + ": " + std::to_string(n_layers) + "x" +
+              std::to_string(n_expert) + " does not fit the u16 pair fields";
+        return false;
+    }
+    if (ranked.size() > 0xffffffffUL) {
+        err = std::string("llama_expert_profile_write: ") + path + ": too many ranked pairs";
+        return false;
+    }
+    // the range check BEFORE the file is touched: a refused save keeps an
+    // existing file (Strata's save test)
+    for (size_t i = 0; i < ranked.size(); ++i) {
+        const int l = ranked[i].first, e = ranked[i].second;
+        if (l < 0 || l >= n_layers || e < 0 || e >= n_expert) {
+            err = std::string("llama_expert_profile_write: ") + path + ": pair " + std::to_string(i) + " (" +
+                  std::to_string(l) + "," + std::to_string(e) + ") is out of range";
+            return false;
+        }
+    }
+
+    const std::string tmp = std::string(path) + ".tmp";
+    std::FILE * f = std::fopen(tmp.c_str(), "wb");
+    if (f == nullptr) {
+        err = std::string("llama_expert_profile_write: ") + tmp + ": cannot open: " + std::strerror(errno);
+        return false;
+    }
+    auto fail = [&](const std::string & why) {
+        std::fclose(f);
+        std::remove(tmp.c_str());   // never leave a `.tmp`
+        err = std::string("llama_expert_profile_write: ") + tmp + ": " + why;
+        return false;
+    };
+    std::fwrite("STRP", 1, 4, f);
+    put_u32(f, 1u);                              // version
+    put_u32(f, (uint32_t) n_layers);
+    put_u32(f, (uint32_t) n_expert);
+    put_u32(f, (uint32_t) ranked.size());        // slots = n_ranked, Strata's writer
+    put_u32(f, (uint32_t) ranked.size());        // n_ranked
+    for (const auto & p : ranked) {
+        put_u16(f, (uint32_t) p.first);
+        put_u16(f, (uint32_t) p.second);
+    }
+    // the trailing table Strata's writer appends: a layer's experts -> their
+    // rank, -1 for a pair the ranking does not hold. Its save test compares the
+    // whole file byte for byte, so a saved profile is the same file the Python
+    // writers produce; readers stop after the pairs.
+    std::vector<int32_t> table((size_t) n_layers * (size_t) n_expert, -1);
+    for (size_t i = 0; i < ranked.size(); ++i) {
+        table[(size_t) ranked[i].first * (size_t) n_expert + (size_t) ranked[i].second] = (int32_t) i;
+    }
+    for (int32_t v : table) {
+        put_u32(f, (uint32_t) v);
+    }
+    if (std::fflush(f) != 0) {
+        return fail(std::string("write failed: ") + std::strerror(errno));
+    }
+    if (std::fclose(f) != 0) {
+        const int e = errno;
+        std::remove(tmp.c_str());
+        err = std::string("llama_expert_profile_write: ") + tmp + ": close failed: " + std::strerror(e);
+        return false;
+    }
+    if (std::rename(tmp.c_str(), path) != 0) {
+        const int e = errno;
+        std::remove(tmp.c_str());
+        err = std::string("llama_expert_profile_write: ") + path + ": rename from the .tmp failed: " +
+              std::strerror(e);
+        return false;
+    }
+    return true;
+}
diff --git a/src/llama-expert-profile.h b/src/llama-expert-profile.h
new file mode 100644
index 0000000..cd413f4
--- /dev/null
+++ b/src/llama-expert-profile.h
@@ -0,0 +1,93 @@
+#pragma once
+
+// Strata's learned expert profile (STRP), its ranking rule and its file format,
+// kept dependency-free so a device-free test compiles the .cpp alone (the same
+// rule the route trace follows, src/llama-expert-route-trace.cpp of patch 0069).
+//
+// Two ranking rules, both from Strata (commit 3d6f1718):
+//   xe  its SYCL/xe save (`save_profile`, sycl/src/program/generate.cpp): the
+//       raw routing counts (one a routed pair, its device counter's unit, not a
+//       decayed sum) mixed with the start's ranking as pseudo-counts, no
+//       resident head. `STRATA_PROFILE_PRIOR_ENTRIES` (default 800,000 routed
+//       entries), lambda 2, the prior pair rank's share exp(-2 * rank / n).
+//       A short conversation must not wipe the prior.
+//   cu  its `rank_learned_profile` (src/core/expert_cache.cpp): the resident
+//       pairs by heat, the counted non-resident pairs by heat, then the rest;
+//       ties by the prior's own rank, then the pair's index.
+//
+// The cu rule, read from Strata's source and its save test:
+//   1. the resident pairs, ordered by heat (usage) descending;
+//   2. the non-resident pairs WITH heat > 0, ordered by heat descending;
+//   3. then the remaining pairs (the prior's pairs in the prior's order, then
+//      the fill layer 0..n_layers-1 outer, expert 0..n_expert-1 inner);
+//   every group ties by the prior's rank first, then the pair's index.
+// Strata's `rank_learned_profile` sorts every pair at once with exactly that
+// comparator; the staged form here gives the same order.
+//
+// STRP file: "STRP", u32 version 1, u32 n_layer, u32 n_expert, u32 slots,
+// u32 n_ranked, then n_ranked x (u16 layer, u16 expert), little endian, then
+// the trailing layer x expert rank table (i32 expert -> rank, -1 for a pair
+// the ranking does not hold), as Strata's writer appends it. The reader stops
+// after the pairs, as arcint's does; a writer produces the whole file so it is
+// byte for byte Strata's. The `slots` field is a hint; the reader ignores it.
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+enum class llama_expert_profile_rule {
+    xe,   // Strata's SYCL/xe save: prior mixing, no resident head (the default)
+    cu,   // Strata's rank_learned_profile: resident first, prior as a tie-break
+};
+
+// a swap a cache still has in flight, as its save sees it: the incoming expert
+// has landed (a copy in flight counts as done, Strata does), the outgoing one
+// is still resident only while the host table is in phase 1
+struct llama_expert_profile_swap {
+    int layer;
+    int e_in;
+    int e_out;
+};
+
+// The version and geometry checks; a refusal names the file, the version found
+// and the one read (version before geometry, Strata's _version_test), or the
+// geometry, or why the pairs stopped. On refusal `ranked` is left empty: no
+// partial ranking. `slots` may be any value.
+bool llama_expert_profile_read(const char * path, int n_layers, int n_expert,
+                               std::vector<std::pair<int, int>> & ranked, std::string & err);
+
+// Atomic: a `.tmp` beside `path`, then a rename over it; a refusal (a pair out
+// of range, a short write, a failed rename) leaves an existing file untouched
+// and removes the `.tmp`. `slots = n_ranked`, as Strata's writer uses
+// len(ranked) for both; the trailing rank table is written after the pairs.
+bool llama_expert_profile_write(const char * path, int n_layers, int n_expert,
+                                const std::vector<std::pair<int, int>> & ranked, std::string & err);
+
+// Count one graph's routing into the save's heat: exactly one a routed id, raw
+// (Strata's per-routing-event device counter, the unit the prior is in), ids out
+// of range skipped. Double: a month at ~33 t/s passes float's 2^24 on the
+// hottest pairs. Call it in the cache's count(), never in its adapt(): the heat
+// must accumulate with adaptation off (LLAMA_EXPERT_CACHE_ADAPT_EVERY=0).
+void llama_expert_profile_add_heat(std::vector<double> & heat, int n_expert, const std::vector<int32_t> & ids);
+
+// The cu ranking above. `resident` and `heat` are indexed `layer * n_expert +
+// expert`; a short or missing vector reads as 0 (Strata's empty heat case). A
+// prior pair out of range is skipped; a pair the prior does not name ties last.
+std::vector<std::pair<int, int>> llama_expert_profile_rank(
+    int n_layers, int n_expert, const std::vector<uint8_t> & resident,
+    const std::vector<double> & heat, const std::vector<std::pair<int, int>> & prior);
+
+// The xe ranking: `heat` (the raw routing counts) mixed with the start's
+// ranking as pseudo-counts worth `prior_entries` routed entries, lambda 2, by
+// the prior pair's rank, then Strata's rank_learned_profile with no residents.
+std::vector<std::pair<int, int>> llama_expert_profile_rank_xe(
+    int n_layers, int n_expert, const std::vector<double> & heat,
+    const std::vector<std::pair<int, int>> & prior, double prior_entries, double lam);
+
+// Mark a cache's swaps still in flight, as Strata's save does: every incoming
+// expert is resident (its copy has landed). The outgoing expert stays resident
+// only in phase 1 (the host table still names its slot); at phase 2 the
+// table has already freed it, so the save clears it.
+void llama_expert_profile_mark_pending(int n_expert, std::vector<uint8_t> & resident,
+                                       const std::vector<llama_expert_profile_swap> & pending, int phase);
diff --git a/src/llama-expert-route-trace.cpp b/src/llama-expert-route-trace.cpp
new file mode 100644
index 0000000..2f6a1b1
--- /dev/null
+++ b/src/llama-expert-route-trace.cpp
@@ -0,0 +1,331 @@
+#include "llama-expert-route-trace.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+uint8_t llama_expert_route_graph_kind(uint32_t n_tokens, uint32_t decode_max, bool all_outputs, bool has_tokens) {
+    const bool prompt = !all_outputs || !has_tokens || n_tokens > decode_max;
+    return prompt ? LLAMA_EXPERT_ROUTE_PROMPT : (n_tokens == 1 ? LLAMA_EXPERT_ROUTE_DECODE : LLAMA_EXPERT_ROUTE_VERIFY);
+}
+
+bool llama_expert_route_trace_enabled() {
+    // once: the graph builder asks on every MTP MoE layer
+    static const bool on = [] {
+        const char * p = getenv("LLAMA_EXPERT_ROUTE_TRACE");
+        return p != nullptr && *p != '\0';
+    }();
+    return on;
+}
+
+// one WARN a process: the writer is dependency-free (a device-free test
+// compiles this file alone), so it cannot use llama's logger
+static void trace_warn(const char * what, const char * detail) {
+    std::fprintf(stderr, "WARN: expert route trace: %s%s%s\n", what,
+                 detail != nullptr ? ": " : "", detail != nullptr ? detail : "");
+}
+
+static uint64_t trace_max_bytes(bool & warned) {
+    const char * p = getenv("LLAMA_EXPERT_ROUTE_TRACE_MAX_MB");
+    // a record is a few KB; 256 MiB is a long span. Fractional values are for
+    // the device-free rotation test (a cap in bytes, not in a serving run).
+    // A non-numeric or non-positive value falls back to the default; 0 used to
+    // mean "rotate every record", the defect this check removes.
+    const double def = 256.0;
+    if (p == nullptr || *p == '\0') {
+        return (uint64_t) (def * 1048576.0);
+    }
+    char * end = nullptr;
+    errno = 0;
+    const double mb = std::strtod(p, &end);
+    if (end == p || *end != '\0' || errno != 0 || !(mb > 0)) {
+        if (!warned) {
+            warned = true;
+            char msg[96];
+            std::snprintf(msg, sizeof(msg), "LLAMA_EXPERT_ROUTE_TRACE_MAX_MB=%s is not a positive number", p);
+            trace_warn("falling back to 256 MB", msg);
+        }
+        return (uint64_t) (def * 1048576.0);
+    }
+    return (uint64_t) (mb * 1048576.0);
+}
+
+void llama_expert_route_trace::put_u32(uint32_t v) {
+    for (int i = 0; i < 4; ++i) {
+        buf.push_back((uint8_t) ((v >> (8 * i)) & 0xff));
+    }
+}
+
+void llama_expert_route_trace::put_i32(int32_t v) {
+    put_u32((uint32_t) v);
+}
+
+void llama_expert_route_trace::flush() {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (!opened || buf.empty()) {
+        buf.clear();
+        return;
+    }
+    // one write a record; the file was opened O_WRONLY|O_EXCL with one writer
+    // (the trace's mu), never O_APPEND, so a short write is resumed in the
+    // loop below instead of trusting a page-atomic write
+    size_t off = 0;
+    while (off < buf.size()) {
+        const ssize_t n = ::write(fd, buf.data() + off, buf.size() - off);
+        if (n <= 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            const int err = errno;
+            opened = false;   // a full disk or a closed fd: stop tracing, do not fail the run
+            buf.clear();
+            if (!warned) {
+                warned = true;
+                char msg[160];
+                std::snprintf(msg, sizeof(msg), "cannot write %s: %s; tracing stops",
+                              path.c_str(), std::strerror(err));
+                trace_warn("the file can no longer be written", msg);
+            }
+            return;
+        }
+        off += (size_t) n;
+        bytes_in_file += (uint64_t) n;
+    }
+    buf.clear();
+}
+
+static std::string trace_file_name(const std::string & base, bool dir_mode, uint32_t seq) {
+    if (dir_mode) {
+        char tail[32];
+        std::snprintf(tail, sizeof(tail), ".%03u.ert1", seq);
+        return base + tail;
+    }
+    if (seq == 0) {
+        return base;
+    }
+    char tail[32];
+    std::snprintf(tail, sizeof(tail), ".%03u", seq);
+    return base + tail;
+}
+
+std::string llama_expert_route_trace_sidecar() {
+    auto & t = llama_expert_route_trace::instance();
+    std::lock_guard<std::recursive_mutex> lk(t.mu);
+    if (!t.opened) {
+        return {};
+    }
+    return trace_file_name(t.path, t.dir_mode, t.seq) + ".accept";
+}
+
+void llama_expert_route_trace::close() {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (fd >= 0) {
+        ::close(fd);
+    }
+    fd = -1;
+    opened = false;
+    buf.clear();
+}
+
+// a fresh name only: O_EXCL, advance the sequence past anything already there.
+// Nothing is ever appended, so a restart cannot put a second header in an old
+// file and the replay never meets one mid-file.
+static int trace_open_fresh(const std::string & base, bool dir_mode, uint32_t & seq, uint64_t & bytes) {
+    for (uint32_t guard = 0; guard < 10000; ++guard) {
+        const std::string f = trace_file_name(base, dir_mode, seq);
+        const int fd = ::open(f.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+        if (fd >= 0) {
+            bytes = 0;
+            return fd;
+        }
+        if (errno != EEXIST) {
+            return -1;
+        }
+        ++seq;
+    }
+    errno = EEXIST;
+    return -1;
+}
+
+bool llama_expert_route_trace::open(const char * p, uint32_t nl, uint32_t ne, uint32_t nu) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    close();
+    path      = p;
+    seq       = 0;
+    bytes_in_file = 0;
+    n_layer   = nl;
+    n_expert  = ne;
+    n_used    = nu;
+    warned    = false;
+    max_bytes = trace_max_bytes(warned);
+    struct stat st;
+    const bool exists = ::stat(p, &st) == 0;
+    dir_mode = exists && S_ISDIR(st.st_mode);
+    if (!exists) {
+        // the flag is a DIR: a missing one is created, or refused loudly. It is
+        // never silently treated as a base file path (the round-6 defect).
+        if (::mkdir(p, 0755) != 0) {
+            trace_warn("cannot create the trace directory", p);
+            return false;
+        }
+        dir_mode = true;
+    }
+    if (dir_mode) {
+        char base[4096];
+        // the start time in the base: a reused pid after a restart opens a new
+        // family, not the previous run's sequence
+        std::snprintf(base, sizeof(base), "%s/expert-route-%d-%lld", p, (int) ::getpid(),
+                      (long long) std::time(nullptr));
+        path = base;
+    }
+    fd = trace_open_fresh(path, dir_mode, seq, bytes_in_file);
+    if (fd < 0) {
+        char msg[160];
+        std::snprintf(msg, sizeof(msg), "cannot open a fresh file for %s: %s", p, std::strerror(errno));
+        trace_warn("tracing is off", msg);
+        return false;
+    }
+    opened = true;
+    buf.clear();
+    buf.insert(buf.end(), {'E', 'R', 'T', '1'});
+    put_u32(2);   // version: a graph carries its first position
+    put_u32(n_layer);
+    put_u32(n_expert);
+    put_u32(n_used);
+    flush();
+    return opened;
+}
+
+bool llama_expert_route_trace_rotate_now(const llama_expert_route_trace & t) {
+    if (!t.opened || t.pending_graphs > 0) {
+        return false;
+    }
+    return t.at_cap();
+}
+
+bool llama_expert_route_trace::rotate_next() {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (!opened) {
+        return false;
+    }
+    close();
+    fd = trace_open_fresh(path, dir_mode, seq, bytes_in_file);
+    if (fd < 0) {
+        char msg[160];
+        std::snprintf(msg, sizeof(msg), "cannot open the next file for %s: %s", path.c_str(), std::strerror(errno));
+        trace_warn("tracing stops", msg);
+        return false;
+    }
+    opened = true;
+    buf.clear();
+    buf.insert(buf.end(), {'E', 'R', 'T', '1'});
+    put_u32(2);
+    put_u32(n_layer);
+    put_u32(n_expert);
+    put_u32(n_used);
+    flush();
+    return opened;
+}
+
+void llama_expert_route_trace::event_layers(const std::vector<int> & il, const std::vector<int> & n_slots,
+                                            const std::vector<std::vector<int32_t>> & residents) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (!opened) {
+        return;
+    }
+    put_u8(0);
+    put_u32((uint32_t) il.size());
+    for (size_t i = 0; i < il.size(); ++i) {
+        put_i32(il[i]);
+        put_i32(n_slots[i]);
+        for (int s = 0; s < n_slots[i]; ++s) {
+            put_i32(s < (int) residents[i].size() ? residents[i][s] : -1);
+        }
+    }
+    flush();
+}
+
+void llama_expert_route_trace::set_residents(intptr_t key, const std::vector<int> & il, const std::vector<int> & n_slots,
+                                             const std::vector<std::vector<int32_t>> & residents) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    for (auto & s : layer_sets) {
+        if (s.key == key) {
+            s.il = il;
+            s.n_slots = n_slots;
+            s.residents = residents;
+            return;
+        }
+    }
+    layer_sets.push_back({ key, il, n_slots, residents });
+}
+
+void llama_expert_route_trace::event_layers_all() {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    std::vector<int> il, ns;
+    std::vector<std::vector<int32_t>> res;
+    for (const auto & s : layer_sets) {
+        il.insert(il.end(), s.il.begin(), s.il.end());
+        ns.insert(ns.end(), s.n_slots.begin(), s.n_slots.end());
+        res.insert(res.end(), s.residents.begin(), s.residents.end());
+    }
+    event_layers(il, ns, res);   // the lock is recursive; one record either way
+}
+
+void llama_expert_route_trace::pending_graph(bool pending) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (pending) {
+        ++pending_graphs;
+    } else if (pending_graphs > 0) {
+        --pending_graphs;
+    }
+}
+
+void llama_expert_route_trace::event_graph(uint8_t kind, int32_t first_pos, uint32_t n_tokens,
+                                           const std::vector<int32_t> & tokens,
+                                           const std::vector<int> & il, const std::vector<std::vector<int32_t>> & ids) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (!opened) {
+        return;
+    }
+    put_u8(kind);
+    put_i32(first_pos);
+    put_u32(n_tokens);
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        put_i32(i < tokens.size() ? tokens[i] : -1);
+    }
+    put_u32((uint32_t) il.size());
+    for (size_t i = 0; i < il.size(); ++i) {
+        put_i32(il[i]);
+        put_u32((uint32_t) ids[i].size());
+        for (int32_t e : ids[i]) {
+            put_i32(e);
+        }
+    }
+    flush();
+}
+
+void llama_expert_route_trace::event_tables(const std::vector<llama_expert_route_trace::change> & changed) {
+    std::lock_guard<std::recursive_mutex> lk(mu);
+    if (!opened || changed.empty()) {
+        buf.clear();
+        return;
+    }
+    put_u8(5);
+    put_u32((uint32_t) changed.size());
+    for (const auto & c : changed) {
+        put_i32(c.il);
+        put_i32(c.expert);
+        put_u8(c.resident);
+    }
+    flush();
+}
+
+llama_expert_route_trace & llama_expert_route_trace::instance() {
+    static llama_expert_route_trace t;
+    return t;
+}
diff --git a/src/llama-expert-route-trace.h b/src/llama-expert-route-trace.h
new file mode 100644
index 0000000..b8e2256
--- /dev/null
+++ b/src/llama-expert-route-trace.h
@@ -0,0 +1,163 @@
+#pragma once
+
+// An opt-in, binary routing trace for the expert cache (campaign
+// expert-foresight; stage 0 built it as a diagnostic, the operator made it a
+// production option on 2026-10-29). `LLAMA_EXPERT_ROUTE_TRACE=<dir or path>`
+// (arcint's `--llama-expert-route-trace DIR`) turns it on; unset it costs one
+// getenv at start-up and nothing else: no allocation, no read-back, no write.
+//
+// A file per process, rotated at a size cap: `f = dir` gives
+// `expert-route-<pid>-<unix-time>.000.ert1`, `.001.ert1`, ...; `f` an existing
+// non-directory is a file BASE, not the first file: a file that already sits
+// there is skipped (O_EXCL) and the sequence starts at `f.001`, then `.002`.
+// Every file is
+// opened with O_EXCL and a fresh name is chosen, never appended: a restarted
+// unit with a reused pid, or a path whose file already exists, gets a new base
+// or the next sequence, so no second header ever lands in an old file. A DIR
+// that does not exist is created; if that fails the trace is refused with a
+// WARN, never treated as a file path. Each file carries its own header and,
+// after a rotation, a LAYERS record of the cache's residents at that moment, so
+// every file replays alone; nothing is ever deleted by arcint. Header with the
+// model's geometry, then one record a event, little endian, no trailer. A run
+// that dies mid-write leaves a torn last record; a reader stops at it (never a
+// partial one), and resynchronises on a later "ERT1" magic so an old file with
+// an appended header still replays.
+//
+// Size: a prompt record is n_tokens x top-k x n_layer x 4 B, about 1.9 KB a
+// prompt token, so a 100k prompt is about 190 MB. DIR belongs on a dataset with
+// room, not the root filesystem.
+//
+// A trace with token ids is the prompt and the answer in another form: whoever
+// turns it on stores every request's content on the serving host.
+//
+//   header  "ERT1" u32 version u32 n_layer u32 n_expert u32 n_used
+//           version 2 adds a graph's first position; version 1 had none
+//   event   u8 kind, then
+//     0 LAYERS  u32 n, per: i32 il, i32 n_slots, n_slots i32 resident (slot ->
+//               expert, -1 for the trailing zeros slot) -- a cache's layers as
+//               loaded, so a replay starts from the run's own resident set
+//     1 PROMPT  a prompt batch of any size, including the 4-token tail a
+//               checkpoint break leaves (the cache classifies by the call:
+//               a prompt call does not output every row; a decode call does)
+//     2 DECODE  a one-token decode
+//     3 VERIFY  a decode verify (2..decode_max tokens): tokens[1..] are the
+//               drafts, tokens[0] the token before them; which of the drafts a
+//               sampler accepted is NOT in this file -- the engine's cache
+//               cannot see the sampler. arcint writes it beside the trace
+//               (`<path>.accept`: "verify <ordinal> pos <p> rows <n> accepted
+//               <a>", one a decode graph, a single lane; the replay aligns by
+//               p, a graph's first position, never by order)
+//     4 DRAFT   an MTP draft context's own decode: the MTP block's input
+//               tokens (step 0 the accepted target token, then the previous
+//               draft -- NOT the drafted tokens) and its own routed ids
+//               (Flash-Next's MTP block is a full MoE layer,
+//               llama-model.cpp/models/qwen4exp.cpp; it runs without an
+//               expert cache, so llama-context.cpp reads its
+//               selected_experts tensor when this trace is on)
+//     all four graph kinds: i32 first_pos (version 2; -1 when the ubatch has
+//      no positions), u32 n_tokens, i32 token[n_tokens] (-1 for an embedding
+//      row), u32 n_layers, per: i32 il, u32 count, i32 ids[count]
+//      (token-major, the router's top-k in rank order, exactly the ids_out the
+//      cache already reads)
+//     5 TABLES  u32 n_changes, per: i32 il, i32 expert, u8 resident (1: in a
+//               slot, 0: not) -- every residency change the cache applies, so a
+//               replay rebuilds the resident set instead of guessing it
+//
+// The writer is dependency-free on purpose: a device-free test compiles this
+// file alone and reads its bytes back with the replay's reader.
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// ERT1 graph kinds: the cache's decision from a call's shape, kept pure so a
+// device-free test can exercise it (a prompt call outputs fewer rows than it
+// has tokens; a decode or verify call outputs every one; a prompt's 4-token
+// checkpoint tail is a prompt).
+enum llama_expert_route_kind : uint8_t {
+    LLAMA_EXPERT_ROUTE_LAYERS = 0, LLAMA_EXPERT_ROUTE_PROMPT = 1,
+    LLAMA_EXPERT_ROUTE_DECODE = 2, LLAMA_EXPERT_ROUTE_VERIFY = 3,
+    LLAMA_EXPERT_ROUTE_DRAFT = 4, LLAMA_EXPERT_ROUTE_TABLES = 5,
+};
+
+uint8_t llama_expert_route_graph_kind(uint32_t n_tokens, uint32_t decode_max, bool all_outputs, bool has_tokens);
+
+// The variable is read once: the graph builder asks whether to mark the
+// MTP block's routed ids as an output (a no-op when the trace is off).
+bool llama_expert_route_trace_enabled();
+
+// The accept sidecar beside the CURRENT trace file (`<file>.accept`), so it
+// rotates with it; empty when the trace is off. A writer appends one line a
+// accepted graph and reopens the sidecar when this name changes.
+std::string llama_expert_route_trace_sidecar();
+
+struct llama_expert_route_trace {
+    struct change { int32_t il, expert; uint8_t resident; };
+    int  fd      = -1;
+    bool opened  = false;
+    bool warned  = false;       // one WARN a run when a write or an open fails
+    std::string path;           // `base` for the file names below
+    bool        dir_mode = false;
+    uint32_t    seq      = 0;   // the file in this process's sequence
+    uint64_t    bytes_in_file = 0;
+    uint64_t    max_bytes = 0;  // rotate past this; LLAMA_EXPERT_ROUTE_TRACE_MAX_MB (default 256)
+    uint32_t    n_layer = 0, n_expert = 0, n_used = 0;
+    std::vector<uint8_t> buf;   // the record being built
+    // the writer is shared by the cache's decode path and an MTP context's
+    // synchronize (lanes), so every public record call holds this one lock
+    std::recursive_mutex mu;
+    // process-wide, not one cache: with a cache a card (a layer split), cache A
+    // must not rotate while cache B's graph record for the same graph is still
+    // pending -- its accept line is already in A's file
+    int pending_graphs = 0;
+    // every cache's residents at its last TABLES record, so a rotation writes
+    // one LAYERS record that holds every card's layers and every file replays
+    // alone under a layer split
+    struct layer_set {
+        intptr_t key;   // the cache, stable for its life
+        std::vector<int> il, n_slots;
+        std::vector<std::vector<int32_t>> residents;
+    };
+    std::vector<layer_set> layer_sets;
+
+    // Opens the first file with O_EXCL (never appends), writes the header.
+    bool open(const char * p, uint32_t n_layer, uint32_t n_expert, uint32_t n_used);
+    // At the cap: close this file, open the next fresh one (O_EXCL) and write
+    // its header. The caller follows with event_layers_all.
+    bool at_cap() const { return opened && bytes_in_file >= max_bytes; }
+    bool rotate_next();
+    void close();
+
+    void put_u8(uint8_t v)  { buf.push_back(v); }
+    void put_u32(uint32_t v);
+    void put_i32(int32_t v);
+    void flush();   // one write() a record, resumed across short writes; the
+                    // file is opened O_WRONLY|O_EXCL (no O_APPEND)
+
+    void event_layers(const std::vector<int> & il, const std::vector<int> & n_slots,
+                      const std::vector<std::vector<int32_t>> & residents);
+    // A cache's current residents, kept for the next rotation's snapshot.
+    void set_residents(intptr_t key, const std::vector<int> & il, const std::vector<int> & n_slots,
+                       const std::vector<std::vector<int32_t>> & residents);
+    // One LAYERS record over every registered cache, in registration order.
+    void event_layers_all();
+    // Hold/release the process-wide pending count around a graph record.
+    void pending_graph(bool pending);
+    void event_graph(uint8_t kind, int32_t first_pos, uint32_t n_tokens, const std::vector<int32_t> & tokens,
+                     const std::vector<int> & il, const std::vector<std::vector<int32_t>> & ids);
+    void event_tables(const std::vector<change> & changed);
+
+    // The process's one trace: opened on the first cache's init, off when the
+    // variable is unset or the file cannot be opened (a warning a run).
+    static llama_expert_route_trace & instance();
+};
+
+// The cache's rotation decision, kept pure so a device-free test can drive the
+// cache's real call order: a rotation is taken at `after_graph`, before arcint
+// writes the verify's accept line. While ANY cache's graph record is pending
+// its accept line is already in this file, so a rotation at the next advance,
+// the request-end flush or an MTP DRAFT record would split the line from its
+// record; it waits for the next `after_graph` (round 7's defect, made
+// process-wide in round 8: a layer split has a cache a card).
+bool llama_expert_route_trace_rotate_now(const llama_expert_route_trace & t);
