diff --git a/tests/test-expert-cache-alias.cpp b/tests/test-expert-cache-alias.cpp
new file mode 100644
index 0000000..2b0e344
--- /dev/null
+++ b/tests/test-expert-cache-alias.cpp
@@ -0,0 +1,120 @@
+// 0077: device-free tests for the slot-buffer sampled alias tripwire.
+//   - the region arithmetic over every planar type the OpenCL set path converts
+//     slice by slice: the offset is a multiple of the tensor's nb[2], the size is
+//     exactly nb[2], inside the tensor;
+//   - an empty slice or a tensor shorter than one slice has no region;
+//   - the pattern: two ids differ at byte 0, one id equals itself; one differing
+//     read-back is one finding;
+//   - llama-expert-cache.cpp's call: the header is included, the planar types are
+//     the ones sampled, all writes precede the read-backs, a finding warns and
+//     the load proceeds, and the env switch is present.
+// No GPU, no llama model; ggml is linked for the type sizes.
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "ggml.h"
+#include "llama-expert-cache-alias.h"
+
+static int g_bad = 0;
+#define CHECK(cond, what) do { if (!(cond)) { std::printf("FAIL: %s\n", what); ++g_bad; } } while (0)
+
+static void check_planar_regions(void) {
+    const ggml_type types[] = { GGML_TYPE_IQ2_XXS, GGML_TYPE_IQ2_XS, GGML_TYPE_IQ2_S,
+                                GGML_TYPE_Q2_0,    GGML_TYPE_IQ3_S,  GGML_TYPE_IQ3_XXS };
+    for (ggml_type type : types) {
+        // a 3-D slot tensor: ne0 = 256, ne1 = 256; nb[2] is one 2-D slice
+        const size_t row  = ggml_row_size(type, 256);
+        const size_t nb2  = row * 256;
+        CHECK((256 * 256 / ggml_blck_size(type)) % 2 == 0, "the planar type's block count is even");
+        const size_t bytes = nb2 * 8;
+        for (size_t i = 0; i < 4; ++i) {
+            const llama_cache_alias_span s = llama_cache_alias_region(bytes, nb2, i);
+            CHECK(s.ok, "a planar tensor of eight slices has a region");
+            CHECK(s.offset % nb2 == 0, "the region starts on a whole slice");
+            CHECK(s.size == nb2, "the region is one whole slice");
+            CHECK(s.offset + s.size <= bytes, "the region lies inside the tensor");
+        }
+        CHECK(llama_cache_alias_region(nb2, nb2, 0).ok, "one slice has a region");
+        CHECK(llama_cache_alias_region(nb2 - 1, nb2, 0).ok == false, "less than one slice has no region");
+    }
+    // two consecutive tensors sample distinct, still slice-aligned starts
+    const size_t nb2 = 110;
+    const llama_cache_alias_span a = llama_cache_alias_region(nb2 * 64, nb2, 0);
+    const llama_cache_alias_span b = llama_cache_alias_region(nb2 * 64, nb2, 1);
+    CHECK(a.ok && b.ok && a.offset % nb2 == 0 && b.offset % nb2 == 0, "two tensors start on whole slices");
+    CHECK(a.offset != b.offset, "consecutive tensors sample distinct regions");
+    // a large slice is still one whole slice, not a capped block
+    const size_t big = 40000;
+    const llama_cache_alias_span c = llama_cache_alias_region(big * 8, big, 0);
+    CHECK(c.ok && c.size == big, "a large slice is one whole slice");
+}
+
+static void check_pattern(void) {
+    constexpr size_t BLOCK = 64u << 10;
+    std::vector<uint8_t> a(BLOCK), b(BLOCK), c(BLOCK);
+    llama_cache_alias_pattern(3, a.data(), a.size());
+    llama_cache_alias_pattern(4, b.data(), b.size());
+    llama_cache_alias_pattern(3, c.data(), c.size());
+    CHECK(std::memcmp(a.data(), b.data(), BLOCK) != 0, "two ids' regions differ");
+    CHECK(std::memcmp(a.data(), c.data(), BLOCK) == 0, "one id's region equals itself");
+    // a slice-sized region whose tail is not a multiple of eight still fills
+    std::vector<uint8_t> d(110), e(110);
+    llama_cache_alias_pattern(5, d.data(), d.size());
+    llama_cache_alias_pattern(6, e.data(), e.size());
+    CHECK(std::memcmp(d.data(), e.data(), d.size()) != 0, "a tail-filled region differs from another id's");
+    CHECK(llama_cache_alias_reads_back(3, a.data(), a.size()), "a read-back matches its own pattern");
+    CHECK(!llama_cache_alias_reads_back(3, b.data(), b.size()), "one differing region is one finding");
+    CHECK(llama_cache_alias_reads_back(3, c.data(), c.size()), "the same id's read-back matches");
+}
+
+static void check_call_site(const std::string & src) {
+    CHECK(src.find("#include \"llama-expert-cache-alias.h\"") != std::string::npos,
+          "llama-expert-cache.cpp includes the alias check");
+    CHECK(src.find("llama_cache_alias_check(alias_slots)") != std::string::npos,
+          "the slot buffers are checked at load");
+    const size_t set = src.find("ggml_backend_tensor_set(t, region.data(), sp.offset, region.size())");
+    const size_t get = src.find("ggml_backend_tensor_get(p.t, actual.data(), p.off, actual.size())");
+    CHECK(set != std::string::npos && get != std::string::npos && set < get,
+          "all writes precede the read-backs");
+    for (const char * t : {"GGML_TYPE_IQ2_XXS", "GGML_TYPE_IQ2_XS", "GGML_TYPE_IQ2_S",
+                           "GGML_TYPE_Q2_0", "GGML_TYPE_IQ3_S", "GGML_TYPE_IQ3_XXS"}) {
+        CHECK(src.find(std::string("case ") + t + ":") != std::string::npos,
+              "the planar types are the ones sampled");
+    }
+    for (const char * t : {"GGML_TYPE_Q4_0", "GGML_TYPE_Q1_0", "GGML_TYPE_Q8_0",
+                           "GGML_TYPE_IQ4_NL", "GGML_TYPE_Q4_K"}) {
+        CHECK(src.find(std::string("case ") + t + ":") == std::string::npos,
+              "the whole-tensor SOA readers are not sampled");
+    }
+    CHECK(src.find("p.expected") == std::string::npos && src.find("sampled_bytes") != std::string::npos,
+          "the plan holds no expected bytes and the summary reports them");
+    CHECK(src.find("warn and proceed") != std::string::npos,
+          "a finding warns and the load proceeds");
+    CHECK(src.find("LLAMA_EXPERT_CACHE_ALIAS") != std::string::npos,
+          "the record's off switch is present");
+    CHECK(src.find("alias check, %d of %zu sampled slot regions differ, %zu bytes written and read back") != std::string::npos,
+          "the finding is logged with its count and the sampled bytes");
+}
+
+int main() {
+    check_planar_regions();
+    check_pattern();
+    std::ifstream f(LLAMA_EXPERT_CACHE_SRC_PATH);
+    if (!f) {
+        std::printf("FAIL: cannot open %s\n", LLAMA_EXPERT_CACHE_SRC_PATH);
+        ++g_bad;
+    } else {
+        const std::string src((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        check_call_site(src);
+    }
+    if (g_bad) {
+        std::printf("test-expert-cache-alias: %d failure(s)\n", g_bad);
+        return 1;
+    }
+    std::printf("test-expert-cache-alias: ok\n");
+    return 0;
+}
diff --git a/tests/test-opencl-alias.cpp b/tests/test-opencl-alias.cpp
new file mode 100644
index 0000000..f57d9d4
--- /dev/null
+++ b/tests/test-opencl-alias.cpp
@@ -0,0 +1,122 @@
+// 0077: device-free tests for the VRAM alias check, a sampled deviation from
+// Strata's full scan.
+//   - the plan: blocks are 64 KiB aligned, inside the allocation, unique and
+//     evenly spread; a small allocation is one block, an empty one none, and an
+//     allocation larger than the sample takes GGML_CL_ALIAS_BLOCKS;
+//   - the pattern: two blocks' patterns differ at byte 0, one block's equals
+//     itself, so a read-back of an aliased block is not the expected one;
+//   - the corruption class: a two-page model whose second write lands in the
+//     first page's physical bytes reads the first back with the second's
+//     pattern, so the check reports it; without the alias the check is clean;
+//   - the call sites: ggml-opencl.cpp includes the header and scans the bank
+//     stream ring whenever a learned order's ring is (re)allocated; a relearn
+//     scans again; the USM host staging ring is not
+//     scanned (host RAM, not a GPU page table); findings are named per block and
+//     every scan ends with one summary line. No host-range pre-check remains
+//     (the old 0077 class: different USM host ranges cannot overlap, so it could
+//     never fire).
+// No GPU, no OpenCL runtime.
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "ggml-opencl-alias.h"
+
+static int g_bad = 0;
+#define CHECK(cond, what) do { if (!(cond)) { std::printf("FAIL: %s\n", what); ++g_bad; } } while (0)
+
+static void check_plan(void) {
+    // 32 MiB, the default staging ring: 512 blocks, the 16-block sample spread
+    const size_t bytes = 32u << 20;
+    size_t offs[GGML_CL_ALIAS_BLOCKS];
+    const size_t k = ggml_cl_alias_offsets(bytes, offs, GGML_CL_ALIAS_BLOCKS);
+    CHECK(k == GGML_CL_ALIAS_BLOCKS, "a 32 MiB allocation takes the full sample");
+    for (size_t i = 0; i < k; ++i) {
+        CHECK(offs[i] % GGML_CL_ALIAS_BLOCK == 0, "a block offset is 64 KiB aligned");
+        CHECK(offs[i] + GGML_CL_ALIAS_BLOCK <= bytes, "a block lies inside the allocation");
+        for (size_t j = 0; j < i; ++j) CHECK(offs[i] != offs[j], "the blocks are unique");
+    }
+    CHECK(offs[0] == 0, "the first block is at the start");
+    // a small allocation: one block; an empty or sub-block one: none
+    CHECK(ggml_cl_alias_offsets(GGML_CL_ALIAS_BLOCK, offs, GGML_CL_ALIAS_BLOCKS) == 1,
+          "one block at one block's size");
+    CHECK(ggml_cl_alias_offsets(GGML_CL_ALIAS_BLOCK - 1, offs, GGML_CL_ALIAS_BLOCKS) == 0,
+          "no block below one block's size");
+    CHECK(ggml_cl_alias_offsets(0, offs, GGML_CL_ALIAS_BLOCKS) == 0, "no block in an empty allocation");
+    // a sample cap: the plan is bounded, not the allocation
+    CHECK(ggml_cl_alias_offsets(1u << 30, offs, 4) == 4, "a billion bytes still takes only the cap");
+}
+
+static void check_pattern(void) {
+    std::vector<uint8_t> a(GGML_CL_ALIAS_BLOCK), b(GGML_CL_ALIAS_BLOCK), c(GGML_CL_ALIAS_BLOCK);
+    ggml_cl_alias_pattern(7, a.data());
+    ggml_cl_alias_pattern(8, b.data());
+    ggml_cl_alias_pattern(7, c.data());
+    CHECK(std::memcmp(a.data(), b.data(), GGML_CL_ALIAS_BLOCK) != 0, "two ids' blocks differ");
+    CHECK(std::memcmp(a.data(), c.data(), GGML_CL_ALIAS_BLOCK) == 0, "one id's block equals itself");
+    CHECK(std::memcmp(a.data(), b.data(), 8) != 0, "two ids differ at the block's first word");
+}
+
+// two pages: page 0 and page 1; with aliasing page 1's bytes are page 0's, so a
+// write to page 1 overwrites page 0 (the class the check exists for)
+static int simulate(bool aliased) {
+    std::vector<uint8_t> page0(GGML_CL_ALIAS_BLOCK), page1(GGML_CL_ALIAS_BLOCK);
+    std::vector<uint8_t> * v0 = &page0, * v1 = aliased ? &page0 : &page1;
+    std::vector<std::vector<uint8_t>> expected(2, std::vector<uint8_t>(GGML_CL_ALIAS_BLOCK));
+    ggml_cl_alias_pattern(0, expected[0].data());
+    ggml_cl_alias_pattern(1, expected[1].data());
+    std::memcpy(v0->data(), expected[0].data(), GGML_CL_ALIAS_BLOCK);
+    std::memcpy(v1->data(), expected[1].data(), GGML_CL_ALIAS_BLOCK);
+    int bad = 0;
+    if (std::memcmp(v0->data(), expected[0].data(), GGML_CL_ALIAS_BLOCK) != 0) ++bad;
+    if (std::memcmp(v1->data(), expected[1].data(), GGML_CL_ALIAS_BLOCK) != 0) ++bad;
+    return bad;
+}
+
+static void check_corruption_class(void) {
+    CHECK(simulate(true) > 0, "an aliased block is found by the write/read-back");
+    CHECK(simulate(false) == 0, "distinct blocks read back clean");
+}
+
+static void check_call_sites(const std::string & src) {
+    CHECK(src.find("#include \"ggml-opencl-alias.h\"") != std::string::npos,
+          "ggml-opencl.cpp includes the alias check's plan");
+    CHECK(src.find("ggml_cl_alias_scan_device(ctx->queue, b.buffer, b.size, \"bank stream ring\", &alias_blocks)") != std::string::npos,
+          "the bank stream ring is scanned at each learned order's ring");
+    CHECK(src.find("ggml_cl_alias_scan_host") == std::string::npos,
+          "the USM host staging ring is not scanned");
+    CHECK(src.find("clEnqueueWriteBuffer(q, mem, CL_TRUE") != std::string::npos &&
+              src.find("clEnqueueReadBuffer(q, mem, CL_TRUE") != std::string::npos,
+          "the device scan writes all blocks and reads them back");
+    CHECK(src.find("block %zu at %zu reads back differently") != std::string::npos,
+          "a finding names the block");
+    CHECK(src.find("alias check, bank stream ring: %d of %zu sampled blocks differ") != std::string::npos,
+          "every scan ends with one summary line");
+    // the old class: a host-range registry of distinct allocations cannot overlap
+    CHECK(src.find("ggml_cl_ranges_overlap") == std::string::npos &&
+              src.find("ggml_cl_note_alloc") == std::string::npos,
+          "no host-range pre-check remains");
+}
+
+int main() {
+    check_plan();
+    check_pattern();
+    check_corruption_class();
+    std::ifstream f(GGML_OPENCL_SRC_PATH);
+    if (!f) {
+        std::printf("FAIL: cannot open %s\n", GGML_OPENCL_SRC_PATH);
+        ++g_bad;
+    } else {
+        const std::string src((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        check_call_sites(src);
+    }
+    if (g_bad) {
+        std::printf("test-opencl-alias: %d failure(s)\n", g_bad);
+        return 1;
+    }
+    std::printf("test-opencl-alias: ok\n");
+    return 0;
+}
