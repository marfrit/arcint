index 0000000..aae30ba
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/arange.cl
@@ -0,0 +1,8 @@
+// 0147: GGML_OP_ARANGE, the rollback slot order of the short-conv state store
+kernel void kernel_arange_f32(
+        global float * dst, ulong offsetd,
+        float start, float step, int n) {
+    if ((int) get_global_id(0) >= n) { return; }
+    dst = (global float*)((global char*)dst + offsetd);
+    dst[get_global_id(0)] = start + step * (float) get_global_id(0);
+}
--- a/ggml/src/ggml-opencl/kernels/scale.cl
+++ b/ggml/src/ggml-opencl/kernels/scale.cl
@@ -37,3 +37,21 @@ kernel void kernel_scale_f32_4(
     dst = (global float4*)((global char*)dst + offsetd);
     dst[get_global_id(0)] = src0[get_global_id(0)] * scale + bias;
 }
+
+// stride-addressed scale for a row-contiguous but not contiguous input (a view):
+// the same walk as unary_ext's _nc kernels, with the scale and bias
+kernel void kernel_scale_f32_nc(
+        global const char * src0, ulong offset0,
+        global       char * dst,  ulong offsetd,
+        int ne00, ulong nb00, ulong nb01, ulong nb02, ulong nb03,
+        ulong nb0, ulong nb1, ulong nb2, ulong nb3,
+        float scale, float bias) {
+    src0 = src0 + offset0; dst = dst + offsetd;
+    const int i3 = get_group_id(2);
+    const int i2 = get_group_id(1);
+    const int i1 = get_group_id(0);
+    for (int i0 = get_local_id(0); i0 < ne00; i0 += get_local_size(0)) {
+        float x = *(global const float *)(src0 + i3*nb03 + i2*nb02 + i1*nb01 + i0*nb00);
+        *(global float *)(dst + i3*nb3 + i2*nb2 + i1*nb1 + i0*nb0) = x * scale + bias;
+    }
+}
--- a/ggml/src/ggml-opencl/kernels/unary_ext.cl
+++ b/ggml/src/ggml-opencl/kernels/unary_ext.cl
@@ -87,3 +87,23 @@ UNARY_EXT(floor,        floor(x),                                          floor
 UNARY_EXT(ceil,         ceil(x),                                           ceil(x))
 UNARY_EXT(round,        round(x),                                          round(x))
 UNARY_EXT(trunc,        trunc(x),                                          trunc(x))
+
+// 0146: GGML_OP_LOG (natural log) for the log-scaled positions of the model
+kernel void kernel_log_f32(
+        global const float * src0, ulong offset0,
+        global       float * dst,  ulong offsetd, int n) {
+    if ((int) get_global_id(0) >= n) { return; }
+    src0 = (global float*)((global char*)src0 + offset0);
+    dst  = (global float*)((global char*)dst  + offsetd);
+    dst[get_global_id(0)] = log(src0[get_global_id(0)]);
+}
+
+kernel void kernel_log_f32_4(
+        global const float4 * src0, ulong offset0,
+        global       float4 * dst,  ulong offsetd, int n) {
+    if ((int) get_global_id(0) >= n) { return; }
+    src0 = (global float4*)((global char*)src0 + offset0);
+    dst  = (global float4*)((global char*)dst  + offsetd);
+    float4 x = src0[get_global_id(0)];
+    dst[get_global_id(0)] = (float4)(log(x.x), log(x.y), log(x.z), log(x.w));
+}
