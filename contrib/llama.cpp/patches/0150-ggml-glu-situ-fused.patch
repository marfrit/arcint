+//------------------------------------------------------------------------------
+// situ
+//------------------------------------------------------------------------------
+// situ(gate, up) = beta*tanh(gate/beta)*sigmoid(gate) * (lb > 0 ? lb*tanh(up/lb) : up)
+// the gate half and the up half may both be views of a merged gate_up tensor
+kernel void kernel_situ_f32(
+    global char * src0,
+    ulong         offset0,
+    global char * src1,
+    ulong         offset1,
+    global char * dst,
+    ulong         offsetd,
+    ulong         nb01,
+    ulong         nb11,
+    int           ne0,
+    ulong         nb1,
+    int           ne00_off,
+    int           ne10_off,
+    float         beta,
+    float         linear_beta
+) {
+    src0 = (global char*)((global char*)src0 + offset0);
+    src1 = (global char*)((global char*)src1 + offset1);
+    dst  = (global char*)((global char*)dst  + offsetd);
+
+    global float * src0_row = (global float *) ((global char *) src0 + get_group_id(0)*nb01) + ne00_off;
+    global float * src1_row = (global float *) ((global char *) src1 + get_group_id(0)*nb11) + ne10_off;
+    global float * dst_row  = (global float *) ((global char *) dst  + get_group_id(0)*nb1);
+
+    for (int i0 = get_group_id(1)*get_local_size(0) + get_local_id(0); i0 < ne0; i0 += get_local_size(0)*get_num_groups(1)) {
+        const float gate = src0_row[i0];
+        const float up   = src1_row[i0];
+
+        float act = beta * tanh(gate * (1.0f / beta));
+        act *= 1.0f / (1.0f + exp(-gate));
+
+        float up_t = up;
+        if (linear_beta > 0.0f) {
+            up_t = linear_beta * tanh(up * (1.0f / linear_beta));
+        }
+        dst_row[i0] = act * up_t;
+    }
+}
