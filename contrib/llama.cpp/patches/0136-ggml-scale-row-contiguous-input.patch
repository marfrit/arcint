+// reference path (use_ref): one element at a time, valid for any layout, with and without bias
+static void ggml_compute_forward_scale_ref(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+
+    GGML_ASSERT(ggml_are_same_shape(src0, dst));
+
+    float s; // scale factor
+    float b; // bias
+
+    memcpy(&s, (float *) dst->op_params + 0, sizeof(float));
+    memcpy(&b, (float *) dst->op_params + 1, sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t nc = src0->ne[0];
+    const int64_t nr = ggml_nrows(src0);
+
+    // rows per thread
+    const int64_t dr = (nr + nth - 1)/nth;
+
+    // row range for this thread
+    const int64_t ir0 = dr*ith;
+    const int64_t ir1 = MIN(ir0 + dr, nr);
+
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t i1 = ir % src0->ne[1];
+        const int64_t i2 = (ir / src0->ne[1]) % src0->ne[2];
+        const int64_t i3 = ir / (src0->ne[1]*src0->ne[2]);
+
+        const char * xp = (const char *) src0->data + i1*src0->nb[1] + i2*src0->nb[2] + i3*src0->nb[3];
+        char       * yp = (char *)       dst->data  + i1*dst->nb[1]  + i2*dst->nb[2]  + i3*dst->nb[3];
+
+        switch (src0->type) {
+            case GGML_TYPE_F32:
+                {
+                    const float * x = (const float *) xp;
+                    float       * y = (float *)       yp;
+                    for (int64_t k = 0; k < nc; ++k) {
+                        y[k] = s*x[k] + b;
+                    }
+                } break;
+            case GGML_TYPE_BF16:
+                {
+                    const ggml_bf16_t * x = (const ggml_bf16_t *) xp;
+                    ggml_bf16_t       * y = (ggml_bf16_t *)       yp;
+                    for (int64_t k = 0; k < nc; ++k) {
+                        y[k] = GGML_FP32_TO_BF16(s*GGML_BF16_TO_FP32(x[k]) + b);
+                    }
+                } break;
+            default:
+                GGML_ABORT("fatal error");
+        }
+    }
+}
