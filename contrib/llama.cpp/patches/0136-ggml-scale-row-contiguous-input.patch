+// GGML_OP_SCALE on a row-contiguous view that is not contiguous: one half of a wider tensor.
+// A kernel that steps rows as i1*nb[1] over all rows (or reads src0 with dst's stride in the
+// bias branch) reads the wrong rows for i2/i3 > 0.
+struct test_scale_view : public test_case {
+    const ggml_type type;
+    const std::array<int64_t, 4> ne;
+    float scale;
+    float bias;
+
+    std::string vars() override {
+        return VARS_TO_STR4(type, ne, scale, bias);
+    }
+
+    test_scale_view(ggml_type type = GGML_TYPE_F32,
+            std::array<int64_t, 4> ne = {16, 4, 3, 1},
+            float scale = 2.0f,
+            float bias = 0.0f)
+        : type(type), ne(ne), scale(scale), bias(bias) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        // the base is twice as wide and twice as tall, so the view's rows are spaced by the
+        // base's nb[1] and a row block of ne[1] happens only every 2*ne[1] rows
+        const std::array<int64_t, 4> ne_base = {2*ne[0], 2*ne[1], ne[2], ne[3]};
+        ggml_tensor * base = ggml_new_tensor(ctx, type, 4, ne_base.data());
+        ggml_set_param(base);
+        ggml_set_name(base, "base");
+
+        ggml_tensor * a = ggml_view_4d(ctx, base, ne[0], ne[1], ne[2], ne[3],
+                base->nb[1], base->nb[2], base->nb[3], ne[0]*ggml_element_size(base));
+        ggml_set_name(a, "a");
+
+        ggml_tensor * out = ggml_scale_bias(ctx, a, scale, bias);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
