+                            { r1[lane][1], r1[lane][2], r1[lane][3], r1[lane][4] }, { r1[lane][5], r1[lane][6], r1[lane][7], r2[lane][0] },
+                            { r2[lane][2], r2[lane][3], r2[lane][4], r2[lane][5] }, { r2[lane][6], r2[lane][7], r3[lane][0], x2 },
