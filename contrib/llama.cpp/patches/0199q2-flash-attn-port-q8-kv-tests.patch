+            for (int key = 0; key < n_kv; ++key) {
+                to_float((const char *) k->data + (size_t) key * k->nb[1] + (size_t) kvh * k->nb[2], kdq.data() + (size_t) key * D, D);
+                to_float((const char *) v->data + (size_t) key * v->nb[1] + (size_t) kvh * v->nb[2], vdq.data() + (size_t) key * D, D);
+            }
+            for (int qt = 0; qt < ntiles; qt += (qt + 9 < ntiles ? 9 : 1)) {     // every ninth tile, and the last ones
+                const int q0 = qt * 8, nrow = std::min(8, n_q - q0);
+                n_tiles_run++;
+                auto qrow = [&](int r) { return (const float *) ((const char *) q->data + (size_t) head * q->nb[2] + (size_t) std::min(q0 + r, n_q - 1) * q->nb[1]); };
