+        ggml_init_params params = { ggml_tensor_overhead()*64 + ggml_graph_overhead(), NULL, true };
+        ggml_context * ctx = ggml_init(params);
+        ggml_tensor * op = tc.build_graph(ctx);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, op);
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf != nullptr);
+        tc.initialize_tensors(ctx);
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+        const ggml_tensor * q = op->src[0], * k = op->src[1], * v = op->src[2], * mask = op->src[3];
+        const ggml_tensor * bt = op->src[FA_PORT_SRC_TABLE], * bi = op->src[FA_PORT_SRC_IDX], * sq = op->src[FA_PORT_SRC_SINK_Q];
