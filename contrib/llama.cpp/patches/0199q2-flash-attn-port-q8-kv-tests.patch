+            t[4 + i] = ((w[i] >> 8) & 0x00FF00FFu) ^ 0x64806480u;
+        }
+        for (int h = 0; h < 16; ++h) {
+            out[h] = ggml_fp16_to_fp32((ggml_fp16_t) (h & 1 ? t[h >> 1] >> 16 : t[h >> 1] & 0xFFFFu));
+        }
