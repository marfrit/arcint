+        // intel_sub_group_2d_block_read_transform_8b_32r16x1c as the kernel assumes it: 16
+        // columns of bytes from byte x; lane = column, its 32 bytes the rows from y in order
+        auto rd_f8 = [&](const ggml_tensor * t, uintptr_t base, int w1, int h1, int p1, int x, int y, uint8_t out[16][32]) {
+            rules(base, w1, h1, p1, x, 8);
+            for (int lane = 0; lane < 16; ++lane) for (int i = 0; i < 32; ++i) {
+                const int row = std::min(y + i, h1);
+                const uint8_t * p = (const uint8_t *) base + (size_t) row * (p1 + 1) + x + lane;
