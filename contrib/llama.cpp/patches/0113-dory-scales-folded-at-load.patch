+    struct folded_scales {
+        ggml_tensor * alpha = nullptr;
+        ggml_tensor * sq = nullptr;
+        ggml_tensor * sg = nullptr;
+        ggml_tensor * cg = nullptr;
+        ggml_tensor * cu = nullptr;
