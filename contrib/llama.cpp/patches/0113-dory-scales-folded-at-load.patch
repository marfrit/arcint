-            auto * sg = ggml_sqr(ctx0, ggml_scale(ctx0, f32(s.gate), sqrtf(model.gate_init) / model.init_std));
-            gate = ggml_sigmoid(ctx0, ggml_mul(ctx0, gate, sg));
+            if (fs) {
+                gate = ggml_sigmoid(ctx0, ggml_mul(ctx0, gate, fs->sg));
