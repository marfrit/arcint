             const int64_t nkv = hparams.n_head_kv(il) * n_embd_head_k;
@@ -121,12 +143,181 @@ void llama_model_dory::load_arch_tensors(llama_model_loader & ml) {
             l.wv = create_tensor(tn(LLM_TENSOR_ATTN_V, "weight", p), {n_embd, nkv}, 0);
