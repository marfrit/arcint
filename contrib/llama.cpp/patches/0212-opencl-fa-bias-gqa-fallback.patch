diff --git a/ggml/src/ggml-opencl/ggml-opencl-fa-bias-route.h b/ggml/src/ggml-opencl/ggml-opencl-fa-bias-route.h
new file mode 100644
index 000000000..17c2f3819
--- /dev/null
+++ b/ggml/src/ggml-opencl/ggml-opencl-fa-bias-route.h
@@ -0,0 +1,49 @@
+// ggml-opencl-fa-bias-route.h - 0212: which decode kernel an indexed-bias FLASH_ATTN_EXT
+// (0143) runs on, as one pure function (no OpenCL call, no backend state), so a CPU test
+// can drive every case, the failed GQA build included.
+//
+// 0143 builds the bias variant of a decode kernel on first use (-DFA_BIAS_TABLE=<n_bins>)
+// and memoises it, a failure included. supports_op builds the intel split variant (or
+// its quantized pair) and declines the op when that fails, so the split variant exists
+// for every call the dispatcher sees. The GQA variant (flash_attn_gqa_dpas.cl) is built
+// only when the call's rows took the GQA kernel (4-8 rows by default, Xe2), at dispatch;
+// before 0212 a failed build there aborted the process. Now the call runs on the split
+// variant, which serves the same rows: the 1-3 row calls take it by default, and 4-8
+// rows do under GGML_OPENCL_FA_GQA_MIN_ROWS=9.
+#ifndef GGML_OPENCL_FA_BIAS_ROUTE_H
+#define GGML_OPENCL_FA_BIAS_ROUTE_H
+
+#include <stdlib.h>
+
+enum ggml_cl_fa_bias_route_t {
+    GGML_CL_FA_BIAS_ROUTE_NONE  = 0,   // no kernel: the dispatcher aborts (supports_op prevents it)
+    GGML_CL_FA_BIAS_ROUTE_GQA   = 1,   // the GQA decode kernel's bias variant
+    GGML_CL_FA_BIAS_ROUTE_SPLIT = 2,   // the intel split kernel's bias variant (or its quantized pair)
+};
+
+// rows_gqa:  the dispatcher put the call's rows on the GQA kernel (its plain build exists)
+// gqa_built: the GQA bias variant built and its kernel was created
+// split_ok:  the split bias variant built (read only when the GQA variant is not taken)
+//
+// FA_BIAS_ROUTE_RED compiles the rule before 0212 (rows on the GQA kernel had no other
+// kernel), for the unit test's red run only.
+static inline int ggml_cl_fa_bias_route(int rows_gqa, int gqa_built, int split_ok) {
+#ifdef FA_BIAS_ROUTE_RED
+    if (rows_gqa) {
+        return gqa_built ? GGML_CL_FA_BIAS_ROUTE_GQA : GGML_CL_FA_BIAS_ROUTE_NONE;
+    }
+#endif
+    if (rows_gqa && gqa_built) {
+        return GGML_CL_FA_BIAS_ROUTE_GQA;
+    }
+    return split_ok ? GGML_CL_FA_BIAS_ROUTE_SPLIT : GGML_CL_FA_BIAS_ROUTE_NONE;
+}
+
+// GGML_OPENCL_FA_BIAS_GQA_FAIL=1 (debug, red only): the GQA bias variant is built with
+// -DFA_BIAS_GQA_FORCE_FAIL, which flash_attn_gqa_dpas.cl turns into a compile error, so
+// the card takes the failed-build path for real. Unset or 0: the normal build.
+static inline int ggml_cl_fa_bias_gqa_fail(const char * env_value) {
+    return env_value != NULL && atoi(env_value) != 0;
+}
+
+#endif // GGML_OPENCL_FA_BIAS_ROUTE_H
diff --git a/ggml/src/ggml-opencl/ggml-opencl.cpp b/ggml/src/ggml-opencl/ggml-opencl.cpp
