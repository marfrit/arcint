@@ -13,6 +13,7 @@
 #include "ggml-backend.h"
 #include "ggml-impl.h"
 #include "ggml-opencl-fa-paged.h"
+#include "ggml-opencl-fa-bias-route.h"   // 0212: the indexed-bias decode route, a pure function (CPU-testable)
 #include "ggml-opencl-cpy-t01.h"
 #include <cstdarg>
 #include <cstdio>
@@ -8863,6 +8864,12 @@ static cl_kernel ggml_opencl_fa_bias_kernel(ggml_backend_opencl_context * backen
                    " -DGQA_SIDES=" + std::to_string(backend_ctx->fa_gqa_sides) +
                    " -DKT=" + std::to_string(gkv[kvq_gqa][0]) + " -DVT=" + std::to_string(gkv[kvq_gqa][1]);
             if (const char * gopt = getenv("GGML_OPENCL_FA_GQA_OPTS")) { opts += std::string(" ") + gopt; }
+            // 0212: GGML_OPENCL_FA_BIAS_GQA_FAIL=1 (debug, red only) makes this build fail
+            // in the compiler (an #error in the kernel source), to prove the fallback
+            static const bool gqa_fail = ggml_cl_fa_bias_gqa_fail(getenv("GGML_OPENCL_FA_BIAS_GQA_FAIL"));
+            if (gqa_fail) {
+                opts += " -DFA_BIAS_GQA_FORCE_FAIL";
+            }
             name = "flash_attn_gqa_dpas";
             cl_program prog = build_program_from_source_ex(backend_ctx->context, backend_ctx->device,
                 src.c_str(), opts + bias_opt, /*fatal=*/false, "fa gqa bias", backend_ctx->queue);
@@ -8871,6 +8878,14 @@ static cl_kernel ggml_opencl_fa_bias_kernel(ggml_backend_opencl_context * backen
                 if (err != CL_SUCCESS) { k = nullptr; }
                 CL_CHECK(clReleaseProgram(prog));
             }
+            // 0212: a failed variant is memoised below, so this line and the build
+            // run once a (dk, dv, kv pair, bins); the dispatcher falls back to the split
+            // variant (ggml_cl_fa_bias_route)
+            if (k == nullptr) {
+                GGML_LOG_WARN("ggml_opencl: the indexed-bias GQA decode variant did not build (dk=%d dv=%d kvq=%d bins=%d%s); "
+                              "its calls take the split kernel\n", dk, dv, kvq_gqa, n_bins,
+                              gqa_fail ? ", forced by GGML_OPENCL_FA_BIAS_GQA_FAIL" : "");
+            }
         } else if (kind == 1 || (kind == 2 && kvq >= 0 && kvq < 3 && dk % 32 == 0)) {
             const char * qn[3] = { "flash_attn_q8q8_q1_split_intel", "flash_attn_q8q4_q1_split_intel",
                                    "flash_attn_q4q4_q1_split_intel" };
@@ -27984,12 +27999,32 @@ static void ggml_cl_flash_attn(ggml_backend_t backend, const ggml_tensor * q, co
         // supports_op ran earlier already has it, one that did not gets it here
         ggml_opencl_ensure_fa_variant(backend_ctx, d_head_q, d_head_v, FA_VARIANT_F32_F16);
         GGML_ASSERT(!kv_pages && "a paged FLASH_ATTN_EXT cannot take an indexed bias");
-        fd_k_split = use_fd_gqa ? ggml_opencl_fa_bias_kernel(backend_ctx, 0, d_head_q, d_head_v,
-                                                            is_mixed ? 0 : kvq + 1, fa_bias_bins)
-                   : is_mixed   ? ggml_opencl_fa_bias_kernel(backend_ctx, 1, d_head_q, d_head_v, -1, fa_bias_bins)
-                   : kvq >= 0   ? ggml_opencl_fa_bias_kernel(backend_ctx, 2, d_head_q, d_head_v, kvq, fa_bias_bins)
-                   : nullptr;
-        if (fd_k_split == nullptr) {
+        // 0212: the GQA variant when the rows took the GQA kernel and it built; else the
+        // split variant (supports_op built it, so this is a lookup), with a DOWNGRADE line
+        // once a process. Before 0212 a failed GQA build aborted here.
+        cl_kernel k_bias_gqa = use_fd_gqa ? ggml_opencl_fa_bias_kernel(backend_ctx, 0, d_head_q, d_head_v,
+                                                                       is_mixed ? 0 : kvq + 1, fa_bias_bins)
+                                          : nullptr;
+        cl_kernel k_bias_split = nullptr;
+        if (k_bias_gqa == nullptr) {
+            k_bias_split = is_mixed ? ggml_opencl_fa_bias_kernel(backend_ctx, 1, d_head_q, d_head_v, -1, fa_bias_bins)
+                         : kvq >= 0 ? ggml_opencl_fa_bias_kernel(backend_ctx, 2, d_head_q, d_head_v, kvq, fa_bias_bins)
+                         : nullptr;
+        }
+        const int bias_route = ggml_cl_fa_bias_route(use_fd_gqa, k_bias_gqa != nullptr, k_bias_split != nullptr);
+        if (bias_route == GGML_CL_FA_BIAS_ROUTE_GQA) {
+            fd_k_split = k_bias_gqa;
+            static std::once_flag taken_bias_gqa;
+            std::call_once(taken_bias_gqa, [] {
+                GGML_LOG_WARN("TAKEN src=opencl op=FLASH_ATTN indexed-bias form=gqa\n");
+            });
+        } else if (bias_route == GGML_CL_FA_BIAS_ROUTE_SPLIT) {
+            if (use_fd_gqa) {
+                ggml_cl_downgrade("op=FLASH_ATTN indexed-bias path=split reason=gqa-variant-unbuilt");
+                use_fd_gqa = false;   // the split kernel's launch: its split size, grid and arguments
+            }
+            fd_k_split = k_bias_split;
+        } else {
             GGML_ABORT("ggml_opencl: an indexed-bias FLASH_ATTN_EXT reached the dispatcher without a kernel");
         }
         use_fd_mq = false;
