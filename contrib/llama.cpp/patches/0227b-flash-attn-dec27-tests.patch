+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t D = 256, nh = hkv * G;
+        // q: [D, heads, rows] seen as [D, rows, heads], the model's permuted view
+        ggml_tensor * q = ggml_permute(ctx, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, nh, nb), 0, 2, 1, 3);
+        ggml_set_name(q, "q");
+        auto cache = [&](ggml_type type, const char * name) -> ggml_tensor * {
+            ggml_tensor * t;
+            if (layout == 0) {
+                // the model's cache: a key row holds the kv heads one after another, and has more cells than are used
+                ggml_tensor * base = ggml_new_tensor_3d(ctx, type, D, hkv, kv + 64);
+                t = ggml_permute(ctx, ggml_view_3d(ctx, base, D, hkv, kv, base->nb[1], base->nb[2], 0), 0, 2, 1, 3);
+            } else {
+                t = ggml_new_tensor_3d(ctx, type, D, kv, hkv);
+            }
+            ggml_set_name(t, name);
+            return t;
+        };
+        ggml_tensor * k = cache(GGML_TYPE_Q8_0, "k");
+        ggml_tensor * v = cache(GGML_TYPE_Q4_0, "v");
