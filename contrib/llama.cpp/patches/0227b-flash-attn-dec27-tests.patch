+        auto vval = [&](int64_t d, int64_t key, int64_t kvh) -> float {
+            const float amp = 0.25f * powf(2.0f, 3.0f * test_flash_attn_ext::det01(18, (uint64_t) ((kvh*kv + key)*(D/32) + d/32)));
