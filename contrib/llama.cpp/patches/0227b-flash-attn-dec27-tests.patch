+        const int64_t used = kv - empty;         // the cells that hold a token
+        const int64_t n_tail = vfloor != 0 ? 0 : std::min<int64_t>(8, used);
+        const float k_amp = 1.0f, v_amp = vfloor != 0 ? 1e-6f : 1.0f;
+        // logical (dim, key, kv head) -> value
+        auto kval = [&](int64_t d, int64_t key, int64_t kvh) -> float {
+            if (key >= used - n_tail && key < used) {
+                return beta * dir(kvh, d) + 0.3f * rnd(5, (uint64_t) ((kvh*kv + key)*D + d));
+            }
+            const float amp = 0.25f * powf(2.0f, 3.0f * test_flash_attn_ext::det01(17, (uint64_t) ((kvh*kv + key)*(D/32) + d/32)));
+            return k_amp * amp * rnd(1, (uint64_t) ((kvh*kv + key)*D + d));
