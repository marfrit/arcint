+    }
+
+    static float rnd(uint64_t salt, uint64_t i) { return -1.0f + 2.0f * test_flash_attn_ext::det01(salt, i); }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        const int64_t D = 256, nh = hkv * G;
+        auto dir = [&](int64_t kvh, int64_t d) -> float { return test_flash_attn_ext::det01(7, (uint64_t) (kvh*D + d)) < 0.5f ? -1.0f : 1.0f; };
