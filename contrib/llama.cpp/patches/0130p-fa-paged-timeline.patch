+// 0130p: GGML_OPENCL_FA_PAGED_TIMELINE=1, development only -- device stamps for the request's
+// first split-decode graph. The compute queue carries profiling only in a build with
+// GGML_OPENCL_PROFILING (the backend's own switch), and the copy queue is created with
+// CL_QUEUE_PROFILING_ENABLE only when this switch is on, so an off switch costs nothing on
+// either queue. A build without the compute queue's profiling makes this switch warn once
+// and print nothing rather than print zeros.
+static bool ggml_cl_fa_paged_timeline() {
+    static const char * e = getenv("GGML_OPENCL_FA_PAGED_TIMELINE");
+    static const bool   on = e != nullptr && atoi(e) != 0;
+    if (on) {
+        static bool said = false;
+        if (!said) { said = true; GGML_LOG_WARN("ggml_opencl: paged FA switch GGML_OPENCL_FA_PAGED_TIMELINE=1: "
+                "device stamps for the request's first split-decode graph, copy queue profiling on\n"); }
+    }
+    return on;
+}
 
