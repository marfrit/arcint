+// 0130p: the timeline's stamps. Roles: 0 copy start, 1 copy end, 2 FA split start,
+// 3 FA split end, 4 k_merge end, 5 the consumed marker, 6 the post hash start,
+// 7 the cross-step prefetch's copy start, -1 the graph's first paged command (base).
+static void ggml_cl_fa_paged_tl_keep(ggml_backend_opencl_context * ctx, int role, int slot, cl_event ev) {
+    auto & o = ctx->fa_paged;
+    if (!ggml_cl_fa_paged_timeline() || o.tl_graph != ctx->graph_gen || ev == nullptr) return;
+    CL_CHECK(clRetainEvent(ev));
+    o.tl.push_back({ role, slot, ev });
+}
+// a marker carries the waits the command after it has, so its END is that command's start
+static void ggml_cl_fa_paged_tl_mark(ggml_backend_opencl_context * ctx, cl_command_queue q, int role,
+        int slot, cl_uint nw, cl_event * wl) {
+    cl_event ev = nullptr;
+    CL_CHECK(clEnqueueMarkerWithWaitList(q, nw, wl, &ev));
+    ggml_cl_fa_paged_tl_keep(ctx, role, slot, ev);
+    if (ev) CL_CHECK(clReleaseEvent(ev));
+}
+static void ggml_cl_fa_paged_tl_finish(ggml_backend_opencl_context * ctx) {
+    auto & o = ctx->fa_paged;
+    if (o.tl.empty()) return;
+    struct stamp { int role, slot; cl_ulong st, en; };
+    std::vector<stamp> v;
+    v.reserve(o.tl.size());
+    int bad_prof = 0;
+    for (auto & e : o.tl) {
+        CL_CHECK(clWaitForEvents(1, &e.ev));
+        cl_ulong st = 0, en = 0;
+        if (clGetEventProfilingInfo(e.ev, CL_PROFILING_COMMAND_START, sizeof(st), &st, nullptr) != CL_SUCCESS ||
+            clGetEventProfilingInfo(e.ev, CL_PROFILING_COMMAND_END, sizeof(en), &en, nullptr) != CL_SUCCESS) {
+            ++bad_prof;
+        }
+        v.push_back({ e.role, e.slot, st, en });
+        CL_CHECK(clReleaseEvent(e.ev));
+    }
+    o.tl.clear();
+    o.tl_graph = -1;
+    o.tl_graphs_seen = 0;
+    o.tl_base = nullptr;
+    if (bad_prof > 0) {
+        if (!o.tl_warned) {
+            o.tl_warned = true;
+            GGML_LOG_WARN("ggml_opencl: paged FA timeline: %d stamps carry no profiling (the compute queue needs a "
+                    "build with GGML_OPENCL_PROFILING); no timeline printed\n", bad_prof);
+        }
+        return;
+    }
+    cl_ulong base = 0;
+    std::vector<stamp> ev;   // the base stamp is dropped from the list
+    for (auto & x : v) if (x.role == -1) base = x.en; else ev.push_back(x);
+    GGML_LOG_WARN("ggml_opencl: paged FA timeline: base the graph's first paged command; %zu stamps, ns relative to it\n",
+            ev.size());
+    for (int slot = 0; slot < 2; ++slot) {
+        std::vector<cl_ulong> cs, ce, fs, fe, me, cons, post;
+        for (auto & x : ev) {
+            if (x.slot != slot) continue;
+            if (x.role == 0) cs.push_back(x.en - base);
+            else if (x.role == 1) ce.push_back(x.en - base);
+            else if (x.role == 2) fs.push_back(x.en - base);
+            else if (x.role == 3) fe.push_back(x.en - base);
+            else if (x.role == 4) me.push_back(x.en - base);
+            else if (x.role == 5) cons.push_back(x.en - base);
+            else if (x.role == 6) post.push_back(x.en - base);
+        }
+        for (size_t k = 0; k < cs.size(); ++k) {
+            GGML_LOG_WARN("ggml_opencl: paged FA timeline: slot %d copy %zu start %lld end %lld; FA split start %lld "
+                    "end %lld; merge end %lld; consumed %lld; post %lld ns\n", slot, k,
+                    (long long) cs[k], k < ce.size() ? (long long) ce[k] : -1,
+                    k < fs.size() ? (long long) fs[k] : -1, k < fe.size() ? (long long) fe[k] : -1,
+                    k < me.size() ? (long long) me[k] : -1, k < cons.size() ? (long long) cons[k] : -1,
+                    k < post.size() ? (long long) post[k] : -1);
+        }
+    }
+    // the derived margin, per slot: copy k+2 (the third copy onward) against FA k's split end
+    long long worst = 0, prev_reader = 0, pre_start = -1, last_fa = -1;
+    int pairs = 0, neg = 0;
+    for (int slot = 0; slot < 2; ++slot) {
+        std::vector<cl_ulong> cs, fe;
+        for (auto & x : ev) {
+            if (x.slot != slot) continue;
+            if (x.role == 0) cs.push_back(x.en - base);
+            else if (x.role == 3) fe.push_back(x.en - base);
+        }
+        long long mn = 0;
+        int n = 0;
+        for (size_t k = 0; k + 1 < cs.size() && k < fe.size(); ++k) {
+            const long long m = (long long) cs[k + 1] - (long long) fe[k];
+            if (n == 0 || m < mn) mn = m;
+            ++n;
+            if (m < 0) ++neg;
+            if (pairs == 0 || m < worst) worst = m;
+            ++pairs;
+            if (n == 1) prev_reader = (long long) fe[k];   // slot's first FA is its first reader
+        }
+        GGML_LOG_WARN("ggml_opencl: paged FA timeline margin: slot %d min %lld ns over %d pairs\n", slot, mn, n);
+    }
+    for (auto & x : ev) {
+        if (x.role == 7) pre_start = (long long) x.en - (long long) base;
+        if (x.role == 3) last_fa = (long long) x.en - (long long) base;
+    }
+    GGML_LOG_WARN("ggml_opencl: paged FA timeline margin: min %lld ns over %d pairs, negative %d; "
+            "cross-step prefetch copy start %lld ns, that slot's first FA split end %lld ns, margin %lld ns; "
+            "last FA split end %lld ns, margin %lld ns\n",
+            worst, pairs, neg, pre_start, prev_reader, pre_start >= 0 && prev_reader >= 0 ? pre_start - prev_reader : -1,
+            last_fa, pre_start >= 0 && last_fa >= 0 ? pre_start - last_fa : -1);
+}
