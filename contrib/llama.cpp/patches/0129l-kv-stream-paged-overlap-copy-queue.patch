+// 0129l (I5, step two): GGML_OPENCL_FA_PAGED_OVERLAP=1 moves a paged FA's page copies to their
+// own in-order queue, so layer L's copies run while layer L-1's kernels do. Two parities, one
+// slot each, as FreeToken's prefill double buffer (python/freetoken/moe/offload_cache.py:887-918,
+// 1055-1068) and Strata's chunk ring (src/dsv41/ds4_model.cu:4868-4939, 11806-11811) order theirs:
+// a copy into slot p waits for the FA that last read it (consumed), and that FA waits for its copy
+// (ready). A copy also waits for a marker of the compute queue taken when it is enqueued
+// (GGML_OPENCL_BANK_STREAM's gmark, patch 0032, ggml-opencl.cpp:30422-30429), so it sees the
+// host store's writes and the page table as they stand at this layer. Default off: unset leaves
+// every copy on the compute queue, exactly as 0123zzzzz3 did.
+static bool ggml_cl_fa_paged_overlap_on() {
+    static const char * e = getenv("GGML_OPENCL_FA_PAGED_OVERLAP");
+    static const bool   on = e != nullptr && atoi(e) != 0;
+    return on;
+}
+// GGML_OPENCL_FA_PAGED_OVERLAP_NOWAIT=1, development only: the red arm. The copies stay on the
+// copy queue, but the FA no longer waits for its ready event, so the kernel reads a slot
+// mid-copy. A race with the copies has to show as wrong answers or a failing check; if an arm
+// with NOWAIT reads right, the arm proves nothing (the device finished the copy early).
+static bool ggml_cl_fa_paged_overlap_nowait() {
+    static const char * e = getenv("GGML_OPENCL_FA_PAGED_OVERLAP_NOWAIT");
+    static const bool   on = e != nullptr && atoi(e) != 0;
+    return on;
+}
+// the copy queue and this graph's per-parity events; returns the parity this dispatch takes
+static int ggml_cl_fa_paged_overlap_begin(ggml_backend_opencl_context * ctx, cl_event * mark) {
+    auto & o = ctx->fa_paged;
+    if (o.gen != ctx->graph_gen) {
+        // a new graph: release what the last one left, start at parity 0
+        for (int i = 0; i < 2; ++i) {
+            if (o.ready[i])    { CL_CHECK(clReleaseEvent(o.ready[i]));    o.ready[i] = nullptr; }
+            if (o.consumed[i]) { CL_CHECK(clReleaseEvent(o.consumed[i])); o.consumed[i] = nullptr; }
+        }
+        o.gen  = ctx->graph_gen;
+        o.next = 0;
+    }
+    if (o.q == nullptr) {
+        cl_int err;
+        o.q = clCreateCommandQueue(ctx->context, ctx->device, 0, &err);
+        CL_CHECK(err);
+    }
+    const int parity = o.next % 2;
+    o.next++;
+    CL_CHECK(clEnqueueMarkerWithWaitList(ctx->queue, 0, nullptr, mark));
+    CL_CHECK(clFlush(ctx->queue));   // the marker the copy queue waits for
+    return parity;
+}
+// after the copies: their ready event, and (unless NOWAIT) the FA's wait for it
+static void ggml_cl_fa_paged_overlap_ready(ggml_backend_opencl_context * ctx, int parity, cl_event mark) {
+    auto & o = ctx->fa_paged;
+    if (o.ready[parity]) { CL_CHECK(clReleaseEvent(o.ready[parity])); o.ready[parity] = nullptr; }
+    CL_CHECK(clEnqueueMarkerWithWaitList(o.q, 0, nullptr, &o.ready[parity]));
+    CL_CHECK(clFlush(o.q));
+    if (!ggml_cl_fa_paged_overlap_nowait()) {
+        CL_CHECK(clEnqueueBarrierWithWaitList(ctx->queue, 1, &o.ready[parity], nullptr));
+    }
+    if (mark) CL_CHECK(clReleaseEvent(mark));
+    o.logged++;
+    if (o.logged == 1) {
+        GGML_LOG_WARN("ggml_opencl: paged FA overlap: the page copies on their own queue%s\n",
+                ggml_cl_fa_paged_overlap_nowait() ? " (NOWAIT: the FA does not wait for its copy)" : "");
+    }
+}
+// after a layer's FA kernels: the slot's read is done, a later copy may overwrite it
