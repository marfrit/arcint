+// 0187: the eligibility of a F32 copy for kernel_cpy_f32_f32_t01 - a (0,1)-swapped copy whose
+// source has dim 1 as its fastest dimension and whose destination is contiguous. Pure: no cl_
+// calls and no device, so a unit test can feed it a graph node's real strides on the CPU host.
+//
+// The kernel indexes `src + gz*s_nb2 + dim0*s_nb0 + dim1*s_nb1` for a token slab and writes
+// `dst + gz*d_nb2 + dim1*d_nb1 + dim0*4`, so the form it serves is:
+//   - the source's slow (dim 0) step is one full row of the fast (dim 1) axis, `ne[1]*4`;
+//   - the source's fast (dim 1) step is one float;
+//   - the source's token stride (dim 2) covers the token slab, `>= ne[0]*ne[1]*4`;
+//   - the source's dim-3 stride steps by the dim-2 count;
+//   - the destination is contiguous.
+// A plain contiguous source (nb[0] == 4) and a merely strided-rows source fail it.
+#ifndef GGML_OPENCL_CPY_T01_H
+#define GGML_OPENCL_CPY_T01_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+static inline bool ggml_cl_cpy_t01_eligible(
+        int      ts0,                    // the source's tensor type, GGML_TYPE_F32 == 0
+        int      ts1,                    // the destination's tensor type
+        const int64_t * ne0,             // the source's four dimensions
+        const size_t  * nb0,             // the source's four byte strides
+        const int64_t * ne1,             // the destination's four dimensions
+        const size_t  * nb1) {           // the destination's four byte strides
+    const size_t esz = sizeof(float);
+    if (ts0 != 0 || ts1 != 0) {
+        return false;                    // F32 x F32 only
+    }
+    for (int i = 0; i < 4; ++i) {
+        if (ne0[i] != ne1[i]) {
+            return false;                // the kernel copies one shape, strides differ
+        }
+    }
+    // the destination contiguous: the kernel writes it as gz*d_nb2 + bin*d_nb1 + dim0*4
+    if (nb1[0] != esz || nb1[1] != (size_t) ne1[0] * esz ||
+        nb1[2] != nb1[1] * (size_t) ne1[1] || nb1[3] != nb1[2] * (size_t) ne1[2]) {
+        return false;
+    }
+    // the source: dim 1 fastest, dim 0 one fast row long, the token slab covered
+    if (nb0[1] != esz || nb0[0] != (size_t) ne0[1] * esz) {
+        return false;
+    }
+    if (nb0[2] < (size_t) ne0[0] * (size_t) ne0[1] * esz || nb0[3] != nb0[2] * (size_t) ne0[2]) {
+        return false;
+    }
+    return true;
+}
+
+#endif // GGML_OPENCL_CPY_T01_H
