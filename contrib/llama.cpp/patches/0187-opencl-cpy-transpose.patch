+// 0187: a (0,1)-swapped copy - the source's fastest dimension is dim 1 and the destination's is
+// dim 0 - as a tiled transpose through local memory: reads coalesced over dim 1 (the source's
+// fastest), writes coalesced over dim 0 (the destination's). A work-group is a 16 x 16 tile of
+// (dim 0, dim 1); `reqd_work_group_size` keeps the tile barrier's threads present, and a partial
+// tile on either edge (the bias table's 24 heads and 1,025 bins) is guarded per element.
+// GGML_OPENCL_CPY_TRANSPOSE=1 selects it; with the knob unset the pack kernel runs as before.
+#ifndef CPY_T_TILE
+#define CPY_T_TILE 16
+#endif
+__attribute__((reqd_work_group_size(CPY_T_TILE, CPY_T_TILE, 1)))
+kernel void kernel_cpy_f32_f32_t01(
+        global const char * src_void, ulong offset0,
+        global char * dst_void, ulong offsetd,
+        int d0, int d1, int d23,                  // dst dim0, dim1, dims 2*3 flattened
+        ulong s_nb0, ulong s_nb1, ulong s_nb2, ulong s_nb3,
+        ulong d_nb1, ulong d_nb2, ulong d_nb3) {
+    const int l0 = get_local_id(0);          // a dim-1 index while reading, dim 0 while writing
+    const int l1 = get_local_id(1);          // the other way round
+    const int gx = get_group_id(0);          // dim-1 tile
+    const int gy = get_group_id(1);          // dim-0 tile
+    const int gz = get_group_id(2);          // token (dims 2*3 flattened)
+    if (gz >= d23) {
+        return;
+    }
+    const int bin  = gx * CPY_T_TILE + l0;   // dim 1 (a row of the destination)
+    const int head = gy * CPY_T_TILE + l1;   // dim 0 (a column)
+    local float tile[CPY_T_TILE][CPY_T_TILE + 1];
+    float v = 0.0f;
+    if (bin < d1 && head < d0) {
+        v = *(global const float *)(src_void + offset0 + gz * s_nb2 + (ulong) head * s_nb0 + (ulong) bin * s_nb1);
+    }
+    tile[l1][l0] = v;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    // the transposed pairing: this thread writes the element the tile holds for
+    // (dim 0 = gx*T + l0, dim 1 = gy*T + l1), i.e. the writes coalesce over dim 0
+    const int bin_w  = gx * CPY_T_TILE + l1;
+    const int head_w = gy * CPY_T_TILE + l0;
+#ifdef CPY_T_RED
+    const bool ok_w = bin_w < d1 - 1 && head_w < d0;   // the red case: the last dim-1 edge is lost
+#else
+    const bool ok_w = bin_w < d1 && head_w < d0;
+#endif
+    if (ok_w) {
+        *(global float *)(dst_void + offsetd + gz * d_nb2 + (ulong) bin_w * d_nb1 + (ulong) head_w * sizeof(float)) = tile[l0][l1];
+    }
+}
+
