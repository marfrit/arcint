+    const int ne11 = (int)src1->ne[1];
+    const int ne12 = (int)src1->ne[2];
+    const int n_used = (int)ids->ne[0];
+    const int n_tok  = (int)ids->ne[1];
+    const int n_expert = (int)src0->ne[2];
