+// (mul_mm_kq_f16.cl).
+static bool ggml_cl_mul_mat_id_kq(ggml_backend_opencl_context * backend_ctx, const ggml_tensor * src0,
+                                  const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
