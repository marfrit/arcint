diff --git a/src/models/gdn-gate-inputs.h b/src/models/gdn-gate-inputs.h
new file mode 100644
index 0000000..f9b2a62
--- /dev/null
+++ b/src/models/gdn-gate-inputs.h
@@ -0,0 +1,39 @@
+// The raw gating projections of a gated delta-net node, kept alive to it.
+//
+// Patch 0051's OpenCL fold computes the gating inside the GDN kernel from the
+// raw projections alpha and b (vllm-xpu-kernels' delta stage takes a and b with
+// A_log and dt_bias). The kernel reads them when the GDN runs, later than the
+// allocator keeps them: it frees alpha after the ADD. Attaching them as extra
+// sources of the GDN node keeps them alive; the op's semantics do not change and
+// the CPU ignores them.
+//
+// The slots are the GDN family's contract (ggml.h, op_params[1] = mode):
+// alpha rides src[8], b rides src[9]. src[6] is the rows form's I32 row index
+// and src[6]/src[7] are the replay's records and control; an attached gating
+// input on src[6] made a gathered node look like the rows form and every
+// consumer that reads a row index there asserted on a F32 (patch 0081's red).
+// A backend folds only when its sources are the chain's raw inputs.
+//
+// ggml.h only, so the same text serves the graph builders and the device-free
+// cell (tests/test_gdn_gate_slots.cpp).
+
+#ifndef GGML_GDN_GATE_INPUTS_H
+#define GGML_GDN_GATE_INPUTS_H
+
+#include "ggml.h"
+
+static inline void gdn_keep_gating_inputs(ggml_tensor * gdn, ggml_tensor * g, ggml_tensor * b) {
+    const auto unary = [](const ggml_tensor * t, ggml_unary_op u) { return t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == u; };
+    ggml_tensor * m = g->op == GGML_OP_RESHAPE ? g->src[0] : g;
+    if (m->op == GGML_OP_MUL) {
+        ggml_tensor * sp = unary(m->src[0], GGML_UNARY_OP_SOFTPLUS) ? m->src[0] : m->src[1];
+        if (unary(sp, GGML_UNARY_OP_SOFTPLUS) && sp->src[0]->op == GGML_OP_ADD) {
+            gdn->src[8] = sp->src[0]->src[0];
+        }
+    }
+    if (unary(b, GGML_UNARY_OP_SIGMOID)) {
+        gdn->src[9] = b->src[0];
+    }
+}
+
+#endif // GGML_GDN_GATE_INPUTS_H
diff --git a/src/models/gdn-qk-l2-norm.h b/src/models/gdn-qk-l2-norm.h
new file mode 100644
index 0000000..9e48e46
--- /dev/null
+++ b/src/models/gdn-qk-l2-norm.h
@@ -0,0 +1,57 @@
+#pragma once
+
+// Patch 0082: one l2_norm over the joint q/k head groups of the GDN conv output.
+//
+// The gated delta-net layers' q and k norm is rms_norm(x, eps/n) * (1/sqrt(n))
+// per row (build_gdn_l2_norm, src/models/models.h), run once for q and once for
+// k. In the conv output q and k are adjacent head groups of the same width, so
+// one l2_norm over the joint view [head_k_dim, 2*num_k_heads, n_seq_tokens,
+// n_seqs] normalises both, and q and k are views into its dense result -- the
+// same normalization per row, one pair of nodes fewer a layer.
+//
+// Device-free by construction (ggml.h only), so tests/test_gdn_qk_l2_norm.cpp
+// runs it against the two separate norms on the CPU backend and compares bytes.
+//
+// This header is NOT a general API: it assumes q then k adjacent in the conv
+// output at the same width, which is what the qwen35-family builders lay out.
+
+#include "ggml.h"
+
+#include <cmath>
+
+static inline ggml_tensor * build_gdn_l2_norm(ggml_context * ctx, ggml_tensor * x, float eps) {
+    const float n = x->ne[0];
+
+    return ggml_scale(ctx, ggml_rms_norm(ctx, x, eps/n), 1.0f/sqrtf(n));
+}
+
+// q_out/k_out: the normalised [head_k_dim, num_k_heads, n_seq_tokens, n_seqs] slices.
+// conv_qkv_mix: the strided conv output; nb1_qkv: its row stride in bytes.
+static inline void build_gdn_qk_l2_norm(
+        ggml_context * ctx,
+        ggml_tensor  * conv_qkv_mix,
+              int64_t   head_k_dim,
+              int64_t   num_k_heads,
+              int64_t   n_seq_tokens,
+              int64_t   n_seqs,
+              size_t    nb1_qkv,
+              float     eps,
+        ggml_tensor ** q_out,
+        ggml_tensor ** k_out) {
+    // q and k are the first 2*num_k_heads head groups of the conv output; the joint
+    // view keeps the conv output's row stride (nb[1] = head_k_dim contiguous, the
+    // group stride nb[2] = nb1_qkv), so every dim-0 row is contiguous
+    ggml_tensor * qk = ggml_view_4d(ctx, conv_qkv_mix, head_k_dim, 2 * num_k_heads, n_seq_tokens, n_seqs,
+            ggml_row_size(conv_qkv_mix->type, head_k_dim),
+            nb1_qkv,
+            nb1_qkv * n_seq_tokens,
+            0);
+    qk = build_gdn_l2_norm(ctx, qk, eps);
+
+    // the norm's result is dense: q and k are its first and second head groups
+    const size_t nb1 = qk->nb[1];
+    *q_out = ggml_view_4d(ctx, qk, head_k_dim, num_k_heads, n_seq_tokens, n_seqs,
+            nb1, qk->nb[2], qk->nb[3], 0);
+    *k_out = ggml_view_4d(ctx, qk, head_k_dim, num_k_heads, n_seq_tokens, n_seqs,
+            nb1, qk->nb[2], qk->nb[3], num_k_heads * nb1);
+}
