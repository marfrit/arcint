+        const uint tn = min((uint)TC, n_tokens - c * TC);
+        for (uint tt = 0; tt < tn; ++tt) {
+            float k[KL], q[KL];
+            #pragma unroll
+            for (int m = 0; m < KL; ++m) {
+                q[m] = LBLOCK_READ_F(cb + tt * S_V + m * SG);
+                k[m] = LBLOCK_READ_F(cb + TC * S_V + tt * S_V + m * SG);
