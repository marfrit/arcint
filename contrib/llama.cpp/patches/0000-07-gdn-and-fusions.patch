+                #pragma unroll
+                for (int m = 0; m < KL; ++m) {
+                    S[r][m] = fma(k[m], d, g * S[r][m]);
+                    p = fma(S[r][m], q[m], p);
+                }
+                out[r] = sub_group_reduce_add(p);
+            }
