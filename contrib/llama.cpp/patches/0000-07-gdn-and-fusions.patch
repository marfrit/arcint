+                global float * sb = (global float *)(snap_buf + off_snap) + (ulong)slot * snap_stride + state_base;
+                #pragma unroll
+                for (int r = 0; r < R; ++r)
+                    #pragma unroll
+                    for (int m = 0; m < KL; ++m) BLOCK_WRITE_F(sb + (ulong)(row0 + r) * S_V + m * SG, S[r][m]);
+            }
+        }
+    }
+
+    if (K == 1u) {
+        global float * sb = data_dst + s_off + state_base;
+        #pragma unroll
+        for (int r = 0; r < R; ++r)
+            #pragma unroll
+            for (int m = 0; m < KL; ++m) BLOCK_WRITE_F(sb + (ulong)(row0 + r) * S_V + m * SG, S[r][m]);
+    }
+}
