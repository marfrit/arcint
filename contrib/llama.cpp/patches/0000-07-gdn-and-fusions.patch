+    const ulong v_base  = (ulong)seq * sv3 + (ulong)head * sv1;
+    const ulong gb_base = (ulong)seq * sb3 + (ulong)head * sb1;
+
+    float S[R][KL];
+    #pragma unroll
+    for (int r = 0; r < R; ++r)
+        #pragma unroll
+        for (int m = 0; m < KL; ++m)
