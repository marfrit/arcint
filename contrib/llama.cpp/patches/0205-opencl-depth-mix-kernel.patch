+// 0205: Inkling 2 Mini's depth attention as one launch. The unfused chain is, a mix call:
+// cpy(cur into the block store), rms_norm over the k+1 states, repeat(queries over the
+// tokens), mul_mat(states, queries), soft_max_ext, cont(transpose(states)), mul_mat(that,
+// the scores), then the norm(s) of the output columns - 8 to 12 nodes, and the cont's copy
+// is the traffic the reference's own kernel does not have. It reads the k+1 states once and
+// keeps them in registers, writes the output once. A token a work-group, n_embd/256 floats
+// a lane; the reduction over the work-group is depth_mix.cl's.
+//
+// GGML_OPENCL_DEPTH_MIX=1 turns it on; unset, the model emits the chain and the dispatch is
+// exactly today's. The shapes are ggml_depth_mix_eligible: a model that starts taking it
+// prints one TAKEN line, and a shape it does not cover leaves a DOWNGRADE line with the
+// reason (once a key, ggml_cl_downgrade).
+static bool ggml_cl_depth_mix_on() {
+    static const bool on = ggml_depth_mix_switch(getenv("GGML_OPENCL_DEPTH_MIX"));
+    return on;
+}
+
+// the kernel is built on the first eligible node: with the knob unset, or on a model that
+// never emits the op, depth_mix.cl is not compiled and nothing else changes
+static cl_kernel ggml_cl_depth_mix_kernel(ggml_backend_opencl_context * backend_ctx) {
+    static bool tried = false;
+    if (!tried && backend_ctx->kernel_depth_mix_f32 == nullptr) {
+        tried = true;
+#ifdef GGML_OPENCL_EMBED_KERNELS
+        const std::string kernel_src {
+            #include "depth_mix.cl.h"
+        };
+#else
+        const std::string kernel_src = read_file("depth_mix.cl");
+#endif
+        // GGML_OPENCL_DEPTH_MIX_OPTS appends compiler options, the red case's route:
+        // -DDEPTH_MIX_RED drops the softmax denominator in depth_mix.cl
+        const char * extra = getenv("GGML_OPENCL_DEPTH_MIX_OPTS");
+        const std::string opts = backend_ctx->kernel_compile_opts + " -cl-intel-256-GRF-per-thread" +
+                                 (extra != nullptr ? std::string(" ") + extra : std::string());
+        cl_program prog = build_program_from_source_optional(backend_ctx, kernel_src.c_str(), opts);
+        if (prog == nullptr) {
+            ggml_cl_downgrade("op=DEPTH_MIX path=cpu reason=not-built");
+            GGML_LOG_WARN("ggml_opencl: depth_mix.cl did not build; GGML_OP_DEPTH_MIX stays on the CPU\n");
+        } else {
+            cl_int err;
+            CL_CHECK((backend_ctx->kernel_depth_mix_f32 = clCreateKernel(prog, "kernel_depth_mix_f32", &err), err));
+            CL_CHECK(clReleaseProgram(prog));
+        }
+    }
+    return backend_ctx->kernel_depth_mix_f32;
+}
+
+static void ggml_cl_depth_mix(ggml_backend_t backend, const ggml_tensor * blocks, const ggml_tensor * cur, ggml_tensor * dst) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *)backend->context;
+
+    // supports_op decides from shapes and strides alone; device storage is this call's
+    // invariant (the scheduler has allocated the node's inputs by now)
+    GGML_ASSERT(blocks->extra && cur->extra && dst->src[2]->extra && dst->extra);
+    GGML_ASSERT(dst->src[3] == nullptr || dst->src[3]->extra);
+
+    const ggml_tensor * queries = dst->src[2];
+    const ggml_tensor * norm_w  = dst->src[3];
+
+    ggml_tensor_extra_cl * extrab = (ggml_tensor_extra_cl *) blocks->extra;
+    ggml_tensor_extra_cl * extrac = (ggml_tensor_extra_cl *) cur->extra;
+    ggml_tensor_extra_cl * extraq = (ggml_tensor_extra_cl *) queries->extra;
+    ggml_tensor_extra_cl * extrad = (ggml_tensor_extra_cl *) dst->extra;
+
+    const cl_ulong offb = extrab->offset + blocks->view_offs;
+    const cl_ulong offc = extrac->offset + cur->view_offs;
+    const cl_ulong offq = extraq->offset + queries->view_offs;
+    const cl_ulong offd = extrad->offset + dst->view_offs;
+
+    const int ne0 = (int) blocks->ne[0];
+    const int k   = (int) blocks->ne[1];     // the block rows; cur is the k+1'th state
+    const int nq  = (int) queries->ne[1];
+    const int nt  = (int) blocks->ne[2];
+
+    const float eps_states = ggml_get_op_params_f32(dst, 0);
+    const float eps_out    = ggml_get_op_params_f32(dst, 1);
+    const float scale      = ggml_get_op_params_f32(dst, 2);
+
+    // the query columns of a 1-D weight are one column: its row step is never read
+    const cl_ulong nbq1 = nq > 1 ? queries->nb[1] : 0;
+    cl_mem nwb = nullptr;
+    cl_ulong offn = 0, nbn1 = 0;
+    int has_nw = 0;
+    if (norm_w != nullptr) {
+        ggml_tensor_extra_cl * extran = (ggml_tensor_extra_cl *) norm_w->extra;
+        nwb   = extran->data_device;
+        offn  = extran->offset + norm_w->view_offs;
+        nbn1  = norm_w->ne[1] > 1 ? norm_w->nb[1] : 0;
+        has_nw = 1;
+    }
+
+    // the furthest byte each argument can reach from the global size and the strides handed
+    // to the kernel, against its buffer (a view's offset included)
+    {
+        const size_t ub = (size_t) offb + (size_t) (k - 1)*blocks->nb[1] + (size_t) (nt - 1)*blocks->nb[2] + (size_t) (ne0 - 1)*sizeof(float) + sizeof(float);
+        const size_t uc = (size_t) offc + (size_t) (nt - 1)*cur->nb[1] + (size_t) (ne0 - 1)*sizeof(float) + sizeof(float);
+        const size_t uq = (size_t) offq + (size_t) (nq - 1)*nbq1 + (size_t) (ne0 - 1)*sizeof(float) + sizeof(float);
+        const size_t ud = (size_t) offd + (size_t) nq*dst->nb[2] - (size_t) dst->nb[2] + (size_t) (nt - 1)*dst->nb[1] + (size_t) (ne0 - 1)*sizeof(float) + sizeof(float);
+        ggml_cl_bounds("depth mix", "blocks", extrab->data_device, ub);
+        ggml_cl_bounds("depth mix", "cur",    extrac->data_device, uc);
+        ggml_cl_bounds("depth mix", "queries", extraq->data_device, uq);
+        ggml_cl_bounds("depth mix", "dst",    extrad->data_device, ud);
+        if (norm_w != nullptr) {
+            ggml_cl_bounds("depth mix", "norm_w", nwb, (size_t) offn + (size_t) (nq - 1)*nbn1 + (size_t) (ne0 - 1)*sizeof(float) + sizeof(float));
+        }
+    }
+
+    cl_kernel kernel = ggml_cl_depth_mix_kernel(backend_ctx);
+    GGML_ASSERT(kernel != nullptr);
+
+    CL_CHECK(clSetKernelArg(kernel,  0, sizeof(cl_mem),   &extrab->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  1, sizeof(cl_ulong), &offb));
+    CL_CHECK(clSetKernelArg(kernel,  2, sizeof(cl_ulong), &blocks->nb[1]));
+    CL_CHECK(clSetKernelArg(kernel,  3, sizeof(cl_ulong), &blocks->nb[2]));
+    CL_CHECK(clSetKernelArg(kernel,  4, sizeof(cl_mem),   &extrac->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  5, sizeof(cl_ulong), &offc));
+    CL_CHECK(clSetKernelArg(kernel,  6, sizeof(cl_ulong), &cur->nb[1]));
+    CL_CHECK(clSetKernelArg(kernel,  7, sizeof(cl_mem),   &extraq->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  8, sizeof(cl_ulong), &offq));
+    CL_CHECK(clSetKernelArg(kernel,  9, sizeof(cl_ulong), &nbq1));
+    CL_CHECK(clSetKernelArg(kernel, 10, sizeof(cl_mem),   &nwb));
+    CL_CHECK(clSetKernelArg(kernel, 11, sizeof(cl_ulong), &offn));
+    CL_CHECK(clSetKernelArg(kernel, 12, sizeof(cl_ulong), &nbn1));
+    CL_CHECK(clSetKernelArg(kernel, 13, sizeof(int),      &has_nw));
+    CL_CHECK(clSetKernelArg(kernel, 14, sizeof(cl_mem),   &extrad->data_device));
+    CL_CHECK(clSetKernelArg(kernel, 15, sizeof(cl_ulong), &offd));
+    CL_CHECK(clSetKernelArg(kernel, 16, sizeof(cl_ulong), &dst->nb[1]));
+    CL_CHECK(clSetKernelArg(kernel, 17, sizeof(cl_ulong), &dst->nb[2]));
+    CL_CHECK(clSetKernelArg(kernel, 18, sizeof(int),      &ne0));
+    CL_CHECK(clSetKernelArg(kernel, 19, sizeof(int),      &k));
+    CL_CHECK(clSetKernelArg(kernel, 20, sizeof(int),      &nq));
+    CL_CHECK(clSetKernelArg(kernel, 21, sizeof(float),    &eps_states));
+    CL_CHECK(clSetKernelArg(kernel, 22, sizeof(float),    &eps_out));
+    CL_CHECK(clSetKernelArg(kernel, 23, sizeof(float),    &scale));
+    // the partial sums: one float a lane for each reduced quantity, sized at the launch
+    const int np = (k + 1)*(1 + nq);
+    CL_CHECK(clSetKernelArg(kernel, 24, (size_t) np*256*sizeof(float), nullptr));
+
+    const size_t lsz = 256;
+    size_t global_work_size[] = { (size_t) nt*lsz, 1, 1 };
+    size_t local_work_size[]  = { lsz, 1, 1 };
+
+    static bool taken_told = false;
+    if (!taken_told) {
+        taken_told = true;
+        GGML_LOG_INFO("depth_mix: TAKEN opencl f32 token-a-group\n");
+    }
+    backend_ctx->depth_mix_calls_graph++;
+
+    backend_ctx->enqueue_ndrange_kernel(kernel, 3, global_work_size, local_work_size, dst);
+}
