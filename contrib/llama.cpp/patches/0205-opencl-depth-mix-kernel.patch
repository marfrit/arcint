diff --git a/ggml/src/ggml-opencl/kernels/depth_mix.cl b/ggml/src/ggml-opencl/kernels/depth_mix.cl
new file mode 100644
index 0000000..fcd3c6b
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/depth_mix.cl
@@ -0,0 +1,265 @@
+//------------------------------------------------------------------------------
+// depth_mix
+//------------------------------------------------------------------------------
+// Inkling 2 Mini's depth attention as one launch: a token a work-group, fp32
+// throughout, the states read once from global into registers and never written
+// back. The reference's _mix_kernel (trellis-serve xpu/exl3xpu/inkling2/fused.py
+// @8f8e2fcc) is the same algorithm, a token a program; its three-state read per
+// call (NORM) is the traffic this form drops.
+//
+//   v_s   the k block rows of the store and cur (n_state = k + 1)
+//   ss_s  sum of v_s^2 over n_embd, reduced over the work-group
+//   inv_s 1 / sqrt(ss_s / n_embd + eps_states)
+//   score[q][s] = scale * inv_s * (queries[q] . v_s), softmax over s
+//   out[q]      = sum_s p[q][s] * v_s, and with norm_w: * 1/sqrt(mean(out^2) + eps_out) * norm_w[q]
+//
+// n_embd is a multiple of DEPTH_MIX_LS and at most DEPTH_MIX_LS * DEPTH_MIX_EL,
+// so a lane holds DEPTH_MIX_EL floats of each state; the state and element loops
+// are unrolled over their maxima with a runtime guard, which keeps the register
+// array's indices compile-time (a dynamic index would spill to scratch).
+
+#define DEPTH_MIX_LS   256
+#define DEPTH_MIX_STATE 7    // k <= 6 blocks, plus cur
+#define DEPTH_MIX_Q     4
+#define DEPTH_MIX_EL    9    // n_embd <= 256 * 9
+
+// reduce np partial sums held at red[p*DEPTH_MIX_LS + lane]; 8 sub-groups of 32 lanes
+// take 8 quantities a round, a 5-step tree each. The result lands at red[p*DEPTH_MIX_LS].
+static void depth_mix_reduce(local float * red, local float * tmp8, int np, int lane) {
+    const int sub = lane / 32;
+    const int sl  = lane % 32;
+    for (int base = 0; base < np; base += 8) {
+        const int p = base + sub;
+        float v = 0.0f;
+        if (p < np) {
+            for (int j = sl; j < DEPTH_MIX_LS; j += 32) {
+                v += red[p*DEPTH_MIX_LS + j];
+            }
+        }
+        tmp8[sub*32 + sl] = v;
+        barrier(CLK_LOCAL_MEM_FENCE);
+        for (int st = 16; st >= 1; st >>= 1) {
+            if (sl < st) {
+                tmp8[sub*32 + sl] += tmp8[sub*32 + sl + st];
+            }
+            barrier(CLK_LOCAL_MEM_FENCE);
+        }
+        if (sl == 0 && p < np) {
+            red[p*DEPTH_MIX_LS] = tmp8[sub*32];
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+}
+
+kernel void kernel_depth_mix_f32(
+        global char * blk,
+        ulong         offb,
+        ulong         nb1,
+        ulong         nb2,
+        global char * cur,
+        ulong         offc,
+        ulong         nbc1,
+        global char * qry,
+        ulong         offq,
+        ulong         nbq1,
+        global char * nw,
+        ulong         offn,
+        ulong         nbn1,
+        int           has_nw,
+        global char * dst,
+        ulong         offd,
+        ulong         nbd1,
+        ulong         nbd2,
+        int           ne0,
+        int           k,
+        int           nq,
+        float         eps_states,
+        float         eps_out,
+        float         scale,
+        local float * red
+) {
+    blk = blk + offb;
+    cur = cur + offc;
+    qry = qry + offq;
+    dst = dst + offd;
+
+    const int t    = get_group_id(0);
+    const int lane = get_local_id(0);
+    const int el   = ne0 / DEPTH_MIX_LS;
+    const int ns   = k + 1;
+
+    local float tmp8[8*32];
+
+    // pass A: the states, one global read
+    float x[DEPTH_MIX_STATE][DEPTH_MIX_EL];
+    #pragma unroll
+    for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+        if (s < ns) {
+            global const float * src = (s < k)
+                ? (global const float *)(blk + (ulong) s*nb1 + (ulong) t*nb2)
+                : (global const float *)(cur + (ulong) t*nbc1);
+            #pragma unroll
+            for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                x[s][i] = (i < el) ? src[lane + i*DEPTH_MIX_LS] : 0.0f;
+            }
+        }
+    }
+
+    // sum of squares each state, and the query dots; partials into local
+    #pragma unroll
+    for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+        if (s < ns) {
+            float v = 0.0f;
+            #pragma unroll
+            for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                if (i < el) {
+                    v += x[s][i]*x[s][i];
+                }
+            }
+            red[s*DEPTH_MIX_LS + lane] = v;
+        }
+    }
+    #pragma unroll
+    for (int q = 0; q < DEPTH_MIX_Q; ++q) {
+        if (q < nq) {
+            global const float * qp = (global const float *)(qry + (ulong) q*nbq1);
+            #pragma unroll
+            for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                if (s < ns) {
+                    float d = 0.0f;
+                    #pragma unroll
+                    for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                        if (i < el) {
+                            d += x[s][i]*qp[lane + i*DEPTH_MIX_LS];
+                        }
+                    }
+                    red[(ns + q*ns + s)*DEPTH_MIX_LS + lane] = d;
+                }
+            }
+        }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    depth_mix_reduce(red, tmp8, ns*(1 + nq), lane);
+
+    // the weights: every lane computes them from the reduced values, they are lane-invariant
+    float inv[DEPTH_MIX_STATE];
+    #pragma unroll
+    for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+        if (s < ns) {
+            inv[s] = rsqrt(red[s*DEPTH_MIX_LS] / (float) ne0 + eps_states);
+        }
+    }
+
+    if (has_nw) {
+        float outv[DEPTH_MIX_Q][DEPTH_MIX_EL];
+        #pragma unroll
+        for (int q = 0; q < DEPTH_MIX_Q; ++q) {
+            if (q < nq) {
+                float mx = -INFINITY;
+                #pragma unroll
+                for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                    if (s < ns) {
+                        mx = fmax(mx, scale*inv[s]*red[(ns + q*ns + s)*DEPTH_MIX_LS]);
+                    }
+                }
+                float pw[DEPTH_MIX_STATE];
+                float tot = 0.0f;
+                #pragma unroll
+                for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                    if (s < ns) {
+                        pw[s] = exp(scale*inv[s]*red[(ns + q*ns + s)*DEPTH_MIX_LS] - mx);
+                        tot += pw[s];
+                    }
+                }
+                #pragma unroll
+                for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                    if (i < el) {
+                        float o = 0.0f;
+                        #pragma unroll
+                        for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                            if (s < ns) {
+                                o += pw[s]*x[s][i];
+                            }
+                        }
+#ifdef DEPTH_MIX_RED
+                        outv[q][i] = o;   // the red case: the softmax denominator dropped
+#else
+                        outv[q][i] = o / tot;
+#endif
+                    }
+                }
+            }
+        }
+        // the output norm: sum of squares over each column's whole row, reduced, then the weights
+        #pragma unroll
+        for (int q = 0; q < DEPTH_MIX_Q; ++q) {
+            if (q < nq) {
+                float v = 0.0f;
+                #pragma unroll
+                for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                    if (i < el) {
+                        v += outv[q][i]*outv[q][i];
+                    }
+                }
+                red[q*DEPTH_MIX_LS + lane] = v;
+            }
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+        depth_mix_reduce(red, tmp8, nq, lane);
+        #pragma unroll
+        for (int q = 0; q < DEPTH_MIX_Q; ++q) {
+            if (q < nq) {
+                const float onorm = rsqrt(red[q*DEPTH_MIX_LS] / (float) ne0 + eps_out);
+                global const float * w = (global const float *)(nw + (ulong) q*nbn1);
+                global float * o = (global float *)(dst + (ulong) q*nbd2 + (ulong) t*nbd1);
+                #pragma unroll
+                for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                    if (i < el) {
+                        o[lane + i*DEPTH_MIX_LS] = outv[q][i] * onorm * w[lane + i*DEPTH_MIX_LS];
+                    }
+                }
+            }
+        }
+    } else {
+        #pragma unroll
+        for (int q = 0; q < DEPTH_MIX_Q; ++q) {
+            if (q < nq) {
+                float mx = -INFINITY;
+                #pragma unroll
+                for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                    if (s < ns) {
+                        mx = fmax(mx, scale*inv[s]*red[(ns + q*ns + s)*DEPTH_MIX_LS]);
+                    }
+                }
+                float pw[DEPTH_MIX_STATE];
+                float tot = 0.0f;
+                #pragma unroll
+                for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                    if (s < ns) {
+                        pw[s] = exp(scale*inv[s]*red[(ns + q*ns + s)*DEPTH_MIX_LS] - mx);
+                        tot += pw[s];
+                    }
+                }
+                global float * o = (global float *)(dst + (ulong) q*nbd2 + (ulong) t*nbd1);
+                #pragma unroll
+                for (int i = 0; i < DEPTH_MIX_EL; ++i) {
+                    if (i < el) {
+                        float acc = 0.0f;
+                        #pragma unroll
+                        for (int s = 0; s < DEPTH_MIX_STATE; ++s) {
+                            if (s < ns) {
+                                acc += pw[s]*x[s][i];
+                            }
+                        }
+#ifdef DEPTH_MIX_RED
+                        // the red case: the softmax denominator dropped (a test must fail)
+                        o[lane + i*DEPTH_MIX_LS] = acc;
+#else
+                        o[lane + i*DEPTH_MIX_LS] = acc / tot;
+#endif
+                    }
+                }
+            }
+        }
+    }
+}
