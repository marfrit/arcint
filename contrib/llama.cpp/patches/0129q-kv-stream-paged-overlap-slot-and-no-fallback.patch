+// 0129q: the parity is the RING SLOT this node's FA reads (its K ring's buffer and view
+// offset), not the node's place in the chain: the stream's slots are slots[ikv % 2]
+// (llama-kv-stream.h slot_k/slot_v, 0120), and the MTP head's graph or a graph that skips an
+// attention layer would otherwise index a parity that guards another slot. -1 when the ring
+// is not one region (the fallback's own path); a third distinct slot aborts under DEBUG.
+static int ggml_cl_fa_paged_overlap_slot(ggml_backend_opencl_context * ctx, const ggml_tensor * dst) {
+    const ggml_tensor * ring_k = dst->src[GGML_FA_SRC_RING_K];
+    if (!ring_k) return -1;
+    ggml_cl_region rk[2];
+    if (ggml_cl_regions(ring_k, rk) != 1 || rk[0].mem == nullptr) return -1;
+    const cl_mem   m = rk[0].mem;
+    const cl_ulong off = rk[0].off + (cl_ulong) ring_k->view_offs;
+    auto & o = ctx->fa_paged;
+    for (int i = 0; i < 2; ++i) if (o.slot_mem[i] == m && o.slot_off[i] == off) return i;
+    for (int i = 0; i < 2; ++i) if (o.slot_mem[i] == nullptr) { o.slot_mem[i] = m; o.slot_off[i] = off; return i; }
+    if (getenv("GGML_OPENCL_FA_PAGED_DEBUG")) {
+        GGML_ABORT("ggml_opencl: paged FA overlap: a third ring slot (%p + %llu beside %p + %llu, %p + %llu)",
+                (void *) m, (unsigned long long) off, (void *) o.slot_mem[0], (unsigned long long) o.slot_off[0],
+                (void *) o.slot_mem[1], (unsigned long long) o.slot_off[1]);
+    }
+    return -1;
+}
