+// the 6-bit scale of sub-block j alone, for the rolled K loop
+static inline float id_scale_k4(int j, uint3 w) {
+    if (j < 4) return (float)((w.s0 >> (8 * j)) & 63);
+    const int jj = j - 4;
+    return (float)(((w.s2 >> (8 * jj)) & 0xF) | ((((w.s0 >> (8 * jj)) & 0xFF) >> 6) << 4));
+}
