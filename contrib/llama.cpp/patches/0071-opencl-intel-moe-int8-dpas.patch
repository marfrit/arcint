index 501bec6..6565d38 100644
--- a/ggml/src/ggml-opencl/CMakeLists.txt
+++ b/ggml/src/ggml-opencl/CMakeLists.txt
@@ -62,6 +62,27 @@ function(ggml_opencl_add_kernel KNAME)
     endif ()
 endfunction()
 
+# 0071: the int8 DPAS expert GEMM's decode/quantize helpers and dispatch rule,
+# one text for the kernel and tests/test-opencl-kq-i8.cpp. The int8 kernel's own
+# program is built with this prepended (ggml-opencl.cpp), so it reaches the
+# embedded build without an #include the runtime cannot resolve; the XMX GEMM
+# program does not contain it.
+if (GGML_OPENCL_EMBED_KERNELS)
+    set(KQ_I8_HDR ${CMAKE_CURRENT_BINARY_DIR}/autogenerated/kq_i8_ops.inc.h)
+    add_custom_command(
+        OUTPUT ${KQ_I8_HDR}
+        COMMAND ${Python3_EXECUTABLE} ${EMBED_KERNEL_SCRIPT} ${CMAKE_CURRENT_SOURCE_DIR}/kernels/kq_i8_ops.inc ${KQ_I8_HDR}
+        DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/kernels/kq_i8_ops.inc ${EMBED_KERNEL_SCRIPT}
+        COMMENT "Generate ${KQ_I8_HDR}"
+    )
+    target_sources(${TARGET_NAME} PRIVATE ${KQ_I8_HDR})
+else ()
+    # the runtime reads it next to the kernel sources: copy it, so a non-embedded
+    # build does not read an empty file (ggml-opencl.cpp warns if it is empty)
+    configure_file(${CMAKE_CURRENT_SOURCE_DIR}/kernels/kq_i8_ops.inc
+                   ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/kq_i8_ops.inc COPYONLY)
+endif ()
+
