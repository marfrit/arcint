 #endif
@@ -350,7 +371,7 @@ kernel void flash_attn_gqa_dpas(
         // neighbouring halves
         for (int u = lid; u < BK * DV / 64; u += nthr) {
             const int key = u % BK, c64 = u / BK, kk = min(k0 + key, kv_end - 1);
