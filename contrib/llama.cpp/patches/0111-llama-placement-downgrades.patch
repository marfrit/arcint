 }
 
+size_t llama_placement_downgrades(char * buf, size_t size) {
+    const std::string out = llama_placement::global().text();
+    if (buf != nullptr && size > 0) {
+        snprintf(buf, size, "%s", out.c_str());
+    }
+    return out.size();
+}
