+bool ggml_depth_mix_switch(const char * env_value) {
+    if (env_value == NULL) {
+        return false;
+    }
+    if (strcmp(env_value, "0") == 0 || strcmp(env_value, "off") == 0) {
+        return false;
+    }
+    return true;
+}
+
+bool ggml_depth_mix_fold_switch(const char * env_value) {
+    return ggml_depth_mix_switch(env_value) && strcmp(env_value, "nofold") != 0;
+}
