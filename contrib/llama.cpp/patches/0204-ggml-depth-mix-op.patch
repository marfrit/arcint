+void ggml_depth_mix_plan_make(const struct ggml_tensor * dst, struct ggml_depth_mix_plan * plan) {
+    const struct ggml_tensor * blocks  = dst->src[0];
+    const struct ggml_tensor * cur     = dst->src[1];
+    const struct ggml_tensor * queries = dst->src[2];
+    const struct ggml_tensor * norm_w  = dst->src[3];
+
+    plan->ne0    = (int) blocks->ne[0];
+    plan->k      = (int) blocks->ne[1];     // the block rows; cur is the k+1'th state
+    plan->nq     = (int) queries->ne[1];
+    plan->nt     = (int) blocks->ne[2];
+    plan->has_nw = norm_w != NULL;
+
+    plan->nb1  = blocks->nb[1];
+    plan->nb2  = blocks->nb[2];
+    plan->nbc1 = cur->nb[1];
+    // one column is a 1-D weight seen through a reshape: its column step is never read
+    plan->nbq1 = queries->ne[1] > 1 ? queries->nb[1] : 0;
+    plan->nbn1 = norm_w != NULL && norm_w->ne[1] > 1 ? norm_w->nb[1] : 0;
+    plan->nbd1 = dst->nb[1];
+    plan->nbd2 = dst->nb[2];
+
+    const uint64_t row = (uint64_t) plan->ne0*sizeof(float);
+    plan->reach_blocks  = (uint64_t) (plan->k  - 1)*plan->nb1  + (uint64_t) (plan->nt - 1)*plan->nb2 + row;
+    plan->reach_cur     = (uint64_t) (plan->nt - 1)*plan->nbc1 + row;
+    plan->reach_queries = (uint64_t) (plan->nq - 1)*plan->nbq1 + row;
+    plan->reach_norm_w  = plan->has_nw ? (uint64_t) (plan->nq - 1)*plan->nbn1 + row : 0;
+    plan->reach_dst     = (uint64_t) (plan->nq - 1)*plan->nbd2 + (uint64_t) (plan->nt - 1)*plan->nbd1 + row;
+
+    // one float a lane for each reduced quantity: the first reduction's (k+1)*(1+nq), and the
+    // folded norm's nq past them (no slot shared between the two reductions)
+    plan->local_floats = (uint64_t) ((plan->k + 1)*(1 + plan->nq) + plan->nq)*256;
+}
+
+bool ggml_view_within_src(const struct ggml_tensor * view) {
+    const struct ggml_tensor * src = view->view_src;
+    if (src == NULL) {
+        return true;
+    }
+    if (ggml_nelements(view) == 0) {
+        return true;
+    }
+    size_t reach = view->view_offs + ggml_type_size(view->type);
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        reach += (size_t) (view->ne[i] - 1)*view->nb[i];
+    }
+    return reach <= ggml_nbytes(src);
+}
+
+struct ggml_tensor * ggml_depth_mix_column(struct ggml_context * ctx, struct ggml_tensor * mixed, int64_t col) {
+    GGML_ASSERT(mixed->op == GGML_OP_DEPTH_MIX);
+    GGML_ASSERT(col >= 0 && col < mixed->ne[2]);
+    struct ggml_tensor * view = ggml_view_2d(ctx, mixed, mixed->ne[0], mixed->ne[1], mixed->nb[1], (size_t) col*mixed->nb[2]);
+    GGML_ASSERT(ggml_view_within_src(view));
+    return view;
+}
+
+bool ggml_depth_mix_eligible(const struct ggml_tensor * blocks, const struct ggml_tensor * cur,
+                             const struct ggml_tensor * queries, const struct ggml_tensor * norm_w) {
+    return ggml_depth_mix_refuse(blocks, cur, queries, norm_w) == NULL;
+}
+
+struct ggml_tensor * ggml_depth_mix(
+    struct ggml_context * ctx,
+    struct ggml_tensor  * blocks,
+    struct ggml_tensor  * cur,
+    struct ggml_tensor  * queries,
+    struct ggml_tensor  * norm_w,
+    float                 eps_states,
+    float                 eps_out,
+    float                 scale) {
+    GGML_ASSERT(ggml_depth_mix_eligible(blocks, cur, queries, norm_w));
+
+    // [n_embd, n_tokens, nq]: a query column's whole token block is contiguous, so the graph
