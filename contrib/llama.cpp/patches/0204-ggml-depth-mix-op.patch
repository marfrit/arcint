+// the pure shape/type/stride rule: one place, so the model's emission, the OpenCL dispatch and the
+// CPU op cannot disagree about what the arm covers. NULL means covered.
+const char * ggml_depth_mix_refuse(const struct ggml_tensor * blocks, const struct ggml_tensor * cur,
+                                   const struct ggml_tensor * queries, const struct ggml_tensor * norm_w) {
+    if (blocks == NULL || cur == NULL || queries == NULL) {
+        return "missing";
+    }
+    if (blocks->type != GGML_TYPE_F32 || cur->type != GGML_TYPE_F32 || queries->type != GGML_TYPE_F32 ||
+        (norm_w != NULL && norm_w->type != GGML_TYPE_F32)) {
+        return "not-f32";
+    }
+    const int64_t n_embd = blocks->ne[0];
+    if (n_embd % 256 != 0 || n_embd > 256*9) {
+        return "d-lanes";   // the kernel holds n_embd/256 floats a lane (9 at most), lane width 256
+    }
+    if (blocks->ne[1] < 1 || blocks->ne[1] > 6) {
+        return "k";
+    }
+    if (blocks->ne[2] < 2) {
+        return "decode";   // the arm is a prefill one; T = 1 keeps today's chain
+    }
+    if (blocks->ne[3] != 1) {
+        return "blocks-shape";
+    }
+    if (blocks->nb[0] != sizeof(float) || blocks->nb[1] != n_embd*sizeof(float)) {
+        return "blocks-stride";   // the block rows back to back, so a state is a row step
+    }
+    if (blocks->nb[2] < blocks->ne[1]*blocks->nb[1]) {
+        return "blocks-slab";   // a token's slab must not overlap the next token's states
+    }
+    if (cur->ne[0] != n_embd || cur->ne[1] != blocks->ne[2] || cur->ne[2] != 1 || cur->ne[3] != 1) {
+        return "cur-shape";
+    }
+    if (cur->nb[0] != sizeof(float) || cur->nb[1] != n_embd*sizeof(float)) {
+        return "cur-stride";
+    }
+    if (queries->ne[0] != n_embd || queries->ne[1] < 1 || queries->ne[1] > 4 || queries->ne[2] != 1 || queries->ne[3] != 1) {
+        return "q-shape";
+    }
+    if (queries->nb[0] != sizeof(float) || (queries->ne[1] > 1 && queries->nb[1] < n_embd*sizeof(float))) {
+        return "q-stride";   // one column is a 1-D weight, its row step is never read
+    }
+    if (norm_w != NULL) {
+        if (norm_w->ne[0] != n_embd || norm_w->ne[2] != 1 || norm_w->ne[3] != 1 ||
+            (norm_w->ne[1] != 1 && norm_w->ne[1] != queries->ne[1])) {
+            return "nw-shape";
+        }
+        if (norm_w->nb[0] != sizeof(float) || (norm_w->ne[1] > 1 && norm_w->nb[1] < n_embd*sizeof(float))) {
+            return "nw-stride";
+        }
+    }
+    return NULL;
+}
