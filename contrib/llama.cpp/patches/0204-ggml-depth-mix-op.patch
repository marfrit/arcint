+// ggml_compute_forward_depth_mix
+
+// the unfused chain reads: cpy(cur into the stack), rms_norm over the k + 1 states,
+// repeat(queries), mul_mat, soft_max_ext, cont(transpose), mul_mat, then the norm of each
+// output column. Same arithmetic here: fp32 sums over n_embd, one state a row.
+// the order differs from the chain in one place: the chain normalizes a state once and
+// accumulates normalized values in the dot, this accumulates raw values and scales the
+// finished dot by 1/sqrt(mean(v^2) + eps) - the same value, a different rounding.
+void ggml_compute_forward_depth_mix_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * blocks  = dst->src[0];
+    const ggml_tensor * cur     = dst->src[1];
+    const ggml_tensor * queries = dst->src[2];
+    const ggml_tensor * norm_w  = dst->src[3];
+
+    const float eps_states = ggml_get_op_params_f32(dst, 0);
+    const float eps_out    = ggml_get_op_params_f32(dst, 1);
+    const float scale      = ggml_get_op_params_f32(dst, 2);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t n_embd   = blocks->ne[0];
+    const int64_t n_state  = blocks->ne[1] + 1;   // the block rows, then cur
+    const int64_t n_tok    = blocks->ne[2];
+    const int64_t n_q      = queries->ne[1];
+
+    const size_t nb1  = blocks->nb[1], nb2 = blocks->nb[2];
+    const size_t nbc1 = cur->nb[1];
+    const size_t nbq1 = queries->ne[1] > 1 ? queries->nb[1] : 0;
+    const size_t nbn1 = norm_w ? (norm_w->ne[1] > 1 ? norm_w->nb[1] : 0) : 0;
+
+    std::vector<float> v ((size_t) n_state*n_embd);
+    std::vector<float> ss((size_t) n_state);
+    std::vector<float> dots((size_t) n_q*n_state);
+    std::vector<float> p   ((size_t) n_q*n_state);
+
+    for (int64_t t = ith; t < n_tok; t += nth) {
+        const char * bp = (const char *) blocks->data + t*nb2;
+        const char * cp = (const char *) cur->data    + t*nbc1;
+        for (int64_t s = 0; s < n_state; ++s) {
+            float * row = v.data() + s*n_embd;
+            if (s < n_state - 1) {
+                const float * src = (const float *) (bp + s*nb1);
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    row[i] = src[i];
+                }
+            } else {
+                const float * src = (const float *) cp;
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    row[i] = src[i];
+                }
+            }
+            ggml_float sum = 0.0;
+            for (int64_t i = 0; i < n_embd; ++i) {
+                sum += (ggml_float) (row[i]*row[i]);
+            }
+            ss[s] = (float) sum;
+        }
+
+        for (int64_t q = 0; q < n_q; ++q) {
+            const float * qp = (const float *) ((const char *) queries->data + (n_q > 1 ? q*nbq1 : 0));
+            for (int64_t s = 0; s < n_state; ++s) {
+                const float * row = v.data() + s*n_embd;
+                ggml_float sum = 0.0;
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    sum += (ggml_float) (row[i]*qp[i]);
+                }
+                const float inv = 1.0f/sqrtf(ss[s]/(float) n_embd + eps_states);
+                dots[q*n_state + s] = scale*inv*(float) sum;
+            }
+
+            // softmax over the states
+            float mx = -INFINITY;
+            for (int64_t s = 0; s < n_state; ++s) {
+                mx = MAX(mx, dots[q*n_state + s]);
+            }
+            ggml_float tot = 0.0;
+            for (int64_t s = 0; s < n_state; ++s) {
+                const float e = expf(dots[q*n_state + s] - mx);
+                p[q*n_state + s] = e;
+                tot += (ggml_float) e;
+            }
+            // the weights on the raw rows: p times the state's own 1/rms - the chain mixes the
+            // NORMALIZED states (its rms_norm output feeds the score product and the weighted sum)
+            const float dsum = (float) tot;
+            for (int64_t s = 0; s < n_state; ++s) {
+                const float inv = 1.0f/sqrtf(ss[s]/(float) n_embd + eps_states);
+                p[q*n_state + s] = p[q*n_state + s] * 1.0f/dsum * inv;
+            }
+
+            float * o = (float *) ((char *) dst->data + q*dst->nb[2] + t*dst->nb[1]);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                ggml_float acc = 0.0;
+                for (int64_t s = 0; s < n_state; ++s) {
+                    acc += (ggml_float) (p[q*n_state + s]*v[s*n_embd + i]);
+                }
+                o[i] = (float) acc;
+            }
+
+            if (norm_w) {
+                const float * w = (const float *) ((const char *) norm_w->data + (norm_w->ne[1] > 1 ? q*nbn1 : 0));
+                ggml_float sumsq = 0.0;
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    sumsq += (ggml_float) (o[i]*o[i]);
+                }
+                const float inv = 1.0f/sqrtf((float) sumsq/(float) n_embd + eps_out);
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    o[i] = o[i]*inv*w[i];
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_depth_mix(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_depth_mix_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
