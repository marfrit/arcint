+        ggml_backend_tensor_get(o, out.data(), 0, ggml_nbytes(o));
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+    };
+    const bool red = getenv("GGML_TEST_FA_PORT_NEEDLE_RED") != nullptr;
+    const double JUMP = 100.0;
+    int n_fail = 0, n_run = 0, n_case = 0;
+    auto cases = make_test_cases_eval();
+    for (auto & c : cases) {
+        auto * fa = dynamic_cast<test_flash_attn_ext *>(c.get());
+        if (fa == nullptr || fa->needle == 0) continue;
+        n_case++;
+        auto mk = [&]() {
+            return test_flash_attn_ext(128, 128, fa->nh, fa->nr23, fa->kv, fa->nb, true, true, 0, 0, GGML_PREC_F32, fa->type_K, fa->type_V,
+                                       fa->permute, false, false, 0, true, fa->n_bins, false, 1, fa->wrap, fa->window, fa->n_empty, fa->pad_bias, 1, 0.0f, 1);
+        };
+        test_flash_attn_ext base = mk();
+        std::vector<float> ref;
+        run(base, ref);
+        const std::vector<int64_t> nk = base.needle_keys();
+        printf("  needle %s:%s kv=%lld nb=%lld: %zu needles at keys", ggml_type_name(fa->type_K), ggml_type_name(fa->type_V), (long long) fa->kv, (long long) fa->nb, nk.size());
+        for (int64_t j : nk) printf(" %lld", (long long) j);
+        printf("%s\n", red ? " (RED: 40 keys off the seams)" : "");
+        for (int wave : { 200, 320 }) {
+            const std::vector<int64_t> seams = base.seams_at(wave);
+            for (int model = 0; model < 2; ++model) {
+                test_flash_attn_ext m = mk();
+                for (int64_t sj : seams) {
+                    if (model == 0) m.hide_cells.push_back({ sj, sj + 1 });      // LOSE: the seam's first key gone
+                    else            m.twice_cells.push_back({ sj - 1, sj });     // TWICE: the key before the seam doubled
+                }
+                std::vector<float> out;
+                run(m, out);
+                double num = 0.0, den = 0.0;
+                for (size_t e = 0; e < ref.size(); ++e) { const double d = (double) out[e] - ref[e]; num += d*d; den += (double) ref[e]*ref[e]; }
+                const double nmse = den > 0.0 ? num/den : 0.0, bound = base.max_nmse_err();
+                const bool ok = nmse > JUMP * bound;
+                printf("    wave %d p %zu %s (RED=%d's model, seams", wave, seams.size() + 1, model == 0 ? "LOSE " : "TWICE", model == 0 ? 21 : 22);
+                for (int64_t sj : seams) printf(" %lld", (long long) sj);
+                printf("): nmse %.3g against the bound %.3g = x%.3g (needs x%.0f): %s\n", nmse, bound, bound > 0.0 ? nmse / bound : 0.0, JUMP,
+                       ok ? "decisive" : "FAIL, not decisive");
+                n_fail += !ok; n_run++;
