 // that assigns ring rows in host-store order is one command a layer instead of n_pages.
@@ -26273,6 +26320,8 @@ static void ggml_cl_flash_attn(ggml_backend_t backend, const ggml_tensor * q, co
             clReleaseMemObject(kv_tmp_table);
         }
 
+        // 0130h: the forced race's busy-wait, after the split kernels and before the merge
+        ggml_cl_fa_paged_delay(backend_ctx);
