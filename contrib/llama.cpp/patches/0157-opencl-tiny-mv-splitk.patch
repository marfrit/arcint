+// 0151: split-K variant for one activation column and few output rows. The flat
+// kernel gives one work-group every N_SG_Q8_0 * N_R0_Q8_0 = 8 output rows, so
+// out=24 is 3 work-groups; here one subgroup reduces one (row, K slice) into
+// partial[slice * n_out + row] and kernel_sum_slices_f32 (in
+// mul_mm_f32_f32_l4_lm.cl) sums the slices in a fixed order. Same per-slice
+// operand order as the flat kernel; only the slice grouping differs.
+#ifdef INTEL_GPU
+REQD_SUBGROUP_SIZE_16
+#elif defined(ADRENO_GPU)
+REQD_SUBGROUP_SIZE_64
+#endif
+kernel void kernel_mul_mv_q8_0_f32_splitk(
+    global char * src0_q,
+    global half * src0_d,
+    global char * src1,
+    ulong         offset1,
+    global char * dst,
+    ulong         offsetd,
+    int           ne00,
+    int           ne01,
+    int           nb_row,     // q8_0 blocks a weight row
+    int           nblocks,    // blocks a slice
+    int           n_out)      // ne01 * ne11
+{
+    src1 = (global char*)((global char*)src1 + offset1);
+    dst  = (global char*)((global char*)dst  + offsetd);
+
+    const int out   = get_global_id(2);
+    const int slice = get_global_id(1);
+    const int m = out % ne01;
+    const int nbrow = m * nb_row;
+    const int b0 = slice * nblocks;
+    const int b1 = b0 + nblocks;
+
+    global float * y = (global float *) src1;   // one activation column
+
+    const short ix = get_sub_group_local_id()/4;
+    const short il = get_sub_group_local_id()%4;
+
+    float sumf = 0.0f;
+
+    for (int ib = b0 + ix; ib < b1; ib += 4) {
+        global float * ybp = y + (ulong)ib * QK8_0 + il * NB_Q8_0;
+        float8 yl = vload8(0, ybp);
+
+        global char * qs = src0_q + (ulong)(nbrow + ib) * QK8_0 + il * NB_Q8_0;
+        float8 qv = convert_float8(vload8(0, qs));
+
+        float sumq = 0.f;
+        sumq += qv.s0*yl.s0;
+        sumq += qv.s1*yl.s1;
+        sumq += qv.s2*yl.s2;
+        sumq += qv.s3*yl.s3;
+        sumq += qv.s4*yl.s4;
+        sumq += qv.s5*yl.s5;
+        sumq += qv.s6*yl.s6;
+        sumq += qv.s7*yl.s7;
+        sumf += sumq * src0_d[nbrow + ib];
+    }
+
+    sumf = sub_group_reduce_add(sumf);
+
+    if (get_sub_group_local_id() == 0) {
+        ((global float *) dst)[(ulong)slice * (ulong)n_out + (ulong)out] = sumf;
+    }
+}
