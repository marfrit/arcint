+// 0151: split-K variant of kernel_gemv_f32_f32_mc for one activation column and
+// few output rows. The base kernel puts one work-group per output row, so out=3
+// runs three work-groups on a 160-core card; here work-group (slice, out)
+// reduces its K slice into partial[slice * n_out + out], and
+// kernel_sum_slices_f32 sums the slices (a fixed order for a shape). W lanes a
+// group, W*nslices*n_out work-items.
+kernel void kernel_gemv_f32_f32_splitk(
+    global float * src0, ulong offset0,   // weight: row m at m*stride_a (elements)
+    global float * src1, ulong offset1,   // activations: col n at n*stride_b
+    global float * dst,  ulong offsetd,   // partials [nslices * n_out], slice-major
+    int ne00,        // K
+    int ne01,        // M
+    int ne11,        // N
+    int stride_a,    // weight row stride (elements) = K
+    int stride_b,    // activation col stride (elements) = K
+    int n_out,       // ne01 * ne11
+    int nslices,
+    int kslice)      // K of one slice, a multiple of 4
+{
+    src0 = (global float*)((global char*)src0 + offset0);
+    src1 = (global float*)((global char*)src1 + offset1);
+    dst  = (global float*)((global char*)dst  + offsetd);
+
+    const uint W     = get_local_size(0);
+    const uint lane  = get_local_id(0);
+    const uint out   = get_global_id(2);
+    const uint slice = get_global_id(1);
+    const uint m = out % (uint)ne01;
+    const uint n = out / (uint)ne01;
+
+    global float4 * wrow = (global float4*)(src0 + (ulong)m * (uint)stride_a);
+    global float4 * xcol = (global float4*)(src1 + (ulong)n * (uint)stride_b);
+    const uint k4 = (uint)kslice >> 2;
+    const uint k0 = slice * k4;          // in float4 units, as wrow and xcol are float4 pointers
+
+    float acc = 0.0f;
+    for (uint k = lane; k < k4; k += W) {
+        float4 w = wrow[k0 + k];
+        float4 x = xcol[k0 + k];
+        acc += w.s0*x.s0 + w.s1*x.s1 + w.s2*x.s2 + w.s3*x.s3;
+    }
+
+    local float red[64];
+    red[lane] = acc;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (uint s = W >> 1; s > 0; s >>= 1) {
+        if (lane < s) red[lane] += red[lane + s];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lane == 0) dst[(ulong)slice * (uint)n_out + out] = red[0];
+}
