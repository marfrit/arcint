+    backend_ctx->leo_mode = ggml_cl_version_is_leo(dev_ctx->device_version.c_str()) != 0;
+    backend_ctx->dg2      = ggml_opencl_device_is_dg2(device);
+    if (backend_ctx->leo_mode && backend_ctx->dg2) {
