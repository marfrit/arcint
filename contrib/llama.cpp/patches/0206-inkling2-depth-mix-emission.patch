index 0000000..e673c15
--- /dev/null
+++ b/tests/test-depth-mix.cpp
@@ -0,0 +1,244 @@
+// 0206: device-free tests for the depth-mix arm's rule (ggml_depth_mix_refuse /
+// ggml_depth_mix_eligible) and its switch (ggml_depth_mix_switch).
+//
+// The tensors are Inkling 2 Mini's own prefill graph nodes, built with the same
+// ggml constructors the model uses, at the sizes its GGUF carries:
+//   n_embd 2304 (24 physical blocks, attn_res_block_size 6, so the block store
+//   has (24 + 5)/6 + 1 = 5 rows), a 512- and a 2048-token ubatch, k 1..4 block
+//   rows (2..5 states with cur), nq 1 (an SWA layer's attn_res_query,
+//   ffn_res_query, output_res_query) and nq 3 (a full-attention layer's
+//   attn_res_query), cur 2-D, the block rows a view_3d of the store at the
+//   store's own strides.
+//
+// The stride literals are the exported graph's (test-export-graph-ops at c 4096,
+// fa on, ub 512/1024/2048; the graph lines' source tensors): the block store is
+// [2304, 5, tokens] with nb[1] 9216 and nb[2] 5 * 9216 = 46080, the states view
+// keeps them (2..5 rows, a token's slab step 46080, so at fewer rows the slab
+// step exceeds the states' extent), cur is [2304, tokens] with nb[1] 9216, the
+// query parent is [2304, nq] with nb[1] 9216 - all through the same constructors
+// the model calls.
+//
+// The strides are the graph's, not guesses: src/models/inkling2.cpp's
+// res_stack_tensor makes [n_embd, n_slot, n_tokens] F32 and its mix() takes
+// ggml_view_3d(stack, n_embd, n_block, n_tokens, stack->nb[1], stack->nb[2],
+// ...), so a state's row step is 2304 floats and a token's slab step is
+// n_slot * 2304 floats - the slab step is larger than the states' own extent.
+// That is the stride a wrong rule (or a kernel that assumes a contiguous slab)
+// would miss, which is why every refusal below is checked here and why the card
+// cases carry the same shape.
+//
+// The red variants (one bad stride, one wrong type, a decode shape, a width off
+// the lane rule, a query count, a block count, a norm weight that is not the
+// query count) must each be refused by name: an eligible() that says yes to any
+// of them fails this test.
+//
+// Why this file did not catch the dispatch defect it now guards: it tests the
+// rule (shapes, types, strides) and the switch, all device-free; the defect lived
+// in the OpenCL backend's own decision, which additionally read
+// `op->src[i]->extra` - null in supports_op by design - so the op was refused
+// everywhere and the model's node went to the CPU silently, with no DOWNGRADE
+// line. The rule was right and the backend disagreed with it. The guard below
+// reads the supports_op case out of ggml-opencl.cpp and fails when it reads
+// `extra`, or when it has no refusal line: what a device cannot show, text can.
+//
+// No GPU, no OpenCL runtime.
+#include "ggml.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+static int g_bad = 0;
+
+#define CHECK(cond, what) do { if (!(cond)) { std::printf("FAIL: %s\n", what); ++g_bad; } } while (0)
+
+// a refusal: the rule must return exactly this reason (nullptr, i.e. eligible, is a failure)
+static bool refused(const char * why, const char * want) {
+    return why != nullptr && strcmp(why, want) == 0;
+}
+#define CHECK_REFUSED(why, want, what) CHECK(refused(why, want), what)
+
+static constexpr int64_t k_embd  = 2304;   // Inkling 2 Mini's width
+static constexpr int64_t k_nslot = 5;      // the block store's rows: 4 blocks + cur (the exported graph)
+
+struct ctx_hold {
+    ggml_context * ctx = nullptr;
+    ctx_hold() {
+        // only the strides are read here, so the tensors take no storage
+        ggml_init_params p = { (size_t) 16*1024*1024, nullptr, true };
+        ctx = ggml_init(p);
+    }
+    ~ctx_hold() { if (ctx) ggml_free(ctx); }
+};
+
+// the block store, its block-row view, cur and the query rows exactly as the model builds them
+struct real_nodes {
+    ggml_tensor * stack = nullptr;
+    ggml_tensor * blocks = nullptr;   // view_3d at (n_slot - k) rows: k block rows
+    ggml_tensor * cur = nullptr;
+    ggml_tensor * q = nullptr;
+    ggml_tensor * nw = nullptr;
+};
+
+static real_nodes build_real(ggml_context * ctx, int64_t k, int64_t nt, int64_t nq, bool with_nw, int64_t n_embd = k_embd) {
+    real_nodes r;
+    r.stack = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, k_nslot, nt);
+    // mix(): the block rows sit at (n_slot - n_block) with the store's strides
+    const int64_t row = (r.stack->ne[1] - 1) - k;
+    r.blocks = ggml_view_3d(ctx, r.stack, n_embd, k, nt, r.stack->nb[1], r.stack->nb[2], (size_t) row*r.stack->nb[1]);
+    r.cur = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nt);
+    if (nq == 1) {
+        // attn_res_query / ffn_res_query / output_res_query are 1-D [n_embd]
+        r.q = ggml_reshape_2d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd), n_embd, 1);
+    } else {
+        r.q = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nq);
+    }
+    if (with_nw) {
+        r.nw = nq == 1
+            ? ggml_reshape_2d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd), n_embd, 1)
+            : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nq);
+    }
+    return r;
+}
+
+int main(void) {
+    // ---- the graph's own strides, asserted as numbers ----
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 1, true);
+        CHECK(r.stack->ne[0] == k_embd && r.stack->ne[1] == k_nslot && r.stack->ne[2] == 512, "the store is [2304, 5, 512]");
+        CHECK(r.stack->nb[1] == k_embd*sizeof(float), "a state's row step is 2304 floats (9216 bytes)");
+        CHECK(r.stack->nb[2] == k_nslot*k_embd*sizeof(float), "a token's slab step is 5 * 2304 floats (46080 bytes)");
+        CHECK(r.blocks->nb[1] == r.stack->nb[1] && r.blocks->nb[2] == r.stack->nb[2], "the block view keeps the store's strides");
+        CHECK(r.blocks->nb[2] > (uint64_t) (r.blocks->ne[1]*r.blocks->nb[1]), "the slab step exceeds the states' extent");
+        CHECK(r.cur->nb[1] == k_embd*sizeof(float), "cur is [n_embd, n_tokens], rows back to back");
+    }
+
+    // ---- the model's shapes are eligible, at both ubatch sizes: k 1..4 blocks ----
+    for (int64_t nt : {512, 2048}) {
+        for (int64_t k : {1, 2, 3, 4}) {
+            // the states (k + 1 rows) fit the store's 5 rows and its 46080-byte slab step
+            CHECK(k + 1 <= k_nslot, "the store holds the states this call reads");
+            ctx_hold h;
+            for (int64_t nq : {1, 3}) {
+                real_nodes r = build_real(h.ctx, k, nt, nq, nq == 1);   // the nq 1 calls fold the norm
+                CHECK(r.blocks->nb[2] == 46080, "a token's slab step is 46080 bytes, the store's");
+                CHECK(r.blocks->nb[2] >= (uint64_t) (r.blocks->ne[1]*r.blocks->nb[1]) || r.blocks->ne[1] == 0,
+                      "the slab step covers the block rows");
+                const char * why = ggml_depth_mix_refuse(r.blocks, r.cur, r.q, r.nw);
+                if (why != nullptr) {
+                    std::printf("FAIL: k=%d nt=%d nq=%d refused with %s\n", (int) k, (int) nt, (int) nq, why);
+                    ++g_bad;
+                } else {
+                    CHECK(ggml_depth_mix_eligible(r.blocks, r.cur, r.q, r.nw), "eligible agrees with refuse");
+                }
+            }
+        }
+    }
+
+    // ---- the op's dst: [n_embd, n_tokens, nq], a query column's token block contiguous ----
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 3, false);
+        ggml_tensor * dst = ggml_depth_mix(h.ctx, r.blocks, r.cur, r.q, r.nw, 1e-6f, 1e-5f, 1.0f/sqrtf(2304.0f));
+        CHECK(dst->ne[0] == k_embd && dst->ne[1] == 512 && dst->ne[2] == 3, "dst is [2304, 512, 3]");
+        CHECK(dst->nb[1] == k_embd*sizeof(float), "a token's rows are back to back");
+        CHECK(dst->nb[2] == k_embd*512*sizeof(float), "a column's whole token block is contiguous");
+        CHECK(dst->nb[3] == dst->nb[2]*dst->ne[2], "the columns follow one another");
+        // the model's per-column view is contiguous: view_2d(dst, n_embd, n_tokens, nb[1], col*nb[2])
+        ggml_tensor * col = ggml_view_2d(h.ctx, dst, k_embd, 512, dst->nb[1], 2*(size_t) dst->nb[2]);
+        CHECK(ggml_is_contiguous(col), "a column view needs no copy");
+    }
+
+    // ---- the red variants: each must be refused, with its own reason ----
+    {
+        // a slab step shorter than the states' extent: two tokens' states overlap
+        ctx_hold h;
+        ggml_tensor * st = ggml_new_tensor_3d(h.ctx, GGML_TYPE_F32, k_embd, k_nslot, 512);
+        ggml_tensor * blk = ggml_view_3d(h.ctx, st, k_embd, 4, 512, st->nb[1], 2*st->nb[1], 2*st->nb[1]);
+        ggml_tensor * cur = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, k_embd, 512);
+        ggml_tensor * q = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, k_embd, 1);
+        const char * why = ggml_depth_mix_refuse(blk, cur, q, nullptr);
+        CHECK_REFUSED(why, "blocks-slab", "an overlapping slab step is refused as blocks-slab");
+    }
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 1, false);
+        ggml_tensor * cur16 = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F16, k_embd, 512);
+        CHECK_REFUSED(ggml_depth_mix_refuse(r.blocks, cur16, r.q, r.nw), "not-f32", "an f16 cur is refused as not-f32");
+    }
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 1, 1, false);   // a decode step
+        CHECK_REFUSED(ggml_depth_mix_refuse(r.blocks, r.cur, r.q, r.nw), "decode", "T = 1 is refused as decode");
+    }
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 1, false, 1000);   // not a multiple of the lane width
+        CHECK_REFUSED(ggml_depth_mix_refuse(r.blocks, r.cur, r.q, r.nw), "d-lanes", "a width off 256 is refused as d-lanes");
+    }
+    {
+        ctx_hold h;
+        ggml_tensor * st = ggml_new_tensor_3d(h.ctx, GGML_TYPE_F32, 256*10, k_nslot, 512);   // 10 floats a lane
+        ggml_tensor * blk = ggml_view_3d(h.ctx, st, 256*10, 4, 512, st->nb[1], st->nb[2], 2*st->nb[1]);
+        ggml_tensor * cur = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, 256*10, 512);
+        ggml_tensor * q = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, 256*10, 1);
+        CHECK_REFUSED(ggml_depth_mix_refuse(blk, cur, q, nullptr), "d-lanes", "10 floats a lane is refused as d-lanes");
+    }
+    {
+        ctx_hold h;
+        // more block rows than the arm's bound: its own store of 7 rows so the view fits
+        ggml_tensor * st = ggml_new_tensor_3d(h.ctx, GGML_TYPE_F32, k_embd, 7, 512);
+        ggml_tensor * blk = ggml_view_3d(h.ctx, st, k_embd, 7, 512, st->nb[1], st->nb[2], 0);
+        ggml_tensor * cur = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, k_embd, 512);
+        ggml_tensor * q = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, k_embd, 1);
+        CHECK_REFUSED(ggml_depth_mix_refuse(blk, cur, q, nullptr), "k", "k = 7 is refused as k");
+    }
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 5, false);   // more columns than the arm's register bound
+        CHECK_REFUSED(ggml_depth_mix_refuse(r.blocks, r.cur, r.q, r.nw), "q-shape", "nq = 5 is refused as q-shape");
+    }
+    {
+        ctx_hold h;
+        real_nodes r = build_real(h.ctx, 4, 512, 1, false);
+        ggml_tensor * nw3 = ggml_new_tensor_2d(h.ctx, GGML_TYPE_F32, k_embd, 3);   // a qkv stack for one column
+        CHECK(strcmp(ggml_depth_mix_refuse(r.blocks, r.cur, r.q, nw3), "nw-shape") == 0, "a norm weight of 3 columns for nq 1 is refused as nw-shape");
+    }
+
+    // ---- the switch: unset, "0" and "off" are off; everything else is on ----
+    CHECK(!ggml_depth_mix_switch(nullptr), "unset is off");
+    CHECK(!ggml_depth_mix_switch("0"), "0 is off");
+    CHECK(!ggml_depth_mix_switch("off"), "off is off");
+    CHECK(ggml_depth_mix_switch("1"), "1 is on");
+    CHECK(ggml_depth_mix_switch("on"), "on is on");
+
+    // ---- the dispatch's decision is the rule's alone: no device storage in supports_op ----
+#ifdef DEPTH_MIX_OPENCL_SRC
+    {
+        std::ifstream f(DEPTH_MIX_OPENCL_SRC);
+        std::string src((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        const size_t a = src.find("case GGML_OP_DEPTH_MIX:");
+        const size_t b = src.find("case GGML_OP_", a + 22);
+        CHECK(a != std::string::npos && b != std::string::npos, "the supports_op case GGML_OP_DEPTH_MIX is found in ggml-opencl.cpp");
+        if (a != std::string::npos && b != std::string::npos) {
+            const std::string seg = src.substr(a, b - a);
+            CHECK(seg.find("->extra") == std::string::npos, "supports_op does not read a tensor's device storage");
+            CHECK(seg.find("ggml_depth_mix_refuse(") != std::string::npos, "supports_op decides through the rule");
+            CHECK(seg.find("ggml_cl_downgrade(") != std::string::npos, "a refused shape leaves a DOWNGRADE line");
+        }
+    }
+#endif
+
+    if (g_bad != 0) {
+        std::printf("%d of the depth-mix rule's checks failed\n", g_bad);
+        return 1;
+    }
+    std::printf("depth-mix rule: all OK device-free\n");
+    return 0;
+}
