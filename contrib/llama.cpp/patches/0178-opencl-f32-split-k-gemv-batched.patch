+    cl_ulong zero = 0;
+    const int stride_a = (int) (src0->nb[1] / sizeof(float)), stride_b = (int) (src1->nb[1] / sizeof(float));
+    const int stride_as = (int) (src0->nb[2] / sizeof(float)), stride_bs = (int) (src1->nb[2] / sizeof(float));
+    // the furthest byte a (token, column, row) can reach on either side, plus the partials
+    {
+        const size_t upto0 = offset0 + (size_t) (ne00 - 1) * sizeof(float) + (size_t) (ne01 - 1) * stride_a * sizeof(float) + (size_t) (ntok - 1) * stride_as * sizeof(float) + sizeof(float);
