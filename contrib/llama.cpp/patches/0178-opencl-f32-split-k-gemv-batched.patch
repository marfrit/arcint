+// a batch of the split-K GEMV above: the model's depth mix first product, src0's rows
+// (token, row) and src1's columns (token, column), a token's slab the tensor's own step.
+// The tile is gone: one work-group per (token, column, row) reduces its K slice, W lanes a
+// group, the slices summed by kernel_sum_slices_f32. W*nslices*n_out work-items.
+kernel void kernel_gemv_f32_f32_splitk_batch(
+    global float * src0, ulong offset0,   // rows: token at token*stride_as, row m at m*stride_a
+    global float * src1, ulong offset1,   // columns: token at token*stride_bs, col n at n*stride_b
+    global float * dst,  ulong offsetd,   // partials [nslices * n_out], slice-major
+    int ne00,        // K
+    int ne01,        // M
+    int ne11,        // N a token
+    int stride_a,    // a row's step (elements) = K
+    int stride_b,    // a column's step (elements) = K
+    int stride_as,   // a token's step of src0 (elements)
+    int stride_bs,   // a token's step of src1 (elements)
+    int n_out,       // ne01 * ne11 * tokens: the partials' extent
+    int nslices,
+    int kslice)      // K of one slice, a multiple of 4
+{
+    src0 = (global float*)((global char*)src0 + offset0);
+    src1 = (global float*)((global char*)src1 + offset1);
+    dst  = (global float*)((global char*)dst  + offsetd);
+
+    const uint W     = get_local_size(0);
+    const uint lane  = get_local_id(0);
+    const uint out   = get_global_id(2);   // (token, column, row): token*ne11*ne01 + n*ne01 + m
+    const uint slice = get_global_id(1);
+    if (out >= (uint)n_out) return;
+    const uint m  = out % (uint)ne01;
+    const uint nc = out / (uint)ne01;
+    const uint bt = nc / (uint)ne11;   // the token: a slab, not a float a row
+    const uint n  = nc % (uint)ne11;
+
+    global float4 * wrow = (global float4*)(src0 + (ulong)bt * (uint)stride_as + (ulong)m * (uint)stride_a);
+    global float4 * xcol = (global float4*)(src1 + (ulong)bt * (uint)stride_bs + (ulong)n * (uint)stride_b);
+    const uint k4 = (uint)kslice >> 2;
+    const uint k0 = slice * k4;          // in float4 units, as wrow and xcol are float4 pointers
+
+    float acc = 0.0f;
+    for (uint k = lane; k < k4; k += W) {
+        float4 w = wrow[k0 + k];
+        float4 x = xcol[k0 + k];
+        acc += w.s0*x.s0 + w.s1*x.s1 + w.s2*x.s2 + w.s3*x.s3;
+    }
+
+    local float red[64];
+    red[lane] = acc;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (uint s = W >> 1; s > 0; s >>= 1) {
+        if (lane < s) red[lane] += red[lane + s];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lane == 0) dst[(ulong)slice * (uint)n_out + out] = red[0];
+}
