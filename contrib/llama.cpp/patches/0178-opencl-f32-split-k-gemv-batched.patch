+        const size_t uptod = offsetd + (size_t) n_out * sizeof(float);
+        ggml_cl_bounds("F32 small-M", "src0", extra0->data_device, upto0);
+        ggml_cl_bounds("F32 small-M", "src1", extra1->data_device, upto1);
+        ggml_cl_bounds("F32 small-M", "dst",  extrad->data_device, uptod);
+        ggml_cl_bounds("F32 small-M", "partials", backend_ctx->prealloc_f32_splitk.buffer, (size_t) nslices * n_out * sizeof(float));
+    }
+    CL_CHECK(clSetKernelArg(ks,  0, sizeof(cl_mem),   &extra0->data_device));
+    CL_CHECK(clSetKernelArg(ks,  1, sizeof(cl_ulong), &offset0));
+    CL_CHECK(clSetKernelArg(ks,  2, sizeof(cl_mem),   &extra1->data_device));
+    CL_CHECK(clSetKernelArg(ks,  3, sizeof(cl_ulong), &offset1));
+    CL_CHECK(clSetKernelArg(ks,  4, sizeof(cl_mem),   &backend_ctx->prealloc_f32_splitk.buffer));
+    CL_CHECK(clSetKernelArg(ks,  5, sizeof(cl_ulong), &zero));
+    CL_CHECK(clSetKernelArg(ks,  6, sizeof(int),      &ne00));
+    CL_CHECK(clSetKernelArg(ks,  7, sizeof(int),      &ne01));
+    CL_CHECK(clSetKernelArg(ks,  8, sizeof(int),      &ne11));
+    CL_CHECK(clSetKernelArg(ks,  9, sizeof(int),      &stride_a));
+    CL_CHECK(clSetKernelArg(ks, 10, sizeof(int),      &stride_b));
+    CL_CHECK(clSetKernelArg(ks, 11, sizeof(int),      &stride_as));
+    CL_CHECK(clSetKernelArg(ks, 12, sizeof(int),      &stride_bs));
+    CL_CHECK(clSetKernelArg(ks, 13, sizeof(int),      &n_out));
+    CL_CHECK(clSetKernelArg(ks, 14, sizeof(int),      &nslices));
+    CL_CHECK(clSetKernelArg(ks, 15, sizeof(int),      &kslice));
+    const int wl = kslice / 4 >= 32 ? 32 : 16;
+    size_t gws[3] = { (size_t)wl, (size_t)nslices, (size_t)n_out };
+    size_t lws[3] = { (size_t)wl, 1, 1 };
+    backend_ctx->enqueue_ndrange_kernel(ks, 3, gws, lws, dst);
+
+    cl_kernel kr = backend_ctx->kernel_sum_slices_f32;
+    CL_CHECK(clSetKernelArg(kr, 0, sizeof(cl_mem),   &backend_ctx->prealloc_f32_splitk.buffer));
+    CL_CHECK(clSetKernelArg(kr, 1, sizeof(cl_mem),   &extrad->data_device));
+    CL_CHECK(clSetKernelArg(kr, 2, sizeof(cl_ulong), &offsetd));
+    CL_CHECK(clSetKernelArg(kr, 3, sizeof(int),      &n_out));
+    CL_CHECK(clSetKernelArg(kr, 4, sizeof(int),      &nslices));
