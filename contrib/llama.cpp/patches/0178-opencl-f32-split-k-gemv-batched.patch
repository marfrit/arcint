+// tensor repeated over the tokens. K is the embedding width, M the slots a token, N the query
+// columns, the tokens a batch on both sides. The tiled GEMM ran it as a 64x64 tile per 64
+// columns (2.0 ms a call); the split-K GEMV's own layout is a work-group a (token, column, row).
+struct test_mul_mat_f32_prompt_m : public test_case {
+    const int64_t k;   // the embedding width, the product's K
+    const int64_t m;   // the slots a token (a block count + 1)
+    const int64_t n;   // the query columns
+    const int64_t nb;  // tokens
+    const int64_t n_slot;
+
+    std::string vars() override { return VARS_TO_STR5(k, m, n, nb, n_slot); }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return 2 * k * m * n * nb;
+    }
+
+    test_mul_mat_f32_prompt_m(int64_t k = 2304, int64_t m = 2, int64_t n = 4, int64_t nb = 512, int64_t n_slot = 8)
+        : k(k), m(m), n(n), nb(nb), n_slot(n_slot) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * stack = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, n_slot, nb);
+        ggml_set_name(stack, "stack");
+        ggml_tensor * states = ggml_view_3d(ctx, stack, k, m, nb, stack->nb[1], stack->nb[2], 0);
+        ggml_set_name(states, "states");
+        ggml_tensor * norm = ggml_rms_norm(ctx, states, 1e-5f);
+        ggml_set_name(norm, "norm");
+        ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_set_name(w, "w");
+        ggml_tensor * queries = ggml_repeat(ctx, w, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, n, nb));
+        ggml_set_name(queries, "queries");
+        ggml_tensor * out = ggml_mul_mat(ctx, norm, queries);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            init_tensor_uniform(t);
+        }
+    }
+};
