+    static const char * env = getenv("GGML_OPENCL_F32_SMALL_M");
+    static const bool   on  = env != nullptr && atoi(env) != 0;
+    const int ne00 = (int) src0->ne[0], ne01 = (int) src0->ne[1], ne11 = (int) src1->ne[1];
+    const int ntok = (int) (src0->ne[2] * src0->ne[3]);
+    if (!on || backend_ctx->gpu_family != INTEL || backend_ctx->kernel_gemv_f32_f32_splitk_batch == nullptr ||
+        backend_ctx->kernel_sum_slices_f32 == nullptr ||
+        src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        src0->ne[0] != src1->ne[0] || ne00 % 16 != 0 || ne01 < 1 || ne01 > 8 || ne11 < 1 || ne11 > 8 ||
+        src0->ne[1] != dst->ne[0] || dst->ne[1] != src1->ne[1] ||
+        src0->ne[2] != src1->ne[2] || dst->ne[2] != src1->ne[2] || ntok < 16 ||
+        src0->ne[3] != 1 || src1->ne[3] != 1 || dst->ne[3] != 1 ||
