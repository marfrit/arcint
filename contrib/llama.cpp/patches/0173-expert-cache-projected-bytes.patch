+size_t llama_expert_cache::project_device_bytes(size_t budget) const {
+    if (layers.empty() || buft_slots_ == nullptr) return n_bytes;
+    // 1) the slot plan: the same walk init runs, over the stored ranking
+    std::vector<std::vector<int>> chosen(layers.size());
+    std::vector<std::vector<char>> taken(layers.size());
+    for (size_t i = 0; i < layers.size(); ++i) taken[i].assign((size_t) layers[i].n_expert, 0);
+    size_t used = 0;
+    for (const auto & L : layers) used += L.nb2[0] + L.nb2[1] + L.nb2[2];
+    std::vector<int> layer_of(model_->layers.size(), -1);
+    for (int i = 0; i < (int) layers.size(); ++i) layer_of[layers[i].il] = i;
+    const int n_expert = layers[0].n_expert;
+    for (const auto & [il, e] : ranked_) {
+        if (il < 0 || il >= (int) layer_of.size() || layer_of[il] < 0 || e < 0 || e >= n_expert) continue;
+        const int i = layer_of[il];
+        const auto & L = layers[(size_t) i];
+        const size_t b = L.nb2[0] + L.nb2[1] + L.nb2[2];
+        if (used + b > budget) break;
+        if (taken[i][(size_t) e] || (int) chosen[i].size() + 1 >= L.n_expert) continue;
+        taken[i][(size_t) e] = 1;
+        chosen[i].push_back(e);
+        used += b;
+    }
+    std::vector<int> n_slots(layers.size());
+    for (size_t i = 0; i < layers.size(); ++i) {
+        if (chosen[i].empty()) chosen[i].push_back(0);
+        n_slots[i] = (int) chosen[i].size();
+    }
+    // 2) the lend set at this budget: candidates whose slot bytes fit the ask, in order
+    std::vector<llama_loan_book::LendCandidate> cand(layers.size());
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & L = layers[i];
+        cand[i].lendable = L.candidate;
+        cand[i].bytes = L.candidate ? (int64_t) n_slots[i] * (int64_t) (L.nb2[0] + L.nb2[1] + L.nb2[2]) : 0;
+    }
+    const auto pick = llama_loan_book::choose_lend_layers(cand, lend_bytes_);
+    std::vector<char> lent(layers.size(), 0);
+    for (int i : pick.chosen) lent[(size_t) i] = 1;
+    // 3) the slot buffer context: non-candidate slots, Q8_0 banks, the tables; size only
+    auto buft_size = [&](ggml_context * gc) { return ggml_backend_alloc_ctx_tensors_from_buft_size(gc, buft_slots_); };
+    const int n_rows = [&] { int r = 0; for (const auto & L : layers) r += L.n_tab; return r; }();
+    ggml_init_params ip{ (size_t) (layers.size() * 6 + 8) * ggml_tensor_overhead(), nullptr, true };
+    ggml_context * main_ctx = ggml_init(ip);
+    ggml_new_tensor_3d(main_ctx, GGML_TYPE_I32, 1, n_expert, n_rows);   // tables
+    ggml_new_tensor_2d(main_ctx, GGML_TYPE_I32, 1, n_expert);           // ids
+    ggml_context * tail_ctx = ggml_init(ip);
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & L = layers[i];
+        const ggml_context * sc = L.candidate ? tail_ctx : main_ctx;
+        const int n_bank = L.n_expert - n_slots[i];
+        const int n_spare = std::min(n_spare_base, std::max(0, 512 - (n_bank + 1)));
+        for (int k = 0; k < 3; ++k) {
+            if (!L.candidate)      ggml_new_tensor_3d(const_cast<ggml_context *>(sc), L.src[k]->type, L.src[k]->ne[0], L.src[k]->ne[1], n_slots[i] + 1);
+            if (L.src[k]->type == GGML_TYPE_Q8_0)
+                ggml_new_tensor_3d(main_ctx, L.src[k]->type, L.src[k]->ne[0], L.src[k]->ne[1], n_bank + 1 + n_spare);
+        }
+    }
+    const size_t slots_size = buft_size(main_ctx);
+    // 4) the lend tail: a buffer over the picked layers' slot tensors
+    ggml_context * lend_ctx = ggml_init(ip);
+    for (int i : pick.chosen) {
+        const auto & L = layers[(size_t) i];
+        for (int k = 0; k < 3; ++k)
+            ggml_new_tensor_3d(lend_ctx, L.src[k]->type, L.src[k]->ne[0], L.src[k]->ne[1], n_slots[(size_t) i] + 1);
+    }
+    const size_t lend_size = pick.chosen.empty() ? 0 : buft_size(lend_ctx);
+    // 5) candidate layers outside the lend: one small buffer a layer
+    size_t spare_size = 0;
+    for (size_t i = 0; i < layers.size(); ++i) {
+        if (!layers[i].candidate || lent[i]) continue;
+        ggml_context * gc = ggml_init(ip);
+        const auto & L = layers[i];
+        for (int k = 0; k < 3; ++k)
+            ggml_new_tensor_3d(gc, L.src[k]->type, L.src[k]->ne[0], L.src[k]->ne[1], n_slots[i] + 1);
+        spare_size += buft_size(gc);
+        ggml_free(gc);
+    }
+    // 6) the gather mirror at load: the largest bank/lend tensor's rows, as init computes it
+    size_t q = 0, d = 0;
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & L = layers[i];
+        const int n_bank = L.n_expert - n_slots[i];
+        const int n_spare = std::min(n_spare_base, std::max(0, 512 - (n_bank + 1)));
+        for (int k = 0; k < 3; ++k) {
+            const size_t nb = L.src[k]->type == GGML_TYPE_Q8_0 ? 0 : (size_t) (n_bank + 1 + n_spare);
+            const size_t nl = L.candidate ? (size_t) n_slots[i] : 0;
+            for (size_t n : { nb, nl }) {
+                if (n == 0) continue;
+                if (L.src[k]->type == GGML_TYPE_IQ4_NL) {
+                    const size_t bps = (size_t) L.src[k]->ne[0] * L.src[k]->ne[1] / 32;
+                    q = std::max(q, n * bps * 16);
+                    d = std::max(d, n * bps * 2);
+                } else {
+                    q = std::max(q, n * L.nb2[k]);
+                }
+            }
+        }
+    }
+    const size_t total = slots_size + lend_size + spare_size + q + d;
+    ggml_free(lend_ctx); ggml_free(tail_ctx); ggml_free(main_ctx);
+    return total;
+}
