diff --git a/ggml/src/ggml-opencl/kernels/mul_mm_kq_f16.cl b/ggml/src/ggml-opencl/kernels/mul_mm_kq_f16.cl
index a796787..ffa87e7 100644
--- a/ggml/src/ggml-opencl/kernels/mul_mm_kq_f16.cl
+++ b/ggml/src/ggml-opencl/kernels/mul_mm_kq_f16.cl
@@ -500,3 +500,366 @@ kernel void kernel_mul_mm_id_iq4_nl_f16(global const uchar * q, ulong offq, glob
