+    uint p0, uint p1, uint p2,
+    uint d0, uint d1, uint d2,
+    uint nb00, uint nb01, uint nb02, uint nb03,
+    uint nb10, uint nb11, uint nb12, uint nb13,
+    uint nb1, uint nb2, uint nb3,
+    uint red
+) {
+    global half* knl_data = (global half*) ((global char*)p_knl + off_knl);
+    global float* src_data = (global float*) ((global char*)p_src + off_src);
+    global float* dst_data = (global float*) ((global char*)p_dst + off_dst);
+
+    const uint K = OC;
+    const uint KD_KH_KW = KD * KH * KW;
+    const uint CRS = IC * KD_KH_KW;
+    const uint OH_OW = OH * OW;
+    const uint NPQ = N * OH_OW * OD;
+
+    const uint lid_k = get_local_id(0);
+    const uint lid_npq = get_local_id(1);
+    const uint tid = lid_npq * WG_K + lid_k;
+
+    const uint B_idx_K = get_group_id(0);
+    const uint B_idx_NPQ = get_group_id(1);
+
+    const uint offset_k = B_idx_K * BS_K;
+    const uint offset_npq = B_idx_NPQ * BS_NPQ;
+
+    local half* Ash = (local half*)shared;
+    local float4* Bsh = (local float4*) &Ash[BS_K * BS_CRS];
+
+    T_ACCUM regC[TS_K][TS_NPQ_VEC];
+    for (int i = 0; i < TS_K; ++i) {
+        for (int j = 0; j < TS_NPQ_VEC; ++j) {
+            regC[i][j] = (T_ACCUM)(0.0f);
+        }
+    }
+
+    const uint NB_CRS = splitWork(CRS, BS_CRS);
+
+    for (uint B_idx_CRS = 0; B_idx_CRS < NB_CRS; ++B_idx_CRS) {
+        const uint offset_crs = B_idx_CRS * BS_CRS;
+
+        for (int i = tid; i < BS_K * BS_CRS; i += (WG_K * WG_NPQ)) {
+            const uint k_l = i / BS_CRS;
+            const uint crs_l = i % BS_CRS;
+            const uint k_g = offset_k + k_l;
+            const uint crs_g = offset_crs + crs_l;
+
+            if (k_g < K && crs_g < CRS) {
+                const uint Cin_idx = crs_g / KD_KH_KW;
+                const uint KD_idx = (crs_g - Cin_idx*KD_KH_KW) / (KH*KW);
+                const uint KH_idx = (crs_g - Cin_idx*KD_KH_KW - KD_idx*KH*KW) / KW;
+                const uint KW_idx = crs_g - Cin_idx*KD_KH_KW - KD_idx*KH*KW - KH_idx*KW;
+                const uint knl_idx = KW_idx*nb00 + KH_idx*nb01 + KD_idx*nb02 + (k_g*IC + Cin_idx)*nb03;
+                // red: the weights are ignored, every output becomes 0 -- a gross
+                // tripwire that the kernel did not run (GGML_OPENCL_CONV3D_RED=1).
+                Ash[k_l * BS_CRS + crs_l] = red ? (half)0.0f : knl_data[knl_idx];
+            } else {
+                Ash[k_l * BS_CRS + crs_l] = (half)0.0f;
+            }
+        }
+
+        for (int i = tid; i < BS_CRS * BS_NPQ_VEC; i += (WG_K * WG_NPQ)) {
+            const uint crs_l = i / BS_NPQ_VEC;
+            const uint npq_l_vec = i % BS_NPQ_VEC;
+            const uint crs_g = offset_crs + crs_l;
+
+            float4 val = (float4)(0.0f);
+            if (crs_g < CRS) {
+                const uint Cin_idx = crs_g / KD_KH_KW;
+                const uint KD_idx = (crs_g - Cin_idx*KD_KH_KW) / (KH*KW);
+                const uint KH_idx = (crs_g - Cin_idx*KD_KH_KW - KD_idx*KH*KW) / KW;
+                const uint KW_idx = crs_g - Cin_idx*KD_KH_KW - KD_idx*KH*KW - KH_idx*KW;
+                for (int v = 0; v < VEC_SIZE; ++v) {
+                    const uint npq_g = offset_npq + npq_l_vec * VEC_SIZE + v;
+                    if (npq_g < NPQ) {
+                        const uint N_idx = npq_g / (OD * OH_OW);
+                        const uint sp_idx = npq_g % (OD * OH_OW);
+                        const uint OD_idx = sp_idx / OH_OW;
+                        const uint pq_idx = sp_idx % OH_OW;
+                        const uint OH_idx = pq_idx / OW;
+                        const uint OW_idx = pq_idx % OW;
+                        const int D_idx = (int)(OD_idx * s2 + KD_idx * d2 - p2);
+                        const int H_idx = (int)(OH_idx * s1 + KH_idx * d1 - p1);
+                        const int W_idx = (int)(OW_idx * s0 + KW_idx * d0 - p0);
+
+                        if (D_idx >= 0 && D_idx < ID && H_idx >= 0 && H_idx < IH && W_idx >= 0 && W_idx < IW) {
+                            const uint src_idx = W_idx * nb10 + H_idx * nb11 + D_idx * nb12 + (N_idx * IC + Cin_idx) * nb13;
+                            ((float*)&val)[v] = src_data[src_idx];
+                        }
+                    }
+                }
+            }
+            Bsh[crs_l * BS_NPQ_VEC + npq_l_vec] = val;
+        }
+
+        barrier(CLK_LOCAL_MEM_FENCE);
+
+        #pragma unroll
+        for (uint crs_l = 0; crs_l < BS_CRS; ++crs_l) {
+            half regA[TS_K];
+            for (uint k_l_reg = 0; k_l_reg < TS_K; ++k_l_reg) {
+                regA[k_l_reg] = Ash[(lid_k * TS_K + k_l_reg) * BS_CRS + crs_l];
+            }
+
+            for (uint npq_l_vec_reg = 0; npq_l_vec_reg < TS_NPQ_VEC; ++npq_l_vec_reg) {
+                float4 regB = Bsh[crs_l * BS_NPQ_VEC + lid_npq * TS_NPQ_VEC + npq_l_vec_reg];
+                for (uint k_l_reg = 0; k_l_reg < TS_K; ++k_l_reg) {
+                    regC[k_l_reg][npq_l_vec_reg] = mad(convert_float(regA[k_l_reg]), regB, regC[k_l_reg][npq_l_vec_reg]);
+                }
+            }
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+
+    for (uint k_l_reg = 0; k_l_reg < TS_K; ++k_l_reg) {
+        const uint k_g = offset_k + lid_k * TS_K + k_l_reg;
+        if (k_g >= K) continue;
+
+        for (uint npq_l_vec_reg = 0; npq_l_vec_reg < TS_NPQ_VEC; ++npq_l_vec_reg) {
+            const uint npq_g_base = offset_npq + (lid_npq * TS_NPQ_VEC + npq_l_vec_reg) * VEC_SIZE;
+
+            const uint N_idx = npq_g_base / (OD * OH_OW);
+            const uint sp_idx = npq_g_base % (OD * OH_OW);
+            const uint OD_idx = sp_idx / OH_OW;
+            const uint pq_idx = sp_idx % OH_OW;
+            const uint OH_idx = pq_idx / OW;
+            const uint OW_idx = pq_idx % OW;
+
+            if (nb1 == OW && OW_idx + VEC_SIZE <= OW && npq_g_base + VEC_SIZE <= NPQ) {
+                const uint dst_idx = OW_idx + OH_idx*nb1 + OD_idx*nb2 + (N_idx*OC + k_g)*nb3;
+                vstore4(regC[k_l_reg][npq_l_vec_reg], 0, &dst_data[dst_idx]);
+            } else {
+                T_ACCUM res = regC[k_l_reg][npq_l_vec_reg];
+                for (int v = 0; v < VEC_SIZE; ++v) {
+                    const uint npq_g = npq_g_base + v;
+                    if (npq_g < NPQ) {
+                        const uint N_idx_s = npq_g / (OD * OH_OW);
+                        const uint sp_idx_s = npq_g % (OD * OH_OW);
+                        const uint OD_idx_s = sp_idx_s / OH_OW;
+                        const uint pq_idx_s = sp_idx_s % OH_OW;
+                        const uint OH_idx_s = pq_idx_s / OW;
+                        const uint OW_idx_s = pq_idx_s % OW;
+                        const uint dst_idx_s = OW_idx_s + OH_idx_s*nb1 + OD_idx_s*nb2 + (N_idx_s*OC + k_g)*nb3;
+                        dst_data[dst_idx_s] = ((float*)&res)[v];
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-opencl/kernels/fwht_f32.cl b/ggml/src/ggml-opencl/kernels/fwht_f32.cl
new file mode 100644
index 0000000..8b27bc7
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/fwht_f32.cl
@@ -0,0 +1,79 @@
+#ifdef cl_intel_subgroups
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#define FWHT_SHUFFLE_XOR(v, m) intel_sub_group_shuffle_xor((v), (m))
+#else
+#pragma OPENCL EXTENSION cl_khr_subgroups : enable
+#pragma OPENCL EXTENSION cl_khr_subgroup_shuffle : enable
+#define FWHT_SHUFFLE_XOR(v, m) sub_group_shuffle_xor((v), (m))
+#endif
+
+#ifdef cl_intel_required_subgroup_size
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+#define REQD_SUBGROUP_SIZE_16 __attribute__((intel_reqd_sub_group_size(16)))
+#else
+// a compile fallback only: the indexing below is right at a 16-wide subgroup
+// alone, and the host loads these kernels only where it can require one
+#define REQD_SUBGROUP_SIZE_16
+#endif
+
+// The fast Walsh-Hadamard transform for MUL_MAT nodes that carry
+// GGML_HINT_SRC0_IS_HADAMARD (the KV cache's attention rotations): dst row =
+// H_n x src1 row with H_n the orthonormal Sylvester Hadamard matrix, so src0
+// is never read. The reference is ggml-cuda/fwht.cu (one row per warp,
+// shuffle stages inside the warp, register stages above it); here one row per
+// 16-wide subgroup: element e of a row sits in lane e % 16, register e / 16.
+// The stages commute, so the order of the butterflies is free.
+#define FWHT_SG 16
+
+#define FWHT_KERNEL(N)                                                              \
+REQD_SUBGROUP_SIZE_16                                                               \
+kernel void kernel_fwht_f32_##N(                                                    \
+        global const char * src, ulong offs,                                        \
+        global char * dst, ulong offd,                                              \
+        int n_rows, float scale) {                                                  \
+    const int r = get_global_id(0) / FWHT_SG;                                       \
+    if (r >= n_rows) {                                                              \
+        return;                                                                     \
+    }                                                                               \
+    const int lane = get_sub_group_local_id();                                      \
+    global const float * s = (global const float *)(src + offs) + (long) r * N;     \
+    global float *       d = (global float *)(dst + offd) + (long) r * N;           \
+    float reg[N / FWHT_SG];                                                         \
+    _Pragma("unroll")                                                               \
+    for (int i = 0; i < N / FWHT_SG; ++i) {                                         \
+        reg[i] = s[i * FWHT_SG + lane] * scale;                                     \
+    }                                                                               \
+    _Pragma("unroll")                                                               \
+    for (int h = 1; h < FWHT_SG; h *= 2) {                                          \
+        _Pragma("unroll")                                                           \
+        for (int j = 0; j < N / FWHT_SG; ++j) {                                     \
+            const float v  = reg[j];                                                \
+            const float v2 = FWHT_SHUFFLE_XOR(v, (uint) h);                         \
+            reg[j] = (lane & h) == 0 ? v + v2 : v2 - v;                             \
+        }                                                                           \
+    }                                                                               \
+    _Pragma("unroll")                                                               \
+    for (int h = FWHT_SG; h < N; h *= 2) {                                          \
+        const int step = h / FWHT_SG;                                               \
+        _Pragma("unroll")                                                           \
+        for (int j = 0; j < N / FWHT_SG; j += 2 * step) {                           \
+            _Pragma("unroll")                                                       \
+            for (int k = 0; k < step; ++k) {                                        \
+                const float x = reg[j + k];                                         \
+                const float y = reg[j + k + step];                                  \
+                reg[j + k]        = x + y;                                          \
+                reg[j + k + step] = x - y;                                          \
+            }                                                                       \
+        }                                                                           \
+    }                                                                               \
+    _Pragma("unroll")                                                               \
+    for (int i = 0; i < N / FWHT_SG; ++i) {                                         \
+        d[i * FWHT_SG + lane] = reg[i];                                             \
+    }                                                                               \
+}
+
+FWHT_KERNEL(64)
+FWHT_KERNEL(128)
+FWHT_KERNEL(256)
+// no 512: on the A770 its 32 values a lane spill at SIMD16 (offline ocloc,
+// dg2-g10) and the retry rolls the loops; no model here rotates at 512.
diff --git a/ggml/src/ggml-opencl/kernels/leaky_relu.cl b/ggml/src/ggml-opencl/kernels/leaky_relu.cl
new file mode 100644
index 0000000..bc521b7
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/leaky_relu.cl
@@ -0,0 +1,77 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+
+//------------------------------------------------------------------------------
+// LEAKY_RELU (patch 0060): the missing unary the ESRGAN upscaler's graph falls
+// back to the CPU for, where the split-graph op segfaults. Same six variants as
+// unary_ext.cl (f32, f32_4, f16, f16_4, f32_nc, f16_nc); the negative slope is
+// the op's own parameter, an extra trailing argument.
+//   x > 0: x;  x <= 0: x * slope.
+// The CPU reference (ggml-cpu/ops.cpp) computes in f32; the f16 variants read
+// and write half and convert, so they match within tolerance.
+//------------------------------------------------------------------------------
+
+#define LEAKY_RELU(NAME, SEXPR, VEXPR)                                          \
+kernel void kernel_##NAME##_f32(                                               \
+        global const float * src0, ulong offset0,                             \
+        global       float * dst,  ulong offsetd, float slope) {              \
+    src0 = (global float*)((global char*)src0 + offset0);                     \
+    dst  = (global float*)((global char*)dst  + offsetd);                     \
+    float x = src0[get_global_id(0)];                                         \
+    dst[get_global_id(0)] = (SEXPR);                                          \
+}                                                                             \
+kernel void kernel_##NAME##_f32_4(                                            \
+        global const float4 * src0, ulong offset0,                           \
+        global       float4 * dst,  ulong offsetd, float slope) {             \
+    src0 = (global float4*)((global char*)src0 + offset0);                   \
+    dst  = (global float4*)((global char*)dst  + offsetd);                   \
+    float4 x = src0[get_global_id(0)];                                       \
+    dst[get_global_id(0)] = (VEXPR);                                         \
+}                                                                             \
+kernel void kernel_##NAME##_f16(                                             \
+        global const half * src0, ulong offset0,                            \
+        global       half * dst,  ulong offsetd, float slope) {              \
+    src0 = (global half*)((global char*)src0 + offset0);                    \
+    dst  = (global half*)((global char*)dst  + offsetd);                    \
+    float x = src0[get_global_id(0)];                                       \
+    dst[get_global_id(0)] = (SEXPR);                                        \
+}                                                                            \
+kernel void kernel_##NAME##_f16_4(                                          \
+        global const half4 * src0, ulong offset0,                          \
+        global       half4 * dst,  ulong offsetd, float slope) {            \
+    src0 = (global half4*)((global char*)src0 + offset0);                  \
+    dst  = (global half4*)((global char*)dst  + offsetd);                  \
+    float4 x = convert_float4(src0[get_global_id(0)]);                     \
+    dst[get_global_id(0)] = convert_half4(VEXPR);                          \
+}                                                                           \
+kernel void kernel_##NAME##_f32_nc(                                         \
+        global const char * src0, ulong offset0,                          \
+        global       char * dst,  ulong offsetd,                          \
+        int ne00, ulong nb00, ulong nb01, ulong nb02, ulong nb03,         \
+        ulong nb0, ulong nb1, ulong nb2, ulong nb3, float slope) {        \
+    src0 = src0 + offset0; dst = dst + offsetd;                            \
+    const int i3 = get_group_id(2);                                       \
+    const int i2 = get_group_id(1);                                       \
+    const int i1 = get_group_id(0);                                       \
+    for (int i0 = get_local_id(0); i0 < ne00; i0 += get_local_size(0)) {  \
+        float x = *(global const float *)(src0 + i3*nb03 + i2*nb02 + i1*nb01 + i0*nb00); \
+        *(global float *)(dst + i3*nb3 + i2*nb2 + i1*nb1 + i0*nb0) = (SEXPR);            \
+    }                                                                     \
+}                                                                         \
+kernel void kernel_##NAME##_f16_nc(                                       \
+        global const char * src0, ulong offset0,                          \
+        global       char * dst,  ulong offsetd,                          \
+        int ne00, ulong nb00, ulong nb01, ulong nb02, ulong nb03,         \
+        ulong nb0, ulong nb1, ulong nb2, ulong nb3, float slope) {        \
+    src0 = src0 + offset0; dst = dst + offsetd;                            \
+    const int i3 = get_group_id(2);                                       \
+    const int i2 = get_group_id(1);                                       \
+    const int i1 = get_group_id(0);                                       \
+    for (int i0 = get_local_id(0); i0 < ne00; i0 += get_local_size(0)) {  \
+        float x = *(global const half *)(src0 + i3*nb03 + i2*nb02 + i1*nb01 + i0*nb00); \
+        *(global half *)(dst + i3*nb3 + i2*nb2 + i1*nb1 + i0*nb0) = (SEXPR);            \
+    }                                                                     \
+}
+
+#define LEAKY_RELU_BODY(NAME) LEAKY_RELU(NAME, x > 0.0f ? x : x * slope, select(x * slope, x, x > (float4)0.0f))
+
+LEAKY_RELU_BODY(leaky_relu)
