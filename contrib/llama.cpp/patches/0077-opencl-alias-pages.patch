+            }
+        }
+        llama_cache_alias_check(alias_slots);   // warn and proceed
+    }
     // round 20: one stream-ring slot holds one bank tensor whole; the largest
     // bank tensor is the cold ring's first-touch slot content
     for (const auto & L : layers) {
