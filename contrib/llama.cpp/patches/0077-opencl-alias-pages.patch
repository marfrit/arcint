         if (bs.ring.empty()) bs.ring.resize(K);   // kept across a relearn (it only grows)
         for (auto & b : bs.ring) b.allocate(ctx->context, bs.max_bytes);
+        size_t alias_blocks = 0;
+        int alias_bad = 0;
+        for (auto & b : bs.ring) {
