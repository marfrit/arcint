+            backend_ctx->q8_2d_slots.emplace_back(new ggml_backend_opencl_context::q8_2d_slot());
+        }
+        ggml_backend_opencl_context::q8_2d_slot * pick = nullptr;
+        for (auto & sl : backend_ctx->q8_2d_slots) {
+            if (ggml_cl_kq_cached(sl->act, backend_ctx, src1, extra1->data_device, offset1, n_vals)) {
+                pick = sl.get();
