+// 0220: MUL_MAT with a fill that tells the scales apart. On the uniform fill every Q8_0 block scale and
+// every activation scale per 256 is nearly the same number, so a kernel that reads the wrong one passes
+// (an activation scale of the wrong token or 256-block stays near 5e-5 NMSE). Here weight row r, 32-block
+// b is scaled by 2^((r + b) % 8 - 4) and activation token t, 256-block s by 2^((t + s) % 8 - 4); with
+// big = 1 every token t % 61 == 7 is also scaled by 2^15, past the f16 conversion's 16,384 (its column
+// scale then moves). The weights are quantized from that fill as init_tensor_uniform quantizes.
+struct test_mul_mat_spread : public test_mul_mat {
+    const int big;
+    test_mul_mat_spread(ggml_type type_a, int64_t m, int64_t n, int64_t k, int big = 0)
+        : test_mul_mat(type_a, GGML_TYPE_F32, m, n, k, { 1, 1 }, { 1, 1 }), big(big) {}
+    std::string vars() override { return test_mul_mat::vars() + ",spread=1,big=" + std::to_string(big); }
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 rng(20261125u);
+        std::uniform_real_distribution<float> u(-1.0f, 1.0f);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            const bool is_a = strcmp(t->name, "a") == 0, is_b = strcmp(t->name, "b") == 0;
+            if (!is_a && !is_b) {
+                init_tensor_uniform(t);   // the sentinels and the rest, as the base case fills them
+                continue;
+            }
+            const int64_t ne0 = t->ne[0], nr = ggml_nrows(t), blk = is_a ? 32 : 256;
+            std::vector<float> data(ne0 * nr);
+            for (int64_t r = 0; r < nr; ++r) {
+                const float extra = (!is_a && big && r % 61 == 7) ? 32768.0f : 1.0f;
+                for (int64_t i = 0; i < ne0; ++i) {
+                    data[r * ne0 + i] = u(rng) * std::ldexp(1.0f, (int) ((r + i / blk) % 8) - 4) * extra;
+                }
+            }
+            if (t->type == GGML_TYPE_F32) {
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+            } else {
+                std::vector<uint8_t> q(ggml_row_size(t->type, ne0) * nr);
+                ggml_quantize_chunk(t->type, data.data(), q.data(), 0, nr, ne0, nullptr);
+                ggml_backend_tensor_set(t, q.data(), 0, q.size());
+            }
+        }
+    }
+};
