+// 0220: the Q8_0 2D GEMM's program: mul_mm_kq_2d.cl with Q8_2D_ONLY (none of the K-quants'
+// kernels) and Q8_2D_KERNELS, the K-quant program's options otherwise (its TM / WG / AT and
+// GGML_OPENCL_KQ_2D_OPTS, through which the red cases come); GGML_OPENCL_Q8_2D_VISA=1 adds
+// the fp16 kernel's inline-vISA decode. Only the mode's kernel is created. A failure costs
+// Q8_0 alone: the 0058 tile keeps it, with a DOWNGRADE line.
+static void ggml_cl_q8_2d_build(ggml_backend_opencl_context * backend_ctx, const std::string & src,
+                                const std::string & opts, int wg) {
+    const int mode = ggml_cl_q8_2d_mode();
+    static const char * va = getenv("GGML_OPENCL_Q8_2D_VISA");
+    const bool visa = va != nullptr && atoi(va) != 0;
+    const std::string o = opts + " -DQ8_2D_ONLY -DQ8_2D_KERNELS" + (visa ? " -DQ8_2D_VISA" : "");
+    cl_program p = build_program_from_source_optional(backend_ctx, src.c_str(), o);
+    if (p == nullptr) {
+        ggml_cl_downgrade("path=fallback reason=%s what=%s", "not-built", "q8_2d");
+        GGML_LOG_WARN("ggml_opencl: the Q8_0 2D GEMM did not build; the tile takes Q8_0\n");
+        return;
+    }
+    cl_int err = CL_SUCCESS, err2 = CL_SUCCESS;
+    cl_kernel k = clCreateKernel(p, mode == 2 ? "kernel_mul_mm_kq2d_q8_0_i8" : "kernel_mul_mm_kq2d_q8_0", &err);
+    cl_kernel kq = mode == 2 ? clCreateKernel(p, "kernel_quant_i8", &err2) : nullptr;
+    size_t wgs = 0, wgq = 256;
+    if (err == CL_SUCCESS) {
+        CL_CHECK(clGetKernelWorkGroupInfo(k, backend_ctx->device, CL_KERNEL_WORK_GROUP_SIZE, sizeof(wgs), &wgs, NULL));
+    }
+    if (kq != nullptr && err2 == CL_SUCCESS) {
+        CL_CHECK(clGetKernelWorkGroupInfo(kq, backend_ctx->device, CL_KERNEL_WORK_GROUP_SIZE, sizeof(wgq), &wgq, NULL));
+    }
+    const int max_sg = std::min(wg, (int) (wgs / 16));
+    if (err != CL_SUCCESS || err2 != CL_SUCCESS || max_sg < 1 || wgq < 256) {
+        if (err == CL_SUCCESS) CL_CHECK(clReleaseKernel(k));
+        if (kq != nullptr && err2 == CL_SUCCESS) CL_CHECK(clReleaseKernel(kq));
+        ggml_cl_downgrade("path=fallback reason=%s what=%s", "no-fit", "q8_2d");
+        GGML_LOG_WARN("ggml_opencl: the Q8_0 2D GEMM does not fit a work-group; the tile takes Q8_0\n");
+    } else {
+        (mode == 2 ? backend_ctx->kernel_mul_mm_kq2d_q8_0_i8 : backend_ctx->kernel_mul_mm_kq2d_q8_0) = k;
+        backend_ctx->kernel_q8_2d_quant_i8 = kq;
+        backend_ctx->q8_2d_max_sg = max_sg;
+        // the options a red case rides on are named, so a run shows its artefact carries them
+        const char * xo = getenv("GGML_OPENCL_KQ_2D_OPTS");
+        GGML_LOG_INFO("ggml_opencl: the Q8_0 2D GEMM built: GGML_OPENCL_Q8_2D=%d (%s), up to %d sub-groups a work-group%s%s%s\n",
+                      mode, mode == 2 ? "int8" : "fp16", max_sg, visa ? ", the vISA decode" : "",
+                      xo != nullptr ? ", GGML_OPENCL_KQ_2D_OPTS=" : "", xo != nullptr ? xo : "");
+    }
+    CL_CHECK(clReleaseProgram(p));
+}
