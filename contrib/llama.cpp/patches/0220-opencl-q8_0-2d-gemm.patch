0220: dense Q8_0 x F32 products of 16 or more columns on the 2D-block GEMM of mul_mm_kq_2d.cl behind GGML_OPENCL_Q8_2D (0 off, the default: nothing is built and the 0058 tile takes Q8_0 as before; 1 fp16, kernel_mul_mm_kq2d_q8_0; 2 int8, kernel_mul_mm_kq2d_q8_0_i8, the Q4_0 int8 kernel with the decode removed: Q8_0's codes are the DPAS operand). A program of its own from the same text (Q8_2D_ONLY: the K-quants' program is unchanged), the work-group sized to the rows, a pure gate (ggml-opencl-q8-2d.h: Q8_0 SoA, F32, K % 256, contiguous, no view, at most 8,192 rows, the 2D limits) with a DOWNGRADE line on refusal and one TAKEN line a process, the int8 activations in GGML_OPENCL_Q8_2D_SLOTS slots (default 4), bounds under GGML_OPENCL_BOUNDS, three reds through GGML_OPENCL_KQ_2D_OPTS (-DQ8_2D_RED=1 / 2 / 3: a block's codes, the block scales' row, the activation scales' token), an inline-vISA decode for the fp16 arm behind GGML_OPENCL_Q8_2D_VISA=1 (the C form the fallback), and the served shapes as op and perf cases, with op cases on a fill that tells the scales apart (test_mul_mat_spread: the uniform fill cannot see red 3).

diff --git a/ggml/src/ggml-opencl/ggml-opencl-q8-2d.h b/ggml/src/ggml-opencl/ggml-opencl-q8-2d.h
new file mode 100644
index 0000000..d7a8c89
--- /dev/null
+++ b/ggml/src/ggml-opencl/ggml-opencl-q8-2d.h
@@ -0,0 +1,139 @@
+// 0220: the gate and the launch shape of the dense Q8_0 2D-block GEMM (mul_mm_kq_2d.cl,
+// kernel_mul_mm_kq2d_q8_0_i8 and kernel_mul_mm_kq2d_q8_0, GGML_OPENCL_Q8_2D). Pure: no cl_
+// calls and no device, so a unit test feeds them a graph export's real types, shapes and
+// strides on the CPU host (arcint tests/test_opencl_q8_2d.cpp).
+//
+// What the kernels assume, and so what the gate requires:
+//   - Q8_0 weights in the backend's flat planes (set_tensor's SoA split: a q plane of
+//     ne00 bytes a row, a d plane of ne00 / 32 halves a row, each a sub-buffer at the
+//     device's base alignment, which a 2D block surface wants 64-byte aligned); a view is
+//     never flattened, so none is taken;
+//   - 2-D: one weight matrix, one column matrix, both contiguous; the destination's
+//     columns are rows of floats (nb[0] == 4) at any nb[1];
+//   - F32 columns, at least 16 of them (fewer take the matvecs, as for the 0058 tile);
+//   - K a multiple of 256 (a super-block of eight 32-blocks: the int8 activations carry
+//     one scale per 256);
+//   - the 2D block limits: a surface at most 2^24 bytes wide and 2^24 rows high (the
+//     fp16 activations are 2 * K bytes a row), and K x columns under 2^31 (the host keys
+//     and sizes the activations by that int);
+//   - at most `max_rows` rows (8,192 from the host): the big output head stays where it
+//     is.
+// The verdict names the first refusal; GGML_CL_Q8_2D_TAKE (0) is the only take. A
+// product that is not this path's (not Q8_0 x F32 -> F32, or under 16 columns) is
+// NOT_MINE, and a knob at 0 is OFF before anything else is looked at: with the knob off,
+// no product is taken and none is reported.
+#ifndef GGML_OPENCL_Q8_2D_H
+#define GGML_OPENCL_Q8_2D_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+// ggml_type values (ggml.h); ggml-opencl.cpp asserts them
+#define GGML_CL_Q8_2D_TYPE_F32  0
+#define GGML_CL_Q8_2D_TYPE_Q8_0 8
+#define GGML_CL_Q8_2D_Q8_BLOCK  32   // weights a block
+#define GGML_CL_Q8_2D_Q8_BYTES  34   // bytes a block (f16 scale + 32 codes)
+
+enum ggml_cl_q8_2d_verdict {
+    GGML_CL_Q8_2D_TAKE = 0,
+    GGML_CL_Q8_2D_OFF,        // GGML_OPENCL_Q8_2D=0 (the default)
+    GGML_CL_Q8_2D_NOT_MINE,   // not Q8_0 x F32 -> F32, or fewer than 16 columns
+    GGML_CL_Q8_2D_LAYOUT,     // batched, not contiguous, or a destination row not floats
+    GGML_CL_Q8_2D_VIEW,       // a view of a weight (never flattened)
+    GGML_CL_Q8_2D_SOA,        // not in the flat planes
+    GGML_CL_Q8_2D_K,          // K not a multiple of 256
+    GGML_CL_Q8_2D_ROWS,       // above the row cap
+    GGML_CL_Q8_2D_LIMIT,      // past a 2D block surface's 2^24, or K x columns past an int
+    GGML_CL_Q8_2D_ALIGN,      // the device's base alignment not a multiple of 64 bytes
+};
+
+struct ggml_cl_q8_2d_in {
+    int      mode;            // GGML_OPENCL_Q8_2D: 0 off, 1 fp16, 2 int8
+    int      type0, type1, typed;
+    int64_t  ne0[4];          // the weight
+    size_t   nb0[4];
+    int64_t  ne1[4];          // the columns
+    size_t   nb1[4];
+    size_t   nbd0;            // the destination's element stride
+    bool     view0;           // src0->view_src != nullptr
+    bool     soa0;            // ggml_cl_is_q8_0_soa(src0)
+    size_t   alignment;       // the device's base alignment in bytes
+    int64_t  max_rows;
+};
+
+static inline const char * ggml_cl_q8_2d_reason(int v) {
+    switch (v) {
+        case GGML_CL_Q8_2D_TAKE:     return "take";
+        case GGML_CL_Q8_2D_OFF:      return "off";
+        case GGML_CL_Q8_2D_NOT_MINE: return "not-mine";
+        case GGML_CL_Q8_2D_LAYOUT:   return "layout";
+        case GGML_CL_Q8_2D_VIEW:     return "view";
+        case GGML_CL_Q8_2D_SOA:      return "not-soa";
+        case GGML_CL_Q8_2D_K:        return "k";
+        case GGML_CL_Q8_2D_ROWS:     return "rows";
+        case GGML_CL_Q8_2D_LIMIT:    return "limit";
+        case GGML_CL_Q8_2D_ALIGN:    return "align";
+    }
+    return "unknown";
+}
+
+// k_mult is the K multiple the kernels need (256); the unit test's red passes 32
+static inline int ggml_cl_q8_2d_gate_k(const ggml_cl_q8_2d_in & a, int64_t k_mult) {
+    if (a.mode != 1 && a.mode != 2) {
+        return GGML_CL_Q8_2D_OFF;
+    }
+    if (a.type0 != GGML_CL_Q8_2D_TYPE_Q8_0 || a.type1 != GGML_CL_Q8_2D_TYPE_F32 ||
+        a.typed != GGML_CL_Q8_2D_TYPE_F32 || a.ne1[1] < 16) {
+        return GGML_CL_Q8_2D_NOT_MINE;
+    }
+    const int64_t k = a.ne0[0], m = a.ne0[1], n = a.ne1[1];
+    // 2-D, the columns' K the weight's, both contiguous (the weight in ggml's Q8_0 rows
+    // as the graph sees it, before the backend's split), a destination row of floats
+    if (a.ne0[2] != 1 || a.ne0[3] != 1 || a.ne1[2] != 1 || a.ne1[3] != 1 || a.ne1[0] != k ||
+        k % GGML_CL_Q8_2D_Q8_BLOCK != 0 || a.nbd0 != sizeof(float)) {
+        return GGML_CL_Q8_2D_LAYOUT;
+    }
+    const size_t row0 = (size_t) (k / GGML_CL_Q8_2D_Q8_BLOCK) * GGML_CL_Q8_2D_Q8_BYTES;
+    if (a.nb0[0] != GGML_CL_Q8_2D_Q8_BYTES || a.nb0[1] != row0 || a.nb0[2] != row0 * (size_t) m ||
+        a.nb0[3] != a.nb0[2] || a.nb1[0] != sizeof(float) || a.nb1[1] != (size_t) k * sizeof(float) ||
+        a.nb1[2] != a.nb1[1] * (size_t) n || a.nb1[3] != a.nb1[2]) {
+        return GGML_CL_Q8_2D_LAYOUT;
+    }
+    if (a.view0) {
+        return GGML_CL_Q8_2D_VIEW;
+    }
+    if (!a.soa0) {
+        return GGML_CL_Q8_2D_SOA;
+    }
+    if (k % k_mult != 0) {
+        return GGML_CL_Q8_2D_K;
+    }
+    if (m < 1 || m > a.max_rows) {
+        return GGML_CL_Q8_2D_ROWS;
+    }
+    if (2 * k >= ((int64_t) 1 << 24) || m >= ((int64_t) 1 << 24) || n >= ((int64_t) 1 << 24) ||
+        k * n >= ((int64_t) 1 << 31)) {
+        return GGML_CL_Q8_2D_LIMIT;
+    }
+    if (a.alignment == 0 || a.alignment % 64 != 0) {
+        return GGML_CL_Q8_2D_ALIGN;
+    }
+    return GGML_CL_Q8_2D_TAKE;
+}
+
+static inline int ggml_cl_q8_2d_gate(const ggml_cl_q8_2d_in & a) {
+    return ggml_cl_q8_2d_gate_k(a, 256);
+}
+
+// the work-groups over the rows: sub-groups of 16 rows, at most max_sg a work-group, the
+// rows shared evenly so no work-group is mostly padding (24 or 32 rows: one of 2; 384: two
+// of 12; 3,072: twelve of 16). The kernels take the band from get_local_size(0) / 16.
+static inline void ggml_cl_q8_2d_shape(int64_t rows, int max_sg, int * sg_per_wg, int * n_wg) {
+    const int64_t nsg = (rows + 15) / 16;
+    const int64_t mx  = max_sg < 1 ? 1 : max_sg;
+    const int64_t nwg = (nsg + mx - 1) / mx;
+    *n_wg      = (int) nwg;
+    *sg_per_wg = (int) ((nsg + nwg - 1) / nwg);
+}
+
+#endif // GGML_OPENCL_Q8_2D_H
