+static void ggml_cl_q8_2d_quantize(ggml_backend_opencl_context * backend_ctx, const ggml_tensor * src1,
+                                   int k, int ncols, int tp, const ggml_tensor * dst, cl_mem * xq, cl_mem * xd) {
