+    ggml_cl_kq_act * act = &backend_ctx->kq_i8;
+    ggml_cl_buffer * bq = &backend_ctx->prealloc_kq2_xq, * bd = &backend_ctx->prealloc_kq2_xd, * bs = &backend_ctx->prealloc_kq2_xs;
+    if (n_slots > 0) {
