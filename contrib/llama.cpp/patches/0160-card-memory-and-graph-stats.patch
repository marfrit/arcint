+// 0160: the driver's card figure for the spill guard. The same probe the loan uses: this
+// process's xe clients on the device's drm-pdev (sum_fdinfo), then
+// DRM_XE_DEVICE_QUERY_MEM_REGIONS on one of their render fds. The total is returned even when
+// the driver's used is the perfmon-less zero, with used_known false, so a guard can still bound
+// by the region total; no figure at all leaves driver false and the OpenCL total stands in.
+bool llama_device_card_memory(ggml_backend_dev_t dev, struct llama_card_memory_data * out) {
+    if (out == nullptr) return false;
+    *out = llama_card_memory_data{};
+    if (dev == nullptr) {
+        std::snprintf(out->why, sizeof(out->why), "no device");
+        return false;
+    }
+    ggml_backend_dev_props props = {};
+    ggml_backend_dev_get_props(dev, &props);
+    llama_loan_book::FdinfoScan scan;
+    llama_loan_book::scan_fdinfo("/proc/self/fdinfo", scan);
+    const llama_loan_book::FdinfoAgg agg = llama_loan_book::sum_fdinfo(scan, props.device_id);
+    if (agg.measured) out->process_vram0 = agg.vram0;
+    const llama_loan_book::CardQuery q = llama_loan_book::xe_query_card(agg.fd);
+    if (q.total > 0) {
+        out->driver     = true;
+        out->total      = q.total;
+        out->used_known = q.used > 0;
+        out->used       = q.used;
+        if (!q.ok) std::snprintf(out->why, sizeof(out->why), "%s", q.why.empty() ? "the driver's used is not a figure" : q.why.c_str());
+        return true;
+    }
+    std::snprintf(out->why, sizeof(out->why), "%s", !q.why.empty() ? q.why.c_str() : (agg.why != nullptr ? agg.why : "no xe query"));
+    return false;
+}
