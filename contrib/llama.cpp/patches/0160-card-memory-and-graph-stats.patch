+// 0160: the driver's own card figure, for the spill guard. DRM_XE_DEVICE_QUERY_MEM_REGIONS on a
+// render fd of this process's clients on the device: total is the region total allocations come
+// out of, used is the device-wide figure (the kernel's objects and every client). process_vram0
+// is this process's fdinfo residency, so used - process_vram0 is what other clients and the
+// kernel hold. The bool is false when no region total is available (no drm/xe_drm.h at build,
+// no client, a failed ioctl); the caller then uses the backend's memory_total (OpenCL's
+// CL_DEVICE_GLOBAL_MEM_SIZE) and says so. A total with the perfmon-less used of 0 is still a
+// driver figure and returns true with used_known false, so the caller can bound by the total
+// with the other clients' share at 0. Not part of the loan's rule, which keeps its own probe.
+struct llama_card_memory_data {
+    bool   driver         = false;   // a driver figure answered
+    size_t total          = 0;       // the VRAM region total, bytes
+    bool   used_known     = false;
+    size_t used           = 0;       // the device-wide used, bytes; 0 when not known
+    size_t process_vram0  = 0;       // this process's fdinfo vram0 on the device, bytes; 0 unknown
+    char   why[192]       = {};      // why not, or why used is not known
+};
+LLAMA_API bool llama_device_card_memory(ggml_backend_dev_t dev, struct llama_card_memory_data * out);
+
+// 0160: the graph the context reserved at init, for the "runs" tier's start warning: node and
+// split counts of the prompt (pp) and token (tg) graphs. -1 when not reserved (a training
+// context has tg from pp).
+struct llama_graph_stats {
+    int32_t n_nodes_pp = -1;
+    int32_t n_splits_pp = -1;
+    int32_t n_nodes_tg = -1;
+    int32_t n_splits_tg = -1;
+};
+LLAMA_API bool llama_context_graph_stats(const struct llama_context * ctx, struct llama_graph_stats * out);
+
