             s1.ne[1] = fc; s1.ne[2] = s1.ne[3] = 1; s1.nb[2] = s1.nb[3] = fc * s1.nb[1];
             d.ne[1]  = fc; d.ne[2]  = d.ne[3]  = 1; d.nb[2]  = d.nb[3]  = fc * d.nb[1];
             ggml_cl_mul_mat(backend, src0, &s1, &d);
+            ggml_cl_kq_forget(backend_ctx, &s1);
             return;
         }
     }
