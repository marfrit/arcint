                 d.ne[2] = 1; d.ne[3] = 1;
                 d.view_offs = dst->view_offs + (size_t)i12*nb2 + (size_t)i13*nb3;
                 ggml_cl_mul_mat(backend, src0, &s1, &d);
+                ggml_cl_kq_forget(backend_ctx, &s1);
