     char buf[256];
@@ -1499,6 +1501,12 @@ struct ggml_backend_opencl_context {
     // flash_attn_dpas2.cl (Xe2): K/V by 2D block reads, Q as f16 re-read a tile
     cl_kernel kernel_fa_dpas2_dk[3] = {}, kernel_fa_dpas2_carry_dk[3] = {}, kernel_fa_q_to_f16_dk[3] = {};
     cl_kernel kernel_fa_mask_cls = nullptr;       // the mask by 8 x 32 blocks (flash_attn_dpas2.cl)
+    // 0198: the port arm (flash_attn_port.cl, after trellis-serve's fa::Kern), GGML_OPENCL_FA_PORT=1
+    cl_kernel kernel_fa_port = nullptr, kernel_fa_port_q16 = nullptr;
+    cl_program program_fa_port = nullptr;
+    bool fa_port_tried = false;
+    int  fa_port_grf = 0, fa_port_qhoist = 0, fa_port_qf32 = 0, fa_port_skip = 1, fa_port_uniform = 1, fa_port_nobias = 0;
