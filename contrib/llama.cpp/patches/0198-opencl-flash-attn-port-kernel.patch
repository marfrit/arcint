+        GGML_ASSERT((rb_on && kv_pages == nullptr && !gqa_wide && backend_ctx->gpu_family == INTEL && n_q > 8 && n_q <= 64 && n_batch == 1 &&
+                     q->type == GGML_TYPE_F32 && mask != nullptr && mask->ne[2] == 1) ==
+                    (fa_row_blocks_split(n_q, n_batch, backend_ctx->gpu_family == INTEL, q->type == GGML_TYPE_F32,
+                                         mask != nullptr && mask->ne[2] == 1, kv_pages != nullptr, gqa_wide, rb_on) != 0));
         if (rb_on && kv_pages == nullptr && !gqa_wide && backend_ctx->gpu_family == INTEL && n_q > 8 && n_q <= 64 && n_batch == 1 &&
             q->type == GGML_TYPE_F32 && mask != nullptr && mask->ne[2] == 1) {
