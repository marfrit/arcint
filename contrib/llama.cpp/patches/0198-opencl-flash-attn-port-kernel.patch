         (mask == nullptr || (mask->type == GGML_TYPE_F16 && mask->ne[0] >= n_kv && mask->ne[1] >= n_q));
+    // 0198: the port arm, after trellis-serve's fa::Kern. GGML_OPENCL_FA_PORT=1,
+    // an indexed bias and the port's sources; supports_op accepted exactly what the
