+        const int window = ggml_get_op_params_i32(dst, GGML_FA_PARAM_WINDOW);
+        // the key blocks a tile visits are decided in the kernel, a block at a time, from
+        // the positions and the group classes (fa::Kern's [lo, hi) a tile): the launch
+        // hands it the whole kv axis
+        const int kv_lo = 0, kv_hi = n_kv;
+        const int rows = (int) q->ne[1];
+
+        auto argbuf = [](const ggml_tensor * t, cl_mem * m, cl_ulong * off) {
+            ggml_tensor_extra_cl * e = (ggml_tensor_extra_cl *) t->extra;
+            *m = e->data_device;
+            *off = e->offset + t->view_offs;
+        };
+        cl_mem bq = nullptr, bk = nullptr, bv = nullptr, bo = nullptr, bm = nullptr, bs = nullptr, bt = nullptr,
+               bkp = nullptr, bqp = nullptr, bcf = nullptr, brf = nullptr;
+        cl_ulong oq = 0, ok = 0, ov = 0, oo = 0, om = 0, os = 0, ot = 0, okp = 0, oqp = 0, ocf = 0, orf = 0;
+        argbuf(q, &bq, &oq); argbuf(k, &bk, &ok); argbuf(v, &bv, &ov); argbuf(dst, &bo, &oo);
+        argbuf(mask, &bm, &om);
+        argbuf(dst->src[GGML_FA_SRC_SINK_Q], &bs, &os);
+        argbuf(dst->src[GGML_FA_SRC_BIAS_TABLE], &bt, &ot);
+        argbuf(dst->src[GGML_FA_SRC_KPOS], &bkp, &okp);
+        argbuf(dst->src[GGML_FA_SRC_QPOS], &bqp, &oqp);
+        argbuf(dst->src[GGML_FA_SRC_CFLAG], &bcf, &ocf);
+        argbuf(dst->src[GGML_FA_SRC_RFLAG], &brf, &orf);
+        const int   n_bins = (int) dst->src[GGML_FA_SRC_BIAS_TABLE]->ne[0];
+        const cl_ulong q_nb1p = q->nb[1], q_nb2p = q->nb[2];   // the op's Q: a query row's stride, a head's stride
+        const cl_ulong o_nb2p = dst->nb[2];                    // the output's query-row stride
+        const cl_ulong k_nb1p = k->nb[1], v_nb1p = v->nb[1];
+        const cl_ulong k_nb2p = k->nb[2], v_nb2p = v->nb[2];   // a kv head's stride
+        // the 2D block reads want each head's base 64-byte aligned: the gate checked the
+        // strides and the view offset, the allocation's offset is the backend's alignment
+        if (ok % 64 != 0 || ov % 64 != 0) {
+            ggml_cl_downgrade("op=FLASH_ATTN port=declined reason=%s", "kv-base-unaligned");
+            GGML_ABORT("op=FLASH_ATTN port: a K/V base that is not 64-byte aligned");
+        }
+
+        // Q. The 256-GRF build reads the op's f32 Q itself (PORT_QF32). Otherwise Q goes to
+        // f16 once a call, [head][row][D] contiguous, unscaled (the kernel applies scale_log2
+        // itself): the port's own prepass, built with the kernel, reading the op's Q by its
+        // row and head strides; the kernel's Q surface then has row pitch D*2 and head
+        // stride n_q*D*2.
+        const bool qf32 = backend_ctx->fa_port_qf32 != 0;
+        const size_t q16_size = (size_t) rows * n_head * d_head_q * sizeof(cl_half);
+        cl_mem   qsrc = bq;
+        cl_ulong qsrc_off = oq, qsrc_nb1 = q_nb1p, qsrc_nb2 = q_nb2p;
+        if (!qf32) {
+            ggml_cl_buffer & q16buf = backend_ctx->scratch_buffer("fa_port_q16");
+            q16buf.allocate(backend_ctx->context, q16_size);
+            qsrc = q16buf.buffer;
+            qsrc_off = 0;
+            qsrc_nb1 = (cl_ulong) d_head_q * sizeof(cl_half);
+            qsrc_nb2 = qsrc_nb1 * rows;
+        }
+
+        // every buffer the two launches touch, against its allocation, before any enqueue
+        ggml_cl_bounds("op=FLASH_ATTN port", "q",  bq,  oq  + (size_t)(n_head - 1) * q_nb2p + (size_t)(rows - 1) * q_nb1p + (size_t) d_head_q * sizeof(float));
+        if (!qf32) {
+            ggml_cl_bounds("op=FLASH_ATTN port", "q16", qsrc, q16_size);
+        }
+        ggml_cl_bounds("op=FLASH_ATTN port", "k",  bk,  ok  + (size_t)(n_head_kv - 1) * k_nb2p + (size_t)(n_kv - 1) * k_nb1p + (size_t) d_head_q * sizeof(cl_half));
+        ggml_cl_bounds("op=FLASH_ATTN port", "v",  bv,  ov  + (size_t)(n_head_kv - 1) * v_nb2p + (size_t)(n_kv - 1) * v_nb1p + (size_t) d_head_q * sizeof(cl_half));
+        ggml_cl_bounds("op=FLASH_ATTN port", "o",  bo,  oo  + (size_t)(n_head - 1) * dst->nb[1] + (size_t)(rows - 1) * o_nb2p + (size_t) d_head_q * sizeof(float));
+        ggml_cl_bounds("op=FLASH_ATTN port", "mask", bm, om + (size_t)(rows - 1) * mask_nb1 + (size_t)n_kv * sizeof(cl_half));
+        ggml_cl_bounds("op=FLASH_ATTN port", "sink", bs, os + (size_t)rows * n_head * sizeof(float));
+        ggml_cl_bounds("op=FLASH_ATTN port", "table", bt, ot + (size_t)rows * n_head * n_bins * sizeof(float));
+        ggml_cl_bounds("op=FLASH_ATTN port", "kpos", bkp, okp + (size_t)n_kv * sizeof(int32_t));
+        ggml_cl_bounds("op=FLASH_ATTN port", "qpos", bqp, oqp + (size_t)rows * sizeof(int32_t));
+        ggml_cl_bounds("op=FLASH_ATTN port", "cflag", bcf, ocf + (size_t)((n_kv + 15) / 16));
+        ggml_cl_bounds("op=FLASH_ATTN port", "rflag", brf, orf + (size_t)((rows + 7) / 8));
+
+        if ((size_t) 16 * G > wg_limit) {
+            ggml_cl_downgrade("op=FLASH_ATTN port=declined reason=%s", "no-fit");
+            GGML_ABORT("op=FLASH_ATTN port: one tile's work-group does not fit the device");
+        }
+
+        {
+            static std::once_flag taken;
+            std::call_once(taken, [&] {
+                GGML_LOG_WARN("TAKEN src=opencl op=FLASH_ATTN port=fa_kern grf=%d qhoist=%d qf32=%d skip=%d uniform=%d qtw=%d%s\n",
+                              backend_ctx->fa_port_grf, backend_ctx->fa_port_qhoist, backend_ctx->fa_port_qf32,
+                              backend_ctx->fa_port_skip, backend_ctx->fa_port_uniform, qtw,
+                              backend_ctx->fa_port_nobias ? " probe=nobias-WRONG-ANSWERS" : "");
+            });
+        }
+
+        if (!qf32) {
+            int a = 0;
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(cl_mem),   &bq));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(cl_ulong), &oq));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(cl_ulong), &q_nb1p));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(cl_ulong), &q_nb2p));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(int),      &n_q));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(int),      &n_head));
+            CL_CHECK(clSetKernelArg(kq16, a++, sizeof(cl_mem),   &qsrc));
+            size_t lws16[3] = { (size_t) d_head_q / 8, 4, 1 };
+            size_t gws16[3] = { (size_t) d_head_q / 8, (size_t) CEIL_DIV(n_q, 4) * 4, (size_t) n_head };
+            backend_ctx->enqueue_ndrange_kernel(kq16, 3, gws16, lws16, dst);
+        }
+
+        float scale_log2 = 1.4426950408889634f * scale;
+        int a = 0;
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &qsrc));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &qsrc_off));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &qsrc_nb1));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &qsrc_nb2));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bk));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &ok));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &k_nb1p));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &k_nb2p));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bv));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &ov));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &v_nb1p));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &v_nb2p));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bo));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &oo));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &dst->nb[1]));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &o_nb2p));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bm));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &om));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &mask_nb1));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bs));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &os));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bt));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &ot));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &n_bins));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bkp));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &okp));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bqp));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &oqp));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &bcf));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &ocf));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_mem),   &brf));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(cl_ulong), &orf));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &n_q));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &n_kv));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &n_head));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &n_head_kv));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &qtw));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &ngroups));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &kv_lo));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &kv_hi));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(int),      &window));
+        CL_CHECK(clSetKernelArg(kp, a++, sizeof(float),    &scale_log2));
+        size_t lws[3] = { 16, (size_t) G, (size_t) qtw };
+        size_t gws[3] = { 16, (size_t) G, (size_t) n_head_kv * ngroups * qtw };
+        backend_ctx->enqueue_ndrange_kernel(kp, 3, gws, lws, dst);
+        return;
+    }
+
     if (backend_ctx->gpu_family == INTEL && n_q > 8 && !fa_dpas_ok && !gqa_wide) {
         ggml_cl_downgrade("op=FLASH_ATTN head=%d kv=%s n_q=9+ path=f32_f16 reason=%s", (int) d_head_q, ggml_type_name(k->type),
                           kd_sel == nullptr && !fa_v2_512 ? "no-dpas-kernel" : "shape");
diff --git a/ggml/src/ggml-opencl/kernels/flash_attn_port.cl b/ggml/src/ggml-opencl/kernels/flash_attn_port.cl
new file mode 100644
index 0000000..e6d7b93
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/flash_attn_port.cl
@@ -0,0 +1,356 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+#pragma OPENCL EXTENSION cl_intel_subgroup_matrix_multiply_accumulate : enable
+#pragma OPENCL EXTENSION cl_intel_subgroup_2d_block_io : enable
+
+// Flash attention for a prompt after trellis-serve's fa::Kern<128> (the vendored
+// kernel and the port's plan are in the arcint tree:
+// contrib/refkernels/trellis-fa/). One sub-group (16 lanes) owns an (head,
+// 8-query-row) tile and walks 32-key blocks (QR 8, KT 16, KBT 2, NC D/16); the
+// work-group is G heads x QTW adjacent query tiles of one kv head, sharing keys.
+// What OpenCL forces (opencl-plan.md): a DPAS needs 16 lanes, so the 8 rows are
+// one sub-group's collaboration, not one work-item's private state.
+//
+// Q: with PORT_QHOIST (the 256-GRF build) a tile's 8 x 128 Q values are read once
+// and held in registers, as fa::Kern holds Qc. With PORT_QF32 as well they come
+// straight from the op's f32 Q (D contiguous, any row and head stride), 16 floats a
+// sub-group block read, converted to f16 in registers: no prepass launch, no
+// scratch. Otherwise Q is the f16 scratch [head][row][D] that
+// kernel_flash_attn_port_q16 below writes once a call, read by 2D block reads -
+// once a tile with PORT_QHOIST, once a key block without it (128 GRF).
+//
+// Positions, not bins: qpos[n_q] and kpos[n_kv] (the host walks the cells and
+// emits them: patch 0194), the window as a scalar, and one class a 16-key group
+// (cflag: 1 = keys at consecutive positions, all of the query's sequence, no
+// empty cell; 2 = every cell empty; 0 = anything else) and one flag a 8-row
+// group (rflag: 1 = consecutive rows of that sequence). dist = qpos - kpos;
+// future and window cells are compares, so a linear group under a linear row
+// group reads no mask. Any other pair takes the general path: the mask decides
+// what is visible, and the bias is a clamped table read a key.
+//
+// The keys a tile visits: fa::Kern computes [lo, hi) a tile from qpos0/kpos0. Here
+// the positions are arrays (a ring cache has a seam, a cache has empty cells), so
+// the bounds are a test a 32-key block: a block is skipped when each of its two
+// groups is empty (class 2), past n_kv, or linear under linear rows with every
+// key in the future of the tile's last row or behind the window of its first.
+// A skipped block costs two flag reads and two position reads. -DGB_NO_SKIP
+// walks every block (the A/B arm; the answers are the same).
+//
+// The table is f32 [row][head][bin], bin-fastest and in the model's order (bin =
+// distance, the last bin the pad). A linear group's 16 keys are 16 descending
+// distances d0 .. d0-15: one intel_sub_group_block_read at bin d0-15, and lane j
+// takes lane 15-j's value (a shuffle).
+//
+// The softmax is fa::Kern's online form: m starts at the sink logit, a block's
+// row maximum updates it, alpha = exp2(m - m_new) rescales l and O, and
+// p = exp2(s - m_new) <= 1 is what goes to f16 for P V. l is a lane's partial
+// sum; the sink's own term (1 at the start, rescaled by every alpha) lives in
+// lane 0, and one reduction a row at the end gives the denominator.
+//
+// The red cases the build offers (GGML_OPENCL_FA_PORT_RED): GB_PAD_KEYS_OFF=1
+// shifts every K/V read one key row up, so the scores are another token's and
+// the answers differ (the 2D block read clamps at the surface height, so a
+// shifted row is an answer difference, not a fault); GB_SKIP_SINK drops the
+// sink's term from the denominator. GB_NO_BIAS (GGML_OPENCL_FA_PORT_PROBE=nobias)
+// is a timing probe, not a red case: the table is never read, so the difference
+// to the full kernel is what the table's bytes cost.
+
+#ifndef QR
+#define QR 8
+#endif
+#ifndef BK
+#define BK 32
+#endif
+#define NKB (BK / 16)   // two 16-key groups a block
+#ifndef DKQ
+#define DKQ 128
+#endif
+#define NC (DKQ / 16)   // eight D chunks
+#define M_INIT (-3.0e38f)
+#define LOG2E 1.4426950408889634f
+#ifndef PORT_QHOIST
+#define PORT_QHOIST 0
+#endif
+#ifndef PORT_QF32
+#define PORT_QF32 0
+#endif
+#ifndef PORT_UNIFORM
+#define PORT_UNIFORM 1
+#endif
+#if PORT_QF32 && !PORT_QHOIST
+#error "PORT_QF32 needs PORT_QHOIST: the f32 rows are converted once a tile"
+#endif
+#ifndef GB_PAD_KEYS_OFF
+#define GB_PAD_KEYS_OFF 0    // the red case: every key read one row up
+#endif
+#ifdef GB_SKIP_SINK
+#define SINK_L 0.f           // the red case: the sink's term dropped
+#else
+#define SINK_L 1.f
+#endif
+
+#define DPAS(a, b, c) intel_sub_group_f16_f16_matrix_mad_k16(a, b, c)
+#define QREAD(c, y) as_short8(__builtin_IB_subgroup_block_read_flat_u16_m8k16v1((long) qb, DKQ * 2 - 1, n_q - 1, qp - 1, (int2)(16 * (c), (y))))
+#define KREAD(c, y) as_int8(__builtin_IB_subgroup_block_read_flat_transpose_u32_k8((long) kb, DKQ * 2 - 1, n_kv - 1, kp - 1, (int2)(8 * (c), (y) + GB_PAD_KEYS_OFF)))
+#define VREAD(c, y) as_int8(__builtin_IB_subgroup_block_read_flat_transform_u16_k16((long) vb, DKQ * 2 - 1, n_kv - 1, vp - 1, (int2)(16 * (c), (y) + GB_PAD_KEYS_OFF)))
+
+// the reads flash_attn_dpas2.cl declares; the table's run read is
+// cl_intel_subgroups' intel_sub_group_block_read (one uint a lane), a builtin
+ushort8 __builtin_IB_subgroup_block_read_flat_u16_m8k16v1(long base, int w, int h, int p, int2 c);
+uint8   __builtin_IB_subgroup_block_read_flat_transpose_u32_k8(long base, int w, int h, int p, int2 c);
+uint8   __builtin_IB_subgroup_block_read_flat_transform_u16_k16(long base, int w, int h, int p, int2 c);
+
+// Q to f16, unscaled, [head][row][DKQ]: a work-item per 8 values. q_nb1 is the op's
+// query-row stride and q_nb2 its head stride, whatever the view (the model's Q is a
+// permuted [D, Lq, Hq] with nb1 = Hq*D*4, nb2 = D*4).
+kernel void kernel_flash_attn_port_q16(global const char * q, ulong q_offset, ulong q_nb1, ulong q_nb2,
+                                       int n_q, int n_head, global half * dst) {
+    const int c8 = get_global_id(0), row = get_global_id(1), head = get_global_id(2);
+    if (c8 >= DKQ / 8 || row >= n_q || head >= n_head) return;
+    const float8 x = vload8(c8, (global const float *)(q + q_offset + (ulong) head * q_nb2 + (ulong) row * q_nb1));
+    vstore8(convert_half8(x), 0, dst + ((ulong) head * n_q + row) * DKQ + 8 * c8);
+}
+
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_flash_attn_port(
+        global const char * q, ulong q_offset, ulong q_nb1, ulong q_nb2,
+        global const char * k, ulong k_offset, ulong k_nb1, ulong k_nb2,
+        global const char * v, ulong v_offset, ulong v_nb1, ulong v_nb2,
+        global char * dst, ulong o_offset, ulong o_nb1, ulong o_nb2,
+        global const void * mask_void, ulong mask_offset, ulong mask_nb1,
+        global const float * sink, ulong sink_offset,
+        global const float * table, ulong table_offset, int n_bins,
+        global const int * kpos, ulong kpos_offset,
+        global const int * qpos, ulong qpos_offset,
+        global const char * cflag, ulong cflag_offset,
+        global const char * rflag, ulong rflag_offset,
+        int n_q, int n_kv, int n_head, int hkv, int qtw, int ngroups,
+        int kv_lo, int kv_hi, int window, float scale_log2)
+{
+    const int lane = get_sub_group_local_id();
+    // z and g are the same in all 16 lanes of a sub-group, but an id read from the lane
+    // payload is a varying value to the compiler: every index, branch and loop below would
+    // then be SIMD-16 control flow, every scalar load a 16-lane gather of one address.
+    // The broadcast of lane 0 makes them uniform (PORT_UNIFORM=0: the varying form, the A/B).
+#if PORT_UNIFORM
+    const int z    = sub_group_broadcast((int) get_global_id(2), 0u);
+    const int g    = sub_group_broadcast((int) get_local_id(1), 0u);
+#else
+    const int z    = get_global_id(2);
+    const int g    = get_local_id(1);
+#endif
+    const int qti  = z % qtw, unit = z / qtw;
+    const int kvh  = unit / ngroups, grp = unit % ngroups;
+    const int qt   = grp * qtw + qti;
+    const int q0   = qt * QR;
+    if (q0 >= n_q) return;
+    const int head = kvh * (n_head / hkv) + g;
+
+    // Q is the op's f32 Q (PORT_QF32) or the f16 scratch [head][row][D]; either way q_nb1 is
+    // a row's stride and q_nb2 a head's. K/V are [D, Lk, Hk] with D fastest (nb1 a key row,
+    // nb2 a kv head); the head slice is the base offset.
+    const long qb = (long) (q + q_offset) + (long) head * (long) q_nb2;
+    const long kb = (long) (k + k_offset) + (long) kvh * (long) k_nb2;
+    const long vb = (long) (v + v_offset) + (long) kvh * (long) v_nb2;
+    const global int * kps = (global const int *)((global const char *) kpos + kpos_offset);
+    const global int * qps = (global const int *)((global const char *) qpos + qpos_offset);
+    const global char * cfl = (global const char *)(cflag + cflag_offset);
+    const global char * rfl = (global const char *)(rflag + rflag_offset);
+    const global half * mb = (global const half *)((global const char *) mask_void + mask_offset);
+    const global float * tb = (global const float *)((global const char *) table + table_offset);
+    const global float * sk = (global const float *)((global const char *) sink + sink_offset);
+
+    const int qp = (int) q_nb1, kp = (int) k_nb1, vp = (int) v_nb1;   // row pitches (bytes)
+    const bool rg_lin = rfl[q0 / QR] != 0;
+    const int nrow = min(QR, n_q - q0);
+
+    // the tile's rows: position, table row and mask row (a row past n_q repeats the last one
+    // and is never live), and the online softmax state with the sink as the initial (m, l)
+    int    qpr[QR];
+    size_t trow[QR], mrow[QR];
+    float  m[QR], l[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        const bool live = r < nrow;
+        const int  row  = min(q0 + r, n_q - 1);
+        qpr[r]  = qps[row];
+        trow[r] = ((size_t) row * n_head + head) * n_bins;       // where the row has its bins
+        mrow[r] = (size_t) row * (mask_nb1 / sizeof(half));     // where the row has its mask
+        const float s2 = LOG2E * sk[(size_t) row * n_head + head];
+        m[r] = live ? s2 : M_INIT;
+        l[r] = (live && lane == 0) ? SINK_L : 0.f;
+    }
+    const int qmin = qpr[0], qmax = qpr[0] + nrow - 1;   // the tile's span when rg_lin
+
+    float8 o[NC];
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) o[c] = (float8)(0.f);
+
+#if PORT_QHOIST
+    short8 qa[NC];
+#if PORT_QF32
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) {
+        // lane = dim 16 c + lane, component = row: the a operand, as QREAD returns it
+        float qv[QR];
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            const global char * qrow = q + q_offset + (ulong) head * q_nb2 + (ulong) min(q0 + r, n_q - 1) * q_nb1;
+            qv[r] = as_float(intel_sub_group_block_read((global const uint *) qrow + 16 * c));
+        }
+        qa[c] = as_short8(convert_half8((float8)(qv[0], qv[1], qv[2], qv[3], qv[4], qv[5], qv[6], qv[7])));
+    }
+#else
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) qa[c] = QREAD(c, q0);
+#endif
+#define QA(c) qa[c]
+#else
+#define QA(c) QREAD(c, q0)
+#endif
+
+    for (int t0 = kv_lo; t0 < kv_hi; t0 += BK) {
+        // ---- the block's two key groups: class, first position, dead or not ----
+        bool glin[NKB], gdead[NKB];
+        int  gk0[NKB];
+        bool skip = true;
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            const int  kg  = t0 + gb * 16;
+            const bool in  = kg < n_kv;
+            const int  kgc = min(kg, n_kv - 1);
+            const int  cf  = in ? (int) cfl[kgc >> 4] : 2;
+            const int  k0  = kps[kgc];
+            const int  cnt = min(16, n_kv - kg);
+            bool dead = cf == 2;
+            if (cf == 1 && rg_lin) {
+                // every key in the future of the last row, or behind the window of the first
+                dead = k0 > qmax || (window > 0 && qmin - (k0 + cnt - 1) >= window);
+            }
+            glin[gb]  = cf == 1 && rg_lin;
+            gdead[gb] = dead;
+            gk0[gb]   = k0;
+            skip = skip && dead;
+        }
+#ifndef GB_NO_SKIP
+        if (skip) continue;
+#endif
+
+        // ---- S = Q K^T: lane = key, component = row ----
+        float8 s[NKB];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) s[gb] = (float8)(0.f);
+        _Pragma("unroll")
+        for (int c = 0; c < NC; ++c) {
+            const short8 a = QA(c);
+            s[0] = DPAS(a, KREAD(c, t0), s[0]);
+            s[1] = DPAS(a, KREAD(c, t0 + 16), s[1]);
+        }
+
+        // ---- score -> per-row components: validity, mask, bias, in one pass ----
+        float sc[NKB][QR];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            const int  kg   = t0 + gb * 16;
+            const int  kk   = min(kg + lane, n_kv - 1);
+            const bool live = kg + lane < n_kv && !gdead[gb];
+            const int  kpl  = kps[kk];
+            const float sv8[QR] = { s[gb].s0, s[gb].s1, s[gb].s2, s[gb].s3, s[gb].s4, s[gb].s5, s[gb].s6, s[gb].s7 };
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                const int  d   = qpr[r] - kpl;
+                bool  vis;
+                float mv = 0.f;
+                if (glin[gb]) {
+                    vis = r < nrow && live && d >= 0 && (window == 0 || d < window);
+                } else {
+                    // the general path: the mask decides (empty cells, other sequences, a seam).
+                    // -inf (by its bits: the build is finite-math) and the f16 lowest hide a cell,
+                    // any other value is added to the score (natural-log units, like the bias)
+                    const ushort mu = as_ushort(mb[mrow[r] + kk]);
+                    const bool hidden = (mu & 0x7C00) == 0x7C00 || mu == 0xFBFF;
+                    mv  = hidden ? 0.f : (float) as_half(mu);
+                    vis = r < nrow && live && !hidden;
+                }
+                float bv = 0.f;
+#ifndef GB_NO_BIAS    // the timing probe: no table read at all (the answers are wrong)
+                if (glin[gb]) {
+                    // the run: this row's distance to the group's first key is d0 (lane-uniform),
+                    // lane j's is d0 - j. With d0 in [15, n_bins-1] the 16 bins d0-15 .. d0 are one
+                    // block read and lane j takes lane 15-j's value; a group wholly at or past the
+                    // pad bin reads nothing (the pad bin is zero); otherwise a clamped read a key.
+                    const int d0 = qpr[r] - gk0[gb];
+                    if (d0 - 15 < n_bins - 1) {
+                        if (d0 >= 15 && d0 <= n_bins - 1) {
+                            const float tv = as_float(intel_sub_group_block_read(
+                                (global const uint *) (tb + trow[r] + (d0 - 15))));
+                            bv = intel_sub_group_shuffle(tv, (uint) (15 - lane));
+                        } else {
+                            const int bin = d < 0 ? n_bins - 1 : (d < n_bins - 1 ? d : n_bins - 1);
+                            bv = tb[trow[r] + bin];
+                        }
+                    }
+                } else {
+                    const int bin = d < 0 ? n_bins - 1 : (d < n_bins - 1 ? d : n_bins - 1);
+                    bv = tb[trow[r] + bin];
+                }
+#endif
+                sc[gb][r] = vis ? sv8[r] * scale_log2 + LOG2E * (mv + bv) : M_INIT;
+            }
+        }
+
+        // ---- the online softmax: the rows' block maxima, alpha, l ----
+        float alpha[QR];
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            const float mx = sub_group_reduce_max(fmax(sc[0][r], sc[1][r]));
+            const float mn = fmax(m[r], mx);
+            alpha[r] = native_exp2(m[r] - mn);
+            m[r] = mn;
+            l[r] *= alpha[r];
+        }
+
+        // ---- p = exp2(s - m) <= 1, f16 a lane, l the lane's partial sum ----
+        short8 pa[NKB];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            half ph[QR];
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                ph[r] = (half)(sc[gb][r] > 0.5f * M_INIT ? native_exp2(sc[gb][r] - m[r]) : 0.f);
+                l[r] += (float) ph[r];
+            }
+            pa[gb] = as_short8((half8)(ph[0], ph[1], ph[2], ph[3], ph[4], ph[5], ph[6], ph[7]));
+        }
+
+        // ---- O = O alpha + P V, lane = dim, components = rows ----
+        const float8 av = (float8)(alpha[0], alpha[1], alpha[2], alpha[3], alpha[4], alpha[5], alpha[6], alpha[7]);
+        _Pragma("unroll")
+        for (int c = 0; c < NC; ++c) {
+            float8 acc = o[c] * av;
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) acc = DPAS(pa[gb], VREAD(c, t0 + gb * 16), acc);
+            o[c] = acc;
+        }
+    }
+
+    // ---- the reduction once, the store ----
+    float inv[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        const float lv = sub_group_reduce_add(l[r]);
+        inv[r] = lv > 0.f ? 1.f / lv : 0.f;
+    }
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) {
+        const float ov[QR] = { o[c].s0, o[c].s1, o[c].s2, o[c].s3, o[c].s4, o[c].s5, o[c].s6, o[c].s7 };
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            if (r >= nrow) continue;
+            // the op's dst is [D, n_head, n_q]: o_nb1 is a head's stride, o_nb2 a query row's
+            global float * orow = (global float *)(dst + o_offset + (size_t)head * o_nb1 + (size_t)(q0 + r) * o_nb2);
+            orow[c * 16 + lane] = ov[r] * inv[r];
+        }
+    }
+}
