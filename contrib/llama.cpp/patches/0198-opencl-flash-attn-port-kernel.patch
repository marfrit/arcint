     int       fa_dpas2_bq = 0, fa_dpas2_nthr = 0;
     // 0106: the build options of the head-256 prompt kernels, so that the
     // head-512 builds made on first use match them (sub-group, sub-groups a
@@ -13094,6 +13102,160 @@ static bool ggml_opencl_fa512_intel_supported(ggml_backend_opencl_context * back
     return true;
 }
 
+// 0198: the port arm after trellis-serve's fa::Kern<128>. The kernel is
+// flash_attn_port.cl; the plan and the reference are in the arcint tree
+// (contrib/refkernels/trellis-fa/). GGML_OPENCL_FA_PORT=1 turns it on; unset,
+// every path below is exactly the dispatch it was (0191/0192's).
+static bool ggml_cl_port_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_OPENCL_FA_PORT");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+// The port serves the calls that carry its sources (the per-query sinks at src[18]: the
+// model attaches them to a prompt batch only) and that its gate covers; anything else
+// carrying them is declined with a reason, never served by a kernel that would read it
+// another way. The rules are fa_port_gate.h's pure function; this is only its argument list.
+static cl_kernel ggml_cl_port_kernel(ggml_backend_opencl_context * backend_ctx);
+
+// THE decision whether the port serves an op that carries its sources. supports_op and the
+// launch both call this, and neither has a rule of its own: the pure gate on the op
+// (fa_port_gate.h), then the two facts only the device has - the kernel is built, and one
+// tile's work-group fits it.
+// Those two are not pure, and are the same answer every time: the kernel is built at most
+// once a device (ggml_cl_port_kernel remembers a failure as well as a success), from one
+// source with options read once a process, and its work-group limit is asked at that build
+// and kept. The first call pays the compile; every later call, at supports_op or at the
+// launch, reads the two fields. A device's first answer is its answer for the process.
+static bool ggml_cl_port_decide(ggml_backend_opencl_context * backend_ctx, const struct ggml_tensor * op, const char ** why) {
+    if (!fa_port_gate_op(op, (size_t) backend_ctx->alignment, backend_ctx->max_workgroup_size,
+                         backend_ctx->gpu_family == INTEL, why)) {
+        return false;
+    }
+    if (ggml_cl_port_kernel(backend_ctx) == nullptr || backend_ctx->kernel_fa_port_q16 == nullptr) {
+        *why = "not-built";
+        return false;
+    }
+    if ((size_t) 16 * (op->src[0]->ne[2] / op->src[1]->ne[2]) > backend_ctx->fa_port_wg) {
+        *why = "no-fit";
+        return false;
+    }
+    return true;
+}
+
+// built once a device, on the first call the gate lets through
+static cl_kernel ggml_cl_port_kernel(ggml_backend_opencl_context * backend_ctx) {
+    if (backend_ctx->kernel_fa_port != nullptr) return backend_ctx->kernel_fa_port;
+    if (backend_ctx->fa_port_tried) return nullptr;
+    backend_ctx->fa_port_tried = true;
+    if (backend_ctx->kernel_compile_opts.empty()) return nullptr;
+#ifdef GGML_OPENCL_EMBED_KERNELS
+    const std::string src {
+        #include "flash_attn_port.cl.h"
+    };
+#else
+    const std::string src = read_file("flash_attn_port.cl");
+#endif
+    if (src.empty()) {
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s", "source-missing");
+        return nullptr;
+    }
+    std::string opts = backend_ctx->kernel_compile_opts + " -DDKQ=128 -DBK=32";
+    // 0198: the register mode, GGML_OPENCL_FA_PORT_GRF=128|256 (unset: 256). The
+    // offline gate (ocloc, bmg-g21) on this kernel: 256 GRF has no scratch, 128 GRF
+    // spills. The reference fa::Kern is the same from its own SPIR-V (a spill at 128,
+    // none at 256) and its 256 build is the faster one on the B60, although 256 halves
+    // the threads a core. Both modes build, so a window can time both; the 256 build
+    // also holds a tile's Q in registers (PORT_QHOIST, as fa::Kern holds Qc) and takes it
