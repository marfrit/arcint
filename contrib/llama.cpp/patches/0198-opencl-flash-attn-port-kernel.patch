+        if (r == 1) opts += " -DGB_PAD_KEYS_OFF=1";
+        if (r == 2) opts += " -DGB_SKIP_SINK";
+    }
+    cl_program p = build_program_from_source_optional(backend_ctx, src.c_str(), opts);
+    if (p == nullptr) {
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s", "compile");
+        return nullptr;
+    }
+    cl_int err = CL_SUCCESS;
+    cl_kernel k = clCreateKernel(p, "kernel_flash_attn_port", &err);
+    if (err != CL_SUCCESS) {
+        CL_CHECK(clReleaseProgram(p));
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s what=%s", "kernel", "kernel_flash_attn_port");
+        return nullptr;
+    }
+    backend_ctx->program_fa_port = p;
+    backend_ctx->kernel_fa_port = k;
+    return k;
