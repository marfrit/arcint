+        // runs 4), clamped to what the device's work-group holds; one tile always fits
+        size_t wg_limit = 0;
+        CL_CHECK(clGetKernelWorkGroupInfo(kp, backend_ctx->device, CL_KERNEL_WORK_GROUP_SIZE, sizeof wg_limit, &wg_limit, nullptr));
+        static const char * qtw_env = getenv("GGML_OPENCL_FA_PORT_QTW");
+        int qtw = qtw_env != nullptr ? std::max(1, atoi(qtw_env)) : 1;
+        if ((size_t) 16 * G * qtw > wg_limit) {
+            const int fit = std::max(1, (int) (wg_limit / ((size_t) 16 * G)));
+            ggml_cl_downgrade("op=FLASH_ATTN port=qtw-clamped reason=%s from=%d to=%d", "work-group", qtw, fit);
+            qtw = fit;
+        }
