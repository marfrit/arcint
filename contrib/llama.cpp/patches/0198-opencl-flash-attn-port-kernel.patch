+// 0198: the port arm after trellis-serve's fa::Kern<128>. The kernel is
+// flash_attn_port.cl; the plan and the reference are in the arcint tree
+// (contrib/refkernels/trellis-fa/). GGML_OPENCL_FA_PORT=1 turns it on; unset,
+// every path below is exactly the dispatch it was (0191/0192's).
+static bool ggml_cl_port_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_OPENCL_FA_PORT");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+// The port serves the calls that carry its sources (the per-query sinks at src[18]: the
+// model attaches them to a prompt batch only) and that its gate covers; anything else
+// carrying them is declined with a reason, never served by a kernel that would read it
+// another way. The rules are fa_port_gate.h's pure function; this is only its argument list.
+static bool ggml_cl_port_gate(ggml_backend_opencl_context * backend_ctx, const struct ggml_tensor * op, const char ** why) {
+    const ggml_tensor * q = op->src[0], * k = op->src[1], * v = op->src[2];
+    const ggml_tensor * mask = op->src[3];
+    const ggml_tensor * bt = op->src[GGML_FA_SRC_BIAS_TABLE];
+    const ggml_tensor * bi = op->src[GGML_FA_SRC_BIAS_IDX];
+    const ggml_tensor * kp = op->src[GGML_FA_SRC_KPOS], * qp = op->src[GGML_FA_SRC_QPOS];
+    const ggml_tensor * cf = op->src[GGML_FA_SRC_CFLAG], * rf = op->src[GGML_FA_SRC_RFLAG];
+    const ggml_tensor * sinks = op->src[GGML_FA_SRC_SINK_Q];
+
+    float max_bias = 0.0f, softcap = 0.0f;
+    memcpy(&max_bias, (const float *) op->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const float *) op->op_params + 2, sizeof(float));
+
+    const int paged = op->src[GGML_FA_SRC_PAGES] != nullptr || op->src[GGML_FA_SRC_PLAN] != nullptr ||
+                      op->src[GGML_FA_SRC_TAG] != nullptr;
+    return fa_port_gate_why(q, k, v, mask, op, bt, bi, sinks, kp, qp, cf, rf,
+                            backend_ctx->alignment, backend_ctx->gpu_family == INTEL, paged,
+                            ggml_flash_attn_ext_has_indexed_bias(op) != 0 ? 1 : 0,
+                            max_bias, softcap, ggml_get_op_params_i32(op, GGML_FA_PARAM_WINDOW), why) != 0;
+}
+
+// built once a device, on the first call the gate lets through
+static cl_kernel ggml_cl_port_kernel(ggml_backend_opencl_context * backend_ctx) {
+    if (backend_ctx->kernel_fa_port != nullptr) return backend_ctx->kernel_fa_port;
+    if (backend_ctx->fa_port_tried) return nullptr;
+    backend_ctx->fa_port_tried = true;
+    if (backend_ctx->kernel_compile_opts.empty()) return nullptr;
+#ifdef GGML_OPENCL_EMBED_KERNELS
+    const std::string src {
+        #include "flash_attn_port.cl.h"
+    };
+#else
+    const std::string src = read_file("flash_attn_port.cl");
+#endif
+    if (src.empty()) {
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s", "source-missing");
+        return nullptr;
+    }
+    std::string opts = backend_ctx->kernel_compile_opts + " -DDKQ=128 -DBK=32";
+    // 0198: the register mode, GGML_OPENCL_FA_PORT_GRF=128|256 (unset: 256). The
+    // offline gate (ocloc, bmg-g21) on this kernel: 256 GRF has no scratch, 128 GRF
+    // spills. The reference fa::Kern is the same from its own SPIR-V (a spill at 128,
+    // none at 256) and its 256 build is the faster one on the B60, although 256 halves
+    // the threads a core. Both modes build, so a window can time both; the 256 build
+    // also holds a tile's Q in registers (PORT_QHOIST, as fa::Kern holds Qc) and takes it
+    // straight from the op's f32 Q (PORT_QF32: no prepass launch); the 128 build re-reads
+    // the f16 scratch a key block. GGML_OPENCL_FA_PORT_QHOIST=0|1 and
+    // GGML_OPENCL_FA_PORT_QF32=0|1 override that (QF32 needs QHOIST).
+    int grf = 256;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_GRF")) {
+        const int g = atoi(e);
+        if (g == 128 || g == 256) {
+            grf = g;
+        } else {
+            GGML_LOG_WARN("ggml_opencl: GGML_OPENCL_FA_PORT_GRF=%s is neither 128 nor 256; 256 is used\n", e);
+        }
+    }
+    int qhoist = grf == 256 ? 1 : 0;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_QHOIST")) {
+        qhoist = atoi(e) != 0 ? 1 : 0;
+    }
+    if (grf == 256) {
+        opts += " -cl-intel-256-GRF-per-thread";
+    }
+    int qf32 = qhoist;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_QF32")) {
+        qf32 = atoi(e) != 0 && qhoist ? 1 : 0;
+    }
+    opts += qhoist ? " -DPORT_QHOIST=1" : " -DPORT_QHOIST=0";
+    opts += qf32 ? " -DPORT_QF32=1" : " -DPORT_QF32=0";
+    // GGML_OPENCL_FA_PORT_SKIP=0: every key block is walked (the A/B arm of the block skip)
+    int skip = 1;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_SKIP")) {
+        skip = atoi(e) != 0 ? 1 : 0;
+    }
+    if (!skip) {
+        opts += " -DGB_NO_SKIP";
+    }
+    // GGML_OPENCL_FA_PORT_UNIFORM=0: the tile's ids as lane-varying values (the A/B of the
+    // broadcast that makes the kernel's indices and branches scalar)
+    int uniform = 1;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_UNIFORM")) {
+        uniform = atoi(e) != 0 ? 1 : 0;
+    }
+    opts += uniform ? " -DPORT_UNIFORM=1" : " -DPORT_UNIFORM=0";
+    // GGML_OPENCL_FA_PORT_PROBE=nobias: a timing probe with WRONG answers - the kernel
+    // never reads the bias table. Its time against the full kernel's is what the
+    // table's bytes cost a call. The TAKEN line names it.
+    int nobias = 0;
+    if (const char * e = getenv("GGML_OPENCL_FA_PORT_PROBE")) {
+        nobias = strcmp(e, "nobias") == 0 ? 1 : 0;
+    }
+    if (nobias) {
+        opts += " -DGB_NO_BIAS";
+    }
+    // the red cases: GGML_OPENCL_FA_PORT_RED=1 shifts every K/V read one key row up,
+    // =2 drops the sink's term; both must FAIL the port's test cases
+    if (const char * red = getenv("GGML_OPENCL_FA_PORT_RED")) {
+        const int r = atoi(red);
+        if (r == 1) opts += " -DGB_PAD_KEYS_OFF=1";
+        if (r == 2) opts += " -DGB_SKIP_SINK";
+    }
+    cl_program p = build_program_from_source_optional(backend_ctx, src.c_str(), opts);
+    if (p == nullptr) {
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s", "compile");
+        return nullptr;
+    }
+    cl_int err = CL_SUCCESS;
+    cl_kernel k = clCreateKernel(p, "kernel_flash_attn_port", &err);
+    cl_kernel k16 = err == CL_SUCCESS ? clCreateKernel(p, "kernel_flash_attn_port_q16", &err) : nullptr;
+    if (err != CL_SUCCESS) {
+        if (k != nullptr) CL_CHECK(clReleaseKernel(k));
+        CL_CHECK(clReleaseProgram(p));
+        ggml_cl_downgrade("op=FLASH_ATTN port=not-built reason=%s what=%s", "kernel", "kernel_flash_attn_port");
+        return nullptr;
+    }
+    backend_ctx->program_fa_port = p;
+    backend_ctx->kernel_fa_port = k;
+    backend_ctx->kernel_fa_port_q16 = k16;
+    backend_ctx->fa_port_grf = grf;
+    backend_ctx->fa_port_qhoist = qhoist;
+    backend_ctx->fa_port_qf32 = qf32;
+    backend_ctx->fa_port_skip = skip;
+    backend_ctx->fa_port_uniform = uniform;
+    backend_ctx->fa_port_nobias = nobias;
+    return k;
+}
