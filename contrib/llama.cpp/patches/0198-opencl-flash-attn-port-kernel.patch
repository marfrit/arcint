+// Flash attention for a prompt after trellis-serve's fa::Kern<128> (the vendored
+// kernel and the port's plan are in the arcint tree:
+// contrib/refkernels/trellis-fa/). One sub-group (16 lanes) owns an (head,
+// 8-query-row) tile and walks 32-key blocks (QR 8, KT 16, KBT 2, NC D/16); the
+// work-group is G heads x QTW adjacent query tiles of one kv head, sharing keys.
+// What OpenCL forces (opencl-plan.md): a DPAS needs 16 lanes, so the 8 rows are
+// one sub-group's collaboration, not one work-item's private state; Q is
+// re-read a tile (128 GRF, as flash_attn_dpas2.cl does at head 256).
+//
+// Positions, not bins: qpos[n_q] and kpos[n_kv] (the host walks the pairs and
+// emits them: patch 0194), the window as a scalar, and one linearity flag a
+// 16-key group (keys consecutive, one sequence, no empty cell) and one a 8-row
+// group. dist = qpos - kpos; pad, future and window cells are compares, so a
+// fully linear tile reads no mask. Other groups take the general path: a mask
+// read and a clamped table read per key.
+//
+// The table is f32 [row, head, bin], bin-fastest and bin-reversed (patch 0194
+// reverses attn_rel_bias's columns), so a row's 16 consecutive bins - one key
+// group's distances, descending - are ascending addresses: one
+// intel_sub_group_block_read_us a row, lane = key, no shuffle. The producer pads
+// the reversed row by 15 bins, so a run at either end cannot overhang; the
+// clamped (pad) bin is dist >= extent.
+//
+// The sink is f32 [n_q, n_head], the initial (m, l), and the table carries the
+// bias only (the graph's ggml_sub no longer runs): the sink term enters l[0]
+// once after the reduction, not into every lane's partial sum.
+//
+// The red cases the build offers (-DGB_*): GB_PAD_KEYS_OFF=1 reads one key past
+// n_kv; GB_SKIP_SINK drops the sink term; GB_FORCE_OFF_END=1 reads the bias run
+// one bin past the row (the pad is then visible as an error).
+
+#ifndef QR
+#define QR 8
+#endif
+#ifndef BK
+#define BK 32
+#endif
+#define NKB (BK / 16)   // two 16-key groups a block
+#ifndef DKQ
+#define DKQ 128
+#endif
+#define NC (DKQ / 16)   // eight D chunks
+#define M_INIT (-3.0e38f)
+#define LOG2E 1.4426950408889634f
+
+#define DPAS(a, b, c) intel_sub_group_f16_f16_matrix_mad_k16(a, b, c)
+#define QREAD(c, y) as_short8(__builtin_IB_subgroup_block_read_flat_u16_m8k16v1((long) qb, DKQ * 2 - 1, n_q - 1, qp - 1, (int2)(16 * (c), (y))))
+#define KREAD(c, y) as_int8(__builtin_IB_subgroup_block_read_flat_transpose_u32_k8((long) kb, DKQ * 2 - 1, n_kv - 1, kp - 1, (int2)(8 * (c), (y) + GB_PAD_KEYS_OFF)))
+#define VREAD(c, y) as_int8(__builtin_IB_subgroup_block_read_flat_transform_u16_k16((long) vb, DKQ * 2 - 1, n_kv - 1, kp - 1, (int2)(16 * (c), (y) + GB_PAD_KEYS_OFF)))
+
+// the reads flash_attn_dpas2.cl declares (its lines 70-87); the table's run
+// read is the sub-group block read of one uint a lane (cl_intel_subgroups)
+ushort8 __builtin_IB_subgroup_block_read_flat_u16_m8k16v1(long base, int w, int h, int p, int2 c);
+uint8   __builtin_IB_subgroup_block_read_flat_transpose_u32_k8(long base, int w, int h, int p, int2 c);
+uint8   __builtin_IB_subgroup_block_read_flat_transform_u16_k16(long base, int w, int h, int p, int2 c);
+uint    intel_sub_group_block_read(const global uint * p);
+
+#ifndef GB_PAD_KEYS_OFF
+#define GB_PAD_KEYS_OFF 0    // the red case's one-key read past n_kv
+#endif
+
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_flash_attn_port(
+        global const char * q, ulong q_offset, ulong q_nb1, ulong q_nb2,
+        global const char * k, ulong k_offset, ulong k_nb1, ulong k_nb2,
+        global const char * v, ulong v_offset, ulong v_nb1, ulong v_nb2,
+        global char * dst, ulong o_offset, ulong o_nb1, ulong o_nb2,
+        global const void * mask_void, ulong mask_offset, ulong mask_nb1,
+        global const float * sink, ulong sink_offset,
+        global const float * table, ulong table_offset, int n_bins,
+        global const int * kpos, ulong kpos_offset,
+        global const int * qpos, ulong qpos_offset,
+        global const char * cflag, ulong cflag_offset,
+        global const char * rflag, ulong rflag_offset,
+        int n_q, int n_kv, int n_head, int hkv, int qtw, int ngroups,
+        int kv_lo, int kv_hi, int window, float scale_log2)
+{
+    const int lane = get_sub_group_local_id();
+    const int z    = get_global_id(2);
+    const int qti  = z % qtw, unit = z / qtw;
+    const int kvh  = unit / ngroups, grp = unit % ngroups;
+    const int qt   = grp * qtw + qti;
+    const int q0   = qt * QR;
+    if (q0 >= n_q) return;
+    const int g    = get_local_id(1);
+    const int head = kvh * (n_head / hkv) + g;
+
+    // Q is [D, Lq, Hq] with D fastest (nb1 a query row, nb2 a head); K/V are [D, Lk, Hk]
+    // with D fastest (nb1 a key row, nb2 a kv head); the head slice is the base offset.
+    const long qb = (long) (global half *)((global const char *) q + q_offset) + (long) head * (long) q_nb2;
+    const long kb = (long) (k + k_offset) + (long) kvh * (long) k_nb2;
+    const long vb = (long) (v + v_offset) + (long) kvh * (long) v_nb2;
+    const global int * kps = (global const int *)((global const char *) kpos + kpos_offset);
+    const global int * qps = (global const int *)((global const char *) qpos + qpos_offset);
+    const global char * cfl = (global const char *)(cflag + cflag_offset);
+    const global char * rfl = (global const char *)(rflag + rflag_offset);
+
+    const int qp = (int) q_nb1, kp = (int) k_nb1;   // row pitches of the Q and K surfaces (bytes)
+    const bool rg_lin = rfl[q0 / QR] != 0;
+
+    float m[QR], l[QR], sinkv[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        const bool live = q0 + r < n_q;
+        sinkv[r] = live ? LOG2E * sink[sink_offset / sizeof(float) + (size_t)(q0 + r) * n_head + head] : M_INIT;
+        m[r] = live ? sinkv[r] : M_INIT;
+        l[r] = 0.f;
+    }
+    float8 o[NC];
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) o[c] = (float8)(0.f);
+
+    for (int t0 = kv_lo; t0 < kv_hi; t0 += BK) {
+        const bool cg_lin = t0 / 16 < n_kv ? cfl[t0 / 16] != 0 : false;
+
+        float8 s[NKB];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) s[gb] = (float8)(0.f);
+        _Pragma("unroll")
+        for (int c = 0; c < NC; ++c) {
+            const short8 a = QREAD(c, q0);
+            s[0] = DPAS(a, KREAD(c, t0), s[0]);
+            s[1] = DPAS(a, KREAD(c, t0 + 16), s[1]);
+        }
+
+        // ---- score -> per-row components (a vector cannot be indexed by r) ----
+        float sc[NKB][QR];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            sc[gb][0] = s[gb].s0; sc[gb][1] = s[gb].s1; sc[gb][2] = s[gb].s2; sc[gb][3] = s[gb].s3;
+            sc[gb][4] = s[gb].s4; sc[gb][5] = s[gb].s5; sc[gb][6] = s[gb].s6; sc[gb][7] = s[gb].s7;
+        }
+
+        // ---- key state of this lane ----
+        int  key[NKB];
+        bool live[NKB], valid[NKB][QR];
+        float bias[NKB][QR], mval[NKB][QR];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            key[gb] = t0 + gb * 16 + lane;
+            live[gb] = key[gb] < n_kv;
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                const int d = qps[q0 + r] - kps[min(key[gb], n_kv - 1)];
+                valid[gb][r] = (q0 + r < n_q) && live[gb] && d >= 0 && (window == 0 || d < window);
+                bias[gb][r] = 0.f;
+                mval[gb][r] = 0.f;
+            }
+        }
+
+        // ---- bias runs: a linear group reads one 16-bin run a row ----
+        // the run's start is (d0-15) for lane 0's distance d0, ascending with the
+        // lane; the lane whose key is at distance d0-j takes lane (15-j)'s value.
+        // d0 outside [15, n_bins-1] (recent keys, or past the extent) is scalar.
+        if (cg_lin) {
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) {
+                _Pragma("unroll")
+                for (int r = 0; r < QR; ++r) {
+                    if (q0 + r >= n_q) continue;
+                    const int d0 = qps[q0 + r] - kps[min(t0 + gb * 16, n_kv - 1)];
+                    const int dmin = d0 - 15;   // the group's smallest distance
+                    if (dmin >= n_bins - 1) continue;   // every bin is the pad: zero bias
+                    if (d0 >= 15 && d0 <= n_bins - 1) {
+                        const size_t base = (size_t)((q0 + r) * n_head + head) * n_bins + (d0 - 15);
+                        const float tv = as_float(intel_sub_group_block_read((global const uint *)(table + table_offset / sizeof(float)) + base + lane));
+                        bias[gb][r] = intel_sub_group_shuffle(tv, 15 - lane);
+                    } else {
+                        // a mixed group at either end: the lane's own bin, clamped
+                        const int d = qps[q0 + r] - kps[key[gb]];
+                        const int bin = d >= n_bins - 1 ? n_bins - 1 : (d < 0 ? n_bins - 1 : d);
+                        bias[gb][r] = table[table_offset / sizeof(float) + (size_t)((q0 + r) * n_head + head) * n_bins + bin];
+                    }
+                }
+            }
+        } else {
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) {
+                if (!live[gb]) continue;
+                _Pragma("unroll")
+                for (int r = 0; r < QR; ++r) {
+                    if (!valid[gb][r]) continue;
+                    const int d = qps[q0 + r] - kps[key[gb]];
+                    const int bin = d >= n_bins - 1 ? n_bins - 1 : d;
+                    bias[gb][r] = table[table_offset / sizeof(float) + (size_t)((q0 + r) * n_head + head) * n_bins + bin];
+                }
+            }
+        }
+
+        // ---- mask (the general path) ----
+        if (!cg_lin || !rg_lin) {
+            const global half * mb = (global const half *)((global const char *) mask_void + mask_offset);
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) {
+                if (!live[gb]) continue;
+                _Pragma("unroll")
+                for (int r = 0; r < QR; ++r) {
+                    if (q0 + r >= n_q) continue;
+                    const half mh = mb[(q0 + r) * mask_nb1 / sizeof(half) + key[gb]];
+                    if (as_ushort(mh) == 0xFC00) valid[gb][r] = false;
+                    else if (valid[gb][r]) mval[gb][r] = (float) mh;   // added after the scale, as the reference does
+                }
+            }
+        }
+
+        // ---- base-2 scores, bias folded in, invalid keys at M_INIT ----
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb)
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r)
+                sc[gb][r] = valid[gb][r] ? sc[gb][r] * scale_log2 + mval[gb][r] + LOG2E * bias[gb][r] : M_INIT;
+
+        // ---- per-row max of this lane's two keys, then a sub-group max only when
+        //      the max moves (flash_attn_dpas2.cl:366-383) ----
+        float smax[QR], dmax = M_INIT;
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            smax[r] = fmax(sc[0][r], sc[1][r]);
+            dmax = fmax(dmax, smax[r] - m[r]);
+        }
+        int anyg = dmax > 0.f ? 1 : 0;
+        anyg |= intel_sub_group_shuffle_xor(anyg, 8);
+        anyg |= intel_sub_group_shuffle_xor(anyg, 4);
+        anyg |= intel_sub_group_shuffle_xor(anyg, 2);
+        anyg |= intel_sub_group_shuffle_xor(anyg, 1);
+        if (anyg) {
+            float cv[QR];
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                const float rowmax = sub_group_reduce_max(smax[r]);   // all lanes' keys of the row
+                const float nm = fmax(m[r], rowmax);
+                cv[r] = nm > m[r] ? native_exp2(m[r] - nm) : 1.f;
+                l[r] *= cv[r];
+                m[r] = nm;
+            }
+            // o[c] holds rows as components: one rescale a block, per component
+            const float8 cvv = (float8)(cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7]);
+            _Pragma("unroll")
+            for (int c = 0; c < NC; ++c) o[c] *= cvv;
+        }
+
+        // ---- p = exp2(s - m), f16 a lane, l the lane's partial sum ----
+        short8 pa[NKB];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            half ph[QR];
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                ph[r] = (half)(sc[gb][r] > 0.5f * M_INIT ? native_exp2(sc[gb][r] - m[r]) : 0.f);
+                l[r] += (float) ph[r];
+            }
+            pa[gb] = as_short8((half8)(ph[0], ph[1], ph[2], ph[3], ph[4], ph[5], ph[6], ph[7]));
+        }
+
+        // ---- O += P V, lane = dim, components = rows ----
+        _Pragma("unroll")
+        for (int c = 0; c < NC; ++c) {
+            float8 acc = o[c];
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) acc = DPAS(pa[gb], VREAD(c, t0 + gb * 16), acc);
+            o[c] = acc;
+        }
+    }
+
+    // ---- the sink once, the reduction once, the store ----
+#ifndef GB_SKIP_SINK
+    float skterm[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) skterm[r] = 0.f;
+    if (lane == 0) {
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) if (q0 + r < n_q) skterm[r] = native_exp2(sinkv[r] - m[r]);
+    }
+#else
+    float skterm[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) skterm[r] = 0.f;   // the red case: the sink dropped
+#endif
+    float lv[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        lv[r] = sub_group_reduce_add(l[r]) + skterm[r];
+        const float inv = lv[r] > 0.f ? 1.f / lv[r] : 0.f;
+        l[r] = inv;
+    }
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) {
+        const float ov[QR] = { o[c].s0, o[c].s1, o[c].s2, o[c].s3, o[c].s4, o[c].s5, o[c].s6, o[c].s7 };
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            if (q0 + r >= n_q) continue;
+            // the op's dst is [D, n_head, n_q]: o_nb1 is a head's stride, o_nb2 a query row's
+            global float * orow = (global float *)(dst + o_offset + (size_t)head * o_nb1 + (size_t)(q0 + r) * o_nb2);
+            orow[c * 16 + lane] = ov[r] * l[r];
+        }
+    }
+}
