diff --git a/ggml/src/ggml-opencl/kernels/loop_control.cl b/ggml/src/ggml-opencl/kernels/loop_control.cl
new file mode 100644
index 0000000..cf9d100
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/loop_control.cl
@@ -0,0 +1,605 @@
+//------------------------------------------------------------------------------
+// loop_control (0221)
+//------------------------------------------------------------------------------
+// Inkling 2 Mini's loop controller (the loop model's message merge) as ONE launch:
+//
+//   g   = s_c * (Wd_a . cur) + s_m * (Wd_b . msg)    [64]   s_x = 1/sqrt(mean(x^2) + eps)
+//   out = (cur - tanh(Wf . g) * cur) + tanh(Wg . g) * msg
+//
+// The chain it replaces normalizes cur and msg, concatenates them, takes the down product,
+// the two up products, two tanh and four element-wise nodes, each a launch with its output
+// in global memory. Here nothing intermediate is written to global memory: the products,
+// the tanh and the combine stay in registers, g [rows, 64] lives in local memory between
+// the two phases, and the only global write is out.
+//
+// Geometry (the plan: ggml_loop_control_plan_make): a work-group of LC_NSG sub-groups of 16
+// lanes owns rows_wg consecutive rows (one work-group a core, one wave where the rows allow).
+//   Phase A (the down product, the norms folded in as scales after it): row tiles of 16 (a
+//     tail of 8). Sub-group s takes half s / 16 (cur or msg) and the K slice s % 16 of it;
+//     lane l holds the 4 outputs r = l + 16 j. The slice's partials and the rows' sums of
+//     squares go through local memory and are reduced to g, which stays in local memory.
+//   Phase B (the gain and forget products and the combine): items of (16 columns, a row
+//     range) round robin over the sub-groups; lane l holds column d = 16 group + l and its
+//     gain and forget weight rows (64 each) in registers for the whole row range.
+//   Software pipelining in both phases: the loads of block t+1 (phase A: the next K chunk's
+//   cur / msg rows and weight rows; phase B: the next rows' g, cur and msg) are issued before
+//   block t computes, into a second register buffer (ping-pong, no copy).
+//
+// Math: f32 FMA by default. -DLC_BF16 builds the bf16 variant (GGML_OPENCL_LOOP_CONTROL=bf16):
+// the products on DPAS (intel_sub_group_bf16_bf16_matrix_mad_k16, float accumulator, the
+// short8-accumulator form is never used), the activations (cur, msg, g) rounded to bf16 by
+// round-to-nearest-even, the weights exact (the model's are bf16 values stored as F32); the
+// sums of squares, the scales, tanh and the combine stay f32.
+//   DPAS operands, SIMD16 (mul_mm_kq_f16.cl's card-proven layout): a = short8, lane i holds
+//   k = i, component m is row m; b = int8, lane n is column n, its 16 k as 8 pairs (low half
+//   the even k); result float8, lane n column n, component m row m.
+//
+// Reds (GGML_OPENCL_LOOP_CONTROL_OPTS=-DLOOP_CONTROL_RED=<n>; each must fail every op case):
+//   1 gain and forget swapped in the combine (forget on msg, gain on cur)
+//   2 s_c used for both halves of the down product (the msg norm's scale dropped)
+//   3 the gain's tanh dropped
+//   4 the last K-split part of the msg half dropped from the reduction
+//   5 (bf16 build) the b operand's pairs swapped (odd k in the low half)
+
+#ifndef LOOP_CONTROL_HOST_REPLAY
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+#ifdef LC_BF16
+#pragma OPENCL EXTENSION cl_intel_subgroup_matrix_multiply_accumulate : enable
+#endif
+#define LC_REQD_SG  __attribute__((intel_reqd_sub_group_size(16)))
+#define LC_SGID()   ((int) get_sub_group_id())
+#define LC_LANE()   ((int) get_sub_group_local_id())
+#define LC_ZERO8(v) (v) = (float8)(0.0f)
+#endif
+
+#ifdef LOOP_CONTROL_HOST_REPLAY
+// the host replay (arcint tests/test_loop_control.cpp) includes this text once a build
+#undef LC_NSG
+#undef LC_HALF
+#undef LC_RANK
+#undef LC_REDUCE_TILE
+#undef LC_TG
+#undef LC_OUT
+#undef LC_COMBINE
+#undef LC_PHASE_A
+#undef LC_FMA_A32
+#undef LC_ACC32
+#undef LC_PB
+#undef LC_LOAD_B32
+#undef LC_COMP_B32
+#undef LC_TILE
+#undef LC_PACK_A
+#undef LC_ACCB
+#undef LC_LOAD_BB
+#undef LC_PACK_BB
+#undef LC_COMP_BB
+#endif
+
+#ifndef LOOP_CONTROL_RED
+#define LOOP_CONTROL_RED 0
+#endif
+// the prefetch distances, in chunks (phase A f32: 8 k a chunk; bf16: 16 k a chunk)
+#ifndef LC_PF
+#define LC_PF 4
+#endif
+
+#define LC_NSG   32
+#define LC_HALF  (LC_NSG/2)
+#define LC_RANK  64
+
+#ifdef LC_BF16
+// round to nearest even (finite inputs); exact for a value that is already a bf16 number
+static inline ushort lc_bf16(float f) {
+    uint u = as_uint(f);
+    u += 0x7FFFu + ((u >> 16) & 1u);
+    return (ushort) (u >> 16);
+}
+static inline int lc_pack(float lo, float hi) {
+#if LOOP_CONTROL_RED == 5
+    return (int) ((uint) lc_bf16(hi) | ((uint) lc_bf16(lo) << 16));
+#else
+    return (int) ((uint) lc_bf16(lo) | ((uint) lc_bf16(hi) << 16));
+#endif
+}
+#endif
+
+// the reduction of a row tile, shared by both maths: each sub-group's partials of output
+// column set j (r = lane + 16 j) and its rows' sums of squares go to local memory, then
+// TR*16 lanes sum the 16 K parts of each half and combine them with the rows' scales.
+//   part [NSG][16 lanes][16 rows], ssp [NSG][16 rows]
+// The scales are computed by the reducing lane itself (its row t), in round j = 0, and kept in
+// sc / sm (the caller's). Rounds J0 .. J1-1; the rows' sums go to local memory with round 0.
+#define LC_REDUCE_TILE(TR, ACC, J0, J1)                                                      \
+    {                                                                                        \
+        if ((J0) == 0 && lane == 0) {                                                        \
+            for (int t = 0; t < TR; ++t) ssp[sg*16 + t] = ss[t];                              \
+        }                                                                                    \
+        for (int j = (J0); j < (J1); ++j) {                                                  \
+            _Pragma("unroll")                                                                \
+            for (int t = 0; t < TR; ++t) part[(sg*16 + lane)*16 + t] = ACC(j, t);             \
+            barrier(CLK_LOCAL_MEM_FENCE);                                                    \
+            if (lid < TR*16) {                                                               \
+                const int t = lid / 16;                                                      \
+                const int n = lid % 16;                                                      \
+                if (j == 0) {                                                                \
+                    float qc = 0.0f, qm = 0.0f;                                              \
+                    for (int p = 0; p < LC_HALF; ++p) {                                      \
+                        qc += ssp[p*16 + t];                                                 \
+                        qm += ssp[(LC_HALF + p)*16 + t];                                     \
+                    }                                                                        \
+                    sc = 1.0f/sqrt(qc/(float) D + eps);                                      \
+                    sm = 1.0f/sqrt(qm/(float) D + eps);                                      \
+                    if (LOOP_CONTROL_RED == 2) sm = sc;                                      \
+                }                                                                            \
+                float A = 0.0f, B = 0.0f;                                                    \
+                for (int p = 0; p < LC_HALF; ++p) {                                          \
+                    A += part[(p*16 + n)*16 + t];                                            \
+                }                                                                            \
+                for (int p = 0; p < LC_HALF - (LOOP_CONTROL_RED == 4 ? 1 : 0); ++p) {        \
+                    B += part[((LC_HALF + p)*16 + n)*16 + t];                                \
+                }                                                                            \
+                if (t < tvalid) gst[t*LC_RANK + 16*j + n] = sc*A + sm*B;                     \
+            }                                                                                \
+            barrier(CLK_LOCAL_MEM_FENCE);                                                    \
+        }                                                                                    \
+    }
+
+// the combine, in the chain's node order (mul, sub, mul, add); one row's column d
+#if LOOP_CONTROL_RED == 1
+#define LC_TG(ag) tanh(ag)
+#define LC_OUT(c, m, tg, tf) ((c) - (tg)*(c)) + (tf)*(m)
+#elif LOOP_CONTROL_RED == 3
+#define LC_TG(ag) (ag)
+#define LC_OUT(c, m, tg, tf) ((c) - (tf)*(c)) + (tg)*(m)
+#else
+#define LC_TG(ag) tanh(ag)
+#define LC_OUT(c, m, tg, tf) ((c) - (tf)*(c)) + (tg)*(m)
+#endif
+#define LC_COMBINE(ag, af, c, m, t)                                                          \
+    {                                                                                        \
+        const float tg_ = LC_TG(ag);                                                         \
+        const float tf_ = tanh(af);                                                          \
+        const float o_  = LC_OUT(c, m, tg_, tf_);                                            \
+        if ((t) < rb) {                                                                      \
+            ((global float *) (dst + (ulong) (row0 + (t))*nbd1))[d] = o_;                    \
+        }                                                                                    \
+    }
+
+#ifndef LC_BF16
+//------------------------------------------------------------------------------
+// f32 math
+//------------------------------------------------------------------------------
+// Phase A, one row tile of TR rows: chunks of 8 k. The cur / msg values are the same for every
+// lane of a sub-group (uniform loads: a row's 8 floats once, the FMA's scalar operand); the
+// weight rows are each lane's own (its 4 output columns). ss is uniform as well.
+#define LC_PHASE_A(TR)                                                                       \
+static void lc_phase_a_##TR(const global char * cur, ulong nbc1, const global char * msg,   \
+        ulong nbm1, const global char * down, ulong nbw1, int D, int nt, int rowbase,        \
+        int tvalid, float eps, local float * gst, local float * part, local float * ssp,     \
+        int sg, int lane, int lid) {                                                         \
+    const int hf    = sg / LC_HALF;                                                          \
+    const int kpart = D / LC_HALF;                                                           \
+    const int kbeg  = (sg % LC_HALF)*kpart;                                                  \
+    const global char * X = hf ? msg : cur;                                                \
+    const ulong ldx = hf ? nbm1 : nbc1;                                                    \
+    const global float * xr[TR];                                                             \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) {                                                           \
+        const int row = min(rowbase + t, nt - 1);                                            \
+        xr[t] = (const global float *) (X + (ulong) row*ldx) + kbeg;                         \
+    }                                                                                        \
+    const global float * wr[4];                                                              \
+    _Pragma("unroll")                                                                        \
+    for (int j = 0; j < 4; ++j) {                                                            \
+        wr[j] = (const global float *) (down + (ulong) (lane + 16*j)*nbw1) + hf*D + kbeg;  \
+    }                                                                                        \
+    float acc[4][TR];                                                                        \
+    float ss[TR];                                                                            \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) {                                                           \
+        ss[t] = 0.0f;                                                                        \
+        _Pragma("unroll")                                                                    \
+        for (int j = 0; j < 4; ++j) acc[j][t] = 0.0f;                                        \
+    }                                                                                        \
+    /* two chunks an iteration, ping-pong: chunk c+1's loads (B) are issued before chunk  */  \
+    /* c's FMAs (A), chunk c+2's (A) before c+1's (B). The loads are unconditional (the   */  \
+    /* index clamped: past the end the last chunk again, from cache, unused): a           */  \
+    /* conditional load made IGC copy the buffer at the branch's join, the copy waiting   */  \
+    /* on the load. What the ISA then shows (ocloc 26.27, tools/isa_pipeline.py): the A   */  \
+    /* loads are first waited for in the next iteration, after both halves' FMAs; IGC     */  \
+    /* sinks the B loads to just before the B FMAs (and a one-chunk loop-carried form     */  \
+    /* lost both). So the cur / msg rows LC_PF chunks ahead are prefetched to the cache   */  \
+    /* (uniform: one message a row a pair of chunks, 16 floats = a 64-byte line); the     */  \
+    /* weights are read by every work-group and sit in L2. The prefetch's chunk pair is   */  \
+    /* clamped to the slice's last pair (nc - 2; nc = n_embd/128 is even for every n_embd */  \
+    /* the rule accepts): at nc - 1 its 16 floats ran 8 floats past the K slice, 32 bytes */  \
+    /* past the tensor on the last row (review F2).                                       */  \
+    float8 xa[TR], xb[TR], wa[4], wb[4];                                                     \
+    const int nc = kpart/8;                                                                  \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) xa[t] = vload8(0, xr[t]);                                   \
+    _Pragma("unroll")                                                                        \
+    for (int j = 0; j < 4; ++j) wa[j] = vload8(0, wr[j]);                                    \
+    for (int c = 0; c < nc; c += 2) {                                                        \
+        const int c1 = min(c + 1, nc - 1), c2 = min(c + 2, nc - 1), cp = min(c + LC_PF, nc - 2); \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) prefetch(xr[t] + cp*8, 16);                             \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) xb[t] = vload8(c1, xr[t]);                              \
+        _Pragma("unroll")                                                                    \
+        for (int j = 0; j < 4; ++j) wb[j] = vload8(c1, wr[j]);                               \
+        LC_FMA_A32(TR, xa, wa)                                                               \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) xa[t] = vload8(c2, xr[t]);                              \
+        _Pragma("unroll")                                                                    \
+        for (int j = 0; j < 4; ++j) wa[j] = vload8(c2, wr[j]);                               \
+        if (c + 1 < nc) {                                                                    \
+            LC_FMA_A32(TR, xb, wb)                                                           \
+        }                                                                                    \
+    }                                                                                        \
+    float sc = 0.0f, sm = 0.0f;                                                              \
+    LC_REDUCE_TILE(TR, LC_ACC32, 0, 4)                                                       \
+}
+
+#define LC_FMA_A32(TR, XB, WB)                                                               \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) {                                                           \
+        _Pragma("unroll")                                                                    \
+        for (int kk = 0; kk < 8; ++kk) {                                                     \
+            const float xv = XB[t][kk];                                                      \
+            ss[t] = fma(xv, xv, ss[t]);                                                      \
+            _Pragma("unroll")                                                                \
+            for (int j = 0; j < 4; ++j) acc[j][t] = fma(WB[j][kk], xv, acc[j][t]);           \
+        }                                                                                    \
+    }
+
+#define LC_ACC32(j, t) acc[j][t]
+
+LC_PHASE_A(16)
+LC_PHASE_A(8)
+#define LC_TILE 16
+
+// Phase B, one item: columns d = 16 group + lane, rows [ra, rb) of the work-group's rows, in
+// blocks of 4. The g row is uniform (local memory, the same address for every lane), cur, msg
+// and out are each lane's own column.
+#define LC_PB 2
+#define LC_LOAD_B32(G, C, M, t0)                                                             \
+    _Pragma("unroll")                                                                        \
+    for (int i = 0; i < LC_PB; ++i) {                                                        \
+        const int tt = min((t0) + i, rb - 1);                                                \
+        _Pragma("unroll")                                                                    \
+        for (int q = 0; q < 8; ++q) G[i][q] = vload8(q, gst + tt*LC_RANK);                   \
+        C[i] = ((const global float *) (cur + (ulong) (row0 + tt)*nbc1))[d];                 \
+        M[i] = ((const global float *) (msg + (ulong) (row0 + tt)*nbm1))[d];                 \
+    }
+#define LC_COMP_B32(G, C, M, t0)                                                             \
+    _Pragma("unroll")                                                                        \
+    for (int i = 0; i < LC_PB; ++i) {                                                        \
+        float ag = 0.0f, af = 0.0f;                                                          \
+        _Pragma("unroll")                                                                    \
+        for (int q = 0; q < 8; ++q) {                                                        \
+            _Pragma("unroll")                                                                \
+            for (int e = 0; e < 8; ++e) {                                                    \
+                ag = fma(wg[q][e], G[i][q][e], ag);                                          \
+                af = fma(wf[q][e], G[i][q][e], af);                                          \
+            }                                                                                \
+        }                                                                                    \
+        LC_COMBINE(ag, af, C[i], M[i], (t0) + i)                                             \
+    }
+
+static void lc_phase_b(const global char * cur, ulong nbc1, const global char * msg, ulong nbm1,
+        const global char * gain, ulong nbg1, const global char * forget, ulong nbf1,
+        global char * dst, ulong nbd1, int D, int row0, int nrows, int rsplit,
+        local const float * gst, int sg, int lane) {
+    const int ngr    = D / 16;
+    const int nitems = ngr*rsplit;
+    const int rchunk = (nrows + rsplit - 1)/rsplit;
+    for (int it = sg; it < nitems; it += LC_NSG) {
+        const int gi = it % ngr;
+        const int ra = (it / ngr)*rchunk;
+        const int rb = min(nrows, ra + rchunk);
+        if (ra >= rb) {
+            continue;
+        }
+        const int d = gi*16 + lane;
+        float8 wg[8], wf[8];
+        const global float * pg = (const global float *) (gain   + (ulong) d*nbg1);
+        const global float * pf = (const global float *) (forget + (ulong) d*nbf1);
+        _Pragma("unroll")
+        for (int q = 0; q < 8; ++q) {
+            wg[q] = vload8(q, pg);
+            wf[q] = vload8(q, pf);
+        }
+        // ping-pong as phase A, the loads unconditional (LC_LOAD_B32 clamps its rows), and
+        // the cur / msg rows four blocks ahead prefetched to the cache (the second half's
+        // loads are sunk to their use, as in phase A)
+        float8 Ga[LC_PB][8], Gb[LC_PB][8];
+        float  Ca[LC_PB], Cb[LC_PB], Ma[LC_PB], Mb[LC_PB];
+        LC_LOAD_B32(Ga, Ca, Ma, ra)
+        for (int t0 = ra; t0 < rb; t0 += 2*LC_PB) {
+            _Pragma("unroll")
+            for (int i = 0; i < 2*LC_PB; ++i) {
+                const int tp = min(t0 + 4*LC_PB + i, rb - 1);
+                prefetch((const global float *) (cur + (ulong) (row0 + tp)*nbc1) + d, 1);
+                prefetch((const global float *) (msg + (ulong) (row0 + tp)*nbm1) + d, 1);
+            }
+            LC_LOAD_B32(Gb, Cb, Mb, t0 + LC_PB)
+            LC_COMP_B32(Ga, Ca, Ma, t0)
+            LC_LOAD_B32(Ga, Ca, Ma, t0 + 2*LC_PB)
+            if (t0 + LC_PB < rb) {
+                LC_COMP_B32(Gb, Cb, Mb, t0 + LC_PB)
+            }
+        }
+    }
+}
+
+#else
+//------------------------------------------------------------------------------
+// bf16 math (DPAS)
+//------------------------------------------------------------------------------
+// Phase A, one row tile of TR rows (TR/8 DPAS row blocks): chunks of 16 k. Lane i holds
+// x[t][k0 + i] (the a operand's k = i) of each row and the 16 k of its 4 weight rows
+// (the b operand's column n = lane); the sums of squares are lane partials, reduced over the
+// sub-group at the tile's end.
+#define LC_PHASE_A(TR)                                                                       \
+static void lc_phase_a_##TR(const global char * cur, ulong nbc1, const global char * msg,   \
+        ulong nbm1, const global char * down, ulong nbw1, int D, int nt, int rowbase,        \
+        int tvalid, float eps, local float * gst, local float * part, local float * ssp,     \
+        int sg, int lane, int lid) {                                                         \
+    const int hf    = sg / LC_HALF;                                                          \
+    const int kpart = D / LC_HALF;                                                           \
+    const int kbeg  = (sg % LC_HALF)*kpart;                                                  \
+    const global char * X = hf ? msg : cur;                                                \
+    const ulong ldx = hf ? nbm1 : nbc1;                                                    \
+    const global float * xr[TR];                                                             \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) {                                                           \
+        const int row = min(rowbase + t, nt - 1);                                            \
+        xr[t] = (const global float *) (X + (ulong) row*ldx) + kbeg;   /* uniform */                  \
+    }                                                                                        \
+    /* two passes over the K slice, output columns j = 2 jp, 2 jp + 1 each: the register  */  \
+    /* set of one pass (accumulators, the next chunk's raw loads, the packed operands)    */  \
+    /* fits 256 GRF, the four-column set did not (IGC's retry); the second pass re-reads   */  \
+    /* the sub-group's own x slice (16 rows x kpart floats, from cache)                   */  \
+    float sc = 0.0f, sm = 0.0f;                                                              \
+    for (int jp = 0; jp < 2; ++jp) {                                                         \
+        float8 accb[2][TR/8];                                                                \
+        float ssl[TR];                                                                       \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) ssl[t] = 0.0f;                                          \
+        _Pragma("unroll")                                                                    \
+        for (int jj = 0; jj < 2; ++jj) {                                                     \
+            _Pragma("unroll")                                                                \
+            for (int mb = 0; mb < TR/8; ++mb) LC_ZERO8(accb[jj][mb]);                        \
+        }                                                                                    \
+        /* one raw buffer in flight (the next chunk's f32 loads, issued before this       */  \
+        /* chunk's DPAS) and one packed buffer (this chunk's bf16 operands, packed after  */  \
+        /* its loads arrive, i.e. after the previous chunk's DPAS)                         */  \
+        const global float * wq[2];   /* this pass's two weight rows, constant indices */  \
+        _Pragma("unroll")                                                                    \
+        for (int jj = 0; jj < 2; ++jj) {                                                     \
+            wq[jj] = (const global float *) (down + (ulong) (lane + 16*(2*jp + jj))*nbw1) + hf*D + kbeg; \
+        }                                                                                    \
+        float xn[TR];                                                                        \
+        float16 wn[2];                                                                       \
+        short8 pa[TR/8];                                                                     \
+        int8 pb[2];                                                                          \
+        const int nc = kpart/16;                                                             \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) xn[t] = xr[t][lane];                                    \
+        _Pragma("unroll")                                                                    \
+        for (int jj = 0; jj < 2; ++jj) wn[jj] = vload16(0, wq[jj]);                   \
+        LC_PACK_A(TR)                                                                        \
+        for (int c = 0; c < nc; ++c) {                                                       \
+            /* unconditional (clamped) loads, as in the f32 build */                         \
+            const int c1 = min(c + 1, nc - 1);                                               \
+            /* a chunk is two DPAS: too little to cover a load's latency (the ISA: the      */ \
+            /* next chunk's data waited for after <= 8 compute instructions), so the rows   */ \
+            /* LC_PD chunks ahead are prefetched to the cache, no registers                 */ \
+            const int cp = min(c + LC_PD, nc - 1);                                           \
+            _Pragma("unroll")                                                                \
+            for (int t = 0; t < TR; ++t) prefetch(xr[t] + cp*16 + lane, 1);                  \
+            _Pragma("unroll")                                                                \
+            for (int jj = 0; jj < 2; ++jj) prefetch(wq[jj] + cp*16, 16);                     \
+            _Pragma("unroll")                                                                \
+            for (int t = 0; t < TR; ++t) xn[t] = xr[t][c1*16 + lane];                        \
+            _Pragma("unroll")                                                                \
+            for (int jj = 0; jj < 2; ++jj) wn[jj] = vload16(c1, wq[jj]);                     \
+            _Pragma("unroll")                                                                \
+            for (int jj = 0; jj < 2; ++jj) {                                                 \
+                _Pragma("unroll")                                                            \
+                for (int mb = 0; mb < TR/8; ++mb) {                                          \
+                    accb[jj][mb] = intel_sub_group_bf16_bf16_matrix_mad_k16(pa[mb], pb[jj], accb[jj][mb]); \
+                }                                                                            \
+            }                                                                                \
+            if (c + 1 < nc) {                                                                \
+                LC_PACK_A(TR)                                                                \
+            }                                                                                \
+        }                                                                                    \
+        float ss[TR];                                                                        \
+        _Pragma("unroll")                                                                    \
+        for (int t = 0; t < TR; ++t) ss[t] = jp == 0 ? sub_group_reduce_add(ssl[t]) : 0.0f;  \
+        const int jbase = 2*jp;                                                              \
+        LC_REDUCE_TILE(TR, LC_ACCB, jbase, jbase + 2)                                        \
+    }                                                                                        \
+}
+
+// pack the raw chunk (xn, wn) into the DPAS operands (pa, pb); the sums of squares take the
+// f32 values
+#define LC_PACK_A(TR)                                                                        \
+    _Pragma("unroll")                                                                        \
+    for (int t = 0; t < TR; ++t) {                                                           \
+        ssl[t] = fma(xn[t], xn[t], ssl[t]);                                                  \
+        pa[t/8][t%8] = (short) lc_bf16(xn[t]);                                               \
+    }                                                                                        \
+    _Pragma("unroll")                                                                        \
+    for (int jj = 0; jj < 2; ++jj) {                                                         \
+        _Pragma("unroll")                                                                    \
+        for (int i = 0; i < 8; ++i) pb[jj][i] = lc_pack(wn[jj][2*i], wn[jj][2*i + 1]);       \
+    }
+
+#define LC_ACCB(j, t) accb[(j) - jbase][(t)/8][(t)%8]
+#ifndef LC_PD
+#define LC_PD 6
+#endif
+
+// 8-row tiles only in this build: with 16 (two DPAS row blocks) IGC's first compile spilled
+// 1,472-1,984 bytes beside phase B and its retry rolled the loops into private memory (ocloc
+// 26.27, bmg-g21); the f32 build keeps 16
+LC_PHASE_A(8)
+#define LC_TILE 8
+
+// Phase B, one item: columns d = 16 group + lane, rows [ra, rb) in blocks of 8 (one DPAS row
+// block). The a operand is g (lane i: k = r = 16 s + i, from local memory), the b operands are
+// the lane's gain and forget weight rows, packed once for the item.
+#define LC_PB 8
+// the next block's g rows (local memory) into the raw set, and a prefetch (to the cache, no
+// registers) of its cur / msg rows: the bf16 build's register set holds the packed weights
+// (64 GRF) and the DPAS operands, and a raw cur / msg set beside them made IGC spill
+#define LC_LOAD_BB(G, t0)                                                                    \
+    _Pragma("unroll")                                                                        \
+    for (int m = 0; m < LC_PB; ++m) {                                                        \
+        const int tt = min((t0) + m, rb - 1);                                                \
+        _Pragma("unroll")                                                                    \
+        for (int s = 0; s < 4; ++s) G[s][m] = gst[tt*LC_RANK + 16*s + lane];                 \
+        prefetch((const global float *) (cur + (ulong) (row0 + tt)*nbc1) + d, 1);            \
+        prefetch((const global float *) (msg + (ulong) (row0 + tt)*nbm1) + d, 1);            \
+    }
+// pack the raw rows (G: g in f32) into the a operands; the raw set is then free
+#define LC_PACK_BB(G)                                                                        \
+    _Pragma("unroll")                                                                        \
+    for (int s = 0; s < 4; ++s) {                                                            \
+        _Pragma("unroll")                                                                    \
+        for (int m = 0; m < 8; ++m) pa[s][m] = (short) lc_bf16(G[s][m]);                     \
+    }
+#define LC_COMP_BB(t0)                                                                       \
+    {                                                                                        \
+        float8 ag, af;                                                                       \
+        LC_ZERO8(ag);                                                                        \
+        LC_ZERO8(af);                                                                        \
+        _Pragma("unroll")                                                                    \
+        for (int s = 0; s < 4; ++s) {                                                        \
+            ag = intel_sub_group_bf16_bf16_matrix_mad_k16(pa[s], bg[s], ag);                 \
+            af = intel_sub_group_bf16_bf16_matrix_mad_k16(pa[s], bf[s], af);                 \
+        }                                                                                    \
+        _Pragma("unroll")                                                                    \
+        for (int m = 0; m < LC_PB; ++m) {                                                    \
+            const int tt = min((t0) + m, rb - 1);                                            \
+            const float cv = ((const global float *) (cur + (ulong) (row0 + tt)*nbc1))[d];   \
+            const float mv = ((const global float *) (msg + (ulong) (row0 + tt)*nbm1))[d];   \
+            LC_COMBINE(ag[m], af[m], cv, mv, (t0) + m)                                       \
+        }                                                                                    \
+    }
+
+static void lc_phase_b(const global char * cur, ulong nbc1, const global char * msg, ulong nbm1,
+        const global char * gain, ulong nbg1, const global char * forget, ulong nbf1,
+        global char * dst, ulong nbd1, int D, int row0, int nrows, int rsplit,
+        local const float * gst, int sg, int lane) {
+    const int ngr    = D / 16;
+    const int nitems = ngr*rsplit;
+    const int rchunk = (nrows + rsplit - 1)/rsplit;
+    for (int it = sg; it < nitems; it += LC_NSG) {
+        const int gi = it % ngr;
+        const int ra = (it / ngr)*rchunk;
+        const int rb = min(nrows, ra + rchunk);
+        if (ra >= rb) {
+            continue;
+        }
+        const int d = gi*16 + lane;
+        int8 bg[4], bf[4];
+        const global float * pg = (const global float *) (gain   + (ulong) d*nbg1);
+        const global float * pf = (const global float *) (forget + (ulong) d*nbf1);
+        _Pragma("unroll")
+        for (int s = 0; s < 4; ++s) {
+            const float16 vg = vload16(s, pg);
+            const float16 vf = vload16(s, pf);
+            _Pragma("unroll")
+            for (int i = 0; i < 8; ++i) {
+                bg[s][i] = lc_pack(vg[2*i], vg[2*i + 1]);
+                bf[s][i] = lc_pack(vf[2*i], vf[2*i + 1]);
+            }
+        }
+        // the next block's g loads and cur / msg prefetches are issued before this block's
+        // DPAS; the current block computes from its packed operands (pa)
+        float  G[4][LC_PB];
+        short8 pa[4];
+        LC_LOAD_BB(G, ra)
+        LC_PACK_BB(G)
+        for (int t0 = ra; t0 < rb; t0 += LC_PB) {
+            LC_LOAD_BB(G, t0 + LC_PB)   // unconditional: LC_LOAD_BB clamps its rows
+            LC_COMP_BB(t0)
+            if (t0 + LC_PB < rb) {
+                LC_PACK_BB(G)
+            }
+        }
+    }
+}
+#endif
+
+LC_REQD_SG
+kernel void kernel_loop_control(
+        global const char * cur,
+        ulong               offc,
+        ulong               nbc1,
+        global const char * msg,
+        ulong               offm,
+        ulong               nbm1,
+        global const char * down,
+        ulong               offw,
+        ulong               nbw1,
+        global const char * gain,
+        ulong               offg,
+        ulong               nbg1,
+        global const char * forget,
+        ulong               offf,
+        ulong               nbf1,
+        global char *       dst,
+        ulong               offd,
+        ulong               nbd1,
+        int                 ne0,
+        int                 nt,
+        int                 rows_wg,
+        int                 rsplit,
+        float               eps,
+        local float *       slm
+) {
+    cur    = cur    + offc;
+    msg    = msg    + offm;
+    down   = down   + offw;
+    gain   = gain   + offg;
+    forget = forget + offf;
+    dst    = dst    + offd;
+
+    const int D     = ne0;
+    const int lid   = (int) get_local_id(0);
+    const int sg    = LC_SGID();
+    const int lane  = LC_LANE();
+    const int row0  = (int) get_group_id(0)*rows_wg;
+    const int nrows = min(rows_wg, nt - row0);
+
+    local float * gst  = slm;                                // [rows_wg][64]
+    local float * part = slm + rows_wg*LC_RANK;              // [NSG][16][16]
+    local float * ssp  = part + LC_NSG*16*16;                // [NSG][16]
+
+    // phase A: g for the work-group's rows, tile by tile (the branch is uniform over the
+    // work-group, so every barrier inside is reached by every lane)
+    for (int t0 = 0; t0 < nrows; t0 += LC_TILE) {
+        const int tvalid = min(LC_TILE, nrows - t0);
+#if LC_TILE == 16
+        if (tvalid > 8) {
+            lc_phase_a_16(cur, nbc1, msg, nbm1, down, nbw1, D, nt, row0 + t0, tvalid, eps,
+                          gst + t0*LC_RANK, part, ssp, sg, lane, lid);
+        } else
+#endif
+        {
+            lc_phase_a_8(cur, nbc1, msg, nbm1, down, nbw1, D, nt, row0 + t0, tvalid, eps,
+                         gst + t0*LC_RANK, part, ssp, sg, lane, lid);
+        }
+    }
+    // the reduction's last barrier also orders the g store before phase B reads it
+
+    // phase B: the up products, tanh and the combine, out written once
+    lc_phase_b(cur, nbc1, msg, nbm1, gain, nbg1, forget, nbf1, dst, nbd1, D, row0, nrows, rsplit,
+               gst, sg, lane);
+}
