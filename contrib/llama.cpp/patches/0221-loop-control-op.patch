+// 0221: Inkling 2 Mini's loop controller as one launch (loop_control.cl). The unfused chain is,
+// a control: rms_norm(cur), rms_norm(msg), concat, the down product (a K-split GEMM and its
+// slice sum), the forget and gain products, two tanh, mul, sub, mul, add - 12 launches, each
+// with its output in global memory (74.2 ms a 1,024-row ubatch on the B60, the profile's d4096
+// chunk). The kernel reads cur, msg and the three weights, keeps g in local memory and writes
+// out once.
+//
+// GGML_OPENCL_LOOP_CONTROL: unset (or 0 / off) the model emits the chain and this is never
+// reached; 1 (or all-layers) the f32 kernel; bf16 the bf16-DPAS build of the same text.
+// GGML_OPENCL_LOOP_CONTROL_OPTS appends compiler options: the reds (-DLOOP_CONTROL_RED=1..5,
+// loop_control.cl's header) - a test hook, as the depth mix's.
+static int ggml_cl_loop_control_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_OPENCL_LOOP_CONTROL");
+        const int m = ggml_loop_control_mode(e);
+        if (m < 0) {
+            GGML_LOG_WARN("ggml_opencl: GGML_OPENCL_LOOP_CONTROL=%s is not a value (0, off, 1, f32, bf16, all-layers): the arm is off\n", e);
+            return 0;
+        }
+        return m;
+    }();
+    return mode;
+}
