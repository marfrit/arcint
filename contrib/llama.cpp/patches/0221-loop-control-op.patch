+// ggml_compute_forward_loop_control
+
+// 0221: the loop controller's reference, the unfused chain's arithmetic in f32, a row at a time:
+// rms_norm of cur and msg as ggml_compute_forward_rms_norm_f32 computes it (a ggml_float sum of
+// squares, scale = 1/sqrt(mean + eps)), the concatenated normed row into the down product, the
+// gain and forget products with tanhf, then (cur - forget*cur) + gain*msg in the chain's node
+// order (mul, sub, mul, add). The products use ggml_vec_dot_f32, the f32 x f32 dot the chain's
+// mul_mat takes on this backend.
+static void ggml_compute_forward_loop_control_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * cur    = dst->src[0];
+    const ggml_tensor * msg    = dst->src[1];
+    const ggml_tensor * down   = dst->src[2];
+    const ggml_tensor * gain   = dst->src[3];
+    const ggml_tensor * forget = dst->src[4];
+
+    const float eps = ggml_get_op_params_f32(dst, 0);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t n_embd = cur->ne[0];
+    const int64_t n_tok  = cur->ne[1];
+    const int64_t rank   = down->ne[1];
+
+    std::vector<float> h((size_t) 2*n_embd);
+    std::vector<float> g((size_t) rank);
+
+    for (int64_t t = ith; t < n_tok; t += nth) {
+        const float * c = (const float *) ((const char *) cur->data + t*cur->nb[1]);
+        const float * m = (const float *) ((const char *) msg->data + t*msg->nb[1]);
+        float       * o = (float *)       ((char *)       dst->data + t*dst->nb[1]);
+
+        for (int half = 0; half < 2; ++half) {
+            const float * x = half == 0 ? c : m;
+            ggml_float sum = 0.0;
+            for (int64_t i = 0; i < n_embd; ++i) {
+                sum += (ggml_float) (x[i]*x[i]);
+            }
+            const float mean  = sum/n_embd;
+            const float scale = 1.0f/sqrtf(mean + eps);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                h[half*n_embd + i] = x[i]*scale;
+            }
+        }
+        for (int64_t r = 0; r < rank; ++r) {
+            ggml_vec_dot_f32((int) (2*n_embd), &g[r], 0,
+                    (const float *) ((const char *) down->data + r*down->nb[1]), 0, h.data(), 0, 1);
+        }
+        for (int64_t i = 0; i < n_embd; ++i) {
+            float gv = 0.0f, fv = 0.0f;
+            ggml_vec_dot_f32((int) rank, &gv, 0, (const float *) ((const char *) gain->data   + i*gain->nb[1]),   0, g.data(), 0, 1);
+            ggml_vec_dot_f32((int) rank, &fv, 0, (const float *) ((const char *) forget->data + i*forget->nb[1]), 0, g.data(), 0, 1);
+            const float tg = tanhf(gv);
+            const float tf = tanhf(fv);
+            const float a  = c[i] - tf*c[i];
+            o[i] = a + tg*m[i];
+        }
+    }
+}
+
+void ggml_compute_forward_loop_control(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_loop_control_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
