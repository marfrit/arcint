+// 0221: the loop controller's rule, switch, plan and constructor (ggml.h)
+const char * ggml_loop_control_refuse(const struct ggml_tensor * cur, const struct ggml_tensor * msg,
+                                      const struct ggml_tensor * down, const struct ggml_tensor * gain,
+                                      const struct ggml_tensor * forget) {
+    if (cur == NULL || msg == NULL || down == NULL || gain == NULL || forget == NULL) {
+        return "missing";
+    }
+    if (cur->type != GGML_TYPE_F32 || msg->type != GGML_TYPE_F32 || down->type != GGML_TYPE_F32 ||
+        gain->type != GGML_TYPE_F32 || forget->type != GGML_TYPE_F32) {
+        return "not-f32";
+    }
+    const int64_t n_embd = cur->ne[0];
+    const int64_t rank   = GGML_LOOP_CONTROL_RANK;
+    if (n_embd <= 0 || n_embd % 256 != 0) {
+        return "d-lanes";   // 16 K-split parts of a half, each a whole number of 16-wide chunks
+    }
+    if (cur->ne[1] < 1 || cur->ne[2] != 1 || cur->ne[3] != 1) {
+        return "cur-shape";
+    }
+    if (cur->nb[0] != sizeof(float) || cur->nb[1] < (size_t) n_embd*sizeof(float) || cur->nb[1] % sizeof(float) != 0) {
+        return "cur-stride";   // rows contiguous, any row step at or past a row
+    }
+    if (msg->ne[0] != n_embd || msg->ne[1] != cur->ne[1] || msg->ne[2] != 1 || msg->ne[3] != 1) {
+        return "msg-shape";
+    }
+    if (msg->nb[0] != sizeof(float) || msg->nb[1] < (size_t) n_embd*sizeof(float) || msg->nb[1] % sizeof(float) != 0) {
+        return "msg-stride";
+    }
+    if (down->ne[0] != 2*n_embd || down->ne[2] != 1 || down->ne[3] != 1) {
+        return "down-shape";
+    }
+    if (down->ne[1] != rank || gain->ne[0] != rank || forget->ne[0] != rank) {
+        return "rank";   // the kernel's lanes x 4 output columns of the down product
+    }
+    if (!ggml_is_contiguous(down)) {
+        return "down-stride";
+    }
+    if (gain->ne[1] != n_embd || gain->ne[2] != 1 || gain->ne[3] != 1 || !ggml_is_contiguous(gain)) {
+        return "gain-shape";
+    }
+    if (forget->ne[1] != n_embd || forget->ne[2] != 1 || forget->ne[3] != 1 || !ggml_is_contiguous(forget)) {
+        return "forget-shape";
+    }
+    return NULL;
+}
+
+int ggml_loop_control_mode(const char * env_value) {
+    if (env_value == NULL || strcmp(env_value, "0") == 0 || strcmp(env_value, "off") == 0) {
+        return 0;
+    }
+    if (strcmp(env_value, "bf16") == 0) {
+        return 2;
+    }
+    if (strcmp(env_value, "1") == 0 || strcmp(env_value, "f32") == 0 || strcmp(env_value, "all-layers") == 0) {
+        return 1;
+    }
+    return -1;   // not a value: the callers keep the arm off and say so (a mistyped "BF16" must not run f32)
+}
