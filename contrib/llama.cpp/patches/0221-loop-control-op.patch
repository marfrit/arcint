+// 0221: the loop controller's arm. GGML_OPENCL_LOOP_CONTROL set (ggml_loop_control_mode != 0)
+// emits one ggml_loop_control for a prompt batch (more than 8 rows) on a layer whose backend
+// declares the op (GGML_LOOP_CONTROL_CAPABILITY_PROC through its registry; the FA port's layer
+// guard, fa_port_layer_attaches): every other layer - the CPU, another GPU backend, a remote
+// one, no device - keeps the chain, so a CPU-only run with the knob set builds the graph it
+// builds without it. The value "all-layers" lifts the guard (the device-free knob-on check, the
+// CPU serving the op with its reference, and the guard's red). Unset, this is never reached and
+// the chain below is today's graph node for node.
+static int inkling2_loop_control_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_OPENCL_LOOP_CONTROL");
+        const int m = ggml_loop_control_mode(e);
+        if (m < 0) {
+            LLAMA_LOG_WARN("GGML_OPENCL_LOOP_CONTROL=%s is not a value (0, off, 1, f32, bf16, all-layers): the chain is emitted\n", e);
+            return 0;
+        }
+        return m;
+    }();
+    return mode;
+}
+static bool inkling2_loop_control_all_layers() {
+    static const bool all = ggml_loop_control_all_layers(getenv("GGML_OPENCL_LOOP_CONTROL"));
+    return all;
+}
+static bool inkling2_loop_control_layer_attaches(ggml_backend_dev_t dev) {
+    if (inkling2_loop_control_all_layers()) {
+        return true;
+    }
+    if (dev == nullptr) {
+        return false;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    return reg != nullptr && ggml_backend_reg_get_proc_address(reg, GGML_LOOP_CONTROL_CAPABILITY_PROC) != nullptr;
+}
+// a DOWNGRADE line a reason (and a device for the layer guard), the first few graph builds:
+// the first builds of a context (the memory-fit passes) run with the log off, as the FA port's
+static void inkling2_loop_control_refused(const void * gf, const std::string & key) {
+    static std::mutex said_mu;
+    static std::map<std::string, std::pair<const void *, int>> said;
+    bool say = false;
+    {
+        std::lock_guard<std::mutex> lock(said_mu);
+        auto & e = said[key];
+        if (e.first != gf && e.second < 6) {
+            e.first = gf; e.second++;
+            say = true;
+        }
+    }
+    if (say) {
+        LLAMA_LOG_WARN("DOWNGRADE src=llama op=LOOP_CONTROL path=chain %s\n", key.c_str());
+    }
+}
