+void ggml_loop_control_plan_make(const struct ggml_tensor * dst, int n_cores, struct ggml_loop_control_plan * plan) {
+    const struct ggml_tensor * cur    = dst->src[0];
+    const struct ggml_tensor * msg    = dst->src[1];
+    const struct ggml_tensor * down   = dst->src[2];
+    const struct ggml_tensor * gain   = dst->src[3];
+    const struct ggml_tensor * forget = dst->src[4];
+
+    plan->ne0  = (int) cur->ne[0];
+    plan->nt   = (int) cur->ne[1];
+    plan->rank = (int) down->ne[1];
+    plan->lsz  = GGML_LOOP_CONTROL_NSG*GGML_LOOP_CONTROL_SG;
+
+    // one work-group a core and one wave where the rows allow it (fill the waves): a work-group
+    // owns ceil(nt / cores) rows rounded up to 8, at most ROWS_MAX (its g store in local memory)
+    const int cores = n_cores > 0 ? n_cores : 1;
+    int rows = (plan->nt + cores - 1)/cores;
+    rows = (rows + 7)/8*8;
+    if (rows > GGML_LOOP_CONTROL_ROWS_MAX) {
+        rows = GGML_LOOP_CONTROL_ROWS_MAX;
+    }
+    plan->rows_wg = rows;
+    plan->n_wg    = (plan->nt + rows - 1)/rows;
+
+    // phase B hands (16-column group, row range) items round robin to the sub-groups: split the
+    // rows so that the item count is a multiple of NSG where a split of at most 4 reaches it
+    const int ngr = plan->ne0/16;
+    int rs = 1;
+    while (rs < 4 && (ngr*rs) % GGML_LOOP_CONTROL_NSG != 0) {
+        rs++;
+    }
+    if ((ngr*rs) % GGML_LOOP_CONTROL_NSG != 0) {
+        rs = ngr >= GGML_LOOP_CONTROL_NSG ? 1 : 2;
+    }
+    plan->rsplit = rs;
+
+    plan->nbc1 = cur->nb[1];
+    plan->nbm1 = msg->nb[1];
+    plan->nbd1 = dst->nb[1];
+    plan->nbw1 = down->nb[1];
+    plan->nbg1 = gain->nb[1];
+    plan->nbf1 = forget->nb[1];
+
+    const uint64_t row = (uint64_t) plan->ne0*sizeof(float);
+    plan->reach_cur    = (uint64_t) (plan->nt - 1)*plan->nbc1 + row;
+    plan->reach_msg    = (uint64_t) (plan->nt - 1)*plan->nbm1 + row;
+    plan->reach_dst    = (uint64_t) (plan->nt - 1)*plan->nbd1 + row;
+    plan->reach_down   = (uint64_t) (plan->rank - 1)*plan->nbw1 + 2*row;
+    plan->reach_gain   = (uint64_t) (plan->ne0 - 1)*plan->nbg1 + (uint64_t) plan->rank*sizeof(float);
+    plan->reach_forget = (uint64_t) (plan->ne0 - 1)*plan->nbf1 + (uint64_t) plan->rank*sizeof(float);
+
+    plan->local_floats = (uint64_t) rows*GGML_LOOP_CONTROL_RANK +
+                         (uint64_t) GGML_LOOP_CONTROL_NSG*GGML_LOOP_CONTROL_SG*16 +
+                         (uint64_t) GGML_LOOP_CONTROL_NSG*16;
+}
+
+struct ggml_tensor * ggml_loop_control(
+    struct ggml_context * ctx,
+    struct ggml_tensor  * cur,
+    struct ggml_tensor  * msg,
+    struct ggml_tensor  * down,
+    struct ggml_tensor  * gain,
+    struct ggml_tensor  * forget,
+    float                 eps) {
+    GGML_ASSERT(ggml_loop_control_refuse(cur, msg, down, gain, forget) == NULL);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cur->ne[0], cur->ne[1]);
+
+    ggml_set_op_params_f32(result, 0, eps);
+
+    result->op     = GGML_OP_LOOP_CONTROL;
+    result->src[0] = cur;
+    result->src[1] = msg;
+    result->src[2] = down;
+    result->src[3] = gain;
+    result->src[4] = forget;
+
+    return result;
+}
