+#ifdef GGML_OPENCL_EMBED_KERNELS
+        const std::string kernel_src {
+            #include "loop_control.cl.h"
+        };
+#else
+        const std::string kernel_src = read_file("loop_control.cl");
+#endif
+        const bool  bf16  = ggml_cl_loop_control_mode() == 2;
+        const char * extra = getenv("GGML_OPENCL_LOOP_CONTROL_OPTS");
+        const std::string opts = backend_ctx->kernel_compile_opts + " -cl-intel-256-GRF-per-thread" +
+                                 (bf16 ? " -DLC_BF16" : "") +
+                                 (extra != nullptr ? std::string(" ") + extra : std::string());
+        cl_program prog = build_program_from_source_optional(backend_ctx, kernel_src.c_str(), opts);
+        if (prog == nullptr) {
+            reason = "not-built";
+            GGML_LOG_WARN("ggml_opencl: loop_control.cl (%s) did not build; GGML_OP_LOOP_CONTROL stays on the CPU\n",
+                          bf16 ? "bf16" : "f32");
+        } else {
+            cl_int err;
+            cl_kernel k = clCreateKernel(prog, "kernel_loop_control", &err);
+            CL_CHECK(err);
+            CL_CHECK(clReleaseProgram(prog));
+            size_t wg = 0;
+            CL_CHECK(clGetKernelWorkGroupInfo(k, backend_ctx->device, CL_KERNEL_WORK_GROUP_SIZE, sizeof(wg), &wg, nullptr));
+            cl_ulong lmem = 0;
+            CL_CHECK(clGetDeviceInfo(backend_ctx->device, CL_DEVICE_LOCAL_MEM_SIZE, sizeof(lmem), &lmem, nullptr));
+            const size_t lsz  = GGML_LOOP_CONTROL_NSG*GGML_LOOP_CONTROL_SG;
+            const size_t need = ((size_t) GGML_LOOP_CONTROL_ROWS_MAX*GGML_LOOP_CONTROL_RANK +
+                                 (size_t) GGML_LOOP_CONTROL_NSG*GGML_LOOP_CONTROL_SG*16 +
+                                 (size_t) GGML_LOOP_CONTROL_NSG*16)*sizeof(float);
+            if (wg < lsz) {
+                reason = "wg-size";
+                GGML_LOG_WARN("ggml_opencl: kernel_loop_control takes %zu work-items a group, it needs %zu\n", wg, lsz);
+                CL_CHECK(clReleaseKernel(k));
+            } else if (lmem < need) {
+                reason = "local-mem";
+                GGML_LOG_WARN("ggml_opencl: kernel_loop_control needs %zu bytes of local memory, the device has %llu\n",
+                              need, (unsigned long long) lmem);
+                CL_CHECK(clReleaseKernel(k));
+            } else {
+                backend_ctx->kernel_loop_control = k;
+            }
+        }
+    }
+    if (why != nullptr) {
+        *why = reason;
+    }
+    return backend_ctx->kernel_loop_control;
+}
+
+static void ggml_cl_loop_control(ggml_backend_t backend, const ggml_tensor * cur, const ggml_tensor * msg, ggml_tensor * dst) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *)backend->context;
+
+    const ggml_tensor * down   = dst->src[2];
+    const ggml_tensor * gain   = dst->src[3];
+    const ggml_tensor * forget = dst->src[4];
+
+    // supports_op decided from shapes and strides; device storage is this call's invariant
+    GGML_ASSERT(cur->extra && msg->extra && down->extra && gain->extra && forget->extra && dst->extra);
+    GGML_ASSERT(ggml_loop_control_refuse(cur, msg, down, gain, forget) == nullptr);
+
+    ggml_tensor_extra_cl * ec = (ggml_tensor_extra_cl *) cur->extra;
+    ggml_tensor_extra_cl * em = (ggml_tensor_extra_cl *) msg->extra;
+    ggml_tensor_extra_cl * ew = (ggml_tensor_extra_cl *) down->extra;
+    ggml_tensor_extra_cl * eg = (ggml_tensor_extra_cl *) gain->extra;
+    ggml_tensor_extra_cl * ef = (ggml_tensor_extra_cl *) forget->extra;
+    ggml_tensor_extra_cl * ed = (ggml_tensor_extra_cl *) dst->extra;
+
+    const cl_ulong offc = ec->offset + cur->view_offs;
+    const cl_ulong offm = em->offset + msg->view_offs;
+    const cl_ulong offw = ew->offset + down->view_offs;
+    const cl_ulong offg = eg->offset + gain->view_offs;
+    const cl_ulong offf = ef->offset + forget->view_offs;
+    const cl_ulong offd = ed->offset + dst->view_offs;
+
+    // the geometry, strides and reaches: one pure function, shared with the host replay of
+    // loop_control.cl. One work-group a Xe core: Intel reports EUs as compute units, 8 a core
+    ggml_loop_control_plan plan;
+    ggml_loop_control_plan_make(dst, (int) std::max<cl_uint>(1, backend_ctx->fa.compute_units/8), &plan);
+
+    // always on, as the depth mix's: six host calls a launch, and a card fault is not a diagnosis
+    ggml_cl_bounds_always("loop control", "cur",    ec->data_device, (size_t) (offc + plan.reach_cur));
+    ggml_cl_bounds_always("loop control", "msg",    em->data_device, (size_t) (offm + plan.reach_msg));
+    ggml_cl_bounds_always("loop control", "down",   ew->data_device, (size_t) (offw + plan.reach_down));
+    ggml_cl_bounds_always("loop control", "gain",   eg->data_device, (size_t) (offg + plan.reach_gain));
+    ggml_cl_bounds_always("loop control", "forget", ef->data_device, (size_t) (offf + plan.reach_forget));
+    ggml_cl_bounds_always("loop control", "dst",    ed->data_device, (size_t) (offd + plan.reach_dst));
+
+    cl_kernel kernel = ggml_cl_loop_control_kernel(backend_ctx, nullptr);
+    GGML_ASSERT(kernel != nullptr);
+
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const cl_ulong nbc1 = plan.nbc1, nbm1 = plan.nbm1, nbw1 = plan.nbw1, nbg1 = plan.nbg1, nbf1 = plan.nbf1, nbd1 = plan.nbd1;
+    CL_CHECK(clSetKernelArg(kernel,  0, sizeof(cl_mem),   &ec->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  1, sizeof(cl_ulong), &offc));
+    CL_CHECK(clSetKernelArg(kernel,  2, sizeof(cl_ulong), &nbc1));
+    CL_CHECK(clSetKernelArg(kernel,  3, sizeof(cl_mem),   &em->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  4, sizeof(cl_ulong), &offm));
+    CL_CHECK(clSetKernelArg(kernel,  5, sizeof(cl_ulong), &nbm1));
+    CL_CHECK(clSetKernelArg(kernel,  6, sizeof(cl_mem),   &ew->data_device));
+    CL_CHECK(clSetKernelArg(kernel,  7, sizeof(cl_ulong), &offw));
+    CL_CHECK(clSetKernelArg(kernel,  8, sizeof(cl_ulong), &nbw1));
+    CL_CHECK(clSetKernelArg(kernel,  9, sizeof(cl_mem),   &eg->data_device));
+    CL_CHECK(clSetKernelArg(kernel, 10, sizeof(cl_ulong), &offg));
+    CL_CHECK(clSetKernelArg(kernel, 11, sizeof(cl_ulong), &nbg1));
+    CL_CHECK(clSetKernelArg(kernel, 12, sizeof(cl_mem),   &ef->data_device));
+    CL_CHECK(clSetKernelArg(kernel, 13, sizeof(cl_ulong), &offf));
+    CL_CHECK(clSetKernelArg(kernel, 14, sizeof(cl_ulong), &nbf1));
+    CL_CHECK(clSetKernelArg(kernel, 15, sizeof(cl_mem),   &ed->data_device));
+    CL_CHECK(clSetKernelArg(kernel, 16, sizeof(cl_ulong), &offd));
+    CL_CHECK(clSetKernelArg(kernel, 17, sizeof(cl_ulong), &nbd1));
+    CL_CHECK(clSetKernelArg(kernel, 18, sizeof(int),      &plan.ne0));
+    CL_CHECK(clSetKernelArg(kernel, 19, sizeof(int),      &plan.nt));
+    CL_CHECK(clSetKernelArg(kernel, 20, sizeof(int),      &plan.rows_wg));
+    CL_CHECK(clSetKernelArg(kernel, 21, sizeof(int),      &plan.rsplit));
+    CL_CHECK(clSetKernelArg(kernel, 22, sizeof(float),    &eps));
+    CL_CHECK(clSetKernelArg(kernel, 23, (size_t) plan.local_floats*sizeof(float), nullptr));
+
+    size_t global_work_size[] = { (size_t) plan.n_wg*plan.lsz, 1, 1 };
+    size_t local_work_size[]  = { (size_t) plan.lsz, 1, 1 };
+
+    static bool taken_told = false;
+    if (!taken_told) {
+        taken_told = true;
+        GGML_LOG_INFO("loop_control: TAKEN opencl %s one-launch rows_wg=%d n_wg=%d\n",
+                      ggml_cl_loop_control_mode() == 2 ? "bf16" : "f32", plan.rows_wg, plan.n_wg);
+    }
+    backend_ctx->loop_control_calls_graph++;
+
+    backend_ctx->enqueue_ndrange_kernel(kernel, 3, global_work_size, local_work_size, dst);
+}
