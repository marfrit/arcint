+// a view stays inside its source over the bytes its strides actually reach (ggml_nbytes), not over
+// a contiguous tensor of its shape; size_t arithmetic, an overflowing sum is out of bounds
+// view_src and view_offs are ggml's root source and the offset into it: for the conv windows that
+// is conv_x itself today (a fresh concat); were conv_x a view, the bound would be its root's bytes
+bool llm_graph_view_in_source(const ggml_tensor * view) {
+    const ggml_tensor * src = view->view_src;
+    if (src == nullptr) {
+        return false;
+    }
+    const size_t n_view = ggml_nbytes(view);
+    const size_t n_src  = ggml_nbytes(src);
+    return n_view <= n_src && view->view_offs <= n_src - n_view;
+}
