+// ggml_compute_forward_norm_clip
+
+// the unfused chain reads: mul (per-channel), sqr, sum_rows, sqrt, scale_bias(1, eps),
+// fill, div, clamp, mul. same order here, so a graph that emits it stays bit-identical.
+static void ggml_compute_forward_norm_clip_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    const float threshold = ggml_get_op_params_f32(dst, 0);
+    const float eps       = ggml_get_op_params_f32(dst, 1);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int n  = ggml_nrows(src0);
+    const int nc = src0->ne[0];
+
+    GGML_TENSOR_UNARY_OP_LOCALS
+
+    GGML_ASSERT( nb0 == sizeof(float));
+    GGML_ASSERT(nb00 == sizeof(float));
+    const size_t nb10_s1 = src1 ? src1->nb[0] : 0;
+    const size_t nb11_s1 = src1 ? src1->nb[1] : 0;
+    GGML_ASSERT(!src1 || (nb10_s1 == sizeof(float) && src1->ne[0] == ne00));
+
+    const int64_t ne11 = src1 ? src1->ne[1] : 1;
+
+    for (int j = ith; j < n; j += nth) {
+        const int64_t i1 = j % ne01;
+        const int64_t i2 = (j / ne01) % ne02;
+        const int64_t i3 = j / (ne01*ne02);
+
+        const float * src0_ptr = (const float *) ((const char *) src0->data + i1*nb01 + i2*nb02 + i3*nb03);
+        const float * src1_ptr = src1 ? (const float *) ((const char *) src1->data + (i1 % ne11)*nb11_s1) : NULL;
+        float * dst_ptr = (float *) ((char *) dst->data + i1*nb1 + i2*nb2 + i3*nb3);
+
+        // sum_rows accumulates in wide precision and rounds once
+        ggml_float sum = 0.0;
+        for (int i = 0; i < nc; i++) {
+            float v = src0_ptr[i];
+            if (src1_ptr) {
+                v *= src1_ptr[i];
+            }
+            const float sq = v*v;
+            sum += (ggml_float) sq;
+        }
+
+        float norm = sqrtf((float) sum);
+        norm = norm*1.0f + eps;
+        float factor = threshold / norm;
+        factor = MAX(MIN(factor, 1.0f), 0.0f);
+
+        for (int i = 0; i < nc; i++) {
+            float v = src0_ptr[i];
+            if (src1_ptr) {
+                v *= src1_ptr[i];
+            }
+            dst_ptr[i] = v*factor;
+        }
+    }
+}
+
+void ggml_compute_forward_norm_clip(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_norm_clip_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
