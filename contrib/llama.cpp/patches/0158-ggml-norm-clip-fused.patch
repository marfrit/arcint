diff --git a/ggml/src/ggml-opencl/kernels/norm_clip.cl b/ggml/src/ggml-opencl/kernels/norm_clip.cl
new file mode 100644
index 0000000..c344b26
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/norm_clip.cl
@@ -0,0 +1,80 @@
+//------------------------------------------------------------------------------
+// norm_clip
+//------------------------------------------------------------------------------
+// one work-group a row: per-channel scale, the row sum of squares in a fixed
+// order, min(1, threshold/norm), the multiply. same order as the unfused chain.
+#define NORM_CLIP_LS 32
+
+kernel void kernel_norm_clip_f32(
+        global char * src0,
+        ulong         offset0,
+        ulong         nb01,
+        ulong         nb02,
+        ulong         nb03,
+        global char * src1,
+        ulong         offset1,
+        ulong         nb11,
+        int           has_scale,
+        global char * dst,
+        ulong         offsetd,
+        ulong         nb1,
+        ulong         nb2,
+        ulong         nb3,
+        int           ne0,
+        int           ne1,
+        int           ne2,
+        int           ne3,
+        float         threshold,
+        float         eps
+) {
+    src0 = src0 + offset0;
+    dst  = dst  + offsetd;
+
+    const int row = get_group_id(0);
+    const int i1 = row % ne1;
+    const int i2 = (row / ne1) % ne2;
+    const int i3 = row / (ne1*ne2);
+
+    global const float * x = (global const float *)(src0 + i3*nb03 + i2*nb02 + i1*nb01);
+    global       float * y = (global       float *)(dst  + i3*nb3  + i2*nb2  + i1*nb1);
+
+    global const float * s = 0;
+    if (has_scale) {
+        s = (global const float *)(src1 + offset1 + i1*nb11);
+    }
+
+    const int lane = get_local_id(0);
+    __local float red[NORM_CLIP_LS];
+
+    float ss = 0.0f;
+    for (int i = lane; i < ne0; i += NORM_CLIP_LS) {
+        float v = x[i];
+        if (has_scale) {
+            v *= s[i];
+        }
+        ss += v*v;
+    }
+
+    red[lane] = ss;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int st = NORM_CLIP_LS/2; st > 0; st >>= 1) {
+        if (lane < st) {
+            red[lane] += red[lane + st];
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+
+    float norm = sqrt(red[0]);
+    norm = norm*1.0f + eps;
+    float factor = threshold / norm;
+    factor = min(factor, 1.0f);
+    factor = max(factor, 0.0f);
+
+    for (int i = lane; i < ne0; i += NORM_CLIP_LS) {
+        float v = x[i];
+        if (has_scale) {
+            v *= s[i];
+        }
+        y[i] = v*factor;
+    }
+}
