diff --git a/ggml/src/ggml-opencl/ggml-opencl-staging.h b/ggml/src/ggml-opencl/ggml-opencl-staging.h
new file mode 100644
index 0000000..d3157b2
--- /dev/null
+++ b/ggml/src/ggml-opencl/ggml-opencl-staging.h
@@ -0,0 +1,28 @@
+// 0078: the graph-input staging bound.
+//
+// Patch 0047 stages a graph input into a USM host ring and enqueues the write
+// without a wait; the ring is reused after a `clFinish` when it wraps. Patch
+// 0078 removes the old 4 MiB refusal only where both bounds hold: the write is
+// the scheduler's graph-input copy (not a checkpoint restore or a state read,
+// which stay blocking) and the whole input fits the ring's free space without a
+// wrap. Anything else returns false and takes the blocking write; a checkpoint
+// restore is in that class and its timing is a card arm owed before the bound is
+// called equivalent (DESIGN §3.4). An input larger than the ring is never split:
+// a split means a `clFinish` a wrap inside the write and a host memcpy where one
+// DMA was. A copy larger than the ring returns before the wrap test, so it does
+// not pay a pointless `clFinish`.
+//
+// `ggml_cl_stage_fits` is the ring bound the caller asks before it touches the
+// ring; a plan is not needed, the write is one `clEnqueueWriteBuffer` of the
+// whole input as 0047 did.
+#ifndef GGML_OPENCL_STAGING_H
+#define GGML_OPENCL_STAGING_H
+
+#include <cstddef>
+
+// whether an aligned `span` fits at `head` in a `ring` (an exact fit does)
+static inline bool ggml_cl_stage_fits(size_t head, size_t span, size_t ring) {
+    return span <= ring && head <= ring && span <= ring - head;
+}
+
+#endif  // GGML_OPENCL_STAGING_H
