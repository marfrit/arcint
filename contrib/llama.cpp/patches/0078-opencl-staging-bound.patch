-// (patch 0047). The ring is reused after a clFinish when it wraps.
+// A write into a buffer that holds no weights (a graph's inputs: positions,
+// masks, ids): the bytes copied into a USM host ring and the copy enqueued
+// without a wait, so the caller may reuse `data` at once. A blocking write cost
+// ~10.4 us an input on the B60 against ~4.1 staged (patch 0047). The ring is
+// reused after a clFinish when it wraps. Patch 0078: the staging is for the
+// scheduler's graph-input copy only (the thread-local marker) and only when the
+// whole input fits the ring's free space without a wrap; anything else -- an
+// input larger than the ring, a checkpoint restore, a state read -- takes the
+// blocking write, as 0047 did above 4 MiB. GGML_OPENCL_STAGE_MB sets the ring,
+// default 32 MiB.
 // One thread writes a context's tensors (the ring head is not atomic).
 static bool ggml_cl_stage_write(ggml_backend_opencl_context * ctx, ggml_backend_buffer_t buffer, cl_mem dst, size_t off,
                                 const void * data, size_t size) {
-    if (size == 0 || size > (4u << 20) || ggml_backend_buffer_get_usage(buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+    if (size == 0 || ggml_backend_buffer_get_usage(buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
         return false;
     }
+    if (!ggml_backend_sched_input_copy_active()) {
+        return false;   // a restore or a state read: the old blocking write
+    }
     if (ctx->stage_on < 0) {
         const char * e = getenv("GGML_OPENCL_STAGE_INPUTS");
         ctx->stage_on = (e == nullptr || atoi(e) != 0) && ctx->usm_host_alloc != nullptr && ctx->usm_mem_free != nullptr;
         if (ctx->stage_on) {
+            size_t mb = 32;
+            const char * m = getenv("GGML_OPENCL_STAGE_MB");
+            if (m != nullptr && atoi(m) >= 8 && atoi(m) <= 1024) {
+                mb = (size_t) atoi(m);   // patch 0078: the ring, 8..1024 MiB
+            }
             cl_int err = CL_SUCCESS;
-            ctx->stage_size = 32u << 20;
+            ctx->stage_size = mb << 20;
             ctx->stage_ring = (char *) ctx->usm_host_alloc(ctx->context, NULL, ctx->stage_size, 128, &err);
             if (ctx->stage_ring == nullptr || err != CL_SUCCESS) {
                 ctx->stage_ring = nullptr;
@@ -12393,8 +12407,13 @@ static bool ggml_cl_stage_write(ggml_backend_opencl_context * ctx, ggml_backend_
         return false;
     }
     const size_t a = (size + 127) & ~(size_t) 127;
-    if (ctx->stage_head + a > ctx->stage_size) {
-        CL_CHECK(clFinish(ctx->queue));   // every staged copy has landed
+    if (a > ctx->stage_size) {
+        return false;   // larger than the ring: one blocking DMA instead of a split
+    }
+    if (!ggml_cl_stage_fits(ctx->stage_head, a, ctx->stage_size)) {
+        // a wrap before this write is the 0047 reuse, not a split: every
+        // staged copy has landed, the ring starts over
+        CL_CHECK(clFinish(ctx->queue));
         ctx->stage_head = 0;
     }
     char * p = ctx->stage_ring + ctx->stage_head;
