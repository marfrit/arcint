diff --git a/tests/test-opencl-staging.cpp b/tests/test-opencl-staging.cpp
new file mode 100644
index 0000000..f963a8d
--- /dev/null
+++ b/tests/test-opencl-staging.cpp
@@ -0,0 +1,96 @@
+// 0078: device-free tests for the graph-input staging bound.
+//   - the ring bound: a whole input fits exactly at the head, a smaller one fits
+//     anywhere before the end, an input larger than the ring or overrunning the
+//     head does not. The write is one DMA for the whole input; a split (the old
+//     0078 chunks, a clFinish a wrap and a 200 MiB host memcpy) is absent.
+//   - the caller rule: ggml-opencl.cpp stages only when the scheduler's
+//     thread-local graph-input marker is on and only when the whole input fits;
+//     the old 4 MiB refusal is gone, so a restore or a state read (the marker
+//     off) takes the blocking write.
+//   - the marker in ggml-backend.cpp/h: begin/end/active around
+//     ggml_backend_sched_copy_input, thread-local.
+// No GPU, no OpenCL runtime.
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "ggml-opencl-staging.h"
+
+static int g_bad = 0;
+#define CHECK(cond, what) do { if (!(cond)) { std::printf("FAIL: %s\n", what); ++g_bad; } } while (0)
+
+static void check_fits(void) {
+    const size_t ring = 32u << 20;
+    CHECK(ggml_cl_stage_fits(0, ring, ring), "a whole ring's input fits at the start");
+    CHECK(ggml_cl_stage_fits(0, 4u << 20, ring), "4 MiB fits");
+    CHECK(ggml_cl_stage_fits(ring - (4u << 20), 4u << 20, ring), "an exact end-fit is allowed");
+    CHECK(!ggml_cl_stage_fits(ring, 1, ring), "nothing fits at the end");
+    CHECK(!ggml_cl_stage_fits(ring - 16, 32, ring), "an overrun does not fit");
+    CHECK(!ggml_cl_stage_fits(0, ring + 1, ring), "an input larger than the ring does not fit");
+    CHECK(!ggml_cl_stage_fits(0, 1, 0), "an empty ring fits no bytes");
+}
+
+static void check_staging_sites(const std::string & src) {
+    CHECK(src.find("#include \"ggml-opencl-staging.h\"") != std::string::npos,
+          "ggml-opencl.cpp includes the bound");
+    CHECK(src.find("ggml_backend_sched_input_copy_active()") != std::string::npos,
+          "staging asks the scheduler's graph-input marker");
+    // one ask after the explicit larger-than-the-ring return: the reuse wrap
+    // before the write; the old second size ask is gone with the wrap test
+    int asks = 0;
+    for (size_t at = 0; (at = src.find("ggml_cl_stage_fits(ctx->stage_head", at)) != std::string::npos; at += 1) {
+        ++asks;
+    }
+    CHECK(asks == 1, "the ring bound is asked once, after the explicit size check");
+    CHECK(src.find("size > (4u << 20)") == std::string::npos, "the old 4 MiB refusal is gone");
+    const size_t big   = src.find("if (a > ctx->stage_size)");
+    const size_t flush = src.find("CL_CHECK(clFinish(ctx->queue));");
+    CHECK(big != std::string::npos && flush != std::string::npos && big < flush,
+          "a copy larger than the ring does not finish the ring");
+    CHECK(src.find("clEnqueueWriteBuffer(ctx->queue, dst, CL_FALSE, off, size, p") != std::string::npos,
+          "the staged write is one DMA of the whole input");
+    // a chunk loop would be an input split: none in the staging write
+    CHECK(src.find("for (size_t done") == std::string::npos &&
+              src.find("GGML_OPENCL_STAGE_CHUNK") == std::string::npos,
+          "no split of an input above the ring");
+}
+
+static void check_marker(const std::string & hdr, const std::string & src) {
+    CHECK(hdr.find("ggml_backend_sched_input_copy_begin") != std::string::npos &&
+              hdr.find("ggml_backend_sched_input_copy_active") != std::string::npos,
+          "ggml-backend.h declares the marker");
+    CHECK(src.find("static thread_local int g_input_copy_depth") != std::string::npos,
+          "the marker is thread-local");
+    CHECK(src.find("input_copy_guard") != std::string::npos,
+          "the marker is held by a guard around the input copy");
+    const size_t copy = src.find("static void ggml_backend_sched_copy_input(");
+    const size_t guard = src.find("input_copy_guard", copy);
+    CHECK(copy != std::string::npos && guard != std::string::npos && guard - copy < 500,
+          "the guard is at the input copy's entry");
+}
+
+int main() {
+    check_fits();
+    const char * files[] = { GGML_OPENCL_SRC_PATH, GGML_BACKEND_SRC_PATH, GGML_BACKEND_HDR_PATH };
+    std::vector<std::string> text;
+    for (const char * p : files) {
+        std::ifstream f(p);
+        if (!f) {
+            std::printf("FAIL: cannot open %s\n", p);
+            ++g_bad;
+            text.emplace_back();
+            continue;
+        }
+        text.emplace_back((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    }
+    check_staging_sites(text[0]);
+    check_marker(text[2], text[1]);
+    if (g_bad) {
+        std::printf("test-opencl-staging: %d failure(s)\n", g_bad);
+        return 1;
+    }
+    std::printf("test-opencl-staging: ok\n");
+    return 0;
+}
