+// 0199: what a card run of `-o FLASH_ATTN_EXT` must report for the port's eval cases, so a
+// window can assert equality instead of reading "0 FAIL" (a case that never ran is not a
+// pass). test_fa_port_decisions() checks these numbers against the case list itself.
+//
+//   class                                  cases | GGML_OPENCL_FA_PORT=1     | knob unset
+//   port=1, pad_bias=0 (the port's cases)     10 | RUN 10, not supported 0   | RUN 0, not supported 10
+//   port=1, pad_bias=2.5 (the pad case)        1 | RUN 1                     | not supported 1
+//   port=2, pad_bias=0 (the twins)             4 | RUN 4                     | RUN 4
+//   port=2, pad_bias=2.5 (the pad's twin)      1 | RUN 1                     | RUN 1
+//
+// The port=1 rows are the port's contract (the card: 11 run with the knob, 0 not supported,
+// the pad case among them; 11 not supported without it). The port=2 rows are today's
+// indexed-bias dispatch on the same data, whatever the knob: a "not supported" there is
+// that dispatch declining a shape of its own, to be reported as such. The first form of
+// this table gave the twins as one row of 5; the card's count of 4 is the pad_bias=0 row.
+static const int FA_PORT_EVAL_PORT1     = 11;
+static const int FA_PORT_EVAL_PORT1_PAD = 1;
+static const int FA_PORT_EVAL_PORT2     = 5;       // 4 with pad_bias=0 and the pad's twin
+static const int FA_PORT_EVAL_PORT2_PAD = 1;
+
+static std::vector<std::unique_ptr<test_case>> make_test_cases_eval();
+
+// 0199: GGML_TEST_FA_PORT_DECISIONS=1 (no device needed): every port=1 eval case's op goes
+// through the supports_op decision and through the launch-time decision - the same pure
+// gate (fa_port_gate.h), on the op as the launch is handed it - and any disagreement, or
+// any refusal of a case the table above says the card must run, fails.
+// GGML_TEST_FA_PORT_ROUTE_RED=1 asks the launch question in the dispatch order before the
+// fix (the 9 to 64-row block split ahead of the port): the three short cases must then FAIL.
+static bool test_fa_port_decisions() {
+    const bool red = getenv("GGML_TEST_FA_PORT_ROUTE_RED") != nullptr;
+    auto cases = make_test_cases_eval();
+    int n1 = 0, n1_pad = 0, n2 = 0, n2_pad = 0, n_fail = 0;
+    for (auto & tc : cases) {
+        auto * fa = dynamic_cast<test_flash_attn_ext *>(tc.get());
+        if (fa == nullptr || fa->port == 0) {
+            continue;
+        }
+        if (fa->port == 2) {
+            n2++; n2_pad += fa->pad_bias != 0.0f;
+            continue;
+        }
+        n1++; n1_pad += fa->pad_bias != 0.0f;
+        ggml_init_params params = { ggml_tensor_overhead()*64 + ggml_graph_overhead(), NULL, true };
+        ggml_context * ctx = ggml_init(params);
+        ggml_tensor * op = fa->build_graph(ctx);
+        bool ok = fa_port_carries(op) != 0;
+        const char * ws = "", * wl[2] = { "", "" };
+        const int sup = fa_port_gate_op(op, 4096, 256, 1, &ws);
+        int lau[2];
+        for (int gqa_wide = 0; gqa_wide < 2; ++gqa_wide) {
+            lau[gqa_wide] = fa_port_gate_at_launch(op, red ? 0 : 1, gqa_wide, 1, 4096, 256, 1, &wl[gqa_wide]);
+            ok = ok && sup != 0 && lau[gqa_wide] == sup;
+        }
+        printf("  kv=%lld nb=%lld wrap=%d window=%d n_empty=%lld pad_bias=%g: supports_op %s%s | launch %s%s (wide verify: %s%s): %s\n",
+               (long long) fa->kv, (long long) fa->nb, fa->wrap, fa->window, (long long) fa->n_empty, (double) fa->pad_bias,
+               sup ? "ACCEPT" : "refuse ", sup ? "" : ws, lau[0] ? "ACCEPT" : "refuse ", lau[0] ? "" : wl[0],
+               lau[1] ? "ACCEPT" : "refuse ", lau[1] ? "" : wl[1], ok ? "OK" : "FAIL");
+        n_fail += !ok;
+        ggml_free(ctx);
+    }
+    const bool counts = n1 == FA_PORT_EVAL_PORT1 && n1_pad == FA_PORT_EVAL_PORT1_PAD &&
+                        n2 == FA_PORT_EVAL_PORT2 && n2_pad == FA_PORT_EVAL_PORT2_PAD;
+    printf("  eval cases: port=1 %d (pad %d), port=2 %d (pad %d): %s\n", n1, n1_pad, n2, n2_pad,
+           counts ? "as the table says" : "FAIL, the table above is stale");
+    printf("  port decisions%s: %s\n", red ? " (the old dispatch order)" : "", n_fail == 0 && counts ? "OK" : "FAIL");
+    return n_fail == 0 && counts;
+}
