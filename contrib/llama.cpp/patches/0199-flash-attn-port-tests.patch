+// 0199: GGML_TEST_FA_PORT_TWINS=1: a port case (port=1) and its twins (port=2, both layouts)
+// must build the same mask and compute the same attention on the given backend - the CPU,
+// which reads either table layout and either sink. It proves the like-for-like perf pairs
+// are the same problem, not that any kernel is right.
+static bool test_fa_port_twins(ggml_backend_t backend) {
+    auto run = [&](test_flash_attn_ext & tc, std::vector<float> & out, std::vector<uint8_t> & mask) {
+        ggml_init_params params = { ggml_tensor_overhead()*64 + ggml_graph_overhead(), NULL, true };
+        ggml_context * ctx = ggml_init(params);
+        ggml_tensor * o = tc.build_graph(ctx);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, o);
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf != nullptr);
+        tc.initialize_tensors(ctx);
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+        out.resize(ggml_nelements(o));
+        ggml_backend_tensor_get(o, out.data(), 0, ggml_nbytes(o));
+        ggml_tensor * m = ggml_get_tensor(ctx, "m");
+        mask.resize(ggml_nbytes(m));
+        ggml_backend_tensor_get(m, mask.data(), 0, mask.size());
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+    };
+    int n_fail = 0;
+    for (auto c : std::vector<std::array<int64_t, 5>>{
+            { 1536, 512, 0, 1024, 0 }, { 2048, 2048, 0, 1024, 0 }, { 3072, 2048, 0, 1024, 0 },
+            { 4096, 512, 0, 0, 2560 }, { 1536, 512, 2, 1024, 0 }, { 160, 12, 0, 0, 60 },
+            { 2200, 24, 0, 0, 0 } /* with a pad bin of 2.5 */ }) {
+        std::vector<float> out[3];
+        std::vector<uint8_t> mask[3];
+        for (int i = 0; i < 3; ++i) {
+            const bool model_layout = i < 2;
+            test_flash_attn_ext tc(128, 128, 8, {3, 1}, c[0], c[1], true, true, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16,
+                                   model_layout ? std::array<int32_t, 4>{0, 2, 1, 3} : std::array<int32_t, 4>{0, 1, 2, 3},
+                                   !model_layout, false, 0, true, 1025, false,
+                                   i == 0 ? 1 : 2, (int32_t) c[2], (int32_t) c[3], c[4], c[0] == 2200 ? 2.5f : 0.0f);
+            run(tc, out[i], mask[i]);
+        }
+        for (int i = 1; i < 3; ++i) {
+            double num = 0.0, den = 0.0;
+            for (size_t e = 0; e < out[0].size(); ++e) {
+                const double d = (double) out[i][e] - out[0][e];
+                num += d*d; den += (double) out[0][e]*out[0][e];
+            }
+            const bool same_mask = mask[i] == mask[0];
+            const double nmse = den > 0.0 ? num/den : 1.0;
+            // the same attention up to rounding: the twin's bins carry bias - sink (magnitude
+            // ~10 against the port's ~4), and the CPU kernel rounds scores through f16
+            const bool ok = same_mask && out[i].size() == out[0].size() && nmse < 1e-5;
+            printf("  twin kv=%lld nb=%lld wrap=%lld window=%lld n_empty=%lld %s: mask %s, nmse %.3g vs the port case: %s\n",
+                   (long long) c[0], (long long) c[1], (long long) c[2], (long long) c[3], (long long) c[4],
+                   i == 1 ? "model layout" : "contiguous, kv view", same_mask ? "identical" : "DIFFERS", nmse, ok ? "OK" : "FAIL");
+            n_fail += !ok;
+        }
+    }
+    printf("  port twins: %s\n", n_fail ? "FAIL" : "OK");
+    return n_fail == 0;
+}
