+// 0223: GGML_TEST_FA_PORT_SEAM=1 (the CPU backend; no device): what a lost seam block does to each split
+// case. The kernel's RED=13 skips the first 32-key block of every split >= 1; here those cells are taken as
+// empty (the same keys missing) and the CPU's answer is compared with the case's own, at the split the
+// rule gives on the B60 (200) and the B70 (320). The red is visible only if that NMSE is above the case's
+// bound: each must be, by a factor of at least 10, or the check fails (the case is too blunt for the red).
+static bool test_fa_port_seam(ggml_backend_t backend) {
+    auto run = [&](test_flash_attn_ext & tc, std::vector<float> & out) {
+        ggml_init_params params = { ggml_tensor_overhead()*64 + ggml_graph_overhead(), NULL, true };
+        ggml_context * ctx = ggml_init(params);
+        ggml_tensor * o = tc.build_graph(ctx);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, o);
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf != nullptr);
+        tc.initialize_tensors(ctx);
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+        out.resize(ggml_nelements(o));
+        ggml_backend_tensor_get(o, out.data(), 0, ggml_nbytes(o));
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+    };
+    int n_fail = 0, n_run = 0;
+    auto cases = make_test_cases_eval();
+    for (auto & c : cases) {
+        auto * fa = dynamic_cast<test_flash_attn_ext *>(c.get());
+        if (fa == nullptr || fa->split_case == 0) continue;
+        std::vector<float> ref;
+        test_flash_attn_ext base(128, 128, fa->nh, fa->nr23, fa->kv, fa->nb, true, true, 0, 0, GGML_PREC_F32, fa->type_K, fa->type_V,
+                                 fa->permute, false, false, 0, true, fa->n_bins, false, 1, fa->wrap, fa->window, fa->n_empty, fa->pad_bias, 1);
+        run(base, ref);
+        for (int wave : { 200, 320 }) {
+            const int p = fa_port_splits(fa->nh * ((fa->nb + 7) / 8), wave, fa->kv, fa->window, 0, 0, 0);
+            const int64_t sb = fa_port_split_blocks(fa->kv, p);
+            test_flash_attn_ext red(128, 128, fa->nh, fa->nr23, fa->kv, fa->nb, true, true, 0, 0, GGML_PREC_F32, fa->type_K, fa->type_V,
+                                    fa->permute, false, false, 0, true, fa->n_bins, false, 1, fa->wrap, fa->window, fa->n_empty, fa->pad_bias, 1);
+            for (int sp = 1; sp < p; ++sp) red.hide_cells.push_back({ sp * sb * 32, sp * sb * 32 + 32 });
+            std::vector<float> out;
+            run(red, out);
+            double num = 0.0, den = 0.0;
+            for (size_t e = 0; e < ref.size(); ++e) { const double d = (double) out[e] - ref[e]; num += d*d; den += (double) ref[e]*ref[e]; }
+            const double nmse = den > 0.0 ? num/den : 0.0, bound = base.max_nmse_err();
+            const bool ok = nmse >= 10.0 * bound;
+            printf("  seam %s kv=%lld nb=%lld n_empty=%lld wave %d p %d: a lost seam block moves the answer by nmse %.3g, bound %.3g: %s\n",
+                   ggml_type_name(fa->type_K), (long long) fa->kv, (long long) fa->nb, (long long) fa->n_empty, wave, p, nmse, bound,
+                   ok ? "visible" : "FAIL, under 10x the bound");
+            n_fail += !ok; n_run++;
+        }
+    }
+    printf("  port seam: %d cells, %s\n", n_run, n_fail ? "FAIL" : "OK");
+    return n_fail == 0 && n_run == 12;
+}
