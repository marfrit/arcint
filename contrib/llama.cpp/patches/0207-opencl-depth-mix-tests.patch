+// 0207: Inkling 2 Mini's depth mix at the shapes its prefill graph hands it, read off the
+// exported graph (test-export-graph-ops, c 4096, fa on, ub 512/1024/2048). The lines that
+// fix each shape, by node name:
+//   node_91 / node_1108 / node_2118 / node_8944 (RMS_NORM): the states view of the main
+//     block store, [2304, 2..5, T] at nb[1] 9216, nb[2] 46080 - a 5-row store, k = 1..4;
+//   node_3060 (RMS_NORM): the loop model's bank store, [2304, 2, T] at nb[2] 18432 - a
+//     2-row store, k = 1;
+//   node_95 .. node_9639 (MUL_MAT states x queries): nq 1 and 3 on the main store, and
+//     node_3064: nq 4 (the loop's four messages) on the bank store;
+//   "leaf_26 (view) (copy of node_12 (reshaped))" (CPY): cur is [2304, T], nb[1] 9216.
+// The tensors are built with the constructors the model uses (a view_3d of the store, a
+// reshape_2d of a 1-D weight), so ne, nb and the view offsets are the graph's. The folded
+// norm is the model's too: a 1-D weight through reshape_2d, on the nq 1 calls.
+// `cols` adds the readers of the result's columns as the model has them (a contiguous
+// view a column, then an RMS norm): the loop's message() and the full-attention inputs.
+struct test_depth_mix : public test_case {
+    const int64_t n_slot;  // the store's rows: 5 (the main store) or 2 (the loop's bank)
+    const int64_t k;       // block rows
+    const int64_t nt;      // tokens
+    const int64_t nq;      // query columns
+    const bool with_norm;
+    const bool cols;
+
+    std::string vars() override {
+        return VARS_TO_STR6(n_slot, k, nt, nq, with_norm, cols);
+    }
+
+    // the bound of the card's op cases, stated before the card run (README 0204-0207): 1e-10,
+    // a thousand times tighter than the tool's 1e-7. The kernel's arithmetic is the CPU op's in
+    // fp32 with the device's exp and rsqrt; the worst of those priced at ~1e-12, and every
+    // defect this arm has had sat at 1e-2 or above
+    double max_nmse_err() override {
+        return 1e-10;
+    }
+
+    // the `cols` cases end in the columns' readers: they stay under -o DEPTH_MIX
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "DEPTH_MIX";
+    }
+
+    test_depth_mix(int64_t n_slot = 5, int64_t k = 4, int64_t nt = 512, int64_t nq = 1, bool with_norm = false, bool cols = false)
+        : n_slot(n_slot), k(k), nt(nt), nq(nq), with_norm(with_norm), cols(cols) {}
+
+    // the store at a different scale a row and cur at a third, so each state's 1/rms matters:
+    // with equal scales a mix of raw states differs from the mix of normalized ones by a
+    // global factor only, which the folded norm hides
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 gen(4201);
+        std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "stack") == 0) {
+                std::vector<float> data((size_t) ggml_nelements(t));
+                size_t i = 0;
+                for (int64_t tok = 0; tok < t->ne[2]; ++tok) {
+                    for (int64_t row = 0; row < t->ne[1]; ++row) {
+                        const float amp = 0.25f*(float) (1 << (row % 5));   // 0.25 .. 4
+                        for (int64_t e = 0; e < t->ne[0]; ++e) {
+                            data[i++] = amp*dist(gen);
+                        }
+                    }
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+            } else if (strcmp(t->name, "blocks") == 0) {
+                // a view of the store: its rows are set
+            } else if (strcmp(t->name, "cur") == 0) {
+                init_tensor_uniform(t, -3.0f, 3.0f);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t n_embd = 2304;
+
+        ggml_tensor * stack = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, n_slot, nt);
+        ggml_set_name(stack, "stack");
+
+        // mix(): the k block rows end one row before the store's last (cur's row in the chain)
+        ggml_tensor * blocks = ggml_view_3d(ctx, stack, n_embd, k, nt,
+                stack->nb[1], stack->nb[2], (size_t) ((n_slot - 1) - k)*stack->nb[1]);
+        ggml_set_name(blocks, "blocks");
+
+        ggml_tensor * cur = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nt);
+        ggml_set_name(cur, "cur");
+
+        ggml_tensor * q = nq == 1
+            ? ggml_reshape_2d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd), n_embd, 1)
+            : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nq);
+        ggml_set_name(q, "queries");
+
+        ggml_tensor * nw = nullptr;
+        if (with_norm) {
+            nw = nq == 1
+                ? ggml_reshape_2d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd), n_embd, 1)
+                : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, nq);
+            ggml_set_name(nw, "norm_w");
+        }
+
+        ggml_tensor * out = ggml_depth_mix(ctx, blocks, cur, q, nw, 1e-6f, 1e-5f, 1.0f/sqrtf((float) n_embd));
+        ggml_set_name(out, "out");
+
+        if (cols) {
+            // every column read as the model reads it, normed, and summed into one result
+            ggml_tensor * acc = nullptr;
+            for (int64_t c = 0; c < nq; ++c) {
+                ggml_tensor * col = ggml_rms_norm(ctx, ggml_depth_mix_column(ctx, out, c), 1e-6f);
+                acc = acc ? ggml_add(ctx, acc, col) : col;
+            }
+            ggml_set_name(acc, "cols");
+            return acc;
+        }
+
+        return out;
+    }
+};
