+// 0129u (C8): the next graph's node 0 pages, enqueued at this graph's LAST paged FA, waiting
+// the consumed event of the FA that last read slot 0 (two attention layers back). Their
+// bytes come from the USM host store, immutable for streamed pages: prepare() writes the
+// store only when a page is saved and zeroed, and this ubatch's new K/V go to resident
+// pages (llama-kv-cache.cpp:1730,1765 write the cache cells, which are never streamed).
+static void ggml_cl_fa_paged_prefetch_head(ggml_backend_opencl_context * ctx) {
+    auto & o = ctx->fa_paged;
+    if (o.chain.empty()) return;
+    const int p = ggml_cl_fa_paged_overlap_slot(ctx, o.chain[0]);
+    if (p < 0) return;
+    const ggml_tensor * dst = o.chain[0];
+    const ggml_tensor * plan = dst->src[GGML_FA_SRC_PLAN];
+    const int32_t * pl = plan ? (const int32_t *) ggml_backend_opencl_usm_ptr(plan) : nullptr;
+    if (pl == nullptr) return;   // a plan that is not USM: this lead cannot compare it later
+    std::vector<int32_t> rows;
+    for (int64_t i = 0; i < plan->ne[0]; ++i) if (pl[i] >= 0) rows.push_back(pl[i]);
+    // the wait: the slot's last reader. It was set by the FA two layers back; the graph's
+    // last FA is on the other slot, so this copy runs beside it and the layers after it.
+    if (o.pre_ready) { CL_CHECK(clReleaseEvent(o.pre_ready)); o.pre_ready = nullptr; }
+    cl_uint  nw = o.consumed[p] != nullptr ? 1 : 0;
+    cl_event wl[1] = { o.consumed[p] };
+    const int runs = ggml_cl_fa_paged_enqueue_pages(ctx, dst, o.q, nw, nw ? wl : NULL);
+    if (runs < 0) return;
+    CL_CHECK(clEnqueueMarkerWithWaitList(o.q, 0, nullptr, &o.pre_ready));
+    CL_CHECK(clFlush(o.q));
+    o.pre_parity = p;
+    o.pre_rows   = rows;
+    o.pre_issued++;
+}
+
+// 0129u: does the graph's node 0 plan name the rows the cross-step copies filled?
+static bool ggml_cl_fa_paged_prefetch_same(ggml_backend_opencl_context * ctx) {
+    auto & o = ctx->fa_paged;
+    if (o.chain.empty() || o.pre_rows.empty()) return false;
+    const ggml_tensor * plan = o.chain[0]->src[GGML_FA_SRC_PLAN];
+    const int32_t * pl = plan ? (const int32_t *) ggml_backend_opencl_usm_ptr(plan) : nullptr;
+    if (pl == nullptr) return false;
+    int64_t k = 0;
+    for (int64_t i = 0; i < plan->ne[0]; ++i) {
+        if (pl[i] < 0) continue;
+        if (k >= (int64_t) o.pre_rows.size() || o.pre_rows[k] != pl[i]) return false;
+        ++k;
+    }
+    return k == (int64_t) o.pre_rows.size();
+}
