+// MUL_MAT_ID with a fixed, realistic top-8 routing: every token's eight slots are
+// eight distinct experts drawn over the 128 with a fixed seed, so two perf arms
+// time the same routing and the per-expert pair counts keep a real spread (at
+// 512 tokens 20..51 pairs an expert, mean 32; at 1,024 46..91, mean 64; at
+// 2,048 100..166, mean 128; no expert is empty at any of the three).
+struct test_mul_mat_id_routed : public test_mul_mat_id {
+    using test_mul_mat_id::test_mul_mat_id;
+    std::string vars() override { return test_mul_mat_id::vars() + ",routed=1"; }
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 rng(20261124u);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_I32) {
+                if (ggml_is_view_op(t->op)) { continue; }
+                const int off = ids_offset ? 1 : 0;
+                for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                    std::vector<int32_t> data(t->ne[0], 0);
+                    std::set<int32_t> used;
+                    for (int i = 0; i < n_used; i++) {
+                        int32_t e;
+                        do { e = (int32_t) (rng() % n_mats); } while (!used.insert(e).second);
+                        data[off + i] = e;
+                    }
+                    ggml_backend_tensor_set(t, data.data(), r * t->nb[1], t->ne[0] * sizeof(int32_t));
+                }
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+    // the routing is what the timing compares: keep it fixed across iterations
+    void reinit_perf_iter(ggml_context * ctx) override { GGML_UNUSED(ctx); }
+};
