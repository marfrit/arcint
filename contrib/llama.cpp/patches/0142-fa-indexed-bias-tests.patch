+++ b/tests/test-flash-attn-indexed-bias.cpp
@@ -0,0 +1,311 @@
+// GGML_OP_FLASH_ATTN_EXT indexed bias (0140, the contract of the compact-bias PR): the bias is
+// table[head, indices[key, query], query], added to the mask value before its F16 rounding. The
+// expectations below are computed by hand, not against the CPU backend, so a CPU that rounds twice
+// or not at all fails them.
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+static void test_indexed_bias(ggml_backend_t backend, int width, int n_query, int cells = 768) {
+    constexpr int heads = 6, kv_heads = 2, streams = 2, bins = 17;
+    const int cols = cells;
+
+    ggml_context * ctx = ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true});
+    auto * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, n_query, heads, streams);
+    auto * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, width, cells, kv_heads, streams);
+    auto * v = ggml_dup_tensor(ctx, k);
+    auto * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cols, n_query, 1, streams);
+    auto * table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, heads, bins, n_query*streams);
+    auto * indices = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, cols, n_query*streams);
+    auto * sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, heads);
+    auto * out = ggml_flash_attn_ext(ctx, q, k, v, mask, 1.0f/sqrtf(width), 0, 0);
+    ggml_flash_attn_ext_add_sinks(out, sinks);
+    const bool supports_plain = ggml_backend_supports_op(backend, out);
+    ggml_flash_attn_ext_add_indexed_bias(out, table, indices);
+    GGML_ASSERT(ggml_flash_attn_ext_has_indexed_bias(out));
+    ggml_flash_attn_ext_add_indexed_bias(out, nullptr, nullptr);
+    GGML_ASSERT(!ggml_flash_attn_ext_has_indexed_bias(out) && !out->src[12] && !out->src[13]);
+    GGML_ASSERT(ggml_backend_supports_op(backend, out) == supports_plain);
+    ggml_flash_attn_ext_add_indexed_bias(out, table, indices);
+    ggml_prec_set_acc(out, GGML_PREC_F32);
+
+    if (!ggml_backend_supports_op(backend, out)) {
+        ggml_free(ctx);
+        return;
+    }
+
+    auto * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, out);
+    auto * buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+    ggml_backend_buffer_clear(buf, 0);
+
+    std::vector<int32_t> idx(ggml_nelements(indices));
+    std::vector<ggml_fp16_t> visibility(idx.size()), values(ggml_nelements(v));
+    std::vector<ggml_fp16_t> keys(ggml_nelements(k));
+    std::vector<float> queries(ggml_nelements(q));
+    float sink_logits[heads];
+    for (int h = 0; h < heads; ++h) {
+        sink_logits[h] = float(2*h - 3);
+    }
+    for (size_t i = 0; i < queries.size(); i += width) {
+        queries[i] = 4.0f;
+    }
+    std::vector<float> biases(ggml_nelements(table)), expected(n_query*streams*heads), output(ggml_nelements(out));
+    for (int s = 0; s < v->ne[3]; ++s) {
+        for (int h = 0; h < kv_heads; ++h) {
+            for (int c = 0; c < cells; ++c) {
+                const float x = float((c + 3*h + 5*s) % 23 - 11)/16;
+                const int offset = ((s*kv_heads + h)*cells + c)*width;
+                std::fill_n(values.data() + offset, width, ggml_fp32_to_fp16(x));
+                keys[offset] = ggml_fp32_to_fp16(float((7*c + 2*h + 3*s) % 29 - 14)/4);
+            }
+        }
+    }
+    for (int s = 0; s < streams; ++s) {
+        for (int j = 0; j < n_query; ++j) {
+            const int query = s*n_query + j;
+            for (int h = 0; h < heads; ++h) {
+                for (int b = 0; b < bins; ++b) {
+                    biases[(query*bins + b)*heads + h] = float((b*(3 + h) + query) % 13 - 6)/2.9f;
+                }
+                double sum = exp(double(sink_logits[h])), weighted = 0.0;
+                for (int c = 0; c < cols; ++c) {
+                    const int i = query*cols + c;
+                    idx[i] = (c + 3*query) % bins;
+                    const bool visible = (s != 1 || j != 0) && (c + j) % 7 != 0;
+                    visibility[i] = ggml_fp32_to_fp16(visible ? 0.25f : -INFINITY);
+                    if (visible) {
+                        const int vk = s*kv_heads + h/(heads/kv_heads);
+                        const double qk = 4.0*ggml_fp16_to_fp32(keys[(vk*cells + c)*width])/sqrt(width);
+                        const float m = 0.25f + biases[(query*bins + idx[i])*heads + h];
+                        const double weight = exp(qk + ggml_fp16_to_fp32(ggml_fp32_to_fp16(m)));
+                        weighted += weight*ggml_fp16_to_fp32(values[(vk*cells + c)*width]);
+                        sum += weight;
+                    }
+                }
+                expected[query*heads + h] = weighted/sum;
+            }
+        }
+    }
+    ggml_backend_tensor_set(q, queries.data(), 0, ggml_nbytes(q));
+    ggml_backend_tensor_set(k, keys.data(), 0, ggml_nbytes(k));
+    ggml_backend_tensor_set(v, values.data(), 0, ggml_nbytes(v));
+    ggml_backend_tensor_set(mask, visibility.data(), 0, ggml_nbytes(mask));
+    ggml_backend_tensor_set(table, biases.data(), 0, ggml_nbytes(table));
+    ggml_backend_tensor_set(sinks, sink_logits, 0, sizeof(sink_logits));
+    ggml_backend_tensor_set(indices, idx.data(), 0, ggml_nbytes(indices));
+    GGML_ASSERT(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(out, output.data(), 0, ggml_nbytes(out));
+    float max_error = 0.0f;
+    for (size_t i = 0; i < output.size(); ++i) {
+        GGML_ASSERT(std::isfinite(output[i]));
+        max_error = std::max(max_error, fabsf(output[i] - expected[i/width]));
+    }
+    printf("%s: width=%d, queries=%d, cells=%d, max error=%g\n", ggml_backend_name(backend), width, n_query, cells, max_error);
+    GGML_ASSERT(max_error < 0.001f);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
+// a small indexed-bias case whose data the caller fills in, computed twice if wanted: with the bias
+// (table + indices) and without it (a dense mask). Runs the same K/V, Q and sink data both times.
+struct bias_case {
+    int width = 128;
+    int heads = 4;
+    int kv_heads = 2;
+    int n_query = 3;
+    int cells = 96;
+    int bins = 8;
+
+    ggml_context * ctx = nullptr;
+    ggml_tensor * q, * k, * v, * mask, * table, * indices, * sinks, * out;
+
+    bias_case(bool with_bias, int heads_ = 4, int kv_heads_ = 2) : heads(heads_), kv_heads(kv_heads_) {
+        ctx = ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true});
+        q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, n_query, heads, 1);
+        k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, width, cells, kv_heads, 1);
+        v = ggml_dup_tensor(ctx, k);
+        mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cells, n_query, 1, 1);
+        table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, heads, bins, n_query);
+        indices = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, cells, n_query);
+        sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, heads);
+        out = ggml_flash_attn_ext(ctx, q, k, v, mask, 1.0f/sqrtf(width), 0, 0);
+        ggml_flash_attn_ext_add_sinks(out, sinks);
+        ggml_flash_attn_ext_add_indexed_bias(out, with_bias ? table : nullptr, with_bias ? indices : nullptr);
+        ggml_prec_set_acc(out, GGML_PREC_F32);
+    }
+    ~bias_case() { ggml_free(ctx); }
+
+    // graph buffers of a case: allocated for the whole context, so table and indices are allocated
+    // even when the bias is off (they are simply not sources then)
+    std::vector<float> run(ggml_backend_t backend, const std::vector<float> & qv, const std::vector<ggml_fp16_t> & kv,
+            const std::vector<ggml_fp16_t> & vm, const std::vector<ggml_fp16_t> & mv, const std::vector<float> & tv,
+            const std::vector<int32_t> & iv, const std::vector<float> & sv) {
+        auto * graph = ggml_new_graph(ctx);
+        ggml_build_forward_expand(graph, out);
+        auto * buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf);
+        ggml_backend_buffer_clear(buf, 0);
+        ggml_backend_tensor_set(q, qv.data(), 0, ggml_nbytes(q));
+        ggml_backend_tensor_set(k, kv.data(), 0, ggml_nbytes(k));
+        ggml_backend_tensor_set(v, vm.data(), 0, ggml_nbytes(v));
+        ggml_backend_tensor_set(mask, mv.data(), 0, ggml_nbytes(mask));
+        ggml_backend_tensor_set(table, tv.data(), 0, ggml_nbytes(table));
+        ggml_backend_tensor_set(indices, iv.data(), 0, ggml_nbytes(indices));
+        ggml_backend_tensor_set(sinks, sv.data(), 0, ggml_nbytes(sinks));
+        GGML_ASSERT(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+        std::vector<float> r(ggml_nelements(out));
+        ggml_backend_tensor_get(out, r.data(), 0, ggml_nbytes(out));
+        ggml_backend_buffer_free(buf);
+        return r;
+    }
+};
+
+static void fill_case_data(const bias_case & c, int bin, float mask_vis,
+        std::vector<float> & qv, std::vector<ggml_fp16_t> & kv, std::vector<ggml_fp16_t> & vm,
+        std::vector<float> & tv, std::vector<int32_t> & iv, std::vector<float> & sv) {
+    // every head shares one table column per bin, so a constant bin is a constant dense-mask value
+    for (int query = 0; query < c.n_query; ++query) {
+        for (int h = 0; h < c.heads; ++h) {
+            for (int b = 0; b < c.bins; ++b) {
+                tv[(query*c.bins + b)*c.heads + h] = (b == bin) ? 1.5f : float(b)/8;
+            }
+            sv[h] = 0.0f; // the model's zero sink
+        }
+        for (int key = 0; key < c.cells; ++key) {
+            iv[query*c.cells + key] = bin;
+        }
+    }
+    qv.assign(c.width*c.n_query*c.heads, 1.0f);
+    kv.assign(c.width*c.cells*c.kv_heads, ggml_fp32_to_fp16(0.5f));
+    vm.assign(c.width*c.cells*c.kv_heads, 0.0f);
+    GGML_UNUSED(mask_vis);
+}
+
+// red case 3: a constant bin's indices must give the answer of a dense mask holding that bin's value,
+// which a backend that ignores the table and reads the mask alone cannot reproduce
+static void test_constant_bin(ggml_backend_t backend) {
+    bias_case cb(true), nb(false);
+
+    std::vector<float> qv; std::vector<ggml_fp16_t> kv, vm;
+    std::vector<float> tv(ggml_nelements(cb.table)), sv(cb.heads);
+    std::vector<int32_t> iv(ggml_nelements(cb.indices));
+    fill_case_data(cb, 5, 0.25f, qv, kv, vm, tv, iv, sv);
+
+    std::vector<ggml_fp16_t> m_bias(ggml_nelements(cb.mask)), m_dense(ggml_nelements(nb.mask));
+    for (size_t i = 0; i < m_bias.size(); ++i) {
+        const int query = i / cb.cells;
+        const bool visible = i % cb.cells % 10 != 9; // whole blocks of invisible cells too
+        const float m = visible ? 0.25f : -INFINITY;
+        m_bias[i] = ggml_fp32_to_fp16(m);
+        // the same mask with the constant bin's value folded in, rounded to f16 like the kernels do
+        m_dense[i] = ggml_fp32_to_fp16(visible ? m + tv[query*cb.bins*cb.heads + 5*cb.heads] : m);
+    }
+
+    if (!ggml_backend_supports_op(backend, cb.out)) {
+        ggml_free(cb.ctx);
+        return;
+    }
+
+    std::vector<float> r_bias  = cb.run(backend, qv, kv, vm, m_bias, tv, iv, sv);
+    std::vector<float> r_dense = nb.run(backend, qv, kv, vm, m_dense, tv, iv, sv);
+    float max_diff = 0.0f;
+    for (size_t i = 0; i < r_bias.size(); ++i) {
+        max_diff = std::max(max_diff, fabsf(r_bias[i] - r_dense[i]));
+    }
+    printf("%s: constant bin 5 vs dense mask, max difference=%g\n", ggml_backend_name(backend), max_diff);
+    GGML_ASSERT(max_diff < 1e-6f);
+}
+
+// red case 6: the bias is added to the mask value before the sum's single F16 rounding. Two bins of
+// a different bias phase over a mask of 100.0 land on different sides of the F16 grid at magnitude
+// 100, so the rounded scores differ where the unrounded ones do; V follows the bins, so the answer
+// moves by ~0.015 with the rounding and an implementation that keeps the sum in f32 misses it.
+static void test_bias_rounding(ggml_backend_t backend) {
+    bias_case cb(true, 1, 1);
+
+    std::vector<float> qv; std::vector<ggml_fp16_t> kv, vm;
+    std::vector<float> tv(ggml_nelements(cb.table)), sv(cb.heads);
+    std::vector<int32_t> iv(ggml_nelements(cb.indices));
+    fill_case_data(cb, 0, 0.25f, qv, kv, vm, tv, iv, sv);
+
+    for (size_t i = 0; i < tv.size(); ++i) {
+        tv[i] = 0.0f;
+    }
+    tv[1] = 0.03f; // bin 1: 100.0 + 0.03 rounds down to 100.0, bin 0 stays 100.0
+
+    std::vector<ggml_fp16_t> m(ggml_nelements(cb.mask));
+    for (size_t i = 0; i < m.size(); ++i) {
+        m[i] = ggml_fp32_to_fp16(100.0f);
+    }
+    for (int query = 0; query < cb.n_query; ++query) {
+        for (int key = 0; key < cb.cells; ++key) {
+            iv[query*cb.cells + key] = key % 2;
+            vm[key*cb.width] = ggml_fp32_to_fp16(key % 2 == 0 ? 1.0f : -1.0f);
+        }
+    }
+
+    if (!ggml_backend_supports_op(backend, cb.out)) {
+        ggml_free(cb.ctx);
+        return;
+    }
+
+    std::vector<float> r = cb.run(backend, qv, kv, vm, m, tv, iv, sv);
+
+    // hand-computed: exp(qk + f16(mask + bias)) with the rounded sum, and the same with the raw sum
+    const auto expect = [&](bool rounded) {
+        std::vector<float> e(cb.heads);
+        for (int h = 0; h < cb.heads; ++h) {
+            const float qk = ggml_fp16_to_fp32(kv[0])/sqrtf(float(cb.width));
+            double sum = exp(double(sv[h])), weighted = 0.0;
+            for (int c = 0; c < cb.cells; ++c) {
+                const float m16 = ggml_fp16_to_fp32(m[c]);
+                const float s = m16 + tv[c % 2];
+                const float ms = rounded ? ggml_fp16_to_fp32(ggml_fp32_to_fp16(s)) : s;
+                const double w = exp(qk + ms);
+                weighted += w*ggml_fp16_to_fp32(vm[c*cb.width]);
+                sum += w;
+            }
+            e[h] = float(weighted/sum);
+        }
+        return e;
+    };
+    const std::vector<float> e_round = expect(true), e_raw = expect(false);
+    float discrimination = 0.0f;
+    for (size_t i = 0; i < e_round.size(); ++i) {
+        discrimination = std::max(discrimination, fabsf(e_round[i] - e_raw[i]));
+    }
+    GGML_ASSERT(discrimination > 1e-2f); // else the case would pass either way
+
+    float max_error = 0.0f;
+    for (size_t i = 0; i < r.size(); ++i) {
+        max_error = std::max(max_error, fabsf(r[i] - e_round[i/cb.width]));
+    }
+    printf("%s: f16 rounding of mask+bias, max error=%g, rounded vs unrounded expectation=%g\n",
+           ggml_backend_name(backend), max_error, discrimination);
+    GGML_ASSERT(max_error < 1e-3f);
+}
+
+int main() {
+    ggml_backend_load_all();
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        auto dev = ggml_backend_dev_get(i);
+        auto backend = ggml_backend_dev_init(dev, nullptr);
+        GGML_ASSERT(backend);
+        for (int width : {64, 128}) {
+            test_indexed_bias(backend, width, 7, 16);
+            for (int n_query : {1, 7, 65}) {
+                test_indexed_bias(backend, width, n_query);
+            }
+        }
+        test_constant_bin(backend);
+        test_bias_rounding(backend);
+        ggml_backend_free(backend);
+    }
+}
