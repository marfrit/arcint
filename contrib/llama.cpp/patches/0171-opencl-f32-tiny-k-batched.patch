 }
+
+// a batched F32 product of a tiny K over a wide N: out[r] of column c = sum_k a[k][r] * b[k][c],
+// with a's rows the wide N (an activation, not a weight) and a column a token as the batch.
+// One work-item a row, the K loop (1-8) in registers; a broadcast weight would read a's row
+// once a column, the shape reads it once a row block.
+kernel void kernel_mul_mat_f32_f32_smallk(
+        global char * src0,
+        ulong offset0,
+        global char * src1,
+        ulong offset1,
+        global float * dst,
+        ulong offsetd,
+        int ne00,
+        int ne01,
+        int n_cols) {
+    const int c = get_global_id(1), r = get_global_id(0);
+    if (r >= ne01 || c >= n_cols) return;
+    global const float * a = (global const float *)(src0 + offset0) + (ulong) r;
+    global const float * b = (global const float *)(src1 + offset1) + (ulong) c * ne00;
+    float s = 0.f;
+    for (int k = 0; k < ne00; ++k) s += a[(ulong) k * ne01] * b[k];
+    global float * d = (global float *)((global char *) dst + offsetd);
+    d[(ulong) c * ne01 + r] = s;
+}
