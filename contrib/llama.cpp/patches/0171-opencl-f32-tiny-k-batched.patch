+// a batched F32 product of a tiny K (1-8 rows) over a wide N: Inkling 2 Mini's depth mix
+// (2304 rows, K = a block count 1-6, one or three columns a token, a column a token as the
+// batch). The tiled GEMMs' BK is 16 and the GEMV's K is 64, so both decline it and the
+// generic matvec runs one work-group a (row block, column): the weight is an activation, so
+// one lane a row and the K loop in registers is the shape's own path. One launch, and no
+// buffer: the output is dst's row.
+static bool ggml_cl_mul_mat_f32_smallk(ggml_backend_t backend, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *)backend->context;
+    static const char * env = getenv("GGML_OPENCL_F32_SMALLK");
+    static const bool   on  = env == nullptr || atoi(env) != 0;
+    if (!on || backend_ctx->gpu_family != INTEL || backend_ctx->kernel_mul_mat_f32_f32_smallk == nullptr ||
+        src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        src0->ne[0] != src1->ne[0] || src0->ne[0] < 1 || src0->ne[0] > 8 || src0->ne[1] != dst->ne[1] ||
+        src0->ne[1] < 256 || src0->ne[2] != src1->ne[2] || src0->ne[3] != 1 || src1->ne[3] != 1 || dst->ne[3] != 1 ||
+        dst->ne[1] != src1->ne[1] || dst->ne[2] != src1->ne[2] ||
+        !ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    const int ne00 = (int) src0->ne[0], ne01 = (int) src0->ne[1];
+    const int n_cols = (int) (src1->ne[1] * src1->ne[2]);
+    ggml_tensor_extra_cl * extra0 = (ggml_tensor_extra_cl *)src0->extra;
+    ggml_tensor_extra_cl * extra1 = (ggml_tensor_extra_cl *)src1->extra;
+    ggml_tensor_extra_cl * extrad = (ggml_tensor_extra_cl *)dst->extra;
+    cl_ulong offset0 = extra0->offset + src0->view_offs;
+    cl_ulong offset1 = extra1->offset + src1->view_offs;
+    cl_ulong offsetd = extrad->offset + dst->view_offs;
+    cl_kernel k = backend_ctx->kernel_mul_mat_f32_f32_smallk;
+    CL_CHECK(clSetKernelArg(k, 0, sizeof(cl_mem),   &extra0->data_device));
+    CL_CHECK(clSetKernelArg(k, 1, sizeof(cl_ulong), &offset0));
+    CL_CHECK(clSetKernelArg(k, 2, sizeof(cl_mem),   &extra1->data_device));
+    CL_CHECK(clSetKernelArg(k, 3, sizeof(cl_ulong), &offset1));
+    CL_CHECK(clSetKernelArg(k, 4, sizeof(cl_mem),   &extrad->data_device));
+    CL_CHECK(clSetKernelArg(k, 5, sizeof(cl_ulong), &offsetd));
+    CL_CHECK(clSetKernelArg(k, 6, sizeof(int),      &ne00));
+    CL_CHECK(clSetKernelArg(k, 7, sizeof(int),      &ne01));
+    CL_CHECK(clSetKernelArg(k, 8, sizeof(int),      &n_cols));
+    size_t gws[2] = { (size_t)CEIL_DIV(ne01, 64) * 64, (size_t)n_cols };
+    size_t lws[2] = { 64, 1 };
+    backend_ctx->enqueue_ndrange_kernel(k, 2, gws, lws, dst);
+    return true;
+}
