+// was copied at init and is the stale plain one. Two blocking writes on the backend's in-order queue: ordered after
+// every earlier kernel and write, done on return (the host copies are locals, the caller may free `data`).
+static void ggml_cl_soa_range_write(ggml_backend_opencl_context * backend_ctx, const ggml_tensor * tensor, const void * data,
