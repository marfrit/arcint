+    }
+#ifndef GGML_CL_SOA_ROUTE2_RED
+    return GGML_CL_SOA_PLANES;
+#else
+    return r0230;   // the red build: 0230's routing (REFUSE_VIEW / REFUSE_PARTIAL, a whole write CONVERT)
+#endif
+}
