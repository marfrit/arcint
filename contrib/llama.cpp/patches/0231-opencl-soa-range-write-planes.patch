+    if (!contiguous) return GGML_CL_SOA_REFUSE_VIEW;
+    if (weights && (is_view || offset != 0 || size != nbytes)) return r0230;   // REFUSE_VIEW / REFUSE_PARTIAL
+    if (!layout_plain) return GGML_CL_SOA_REFUSE_LAYOUT;
+    if (blk == 0 || (view_offs + offset) % blk != 0 || size % blk != 0 || offset + size > nbytes ||
+        view_offs + offset + size > base_nbytes) {
