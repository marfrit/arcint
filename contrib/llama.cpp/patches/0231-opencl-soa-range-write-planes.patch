+        d = e->d; q = e->q;
+    } else {
+        auto * e = (ggml_tensor_extra_cl_q4_0 *) base->extra;
+        d = e->d; q = e->q;
+    }
+    GGML_ASSERT(d != nullptr && q != nullptr);
+    cl_command_queue queue = backend_ctx->queue;
+    CL_CHECK(clEnqueueWriteBuffer(queue, d, CL_TRUE, b0 * sizeof(ggml_fp16_t), dh.size(), dh.data(), 0, NULL, NULL));
+    CL_CHECK(clEnqueueWriteBuffer(queue, q, CL_TRUE, b0 * qb, qh.size(), qh.data(), 0, NULL, NULL));
+}
