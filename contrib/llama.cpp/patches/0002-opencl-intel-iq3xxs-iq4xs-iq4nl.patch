+constant char kvalues_iq4nl[16] = {
+    -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113,
+};
+
+static inline int dot8_ss(const uint * w, uint4 x0, uint4 x1) {
+    int a = 0;
+    a = dot_acc_sat_4x8packed_ss_int(w[0], x0.s0, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[1], x0.s1, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[2], x0.s2, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[3], x0.s3, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[4], x1.s0, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[5], x1.s1, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[6], x1.s2, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[7], x1.s3, a);
+    return a;
+}
+
+// four 4-bit codes (one per byte, low nibble) -> four int8 kvalues
+static inline uint kv4(uint n) {
+    return as_uint((char4)(kvalues_iq4nl[n & 0xF], kvalues_iq4nl[(n >> 8) & 0xF],
+                           kvalues_iq4nl[(n >> 16) & 0xF], kvalues_iq4nl[(n >> 24) & 0xF]));
+}
+
+// 16 code bytes -> the 32 weights' int8 values: low nibbles are weights
+// 0..15, high nibbles 16..31 (dequantize_row_iq4_nl / _iq4_xs)
+static inline void iq4_expand(uint4 q, uint * w) {
+    w[0] = kv4(q.s0 & 0x0F0F0F0Fu);        w[1] = kv4(q.s1 & 0x0F0F0F0Fu);
+    w[2] = kv4(q.s2 & 0x0F0F0F0Fu);        w[3] = kv4(q.s3 & 0x0F0F0F0Fu);
+    w[4] = kv4((q.s0 >> 4) & 0x0F0F0F0Fu); w[5] = kv4((q.s1 >> 4) & 0x0F0F0F0Fu);
+    w[6] = kv4((q.s2 >> 4) & 0x0F0F0F0Fu); w[7] = kv4((q.s3 >> 4) & 0x0F0F0F0Fu);
+}
+
+// IQ3_XXS sub-block p of the block at bp (98 bytes, 2-byte aligned): the 32
+// weights' signed int8 values and the sub-block scale (dequantize_row_iq3_xxs)
+static inline float iq3xxs_expand(global const uchar * bp, int p, uint * w,
+                                  local const uint * grid, local const ulong * signs) {
+    global const ushort * h = (global const ushort *)bp;
+    const float d = vload_half(0, (global const half *)bp);
+    // grid indices: qs[8p .. 8p+7] at byte 2 + 8p; scales/signs: qs[64 + 4p]
+    const ushort4 gi = vload4(0, h + 1 + 4 * p);
+    const uint aux = (uint)h[1 + 32 + 2 * p] | ((uint)h[1 + 32 + 2 * p + 1] << 16);
+    const uchar idx[8] = { gi.s0 & 0xFF, gi.s0 >> 8, gi.s1 & 0xFF, gi.s1 >> 8,
+                           gi.s2 & 0xFF, gi.s2 >> 8, gi.s3 & 0xFF, gi.s3 >> 8 };
+    #pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        const ulong m = signs[(aux >> (7 * l)) & 127];   // 0xFF in the bytes to negate
+        const uint m1 = (uint)m, m2 = (uint)(m >> 32);
+        const uint g1 = grid[idx[2 * l]], g2 = grid[idx[2 * l + 1]];
+        w[2 * l]     = as_uint(as_char4(g1 ^ m1) - as_char4(m1));
+        w[2 * l + 1] = as_uint(as_char4(g2 ^ m2) - as_char4(m2));
+    }
+    return d * (0.5f + (float)(aux >> 28)) * 0.5f;
+}
+
+// IQ4_XS sub-block p of the block at bp (136 bytes): values and scale
+static inline float iq4xs_expand(global const uchar * bp, int p, uint * w) {
+    const float d = vload_half(0, (global const half *)bp);
+    const uint sh = ((global const ushort *)bp)[1];
+    const uint sl = bp[4 + p / 2];
+    const int ls = ((sl >> (4 * (p & 1))) & 0xF) | (((sh >> (2 * p)) & 3) << 4);
+    iq4_expand(vload4(0, (global const uint *)(bp + 8 + 16 * p)), w);
+    return d * (float)(ls - 32);
+}
+
+static inline void reduce_store(float acc[N_DST][NCOLS], global float * out, ulong ostride, int first_row, int ne01) {
+    const int lane = get_sub_group_local_id();
+    #pragma unroll
+    for (int c = 0; c < NCOLS; ++c) {
+        #pragma unroll
+        for (int r = 0; r < N_DST; ++r) {
+            const float t = sub_group_reduce_add(acc[r][c]);
+            if (lane == 0 && first_row + r < ne01) out[c * ostride + first_row + r] = t;
+        }
+    }
+}
+
+// TYPE 0: IQ3_XXS, 1: IQ4_XS (row_bytes: the row stride in bytes), 2: IQ4_NL
+// flat (q: code plane, dp: scale plane, rows of nb*8 blocks). xq/xd: column
+// 0's codes and scales, the residual term at + res.
+// IQ4_NL: one 32-block per lane, 16 lanes a step, rows of n32 blocks (K a
+// multiple of 32 only: Flash-Next's down projections have K = 640)
+static inline void mv_iq4_nl(global const uchar * q, global const half * dp, ulong blk0, int n32, int first_row, int ne01,
+                             global const char * xq, global const float * xd, ulong res,
+                             global float * out, ulong ostride) {
+    const int lane = get_sub_group_local_id();
+    const int ne00 = n32 * 32;
+    global const char  * xq2 = xq + res;
+    global const float * xd2 = xd + res / 32;
+
+    float acc[N_DST][NCOLS];
+    #pragma unroll
+    for (int r = 0; r < N_DST; ++r)
+        #pragma unroll
+        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;
+
+    for (int b32 = lane; b32 < n32; b32 += 16) {
+        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
+        float dx[NCOLS], dy[NCOLS];
+        #pragma unroll
+        for (int c = 0; c < NCOLS; ++c) {
+            global const char * xc = xq + c * ne00 + b32 * 32;
+            global const char * yc = xq2 + c * ne00 + b32 * 32;
+            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
+            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
+            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
+        }
+        #pragma unroll
+        for (int r = 0; r < N_DST; ++r) {
+            if (first_row + r >= ne01) break;
+            const ulong blk = blk0 + (ulong)r * n32 + b32;
+            uint w[8];
+            iq4_expand(vload4(0, (global const uint *)(q + blk * 16)), w);
+            const float s = vload_half(blk, dp);
+            #pragma unroll
+            for (int c = 0; c < NCOLS; ++c) {
+                acc[r][c] += s * (dx[c] * (float)dot8_ss(w, xa[c], xb[c]) + dy[c] * (float)dot8_ss(w, ya[c], yb[c]));
+            }
+        }
+    }
+    reduce_store(acc, out, ostride, first_row, ne01);
+}
+
+static inline void mv_iq(const int TYPE, global const uchar * q, global const half * dp, ulong row0_off,
+                         ulong row_bytes, int nb, int first_row, int ne01,
+                         global const char * xq, global const float * xd, ulong res,
+                         global float * out, ulong ostride, local const uint * grid, local const ulong * signs) {
+    const int lane = get_sub_group_local_id();
+    const int p = lane & 7;
+    const int ne00 = nb * QK_K, n32 = nb * 8;
+    global const char  * xq2 = xq + res;
+    global const float * xd2 = xd + res / 32;
+
+    float acc[N_DST][NCOLS];
+    #pragma unroll
+    for (int r = 0; r < N_DST; ++r)
+        #pragma unroll
+        for (int c = 0; c < NCOLS; ++c) acc[r][c] = 0.f;
+
+    for (int ib = lane >> 3; ib < nb; ib += 2) {
+        const int b32 = ib * 8 + p;
+        uint4 xa[NCOLS], xb[NCOLS], ya[NCOLS], yb[NCOLS];
+        float dx[NCOLS], dy[NCOLS];
+        #pragma unroll
+        for (int c = 0; c < NCOLS; ++c) {
+            global const char * xc = xq + c * ne00 + b32 * 32;
+            global const char * yc = xq2 + c * ne00 + b32 * 32;
+            xa[c] = vload4(0, (global const uint *)xc); xb[c] = vload4(0, (global const uint *)(xc + 16));
+            ya[c] = vload4(0, (global const uint *)yc); yb[c] = vload4(0, (global const uint *)(yc + 16));
+            dx[c] = xd[c * n32 + b32]; dy[c] = xd2[c * n32 + b32];
+        }
+        #pragma unroll
+        for (int r = 0; r < N_DST; ++r) {
+            if (first_row + r >= ne01) break;
+            uint w[8];
+            float s;
+            if (TYPE == 0) {
+                s = iq3xxs_expand(q + row0_off + (ulong)r * row_bytes + (ulong)ib * 98, p, w, grid, signs);
+            } else {
+                s = iq4xs_expand(q + row0_off + (ulong)r * row_bytes + (ulong)ib * 136, p, w);
+            }
+            #pragma unroll
+            for (int c = 0; c < NCOLS; ++c) {
+                acc[r][c] += s * (dx[c] * (float)dot8_ss(w, xa[c], xb[c]) + dy[c] * (float)dot8_ss(w, ya[c], yb[c]));
+            }
+        }
+    }
+    reduce_store(acc, out, ostride, first_row, ne01);
+}
+
+#define FIRST_ROW (int)((get_group_id(0) * N_SIMDGROUP + get_sub_group_id()) * N_DST)
+
+// IQ3_XXS reads its grid and sign tables from local memory: each lane looks
+// up its own entries, and gathers from constant memory measured 74 GB/s
+// against 200 for the IQ4 types (A770).
+#define LOCAL_TABLES(TYPE)                                                                     \
+    local uint  lgrid[256];                                                                    \
+    local ulong lsigns[128];                                                                   \
+    if ((TYPE) == 0) {                                                                         \
+        for (int i_ = get_local_linear_id(); i_ < 256; i_ += get_local_size(0) * get_local_size(1)) { \
+            lgrid[i_] = iq3xxs_grid[i_];                                                       \
+            if (i_ < 128) lsigns[i_] = ksigns64[i_];                                           \
+        }                                                                                      \
+        barrier(CLK_LOCAL_MEM_FENCE);                                                          \
+    }
+
+// row byte strides of the blocked types: IQ3_XXS nb*98, IQ4_XS nb*136
+#define ROW_BYTES(TYPE, nb) ((ulong)(nb) * ((TYPE) == 0 ? 98 : 136))
+
+// ---- one weight matrix times NCOLS packed columns; dst column c at
+// offd + c * nb1. The weights at q + offq; IQ4_NL takes its code plane in `q`
+// and scales in `dp`, the others ignore `dp`. ----
+#define MV_KERNEL(NAME, TYPE)                                                                  \
+__attribute__((intel_reqd_sub_group_size(16)))                                                 \
+kernel void NAME(global const uchar * q, ulong offq, global const half * dp,                   \
+                 global const char * xq, global const float * xd,                              \
+                 global char * dst, ulong offd, ulong nb1, int ne00, int ne01) {               \
+    LOCAL_TABLES(TYPE)                                                                         \
+    const int first_row = FIRST_ROW;                                                           \
+    if (first_row >= ne01) return;                                                             \
+    const int nb = ne00 / QK_K;                                                                \
+    if ((TYPE) == 2) {                                                                         \
+        mv_iq4_nl(q + offq, dp, (ulong)first_row * (ne00 / 32), ne00 / 32, first_row, ne01,    \
+                  xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float)); \
+        return;                                                                                \
+    }                                                                                          \
+    mv_iq(TYPE, q + offq, dp, (ulong)first_row * ROW_BYTES(TYPE, nb), ROW_BYTES(TYPE, nb), nb,        \
+          first_row, ne01, xq, xd, (ulong)ne00 * NCOLS, (global float *)(dst + offd), nb1 / sizeof(float), \
+          lgrid, lsigns);                                                                      \
+}
+MV_KERNEL(kernel_mul_mv_iq3_xxs_q8_1, 0)
+MV_KERNEL(kernel_mul_mv_iq4_xs_q8_1, 1)
+MV_KERNEL(kernel_mul_mv_iq4_nl_q8_1, 2)
+
+// ---- MUL_MAT_ID (NCOLS = 1 builds): pair k = get_group_id(2), slot
+// i = k % n_used, token t = k / n_used; expert ids[t][i], column
+// (i % ne11) + t * ne11, output dst + t * nb2 + i * nb1; res: the residual
+// term's offset (the quantized total) ----
+#define MV_ID_KERNEL(NAME, TYPE)                                                               \
+__attribute__((intel_reqd_sub_group_size(16)))                                                 \
+kernel void NAME(global const uchar * q, ulong offq, global const half * dp,                   \
+                 global const char * xq, global const float * xd,                              \
+                 global const char * ids, ulong offi, ulong nbi1, int n_used, int ne11,        \
+                 global char * dst, ulong offd, ulong nb1, ulong nb2, int ne00, int ne01, ulong res) { \
+    LOCAL_TABLES(TYPE)                                                                         \
+    const int first_row = FIRST_ROW;                                                           \
+    if (first_row >= ne01) return;                                                             \
+    const int nb = ne00 / QK_K;                                                                \
+    const int k = get_group_id(2);                                                             \
+    const int i = k % n_used, t = k / n_used;                                                  \
+    const int e = ((global const int *)(ids + offi + t * nbi1))[i];                            \
+    const int col = (i % ne11) + t * ne11;                                                     \
+    if ((TYPE) == 2) {                                                                         \
+        mv_iq4_nl(q + offq, dp, ((ulong)e * ne01 + first_row) * (ne00 / 32), ne00 / 32, first_row, ne01, \
+                  xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res,                  \
+                  (global float *)(dst + offd + t * nb2 + i * nb1), 0);                        \
+        return;                                                                                \
+    }                                                                                          \
+    mv_iq(TYPE, q + offq, dp, ((ulong)e * ne01 + first_row) * ROW_BYTES(TYPE, nb), ROW_BYTES(TYPE, nb), nb, \
+          first_row, ne01, xq + (ulong)col * ne00, xd + (ulong)col * (ne00 / 32), res,         \
+          (global float *)(dst + offd + t * nb2 + i * nb1), 0, lgrid, lsigns);                 \
+}
+MV_ID_KERNEL(kernel_mul_mv_id_iq3_xxs_q8_1, 0)
+MV_ID_KERNEL(kernel_mul_mv_id_iq4_xs_q8_1, 1)
+MV_ID_KERNEL(kernel_mul_mv_id_iq4_nl_q8_1, 2)
