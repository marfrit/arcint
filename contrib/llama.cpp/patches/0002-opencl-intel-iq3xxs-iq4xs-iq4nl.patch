+            v[8 * l + 4] = (mb.s4 ? -db : db) * g2.s0; v[8 * l + 5] = (mb.s5 ? -db : db) * g2.s1;
+            v[8 * l + 6] = (mb.s6 ? -db : db) * g2.s2; v[8 * l + 7] = (mb.s7 ? -db : db) * g2.s3;
+        }
