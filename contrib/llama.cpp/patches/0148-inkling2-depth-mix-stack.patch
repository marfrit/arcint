+ggml_tensor * llama_model_inkling2::graph::res_stack_tensor() {
+    if (!res_stack) {
+        const int64_t block  = hparams.attn_res_block_size;
+        const int64_t n_slot = (model.n_layer_physical() + block - 1) / block + 1;
+        res_stack = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, n_slot, n_tokens);
+        // the stack is only read through views; a direct consumer anchors it on the backend
+        ggml_build_forward_expand(gf, ggml_sum_rows(ctx0, res_stack));
+    }
+    return res_stack;
+}
+
+// the stack rows hold the block residuals newest first, the last row holds the current input
+void llama_model_inkling2::graph::write_res_block(ggml_tensor * block, int j) {
+    ggml_tensor * stack  = res_stack_tensor();
+    const int64_t n_slot = stack->ne[1] - 1;
+    GGML_ASSERT(j < n_slot);
+
+    ggml_build_forward_expand(gf, ggml_cpy(ctx0,
+        ggml_reshape_2d(ctx0, block, n_embd, n_tokens),
+        ggml_view_3d(ctx0, stack, n_embd, 1, n_tokens, stack->nb[1], stack->nb[2], (n_slot - 1 - j)*stack->nb[1])));
+}
+
