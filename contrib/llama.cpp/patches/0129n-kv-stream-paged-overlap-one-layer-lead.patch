+    ggml_cl_region rk[2], rv[2];
+    if (ggml_cl_regions(ring_k, rk) != 1 || ggml_cl_regions(ring_v, rv) != 1) return -1;
+    if (rk[0].mem == nullptr || rv[0].mem == nullptr) return -1;
+    const int ps = ggml_get_op_params_i32(dst, GGML_FA_PARAM_PAGE_SIZE);
+    if (ps <= 0) return -1;
+    const size_t kb = (size_t) host_k->nb[2], vb = (size_t) host_v->nb[2];
+    const size_t rb = (size_t) ring_k->nb[1], rvb = (size_t) ring_v->nb[1];
+    const cl_ulong k_off = rk[0].off + (cl_ulong) ring_k->view_offs;
+    const cl_ulong v_off = rv[0].off + (cl_ulong) ring_v->view_offs;
+    size_t k_size = 0, v_size = 0;
+    CL_CHECK(clGetMemObjectInfo(rk[0].mem, CL_MEM_SIZE, sizeof(k_size), &k_size, NULL));
+    CL_CHECK(clGetMemObjectInfo(rv[0].mem, CL_MEM_SIZE, sizeof(v_size), &v_size, NULL));
+    const int64_t n_pages = plan->ne[0];
+    int runs = 0;
+    for (int64_t p = 0; p < n_pages; ) {
+        const int32_t row = pl[p];
+        if (row < 0) { ++p; continue; }
+        int64_t n = 1;   // pages in this run: consecutive pages, consecutive ring rows
+        while (p + n < n_pages && pl[p + n] == row + (int32_t) n) ++n;
+        const cl_ulong dk = k_off + (cl_ulong) row*ps*rb;
+        const cl_ulong dv = v_off + (cl_ulong) row*ps*rvb;
+        if (dk + (cl_ulong) n*kb > k_size || dv + (cl_ulong) n*vb > v_size) {
+            GGML_ABORT("ggml_opencl: a paged FA copy runs past its ring slot (page %lld row %d, "
+                       "%lld pages, K off %llu + %zu / %zu, V off %llu + %zu / %zu)", (long long) p, row,
+                       (long long) n, (unsigned long long) dk, (size_t) n*kb, k_size,
+                       (unsigned long long) dv, (size_t) n*vb, v_size);
+        }
+        CL_CHECK(clEnqueueWriteBuffer(cq, rk[0].mem, CL_FALSE, dk, (size_t) n*kb,
+                                      hk + (size_t) p*kb, nw, nw ? wl : NULL, NULL));
+        CL_CHECK(clEnqueueWriteBuffer(cq, rv[0].mem, CL_FALSE, dv, (size_t) n*vb,
+                                      hv + (size_t) p*vb, nw, nw ? wl : NULL, NULL));
+        runs += 2;   // K and V: each a command
+        p += n;
+    }
+    return runs;
+}
