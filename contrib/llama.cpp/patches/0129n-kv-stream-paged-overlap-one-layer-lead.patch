+    const char * hk = (const char *) ggml_backend_opencl_usm_ptr(host_k);
+    const char * hv = (const char *) ggml_backend_opencl_usm_ptr(host_v);
+    const int32_t * pl = (const int32_t *) ggml_backend_opencl_usm_ptr(plan);
+    if (hk == nullptr || hv == nullptr) return -1;
+    std::vector<int32_t> pl_local;   // a plan the backend placed on the device: read it once
+    if (pl == nullptr) {
+        auto * ex = (ggml_tensor_extra_cl *) plan->extra;
+        if (ex == nullptr) return -1;
+        pl_local.resize((size_t) plan->ne[0]);
+        CL_CHECK(clEnqueueReadBuffer(ctx->queue, ex->data_device, CL_TRUE, ex->offset,
+                pl_local.size()*sizeof(int32_t), pl_local.data(), 0, NULL, NULL));
+        pl = pl_local.data();
