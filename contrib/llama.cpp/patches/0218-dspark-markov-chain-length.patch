         ggml_tensor * markov  = w1_prev;
 
@@ -550,11 +555,21 @@ static void build_dspark_markov_head(llm_graph_context & g, const llama_model &
             cat_conf = cat_conf ? ggml_concat(ctx0, cat_conf, conf, 1) : conf;
         }
 
-        if (i + 1 < block_drafts) {
+        if (i + 1 < n_chain) {
             prev = ggml_argmax(ctx0, col);
         }
     }
 
+    // 0218: the rows past the chain, the base logits as they are (the confidence head, if any, reads 0 there)
+    for (int64_t i = n_chain; i < block_drafts; ++i) {
+        ggml_tensor * col = ggml_cont(ctx0, ggml_view_2d(ctx0, base, n_vocab, n_blocks, base_stride, i*base->nb[1]));
+        cat = cat ? ggml_concat(ctx0, cat, col, 1) : col;
