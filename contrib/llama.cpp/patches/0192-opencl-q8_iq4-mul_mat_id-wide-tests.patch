+// 0190: the wide tile's own text, assembled as the backend assembles it (the
+// helpers, the mm source's tables, the wide kernels) and compiled when a clang
+// is present. Its geometry is the dispatch's: 16 sub-groups of 16 lanes, two
+// columns a lane, so 512 columns a work-group.
+static void check_wide_text(void) {
+    bool ok_w = false, ok_inc = false, ok_f16 = false;
+    const std::string w   = read_text(KQ_I8_WIDE_PATH, &ok_w);
+    const std::string inc = read_text(KQ_I8_INC_PATH, &ok_inc);
+    const std::string f16 = read_text(KQ_I8_F16_PATH, &ok_f16);
+    CHECK(ok_w,   "opencl-wide: mul_mm_kq_i8_wide.cl is readable");
+    if (!ok_w || !ok_inc || !ok_f16) return;
+    const std::string cl = strip_comments(w);
+    for (const char * arg : { "#define I8W_XSG 16", "#define I8W_NC 2", "#define I8W_XT 32" }) {
+        const bool has = cl.find(arg) != std::string::npos || w.find(arg) != std::string::npos;
+        CHECK(has, "opencl-wide: the geometry the dispatch assumes is in the source");
+    }
+    // both kernels of the file exist: the IQ4_NL one the int8 arm takes and the
+    // Q8_0 one its prompt arm takes
+    CHECK(has_ident(cl, "kernel_mul_mm_id_iq4_nl_i8_wide"), "opencl-wide: the IQ4_NL wide kernel");
+    CHECK(has_ident(cl, "kernel_mul_mm_id_q8_0_i8_wide"),   "opencl-wide: the Q8_0 wide kernel");
+    // every kq_i8_* helper it calls is defined in the .inc's OpenCL part
+    const std::string inc_cl = strip_comments(opencl_part(inc));
+    std::vector<std::string> called;
+    for (size_t at = 0; (at = cl.find("kq_i8_", at)) != std::string::npos; ) {
+        size_t e = at + 6;
+        while (e < cl.size() && (std::isalnum((unsigned char)cl[e]) || cl[e] == '_')) ++e;
+        const std::string nm = cl.substr(at, e - at);
+        if (std::find(called.begin(), called.end(), nm) == called.end()) called.push_back(nm);
+        at = e;
+    }
+    CHECK(!called.empty(), "opencl-wide: the wide kernels call kq_i8_* helpers");
+    for (const std::string & nm : called) {
+        const bool defined = has_ident(inc_cl, nm);
+        if (!defined) std::printf("FAIL: opencl-wide: the kernel calls %s, not defined in the .inc\n", nm.c_str());
+        CHECK(defined, "opencl-wide: every kq_i8_* the wide kernels call is in the OpenCL part");
+    }
+    for (const char * tok : { "nullptr", "std::", "template<", "constexpr", "static_cast", "reinterpret_cast" }) {
+        const bool bad = cl.find(tok) != std::string::npos;
+        if (bad) std::printf("FAIL: opencl-wide: C++-only token %s in the OpenCL source\n", tok);
+        CHECK(!bad, "opencl-wide: no C++-only token");
+    }
+    for (const char * nm : { "half", "float", "double", "int", "char", "short", "long",
+                             "uchar", "ushort", "uint", "ulong", "bool", "void" }) {
+        const bool bad = reserved_ident(cl, nm);
+        if (bad) std::printf("FAIL: opencl-wide: reserved type name %s used as an identifier\n", nm);
+        CHECK(!bad, "opencl-wide: no reserved type name used as an identifier");
+    }
+    const std::string cc = find_clang();
+    if (cc.empty()) {
+        std::printf("note: no clang; the wide program's compile is skipped\n");
+        return;
+    }
+    std::FILE * f = std::fopen(KQ_I8_WIDE_ASSEMBLED_PATH, "wb");
+    CHECK(f != nullptr, "opencl-wide: the assembled wide program is writable");
+    if (f == nullptr) return;
+    const std::string all = std::string(kq_i8_prelude) + inc + f16 + w;
+    std::fwrite(all.data(), 1, all.size(), f);
+    std::fclose(f);
+    const std::string cmd = cc + " -target spir64 -x cl -cl-std=CL3.0 -DSG=16" +
+                            " -fsyntax-only \"" + KQ_I8_WIDE_ASSEMBLED_PATH + "\" >/dev/null 2>&1";
+    const int rc = std::system(cmd.c_str());
+    if (rc != 0) std::printf("FAIL: opencl-wide: the assembled wide program does not compile (%s)\n", cc.c_str());
+    CHECK(rc == 0, "opencl-wide: the assembled wide program compiles as OpenCL C");
+}
