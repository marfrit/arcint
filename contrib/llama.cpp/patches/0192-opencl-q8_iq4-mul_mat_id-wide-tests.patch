+// 0190: the wide tile's knob. Unset is OFF, which is the whole point of the
+// patch: with the knob unset no wide program is built and the narrow tile runs
+// as today.
+static void check_wide(void) {
+    CHECK(kq_i8_wide_wanted(nullptr) == 0, "wide: unset -> off");
+    CHECK(kq_i8_wide_wanted("") == 0, "wide: empty -> off");
+    CHECK(kq_i8_wide_wanted("0") == 0, "wide: =0 -> off");
+    CHECK(kq_i8_wide_wanted("off") == 0, "wide: off -> off");
+    CHECK(kq_i8_wide_wanted("OFF") == 0, "wide: OFF -> off");
+    CHECK(kq_i8_wide_wanted("1") == 1, "wide: =1 -> on");
+    CHECK(kq_i8_wide_wanted("on") == 1, "wide: on -> on");
+    CHECK(kq_i8_wide_wanted("ON") == 1, "wide: ON -> on");
+    CHECK(kq_i8_wide_wanted("yes") == 0, "wide: an unparsable word -> off");
+}
