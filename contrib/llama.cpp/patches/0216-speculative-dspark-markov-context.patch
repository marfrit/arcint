0216: the pin's speculative driver for the DSpark drafter (common/speculative.cpp, --spec-type draft-dspark, PR #32218): the Markov context row carried from the target's features into each draft block.

diff --git a/common/speculative.cpp b/common/speculative.cpp
index 7010933..5a4afff 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1015,6 +1015,16 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
     // dspark speculators
     bool sample_from_anchor = true;
 
+    // the Markov head reads the context state of the last committed token (Inkling2 f_rnn)
+    // it comes back from the injection as h_nextn, kept for the last ctx_rows positions of each sequence
+    bool has_markov_context = false;
+    size_t ctx_rows = 0;
+    std::vector<float>     ctx_embd;
+    std::vector<llama_pos> ctx_pos;
+
+    // per-token state of the block tokens, n_embd_dec wide: the context state on the anchor row, zero on the draft rows
+    std::vector<float> block_state;
+
     // block-internal attention
     bool causal_attn = false;
 
@@ -1055,6 +1065,19 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             if (llama_model_meta_val_str(model_dft, "dflash.attention.causal", buf, sizeof(buf)) >= 0) {
                 causal_attn = std::strcmp(buf, "true") == 0;
             }
+            if (is_dspark && llama_model_meta_val_str(model_dft, "dflash.has_markov_context", buf, sizeof(buf)) >= 0) {
+                has_markov_context = std::strcmp(buf, "true") == 0;
+            }
+        }
+
+        if (has_markov_context) {
+            if (n_embd_dec != n_embd_tgt) {
+                throw std::runtime_error("DSpark draft with a markov context: its width differs from the target's");
+            }
+            ctx_rows = (size_t) block_size + 1;
+            ctx_embd.resize((size_t) n_seq * ctx_rows * (size_t) n_embd_dec);
+            ctx_pos.assign((size_t) n_seq * ctx_rows, -1);
+            block_state.reserve((size_t) n_seq * block_size * n_embd_dec);
         }
 
         selector_top_k = llama_model_dflash_selector_top_k(model_dft);
@@ -1083,8 +1106,8 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
 
         LOG_INF("%s: adding speculative implementation '%s'\n", __func__, common_speculative_type_to_str(type).c_str());
         LOG_INF("%s: - n_max=%d, n_min=%d, p_min=%.2f\n", __func__, this->params.n_max, this->params.n_min, this->params.p_min);
-        LOG_INF("%s: - block_size=%d, mask_token_id=%d, n_extract=%u, sample_from_anchor=%s\n", __func__,
-                block_size, mask_token_id, target_layer_ids_n, sample_from_anchor ? "true" : "false");
+        LOG_INF("%s: - block_size=%d, mask_token_id=%d, n_extract=%u, sample_from_anchor=%s, has_markov_context=%s\n", __func__,
+                block_size, mask_token_id, target_layer_ids_n, sample_from_anchor ? "true" : "false", has_markov_context ? "true" : "false");
 
         // DFlash input is [id_last, <mask> * (block_size-1)]: in-place denoising yields at most
         // block_size-1 draft tokens, anchor-first DSpark yields a full block_size draft tokens
@@ -1134,7 +1157,8 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         }
 
         // DFlash2 reads its selector lattice from h_nextn and never consumes raw logits.
-        llama_set_embeddings_nextn(ctx_dft, true, /*masked*/ !is_dflash2 && !is_lilicorr);
+        // with a markov context the state is read back from h_nextn at every injected row
+        llama_set_embeddings_nextn(ctx_dft, true, /*masked*/ !is_dflash2 && !is_lilicorr && !has_markov_context);
         llama_set_causal_attn(ctx_dft, causal_attn); // DFlash needs non-causal attention unless the model says otherwise
     }
 
@@ -1249,6 +1273,23 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
                             __func__, rc, (int) n_chunk, (int) offset);
                     return false;
                 }
+                if (has_markov_context) {
+                    // keep f_rnn of the last positions: the block reads the one of the token before it
+                    const float * state = llama_get_embeddings_nextn(ctx_dft);
+                    if (state) {
+                        const llama_pos pos_min = std::max(0, batch_inject.tokens.back().pos[0] - block_size);
+                        for (int32_t i = 0; i < n_chunk; ++i) {
+                            const llama_pos pos = batch_inject.tokens[i].pos[0];
+                            if (pos < pos_min) {
+                                continue;
+                            }
+                            const size_t slot = (size_t) seq_id * ctx_rows + (size_t) pos % ctx_rows;
+                            std::memcpy(ctx_embd.data() + slot * (size_t) n_embd_dec,
+                                    state + (size_t) i * n_embd_dec, (size_t) n_embd_dec * sizeof(float));
+                            ctx_pos[slot] = pos;
+                        }
+                    }
+                }
                 if (is_lilicorr) {
                     // Ordinary DFlash can write to the KV cache, but LiliCorr needs to store embeddings across sequences.
                     const float * projected = llama_get_embeddings_nextn(ctx_dft);
@@ -1283,12 +1324,29 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         std::vector<int32_t> i_block_beg(n_seq, -1);
         std::vector<int32_t> n_block    (n_seq,  0);
 
+        block_state.clear();
+
         for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
             auto & dp = dparams[seq_id];
             if (!dp.drafting) {
                 continue;
             }
 
+            // the Markov head reads the context state of the token before the block, no draft without it
+            const float * state = nullptr;
+            if (has_markov_context) {
+                const llama_pos pos = dp.pos0 - 1;
+                if (pos >= 0) {
+                    const size_t slot = (size_t) seq_id * ctx_rows + (size_t) pos % ctx_rows;
+                    if (ctx_pos[slot] == pos) {
+                        state = ctx_embd.data() + slot * (size_t) n_embd_dec;
+                    }
+                }
+                if (!state) {
+                    continue;
+                }
+            }
+
             common_sampler_reset(smpls[seq_id].get());
 
             const int32_t n = (int32_t) dp.pos0;
@@ -1305,6 +1363,17 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
                     const size_t slot = (size_t) seq_id * lilicorr_rows + (size_t) pos % lilicorr_rows;
                     batch.set_embd_state(idx, { lilicorr_embd.data() + slot * (size_t) n_embd_dec, 1, (size_t) n_embd_dec });
                 }
+                if (state) {
+                    // reserved up front, so the views of the earlier tokens stay valid
+                    GGML_ASSERT(block_state.size() + n_embd_dec <= block_state.capacity());
+                    const size_t off = block_state.size();
+                    if (i == 0) {
+                        block_state.insert(block_state.end(), state, state + n_embd_dec);
+                    } else {
+                        block_state.resize(off + n_embd_dec, 0.0f);
+                    }
+                    batch.set_embd_state(idx, { block_state.data() + off, 1, (size_t) n_embd_dec });
+                }
             }
         }
 
