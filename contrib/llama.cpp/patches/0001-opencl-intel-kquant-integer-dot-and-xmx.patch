+    const int ncols = (int)(src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    if (ti < 0 || ncols <= 4 || !ggml_cl_kq_mul_mat_shape(src0, src1, dst)) {
+        return false;
+    }
+    cl_kernel kernel = backend_ctx->kernel_mul_mm_kq_f16[ti];
