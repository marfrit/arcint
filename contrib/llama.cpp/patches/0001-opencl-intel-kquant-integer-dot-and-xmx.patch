+static int ggml_cl_kq_type_index(ggml_type t) {
+    return t == GGML_TYPE_Q4_K ? 0 : (t == GGML_TYPE_Q5_K ? 1 : (t == GGML_TYPE_Q6_K ? 2 : -1));
