+        win_base.clear();
+        win_size.clear();
+        win_head.clear();
+        return true;
+    }
+    if (n_stream != 1 || other != nullptr || (uint32_t) n_seq > n_seq_max) {
+        LLAMA_LOG_WARN("%s: windows need one unified stream of its own (streams %u, shared %d, %d of %u sequences)\n",
