+        win_size[i] = n_cells[i];
+        win_head[i] = base;
+        base += n_cells[i];
+    }
+    LLAMA_LOG_INFO("%s: %d windows over %u cells\n", __func__, n_seq, cells.size());
+    return true;
 }
 
