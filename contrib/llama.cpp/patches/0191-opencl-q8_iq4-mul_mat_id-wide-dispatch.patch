+// ---- the wide tile (host-only) ----
+// GGML_OPENCL_KQ_MM_ID_I8_WIDE: the int8 expert tile at a 512-column band a
+// work-group (mul_mm_kq_i8_wide.cl) instead of 128. Unset is OFF: with the knob
+// unset no wide program is built and both int8 formats keep the narrow tile,
+// bit-identical. `1` or `on` (case-insensitive) turns it on; any other value,
+// `0` and `off` leave it off.
+static inline int kq_i8_wide_wanted(const char *env) {
+    if (env == 0 || env[0] == 0) return 0;
+    if (env[0] == '0') return 0;                 // "0", "0x", anything starting 0
+    if (kq_i8_lower(env[0]) == 'o') {
+        const char *c = env, *o = "off";
+        while (*c != 0 && *o != 0 && kq_i8_lower(*c) == *o) { ++c; ++o; }
+        if (c != env && *o == 0 && *c == 0) return 0;
+    }
+    if (kq_i8_lower(env[0]) == 'o') {
+        const char *c = env, *o = "on";
+        while (*c != 0 && *o != 0 && kq_i8_lower(*c) == *o) { ++c; ++o; }
+        if (c != env && *o == 0 && *c == 0) return 1;
+    }
+    return env[0] == '1' ? 1 : 0;                // "1", "1..." on; anything else off
+}
