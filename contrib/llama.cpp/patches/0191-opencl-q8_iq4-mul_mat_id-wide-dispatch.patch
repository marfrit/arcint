+        return 1;
+    }
+    const ggml_backend_opencl_buffer_context * bctx = (const ggml_backend_opencl_buffer_context *) soa0->buffer->context;
+    if (bctx->usm) {
+        return 0;   // the kernel reads the bank's base through a pointer argument
+    }
+    if (src0->type == GGML_TYPE_Q8_0 && src0->extra != nullptr) {
+        const ggml_tensor_extra_cl_q8_0 * e = (const ggml_tensor_extra_cl_q8_0 *) soa0->extra;
+        ggml_cl_bounds(arm, "q", e->q, q_upto);
+        ggml_cl_bounds(arm, "d", e->d, d_upto);
+        return 1;
+    }
+    if (src0->type == GGML_TYPE_IQ4_NL) {
+        const ggml_tensor_extra_cl_iq4_nl * e = (const ggml_tensor_extra_cl_iq4_nl *) soa0->extra;
