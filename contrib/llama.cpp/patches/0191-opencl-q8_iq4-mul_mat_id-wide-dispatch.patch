+// 0191: the weight planes a MUL_MAT_ID launch reads, bound as ggml_cl_kq_weight_args
+// actually passes them: a gathered/streamed stage buffer, a SoA extra's q/d (offsets
+// included), and nothing at a USM bank, which is a pointer argument and has no cl_mem
+// to compare a size against. Returns 1 when a plane was checked.
+static int ggml_cl_kq_plane_bounds(const ggml_tensor * src0, const char * arm,
+                                   size_t q_upto, size_t d_upto) {
+    const ggml_tensor * soa0 = src0->view_src != nullptr ? src0->view_src : src0;
