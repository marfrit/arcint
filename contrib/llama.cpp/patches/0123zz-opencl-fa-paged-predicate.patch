+                              op->src[GGML_FA_SRC_RING_V]->ne[1] == op->src[GGML_FA_SRC_RING_K]->ne[1]);
+
                 load_cl_kernels(backend_ctx);
                 const int gi = k->type == GGML_TYPE_Q8_0 ? (v->type == GGML_TYPE_Q8_0 ? 1 : 2)
                              : k->type == GGML_TYPE_Q4_0 ? 3 : 0;
-                // a prompt's rows take the gather path (I4): the conversion kernel reads
