diff --git a/ggml/src/ggml-opencl/ggml-opencl-fa-paged.h b/ggml/src/ggml-opencl/ggml-opencl-fa-paged.h
new file mode 100644
index 0000000..8324440
--- /dev/null
+++ b/ggml/src/ggml-opencl/ggml-opencl-fa-paged.h
@@ -0,0 +1,55 @@
+#pragma once
+
+// The paged FLASH_ATTN_EXT predicate (0119's page table, 0122/0123z's kernels),
+// as plain data so a device-free test drives the same logic the backend's
+// supports_op runs (arcint's tests/test_fa_paged_predicate.cpp). The kernel
+// improvements live in flash_attn_gqa_dpas.cl (decode) and flash_attn_dpas.cl's
+// conversion (prefill); a false here must mean the kernel cannot read the case.
+
+#include <cstdint>
+
+struct ggml_cl_fa_paged_shape {
+    // tensor types, as enum ggml_type values
+    int q_type, k_type, v_type;
+    // dimensions of q, k, v at the index positions (0 the head width, 1 the
+    // cells, 2 the heads, 3 the streams)
+    int64_t q_ne1, q_ne2, q_ne3;
+    int64_t k_ne0, k_ne2, k_ne3;
+    int64_t v_ne0, v_ne2, v_ne3;
+    // the page table: I32, contiguous, [n_pages, n_tables]
+    bool    table_ok;
+    // a full-width mask (a compact mask is I5's)
+    bool    mask_ok;
+    // the ring rows are whole pages and its K/V pair is present or absent together
+    bool    ring_ok;
+    // the kernels that read the shape are built: the GQA decode kernel for rows
+    // within its cap, the conversion + f16 prompt kernel for a prompt
+    bool    kernels_decode, kernels_prefill;
+};
+
+// the KV pair the kernels were built for
+static inline bool ggml_cl_fa_paged_kv_ok(const ggml_cl_fa_paged_shape & s) {
+    // the agent's cache pair and the other pairs the kernels were built for
+    const bool kv_ok =
+        (s.k_type == 8 /* Q8_0 */ && s.v_type == 4 /* Q4_0 */) ||
+        (s.k_type == 8 /* Q8_0 */ && s.v_type == 8 /* Q8_0 */) ||
+        (s.k_type == 4 /* Q4_0 */ && s.v_type == 4 /* Q4_0 */) ||
+        (s.k_type == 1 /* F16  */ && s.v_type == 1 /* F16  */);
+    return kv_ok;
+}
+
+// the tensor shapes the kernels index
+static inline bool ggml_cl_fa_paged_shape_ok(const ggml_cl_fa_paged_shape & s) {
+    return s.q_type == 0 /* F32 */ && s.q_ne1 >= 1 && s.q_ne3 == 1 &&
+           s.k_ne0 == 256 && s.v_ne0 == 256 &&
+           s.k_ne3 == 1 && s.v_ne3 == 1 &&
+           s.k_ne2 > 0 && s.v_ne2 == s.k_ne2 && s.q_ne2 % s.k_ne2 == 0;
+}
+
+// true exactly where the kernels handle a paged case
+static inline bool ggml_cl_fa_paged_ok(const ggml_cl_fa_paged_shape & s) {
+    const bool gqa_rows = (s.q_ne2 / s.k_ne2) * s.q_ne1 <= 64;   // the decode kernel's cap
+    const bool kernels_ok = gqa_rows ? s.kernels_decode : s.kernels_prefill;
+    return s.table_ok && ggml_cl_fa_paged_kv_ok(s) && ggml_cl_fa_paged_shape_ok(s) &&
+           s.mask_ok && s.ring_ok && kernels_ok;
+}
