-                const bool prefill_ok = backend_ctx->kernel_fa_kv_to_f16 != nullptr &&
-                                        (backend_ctx->kernel_fa_dpas_carry_dk[0] != nullptr ||
-                                         backend_ctx->kernel_fa_dpas_q_dk[0] != nullptr);
-                const bool rows_gqa = (q->ne[2]/k->ne[2]) * q->ne[1] <= 64;
-                const bool kernel_ok = rows_gqa
-                                     ? (backend_ctx->kernel_fa_gqa_dk[0][gi] != nullptr ||
