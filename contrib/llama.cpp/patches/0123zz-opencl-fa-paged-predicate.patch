-                                     : prefill_ok;
-                return page_table_ok && kv_ok && shape_ok && mask_ok && kernel_ok;
+                sh.kernels_decode = backend_ctx->kernel_fa_gqa_dk[0][gi] != nullptr ||
+                                    backend_ctx->kernel_fa_gqa_st_dk[0][gi] != nullptr;
+                sh.kernels_prefill = backend_ctx->kernel_fa_kv_to_f16 != nullptr &&
+                                     (backend_ctx->kernel_fa_dpas_carry_dk[0] != nullptr ||
+                                      backend_ctx->kernel_fa_dpas_q_dk[0] != nullptr);
+                const bool ok = ggml_cl_fa_paged_ok(sh);
+                if (getenv("GGML_OPENCL_FA_PAGED_DEBUG")) {
+                    GGML_LOG_INFO("ggml_opencl: paged FA: table %d kv %d shape %d mask %d ring %d "
+                                  "gqa-kernel %d prefill-kernel %d -> %d\n",
+                                  sh.table_ok, ggml_cl_fa_paged_kv_ok(sh), ggml_cl_fa_paged_shape_ok(sh),
