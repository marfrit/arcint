+                ggml_cl_fa_paged_shape sh{};
+                sh.q_type = (int) q->type; sh.k_type = (int) k->type; sh.v_type = (int) v->type;
+                sh.q_ne1 = q->ne[1]; sh.q_ne2 = q->ne[2]; sh.q_ne3 = q->ne[3];
+                sh.k_ne0 = k->ne[0]; sh.k_ne2 = k->ne[2]; sh.k_ne3 = k->ne[3];
+                sh.v_ne0 = v->ne[0]; sh.v_ne2 = v->ne[2]; sh.v_ne3 = v->ne[3];
+                sh.table_ok = pages->type == GGML_TYPE_I32 && ggml_is_contiguous(pages) &&
