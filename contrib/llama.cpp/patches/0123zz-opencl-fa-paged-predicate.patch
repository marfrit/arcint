+// A paged FLASH_ATTN_EXT reads one table row: `pages` may be a device tensor (test-backend-ops
+// allocates its tensors on the backend) or a host graph input (llama's page table is a host
+// tensor). A device tensor's row is passed with its byte offset; a host tensor's row is
+// uploaded on the compute queue and released after the queued command. Reading the host
+// `data` pointer of a device tensor was window 228's crash: row 0 then held INT32_MAX and a
+// pool row of 2^31 rows went out of bounds.
+struct ggml_cl_fa_table {
+    cl_mem    mem  = NULL;
+    cl_ulong  off  = 0;
+    bool      uploaded = false;
+};
+
+static ggml_cl_fa_table ggml_cl_fa_table_row(ggml_backend_opencl_context * backend_ctx, const ggml_tensor * pages, int32_t row) {
+    ggml_cl_fa_table t;
+    const size_t row_bytes = (size_t) pages->nb[1];
+    ggml_tensor_extra_cl * extra = pages ? (ggml_tensor_extra_cl *) pages->extra : NULL;
+    if (extra && extra->data_device != NULL) {
+        t.mem = extra->data_device;
+        t.off = extra->offset + pages->view_offs + (cl_ulong) row*row_bytes;
+        return t;
+    }
+    cl_int err = CL_SUCCESS;
+    t.mem = clCreateBuffer(backend_ctx->context, CL_MEM_READ_ONLY, row_bytes, NULL, &err);
+    CL_CHECK(err);
+    CL_CHECK(clEnqueueWriteBuffer(backend_ctx->queue, t.mem, CL_FALSE, 0, row_bytes,
+            (const char *) pages->data + (size_t) row*row_bytes, 0, NULL, NULL));
+    t.uploaded = true;
+    return t;
+}
