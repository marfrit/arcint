0141: the CPU flash-attention reference adds the indexed bias to the mask in both score loops (one chunk and the tiled path), rounds mask+bias to F16 once, applies the ALiBi slope after it, reads a bin past n_bins as no bias and keeps a -INFINITY mask entry -INFINITY.

--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8960,6 +8960,23 @@ void ggml_compute_forward_top_k(
     }
 }
 
+// the indexed bias of a GGML_OP_FLASH_ATTN_EXT: table[head, indices[key, query], query], 0.0f when there is none
+static inline float ggml_flash_attn_ext_get_indexed_bias(const ggml_tensor * dst, int64_t query, int64_t head, int64_t key) {
+    const ggml_tensor * table   = dst->src[GGML_FA_SRC_BIAS_TABLE];
+    const ggml_tensor * indices = dst->src[GGML_FA_SRC_BIAS_IDX];
+
+    if (!table) {
+        return 0.0f;
+    }
+
+    const int32_t bin = ((const int32_t *) indices->data)[query*indices->ne[0] + key];
+    if ((uint32_t) bin >= (uint32_t) table->ne[1]) {
+        return 0.0f;
+    }
+
+    return ((const float *) table->data)[(query*table->ne[1] + bin)*table->ne[0] + head];
+}
+
 static void ggml_compute_forward_flash_attn_ext_f16_one_chunk(
         const ggml_compute_params * params,
         ggml_tensor * dst,
