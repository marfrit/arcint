@@ -0,0 +1,182 @@
+// 0241: the DSpark shortlist's pick against the full chain's, the ops as src/models/dflash.cpp composes them
+// (build_dspark_markov_head, the use_short branch), on the CPU backend (default) or the first GPU (argv[1] = "gpu").
+//   full:  argmax_V( softcap(base + w2 . m + b) )                                    (ggml's rule: the last maximum)
+//   short: idx = top_k_ordered(base, K); the same over the K gathered candidates; argmax over them; idx[argmax]
+// Cases (each prints PASS / FAIL; exit 0 when all pass):
+//   kv     K = V on random rows: the same id as the full chain, every row
+//   k256   K = 256 on rows built so the full chain's argmax lies in the base top-256: the same id
+//   tie    K = V, a row with an exact tie at the maximum between two ids the top-k does not return in index
+//          order: the pick must be the higher id (as the full chain's ARGMAX)
+//   cut    K = 256, base ties exactly at rank 256 / 257: top_k_ordered takes the higher id, the same set every run
+//   det    the K = 256 indices of one row, 20 runs: identical
+// DSPARK_SHORTLIST_RED=1: the red pick: the candidates in descending id order (the ordered top-k reversed: an order
+// that is not the ids') and the position from ARGMAX taken as it is: the last maximum is then the LOWER tied id, so the
+// tie case must fail, deterministically.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static const int   R = 256;
+static int         V = 200058;   // the row width of the current case (Inkling 2's vocabulary, or 1,000 for K = V)
+static const float CAP = 30.0f;
+static int g_fail = 0;
+static bool g_red = false;
+
+struct Run {
+    ggml_backend_t be;
+    std::vector<int32_t> full, shortl, idx_row0;
+};
+
+// one graph: n_rows independent rows (base [V, n], fold w2 [R, V], bias [V], markov m [R, n])
+static void run(ggml_backend_t be, int K, const std::vector<float> & base, const std::vector<float> & w2,
+                const std::vector<float> & b, const std::vector<float> & m, int n, Run & out) {
+    ggml_init_params ip = { 64 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * cw = ggml_init(ip);
+    ggml_tensor * tb = ggml_new_tensor_2d(cw, GGML_TYPE_F32, V, n);
+    ggml_tensor * tw = ggml_new_tensor_2d(cw, GGML_TYPE_F32, R, V);
+    ggml_tensor * tbias = ggml_new_tensor_1d(cw, GGML_TYPE_F32, V);
+    ggml_tensor * tm = ggml_new_tensor_2d(cw, GGML_TYPE_F32, R, n);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(cw, be);
+    ggml_backend_tensor_set(tb, base.data(), 0, ggml_nbytes(tb));
+    ggml_backend_tensor_set(tw, w2.data(), 0, ggml_nbytes(tw));
+    ggml_backend_tensor_set(tbias, b.data(), 0, ggml_nbytes(tbias));
+    ggml_backend_tensor_set(tm, m.data(), 0, ggml_nbytes(tm));
+
+    ggml_context * cx = ggml_init(ip);
+    // full
+    ggml_tensor * col = ggml_add(cx, tb, ggml_add(cx, ggml_mul_mat(cx, tw, tm), tbias));   // dflash's order: base + (w.m + b)
+    col = ggml_scale(cx, ggml_tanh(cx, ggml_scale(cx, col, 1.0f / CAP)), CAP);
+    ggml_tensor * full = ggml_argmax(cx, col);
+    // short (as dflash.cpp's use_short branch, one block a row: n_blocks = n rows)
+    ggml_tensor * idx = ggml_top_k_ordered(cx, tb, K);                                           // [K, n]
+    ggml_tensor * rev = nullptr;
+    if (g_red) {   // the red: the candidates in DESCENDING id order (not index order), the position taken as is
+        rev = ggml_new_tensor_2d(cx, GGML_TYPE_I32, K, n);
+        ggml_set_input(rev);
+        idx = ggml_reshape_2d(cx, ggml_get_rows(cx, ggml_reshape_3d(cx, idx, 1, K, n), rev), K, n);
+    }
+    ggml_tensor * idx_flat = ggml_reshape_1d(cx, idx, (int64_t) K * n);
+    ggml_tensor * bk = ggml_reshape_2d(cx, ggml_get_rows(cx, ggml_reshape_3d(cx, tb, 1, V, n), idx), K, n);
+    ggml_tensor * fk = ggml_reshape_3d(cx, ggml_get_rows(cx, tw, idx_flat), R, K, n);           // [R, K, n]
+    ggml_tensor * ck = ggml_reshape_2d(cx, ggml_get_rows(cx, ggml_reshape_2d(cx, tbias, 1, V), idx_flat), K, n);
+    ggml_tensor * corr = ggml_reshape_2d(cx, ggml_mul_mat(cx, fk, ggml_reshape_3d(cx, tm, R, 1, n)), K, n);
+    ggml_tensor * colk = ggml_add(cx, bk, ggml_add(cx, corr, ck));   // dflash's order: base + (w.m + b)
+    colk = ggml_scale(cx, ggml_tanh(cx, ggml_scale(cx, colk, 1.0f / CAP)), CAP);
+    ggml_tensor * am = ggml_argmax(cx, colk);
+    ggml_tensor * tok = ggml_reshape_1d(cx, ggml_get_rows(cx, ggml_reshape_3d(cx, idx, 1, K, n), ggml_reshape_2d(cx, am, 1, n)), n);
+    ggml_set_output(full); ggml_set_output(tok); ggml_set_output(idx);
+    ggml_cgraph * gf = ggml_new_graph_custom(cx, 256, false);
+    ggml_build_forward_expand(gf, full);
+    ggml_build_forward_expand(gf, tok);
+    ggml_build_forward_expand(gf, idx);
+    ggml_gallocr_t ga = ggml_gallocr_new(ggml_backend_get_default_buffer_type(be));
+    bool alloc_ok = ggml_gallocr_alloc_graph(ga, gf);
+    if (alloc_ok && rev != nullptr) {
+        std::vector<int32_t> r(K * (size_t) n);
+        for (int j = 0; j < n; ++j) for (int c = 0; c < K; ++c) r[(size_t) j * K + c] = K - 1 - c;
+        ggml_backend_tensor_set(rev, r.data(), 0, ggml_nbytes(rev));
+    }
+    if (!alloc_ok || ggml_backend_graph_compute(be, gf) != GGML_STATUS_SUCCESS) {
+        printf("SHORTLIST FAIL: the graph did not run\n"); g_fail = 1; return;
+    }
+    out.full.resize(n); out.shortl.resize(n); out.idx_row0.resize(K);
+    ggml_backend_tensor_get(full, out.full.data(), 0, sizeof(int32_t) * n);
+    ggml_backend_tensor_get(tok, out.shortl.data(), 0, sizeof(int32_t) * n);
+    ggml_backend_tensor_get(idx, out.idx_row0.data(), 0, sizeof(int32_t) * K);
+    ggml_gallocr_free(ga); ggml_free(cx); ggml_backend_buffer_free(buf); ggml_free(cw);
+}
+
+static void check(const char * name, bool ok, const std::string & why) {
+    printf("SHORTLIST %-6s %s%s%s\n", name, ok ? "PASS" : "FAIL", why.empty() ? "" : ": ", why.c_str());
+    if (!ok) g_fail = 1;
+}
+
+int main(int argc, char ** argv) {
+    g_red = getenv("DSPARK_SHORTLIST_RED") && atoi(getenv("DSPARK_SHORTLIST_RED")) == 1;
+    ggml_backend_t be = nullptr;
+    if (argc > 1 && std::string(argv[1]) == "gpu") {
+        ggml_backend_dev_t d = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+        if (!d) { fprintf(stderr, "no GPU device\n"); return 2; }
+        be = ggml_backend_dev_init(d, nullptr);
+    } else {
+        be = ggml_backend_cpu_init();
+    }
+    printf("SHORTLIST backend %s%s\n", ggml_backend_name(be), g_red ? " -- RED: the stock top-k, the position taken as is" : "");
+    std::mt19937 rng(241);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    const int n = 4;
