+int32_t llama_context::get_dspark_ids(llama_seq_id seq, int32_t * out, int32_t n_max) {
+    synchronize();
+    for (size_t b = 0; b < dspark_ids_seq.size(); ++b) {
+        if (dspark_ids_seq[b] != seq) {
+            continue;
+        }
+        const int32_t n = std::min(n_max, dspark_ids_steps);
+        for (int32_t s = 0; s < n; ++s) {
+            out[s] = dspark_ids[b * (size_t) dspark_ids_steps + (size_t) s];
+        }
+        return n;
+    }
+    return -1;
+}
