+    for (auto & v : w2) v = nd(rng) * 0.05f;
+    for (auto & v : b) v = nd(rng) * 0.1f;
+    for (auto & v : m) v = std::tanh(nd(rng));
+    for (auto & v : base) v = nd(rng) * 3.0f;
+    Run r;
+    // kv: K = V on 1,000-wide rows (the ordered top-k's local sort takes k <= 1,024)
+    V = 1000;
+    std::vector<float> w2s((size_t) R * V), bs(V), bases((size_t) V * n);
+    for (auto & v : w2s) v = nd(rng) * 0.05f;
+    for (auto & v : bs) v = nd(rng) * 0.1f;
+    for (auto & v : bases) v = nd(rng) * 3.0f;
+    run(be, V, bases, w2s, bs, m, n, r);
+    { bool ok = true; std::string why;
+      for (int i = 0; i < n; ++i) if (r.full[i] != r.shortl[i]) { ok = false; why += " row " + std::to_string(i) + ": " + std::to_string(r.full[i]) + " vs " + std::to_string(r.shortl[i]); }
+      check("kv", ok, why); }
+    // k256: the full chain's winner forced into the base top-256 (a large base value at a random id)
+    V = 200058;
+    {
+        std::vector<float> bb = base;
+        for (int i = 0; i < n; ++i) bb[(size_t) i * V + (size_t) (rng() % V)] = 40.0f;
+        run(be, 256, bb, w2, b, m, n, r);
+        bool ok = true; std::string why;
+        for (int i = 0; i < n; ++i) if (r.full[i] != r.shortl[i]) { ok = false; why += " row " + std::to_string(i); }
+        check("k256", ok, why);
+    }
+    // tie: K = V (1,000-wide rows); corrections zero, two equal base maxima: the higher id must win (id 7 in lane 7,
+    // id 300 in lane 44 of the next round of a 256-lane scan)
+    V = 1000;
+    {
+        std::vector<float> z0((size_t) R * V, 0.0f), zb(V, 0.0f), bb((size_t) V * n);
+        for (auto & v : bb) v = nd(rng);
+        const int lo = 7, hi = 300;
+        for (int i = 0; i < n; ++i) { bb[(size_t) i * V + lo] = 50.0f; bb[(size_t) i * V + hi] = 50.0f; }
+        run(be, V, bb, z0, zb, m, n, r);
+        bool ok = true; std::string why;
+        for (int i = 0; i < n; ++i) if (r.shortl[i] != hi || r.full[i] != hi) { ok = false; why += " row " + std::to_string(i) + ": full " + std::to_string(r.full[i]) + " short " + std::to_string(r.shortl[i]); }
+        check("tie", ok, why);
+    }
+    // cut: K = 256 on 200,058-wide rows; 255 values above, then three equal values at ranks 256-258: ids 9, 120000 and 200057 tie;
+    // the ordered top-k takes the highest (200057) and returns ascending ids
+    {
+        V = 200058;
+        std::vector<float> bb((size_t) V * n);
+        for (auto & v : bb) v = -10.0f + nd(rng) * 0.01f;
+        for (int i = 0; i < n; ++i) {
+            for (int t = 0; t < 255; ++t) bb[(size_t) i * V + 1000 + (size_t) t * 7] = 20.0f + (float) t;
+            bb[(size_t) i * V + 9] = 5.0f; bb[(size_t) i * V + 120000] = 5.0f; bb[(size_t) i * V + (V - 1)] = 5.0f;
+        }
+        std::vector<float> z0((size_t) R * V, 0.0f), zb(V, 0.0f);
+        run(be, 256, bb, z0, zb, m, n, r);
+        const bool asc = std::is_sorted(r.idx_row0.begin(), r.idx_row0.end());
+        const bool has_hi = std::find(r.idx_row0.begin(), r.idx_row0.end(), V - 1) != r.idx_row0.end();
+        const bool no_lo = std::find(r.idx_row0.begin(), r.idx_row0.end(), 9) == r.idx_row0.end() &&
+                           std::find(r.idx_row0.begin(), r.idx_row0.end(), 120000) == r.idx_row0.end();
+        check("cut", asc && has_hi && no_lo, std::string(asc ? "" : " not ascending") + (has_hi ? "" : " 200057 missing") + (no_lo ? "" : " a lower tied id taken"));
+        // det: 20 runs of the same row
+        std::vector<int32_t> first = r.idx_row0; bool same = true;
+        for (int t = 0; t < 19 && same; ++t) { run(be, 256, bb, z0, zb, m, n, r); same = r.idx_row0 == first; }
+        check("det", same, same ? "" : " the set or its order changed between runs");
+    }
+    printf("SHORTLIST %s\n", g_fail ? "FAIL" : "PASS");
+    ggml_backend_free(be);
+    return g_fail;
+}
