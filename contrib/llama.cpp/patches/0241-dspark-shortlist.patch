diff --git a/ggml/src/ggml-opencl/kernels/top_k_ordered.cl b/ggml/src/ggml-opencl/kernels/top_k_ordered.cl
new file mode 100644
index 0000000..dbf3907
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/top_k_ordered.cl
@@ -0,0 +1,110 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+
+// 0241: its own program (built on demand, optional: a build failure leaves ggml_top_k_ordered to the CPU with a
+// DOWNGRADE line and the stock argsort / top-k program untouched). The key and the work-group are argsort.cl's.
+#define TOPK_WG 256
+static inline uint topk_key(float f) {
+    const uint u = as_uint(f);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+// 0241: ggml_top_k_ordered. The same radix select as kernel_top_k_f32, then the set made determinate and ordered:
+// when the keys equal to the k-th largest are more than the k still needed (a tie at the cut), the ones with the
+// HIGHEST indices get in (ggml_argmax's rule), scanned in descending chunks of TOPK_WG; the k indices are then sorted
+// ascending in local memory (bitonic, padded to a power of two). k <= TOPK_ORD_MAX.
+#define TOPK_ORD_MAX 1024
+kernel void kernel_top_k_f32_ordered(
+        global const char * src0, ulong offset0,
+        global       char * dst,  ulong offsetd,
+        int ne00, ulong nb01, ulong nb02, ulong nb03,
+        int k,    ulong nb1,  ulong nb2,  ulong nb3) {
+    local int  hist[256];
+    local int  sel[TOPK_ORD_MAX];
+    local int  scan[TOPK_WG];
+    local uint s_prefix;
+    local int  s_need, s_gt, s_eq, s_cnt_eq, s_taken;
+    const int lid = get_local_id(0);
+    const int i1 = get_group_id(0), i2 = get_group_id(1), i3 = get_group_id(2);
+    global const float * x = (global const float *)(src0 + offset0 + i1*nb01 + i2*nb02 + i3*nb03);
+    global int * y = (global int *)(dst + offsetd + i1*nb1 + i2*nb2 + i3*nb3);
+    if (lid == 0) { s_prefix = 0; s_need = k; s_cnt_eq = 0; }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int pass = 0; pass < 4; ++pass) {
+        const int shift = 24 - 8 * pass;
+        const uint mask = pass == 0 ? 0u : (0xFFFFFFFFu << (shift + 8));
+        for (int b = lid; b < 256; b += TOPK_WG) hist[b] = 0;
+        barrier(CLK_LOCAL_MEM_FENCE);
+        const uint prefix = s_prefix;
+        for (int j = lid; j < ne00; j += TOPK_WG) {
+            const uint key = topk_key(x[j]);
+            if ((key & mask) == prefix) atomic_inc(&hist[(key >> shift) & 0xFF]);
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+        if (lid == 0) {
+            int need = s_need, b = 255;
+            for (; b > 0; --b) {
+                if (hist[b] >= need) break;
+                need -= hist[b];
+            }
+            s_prefix = prefix | ((uint)b << shift);
+            s_need = need;
+            if (pass == 3) s_cnt_eq = hist[b];   // the keys equal to T in the row
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    const uint T = s_prefix;
+    const int n_eq = s_need;
+    const int n_gt = k - n_eq;
+    if (lid == 0) { s_gt = 0; s_eq = 0; s_taken = 0; }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    const bool all_eq = s_cnt_eq == n_eq;
+    for (int j = lid; j < ne00; j += TOPK_WG) {
+        const uint key = topk_key(x[j]);
+        if (key > T) {
+            sel[atomic_inc(&s_gt)] = j;
+        } else if (all_eq && key == T) {
+            sel[n_gt + atomic_inc(&s_eq)] = j;
+        }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    if (!all_eq) {
+        // a tie at the cut: the n_eq equal keys with the highest indices, chunk by chunk from the end
+        for (int c0 = ((ne00 - 1) / TOPK_WG) * TOPK_WG; c0 >= 0; c0 -= TOPK_WG) {
+            const int taken = s_taken;
+            if (taken >= n_eq) break;   // uniform: read after the barrier below
+            const int  j = c0 + lid;
+            const bool e = j < ne00 && topk_key(x[j]) == T;
+            // a reversed inclusive scan: scan[r] = equal keys among lanes >= TOPK_WG - 1 - r
+            scan[TOPK_WG - 1 - lid] = e ? 1 : 0;
+            barrier(CLK_LOCAL_MEM_FENCE);
+            for (int off = 1; off < TOPK_WG; off <<= 1) {
+                const int v = lid >= off ? scan[lid - off] : 0;
+                barrier(CLK_LOCAL_MEM_FENCE);
+                scan[lid] += v;
+                barrier(CLK_LOCAL_MEM_FENCE);
+            }
+            const int above = scan[TOPK_WG - 1 - lid] - (e ? 1 : 0);   // equal keys at higher indices in this chunk
+            if (e && taken + above < n_eq) sel[n_gt + taken + above] = j;
+            barrier(CLK_LOCAL_MEM_FENCE);
+            if (lid == 0) s_taken = min(n_eq, taken + scan[TOPK_WG - 1]);
+            barrier(CLK_LOCAL_MEM_FENCE);
+        }
+    }
+    // ascending: a bitonic sort of sel[0..P), the tail padded with INT_MAX
+    int P = 1;
+    while (P < k) P <<= 1;
+    for (int i = lid; i < P; i += TOPK_WG) if (i >= k) sel[i] = INT_MAX;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int size = 2; size <= P; size <<= 1) {
+        for (int stride = size >> 1; stride > 0; stride >>= 1) {
+            for (int t = lid; t < P / 2; t += TOPK_WG) {
+                const int i = 2 * t - (t & (stride - 1));
+                const int jj = i + stride;
+                const bool asc = (i & size) == 0;
+                const int a = sel[i], b = sel[jj];
+                if ((a > b) == asc) { sel[i] = b; sel[jj] = a; }
+            }
+            barrier(CLK_LOCAL_MEM_FENCE);
+        }
+    }
+    for (int i = lid; i < k; i += TOPK_WG) y[i] = sel[i];
+}
