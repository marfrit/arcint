+    local float part[16][4][8];
+    const int row0 = get_group_id(0) * 4;
+    const int lid = get_local_id(0);
+    global const half * w0 = (global const half *)(a + offa) + (ulong)row0 * ne00;
+    float acc[4][8];
+    #pragma unroll
+    for (int r = 0; r < 4; ++r)
+        #pragma unroll
+        for (int c = 0; c < 8; ++c) acc[r][c] = 0.f;
+    for (int k = lid * 8; k < ne00; k += 256 * 8) {
+        float8 w[4];
+        #pragma unroll
+        for (int r = 0; r < 4; ++r) w[r] = row0 + r < ne01 ? vload_half8(0, w0 + (ulong)r * ne00 + k) : (float8)(0.f);
