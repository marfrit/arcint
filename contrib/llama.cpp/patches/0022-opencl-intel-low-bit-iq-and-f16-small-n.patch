+        for (int l = 0; l < 4; ++l) {
+            const uint2 g = LB_TAB2(iq2xxs_grid, (a0 >> (8 * l)) & 0xFF);
+            const uint2 m = LB_TAB2(ksigns64, (a1 >> (7 * l)) & 127);
