+// identity comb: every stream keeps its own residual and adds the block output
+// scaled by its weight
+kernel void kernel_dsv4_hc_post(global const char * x, ulong offx, global const char * r, ulong offr,
+                                global const char * p, ulong offp, global char * d, ulong offd,
+                                int n_embd, int hc, int n_tok, ulong sx0, ulong sx1,
+                                ulong sr0, ulong sr1, ulong sr2, ulong sp0, ulong sp1,
+                                ulong sd0, ulong sd1, ulong sd2) {
+    const int ir = get_global_id(0);
+    if (ir >= n_embd * hc * n_tok) return;
+    const int i0 = ir % n_embd, idst = (ir / n_embd) % hc, it = ir / (n_embd * hc);
+    x += offx; r += offr; p += offp; d += offd;
+    const float v = *(global const float *)(x + i0 * sx0 + it * sx1) * *(global const float *)(p + idst * sp0 + it * sp1) +
+                    *(global const float *)(r + i0 * sr0 + idst * sr1 + it * sr2);
+    *(global float *)(d + i0 * sd0 + idst * sd1 + it * sd2) = v;
+}
+
+// ---- the MoE router's top-k in one kernel (llama.cpp's CUDA topk_moe fusion):
+// softmax over a token's logits, the k largest in descending order (ties: the
+// lower expert), and their probabilities normalized by their clamped sum. A
+// work-group a token; the six kernels it replaces cost ~22 us and six launch
+// gaps a layer (B60, profiled). ----
+#define TOPK_MAX_EXPERT 1024
+#define TOPK_MAX_K      32
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_topk_moe_softmax_norm(global const char * lg, ulong offl, ulong nbl1,
+                                         global char * ids, ulong offi, ulong nbi1,
+                                         global char * w, ulong offw, ulong nbw1,
+                                         int n_expert, int k, float cmin, float cmax) {
+    local float p[TOPK_MAX_EXPERT];
+    local float red[16];
+    local float sv[16];
+    local int   si[16];
+    local float wt[TOPK_MAX_K];
+    local int   sel_l;
+    const int t = get_group_id(0), lid = get_local_id(0), sg = get_sub_group_id(), ln = get_sub_group_local_id();
+    const int nsg = get_num_sub_groups();
+    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1);
+
+    float m = -INFINITY;
+    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float v = x[i]; p[i] = v; m = fmax(m, v); }
+    m = sub_group_reduce_max(m);
+    if (ln == 0) red[sg] = m;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    m = red[0];
+    for (int j = 1; j < nsg; ++j) m = fmax(m, red[j]);
+    barrier(CLK_LOCAL_MEM_FENCE);
+    float s = 0.f;
+    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float e = exp(p[i] - m); p[i] = e; s += e; }
+    s = sub_group_reduce_add(s);
+    if (ln == 0) red[sg] = s;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    s = 0.f;
+    for (int j = 0; j < nsg; ++j) s += red[j];
+
+    for (int j = 0; j < k; ++j) {
+        float bv = -1.f;
+        int   bi = INT_MAX;
+        for (int i = lid; i < n_expert; i += get_local_size(0)) {
+            const float v = p[i];
+            if (v > bv) { bv = v; bi = i; }
+        }
+        const float gv = sub_group_reduce_max(bv);
+        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX);
+        if (ln == 0) { sv[sg] = gv; si[sg] = gi; }
+        barrier(CLK_LOCAL_MEM_FENCE);
+        if (lid == 0) {
+            float b = sv[0];
+            int   bix = si[0];
+            for (int q = 1; q < nsg; ++q)
+                if (sv[q] > b || (sv[q] == b && si[q] < bix)) { b = sv[q]; bix = si[q]; }
+            ((global int *)(ids + offi + (ulong)t * nbi1))[j] = bix;
+            wt[j] = b / s;
+            p[bix] = -1.f;
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lid == 0) {
+        float sum = 0.f;
+        for (int j = 0; j < k; ++j) sum += wt[j];
+        sum = clamp(sum, cmin, cmax);
+        global float * wo = (global float *)(w + offw + (ulong)t * nbw1);
+        for (int j = 0; j < k; ++j) wo[j] = wt[j] / sum;
+    }
+}
