+static void ggml_cl_hc_mix_fused(ggml_backend_t backend, ggml_cgraph * cgraph, int i) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *) backend->context;
+    ggml_tensor ** n = cgraph->nodes + i;
+    const ggml_tensor * x  = n[0]->src[0];
+    const ggml_tensor * g  = n[1]->src[0] == n[0] ? n[1]->src[1] : n[1]->src[0];
+    const ggml_tensor * wd = n[4]->src[0];
+    const ggml_tensor * wu = n[7]->src[0];
+    ggml_tensor * xn = n[1];
+    ggml_tensor * mx = n[9];
+    const int n_embd = (int) x->ne[0], hc = (int) x->ne[1], T = (int) x->ne[2], lr = (int) wd->ne[1];
+    float eps = 0.0f, s_lo = 1.0f, b_lo = 0.0f, s_mix = 1.0f;
+    memcpy(&eps,   (const float *) n[0]->op_params + 0, sizeof(float));
+    memcpy(&s_lo,  (const float *) n[5]->op_params + 0, sizeof(float));
+    memcpy(&b_lo,  (const float *) n[5]->op_params + 1, sizeof(float));
+    memcpy(&s_mix, (const float *) n[9]->op_params + 0, sizeof(float));
+    // GGML_OPENCL_HC_MIX_RED=1: the mix off by 5 % (the red case of the fusion's test)
+    static const char * red_env = getenv("GGML_OPENCL_HC_MIX_RED");
+    if (red_env != nullptr && atoi(red_env) != 0) s_mix *= 1.05f;
+    // scratch: partial dots [T][hc][2][lr], sums of squares [T][hc][2], lo [T][lr], rs [T][hc]
+    backend_ctx->prealloc_hc_mix.allocate(backend_ctx->context,
+        (size_t) T * (hc * 2 * lr + hc * 2 + lr + hc) * sizeof(float));
+    cl_mem part = backend_ctx->prealloc_hc_mix.buffer;
+    ggml_tensor_extra_cl * ex  = (ggml_tensor_extra_cl *) x->extra;
+    ggml_tensor_extra_cl * eg  = (ggml_tensor_extra_cl *) g->extra;
+    ggml_tensor_extra_cl * ewd = (ggml_tensor_extra_cl *) wd->extra;
+    ggml_tensor_extra_cl * ewu = (ggml_tensor_extra_cl *) wu->extra;
+    ggml_tensor_extra_cl * exn = (ggml_tensor_extra_cl *) xn->extra;
+    ggml_tensor_extra_cl * emx = (ggml_tensor_extra_cl *) mx->extra;
+    const cl_ulong offx = ex->offset + x->view_offs, offg = eg->offset + g->view_offs;
+    const cl_ulong offwd = ewd->offset + wd->view_offs, offwu = ewu->offset + wu->view_offs;
+    const cl_ulong offxn = exn->offset + xn->view_offs, offm = emx->offset + mx->view_offs;
+    const cl_ulong nbx1 = x->nb[1], nbx2 = x->nb[2], nbxn2 = xn->nb[2], nbm1 = mx->nb[1];
+    {
+        cl_kernel k = backend_ctx->kernel_hc_mix_down;
+        int a = 0;
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &ex->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offx));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbx1));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbx2));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &eg->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offg));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &ewd->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offwd));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &part));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &n_embd));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &hc));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &lr));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &T));
+        size_t lws[3] = { 128, 1, 1 }, gws[3] = { (size_t) CEIL_DIV(lr, 8) * 128, (size_t) hc, 2 };
+        backend_ctx->enqueue_ndrange_kernel(k, 3, gws, lws, n[4]);
+    }
+    {
+        cl_kernel k = backend_ctx->kernel_hc_mix_lo;
+        int a = 0;
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem), &part));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),    &n_embd));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),    &hc));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),    &lr));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),    &T));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(float),  &eps));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(float),  &s_lo));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(float),  &b_lo));
+        size_t lws[1] = { 256 }, gws[1] = { 256 };
+        backend_ctx->enqueue_ndrange_kernel(k, 1, gws, lws, n[6]);
+    }
+    {
+        cl_kernel k = backend_ctx->kernel_hc_mix_up;
+        int a = 0;
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &ex->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offx));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbx1));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbx2));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &eg->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offg));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &ewu->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offwu));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &part));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &exn->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offxn));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbxn2));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &emx->data_device));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &offm));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &nbm1));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &n_embd));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &hc));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &lr));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int),      &T));
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(float),    &s_mix));
+        size_t lws[1] = { 256 }, gws[1] = { (size_t) CEIL_DIV(n_embd, 16) * 256 };
+        backend_ctx->enqueue_ndrange_kernel(k, 1, gws, lws, mx);
+    }
+}
