+#define MV_IDG_KERNEL(NAME, TYPE)                                                              \
+__attribute__((intel_reqd_sub_group_size(16)))                                                 \
+kernel void NAME(global const uchar * q, ulong offq, global const half * dp,                   \
+                 global const char * xq, global const float * xd,                              \
+                 global const char * ids, ulong offi, ulong nbi1, int n_used, int ne11,        \
+                 global char * dst, ulong offd, ulong nb1, ulong nb2, int ne00, int ne01, ulong res, \
+                 global const uchar * q2, global const half * dp2, int n_split,               \
+                 global const int * pairs, global const int4 * tiles, global const int * n_tiles) { \
+    LOCAL_TABLES(TYPE)                                                                         \
+    const int first_row = FIRST_ROW;                                                           \
+    if (first_row >= ne01) return;                                                             \
+    const int ti = get_group_id(2);                                                            \
+    if (ti >= *n_tiles) return;                                                                \
+    const int4 te = tiles[ti];                                                                 \
+    int e = te.x;                                                                              \
+    if (e >= n_split) { q = q2; offq = 0; dp = dp2; e -= n_split; }                            \
+    mv_group(TYPE, q + offq, dp, (ulong)e * ne01 + first_row, ne00, first_row, ne01, xq, xd, res, \
+             pairs + te.y, te.z, n_used, ne11, dst + offd, nb1, nb2, lgrid, lsigns);           \
+}
