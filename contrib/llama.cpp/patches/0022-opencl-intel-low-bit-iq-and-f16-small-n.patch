+// lanes over K in 8-half steps; dst column c at offd + c * nb1. ----
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_mul_mv_f16_f32_nc(global const char * a, ulong offa, global const char * b, ulong offb, ulong nb11,
+                                     global char * d, ulong offd, ulong nb1, int ne00, int ne01, int ncols) {
+    const int first_row = (int)((get_group_id(0) * get_num_sub_groups() + get_sub_group_id()) * 4);
+    if (first_row >= ne01) return;
+    const int lane = get_sub_group_local_id();
+    global const half * w0 = (global const half *)(a + offa);
+    float acc[4][8];
+    #pragma unroll
+    for (int r = 0; r < 4; ++r)
+        #pragma unroll
+        for (int c = 0; c < 8; ++c) acc[r][c] = 0.f;
+    for (int k = lane * 8; k < ne00; k += 16 * 8) {
+        float8 x[8];
+        #pragma unroll
+        for (int c = 0; c < 8; ++c)
+            x[c] = c < ncols ? vload8(0, (global const float *)(b + offb + (ulong)c * nb11) + k) : (float8)(0.f);
+        #pragma unroll
+        for (int r = 0; r < 4; ++r) {
+            if (first_row + r >= ne01) break;
+            const float8 w = vload_half8(0, w0 + (ulong)(first_row + r) * ne00 + k);
+            #pragma unroll
+            for (int c = 0; c < 8; ++c)
+                acc[r][c] += dot(w.lo, x[c].lo) + dot(w.hi, x[c].hi);
+        }
+    }
+    #pragma unroll
+    for (int r = 0; r < 4; ++r) {
+        #pragma unroll
+        for (int c = 0; c < 8; ++c) {
+            const float t = sub_group_reduce_add(acc[r][c]);
+            if (lane == 0 && c < ncols && first_row + r < ne01)
+                ((global float *)(d + offd + (ulong)c * nb1))[first_row + r] = t;
+        }
+    }
+}
