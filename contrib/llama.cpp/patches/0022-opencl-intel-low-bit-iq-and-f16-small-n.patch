+// ---- the MoE router's top-k in one kernel (llama.cpp's CUDA topk_moe fusion):
+// softmax over a token's logits, the k largest in descending order (ties: the
+// lower expert), and their probabilities normalized by their clamped sum. A
+// work-group a token; the six kernels it replaces cost ~22 us and six launch
+// gaps a layer (B60, profiled). ----
+#define TOPK_MAX_EXPERT 1024
+#define TOPK_MAX_K      32
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_topk_moe_softmax_norm(global const char * lg, ulong offl, ulong nbl1,
+                                         global char * ids, ulong offi, ulong nbi1,
+                                         global char * w, ulong offw, ulong nbw1,
+                                         int n_expert, int k, float cmin, float cmax) {
+    local float p[TOPK_MAX_EXPERT];
+    local float red[16];
+    local float sv[16];
+    local int   si[16];
+    local float wt[TOPK_MAX_K];
+    local int   sel_l;
+    const int t = get_group_id(0), lid = get_local_id(0), sg = get_sub_group_id(), ln = get_sub_group_local_id();
+    const int nsg = get_num_sub_groups();
+    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1);
+
+    float m = -INFINITY;
+    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float v = x[i]; p[i] = v; m = fmax(m, v); }
+    m = sub_group_reduce_max(m);
+    if (ln == 0) red[sg] = m;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    m = red[0];
+    for (int j = 1; j < nsg; ++j) m = fmax(m, red[j]);
+    barrier(CLK_LOCAL_MEM_FENCE);
+    float s = 0.f;
+    for (int i = lid; i < n_expert; i += get_local_size(0)) { const float e = exp(p[i] - m); p[i] = e; s += e; }
+    s = sub_group_reduce_add(s);
+    if (ln == 0) red[sg] = s;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    s = 0.f;
+    for (int j = 0; j < nsg; ++j) s += red[j];
+
+    for (int j = 0; j < k; ++j) {
+        float bv = -1.f;
+        int   bi = INT_MAX;
+        for (int i = lid; i < n_expert; i += get_local_size(0)) {
+            const float v = p[i];
+            if (v > bv) { bv = v; bi = i; }
+        }
+        const float gv = sub_group_reduce_max(bv);
+        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX);
+        if (ln == 0) { sv[sg] = gv; si[sg] = gi; }
+        barrier(CLK_LOCAL_MEM_FENCE);
+        if (lid == 0) {
+            float b = sv[0];
+            int   bix = si[0];
+            for (int q = 1; q < nsg; ++q)
+                if (sv[q] > b || (sv[q] == b && si[q] < bix)) { b = sv[q]; bix = si[q]; }
+            ((global int *)(ids + offi + (ulong)t * nbi1))[j] = bix;
+            wt[j] = b / s;
+            p[bix] = -1.f;
+        }
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lid == 0) {
+        float sum = 0.f;
+        for (int j = 0; j < k; ++j) sum += wt[j];
+        sum = clamp(sum, cmin, cmax);
+        global float * wo = (global float *)(w + offw + (ulong)t * nbw1);
+        for (int j = 0; j < k; ++j) wo[j] = wt[j] / sum;
+    }
+}
+
+// ---- SCALE -> SILU and SCALE -> SIGMOID -> SCALE in one pass (contiguous
+// f32): the hyper-connection mixer's silu(x / hc) and combine's
+// 2 sigmoid(x / hc), ~290 small kernels a Flash-Next graph ----
+kernel void kernel_scale_act_f32(global const char * x, ulong offx, global char * d, ulong offd, int n,
+                                 float s1, float b1, float s2, int act) {
+    const int i = get_global_id(0);
+    if (i >= n) return;
+    const float v = ((global const float *)(x + offx))[i] * s1 + b1;
+    const float r = act == 0 ? v / (1.0f + exp(-v)) : s2 / (1.0f + exp(-v));
+    ((global float *)(d + offd))[i] = r;
+}
+
+// ---- a hyper-connection read fused (Qwen3.8-Flash-Next's build_hc_mix, after
+// Strata's fused_gr.cu gr_down_v3 / gr_up_v3): RMS_NORM -> MUL (w_norm) -> the
+// down product (hc * n_embd -> lr) -> SCALE -> SILU -> the up product (lr ->
+// hc * n_embd) -> DSV4_HC_PRE (gated) in three kernels instead of five, for 1
+// to HC_MAXT tokens and F16 weights. The rms scale is per stream, so the down
+// kernel writes unscaled partial dots per stream and K half and the next
+// kernel applies it: w . xn = sum_c rs_c sum_h (w_ch . (x_ch * g_ch)).
+// Scratch (floats): part [T][hc][2][lr], ss [T][hc][2], lo [T][lr], rs [T][hc]. ----
+#define HC_MAXT 4
+#define HC_HALF 1280   // floats of a stream's K half staged per token: n_embd / 2
+
+// group (8-row block rb, stream c, K half h), 8 sub-groups a row each: the
+// half-slice of x * w_norm for every token in local memory, its sums of
+// squares (block 0 writes them), and the rows' partial dots
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_hc_mix_down(global const char * x, ulong offx, ulong nbx1, ulong nbx2,
+                               global const char * g, ulong offg,
+                               global const char * wd, ulong offwd,
+                               global float * part,
+                               int n_embd, int hc, int lr, int T) {
+    local float xs[HC_MAXT * HC_HALF];
+    local float red[8][HC_MAXT];
+    global float * ss = part + T * hc * 2 * lr;
+    const int rb = get_group_id(0), c = get_group_id(1), h = get_group_id(2);
+    const int lid = get_local_id(0), lsz = get_local_size(0);
+    const int sg = get_sub_group_id(), lane = get_sub_group_local_id();
+    const int hn = n_embd / 2, k0 = h * hn;
+    float ssp[HC_MAXT];
+    #pragma unroll
+    for (int t = 0; t < HC_MAXT; ++t) ssp[t] = 0.f;
+    global const float * gr = (global const float *)(g + offg) + (ulong)c * n_embd + k0;
+    for (int t = 0; t < T; ++t) {
+        global const float * xr = (global const float *)(x + offx + c * nbx1 + t * nbx2) + k0;
+        for (int i = lid; i < hn; i += lsz) {
+            const float v = xr[i];
+            ssp[t] += v * v;
+            xs[t * hn + i] = v * gr[i];
+        }
+    }
+    if (rb == 0) {
+        #pragma unroll
+        for (int t = 0; t < HC_MAXT; ++t) {
+            const float sv = sub_group_reduce_add(ssp[t]);
+            if (lane == 0) red[sg][t] = sv;
+        }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    if (rb == 0 && lid < T) {
+        float sv = 0.f;
+        for (int i = 0; i < lsz / 16; ++i) sv += red[i][lid];
+        ss[(lid * hc + c) * 2 + h] = sv;
+    }
+    const int row = rb * 8 + sg;
+    if (row >= lr) return;
+    global const half * w = (global const half *)(wd + offwd) + (ulong)row * hc * n_embd + (ulong)c * n_embd + k0;
+    float acc[HC_MAXT];
+    #pragma unroll
+    for (int t = 0; t < HC_MAXT; ++t) acc[t] = 0.f;
+    for (int k = lane * 8; k < hn; k += 128) {
+        const float8 wv = vload_half8(0, w + k);
+        #pragma unroll
+        for (int t = 0; t < HC_MAXT; ++t) {
+            if (t < T) {
+                const float8 xv = vload8(0, xs + t * hn + k);
+                acc[t] += dot(wv.lo, xv.lo) + dot(wv.hi, xv.hi);
+            }
+        }
+    }
+    #pragma unroll
+    for (int t = 0; t < HC_MAXT; ++t) {
+        const float sv = sub_group_reduce_add(acc[t]);
+        if (lane == 0 && t < T) part[((t * hc + c) * 2 + h) * lr + row] = sv;
+    }
+}
+
+// one group: the rms scales from the halves' sums of squares, and
+// lo = silu(sum_c rs_c sum_h part * s_lo + b_lo) for all lr rows
+kernel void kernel_hc_mix_lo(global float * part, int n_embd, int hc, int lr, int T, float eps, float s_lo, float b_lo) {
+    global const float * ss = part + T * hc * 2 * lr;
+    global float * lo = part + T * hc * 2 * lr + T * hc * 2;
+    global float * rs = lo + T * lr;
+    local float rsl[HC_MAXT][4];
+    const int lid = get_local_id(0), lsz = get_local_size(0);
+    if (lid < T * hc) {
+        const int t = lid / hc, c = lid % hc;
+        const float r = 1.0f / sqrt((ss[(t * hc + c) * 2] + ss[(t * hc + c) * 2 + 1]) / (float)n_embd + eps);
+        rsl[t][c] = r;
+        rs[t * hc + c] = r;
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int i = lid; i < T * lr; i += lsz) {
+        const int t = i / lr, r = i % lr;
+        float sv = 0.f;
+        for (int c = 0; c < hc; ++c)
+            sv += rsl[t][c] * (part[((t * hc + c) * 2) * lr + r] + part[((t * hc + c) * 2 + 1) * lr + r]);
+        const float v = sv * s_lo + b_lo;
+        lo[t * lr + r] = v / (1.0f + exp(-v));
+    }
+}
+
+// group: 16 output columns d of every stream (hc x 16 up rows), 8 lanes a row
+// (32 rows a pass). Each row's dot with lo is the gate of xn[c][d] = x * rs *
+// w_norm (written: a later inject product reads it); the mix is s_mix * the
+// sum over the streams of xn * sigmoid(gate)
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_hc_mix_up(global const char * x, ulong offx, ulong nbx1, ulong nbx2,
+                             global const char * g, ulong offg,
+                             global const char * wu, ulong offwu,
+                             global const float * part,
+                             global char * xn, ulong offxn, ulong nbxn2,
+                             global char * mixed, ulong offm, ulong nbm1,
+                             int n_embd, int hc, int lr, int T, float s_mix) {
+    local float lo[HC_MAXT][512];
+    local float rs[HC_MAXT][4];
+    local float gs[HC_MAXT][4][16];
+    global const float * lo_g = part + T * hc * 2 * lr + T * hc * 2;
+    global const float * rs_g = lo_g + T * lr;
+    const int lid = get_local_id(0), lsz = get_local_size(0);
+    for (int i = lid; i < T * lr; i += lsz) lo[i / lr][i % lr] = lo_g[i];
+    if (lid < T * hc) rs[lid / hc][lid % hc] = rs_g[lid];
+    barrier(CLK_LOCAL_MEM_FENCE);
+    const int d0 = get_group_id(0) * 16;
+    const int l8 = lid & 7, rslot = lid >> 3, nslot = lsz >> 3;
+    for (int q0 = 0; q0 < hc * 16; q0 += nslot) {
+        const int q = q0 + rslot;
+        const bool live = q < hc * 16 && d0 + (q % 16) < n_embd;
+        const int c = q / 16, dd = q % 16, d = d0 + dd;
+        float acc[HC_MAXT];
+        #pragma unroll
+        for (int t = 0; t < HC_MAXT; ++t) acc[t] = 0.f;
+        if (live) {
+            global const half * w = (global const half *)(wu + offwu) + ((ulong)c * n_embd + d) * lr;
+            for (int k = l8 * 8; k < lr; k += 64) {
+                const float8 wv = vload_half8(0, w + k);
+                #pragma unroll
+                for (int t = 0; t < HC_MAXT; ++t) {
+                    if (t < T) {
+                        const float8 lv = vload8(0, &lo[t][k]);
+                        acc[t] += dot(wv.lo, lv.lo) + dot(wv.hi, lv.hi);
+                    }
+                }
+            }
+        }
+        #pragma unroll
+        for (int t = 0; t < HC_MAXT; ++t) {
+            float v = acc[t];
+            v += intel_sub_group_shuffle_xor(v, 1);
+            v += intel_sub_group_shuffle_xor(v, 2);
+            v += intel_sub_group_shuffle_xor(v, 4);
+            if (live && l8 == 0 && t < T) {
+                const ulong i = (ulong)c * n_embd + d;
+                const float xv  = ((global const float *)(x + offx + c * nbx1 + t * nbx2))[d];
+                const float xnv = xv * rs[t][c] * ((global const float *)(g + offg))[i];
+                ((global float *)(xn + offxn + t * nbxn2))[i] = xnv;
+                gs[t][c][dd] = xnv * (1.0f / (1.0f + exp(-v)));
+            }
+        }
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int i = lid; i < T * 16; i += lsz) {
+        const int t = i / 16, dd = i % 16, d = d0 + dd;
+        if (d >= n_embd) continue;
+        float sv = 0.f;
+        for (int c = 0; c < hc; ++c) sv += gs[t][c][dd];
+        ((global float *)(mixed + offm + t * nbm1))[d] = s_mix * sv;
+    }
+}
