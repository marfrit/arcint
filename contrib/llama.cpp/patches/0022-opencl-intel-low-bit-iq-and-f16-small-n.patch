+// llama.cpp's MoE routing (build_moe_ffn, softmax gating, normalized weights):
+// SOFT_MAX, RESHAPE, ARGSORT, VIEW (the ids), GET_ROWS, RESHAPE, SUM_ROWS,
+// CLAMP, DIV, RESHAPE (the weights) -> one kernel, as ggml-cuda's topk_moe
+static bool ggml_opencl_can_fuse_topk_moe(const ggml_backend_opencl_context * backend_ctx, const ggml_cgraph * cgraph, int i) {
+    static const char * env = getenv("GGML_OPENCL_FUSE_TOPK_MOE");
+    if (backend_ctx->kernel_topk_moe == nullptr || (env != nullptr && atoi(env) == 0) || i + 10 > cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor ** n = cgraph->nodes + i;
+    if (n[0]->op != GGML_OP_SOFT_MAX || n[0]->src[1] != nullptr || n[0]->src[2] != nullptr ||
+        n[0]->type != GGML_TYPE_F32 || n[0]->src[0]->type != GGML_TYPE_F32 || n[0]->src[0]->nb[0] != sizeof(float)) {
+        return false;
+    }
+    float sm_scale = 1.0f, sm_bias = 0.0f;
+    memcpy(&sm_scale, (const float *) n[0]->op_params + 0, sizeof(float));
+    memcpy(&sm_bias,  (const float *) n[0]->op_params + 1, sizeof(float));
+    if (sm_scale != 1.0f || sm_bias != 0.0f || n[0]->ne[0] > 1024 || n[0]->ne[2] != 1 || n[0]->ne[3] != 1) {
+        return false;
+    }
+    if (n[1]->op != GGML_OP_RESHAPE  || n[1]->src[0] != n[0] ||
+        n[2]->op != GGML_OP_ARGSORT  || n[2]->src[0] != n[0] || ggml_get_op_params_i32(n[2], 0) != GGML_SORT_ORDER_DESC ||
+        n[3]->op != GGML_OP_VIEW     || n[3]->src[0] != n[2] || n[3]->view_offs != 0 || n[3]->ne[0] > 32 ||
+        n[4]->op != GGML_OP_GET_ROWS || n[4]->src[0] != n[1] || n[4]->src[1] != n[3] ||
+        n[5]->op != GGML_OP_RESHAPE  || n[5]->src[0] != n[4] ||
+        n[6]->op != GGML_OP_SUM_ROWS || n[6]->src[0] != n[5] ||
+        n[7]->op != GGML_OP_CLAMP    || n[7]->src[0] != n[6] ||
+        n[8]->op != GGML_OP_DIV      || n[8]->src[0] != n[5] || n[8]->src[1] != n[7] ||
+        n[9]->op != GGML_OP_RESHAPE  || n[9]->src[0] != n[8] ||
+        n[8]->type != GGML_TYPE_F32 || !ggml_is_contiguous(n[8])) {
+        return false;
+    }
+    static const enum ggml_op ops[10] = { GGML_OP_SOFT_MAX, GGML_OP_RESHAPE, GGML_OP_ARGSORT, GGML_OP_VIEW, GGML_OP_GET_ROWS,
+                                          GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP, GGML_OP_DIV, GGML_OP_RESHAPE };
+    const int outs[2] = { i + 3, i + 9 };
+    return ggml_can_fuse_subgraph(cgraph, i, 10, ops, outs, 2);
+}
+
+static void ggml_cl_topk_moe_fused(ggml_backend_t backend, ggml_cgraph * cgraph, int i) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *) backend->context;
+    ggml_tensor ** n = cgraph->nodes + i;
+    const ggml_tensor * logits = n[0]->src[0];
+    const ggml_tensor * ids    = n[3];
+    const ggml_tensor * w      = n[8];
+    ggml_tensor_extra_cl * el = (ggml_tensor_extra_cl *) logits->extra;
+    ggml_tensor_extra_cl * ei = (ggml_tensor_extra_cl *) ids->extra;
+    ggml_tensor_extra_cl * ew = (ggml_tensor_extra_cl *) w->extra;
+    const cl_ulong offl = el->offset + logits->view_offs, offi = ei->offset + ids->view_offs, offw = ew->offset + w->view_offs;
+    const cl_ulong nbl1 = logits->nb[1], nbi1 = ids->nb[1], nbw1 = w->nb[1];
+    const int n_expert = (int) logits->ne[0], k = (int) ids->ne[0], n_tok = (int) logits->ne[1];
+    float cmin = 0.0f, cmax = 0.0f;
+    memcpy(&cmin, (const float *) n[7]->op_params + 0, sizeof(float));
+    memcpy(&cmax, (const float *) n[7]->op_params + 1, sizeof(float));
+    cl_kernel kk = backend_ctx->kernel_topk_moe;
+    int a = 0;
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &el->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offl));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbl1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &ei->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offi));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbi1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &ew->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offw));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbw1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &n_expert));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &k));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(float),    &cmin));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(float),    &cmax));
+    size_t lws[1] = { 256 }, gws[1] = { (size_t) n_tok * 256 };
+    backend_ctx->enqueue_ndrange_kernel(kk, 1, gws, lws, n[8]);
+}
+
+// a hyper-connection read, as qwen4exp's build_hc_mix builds it (fused
+// DSV4_HC_PRE, no inject in between): RMS_NORM(x [n_embd, hc, T]) -> MUL
+// (w_norm) -> RESHAPE (xn, [hc * n_embd, T]; a later inject product reads it)
+// -> RESHAPE (xn 3D) -> MUL_MAT (w_down) -> SCALE -> SILU -> MUL_MAT (w_up) ->
+// RESHAPE (gate 3D) -> DSV4_HC_PRE (gated). F16 / BF16 weights, 1 to 4 tokens.
+static bool ggml_opencl_can_fuse_hc_mix(const ggml_backend_opencl_context * backend_ctx, const ggml_cgraph * cgraph, int i) {
+    // opt-in (GGML_OPENCL_FUSE_HC_MIX=1): served it measured no faster than the five
+    // kernels it replaces (Flash-Next MTP 2, B60, one binary: 31.2 t/s off, 30.8 on)
+    static const char * env = getenv("GGML_OPENCL_FUSE_HC_MIX");
+    if (backend_ctx->kernel_hc_mix_down == nullptr || env == nullptr || atoi(env) == 0 || i + 10 > cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor ** n = cgraph->nodes + i;
+    if (n[0]->op != GGML_OP_RMS_NORM || n[1]->op != GGML_OP_MUL) {
+        return false;
+    }
+    if (n[2]->op != GGML_OP_RESHAPE || n[3]->op != GGML_OP_RESHAPE || n[4]->op != GGML_OP_MUL_MAT ||
+        n[5]->op != GGML_OP_SCALE || n[6]->op != GGML_OP_UNARY || n[7]->op != GGML_OP_MUL_MAT ||
+        n[8]->op != GGML_OP_RESHAPE || n[9]->op != GGML_OP_DSV4_HC_PRE) {
+        return false;
+    }
+    const ggml_tensor * x = n[0]->src[0];
+    const ggml_tensor * g = n[1]->src[0] == n[0] ? n[1]->src[1] : n[1]->src[0];
+    const ggml_tensor * wd = n[4]->src[0];
+    const ggml_tensor * wu = n[7]->src[0];
+    const int64_t n_embd = x->ne[0], hc = x->ne[1], T = x->ne[2], lr = wd->ne[1];
+    // the checks, each a bit of `bad` (GGML_OPENCL_HC_MIX_DEBUG=1 prints the first few with up to 4 tokens)
+    unsigned bad = 0;
+    bad |= (x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->ne[3] != 1) << 0;
+    bad |= (hc > 4 || T < 1 || T > 4 || n_embd % 256 != 0 || (n_embd / 2) * T > 5120) << 1;
+    bad |= (lr % 8 != 0 || lr > 512) << 2;
+    bad |= !((wd->type == GGML_TYPE_F16 || wd->type == GGML_TYPE_BF16) && wu->type == wd->type) << 3;
+    bad |= (g->type != GGML_TYPE_F32 || !ggml_is_contiguous(g) || g->ne[0] != n_embd || g->ne[1] != hc) << 4;
+    bad |= ((n[1]->src[0] != n[0] && n[1]->src[1] != n[0]) || !ggml_is_contiguous(n[1])) << 5;
+    bad |= (n[2]->src[0] != n[1] || n[3]->src[0] != n[2]) << 6;
+    bad |= (n[4]->src[1] != n[2] || !ggml_is_contiguous(wd) || wd->ne[0] != hc * n_embd || wd->ne[2] != 1) << 7;
+    bad |= (n[5]->src[0] != n[4] || n[6]->src[0] != n[5] || ggml_get_unary_op(n[6]) != GGML_UNARY_OP_SILU) << 8;
+    bad |= (n[7]->src[1] != n[6] || !ggml_is_contiguous(wu) || wu->ne[0] != lr || wu->ne[1] != hc * n_embd || wu->ne[2] != 1) << 9;
+    bad |= (n[8]->src[0] != n[7] || n[9]->src[0] != n[3] || n[9]->src[1] != n[8]) << 10;
+    bad |= (ggml_get_op_params_i32(n[9], 1) == 0 || !ggml_is_contiguous(n[9])) << 11;
+    static const enum ggml_op ops[10] = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_RESHAPE, GGML_OP_MUL_MAT,
+                                          GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_DSV4_HC_PRE };
+    // the normed rows (MUL, and its 2D view that a later inject product reads) are
+    // written by the fused kernels; the mix is the read's output
+    const int outs[3] = { i + 1, i + 2, i + 9 };
+    if (bad == 0 && !ggml_can_fuse_subgraph(cgraph, i, 10, ops, outs, 3)) {
+        bad |= 1u << 12;
+    }
+    static const char * dbg_env = getenv("GGML_OPENCL_HC_MIX_DEBUG");
+    static int dbg_left = 4;
+    if (bad != 0) {
+        if (dbg_env != nullptr && atoi(dbg_env) != 0 && dbg_left > 0 && T <= 4) {
+            --dbg_left;
+            GGML_LOG_INFO("ggml_opencl: hc mix not fused at node %d: checks 0x%x failed (T %d, n_embd %d, hc %d, lr %d, w %s/%s, g %s %dx%d)\n",
+                          i, bad, (int) T, (int) n_embd, (int) hc, (int) lr, ggml_type_name(wd->type), ggml_type_name(wu->type),
+                          ggml_type_name(g->type), (int) g->ne[0], (int) g->ne[1]);
+        }
+        return false;
+    }
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        GGML_LOG_INFO("ggml_opencl: hyper-connection read fused (%d tokens, lr %d)\n", (int) T, (int) lr);
+    }
+    return true;
+}
