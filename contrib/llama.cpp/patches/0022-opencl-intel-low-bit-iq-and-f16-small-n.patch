+// ---- the DeepSeek-V4-style hyper-connection ops (GGML_OP_DSV4_HC_PRE /
+// _POST, as ggml-sycl/dsv4-hc.cpp computes them): Qwen3.8-Flash-Next's mixers
+// were ~17 small ops a layer half on this backend. Strides in bytes. ----
+kernel void kernel_dsv4_hc_pre(global const char * x, ulong offx, global const char * w, ulong offw,
+                               global char * d, ulong offd, int n_embd, int hc, int n_tok,
+                               ulong sx0, ulong sx1, ulong sx2, ulong sw0, ulong sw1, ulong sw2,
+                               ulong sd0, ulong sd1, float scale, int gated) {
+    const int ir = get_global_id(0);
+    if (ir >= n_embd * n_tok) return;
+    const int i0 = ir % n_embd, it = ir / n_embd;
+    x += offx; w += offw; d += offd;
+    float sum = 0.f;
+    for (int ih = 0; ih < hc; ++ih) {
+        const float xv = *(global const float *)(x + i0 * sx0 + ih * sx1 + it * sx2);
+        float wv;
+        if (gated) {
+            const float gv = *(global const float *)(w + i0 * sw0 + ih * sw1 + it * sw2);
+            wv = 1.0f / (1.0f + exp(-gv));
+        } else {
+            wv = *(global const float *)(w + ih * sw0 + it * sw1);
+        }
+        sum += xv * wv;
+    }
+    *(global float *)(d + i0 * sd0 + it * sd1) = scale * sum;
+}
