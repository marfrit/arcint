+// ---- the low-bit types of the ISTA-DASLab GSQ-RCO files (patch 0022): kq type
+// index 6 IQ2_XXS, 7 IQ2_S, 8 IQ1_M, 9 Q2_0, 10 IQ3_S, blocks as stored.
+// A 32-weight sub-block j32 of a row expands to its signed int8 values w[8]
+// (weights 4i .. 4i+3 in w[i]) and two scales, s0 for weights 0..15 and s1
+// for 16..31 (equal unless the type scales half sub-blocks: IQ2_S, IQ1_M).
+// IQ1_M's values are 8 (g + delta) with delta = +-1/8, exact in int8, and
+// its scales carry the 1/8. After ggml-quants.c's dequantize_row_*. ----
+
+// bytes per block, 32-weight sub-blocks per block
+#define LB_BYTES(T) ((T) == 6 ? 66 : (T) == 7 ? 82 : (T) == 8 ? 56 : (T) == 9 ? 18 : 110)
+#define LB_SUBS(T)  ((T) == 9 ? 2 : 8)
+#define LB_ROW_BYTES(T, n32) ((ulong)((n32) / LB_SUBS(T)) * LB_BYTES(T))
+
+// eight sign bits -> 0xFF in the bytes to negate
+static inline ulong lb_signmask(uint b) {
+    ulong m = ((ulong)(b & 0xFFu) * 0x0101010101010101UL) & 0x8040201008040201UL;
+    m = (m + 0x7F7F7F7F7F7F7F7FUL) & 0x8080808080808080UL;
+    return (m >> 7) * 0xFFUL;
+}
+
+// four unsigned grid bytes, negated where m's bytes are 0xFF
+static inline uint lb_sgn4(uint g, uint m) {
+    return as_uint(as_char4(g ^ m) - as_char4(m));
+}
+
+static inline uint lb_u32(global const uchar * p) {
+    return (uint)p[0] | ((uint)p[1] << 8) | ((uint)p[2] << 16) | ((uint)p[3] << 24);
+}
+
+static inline void lb_expand(const int TYPE, global const uchar * row, int j32, uint * w, float * s0, float * s1) {
+    if (TYPE == 6) {          // IQ2_XXS: d, qs[32] as u16
+        global const uchar * bp = row + (ulong)(j32 >> 3) * 66;
+        const int p = j32 & 7;
+        const float d = vload_half(0, (global const half *)bp);
+        const uint a0 = lb_u32(bp + 2 + 8 * p), a1 = lb_u32(bp + 6 + 8 * p);
+        #pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const ulong g = iq2xxs_grid[(a0 >> (8 * l)) & 0xFF];
+            const ulong m = ksigns64[(a1 >> (7 * l)) & 127];
+            w[2 * l]     = lb_sgn4((uint)g, (uint)m);
+            w[2 * l + 1] = lb_sgn4((uint)(g >> 32), (uint)(m >> 32));
+        }
+        *s0 = *s1 = d * (0.5f + (float)(a1 >> 28)) * 0.25f;
+    } else if (TYPE == 7) {   // IQ2_S: d, qs[32], signs[32], qh[8], scales[8]
+        global const uchar * bp = row + (ulong)(j32 >> 3) * 82;
+        const int p = j32 & 7;
+        const float d = vload_half(0, (global const half *)bp);
+        const uint qh = bp[66 + p], sc = bp[74 + p];
+        #pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const ulong g = iq2s_grid[bp[2 + 4 * p + l] | ((qh << (8 - 2 * l)) & 0x300)];
+            const ulong m = lb_signmask(bp[34 + 4 * p + l]);
+            w[2 * l]     = lb_sgn4((uint)g, (uint)m);
+            w[2 * l + 1] = lb_sgn4((uint)(g >> 32), (uint)(m >> 32));
+        }
+        *s0 = d * (0.5f + (float)(sc & 0xF)) * 0.25f;
+        *s1 = d * (0.5f + (float)(sc >> 4)) * 0.25f;
+    } else if (TYPE == 8) {   // IQ1_M: qs[32], qh[16], scales[8] (the block scale in their top nibbles)
+        global const uchar * bp = row + (ulong)(j32 >> 3) * 56;
+        const int p = j32 & 7;
+        global const ushort * sc = (global const ushort *)(bp + 48);
+        const ushort u = (sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) | ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000);
+        const float d = convert_float(as_half(u));
+        const uint s = sc[p / 2] >> (6 * (p & 1));
+        const uint qh0 = bp[32 + 2 * p], qh1 = bp[33 + 2 * p];
+        const uint idx[4] = { bp[4 * p] | ((qh0 << 8) & 0x700), bp[4 * p + 1] | ((qh0 << 4) & 0x700),
+                              bp[4 * p + 2] | ((qh1 << 8) & 0x700), bp[4 * p + 3] | ((qh1 << 4) & 0x700) };
+        const int dl[4] = { (qh0 & 0x08) ? -1 : 1, (qh0 & 0x80) ? -1 : 1, (qh1 & 0x08) ? -1 : 1, (qh1 & 0x80) ? -1 : 1 };
+        #pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const ulong g = iq1s_grid[idx[l]];
+            w[2 * l]     = as_uint(as_char4((uint)g) * (char4)(8) + (char4)(dl[l]));
+            w[2 * l + 1] = as_uint(as_char4((uint)(g >> 32)) * (char4)(8) + (char4)(dl[l]));
+        }
+        *s0 = d * (float)(2 * (s & 7) + 1) * 0.125f;
+        *s1 = d * (float)(2 * ((s >> 3) & 7) + 1) * 0.125f;
+    } else if (TYPE == 9) {   // Q2_0: d, qs[16] for 64 weights, four 2-bit codes a byte, value q - 1
+        global const uchar * bp = row + (ulong)(j32 >> 1) * 18;
+        const float d = vload_half(0, (global const half *)bp);
+        global const uchar * q = bp + 2 + 8 * (j32 & 1);
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const uint b = q[i];
+            const uint v = (b & 3) | (((b >> 2) & 3) << 8) | (((b >> 4) & 3) << 16) | (((b >> 6) & 3) << 24);
+            w[i] = as_uint(as_char4(v) - (char4)(1));
+        }
+        *s0 = *s1 = d;
+    } else {                  // IQ3_S: d, qs[64], qh[8], signs[32], scales[4]
+        global const uchar * bp = row + (ulong)(j32 >> 3) * 110;
+        const int p = j32 & 7;
+        const float d = vload_half(0, (global const half *)bp);
+        const uint qh = bp[66 + p];
+        const uint sc = (bp[106 + p / 2] >> (4 * (p & 1))) & 0xF;
+        #pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const uint g1 = iq3s_grid[bp[2 + 8 * p + 2 * l]     | ((qh << (8 - 2 * l)) & 256)];
+            const uint g2 = iq3s_grid[bp[2 + 8 * p + 2 * l + 1] | ((qh << (7 - 2 * l)) & 256)];
+            const ulong m = lb_signmask(bp[74 + 4 * p + l]);
+            w[2 * l]     = lb_sgn4(g1, (uint)m);
+            w[2 * l + 1] = lb_sgn4(g2, (uint)(m >> 32));
+        }
+        *s0 = *s1 = d * (float)(1 + 2 * sc);
+    }
+}
+
+// the 32 weights of sub-block j32 as floats
+static inline void lb_v32(const int TYPE, global const uchar * row, int j32, float * v) {
+    uint w[8];
+    float s0, s1;
+    lb_expand(TYPE, row, j32, w, &s0, &s1);
+    #pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const char4 c = as_char4(w[i]);
+        const float s = i < 4 ? s0 : s1;
+        v[4 * i] = s * c.s0; v[4 * i + 1] = s * c.s1; v[4 * i + 2] = s * c.s2; v[4 * i + 3] = s * c.s3;
+    }
+}
