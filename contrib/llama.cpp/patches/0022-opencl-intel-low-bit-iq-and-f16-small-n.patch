+// it, as Strata's verify does: src/core/verify.cpp, native_expert_grouped) ----
+#define IDG_MAX 8
+static inline void mv_group(const int TYPE, global const uchar * q, global const half * dp, ulong row0, int ne00,
+                            int first_row, int ne01, global const char * xq, global const float * xd, ulong res,
