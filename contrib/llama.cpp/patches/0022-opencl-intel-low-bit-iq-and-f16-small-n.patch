+static inline int dot4_ss(const uint * w, uint4 x) {
+    int a = 0;
+    a = dot_acc_sat_4x8packed_ss_int(w[0], x.s0, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[1], x.s1, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[2], x.s2, a);
+    a = dot_acc_sat_4x8packed_ss_int(w[3], x.s3, a);
+    return a;
