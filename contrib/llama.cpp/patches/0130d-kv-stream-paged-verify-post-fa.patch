+// 0130d: GGML_OPENCL_FA_PAGED_VERIFY=3 -- the pre hash at the FA's position as =1's, and a
+// post hash of the SAME rows right after the FA's kernels, before the consumed marker. Both
+// are read back non-blocking, both events kept, and the two hashes compared at the next
+// graph's start and at the request's end: a chunk whose hashes differ is a copy that landed
+// while the FA was reading the slot, the write-after-read race =1 cannot see (its hash and
+// blocking read happen at the FA's start).
+// enqueue the hash of one slot region into `out`, then read it back non-blocking into `host`
+static void ggml_cl_fa_paged_verify3_hash_read(ggml_backend_opencl_context * ctx,
+        cl_mem buf, cl_mem rowsbuf, cl_ulong base_off, cl_ulong stride_bytes, cl_ulong nbytes,
+        int64_t nc, size_t gy, cl_mem out, std::vector<uint32_t> & host, cl_event * ev) {
+    auto & o = ctx->fa_paged;
+    const uint32_t chunk = 4096;
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 0, sizeof(cl_mem), &buf));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 1, sizeof(cl_mem), &rowsbuf));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 2, sizeof(cl_ulong), &base_off));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 3, sizeof(cl_ulong), &stride_bytes));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 4, sizeof(cl_ulong), &nbytes));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 5, sizeof(uint32_t), &chunk));
+    CL_CHECK(clSetKernelArg(o.verify_kernel, 6, sizeof(cl_mem), &out));
+    size_t gws[2] = { (size_t) nc, gy };
+    CL_CHECK(clEnqueueNDRangeKernel(ctx->queue, o.verify_kernel, 2, nullptr, gws, nullptr,
+            0, nullptr, nullptr));
+    host.resize((size_t) nc*gy);
+    // CL_FALSE: the graph does not wait for it; the event is waited at the next graph's start
+    CL_CHECK(clEnqueueReadBuffer(ctx->queue, out, CL_FALSE, 0, host.size()*sizeof(uint32_t),
+            host.data(), 0, nullptr, ev));
+}
+
+static void ggml_cl_fa_paged_verify3_begin(ggml_backend_opencl_context * ctx,
+        cl_mem k_buf, cl_mem v_buf, cl_ulong k_off, cl_ulong v_off, int ps, int rb, int rvb,
+        size_t kb, size_t vb, const int32_t * pl, int64_t n_pages, int node) {
+    if (ggml_cl_fa_paged_verify_mode() != 3) return;
+    auto & o = ctx->fa_paged;
+    o.post_cur = -1;   // this dispatch's pair; `post` below finds it even when node is -1
+    if (pl == nullptr) return;
+    std::vector<int32_t> rows, pages;
+    for (int64_t p = 0; p < n_pages; ++p) if (pl[p] >= 0) { rows.push_back(pl[p]); pages.push_back((int32_t) p); }
+    if (rows.empty()) return;
+    if (!ggml_cl_fa_paged_verify_kernel(ctx)) return;
+    g_fa_paged_verify3_ctx = ctx;
+    const uint32_t chunk = 4096;
+    fa_paged_post e;
+    e.node = node;
+    e.rows = rows;
+    e.pages = pages;
+    e.nk = (int64_t) ((kb + chunk - 1) / chunk);
+    e.nv = (int64_t) ((vb + chunk - 1) / chunk);
+    e.buf[0]  = k_buf;
+    e.buf[1]  = v_buf;
+    e.base[0] = k_off;
+    e.base[1] = v_off;
+    e.stride[0] = (cl_ulong) ps*(cl_ulong) rb;
+    e.stride[1] = (cl_ulong) ps*(cl_ulong) rvb;
+    e.nbytes[0] = (cl_ulong) kb;
+    e.nbytes[1] = (cl_ulong) vb;
+    const size_t gy = rows.size();
+    const size_t out_bytes = (size_t) std::max(e.nk, e.nv)*gy*sizeof(uint32_t);
+    cl_int err;
+    CL_CHECK((e.rowsbuf = clCreateBuffer(ctx->context, CL_MEM_READ_ONLY | CL_MEM_COPY_HOST_PTR,
+            gy*sizeof(int32_t), rows.data(), &err), err));
+    for (int kv = 0; kv < 2; ++kv) {
+        for (int pp = 0; pp < 2; ++pp) {
+            CL_CHECK((e.out[kv][pp] = clCreateBuffer(ctx->context, CL_MEM_WRITE_ONLY, out_bytes,
+                    nullptr, &err), err));
+        }
+    }
+    for (int kv = 0; kv < 2; ++kv) {
+        ggml_cl_fa_paged_verify3_hash_read(ctx, e.buf[kv], e.rowsbuf, e.base[kv], e.stride[kv],
+                e.nbytes[kv], kv == 0 ? e.nk : e.nv, gy, e.out[kv][0], e.dev[kv][0], &e.ev[kv][0]);
+    }
+    o.v_nodes++;
+    o.v_bytes += (int64_t) gy*(kb + vb);
+    o.post_pending.push_back(std::move(e));
+    o.post_cur = (int) o.post_pending.size() - 1;
+}
+
+// after this FA's kernels and before `ggml_cl_fa_paged_overlap_after`'s consumed marker
+static void ggml_cl_fa_paged_verify3_post(ggml_backend_opencl_context * ctx) {
+    if (ggml_cl_fa_paged_verify_mode() != 3) return;
+    auto & o = ctx->fa_paged;
+    if (o.post_cur < 0 || o.post_cur >= (int) o.post_pending.size()) return;
+    fa_paged_post & e = o.post_pending[o.post_cur];
+    if (e.post) return;
+    const size_t gy = e.rows.size();
+    for (int kv = 0; kv < 2; ++kv) {
+        ggml_cl_fa_paged_verify3_hash_read(ctx, e.buf[kv], e.rowsbuf, e.base[kv], e.stride[kv],
+                e.nbytes[kv], kv == 0 ? e.nk : e.nv, gy, e.out[kv][1], e.dev[kv][1], &e.ev[kv][1]);
+    }
+    e.post = true;
+}
+
+// wait the pairs of the previous graph(s) and compare pre against post
+static void ggml_cl_fa_paged_verify3_collect(ggml_backend_opencl_context * ctx) {
+    auto & o = ctx->fa_paged;
+    if (o.post_pending.empty()) return;
+    for (size_t n = 0; n < o.post_pending.size(); ++n) {
+        fa_paged_post & e = o.post_pending[n];
+        if (!e.post) {
+            if (!o.v_post_nopost_warned) {
+                o.v_post_nopost_warned = 1;
+                GGML_LOG_WARN("ggml_opencl: paged FA post-FA: node %d's post hash never ran; its pair is dropped\n", e.node);
+            }
+        } else {
+            int64_t bad = 0;
+            int first_page = -1, first_chunk = -1;
+            for (int kv = 0; kv < 2; ++kv) {
+                CL_CHECK(clWaitForEvents(1, &e.ev[kv][0]));
+                CL_CHECK(clWaitForEvents(1, &e.ev[kv][1]));
+                const size_t nc = (size_t) (kv == 0 ? e.nk : e.nv);
+                const size_t gy = e.rows.size();
+                for (size_t p = 0; p < gy; ++p) {
+                    for (size_t c = 0; c < nc; ++c) {
+                        if (e.dev[kv][0][p*nc + c] != e.dev[kv][1][p*nc + c]) {
+                            ++bad;
+                            if (first_page < 0) { first_page = e.pages[p]; first_chunk = (int) c; }
+                        }
+                    }
+                }
+            }
+            o.v_post_changes += bad;
+            if (bad > 0 && !o.v_post_warned) {
+                o.v_post_warned = 1;
+                GGML_LOG_WARN("ggml_opencl: paged FA post-FA changed: node %d page %d chunk %d\n",
+                        e.node, first_page, first_chunk);
+            }
+        }
+        for (int kv = 0; kv < 2; ++kv) {
+            for (int pp = 0; pp < 2; ++pp) {
+                if (e.out[kv][pp])  { CL_CHECK(clReleaseMemObject(e.out[kv][pp]));  e.out[kv][pp] = nullptr; }
+                if (e.ev[kv][pp])   { CL_CHECK(clReleaseEvent(e.ev[kv][pp]));       e.ev[kv][pp] = nullptr; }
+            }
+        }
+        if (e.rowsbuf) { CL_CHECK(clReleaseMemObject(e.rowsbuf)); e.rowsbuf = nullptr; }
+    }
+    o.post_pending.clear();
+    o.post_cur = -1;
+}
