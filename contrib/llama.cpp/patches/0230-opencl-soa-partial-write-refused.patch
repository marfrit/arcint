+// 0230: a partial write that reached the q8_0 / q4_0 split conversion is refused (the conversion uploads the whole
+// tensor from `data` and would read past it); once per process and type, so a path that lands here shows in the log.
+static void ggml_cl_warn_partial_write_refused(const ggml_tensor * tensor, ggml_backend_buffer_t buffer, size_t offset,
+                                               size_t size) {
+    static std::atomic<bool> warned_q8_0{false};
+    static std::atomic<bool> warned_q4_0{false};
+    std::atomic<bool> & warned = tensor->type == GGML_TYPE_Q8_0 ? warned_q8_0 : warned_q4_0;
+    if (warned.exchange(true)) {
+        return;
+    }
+    GGML_LOG_WARN("ggml_opencl: set_tensor: a partial write into a q8_0/q4_0 tensor was refused, not converted "
+                  "(tensor '%s', type %s, offset %zu, size %zu of %zu, %s buffer); logged once per process and type\n",
+                  tensor->name, ggml_type_name(tensor->type), offset, size, ggml_nbytes(tensor),
+                  ggml_backend_buffer_get_usage(buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS ? "weights" : "non-weights");
+}
