0230: set_tensor refuses a partial write into a q8_0 / q4_0 tensor instead of converting the whole tensor from it (the conversion read past the caller's data); whole writes and 0209's plain copy are unchanged.

diff --git a/ggml/src/ggml-opencl/ggml-opencl-soa-route.h b/ggml/src/ggml-opencl/ggml-opencl-soa-route.h
new file mode 100644
index 0000000..b72557c
--- /dev/null
+++ b/ggml/src/ggml-opencl/ggml-opencl-soa-route.h
@@ -0,0 +1,25 @@
+// ggml-opencl-soa-route.h - 0230: which way set_tensor takes a write that reaches the q8_0 / q4_0 split conversion
+// (after 0209's plain copy has taken the non-weights writes into a tensor that is not split). The conversion uploads
+// the WHOLE tensor from the caller's data, so only a whole write of a whole, contiguous base may take it; a view
+// keeps 0209's refusal, and a partial write (offset != 0 or size != the tensor's bytes) is refused too: it read past
+// the caller's data and re-cut the split layout. A pure function (CPU-testable).
+#pragma once
+
+#include <cstddef>
+
+enum ggml_cl_soa_route {
+    GGML_CL_SOA_CONVERT        = 0,   // a whole write of a whole, contiguous base: convert (today's path)
+    GGML_CL_SOA_REFUSE_VIEW    = 1,   // a view or a non-contiguous tensor: 0209's WARN, not performed
+    GGML_CL_SOA_REFUSE_PARTIAL = 2,   // 0230: a partial write: WARN, not performed
+};
+
+static inline ggml_cl_soa_route ggml_cl_soa_write_route(bool view_or_noncontiguous, size_t offset, size_t size,
+                                                        size_t nbytes) {
+    if (view_or_noncontiguous) return GGML_CL_SOA_REFUSE_VIEW;
+#ifndef GGML_CL_SOA_ROUTE_RED
+    if (offset != 0 || size != nbytes) return GGML_CL_SOA_REFUSE_PARTIAL;
+#else
+    (void) offset; (void) size; (void) nbytes;   // the red build: today's routing, a partial write converts
+#endif
+    return GGML_CL_SOA_CONVERT;
+}
