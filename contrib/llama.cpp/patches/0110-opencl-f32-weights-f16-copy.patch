-        queue, extra->data_device, CL_TRUE, extra->offset + offset,
-        size, data, 0, NULL, NULL));
-
-    GGML_UNUSED(buffer);
+    ggml_cl_f16_copy_build(backend_ctx, buffer, tensor, data, offset, size);   // 0110
 }
 
