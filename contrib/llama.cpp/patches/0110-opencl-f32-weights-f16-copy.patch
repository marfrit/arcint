@@ -30013,14 +30170,28 @@ static bool ggml_cl_mul_mat_fwht(ggml_backend_t backend, const ggml_tensor * src
     return true;
 }
 
+// ARC-LAB 0110: an F32 weight that 0110 copies to f16 (by its shape and name)
+// but that has no copy here (GGML_OPENCL_F32W_F16=0, a value outside f16)
+// reports reason=no-f16-copy; with its copy it does not reach the F32 paths,
+// except at column counts without an F16 fast path (no-fast-path, as before)
+static const char * ggml_cl_downgrade_reason(const ggml_backend_opencl_context * backend_ctx, const ggml_tensor * src0) {
+    if (src0->type == GGML_TYPE_F32 && src0->buffer != nullptr &&
+        ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+        ggml_cl_f16_copy_shape(backend_ctx, src0) && src0->extra != nullptr &&
+        ((const ggml_tensor_extra_cl *) src0->extra)->f16 == nullptr) {
+        return "no-f16-copy";
+    }
+    return "no-fast-path";
+}
+
 // ARC-LAB 0100: an Intel product on ggml's generic tiled GEMM
