+            CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &e->q));
+            CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &off0));
+            CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),   &e->d));
