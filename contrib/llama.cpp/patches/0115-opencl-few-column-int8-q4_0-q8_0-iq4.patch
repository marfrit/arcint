             // "TMM,WG" overrides the shape.
@@ -11389,6 +11501,8 @@ static void ggml_cl_ngpt_fused(ggml_backend_t backend, ggml_tensor * const * n)
     backend_ctx->enqueue_ndrange_kernel(k, 1, gws, lws, y);
 }
 
