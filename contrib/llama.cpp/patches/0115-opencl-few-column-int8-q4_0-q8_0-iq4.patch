+        }
+        cl_kernel k = backend_ctx->kernel_mul_mv_q80_q8_1[ncols - 1];
+        const ggml_tensor * soa0 = src0->view_src != nullptr ? src0->view_src : src0;
+        // a Q8_0 product the arm's matvec cannot take goes on to the few-column kernel below
