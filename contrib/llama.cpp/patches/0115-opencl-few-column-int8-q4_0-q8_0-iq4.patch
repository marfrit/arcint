+        CL_CHECK(clSetKernelArg(kp, 4, sizeof(cl_mem),   &backend_ctx->prealloc_fewq_xd.buffer));
+        CL_CHECK(clSetKernelArg(kp, 5, sizeof(int),      &ne00));
+        CL_CHECK(clSetKernelArg(kp, 6, sizeof(int),      &ncols));
