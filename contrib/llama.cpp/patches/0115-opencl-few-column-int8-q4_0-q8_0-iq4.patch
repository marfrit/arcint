+    }
+    ggml_tensor_extra_cl * extrad = (ggml_tensor_extra_cl *)dst->extra;
+    const cl_ulong offsetd = extrad->offset + dst->view_offs;
+    const cl_ulong nb1 = dst->nb[1];
