+// ARC-LAB 0115: GGML_OPENCL_FEWQ_LOG=2: each shape and the path it took, once
+static void ggml_cl_fewq_trace(const ggml_backend_opencl_context * ctx, const ggml_tensor * src0, int ncols, const char * path) {
+    if (ctx->fewq_log < 2) {
+        return;
+    }
+    static std::mutex mu;
+    static std::set<std::string> seen;
+    char b[160];
+    snprintf(b, sizeof(b), "%s k=%d m=%d x %d columns: %s", ggml_type_name(src0->type), (int) src0->ne[0], (int) src0->ne[1], ncols, path);
+    std::lock_guard<std::mutex> lock(mu);
+    if (seen.insert(b).second) {
+        GGML_LOG_INFO("ggml_opencl: few-column int8 product: %s\n", b);
+    }
+}
