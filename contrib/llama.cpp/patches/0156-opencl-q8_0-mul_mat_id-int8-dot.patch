+// 0156: MUL_MAT_ID of Q8_0's flat planes on the int8 dot: pair k = get_group_id(2),
+// slot i = k % n_used, token t = k / n_used, expert ids[t][i], activation column
+// (i % ne11) + t * ne11; the weight blocks are the expert's rows, as the matvec above.
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_mul_mv_id_q8_0_q8_1(global const uchar * q, ulong offq, global const half * dp,
+                                      global const char * xq, global const float * xd,
+                                      global const char * ids, ulong offi, ulong nbi1, int n_used, int ne11,
+                                      global char * dst, ulong offd, ulong nb1, ulong nb2, int ne00, int ne01,
+                                      ulong res, int n_tok) {
+    const int k = (int)get_group_id(2);
+    const int i = k % n_used, t = k / n_used;
+    if (t >= n_tok) return;
+    const int e = ((global const int *)(ids + offi + (ulong)t * nbi1))[i];
+    const int first_row = FIRST_ROW;
+    if (first_row >= ne01 || e < 0) return;   // a skipped pair's rows stay zero
+    const int n32 = ne00 / 32;
+    const int col = (i % ne11) + t * ne11;
+    mv_q8_0(q + offq, dp, ((ulong)e * ne01 + first_row) * n32, n32, first_row, ne01,
+            xq + (ulong)col * ne00, xd + (ulong)col * n32, res,
+            (global float *)(dst + offd + t * nb2 + i * nb1), nb1 / sizeof(float));
+}
 #endif
 MV_KERNEL(kernel_mul_mv_iq2_xxs_q8_1, 6)
 MV_KERNEL(kernel_mul_mv_iq2_s_q8_1, 7)
