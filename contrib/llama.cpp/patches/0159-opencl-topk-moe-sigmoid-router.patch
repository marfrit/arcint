+// ---- the same top-k as one kernel for a SIGMOID router (llama.cpp's
+// LLAMA_EXPERT_GATING_FUNC_TYPE_SIGMOID, Inkling 2 Mini): p = sigmoid(logit),
+// an optional per-expert bias added only for the selection (the weights stay
+// the unbiased probabilities), the k largest selection values in descending
+// order (ties: the lower expert), and their probabilities normalized by the
+// clamped sum or by the sum plus a fixed epsilon (llama-graph's
+// expert_weights_norm_eps path: SCALE(sum, 1, eps) before DIV).
+//
+// The unfused chain's order is kept: the weights are the p of the selected ids
+// in the argsort's descending order, accumulated f32 serially by lane 0 in the
+// same j order as SUM_ROWS, then divided. Same shape of kernel, same sub-group
+// a token, same buckets; the softmax kernels above are untouched. ----
+#define TOPK_MOE_SIG_BODY(NPER) \
+    const int sg = get_sub_group_id(), ln = get_sub_group_local_id(); \
+    const int t = get_group_id(0) * TOPK_MOE_TOKENS_PER_WG + sg; \
+    if (t >= n_tok) return; \
+    \
+    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1); \
+    global const float * bsel = has_bias ? (global const float *)(bias + offb) : NULL; \
+    global int * io = (global int *)(ids + offi + (ulong)t * nbi1); \
+    global float * wo = (global float *)(w + offw + (ulong)t * nbw1); \
+    \
+    float p[NPER]; \
+    ulong sel = 0; \
+    _Pragma("unroll") \
+    for (int j = 0; j < NPER; ++j) { \
+        const int i = ln + TOPK_MOE_SG_SIZE * j; \
+        p[j] = i < n_expert ? 1.0f / (1.0f + exp(-x[i])) : -INFINITY; \
+    } \
+    \
+    float wsum = 0.0f; \
+    for (int j = 0; j < k; ++j) { \
+        float bv = -INFINITY; \
+        int   bi = INT_MAX; \
+        _Pragma("unroll") \
+        for (int q = 0; q < NPER; ++q) { \
+            const int i = ln + TOPK_MOE_SG_SIZE * q; \
+            const float sv = p[q] + (has_bias && i < n_expert ? bsel[i] : 0.0f); \
+            if ((sel & (1UL << q)) == 0 && sv > bv) { bv = sv; bi = i; } \
+        } \
+        const float gv = sub_group_reduce_max(bv); \
+        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX); \
+        /* the unbiased probability at the selected id, from the lane holding it */ \
+        const int   sq = gi < n_expert ? gi / TOPK_MOE_SG_SIZE : 0; \
+        const float pv = (gi < n_expert && (gi & (TOPK_MOE_SG_SIZE - 1)) == ln) ? p[sq] : 0.0f; \
+        const float pw = sub_group_reduce_add(pv); \
+        if (ln == 0) { io[j] = gi; wo[j] = pw; wsum += pw; } \
+        if (gi < n_expert && (gi & (TOPK_MOE_SG_SIZE - 1)) == ln) sel |= 1UL << sq; \
+    } \
+    if (ln == 0) { \
+        /* SCALE(sum, 1, eps) then DIV, or clamp then DIV: the unfused order */ \
+        const float sum = norm_eps > 0.0f ? (wsum + norm_eps) : clamp(wsum, cmin, cmax); \
+        for (int j = 0; j < k; ++j) wo[j] = wo[j] / sum; \
+    }
+
+#define TOPK_MOE_SIG_KERNEL(N) \
+__attribute__((intel_reqd_sub_group_size(TOPK_MOE_SG_SIZE))) \
+kernel void kernel_topk_moe_sigmoid_norm_n##N(global const char * lg, ulong offl, ulong nbl1, \
+                                              global char * ids, ulong offi, ulong nbi1, \
+                                              global char * w, ulong offw, ulong nbw1, \
+                                              int n_expert, int k, int n_tok, float cmin, float cmax, \
+                                              global const char * bias, ulong offb, int has_bias, float norm_eps) { \
+    TOPK_MOE_SIG_BODY(N) \
+}
+
+TOPK_MOE_SIG_KERNEL(4)
+TOPK_MOE_SIG_KERNEL(8)
+TOPK_MOE_SIG_KERNEL(16)
+TOPK_MOE_SIG_KERNEL(32)
+TOPK_MOE_SIG_KERNEL(64)
