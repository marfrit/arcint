+// The SIGMOID router arm of the same fusion (llama.cpp's
+// LLAMA_EXPERT_GATING_FUNC_TYPE_SIGMOID: Inkling 2 Mini's 128 experts, top 8):
+// SIGMOID, RESHAPE, [ADD the selection bias], ARGSORT, VIEW, GET_ROWS, RESHAPE,
+// SUM_ROWS, CLAMP | SCALE(1,eps), DIV, RESHAPE -> one kernel. The bias ADD
+// carries only the selection; the weights are the unbiased probabilities, as
+// llama-graph passes them. Returns the nodes fused (10 without the bias, 11
+// with it; 0: not this pattern), with the bias tensor and the norm arm.
+struct ggml_opencl_topk_moe_sigmoid {
+    int          nf;
+    bool         has_bias;
+    ggml_tensor * bias;
+    bool         eps_norm;   // SCALE(sum, 1, eps) instead of CLAMP
+    float        cmin, cmax, eps;
+};
+
+static bool ggml_opencl_can_fuse_topk_moe_sigmoid(const ggml_backend_opencl_context * backend_ctx,
+                                                  const ggml_cgraph * cgraph, int i,
+                                                  ggml_opencl_topk_moe_sigmoid * out) {
+    static const char * env = getenv("GGML_OPENCL_FUSE_TOPK_MOE");
+    if (backend_ctx->kernel_topk_moe_sigmoid[4] == nullptr || (env != nullptr && atoi(env) == 0) ||
+        i + 10 > cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor ** n = cgraph->nodes + i;
+    if (n[0]->op != GGML_OP_UNARY || ggml_get_unary_op(n[0]) != GGML_UNARY_OP_SIGMOID ||
+        n[0]->type != GGML_TYPE_F32 || n[0]->src[0]->type != GGML_TYPE_F32 ||
+        n[0]->src[0]->nb[0] != sizeof(float) || n[0]->src[1] != nullptr ||
+        n[0]->ne[0] > 1024 || n[0]->ne[2] != 1 || n[0]->ne[3] != 1) {
+        return false;
+    }
+    const int64_t n_expert = n[0]->ne[0];
+    if (n[1]->op != GGML_OP_RESHAPE || n[1]->src[0] != n[0] || n[1]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // the selection bias is optional: llama4's sigmoid has none, Inkling's ADD
+    // feeds ARGSORT while GET_ROWS reads the unbiased probs
+    bool has_bias = false;
+    int j = 2;
+    if (n[2]->op == GGML_OP_ADD && n[2]->src[0] == n[0] && n[2]->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(n[2]->src[1]) && n[2]->src[1]->type == GGML_TYPE_F32 &&
+        n[2]->src[1]->ne[0] == n_expert && n[2]->src[1]->ne[1] == 1 &&
+        n[2]->src[1]->nb[0] == sizeof(float)) {
+        has_bias = true;
+        j = 3;
+    }
+    // the rest of the scan: ARGSORT, VIEW, GET_ROWS, RESHAPE, SUM_ROWS, the norm,
+    // DIV, RESHAPE. Without the bias j == 2; with it j == 3 and the window is 11.
+    if (i + j + 8 > cgraph->n_nodes) {
+        return false;
+    }
+    const int nf = j + 8;
+    const int argsort = j, view = j + 1, get_rows = j + 2, reshape_i = j + 3,
+              sum_rows = j + 4, norm = j + 5, div = j + 6, reshape_o = j + 7;
+    const ggml_tensor * sel = has_bias ? n[2] : n[0];
+    if (n[argsort]->op != GGML_OP_ARGSORT || n[argsort]->src[0] != sel ||
+        ggml_get_op_params_i32(n[argsort], 0) != GGML_SORT_ORDER_DESC ||
+        n[view]->op != GGML_OP_VIEW || n[view]->src[0] != n[argsort] ||
+        n[view]->view_offs != 0 || n[view]->ne[0] > 32 ||
+        n[get_rows]->op != GGML_OP_GET_ROWS || n[get_rows]->src[0] != n[1] || n[get_rows]->src[1] != n[view] ||
+        n[reshape_i]->op != GGML_OP_RESHAPE || n[reshape_i]->src[0] != n[get_rows] ||
+        n[sum_rows]->op != GGML_OP_SUM_ROWS || n[sum_rows]->src[0] != n[reshape_i] ||
+        n[norm]->src[0] != n[sum_rows] ||
+        n[div]->op != GGML_OP_DIV || n[div]->src[0] != n[reshape_i] || n[div]->src[1] != n[norm] ||
+        n[reshape_o]->op != GGML_OP_RESHAPE || n[reshape_o]->src[0] != n[div] ||
+        n[div]->type != GGML_TYPE_F32 || !ggml_is_contiguous(n[div])) {
+        return false;
+    }
+    bool eps_norm = false;
+    float cmin = 0.0f, cmax = 0.0f, eps = 0.0f;
+    if (n[norm]->op == GGML_OP_CLAMP) {
+        memcpy(&cmin, (const float *) n[norm]->op_params + 0, sizeof(float));
+        memcpy(&cmax, (const float *) n[norm]->op_params + 1, sizeof(float));
+    } else if (n[norm]->op == GGML_OP_SCALE) {
+        float s_ = 0.0f;
+        memcpy(&s_,  (const float *) n[norm]->op_params + 0, sizeof(float));
+        memcpy(&eps, (const float *) n[norm]->op_params + 1, sizeof(float));
+        if (s_ != 1.0f || eps <= 0.0f) return false;
+        eps_norm = true;
+    } else {
+        return false;
+    }
+    if (n[norm]->type != GGML_TYPE_F32 || n[div]->src[0]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    static const enum ggml_op ops_sig[10] = { GGML_OP_UNARY, GGML_OP_RESHAPE, GGML_OP_ARGSORT, GGML_OP_VIEW,
+                                              GGML_OP_GET_ROWS, GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP,
+                                              GGML_OP_DIV, GGML_OP_RESHAPE };
+    static const enum ggml_op ops_bias[11] = { GGML_OP_UNARY, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_ARGSORT,
+                                               GGML_OP_VIEW, GGML_OP_GET_ROWS, GGML_OP_RESHAPE, GGML_OP_SUM_ROWS,
+                                               GGML_OP_CLAMP, GGML_OP_DIV, GGML_OP_RESHAPE };
+    // the norm node is CLAMP or SCALE: compare the ops with the norm slot the
+    // graph actually has, so a SCALE there is not read as a CLAMP mismatch
+    enum ggml_op ops_copy[11];
+    memcpy(ops_copy, has_bias ? ops_bias : ops_sig, (size_t) nf * sizeof(enum ggml_op));
+    ops_copy[sum_rows + 1] = n[norm]->op;
+    const int outs[2] = { i + view, i + reshape_o };
+    if (!ggml_can_fuse_subgraph(cgraph, i, nf, ops_copy, outs, 2)) {
+        return false;
+    }
+    out->nf = nf;
+    out->has_bias = has_bias;
+    out->bias = has_bias ? n[2]->src[1] : nullptr;
+    out->eps_norm = eps_norm;
+    out->cmin = cmin; out->cmax = cmax; out->eps = eps;
+    return true;
+}
+
+// patch 0159: how many times the SIGMOID top-k arm ran, for test-backend-ops'
+// "the test reached the fused arm" check. One per fused launch.
+static int64_t g_topk_moe_sigmoid_fused_count = 0;
+static int64_t ggml_backend_opencl_topk_moe_sigmoid_fused_count(void) {
+    return g_topk_moe_sigmoid_fused_count;
+}
+
+static void ggml_cl_topk_moe_sigmoid_fused(ggml_backend_t backend, ggml_cgraph * cgraph, int i,
+                                           const ggml_opencl_topk_moe_sigmoid * p) {
+    ggml_backend_opencl_context * backend_ctx = (ggml_backend_opencl_context *) backend->context;
+    ggml_tensor ** n = cgraph->nodes + i;
+    g_topk_moe_sigmoid_fused_count++;
+    const ggml_tensor * logits = n[0]->src[0];
+    const int view = p->has_bias ? 4 : 3;
+    // the weights the consumer reads: the closing RESHAPE is a view of DIV at the
+    // same byte offset, but its nb[1] is 4 (ne[0] == 1), unusable as the row
+    // stride; DIV holds the contiguous k-float rows (nb[1] == k*4), so the kernel
+    // writes there. Card-proven: multi-token KL 0.001950, -ub1 0.001988.
+    const int wnode = p->has_bias ? 9 : 8;
+    const ggml_tensor * ids = n[view];
+    const ggml_tensor * w   = n[wnode];
+    ggml_tensor_extra_cl * el = (ggml_tensor_extra_cl *) logits->extra;
+    ggml_tensor_extra_cl * ei = (ggml_tensor_extra_cl *) ids->extra;
+    ggml_tensor_extra_cl * ew = (ggml_tensor_extra_cl *) w->extra;
+    const cl_ulong offl = el->offset + logits->view_offs, offi = ei->offset + ids->view_offs, offw = ew->offset + w->view_offs;
+    const cl_ulong nbl1 = logits->nb[1], nbi1 = ids->nb[1], nbw1 = w->nb[1];
+    const int n_expert = (int) logits->ne[0], k = (int) ids->ne[0], n_tok = (int) logits->ne[1];
+    int bucket = 0;
+    for (int b = 0; b < 5; ++b) {
+        if ((4 << b) * 16 >= n_expert) { bucket = b; break; }
+    }
+    cl_kernel kk = backend_ctx->kernel_topk_moe_sigmoid[bucket];
+    int a = 0;
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &el->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offl));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbl1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &ei->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offi));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbi1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &ew->data_device));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offw));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &nbw1));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &n_expert));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &k));
+    const int sg_size = 16, tokens_per_wg = 4;
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &n_tok));
+    const float cmin = p->cmin, cmax = p->cmax, eps = p->eps;
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(float),    &cmin));
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(float),    &cmax));
+    if (p->has_bias) {
+        ggml_tensor_extra_cl * eb = (ggml_tensor_extra_cl *) p->bias->extra;
+        const cl_ulong offb = eb->offset + p->bias->view_offs;
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   &eb->data_device));
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offb));
+        const int one = 1;
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &one));
+    } else {
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_mem),   nullptr));
+        const cl_ulong offb = 0;
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(cl_ulong), &offb));
+        const int zero = 0;
+        CL_CHECK(clSetKernelArg(kk, a++, sizeof(int),      &zero));
+    }
+    CL_CHECK(clSetKernelArg(kk, a++, sizeof(float),    &eps));
+    size_t lws[1], gws[1];
+    lws[0] = tokens_per_wg * sg_size;
+    gws[0] = (size_t) ((n_tok + tokens_per_wg - 1) / tokens_per_wg) * lws[0];
+    backend_ctx->enqueue_ndrange_kernel(kk, 1, gws, lws, n[wnode]);
+}
