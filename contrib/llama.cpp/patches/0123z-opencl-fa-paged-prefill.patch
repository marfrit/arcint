diff --git a/ggml/src/ggml-opencl/kernels/flash_attn_dpas.cl b/ggml/src/ggml-opencl/kernels/flash_attn_dpas.cl
index 61ab4a7..44929d3 100644
--- a/ggml/src/ggml-opencl/kernels/flash_attn_dpas.cl
+++ b/ggml/src/ggml-opencl/kernels/flash_attn_dpas.cl
@@ -125,11 +125,26 @@ static inline half8 load8(const int t, const global char * row, const int c8) {
 // [dim][key][head][batch]: a work-item per 8 values, the attention kernel's
 // own conversion (load8), one 16-byte store
 kernel void flash_attn_kv_to_f16(global const char * src, ulong off, ulong nb1, ulong nb2, ulong nb3,
-                                 int t, int d, int nkeys, int ne2, global half * dst) {
+                                 int t, int d, int nkeys, int ne2, global half * dst,
+                                 // paged K/V (0119/0124): logical key = kv0 + key; a null table reads
+                                 // `key` rows from `off` as before, else the pool page or the ring page
+                                 global const int * table, int ps, int kv0,
+                                 global const char * rsrc, ulong roff, ulong rnb1, ulong rnb2, ulong rnb3) {
     const int c8 = get_global_id(0), key = get_global_id(1);
     const int h = get_global_id(2) % ne2, b = get_global_id(2) / ne2;
     if (c8 >= d / 8 || key >= nkeys) return;
-    const half8 x = load8(t, src + off + (ulong) key * nb1 + (ulong) h * nb2 + (ulong) b * nb3, c8);
+    const int lkey = kv0 + key;
+    if (table != 0) {
+        const int e = table[lkey / ps];
+        const int row = (e >= 0 ? e : -1 - e) * ps + (lkey % ps);
+        const global char * base = e >= 0 ? src + off : rsrc + roff;
+        const ulong b1 = e >= 0 ? nb1 : rnb1, b2 = e >= 0 ? nb2 : rnb2, b3 = e >= 0 ? nb3 : rnb3;
+        const half8 x = load8(t, base + (ulong) row * b1 + (ulong) h * b2 + (ulong) b * b3, c8);
+        vstore8(x, 0, dst + (((ulong) b * ne2 + h) * nkeys + key) * d + 8 * c8);
+        return;
+    }
+    const global char * base = src + off;
+    const half8 x = load8(t, base + (ulong) key * nb1 + (ulong) h * nb2 + (ulong) b * nb3, c8);
     vstore8(x, 0, dst + (((ulong) b * ne2 + h) * nkeys + key) * d + 8 * c8);
 }
 #endif
