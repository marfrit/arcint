diff --git a/ggml/src/ggml-opencl/kernels/concat.cl b/ggml/src/ggml-opencl/kernels/concat.cl
index 8ecf746..7d65878 100644
--- a/ggml/src/ggml-opencl/kernels/concat.cl
+++ b/ggml/src/ggml-opencl/kernels/concat.cl
@@ -126,3 +126,62 @@ kernel void kernel_concat_b4_pack(
         *y = *x;
     }
 }
+
+// small shapes: one work item copies one element, rows flattened over dim 0 and 1.
+// The generic kernel above walks ne0 with a strided step in one work item, which is
+// latency bound when ne0 is a few thousand and the whole copy is a few kilobytes.
+kernel void kernel_concat_b4_small(
+    global  const char * src0,
+    ulong                offset0,
+    global  const char * src1,
+    ulong                offset1,
+    global        char * dst,
+    ulong                offsetd,
+    int             ne00,
+    int             ne01,
+    int             ne02,
+    int             ne03,
+    ulong           nb00,
+    ulong           nb01,
+    ulong           nb02,
+    ulong           nb03,
+    ulong           nb10,
+    ulong           nb11,
+    ulong           nb12,
+    ulong           nb13,
+    int             ne0,
+    ulong           nb0,
+    ulong           nb1,
+    ulong           nb2,
+    ulong           nb3,
+    int             dim,
+    int             ne1
+) {
+    src0 = src0 + offset0;
+    src1 = src1 + offset1;
+    dst  = dst  + offsetd;
+
+    int g = get_global_id(0);
+    if (g >= ne0*ne1) {
+        return;
+    }
+
+    const int i0 = g % ne0;
+    const int i1 = g / ne0;
+    const int i2 = get_global_id(1);
+    const int i3 = get_global_id(2);
+
+    int o[4] = {0, 0, 0, 0};
+    o[dim] = dim == 0 ? ne00 : (dim == 1 ? ne01 : (dim == 2 ? ne02 : ne03));
+
+    global const int * x;
+    if (i0 < ne00 && i1 < ne01 && i2 < ne02 && i3 < ne03) {
+        x = (global const int *)(src0 + i3*nb03 + i2*nb02 + i1*nb01 + i0*nb00);
+    } else {
+        x = (global const int *)(src1 + (i3 - o[3])*nb13 + (i2 - o[2])*nb12 + (i1 - o[1])*nb11 + (i0 - o[0])*nb10);
+    }
+
+    global int * y = (global int *)(dst + i3*nb3 + i2*nb2 + i1*nb1 + i0*nb0);
+
+    *y = *x;
+}
diff --git a/ggml/src/ggml-opencl/kernels/repeat.cl b/ggml/src/ggml-opencl/kernels/repeat.cl
index 53d9673..ba3e8d9 100644
--- a/ggml/src/ggml-opencl/kernels/repeat.cl
+++ b/ggml/src/ggml-opencl/kernels/repeat.cl
@@ -75,3 +75,45 @@ kernel void kernel_repeat_f16(
         *((global ushort *)(dst_ptr + i0*nb0)) = *((global const ushort *)(src0_ptr + i00*nb00));
     }
 }
+
+// small shapes: one work item copies one element of the whole output.
+// The generic kernel above walks ne0 with a strided step in one work item, which is
+// latency bound for a few kilobytes.
+kernel void kernel_repeat_f32_small(
+        global const char * src0,
+        ulong               offset0,
+        global       char * dst,
+        ulong               offsetd,
+        int     ne00,
+        int     ne01,
+        int     ne02,
+        int     ne03,
+        ulong   nb00,
+        ulong   nb01,
+        ulong   nb02,
+        ulong   nb03,
+        int     ne0,
+        ulong   nb0,
+        ulong   nb1,
+        ulong   nb2,
+        ulong   nb3,
+        int     ne1
+) {
+    src0 = src0 + offset0;
+    dst  = dst  + offsetd;
+
+    int g = get_global_id(0);
+    if (g >= ne0*ne1) {
+        return;
+    }
+
+    const int i0 = g % ne0;
+    const int i1 = g / ne0;
+    const int i2 = get_global_id(1);
+    const int i3 = get_global_id(2);
+
+    global const char * src0_ptr = src0 + (i3%ne03)*nb03 + (i2%ne02)*nb02 + (i1%ne01)*nb01;
+    global       char * dst_ptr  = dst  +  i3*nb3  +  i2*nb2  +  i1*nb1;
+
+    *((global float *)(dst_ptr + i0*nb0)) = *((global const float *)(src0_ptr + (i0%ne00)*nb00));
+}
