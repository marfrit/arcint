diff --git a/ggml/src/ggml-opencl/fa_dec27_gate.h b/ggml/src/ggml-opencl/fa_dec27_gate.h
new file mode 100644
index 0000000..c9f5884
--- /dev/null
+++ b/ggml/src/ggml-opencl/fa_dec27_gate.h
@@ -0,0 +1,236 @@
+// fa_dec27_gate.h - 0227: the eligibility and the key split of the decode flash-attention arm
+// (kernels/flash_attn_dec27.cl), as pure functions (no OpenCL call, no backend state), so a CPU
+// test can feed them a graph export's own lines.
+//
+// The arm serves a decode / verify call of 4 to 8 query rows over a q8_0 K and a q4_0 V cache at
+// head size 256, read in place - the call as the model emits it, not an 8-row block of a 9 to 64-row
+// call, and from 8,192 keys on (fa_dec27_gate_call). Each rule exists because of what the kernel indexes:
+//   q:     the prepass reads a float at head*nb[2] + row*nb[1] + 4*dim: D contiguous floats,
+//          float-aligned strides, any row and head stride (the model's Q is a permuted view);
+//   k:     ggml's q8_0 blocks, 34 bytes for 32 values, 8 blocks = 272 bytes a (key, kv head). The
+//          transposed dword reads take a surface whose base is the head's first byte rounded down
+//          to 64 and whose x coordinate carries the remainder in dwords: the head's first byte is
+//          a multiple of 4 (view offset and head stride) on a 64-byte aligned buffer; a surface
+//          row holds up to 60 + 272 bytes, so the row pitch is at least 332, a multiple of 16
+//          and below 2^24 (the 2D block reads' own limits);
+//   v:     ggml's q4_0 blocks, 18 bytes for 32 values, 8 blocks = 144 bytes a (key, kv head); the
+//          transformed byte reads take the same kind of surface (x a multiple of 4), so the row
+//          pitch is at least 204, a multiple of 16 and below 2^24;
+//   mask:  f16 [n_kv, rows], row*nb[1]/2 + key, one head and one stream;
+//   dst:   f32, head*nb[1] + row*nb[2] + 4*dim.
+// A call with a sink, an indexed bias, the port's sources, a page table, ALiBi or a softcap is
+// another kernel's. The model's lines (the dense 27B hybrid's attention with -ctk q8_0 -ctv q4_0):
+// q [256, T, 24] nb [4, 24576, 1024], K [256, n_kv, 4] nb [34, 1088, 272], V [256, n_kv, 4] nb
+// [18, 576, 144].
+#ifndef FA_DEC27_GATE_H
+#define FA_DEC27_GATE_H
+
+#include <ggml.h>
+#include <stdint.h>
+#include <string.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+#define FA_DEC27_D          256
+#define FA_DEC27_ROWS_MIN   4
+#define FA_DEC27_ROWS_MAX   8
+#define FA_DEC27_KBYTES     (FA_DEC27_D / 32 * 34)   // 272: q8_0 bytes a (key, kv head)
+#define FA_DEC27_VBYTES     (FA_DEC27_D / 32 * 18)   // 144: q4_0 bytes a (key, kv head)
+// a split state's floats: O as a sub-group holds it (16 chunks x 8 rows x 16 lanes), then m (8) and l (8)
+#define FA_DEC27_STATE_FLOATS (FA_DEC27_D / 16 * 128 + 16)
+// the Q scratch a tile: 8 rows x 256 halves (4,096 bytes, so a tile's base keeps the buffer's
+// alignment), then 8 blocks x 8 rows of floats (the accumulator starts)
+#define FA_DEC27_QTILE_BYTES  (8 * FA_DEC27_D * 2)
+#define FA_DEC27_NQTILE_FLOATS 64
+
+// the op's slots and params the gate reads (ggml-impl.h's GGML_FA_SRC_* / GGML_FA_PARAM_*, repeated so this
+// header needs ggml.h only). Every slot after the sink up to the op's last (GGML_MAX_SRC - 1) is "extra": paged
+// K/V, an indexed bias, the port's sources, and any slot a later patch gives a meaning. The numbers are checked
+// against ggml-impl.h by static_asserts in ggml-opencl.cpp, where both headers are seen (a check here would be dead:
+// this header is included before ggml-impl.h).
+enum {
+    FA_DEC27_SRC_SINK = 4, FA_DEC27_SRC_FIRST_EXTRA = 5, FA_DEC27_SRC_PORT_SINK = 18, FA_DEC27_SRC_LAST_EXTRA = 19,
+    FA_DEC27_PARAM_BIAS_FLAG = 15,
+};
+
+// the rows the switch is about: a call of this kind that the gate refuses is said (a DOWNGRADE
+// line); any other call is simply not the arm's (a 1-row step, a prompt, another cache type)
+static inline int fa_dec27_in_scope(const struct ggml_tensor * op) {
+    const struct ggml_tensor * q = op->src[0], * k = op->src[1], * v = op->src[2];
+    return q != NULL && k != NULL && v != NULL &&
+           q->type == GGML_TYPE_F32 && k->type == GGML_TYPE_Q8_0 && v->type == GGML_TYPE_Q4_0 &&
+           q->ne[0] == FA_DEC27_D && k->ne[0] == FA_DEC27_D && v->ne[0] == FA_DEC27_D &&
+           q->ne[1] >= FA_DEC27_ROWS_MIN && q->ne[1] <= FA_DEC27_ROWS_MAX;
+}
+
+// 1 accept, 0 refuse with *why set. Pure: the op's tensors' type / ne / nb / view_offs and its
+// params. buf_align is the backend's buffer alignment: a tensor's placed offset is its buffer's (a
+// multiple of buf_align, by the allocator) plus its view offset.
+static inline int fa_dec27_gate_op(const struct ggml_tensor * op, size_t buf_align, int is_intel, const char ** why_out) {
+#define REFUSE(r) do { *why_out = (r); return 0; } while (0)
+    const struct ggml_tensor * q = op->src[0], * k = op->src[1], * v = op->src[2], * mask = op->src[3];
+    if (!is_intel) REFUSE("device");
+    if (q == NULL || k == NULL || v == NULL) REFUSE("shape");
+    if (q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_Q8_0 || v->type != GGML_TYPE_Q4_0) REFUSE("kv-type");
+    if (q->ne[0] != FA_DEC27_D || k->ne[0] != FA_DEC27_D || v->ne[0] != FA_DEC27_D) REFUSE("head");
+    if (q->ne[1] < FA_DEC27_ROWS_MIN || q->ne[1] > FA_DEC27_ROWS_MAX) REFUSE("rows");
+    if (q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1) REFUSE("streams");
+    if (op->src[FA_DEC27_SRC_SINK] != NULL) REFUSE("sinks");
+#ifdef FA_DEC27_GATE_RED_EXTRA
+    // the red rule: only the page table is looked at - a call with a ring, a host store, an indexed
+    // bias or the port's sources would be read as a plain one
+    if (op->src[FA_DEC27_SRC_FIRST_EXTRA] != NULL) REFUSE("extra-sources");
+#else
+    for (int i = FA_DEC27_SRC_FIRST_EXTRA; i <= FA_DEC27_SRC_LAST_EXTRA; ++i) {
+        if (op->src[i] != NULL) REFUSE("extra-sources");     // paged K/V, an indexed bias, the port's sources
+    }
+#endif
+    {
+        int32_t flag;
+        float max_bias, softcap;
+        memcpy(&flag,     (const char *) op->op_params + FA_DEC27_PARAM_BIAS_FLAG * sizeof(int32_t), sizeof flag);
+        memcpy(&max_bias, (const char *) op->op_params + 1 * sizeof(float), sizeof max_bias);
+        memcpy(&softcap,  (const char *) op->op_params + 2 * sizeof(float), sizeof softcap);
+        if (flag != 0) REFUSE("extra-sources");
+        if (max_bias != 0.0f) REFUSE("alibi");
+        if (softcap != 0.0f) REFUSE("softcap");
+    }
+    const int64_t D = FA_DEC27_D, rows = q->ne[1], n_head = q->ne[2], n_kv = k->ne[1], n_head_kv = k->ne[2];
+    if (n_kv < 1 || n_kv >= (1 << 24) || n_head_kv < 1 || n_head < 1 || n_head % n_head_kv != 0 ||
+        v->ne[1] != n_kv || v->ne[2] != n_head_kv) REFUSE("shape");
+    if ((n_head / n_head_kv) * rows > 8 * 64) REFUSE("tiles");     // 64 tiles a kv head at most
+    if (mask == NULL || mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || mask->ne[3] != 1 ||
+        mask->ne[0] < n_kv || mask->ne[1] < rows || mask->nb[0] != 2 || mask->nb[1] % 2 != 0 ||
+        mask->nb[1] < (size_t) (n_kv * 2)) REFUSE("mask");
+    if (op->type != GGML_TYPE_F32 || op->ne[0] != D || op->ne[1] != n_head || op->ne[2] < rows ||
+        op->nb[0] != 4 || op->nb[1] % 4 != 0 || op->nb[2] % 4 != 0 || op->nb[1] < (size_t) (D * 4)) REFUSE("dst");
+    if (q->nb[0] != 4 || q->nb[1] < 4 || q->nb[2] < 4 || q->nb[1] % 4 != 0 || q->nb[2] % 4 != 0 ||
+        q->view_offs % 4 != 0) REFUSE("layout-q");
+    if (buf_align % 64 != 0) REFUSE("layout-align");
+#ifdef FA_DEC27_GATE_RED_STRIDE
+    // a wrong rule, an f16 cache's head stride asked of this one: refuses the model (K 272, V 144)
+    if (k->nb[2] % 64 != 0 || v->nb[2] % 64 != 0) REFUSE("layout-k");
+#endif
+    if (k->nb[0] != 34 || k->nb[1] % 16 != 0 || k->nb[1] < 60 + (size_t) FA_DEC27_KBYTES || k->nb[1] >= ((size_t) 1 << 24) ||
+        k->nb[2] % 4 != 0 || k->view_offs % 4 != 0) REFUSE("layout-k");
+    if (v->nb[0] != 18 || v->nb[1] % 16 != 0 || v->nb[1] < 60 + (size_t) FA_DEC27_VBYTES || v->nb[1] >= ((size_t) 1 << 24) ||
+        v->nb[2] % 4 != 0 || v->view_offs % 4 != 0) REFUSE("layout-v");
+#undef REFUSE
+    return 1;
+}
+
+// The call as the dispatch sees it. A 9 to 64-row call is cut into blocks of up to 8 rows that
+// re-enter the dispatch (the row-block split); such a block has the shape of a verify, and it is
+// NOT the arm's: the arm serves the calls the model emits with 4 to 8 rows, nothing a split makes
+// (a second path, with prompts' shapes and timings, that its cases and card rows do not cover).
+// row_block: the op is a block of that split. FA_DEC27_GATE_RED_ROW_BLOCK: the form before this
+// rule (the unit test's red).
+//
+// THE CROSSOVER. The arm has a fixed cost: fa_dec27 costs ~153 us a call against ~50 us for
+// flash_attn_gqa_dpas, independent of the keys; below 8192 keys the dispatch keeps today's kernel
+// (a measured crossover). The sweep, on the 24 GB card, the FA family's launch
+// time a call, today's kernels against the arm at 4 / 6 / 8 rows: at 4,096 keys the arm loses the
+// 8-row case (+4.7 %); at 8,192 it wins every row (-68 / -46 / -44 %), and at every larger size
+// measured. The threshold is that measured point, not an interpolation. A call the shape's gate
+// accepts with fewer keys is refused "below-crossover": the designed route, not a fallback.
+// force != 0 (the tests: GGML_OPENCL_FA_DEC27=2) takes the arm at every key count the shape's
+// gate accepts. FA_DEC27_GATE_RED_NO_MIN_KV: the form before this rule (the unit test's red).
+#define FA_DEC27_MIN_KV 8192
+static inline int fa_dec27_gate_call(const struct ggml_tensor * op, int row_block, int force, size_t buf_align, int is_intel, const char ** why_out) {
+#ifndef FA_DEC27_GATE_RED_ROW_BLOCK
+    if (row_block) { *why_out = "row-block"; return 0; }
+#else
+    (void) row_block;
+#endif
+    if (!fa_dec27_gate_op(op, buf_align, is_intel, why_out)) return 0;
+#ifndef FA_DEC27_GATE_RED_NO_MIN_KV
+    if (!force && op->src[1]->ne[1] < FA_DEC27_MIN_KV) { *why_out = "below-crossover"; return 0; }
+#else
+    (void) force;
+#endif
+    return 1;
+}
+
+// ---- the tiles ----
+// A query "row" of a kv head is a (query head, token) pair: flat row f is query head kvh*G + f % G,
+// token f / G (G = n_head / n_head_kv), the order flash_attn_gqa_dpas.cl has. A sub-group owns 8
+// flat rows (the DPAS's M), a tile; a kv head has ceil(G * rows / 8) tiles.
+static inline int fa_dec27_tiles(int G, int rows) {
+    return (G * rows + 7) / 8;
+}
+
+// the tokens a tile's 8 flat rows span, at most (the mask rows a tile reads a key group): the
+// kernel is built with it (-DDEC27_MT). G 6: 2, G 8: 1, G 4: 2, G 1: 8.
+static inline int fa_dec27_mask_slots(int G, int rows) {
+    int mt = 1;
+    for (int t = 0; t < fa_dec27_tiles(G, rows); ++t) {
+        const int last = (8 * t + 7) / G < rows - 1 ? (8 * t + 7) / G : rows - 1;
+        const int n = last - (8 * t) / G + 1;
+        if (n > mt) mt = n;
+    }
+    return mt;
+}
+
+// ---- the key split ----
+// A sub-group is a thread, and the kernel has no local memory and no barrier, so a thread is the
+// unit the device schedules: a Xe core holds 32 threads at 256 GRF (8 vector engines x 4), and
+// CL_DEVICE_MAX_COMPUTE_UNITS counts the engines. B60 (160): 20 cores, 640 threads; B70 (256): 1,024.
+static inline int fa_dec27_cores(int n_cu) {
+    return n_cu / 8;
+}
+static inline int fa_dec27_wave(int n_cu) {
+    return n_cu < 8 ? 0 : fa_dec27_cores(n_cu) * 32;
+}
+
+#define FA_DEC27_SPLIT_MAX        256
+#define FA_DEC27_SPLIT_MIN_BLOCKS 16     // 512 keys a split at least (flash_attn_gqa_dpas.cl's split size)
+
+// p for one call. A split costs threads_per_split = n_head_kv x tiles threads; each walks 1/p of the
+// 32-key blocks and writes a state the merge reads (FA_DEC27_STATE_FLOATS floats, as much as ~100
+// keys of K and V), so a split walks at least min_blocks blocks (0: FA_DEC27_SPLIT_MIN_BLOCKS).
+// Above that floor p fills ONE wave and no more: the most p with p x threads_per_split <= wave,
+// then - the wave rule - stepped down to the next p whose threads are a multiple of the core count
+// (every core the same number of threads), when there is one. force > 0 sets p (bounded by the
+// call's blocks and FA_DEC27_SPLIT_MAX): the tests and a window's sweep.
+// FA_DEC27_SPLIT_RED_NO_WAVE: the rule without the wave bound (the unit test's red: 512 keys a
+// split at any depth, flash_attn_gqa_dpas.cl's rule, 2.4 waves at 77k keys with the last 40 % full).
+static inline int fa_dec27_splits(int threads_per_split, int n_cu, int64_t n_kv, int force, int min_blocks) {
+    const int64_t blocks = (n_kv + 31) / 32;
+    if (force > 0) {
+        int64_t p = force < FA_DEC27_SPLIT_MAX ? force : FA_DEC27_SPLIT_MAX;
+        if (p > blocks) p = blocks;
+        return p < 1 ? 1 : (int) p;
+    }
+    const int wave = fa_dec27_wave(n_cu), cores = fa_dec27_cores(n_cu);
+    if (threads_per_split < 1) return 1;
+    int64_t p = blocks / (min_blocks > 0 ? min_blocks : FA_DEC27_SPLIT_MIN_BLOCKS);
+    if (p > FA_DEC27_SPLIT_MAX) p = FA_DEC27_SPLIT_MAX;
+    if (p < 1) p = 1;
+#ifndef FA_DEC27_SPLIT_RED_NO_WAVE
+    if (wave > 0 && p * threads_per_split > wave) {
+        p = wave / threads_per_split;
+        if (p < 1) p = 1;
+        // the wave rule: the threads a multiple of the core count
+        for (int64_t c = p; c >= 1 && c > p - cores; --c) {
+            if ((c * threads_per_split) % cores == 0) { p = c; break; }
+        }
+    }
+#else
+    (void) wave; (void) cores;
+#endif
+    return (int) p;
+}
+
+// the 32-key blocks a split walks: split s takes [s * b, min(B, (s + 1) * b)) of the call's B blocks.
+// A split past B (p does not divide B evenly) walks none: its state is (M_INIT, 0) and weighs 0.
+static inline int fa_dec27_split_blocks(int64_t n_kv, int p) {
+    const int64_t blocks = (n_kv + 31) / 32;
+    return (int) ((blocks + p - 1) / (p < 1 ? 1 : p));
+}
+
+#if defined(__cplusplus)
+}
+#endif
+#endif
