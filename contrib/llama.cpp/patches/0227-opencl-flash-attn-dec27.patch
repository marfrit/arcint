                 dv.src[3]    = &mv;
+                g_fa_dec27_row_block = true;     // 0227: a block of this split is not the decode arm's
                 ggml_cl_flash_attn(backend, &qv, k, &dv);
+                g_fa_dec27_row_block = false;
             }
             return;
         }
diff --git a/ggml/src/ggml-opencl/kernels/flash_attn_dec27.cl b/ggml/src/ggml-opencl/kernels/flash_attn_dec27.cl
new file mode 100644
index 0000000..d805866
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/flash_attn_dec27.cl
@@ -0,0 +1,484 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups_short : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+#pragma OPENCL EXTENSION cl_intel_subgroup_matrix_multiply_accumulate : enable
+#pragma OPENCL EXTENSION cl_intel_subgroup_2d_block_io : enable
+
+// 0227: decode / verify flash attention (4 to 8 query rows) over a q8_0 K and a q4_0 V cache at head
+// size 256, both read in place. The read forms are flash_attn_port.cl's (its PORT_KV8 + PORT_V4
+// build, 0199q1 / 0225): raw cache bytes by 2D block reads with the key in the lane (K) or in the
+// dword (V), codes and nibbles made f16 by integer operations on whole dwords, each block's scale
+// applied in f32. Nothing is staged in local memory, there is no barrier, and no K or V value is
+// rounded before its product.
+//
+// The rows. A query "row" of a kv head is a (query head, token) pair, flat row f = query head
+// kvh*G + f % G, token f / G (flash_attn_gqa_dpas.cl's order). A sub-group (16 lanes) owns a tile of
+// 8 flat rows (the DPAS's M) and all 256 output columns: O is 16 float8, 128 of the 256 registers.
+// That leaves no room for a tile's Q (64 registers), so Q is re-read a key group from an f16
+// scratch, as flash_attn_dpas2.cl does at this head size (kernel_fa_dec27_q writes it once a call,
+// 4,096 bytes a tile, already in the lane order K's codes come out in).
+//
+// The sharing. Every tile of a kv head reads the same K and V bytes: at 6 rows 5 tiles, 36 (head,
+// token) rows. A tile's 8 rows share each read in registers; the tiles share it in the cache (the
+// grid puts the tiles of a (kv head, split) next to each other). One read for all tiles in
+// registers would need two tiles' O in one thread, which 256 registers do not hold.
+//
+// The keys split across threads (0045's form, as flash_attn_port.cl's PORT_SPLIT): the grid is
+// (tile, split, kv head), one sub-group a work-group; split s walks the 32-key blocks [s *
+// split_blocks, (s + 1) * split_blocks) with its own online-softmax state and writes it
+// (FA_DEC27_STATE_FLOATS floats, fa_dec27_gate.h); kernel_fa_dec27_merge joins the states and
+// writes the output. The host picks the split count so that the threads fill one wave of the
+// device (fa_dec27_splits).
+//
+// K (q8_0, 8 blocks of 34 bytes = 68 dwords a (key, kv head)): the transposed dword read gives 8
+// dwords of 16 key rows, lane = key; nine of them cover the head (dwords 0, 8 .. 56, and 60 for the
+// last four). Two blocks are 17 dwords, so pair p starts on dword 17 p: its even block has the
+// scale in the low short of dword 0, codes 0, 1 in its high short, codes 2 .. 29 in dwords 1 .. 7,
+// codes 30, 31 in the low short of dword 8, whose high short is the odd block's scale; the odd
+// block's codes are dwords 9 .. 16. B16 turns 4 dwords (16 codes) into 16 halves of value 1152 +
+// code (a code's byte with its top bit flipped is code + 128; 0x6400 | x is the f16 of 1024 + x),
+// a dword's bytes 0 and 2 before its bytes 1 and 3 - the scratch holds Q in that lane order
+// (DEC27_ORD). S = sum over blocks of d_b(key) * (sum q (1152 + code) - 1152 sum q): the DPAS
+// accumulator starts at -1152 sum q (the prepass's sum of the f16 Q, a float a (block, row)), and
+// the scale multiplies the f32 sum once a block.
+//
+// V (q4_0, 8 blocks of 18 bytes): one transformed byte read a block (16 byte columns x 32 key
+// rows: lane = quant byte j, a byte a key) gives dims 32 b + j from the low nibbles and 32 b + 16 +
+// j from the high ones. A byte read's column must be on the 4-byte grid: an odd block's quant
+// bytes start on it; an even block's start 2 bytes off, so it is read 2 bytes on and lanes 14, 15
+// take quant bytes 0, 1 from lanes 2, 3 of a read at the block's first byte. 0x6400 | n is the f16
+// of 1032 + (n - 8). The scale of (key, block) stands under the sum over keys, so it goes into the
+// operand that has the key in its lane, normalised a (32-key block, q4_0 block) by a power of two:
+// c = 2^-e, e the binary exponent of the largest |d| among the block's 32 keys, pe = f16(p d c)
+// (|d c| < 2: no clamp is reached). The accumulator starts 1032 sum pe lower; O is taken to that
+// scale (x c), takes the two DPAS there and comes back (x 1 / c), in f32, so O holds the sum
+// itself. Exact powers of two: only pe's rounding point moves - 11 bits below the 32 keys' largest
+// scale, whatever its size. p itself is rounded to f16 first (a key 2^-24 under its row's maximum
+// weighs nothing, as in flash_attn_gqa_dpas).
+// Two other forms of this phase were built and measured, and are not in this text (the record:
+// the 0227 section of the series' README and the branch it names). pe = f16(p d 8) without the
+// normalisation keeps p d in f16's range from above, not from below: a V block of small values
+// under a flat row of weights leaves pe in the subnormals, and the V-floor test case fails it
+// (4.9e-3 on the 24 GB card; this text 3.4e-6). P V in f32 without the DPAS is right on every
+// input and slower: 1,793 us against 1,186 a 6-row call at 77,297 keys on that card.
+//
+// The mask is f16 [n_kv, rows]; a tile's rows are at most DEC27_MT tokens, so a key group reads
+// DEC27_MT runs of 16 halves (a block read; the last group of a call, which may end inside the
+// run, a clamped read a key). -inf (by its bits) and the f16 lowest hide a cell, any other value
+// is added to the score.
+// The block read needs its pointer on a 4-byte boundary. A row's run starts at row x n_kv cells of
+// 2 bytes: an odd row over an odd key count is 2 bytes past one. Measured on the 24 GB card with
+// the first build, which read every whole group as a block: the odd lanes of such a read held the
+// cell two before their own (the even lanes their own), so an odd row lost key 1 and took a key
+// past its mask's edge, and a call of 1,013 keys stood 7.0e-4 from the CPU. A run that is not on
+// 4 bytes is read a key at a time (mal[]); the served cache's key counts are multiples of 256,
+// so there the block read is the path.
+//
+// Red builds (GGML_OPENCL_FA_DEC27_RED): 1 DEC27_RED_V_SCALE takes V's scale from the next block
+// of the row; 2 DEC27_RED_TAIL drops the call's last key; 3 DEC27_RED_SEAM skips the first block
+// of every split from the second on; 4 DEC27_RED_NOMAX merges the states without their maxima;
+// 5 DEC27_RED_K_SCALE2 applies K's scale twice. Each must FAIL the arm's test cases.
+// 6 DEC27_RED_PVNORM_IC leaves out the 1 / c that brings O back from a block's scale: it must FAIL too.
+// 7 DEC27_RED_MASK_ALIGN block-reads a mask run whatever its pointer: it must FAIL the cases of an odd key count
+// (a device behaviour: only a card run shows it; an even key count has every run on 4 bytes and passes).
+
+#define DK 256
+#define QR 8
+#define BK 32
+#define NKB (BK / 16)
+#define NC (DK / 16)          // 16 chunks of 16 dims
+#define NB8 (DK / 32)         // 8 blocks a (key, kv head)
+#define HBK (NB8 * 34)        // 272
+#define HBV (NB8 * 18)        // 144
+#define STATE (NC * QR * 16 + 2 * QR)   // = FA_DEC27_STATE_FLOATS
+#define QTILE (QR * DK * 2)             // = FA_DEC27_QTILE_BYTES
+#define M_INIT (-3.0e38f)
+#define LOG2E 1.4426950408889634f
+#ifndef DEC27_MT
+#define DEC27_MT 2
+#endif
+#if DEC27_MT < 1 || DEC27_MT > 8
+#error "DEC27_MT: a tile's 8 rows are 1 to 8 tokens"
+#endif
+#define DPAS(a, b, c) intel_sub_group_f16_f16_matrix_mad_k16(a, b, c)
+
+// IGC's value-returning forms of the cl_intel_subgroup_2d_block_io reads (flash_attn_dpas2.cl)
+ushort16 __builtin_IB_subgroup_block_read_flat_u16_m8k16v2(long base, int w, int h, int p, int2 c);
+uint8    __builtin_IB_subgroup_block_read_flat_transpose_u32_k8(long base, int w, int h, int p, int2 c);
+uint8    __builtin_IB_subgroup_block_read_flat_transform_u8_k32(long base, int w, int h, int p, int2 c);
+
+// the code (of 16 in 4 dwords) half h of B16's result holds
+#define DEC27_ORD(h) (4 * (((h) & 7) >> 1) + 2 * ((h) & 1) + ((h) >> 3))
+#define KV8_BIAS 1152.0f
+#define V4_BIAS  1032.0f
+#define ONES16 ((int8)(0x3C003C00))   // sixteen 1.0h, a DPAS b operand
+#define B16(w)  ((uint8)(((w) & 0x00FF00FFu) ^ 0x64806480u, (((w) >> 8) & 0x00FF00FFu) ^ 0x64806480u))
+#define B16L(w) ((uint8)(((w) & 0x000F000Fu) | 0x64006400u, (((w) >> 8) & 0x000F000Fu) | 0x64006400u))
+#define B16H(w) ((uint8)((((w) >> 4) & 0x000F000Fu) | 0x64006400u, (((w) >> 12) & 0x000F000Fu) | 0x64006400u))
+// the byte column of block b's V read, and the quant byte (of 16) lane l holds after the splice
+#define V4X(b) (18 * (b) + (((b) & 1) ? 2 : 4))
+#define V4J(b, l) (((b) & 1) ? (l) : ((l) < 14 ? (l) + 2 : (l) - 14))
+#define V4_ODIM(c, l) (16 * ((c) & 1) + V4J((c) / 2, (l)))
+#if (18 * 0 + 4) % 4 != 0 || (18 * 1 + 2) % 4 != 0 || (18 * 6 + 4) % 4 != 0 || (18 * 7 + 2) % 4 != 0
+#error "flash_attn_dec27.cl: a V read off the 4-byte grid"
+#endif
+#ifdef DEC27_RED_V_SCALE
+#define V4B(b) (((b) + 1) % NB8)      // the red case: the scale of the next block
+#else
+#define V4B(b) (b)
+#endif
+
+// The dim (of a block's 32) lane h of chunk c holds, in the Q scratch and in the K operand:
+//   an odd block (codes on dwords):         16 (c & 1) + ORD(h)
+//   an even block (codes 2 bytes off them): its first chunk codes 2 .. 17 (2 + ORD(h)), its second
+//     codes 18 .. 29 and, in the last dword, 0, 1, 30, 31
+static inline int dec27_qdim(const int c, const int h) {
+    const int ko = DEC27_ORD(h);
+    const int e1 = ko < 12 ? 18 + ko : (ko < 14 ? ko - 12 : ko + 16);
+    return 32 * (c / 2) + (((c / 2) & 1) ? 16 * (c & 1) + ko : ((c & 1) ? e1 : 2 + ko));
+}
+
+// Q to the scratch, once a call: a work-item a (q8_0 block, flat row, tile of a kv head). The
+// tile's 8 rows x 256 halves in K's lane order (unscaled; a row past the call's rows is zero), and
+// -1152 x the sum of the block's 32 f16 values as a float (the DPAS accumulator's start).
+kernel void kernel_fa_dec27_q(global const char * q, ulong q_offset, ulong q_nb1, ulong q_nb2,
+                              int n_q, int G, int n_tiles, int n_head_kv,
+                              global half * qs, global float * nqs) {
+    const int b = get_global_id(0), r = get_global_id(1), tl = get_global_id(2);
+    if (b >= NB8 || r >= QR || tl >= n_tiles * n_head_kv) return;
+    const int kvh = tl / n_tiles, tile = tl % n_tiles;
+    const int f = tile * QR + r;
+    const bool live = f < G * n_q;
+    const int head = kvh * G + (live ? f % G : 0), row = live ? f / G : 0;
+    global const float * qrow = (global const float *)(q + q_offset + (ulong) head * q_nb2 + (ulong) row * q_nb1);
+    global half * out = qs + ((size_t) tl * QR + r) * DK;
+    float sum = 0.f;
+    for (int c = 2 * b; c < 2 * b + 2; ++c) {
+        for (int h = 0; h < 16; ++h) {
+            const half x = live ? (half) qrow[dec27_qdim(c, h)] : 0.0h;
+            out[16 * c + h] = x;
+            sum += (float) x;
+        }
+    }
+    nqs[((size_t) tl * NB8 + b) * QR + r] = -KV8_BIAS * sum;
+}
+
+// Q rows 0 .. 7 of the tile, chunks 2 j and 2 j + 1: lane = the chunk's 16 dims, component = row
+#define QREAD2(j) __builtin_IB_subgroup_block_read_flat_u16_m8k16v2(qb, DK * 2 - 1, QR - 1, DK * 2 - 1, (int2)(32 * (j), 0))
+// K: 8 dwords of 16 key rows from dword w of the head, lane = key
+#define K8W(w, y) __builtin_IB_subgroup_block_read_flat_transpose_u32_k8(kb, kx + HBK - 1, n_kv - 1, kp - 1, (int2)(kx / 4 + (w), (y)))
+// V: 16 byte columns of 32 key rows from byte xb of the head, lane = byte column, a byte a key
+#define V4R(xb, y) __builtin_IB_subgroup_block_read_flat_transform_u8_k32(vb, vx + HBV - 1, n_kv - 1, vp - 1, (int2)(vx + (xb), (y)))
+
+// One pair of q8_0 blocks (2 p, 2 p + 1) of a key group into acc: E0 .. E7, X8 are the even block's
+// nine dwords, O9 .. O16 the odd block's eight; QE, QO the two blocks' Q (ushort16: two chunks)
+#ifdef DEC27_RED_K_SCALE2
+#define DEC27_KD(d) ((d) * (d))        // the red case: the scale applied twice
+#else
+#define DEC27_KD(d) (d)
+#endif
+#define DEC27_PAIR(acc, p, QE, QO, E0, E1, E2, E3, E4, E5, E6, E7, X8, O9, O10, O11, O12, O13, O14, O15, O16) { \
+        const ushort16 qe = (QE), qo = (QO); \
+        const float kde = (float) as_half((ushort) (E0)); \
+        const float kdo = (float) as_half((ushort) ((X8) >> 16)); \
+        const uint  kx0 = ((E0) >> 16) | ((X8) << 16); \
+        float8 t = nq[2 * (p)]; \
+        t = DPAS(as_short8(qe.lo), as_int8(B16((uint4)(E1, E2, E3, E4))), t); \
+        t = DPAS(as_short8(qe.hi), as_int8(B16((uint4)(E5, E6, E7, kx0))), t); \
+        acc += t * DEC27_KD(kde); \
+        t = nq[2 * (p) + 1]; \
+        t = DPAS(as_short8(qo.lo), as_int8(B16((uint4)(O9, O10, O11, O12))), t); \
+        t = DPAS(as_short8(qo.hi), as_int8(B16((uint4)(O13, O14, O15, O16))), t); \
+        acc += t * DEC27_KD(kdo); \
+    }
+// a key group's S: the nine dword reads, three in flight at most
+#define DEC27_S_GROUP(acc, y, Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7) { \
+        const uint8 ra = K8W(0, y), rb = K8W(8, y), rc = K8W(16, y); \
+        DEC27_PAIR(acc, 0, Q0, Q1, ra.s0, ra.s1, ra.s2, ra.s3, ra.s4, ra.s5, ra.s6, ra.s7, rb.s0, \
+                   rb.s1, rb.s2, rb.s3, rb.s4, rb.s5, rb.s6, rb.s7, rc.s0) \
+        const uint8 rd = K8W(24, y), re = K8W(32, y); \
+        DEC27_PAIR(acc, 1, Q2, Q3, rc.s1, rc.s2, rc.s3, rc.s4, rc.s5, rc.s6, rc.s7, rd.s0, rd.s1, \
+                   rd.s2, rd.s3, rd.s4, rd.s5, rd.s6, rd.s7, re.s0, re.s1) \
+        const uint8 rf = K8W(40, y), rg = K8W(48, y); \
+        DEC27_PAIR(acc, 2, Q4, Q5, re.s2, re.s3, re.s4, re.s5, re.s6, re.s7, rf.s0, rf.s1, rf.s2, \
+                   rf.s3, rf.s4, rf.s5, rf.s6, rf.s7, rg.s0, rg.s1, rg.s2) \
+        const uint8 rh = K8W(56, y), ri = K8W(60, y); \
+        DEC27_PAIR(acc, 3, Q6, Q7, rg.s3, rg.s4, rg.s5, rg.s6, rg.s7, rh.s0, rh.s1, rh.s2, rh.s3, \
+                   rh.s4, rh.s5, rh.s6, rh.s7, ri.s4, ri.s5, ri.s6, ri.s7) \
+    }
+
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_fa_dec27(
+        global const char * qs, global const float * nqs,
+        global const char * k, ulong k_offset, ulong k_nb1, ulong k_nb2,
+        global const char * v, ulong v_offset, ulong v_nb1, ulong v_nb2,
+        global const char * mask, ulong mask_offset, ulong mask_nb1,
+        int n_q, int n_kv, int G, int n_tiles, int n_head_kv,
+        int n_split, int split_blocks, float scale_log2,
+        global float * part)
+{
+    const int lane = get_sub_group_local_id();
+    // the ids are the same in all 16 lanes; the broadcast of lane 0 makes them uniform values to
+    // the compiler (flash_attn_port.cl's PORT_UNIFORM), so indices, branches and loops are scalar
+    const int tile = sub_group_broadcast((int) get_group_id(0), 0u);
+    const int sidx = sub_group_broadcast((int) get_global_id(1), 0u);
+    const int kvh  = sub_group_broadcast((int) get_global_id(2), 0u);
+    if (tile >= n_tiles || sidx >= n_split || kvh >= n_head_kv) return;
+    const int tl = kvh * n_tiles + tile;
+
+    // the head's first byte, as an aligned surface base and a byte offset in its rows
+    const long ka = (long) (k + k_offset) + (long) kvh * (long) k_nb2;
+    const long va = (long) (v + v_offset) + (long) kvh * (long) v_nb2;
+    const long kb = ka & ~63L, vb = va & ~63L;
+    const int  kx = (int) (ka & 63L), vx = (int) (va & 63L);
+    const int  kp = (int) k_nb1, vp = (int) v_nb1;
+    const long qb = (long) qs + (long) tl * QTILE;
+    const global float * nqp = nqs + (size_t) tl * (NB8 * QR);
+    const global half * mb = (const global half *)(mask + mask_offset);
+    const size_t mstr = (size_t) (mask_nb1 / sizeof(half));
+
+    // the tile's rows: which are live, and which of the tile's tokens each is
+    const int n_rows = G * n_q;
+    const int tk0 = (tile * QR) / G;
+    bool rlive[QR];
+    int  rslot[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        const int f = tile * QR + r;
+        rlive[r] = f < n_rows;
+        rslot[r] = min(f / G, n_q - 1) - tk0;
+    }
+    const global half * mrow[DEC27_MT];
+    bool mal[DEC27_MT];                  // the row's runs are on 4 bytes (a key group starts 32 bytes after the one before)
+    _Pragma("unroll")
+    for (int j = 0; j < DEC27_MT; ++j) {
+        mrow[j] = mb + (size_t) min(tk0 + j, n_q - 1) * mstr;
+#ifdef DEC27_RED_MASK_ALIGN
+        mal[j] = true;                   // the red case: the block read whatever the pointer
+#else
+        mal[j] = ((size_t) mrow[j] & 3) == 0;
+#endif
+    }
+
+    float8 nq[NB8];
+    _Pragma("unroll")
+    for (int b = 0; b < NB8; ++b) nq[b] = vload8(0, nqp + b * QR);
+
+    float  m[QR], l[QR];
+    float8 o[NC];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) { m[r] = M_INIT; l[r] = 0.f; }
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) o[c] = (float8)(0.f);
+
+    // this split's blocks; a split past the call's blocks walks none
+#ifdef DEC27_RED_SEAM
+    const int s_lo = sidx * split_blocks * BK + (sidx > 0 ? BK : 0);     // the red case: a seam block lost
+#else
+    const int s_lo = sidx * split_blocks * BK;
+#endif
+    const int s_hi = min(n_kv, (sidx + 1) * split_blocks * BK);
+    const int vord = lane < 8 ? 2 * lane : 2 * lane - 15;                // the key (of 16) a lane of P holds: DEC27_ORD(lane)
+    for (int t0 = s_lo; t0 < s_hi; t0 += BK) {
+        // ---- S = Q K^T: lane = key, component = row. Each key group reads Q itself (16 reads a
+        // block): with one set of Q reads for both groups, 16 more registers are in flight and the
+        // kernel spills (ocloc, both targets: 3,264 bytes of scratch) ----
+        float8 s[NKB];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            float8 acc = (float8)(0.f);
+            DEC27_S_GROUP(acc, t0 + gb * 16, QREAD2(0), QREAD2(1), QREAD2(2), QREAD2(3), QREAD2(4), QREAD2(5), QREAD2(6), QREAD2(7))
+            s[gb] = acc;
+        }
+
+        // ---- score: bounds and the mask ----
+        float sc[NKB][QR];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            const int  kg  = t0 + gb * 16;
+            const int  kk  = min(kg + lane, n_kv - 1);
+#ifdef DEC27_RED_TAIL
+            const bool inb = kg + lane < n_kv - 1;                       // the red case: the last key dropped
+#else
+            const bool inb = kg + lane < n_kv;
+#endif
+            ushort mu[DEC27_MT];
+            _Pragma("unroll")
+            for (int j = 0; j < DEC27_MT; ++j) {
+                if (kg + 16 <= n_kv && mal[j]) {
+                    mu[j] = intel_sub_group_block_read_us((const global ushort *) (mrow[j] + kg));
+                } else {
+                    mu[j] = as_ushort(mrow[j][kk]);
+                }
+            }
+            const float sv8[QR] = { s[gb].s0, s[gb].s1, s[gb].s2, s[gb].s3, s[gb].s4, s[gb].s5, s[gb].s6, s[gb].s7 };
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                ushort mr = mu[0];
+                _Pragma("unroll")
+                for (int j = 1; j < DEC27_MT; ++j) mr = rslot[r] == j ? mu[j] : mr;
+                const bool  hidden = (mr & 0x7C00) == 0x7C00 || mr == 0xFBFF;
+                const float mv = hidden ? 0.f : (float) as_half(mr);
+                sc[gb][r] = (rlive[r] && inb && !hidden) ? sv8[r] * scale_log2 + LOG2E * mv : M_INIT;
+            }
+        }
+
+        // ---- the online softmax: the rows' block maxima, alpha, l ----
+        float alpha[QR];
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            const float mx = sub_group_reduce_max(fmax(sc[0][r], sc[1][r]));
+            const float mn = fmax(m[r], mx);
+            alpha[r] = native_exp2(m[r] - mn);
+            m[r] = mn;
+            l[r] *= alpha[r];
+        }
+
+        // ---- p = exp2(s - m) <= 1, rounded to f16 once; l the lane's partial sum; P in V's key order ----
+        float ps[NKB][QR];
+        _Pragma("unroll")
+        for (int gb = 0; gb < NKB; ++gb) {
+            _Pragma("unroll")
+            for (int r = 0; r < QR; ++r) {
+                const float pf = (float) (half) (sc[gb][r] > 0.5f * M_INIT ? native_exp2(sc[gb][r] - m[r]) : 0.f);
+                l[r] += pf;
+                ps[gb][r] = intel_sub_group_shuffle(pf, (uint) vord);
+            }
+        }
+
+        // ---- O = O alpha + sum over keys of p d (nibble - 8): lane = quant byte, components = rows ----
+        const float8 av = (float8)(alpha[0], alpha[1], alpha[2], alpha[3], alpha[4], alpha[5], alpha[6], alpha[7]);
+        _Pragma("unroll")
+        for (int b = 0; b < NB8; ++b) {
+            short8 pe[NKB];
+            // the binary exponent of the largest |d| among the block's 32 keys (0: every scale is zero, c = 1), c and
+            // 1 / c: uniform. The scales are read here for the exponent alone and again where P takes them
+            float cn, ic;
+            {
+                const float dr0 = vload_half(0, (global const half *)(v + v_offset + (ulong) kvh * v_nb2 + (ulong) min(t0 + lane, n_kv - 1) * v_nb1 + 18 * V4B(b)));
+                const float dr1 = vload_half(0, (global const half *)(v + v_offset + (ulong) kvh * v_nb2 + (ulong) min(t0 + 16 + lane, n_kv - 1) * v_nb1 + 18 * V4B(b)));
+                const uint  eb  = (as_uint(sub_group_broadcast(sub_group_reduce_max(fmax(fabs(dr0), fabs(dr1))), 0u)) >> 23) & 0xFFu;
+                // eb 0: every scale is zero (or subnormal as a float, which an f16 scale never is); eb 255: a scale
+                // that is inf or NaN. Neither is normalised (c = 1): the block's sum is then whatever those scales give
+                const bool en = eb != 0u && eb != 255u;
+                cn = en ? as_float((254u - eb) << 23) : 1.f;
+#ifdef DEC27_RED_PVNORM_IC
+                ic = 1.f;                        // the red case: the block's sum left at the normalised scale
+#else
+                ic = en ? as_float(eb << 23) : 1.f;
+#endif
+            }
+            _Pragma("unroll")
+            for (int gb = 0; gb < NKB; ++gb) {
+                // the scale of this lane's key: a row past n_kv repeats the last one (its p is 0)
+                const int kr = min(t0 + gb * 16 + vord, n_kv - 1);
+                const float ds = cn * vload_half(0, (global const half *)(v + v_offset + (ulong) kvh * v_nb2 + (ulong) kr * v_nb1 + 18 * V4B(b)));
+                half eh[QR];
+                _Pragma("unroll")
+                for (int r = 0; r < QR; ++r) eh[r] = (half)(ps[gb][r] * ds);
+                pe[gb] = as_short8((half8)(eh[0], eh[1], eh[2], eh[3], eh[4], eh[5], eh[6], eh[7]));
+            }
+            const float8 ns = DPAS(pe[1], ONES16, DPAS(pe[0], ONES16, (float8)(0.f))) * -V4_BIAS;
+            uint8 vr = V4R(V4X(b), t0);          // 4 dwords a lane: the first key group, then the second
+            if ((b & 1) == 0) {
+                // an even block: lanes 14, 15 read the next block's scale; they take the block's quant
+                // bytes 0, 1 from lanes 2, 3 of a read at the block's first byte
+                const uint8 v0 = V4R(18 * b, t0);
+                const uint vsrc = (uint) (lane >= 14 ? lane - 12 : lane);
+                const int  vfix = lane >= 14;
+                vr = (uint8)(vfix ? intel_sub_group_shuffle(v0.s0, vsrc) : vr.s0, vfix ? intel_sub_group_shuffle(v0.s1, vsrc) : vr.s1,
+                             vfix ? intel_sub_group_shuffle(v0.s2, vsrc) : vr.s2, vfix ? intel_sub_group_shuffle(v0.s3, vsrc) : vr.s3,
+                             vfix ? intel_sub_group_shuffle(v0.s4, vsrc) : vr.s4, vfix ? intel_sub_group_shuffle(v0.s5, vsrc) : vr.s5,
+                             vfix ? intel_sub_group_shuffle(v0.s6, vsrc) : vr.s6, vfix ? intel_sub_group_shuffle(v0.s7, vsrc) : vr.s7);
+            }
+            // O goes to the block's normalised scale (x c, exact), takes the two DPAS there, and comes back (x 1 / c):
+            // the same registers as the default form
+            float8 acc = o[2 * b] * av * cn + ns;    // the low nibbles: dims 32 b + j
+            acc = DPAS(pe[0], as_int8(B16L(vr.lo)), acc);
+            acc = DPAS(pe[1], as_int8(B16L(vr.hi)), acc);
+            o[2 * b] = acc * ic;
+            acc = o[2 * b + 1] * av * cn + ns;   // the high nibbles: dims 32 b + 16 + j
+            acc = DPAS(pe[0], as_int8(B16H(vr.lo)), acc);
+            acc = DPAS(pe[1], as_int8(B16H(vr.hi)), acc);
+            o[2 * b + 1] = acc * ic;
+        }
+    }
+
+    // ---- the split's state: O as the sub-group holds it, then the rows' m (lanes 0 .. 7) and their
+    // reduced l (lanes 8 .. 15); the merge divides ----
+    global float * st = part + ((size_t) (sidx * n_head_kv + kvh) * (size_t) n_tiles + (size_t) tile) * STATE;
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) intel_sub_group_block_write8((global uint *) (st + c * QR * 16), as_uint8(o[c]));
+    float mlv = 0.f;
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) {
+        const float lv = sub_group_reduce_add(l[r]);
+        mlv = lane == r ? m[r] : (lane == QR + r ? lv : mlv);
+    }
+    st[NC * QR * 16 + lane] = mlv;
+}
+
+// The merge of a call's split states, one sub-group a (tile, kv head): M = max m_s, w_s = exp2(m_s
+// - M), O = sum w_s O_s, l = sum w_s l_s, out = O / (8 l) into the op's dst at head * o_nb1 + row *
+// o_nb2. A split that walked no visible key has (M_INIT, 0) and weighs 0; a row no split saw is 0.
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_fa_dec27_merge(global const float * part, global char * dst, ulong o_offset, ulong o_nb1, ulong o_nb2,
+                                  int n_q, int G, int n_tiles, int n_head_kv, int n_split)
+{
+    const int lane = get_sub_group_local_id();
+    const int tile = sub_group_broadcast((int) get_global_id(1), 0u);
+    const int kvh  = sub_group_broadcast((int) get_global_id(2), 0u);
+    if (tile >= n_tiles || kvh >= n_head_kv) return;
+    const size_t sstride = (size_t) n_head_kv * (size_t) n_tiles * STATE;    // one split's states
+    global const float * st0 = part + ((size_t) kvh * (size_t) n_tiles + (size_t) tile) * STATE;
+
+    float mx[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) mx[r] = M_INIT;
+    for (int s = 0; s < n_split; ++s) {
+        const float ml = st0[(size_t) s * sstride + NC * QR * 16 + lane];
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) mx[r] = fmax(mx[r], sub_group_broadcast(ml, (uint) r));
+    }
+
+    float  ls[QR];
+    float8 o[NC];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) ls[r] = 0.f;
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) o[c] = (float8)(0.f);
+    for (int s = 0; s < n_split; ++s) {
+        global const float * st = st0 + (size_t) s * sstride;
+        const float ml = st[NC * QR * 16 + lane];
+        float w[QR];
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            const float ms = sub_group_broadcast(ml, (uint) r), lv = sub_group_broadcast(ml, (uint) (QR + r));
+#ifdef DEC27_RED_NOMAX
+            w[r] = 1.f;                          // the red case: the states added without their maxima
+#else
+            w[r] = ms > 0.5f * M_INIT ? native_exp2(ms - mx[r]) : 0.f;
+#endif
+            ls[r] += w[r] * lv;
+        }
+        const float8 wv = (float8)(w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+        _Pragma("unroll")
+        for (int c = 0; c < NC; ++c) o[c] += wv * as_float8(intel_sub_group_block_read8((global const uint *) (st + c * QR * 16)));
+    }
+    float inv[QR];
+    _Pragma("unroll")
+    for (int r = 0; r < QR; ++r) inv[r] = ls[r] > 0.f ? 1.f / ls[r] : 0.f;                   // O holds the sum itself
+    const int n_rows = G * n_q;
+    _Pragma("unroll")
+    for (int c = 0; c < NC; ++c) {
+        const float ov[QR] = { o[c].s0, o[c].s1, o[c].s2, o[c].s3, o[c].s4, o[c].s5, o[c].s6, o[c].s7 };
+        _Pragma("unroll")
+        for (int r = 0; r < QR; ++r) {
+            const int f = tile * QR + r;
+            if (f >= n_rows) continue;
+            global float * orow = (global float *)(dst + o_offset + (size_t) (kvh * G + f % G) * o_nb1 + (size_t) (f / G) * o_nb2);
+            orow[32 * (c / 2) + V4_ODIM(c, lane)] = ov[r] * inv[r];
+        }
+    }
+}
