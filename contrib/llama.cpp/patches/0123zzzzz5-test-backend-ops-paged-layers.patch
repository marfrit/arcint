diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index f0fc7ab..650f479 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -9368,6 +9368,136 @@ struct test_flash_attn_ext_paged : public test_case {
     }
 };
 
+// 0123zzzzz3: the per-layer page move. TWO attention layers share one ring (the
+// stream's slots[ikv % 2] are shared across layers) but each has its own pool, host
+// store and the same plan; both attention nodes are one graph joined by an ADD.
+// Every call must read its own host-store pages, not what the previous call left in
+// the slot. The CPU reference performs the same per-layer copy, so a backend that
+// copies every layer up front (read: the old bug) reads the last layer's pages and
+// the summed output differs. The table row is the same for both layers; the ring
+// starts with random bytes (copied to the reference backend like every input), and
+// only the streamed pages are overwritten by the copy.
+struct test_flash_attn_ext_paged_layers : public test_case {
+    static constexpr int64_t page = 256;
+
+    const int64_t hs;
+    const int64_t nh;
+    const int64_t nr;
+    const int64_t kv;
+    const int64_t nb;
+    const ggml_type type_K;
+    const ggml_type type_V;
+    const int ring_every;
+    const int64_t n_slots;
+
+    std::string vars() override {
+        return VARS_TO_STR9(hs, nh, nr, kv, nb, type_K, type_V, ring_every, n_slots) + ",2 layers";
+    }
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FLASH_ATTN_EXT (paged, 2 layers)";
+    }
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return 4 * nh*nr * nb * (2*hs) * kv;   // two attention layers
+    }
+
+    test_flash_attn_ext_paged_layers(int64_t hs = 256, int64_t nh = 4, int64_t nr = 6, int64_t kv = 1024, int64_t nb = 6,
+            ggml_type type_K = GGML_TYPE_Q8_0, ggml_type type_V = GGML_TYPE_Q4_0, int ring_every = 2, int64_t n_slots = 2)
+        : hs(hs), nh(nh), nr(nr), kv(kv), nb(nb), type_K(type_K), type_V(type_V), ring_every(ring_every), n_slots(n_slots) {}
+
+    int64_t n_pages() const { return kv / page; }
+    int64_t n_ring()  const { return ring_every ? (n_pages() + ring_every - 1) / ring_every : 0; }
+    int64_t n_res()   const { return n_pages() - n_ring(); }
+    int64_t pool_rows() const { return (n_slots + 3) * page; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        GGML_ASSERT(kv % page == 0);
+        GGML_ASSERT(n_res() <= n_slots && "the paged case's pool cannot hold its resident pages");
+
+        auto heads = [&](ggml_type type, int64_t rows, const char * name) {
+            ggml_tensor * t = ggml_new_tensor_2d(ctx, type, hs*nh, rows);
+            ggml_set_name(t, name);
+            return ggml_view_4d(ctx, t, hs, rows, nh, 1, t->nb[1], ggml_row_size(type, hs), ggml_nbytes(t), 0);
+        };
+        auto host_page = [&](ggml_type type, const char * name) {
+            ggml_tensor * t = ggml_new_tensor_3d(ctx, type, hs*nh, page, n_pages());   // the stream's host store
+            ggml_set_name(t, name);
+            return t;
+        };
+
+        ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hs, nb, nh*nr, 1);
+        ggml_set_name(q, "q");
+
+        // one ring for both layers, like the stream's two slots shared across layers
+        ggml_tensor * rk = n_ring() ? heads(type_K, (n_ring() + 1) * page, "k_ring") : nullptr;
+        ggml_tensor * rv = n_ring() ? heads(type_V, (n_ring() + 1) * page, "v_ring") : nullptr;
+
+        ggml_tensor * m = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, kv, nb, 1, 1);
+        ggml_set_name(m, "m");
+
+        ggml_tensor * pages = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_pages(), 2);
+        ggml_set_name(pages, "pages");
+        ggml_tensor * plan = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_pages(), 1);
+        ggml_set_name(plan, "plan");
+
+        ggml_tensor * out = nullptr;
+        for (int l = 0; l < 2; ++l) {
+            char kname[32], vname[32], hkname[32], hvname[32];
+            snprintf(kname, sizeof(kname), "k_pool%d", l);
+            snprintf(vname, sizeof(vname), "v_pool%d", l);
+            snprintf(hkname, sizeof(hkname), "k_host%d", l);
+            snprintf(hvname, sizeof(hvname), "v_host%d", l);
+            ggml_tensor * k = heads(type_K, pool_rows(), kname);
+            ggml_tensor * v = heads(type_V, pool_rows(), vname);
+            ggml_tensor * hk = host_page(type_K, hkname);
+            ggml_tensor * hv = host_page(type_V, hvname);
+            ggml_tensor * o = ggml_flash_attn_ext(ctx, q, k, v, m, 1.0f/sqrtf(hs), 0.0f, 0.0f);
+            ggml_flash_attn_ext_set_pages(o, pages, l, page, rk, rv);
+            ggml_flash_attn_ext_set_host(o, hk, hv, plan);
+            ggml_prec_set_acc(o, GGML_PREC_F32);
+            char oname[16]; snprintf(oname, sizeof(oname), "out%d", l);
+            ggml_set_name(o, oname);
+            out = out ? ggml_add(ctx, out, o) : o;
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "pages") == 0) {
+                std::vector<int32_t> slots(n_slots);
+                std::iota(slots.begin(), slots.end(), 0);
+                std::shuffle(slots.begin(), slots.end(), std::mt19937(1234));
+                std::vector<int32_t> table(2*n_pages(), INT32_MAX);
+                int32_t res = 0, ring = 0;
+                for (int64_t i = 0; i < n_pages(); ++i) {
+                    const int32_t e = ring_every && i % ring_every == 0
+                        ? -1 - (int32_t) (n_ring() - 1 - ring++) : slots[(size_t) res++];
+                    table[n_pages() + i] = e;
+                }
+                ggml_backend_tensor_set(t, table.data(), 0, ggml_nbytes(t));
+            } else if (strcmp(t->name, "plan") == 0) {
+                // the plan the stream fills in prepare: the ring row of each streamed page, -1 resident
+                std::vector<int32_t> pl((size_t) n_pages(), -1);
+                int32_t ring = 0;
+                for (int64_t i = 0; i < n_pages(); ++i) {
+                    if (ring_every && i % ring_every == 0) pl[(size_t) i] = ring++;
+                }
+                ggml_backend_tensor_set(t, pl.data(), 0, ggml_nbytes(t));
+            } else if (strcmp(t->name, "m") == 0) {
+                init_tensor_kq_mask(t);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
+
 struct test_flash_attn_ext_large_logits : public test_flash_attn_ext {
     static constexpr int q_range = 20;
 
@@ -12997,6 +13127,10 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     // q4_0 V staging (or the conversion for V), a failure on both names the K side.
     test_cases.emplace_back(new test_flash_attn_ext_paged(256, 4, 6, 8192, 6, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, 2, 16));
     test_cases.emplace_back(new test_flash_attn_ext_paged(256, 4, 6, 8192, 6, GGML_TYPE_Q4_0, GGML_TYPE_Q4_0, 2, 16));
+    // 0123zzzzz3: two attention layers over one shared ring, each with its own pool and host store,
+    // joined by an ADD (decode and a 6-row verify); the per-layer copy is what the CPU reference does too
+    test_cases.emplace_back(new test_flash_attn_ext_paged_layers(256, 4, 6, 8192, 1, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0, 2, 16));
+    test_cases.emplace_back(new test_flash_attn_ext_paged_layers(256, 4, 6, 8192, 6, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0, 2, 16));
     test_cases.emplace_back(new test_flash_attn_ext_paged(256, 4, 6, 8192, 512, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, 2, 16));
     // Mistral Small 24B's geometry (head size 128, 32 query heads on 8):
     // decode, verify rows, prompts; f16 and quantized K/V
