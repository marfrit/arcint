--- a/ggml/src/ggml-opencl/kernels/mul_mv_iq_q8_1.cl
+++ b/ggml/src/ggml-opencl/kernels/mul_mv_iq_q8_1.cl
@@ -1989,13 +1989,91 @@ kernel void kernel_dsv4_hc_post(global const char * x, ulong offx, global const
 
 // ---- the MoE router's top-k in one kernel (llama.cpp's CUDA topk_moe fusion):
 // softmax over a token's logits, the k largest in descending order (ties: the
-// lower expert), and their probabilities normalized by their clamped sum. A
-// work-group a token; the six kernels it replaces cost ~22 us and six launch
-// gaps a layer (B60, profiled). ----
-#define TOPK_MAX_EXPERT 1024
-#define TOPK_MAX_K      32
+// lower expert), and their probabilities normalized by their clamped sum.
+//
+// One sub-group handles one token, TOPK_MOE_TOKENS_PER_WG tokens a work-group,
+// so decode (1..5 tokens) fills a whole work-group and prefill keeps the GPU
+// busy. The token's probabilities live in one register per expert per lane
+// (expert i = lane + TOPK_MOE_SG_SIZE * j), and the row max, the probability
+// sum and the k selections are sub-group reductions only: no local memory and
+// no barrier inside a token. GGML_OPENCL_TOPK_MOE_LEGACY=1 selects the old
+// work-group-per-token kernel below. ----
+#define TOPK_MAX_EXPERT          1024
+#define TOPK_MAX_K              32
+#define TOPK_MOE_SG_SIZE        16
+#ifndef TOPK_MOE_TOKENS_PER_WG
+#define TOPK_MOE_TOKENS_PER_WG  4
+#endif
+
+// One kernel per NPER bucket, so the private array is only as large as the
+// token's expert count needs: NPER = 4, 8, 16, 32, 64 for n_expert <= 64, 128,
+// 256, 512, 1024. A larger bucket is harmless but spills registers, so the
+// host picks the smallest bucket whose NPER * 16 covers n_expert.
+#define TOPK_MOE_BODY(NPER) \
+    const int sg = get_sub_group_id(), ln = get_sub_group_local_id(); \
+    const int t = get_group_id(0) * TOPK_MOE_TOKENS_PER_WG + sg; \
+    if (t >= n_tok) return; \
+    \
+    global const float * x = (global const float *)(lg + offl + (ulong)t * nbl1); \
+    global int * io = (global int *)(ids + offi + (ulong)t * nbi1); \
+    global float * wo = (global float *)(w + offw + (ulong)t * nbw1); \
+    \
+    /* p[j]: expert i = ln + TOPK_MOE_SG_SIZE * j; sel: bit j = p[j] taken */ \
+    float p[NPER]; \
+    ulong sel = 0; \
+    float m = -INFINITY; \
+    _Pragma("unroll") \
+    for (int j = 0; j < NPER; ++j) { \
+        const int i = ln + TOPK_MOE_SG_SIZE * j; \
+        p[j] = i < n_expert ? x[i] : -INFINITY; \
+        m = fmax(m, p[j]); \
+    } \
+    m = sub_group_reduce_max(m); \
+    float s = 0.0f; \
+    _Pragma("unroll") \
+    for (int j = 0; j < NPER; ++j) { \
+        const int i = ln + TOPK_MOE_SG_SIZE * j; \
+        if (i < n_expert) { p[j] = exp(p[j] - m); s += p[j]; } \
+    } \
+    s = sub_group_reduce_add(s); \
+    \
+    float wsum = 0.0f; \
+    for (int j = 0; j < k; ++j) { \
+        float bv = -1.0f; \
+        int   bi = INT_MAX; \
+        _Pragma("unroll") \
+        for (int q = 0; q < NPER; ++q) { \
+            if ((sel & (1UL << q)) == 0 && p[q] > bv) { bv = p[q]; bi = ln + TOPK_MOE_SG_SIZE * q; } \
+        } \
+        const float gv = sub_group_reduce_max(bv); \
+        const int   gi = sub_group_reduce_min(bv == gv ? bi : INT_MAX); \
+        if (ln == 0) { io[j] = gi; wo[j] = gv / s; wsum += gv / s; } \
+        if (gi < n_expert && (gi & (TOPK_MOE_SG_SIZE - 1)) == ln) sel |= 1UL << (gi / TOPK_MOE_SG_SIZE); \
+    } \
+    if (ln == 0) { \
+        const float sum = clamp(wsum, cmin, cmax); \
+        for (int j = 0; j < k; ++j) wo[j] = wo[j] / sum; \
+    }
+
+#define TOPK_MOE_KERNEL(N) \
+__attribute__((intel_reqd_sub_group_size(TOPK_MOE_SG_SIZE))) \
+kernel void kernel_topk_moe_softmax_norm_n##N(global const char * lg, ulong offl, ulong nbl1, \
+                                         global char * ids, ulong offi, ulong nbi1, \
+                                         global char * w, ulong offw, ulong nbw1, \
+                                         int n_expert, int k, int n_tok, float cmin, float cmax) { \
+    TOPK_MOE_BODY(N) \
+}
+
+TOPK_MOE_KERNEL(4)
+TOPK_MOE_KERNEL(8)
+TOPK_MOE_KERNEL(16)
+TOPK_MOE_KERNEL(32)
+TOPK_MOE_KERNEL(64)
+
+// the previous version: one work-group (256 work-items) per token, the
+// probabilities and the selection in local memory
 __attribute__((intel_reqd_sub_group_size(16)))
-kernel void kernel_topk_moe_softmax_norm(global const char * lg, ulong offl, ulong nbl1,
+kernel void kernel_topk_moe_softmax_norm_legacy(global const char * lg, ulong offl, ulong nbl1,
                                          global char * ids, ulong offi, ulong nbi1,
                                          global char * w, ulong offw, ulong nbw1,
                                          int n_expert, int k, float cmin, float cmax) {
@@ -2004,7 +2082,6 @@ kernel void kernel_topk_moe_softmax_norm(global const char * lg, ulong offl, ulo
     local float sv[16];
     local int   si[16];
