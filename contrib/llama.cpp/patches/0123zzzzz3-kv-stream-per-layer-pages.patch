     ggml_tensor d = *dst;
-    for (int i = GGML_FA_SRC_PAGES; i <= GGML_FA_SRC_TAG; ++i) {
+    for (int i = GGML_FA_SRC_PAGES; i <= GGML_FA_SRC_PLAN; ++i) {
         d.src[i] = nullptr;
     }
 
@@ -9751,6 +9751,40 @@ static void ggml_compute_forward_flash_attn_ext_paged(
         const int64_t n_kv = pages->ne[0]*page_size;
         const int32_t * table = ggml_flash_attn_ext_get_pages(dst);
 
+        // 0123zzzzz3: this attention layer's streamed pages, from its host store into the ring
+        // slots, here and now rather than for every layer up front: whatever the ring held at
+        // the previous layer's attention is replaced before this one reads it, so the two
+        // slots can be shared by later layers. On the CPU backend the host store, the plan and
+        // the ring are host memory (the device-free arm); OpenCL moves them in its dispatch.
+        {
+            const ggml_tensor * host_k = dst->src[GGML_FA_SRC_HOST_K];
+            const ggml_tensor * host_v = dst->src[GGML_FA_SRC_HOST_V];
+            const ggml_tensor * plan   = dst->src[GGML_FA_SRC_PLAN];
+            if (plan) {
+                GGML_ASSERT(host_k && host_v && host_k->buffer && host_v->buffer && plan->buffer);
+                GGML_ASSERT(ggml_backend_buffer_is_host(host_k->buffer) &&
+                            ggml_backend_buffer_is_host(host_v->buffer) &&
+                            ggml_backend_buffer_is_host(plan->buffer));
+                if (params->ith == 0) {
+                    const int32_t * pl = (const int32_t *) plan->data;
+                    const char * hk = (const char *) host_k->data;
+                    const char * hv = (const char *) host_v->data;
+                    const char * rk = (const char *) ring_k->data;
+                    const char * rv = (const char *) ring_v->data;
+                    const size_t kb = (size_t) host_k->nb[2];   // a page of K: page_size rows
+                    const size_t vb = (size_t) host_v->nb[2];
+                    const size_t rb = (size_t) ring_k->nb[1];   // the slot's row (all heads of a cell)
+                    for (int64_t p = 0; p < plan->ne[0]; ++p) {
+                        const int32_t row = pl[p];
+                        if (row < 0) continue;   // a resident page: the pool holds it
+                        memcpy((char *) rk + (size_t) row*page_size*rb, hk + (size_t) p*kb, kb);
+                        memcpy((char *) rv + (size_t) row*page_size*rb, hv + (size_t) p*vb, vb);
+                    }
+                }
+                ggml_barrier(params->threadpool);
+            }
+        }
+
         // contiguous [D, n_kv, H, 1] copies at the end of the work buffer (ggml_graph_plan reserves the space)
         const size_t row_k = ggml_row_size(k->type, k->ne[0]);
         const size_t row_v = ggml_row_size(v->type, v->ne[0]);
