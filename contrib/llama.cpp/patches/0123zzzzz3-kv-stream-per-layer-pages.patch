+// 0123zzzzz3: the streamed pages of this attention layer, from the host store (USM host memory)
+// into the two ring slots, on this device's in-order compute queue right before the kernels below
+// read them. Layer i's copies therefore run while layer i's own attention runs, and the slot layer
+// i+2 reuses is only overwritten after layer i's kernels were enqueued, so no two layers share a
+// slot's content at the time of their attention. The host store is read once per attention call.
+static void ggml_cl_fa_kv_stream_pages(ggml_backend_opencl_context * backend_ctx, const ggml_tensor * dst) {
+    const ggml_tensor * plan = dst->src[GGML_FA_SRC_PLAN];
+    if (!plan) {
+        return;
+    }
+    const ggml_tensor * host_k = dst->src[GGML_FA_SRC_HOST_K];
+    const ggml_tensor * host_v = dst->src[GGML_FA_SRC_HOST_V];
+    const ggml_tensor * ring_k = dst->src[GGML_FA_SRC_RING_K];
+    const ggml_tensor * ring_v = dst->src[GGML_FA_SRC_RING_V];
+    GGML_ASSERT(host_k && host_v && ring_k && ring_v);
+
+    const char * hk = (const char *) ggml_backend_opencl_usm_ptr(host_k);
+    const char * hv = (const char *) ggml_backend_opencl_usm_ptr(host_v);
+    const int32_t * pl = (const int32_t *) ggml_backend_opencl_usm_ptr(plan);
+    if (hk == nullptr || hv == nullptr || pl == nullptr) {
+        GGML_ABORT("ggml_opencl: a paged attention with a host store that is not USM host memory");
+    }
+
+    ggml_cl_region rk[2], rv[2];
+    const int nrk = ggml_cl_regions(ring_k, rk);
+    const int nrv = ggml_cl_regions(ring_v, rv);
+    GGML_ASSERT(nrk == 1 && nrv == 1 && rk[0].mem && rv[0].mem);
+
+    const int ps = ggml_get_op_params_i32(dst, GGML_FA_PARAM_PAGE_SIZE);
+    const size_t kb = (size_t) host_k->nb[2];   // a page of K: page_size rows
+    const size_t vb = (size_t) host_v->nb[2];
+    const size_t rb = (size_t) ring_k->nb[1];   // the K slot's row (all its heads of a cell)
+    const size_t rvb = (size_t) ring_v->nb[1];
+    const int64_t n_pages = plan->ne[0];
+
+    cl_command_queue queue = backend_ctx->queue;
+    for (int64_t p = 0; p < n_pages; ++p) {
+        const int32_t row = pl[p];
+        if (row < 0) {
+            continue;   // a resident page: the kernel reads it from the pool
+        }
+        const cl_ulong off_k = rk[0].off + (cl_ulong) ring_k->view_offs;
+        const cl_ulong off_v = rv[0].off + (cl_ulong) ring_v->view_offs;
+        CL_CHECK(clEnqueueWriteBuffer(queue, rk[0].mem, CL_FALSE, off_k + (cl_ulong) row*ps*rb, (size_t) kb,
+                                      hk + (size_t) p*kb, 0, NULL, NULL));
+        CL_CHECK(clEnqueueWriteBuffer(queue, rv[0].mem, CL_FALSE, off_v + (cl_ulong) row*ps*rvb, (size_t) vb,
+                                      hv + (size_t) p*vb, 0, NULL, NULL));
+    }
+}
+
 static void ggml_cl_flash_attn(ggml_backend_t backend, const ggml_tensor * q, const ggml_tensor * k, ggml_tensor * dst) {
     const ggml_tensor * v = dst->src[2];
     const ggml_tensor * mask = dst->src[3];
@@ -23550,6 +23604,9 @@ static void ggml_cl_flash_attn(ggml_backend_t backend, const ggml_tensor * q, co
 
     ggml_backend_opencl_context *backend_ctx = (ggml_backend_opencl_context *)backend->context;
 
+    // 0123zzzzz3: this layer's streamed pages into its ring slot, before anything reads it
+    ggml_cl_fa_kv_stream_pages(backend_ctx, dst);
+
     const int n_q = q->ne[1];
     // paged K/V (0119): the attended length is the page table's pages * page_size,
     // not the pool's rows; 0122's GQA kernel resolves every row through the table
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 0c6b3cd..63ee87d 100644
--- a/ggml/src/ggml.c
