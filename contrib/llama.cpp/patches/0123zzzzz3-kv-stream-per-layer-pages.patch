         }
     }
 
@@ -3430,9 +3435,14 @@ ggml_tensor * llm_graph_context::build_attn(
         GGML_ASSERT(fa.op == LLM_FUSED_OP_FLASH_ATTN && fa.il == il);
         ggml_flash_attn_ext_set_pages(fa.tensor, inp->self_kv_pages, mctx_cur->kv_layer_index(il),
                 llama_kv_stream::page_size, inp->self_kv_ring_k[(size_t) il], inp->self_kv_ring_v[(size_t) il]);
+        ggml_flash_attn_ext_set_host(fa.tensor, inp->self_kv_host_k[(size_t) il],
+                inp->self_kv_host_v[(size_t) il], inp->self_kv_plan);
         ggml_build_forward_expand(gf, inp->self_kv_pages);
         ggml_build_forward_expand(gf, inp->self_kv_ring_k[(size_t) il]);
         ggml_build_forward_expand(gf, inp->self_kv_ring_v[(size_t) il]);
+        ggml_build_forward_expand(gf, inp->self_kv_host_k[(size_t) il]);
+        ggml_build_forward_expand(gf, inp->self_kv_host_v[(size_t) il]);
+        ggml_build_forward_expand(gf, inp->self_kv_plan);
     }
 
     if (inp->self_v_rot) {
