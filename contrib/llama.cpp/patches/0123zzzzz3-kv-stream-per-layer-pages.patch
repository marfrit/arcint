 }
 
+void ggml_flash_attn_ext_set_host(
+        struct ggml_tensor * a,
+        struct ggml_tensor * host_k,
+        struct ggml_tensor * host_v,
+        struct ggml_tensor * plan) {
+    GGML_ASSERT(a->op == GGML_OP_FLASH_ATTN_EXT && a->src[GGML_FA_SRC_PAGES] && a->src[GGML_FA_SRC_RING_K]);
+    GGML_ASSERT(host_k && host_v && plan);
+    GGML_ASSERT(plan->type == GGML_TYPE_I32 && ggml_is_contiguous(plan) && plan->ne[0] >= a->src[GGML_FA_SRC_PAGES]->ne[0]);
+    // a host page is the ring's row layout: all KV heads of a cell contiguous
+    GGML_ASSERT(host_k->type == a->src[1]->type && host_k->ne[1] == (int64_t) ggml_get_op_params_i32(a, GGML_FA_PARAM_PAGE_SIZE) &&
+                host_k->ne[2] >= a->src[GGML_FA_SRC_PAGES]->ne[0] && host_k->nb[0] == ggml_type_size(host_k->type));
+    GGML_ASSERT(host_v->type == a->src[2]->type && host_v->ne[1] == (int64_t) ggml_get_op_params_i32(a, GGML_FA_PARAM_PAGE_SIZE) &&
+                host_v->ne[2] >= a->src[GGML_FA_SRC_PAGES]->ne[0] && host_v->nb[0] == ggml_type_size(host_v->type));
+
+    a->src[GGML_FA_SRC_HOST_K] = host_k;
+    a->src[GGML_FA_SRC_HOST_V] = host_v;
+    a->src[GGML_FA_SRC_PLAN]   = plan;
+}
+
 void ggml_flash_attn_ext_set_page_runs(
         struct ggml_tensor             * a,
         const struct ggml_fa_page_runs * runs) {
