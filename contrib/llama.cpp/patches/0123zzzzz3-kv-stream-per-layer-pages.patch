diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index c2074ec..6319c6e 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2544,6 +2544,17 @@ extern "C" {
             struct ggml_tensor * ring_k,
             struct ggml_tensor * ring_v);
 
+    // Paged K/V with the streamed pages in a host store: host_k/host_v are the attention layer's pages
+    // as USM host memory ([n_embd, page_size, n_pages], host memory on a CPU backend), and plan is I32
+    // [n_pages]: the ring row of each streamed logical page, or -1 for a resident one. A backend moves
+    // the plan's pages into ring_k/ring_v per attention call (OpenCL: on its in-order queue before the
+    // kernels), so no two layers share a ring slot's content while their attention reads it.
+    GGML_API void ggml_flash_attn_ext_set_host(
+            struct ggml_tensor * a,
+            struct ggml_tensor * host_k,
+            struct ggml_tensor * host_v,
+            struct ggml_tensor * plan);
+
     // A run of consecutive logical pages that are also consecutive in the pool (pool != 0) or in the ring
     struct ggml_fa_page_run {
         int32_t page; // first logical page
