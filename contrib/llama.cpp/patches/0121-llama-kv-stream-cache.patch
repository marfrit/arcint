diff --git a/include/llama.h b/include/llama.h
index d91e93e..6ee488d 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -454,6 +454,11 @@ extern "C" {
         // batch's ubatches are cut so that ubatch tokens x cells stay within n_ubatch x n_kv_reserve:
         // a long context does not reserve a full-context prompt's buffers for the whole session
         uint32_t n_kv_reserve;
+
+        // KV streaming (0119-0122, docs/campaigns/kv-streaming-design.md): device bytes of the
+        // resident KV pages; 0 keeps the whole cache in device memory. Requires flash attention,
+        // one sequence, q8_0 K / q4_0 V, head size 256 (the paged kernel's shapes).
+        uint32_t kv_resident_size;
     };
 
     struct llama_model_tensor_override {
