@@ -343,6 +343,7 @@ llama_context::llama_context(
     cparams.n_ubatch_reserve = std::min(cparams.n_ubatch, params.n_ubatch_reserve == 0 ? cparams.n_ubatch : params.n_ubatch_reserve);
     reserve_ubatch = cparams.n_ubatch_reserve;
     cparams.n_kv_reserve = params.n_kv_reserve == 0 ? 0 : GGML_PAD(params.n_kv_reserve, 256);
+    cparams.kv_resident_size = params.kv_resident_size;
 
     cparams.n_outputs_max = params.n_outputs_max == 0 || llama_model_has_encoder(&model) ? cparams.n_batch : params.n_outputs_max;
     cparams.n_outputs_max_per_seq = params.n_outputs_max_per_seq == 0 ?
@@ -5135,6 +5136,7 @@ llama_context_params llama_context_default_params() {
         /*.n_sampler                   =*/ 0,
         /*.ctx_other                   =*/ nullptr,
         /*.n_kv_reserve                =*/ 0,
+        /*.kv_resident_size            =*/ 0,
     };
 
     return result;
diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index 8c7bb4a..6ded57e 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -14,6 +14,7 @@ struct llama_cparams {
     uint32_t n_ubatch;
     uint32_t n_ubatch_reserve; // the ubatch the buffers are reserved for (0: n_ubatch)
     uint32_t n_kv_reserve;    // the cells the compute buffers are reserved for, 0 = all (llama_context_params)
+    uint32_t kv_resident_size = 0; // KV streaming: device bytes of the resident pages (0119-0122)
     uint32_t n_seq_max;
     uint32_t n_rs_seq;        // number of recurrent-state snapshots per seq for rollback
