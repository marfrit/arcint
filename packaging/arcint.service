# arcint as a systemd *user* unit, matching the package this file ships in.
#
# Install (package host, which is the normal case):
#   cp /usr/share/arcint/arcint.service ~/.config/systemd/user/
#   $EDITOR ~/.config/systemd/user/arcint.service     # GGUF, card, port, name
#   systemctl --user daemon-reload && systemctl --user enable --now arcint
#
# If a unit manager owns ~/.config/systemd/user on your host, hand it this file
# rather than installing it by hand.
#
# Two things about the shape of this file, both learned by installing it:
#
#  1. ExecStart is /usr/bin/arcint, where the .deb puts the binary. It used to
#     read %h/.local/bin/arcint, which is where `cmake --install --prefix
#     ~/.local` puts it — so the shipped unit did not start on a host that only
#     had the package. If you built from source into ~/.local, change this one
#     line back.
#
#  2. The flags are literal, not ${ARCINT_PORT} out of an EnvironmentFile.
#     A unit manager reads the port, the served name and the context out of
#     ExecStart: behind an env-file indirection none of that is visible to it,
#     and neither is it greppable in a journal. One file, self-describing.
#
# The binary carries llama.cpp compiled in; at run time it needs the OpenCL
# ICD loader and Intel's compute runtime on the host (README, "Building").
# There is no LD_LIBRARY_PATH here on purpose.

[Unit]
Description=arcint — LLM inference for Intel Arc
Documentation=https://github.com/marfrit/arcint
# default.target, not graphical-session.target: a headless container has no
# graphical session, and a unit ordered after one that never arrives is a unit
# that looks fine and never runs.
After=default.target
# One card, one resident model: anything else holding this GPU must not run at
# the same time. Name the neighbours that actually collide on this host.
#Conflicts=arcint-writer.service

[Service]
Type=simple
ExecStart=/usr/bin/arcint \
    --engine llama \
    --gguf /models/gguf/Qwen3.8-27B-Q4_K_M.gguf \
    --served-model-name qwen3.8-agent \
    --device GPU.0 \
    --host 0.0.0.0 \
    --port 8080 \
    --n-ctx 131072 \
    --llama-kv q8_0 \
    --llama-mtp 5 \
    --queue-timeout 30

# --served-model-name is what /v1/models reports, which is what a discovering
# proxy pins its roster to and therefore what clients must send. The GGUF
# behind it can change without the clients noticing.
#
# --n-ctx is checked by measurement, not by the process: size it at the
# deepest prompt you will admit and watch the card's peak (DESIGN §3.3). A
# prompt longer than it is refused with HTTP 400, never truncated.
#
# --queue-timeout 30 is deliberate for a *service* endpoint. The engine default
# is 0 -- refuse a request that finds no free lane -- because an unbounded
# queue is indistinguishable from a hang. But an OpenAI-compatible client
# generally does not retry a 503, so on a shared endpoint waiting is kinder.
#
# Other flags worth knowing, none of them enabled here (arcint --help):
#   --llama-kv q8_0:q4_0  a deeper context in the same VRAM (the agent unit
#                         runs 245,760 tokens with it on a 24 GB card)
#   --served-model-name A,B --lane-ctx CA,CB
#                         two named lanes on one copy of the weights
#   --llama-checkpoints N recurrent-state checkpoints a lane resumes from
#                         (default 32)
#   Flash-Next's expert cache: contrib/systemd/arcint-flashnext.service

# The card holds the model's VRAM for the process lifetime, so a restart is a
# full reload (minutes). Restart on failure, but do not thrash.
Restart=on-failure
RestartSec=30s

# Loading a large GGUF and building the OpenCL kernels on a cold kernel cache
# takes minutes. systemd must not call that a hung start.
TimeoutStartSec=20min
TimeoutStopSec=60s

# stderr is the dashboard (llama.cpp-style state lines); let journald have it.
StandardOutput=journal
StandardError=journal

# It reads model files and writes only the OpenCL kernel cache, under /tmp by
# default (ggml's GGML_OPENCL_KERNEL_CACHE_DIR moves it; keep it persistent, a
# cold cache rebuilds every kernel at start).
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=read-only

[Install]
WantedBy=default.target
