# Configuration for the arcint systemd unit. Every arcint setting is a command
# line flag; this file exists so the unit itself does not have to be edited to
# change one.

ARCINT_MODEL=/models/ov/qwen36-coder-b5-ov
ARCINT_DEVICE=GPU.0
ARCINT_HOST=127.0.0.1
ARCINT_PORT=8081
ARCINT_N_CTX=262144
ARCINT_PREFIX_CACHE_MIB=8192

# Anything else, verbatim. Both speculative paths are off by default and are a
# net loss until the paged decode path lands (DESIGN §3.5.1–3.5.2), so they are
# deliberately not enabled here.
#   --mtp on              the Qwen3.8 MTP head, where the export carries one
#   --draft 4             prompt-lookup drafting
#   --custom-kernels ...  hand-written OpenCL (measurement switch)
ARCINT_EXTRA_ARGS=--cache-dir /home/mfritsche/.cache/arcint
